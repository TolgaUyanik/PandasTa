kz_show_m_open = input.bool(false, "M Open",    inline = "MO", group = g_DWM)
kz_mhl         = input.bool(false, "High/Low",  inline = "MO", group = g_DWM)
kz_ms          = input.bool(false, "Separators",inline = "MO", group = g_DWM)
kz_m_color     = input.color(color.red, "",     inline = "MO", group = g_DWM)

kz_htf_style_str = input.string("Solid", "Style", options = ["Solid","Dotted","Dashed"], inline = "D0", group = g_DWM)
kz_htf_width     = input.int(1, "",                inline = "D0", group = g_DWM)

kz_dow_labels   = input.bool(true,    "Day of Week Labels", inline = "DOW", group = g_DWM)
kz_dow_yloc     = input.string("Bottom", "",  options = ["Top","Bottom"],          inline = "DOW", group = g_DWM)
kz_dow_xloc     = input.string("Midnight","", options = ["Midnight","Midday"],     inline = "DOW", group = g_DWM)
kz_dow_hide_wknd = input.bool(true,   "Hide Weekend Labels", group = g_DWM)

// ── Helpers ───────────────────────────────────────────────
kz_get_line_type(s) =>
    switch s
        "Solid"  => line.style_solid
        "Dotted" => line.style_dotted
        "Dashed" => line.style_dashed
        => line.style_solid

kz_get_size(x) =>
    switch x
        "Auto"   => size.auto
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        "Huge"   => size.huge
        => size.normal

kz_get_table_pos(p) =>
    switch p
        "Bottom Center" => position.bottom_center
        "Bottom Left"   => position.bottom_left
        "Bottom Right"  => position.bottom_right
        "Middle Center" => position.middle_center
        "Middle Left"   => position.middle_left
        "Middle Right"  => position.middle_right
        "Top Center"    => position.top_center
        "Top Left"      => position.top_left
        "Top Right"     => position.top_right
        => position.top_right

kz_lbl_size  = kz_get_size(kz_lbl_size_str)
kz_kzp_style = kz_get_line_type(kz_kzp_style_str)
kz_kzm_style = kz_get_line_type(kz_kzm_style_str)
kz_htf_style = kz_get_line_type(kz_htf_style_str)
kz_range_pos = kz_get_table_pos(kz_range_pos_str)
kz_range_sz  = kz_get_size(kz_range_sz_str)

var kz_tf_ok = timeframe.in_seconds() <= timeframe.in_seconds(kz_tf_limit)
var kz_transparent = #ffffff00
var kz_ext_current = kz_ext_which == "Most Recent"
var kz_ext_past    = kz_ext_pivots == "Past Mitigation"

kz_t_co = not na(time("", kz_cutoff, kz_gmt_tz))

// ── UDT ───────────────────────────────────────────────────
type kz_t
    string         _title
    array<box>     _box
    array<line>    _hi_line
    array<line>    _md_line
    array<line>    _lo_line
    array<label>   _hi_label
    array<label>   _lo_label
    array<bool>    _hi_valid
    array<bool>    _md_valid
    array<bool>    _lo_valid
    array<float>   _range_store
    float          _range_current

type kz_dwm_hl_t
    array<line>  hi_line
    array<line>  lo_line
    array<label> hi_label
    array<label> lo_label
    bool         hit_high = false
    bool         hit_low  = false

type kz_dwm_info_t
    string tf
    float  o  = na
    float  h  = na
    float  l  = na
    float  ph = na
    float  pl = na

type kz_helper_t
    kz_t   _kz
    string session
    color  c
    string box_txt
    string hi_txt
    string lo_txt

// ── Init killzones ────────────────────────────────────────
kz_initKZ() =>
    res = array.new<kz_helper_t>()
    if kz_use_as
        res.push(kz_helper_t.new(kz_t.new(kz_as_txt, array.new<box>(), array.new<line>(), array.new<line>(), array.new<line>(), array.new<label>(), array.new<label>(), array.new<bool>(), array.new<bool>(), array.new<bool>(), array.new<float>()), kz_asia,   kz_as_color, kz_as_txt, kz_ash_str, kz_asl_str))
    if kz_use_lo
        res.push(kz_helper_t.new(kz_t.new(kz_lo_txt, array.new<box>(), array.new<line>(), array.new<line>(), array.new<line>(), array.new<label>(), array.new<label>(), array.new<bool>(), array.new<bool>(), array.new<bool>(), array.new<float>()), kz_london, kz_lo_color, kz_lo_txt, kz_loh_str, kz_lol_str))
    if kz_use_na
        res.push(kz_helper_t.new(kz_t.new(kz_na_txt, array.new<box>(), array.new<line>(), array.new<line>(), array.new<line>(), array.new<label>(), array.new<label>(), array.new<bool>(), array.new<bool>(), array.new<bool>(), array.new<float>()), kz_nyam,   kz_na_color, kz_na_txt, kz_nah_str, kz_nal_str))
    if kz_use_nl
        res.push(kz_helper_t.new(kz_t.new(kz_nl_txt, array.new<box>(), array.new<line>(), array.new<line>(), array.new<line>(), array.new<label>(), array.new<label>(), array.new<bool>(), array.new<bool>(), array.new<bool>(), array.new<float>()), kz_nylu,   kz_nl_color, kz_nl_txt, kz_nlh_str, kz_nll_str))
    if kz_use_np
        res.push(kz_helper_t.new(kz_t.new(kz_np_txt, array.new<box>(), array.new<line>(), array.new<line>(), array.new<line>(), array.new<label>(), array.new<label>(), array.new<bool>(), array.new<bool>(), array.new<bool>(), array.new<float>()), kz_nypm,   kz_np_color, kz_np_txt, kz_nph_str, kz_npl_str))
    res

var array<kz_helper_t> _kz_arr = kz_initKZ()

var kz_d_hl = kz_dwm_hl_t.new(array.new<line>(), array.new<line>(), array.new<label>(), array.new<label>())
var kz_w_hl = kz_dwm_hl_t.new(array.new<line>(), array.new<line>(), array.new<label>(), array.new<label>())
var kz_m_hl = kz_dwm_hl_t.new(array.new<line>(), array.new<line>(), array.new<label>(), array.new<label>())
var kz_d_info = kz_dwm_info_t.new("D")
var kz_w_info = kz_dwm_info_t.new("W")
var kz_m_info = kz_dwm_info_t.new("M")

var kz_d_sep_line = array.new<line>()
var kz_w_sep_line = array.new<line>()
var kz_m_sep_line = array.new<line>()
var kz_d_line  = array.new<line>()
var kz_w_line  = array.new<line>()
var kz_m_line  = array.new<line>()
var kz_d_label = array.new<label>()
var kz_w_label = array.new<label>()
var kz_m_label = array.new<label>()

// ── DWM update ────────────────────────────────────────────
kz_update_dwm(kz_dwm_info_t n) =>
    if timeframe.change(n.tf)
        n.ph := n.h
        n.pl := n.l
        n.o  := open
        n.h  := high
        n.l  := low
    else
        n.h := math.max(high, n.h)
        n.l := math.min(low,  n.l)

if kz_dhl or kz_show_d_open
    kz_update_dwm(kz_d_info)
if kz_whl or kz_show_w_open
    kz_update_dwm(kz_w_info)
if kz_mhl or kz_show_m_open
    kz_update_dwm(kz_m_info)

// ── Box/text color ────────────────────────────────────────
kz_box_color(color c) => color.new(c, kz_box_transp)
kz_tc(color c)        => color.new(c, kz_text_transp)

// ── DWM functions ─────────────────────────────────────────
kz_dwm_sep(string tf, bool use, array<line> arr, color col) =>
    if use
        if timeframe.change(tf)
            arr.unshift(line.new(bar_index, high*1.0001, bar_index, low, style=kz_htf_style, width=kz_htf_width, extend=extend.both, color=col))
            if not kz_sep_unlimited and arr.size() > kz_max_days
                arr.pop().delete()

kz_dwm_open(string tf, bool use, array<line> lns, array<label> lbls, kz_dwm_info_t n, color col) =>
    if use
        if lns.size() > 0
            lns.get(0).set_x2(time)
            lbls.get(0).set_x(time)
        if timeframe.change(tf)
            lns.unshift(line.new(time, n.o, time, n.o, xloc=xloc.bar_time, style=kz_htf_style, width=kz_htf_width, color=col))
            lbls.unshift(label.new(time, n.o, tf+" OPEN", xloc=xloc.bar_time, style=label.style_label_left, color=kz_transparent, textcolor=kz_txt_color, size=kz_lbl_size))
            if not kz_sep_unlimited and lns.size() > kz_max_days
                lns.pop().delete()
                lbls.pop().delete()

kz_dwm_hl(string tf, bool use, kz_dwm_hl_t hl, kz_dwm_info_t n, color col) =>
    if use
        if hl.hi_line.size() > 0
            hl.hi_line.get(0).set_x2(time)
            hl.lo_line.get(0).set_x2(time)
            hl.hi_label.get(0).set_x(time)
            hl.lo_label.get(0).set_x(time)
        if timeframe.change(tf)
            hl.hi_line.unshift(line.new(time, n.ph, time, n.ph, xloc=xloc.bar_time, style=kz_htf_style, width=kz_htf_width, color=col))
            hl.lo_line.unshift(line.new(time, n.pl, time, n.pl, xloc=xloc.bar_time, style=kz_htf_style, width=kz_htf_width, color=col))
            hl.hi_label.unshift(label.new(time, n.ph, "P"+tf+"H", xloc=xloc.bar_time, style=label.style_label_left, color=kz_transparent, textcolor=kz_txt_color, size=kz_lbl_size))
            hl.lo_label.unshift(label.new(time, n.pl, "P"+tf+"L", xloc=xloc.bar_time, style=label.style_label_left, color=kz_transparent, textcolor=kz_txt_color, size=kz_lbl_size))
            hl.hit_high := false
            hl.hit_low  := false
            if not kz_sep_unlimited and hl.hi_line.size() > kz_max_days
                hl.hi_line.pop().delete()
                hl.lo_line.pop().delete()
                hl.hi_label.pop().delete()
                hl.lo_label.pop().delete()
        if hl.hi_line.size() > 0 and kz_alert_HL
            if not hl.hit_high and high > hl.hi_line.get(0).get_y1()
                hl.hit_high := true
                alert(str.format("Hit P{0}H", tf))
            if not hl.hit_low and low < hl.lo_line.get(0).get_y1()
                hl.hit_low := true
                alert(str.format("Hit P{0}L", tf))

// ── DWM main ──────────────────────────────────────────────
if kz_tf_ok
    kz_dwm_sep("D", kz_ds, kz_d_sep_line, kz_d_color)
    kz_dwm_sep("W", kz_ws, kz_w_sep_line, kz_w_color)
    kz_dwm_sep("M", kz_ms, kz_m_sep_line, kz_m_color)
    kz_dwm_open("D", kz_show_d_open, kz_d_line, kz_d_label, kz_d_info, kz_d_color)
    kz_dwm_open("W", kz_show_w_open, kz_w_line, kz_w_label, kz_w_info, kz_w_color)
    kz_dwm_open("M", kz_show_m_open, kz_m_line, kz_m_label, kz_m_info, kz_m_color)
    kz_dwm_hl("D", kz_dhl, kz_d_hl, kz_d_info, kz_d_color)
    kz_dwm_hl("W", kz_whl, kz_w_hl, kz_w_info, kz_w_color)
    kz_dwm_hl("M", kz_mhl, kz_m_hl, kz_m_info, kz_m_color)

// ── KZ delete helper ──────────────────────────────────────
kz_del(kz_t k) =>
    if k._box.size() > kz_max_days
        k._box.pop().delete()
    if k._hi_line.size() > kz_max_days
        k._hi_line.pop().delete()
        k._lo_line.pop().delete()
        k._hi_valid.pop()
        k._lo_valid.pop()
        if kz_show_midpoints
            k._md_line.pop().delete()
            k._md_valid.pop()
    if k._hi_label.size() > kz_max_days
        k._hi_label.pop().delete()
        k._lo_label.pop().delete()

// ── Update price string ───────────────────────────────────
kz_update_price_str(label L, float P) =>
    S   = L.get_text()
    pre = str.trim(str.substring(S, 0, str.pos(S, " ")))
    L.set_text(str.format("{0} ({1})", pre, P))

// ── Adjust inside session ─────────────────────────────────
kz_adjust_in(kz_t k, bool t) =>
    if t
        b0 = k._box.get(0)
        b0.set_right(time)
        newTop    = math.max(b0.get_top(),    high)
        newBottom = math.min(b0.get_bottom(), low)
        b0.set_top(newTop)
        b0.set_bottom(newBottom)
        k._range_current := newTop - newBottom
        if kz_show_pivots and k._hi_line.size() > 0
            h0 = k._hi_line.get(0)
            l0 = k._lo_line.get(0)
            h0.set_x2(time)
            l0.set_x2(time)
            if high > h0.get_y1()
                h0.set_xy1(time, high)
                h0.set_xy2(time, high)
            if low < l0.get_y1()
                l0.set_xy1(time, low)
                l0.set_xy2(time, low)
            if kz_show_midpoints
                m0 = k._md_line.get(0)
                mid = math.avg(h0.get_y2(), l0.get_y2())
                m0.set_x2(time)
                m0.set_xy1(time, mid)
                m0.set_xy2(time, mid)
        if kz_show_labels and k._hi_label.size() > 0
            if kz_label_right
                k._hi_label.get(0).set_x(time)
                k._lo_label.get(0).set_x(time)
            if high > k._hi_label.get(0).get_y()
                k._hi_label.get(0).set_xy(time, high)
                if kz_label_price
                    kz_update_price_str(k._hi_label.get(0), high)
            if low < k._lo_label.get(0).get_y()
                k._lo_label.get(0).set_xy(time, low)
                if kz_label_price
                    kz_update_price_str(k._lo_label.get(0), low)

// ── Adjust outside session ────────────────────────────────
kz_adjust_out(kz_t k, bool t, bool t_prev) =>
    boxCount = k._box.size()
    if not t and boxCount > 0
        if t_prev
            k._range_store.unshift(k._range_current)
            if k._range_store.size() > kz_range_avg
                k._range_store.pop()
    if kz_show_pivots and boxCount > 0
        for i = 0 to boxCount - 1
            if not kz_ext_current or i == 0
                hv = k._hi_valid.get(i)
                if kz_ext_past or hv
                    k._hi_line.get(i).set_x2(time)
                    if kz_show_labels and kz_label_right
                        k._hi_label.get(i).set_x(time)
                if hv and high > k._hi_line.get(i).get_y1()
                    if kz_use_alerts and i == 0
                        alert("Broke " + k._title + " High", alert.freq_once_per_bar)
                    k._hi_valid.set(i, false)
                    if kz_show_labels and kz_label_right
                        k._hi_label.get(i).set_style(label.style_label_down)
                else if kz_use_cutoff ? kz_t_co : false
                    k._hi_valid.set(i, false)

                lv = k._lo_valid.get(i)
                if kz_ext_past or lv
                    k._lo_line.get(i).set_x2(time)
                    if kz_show_labels and kz_label_right
                        k._lo_label.get(i).set_x(time)
                if lv and low < k._lo_line.get(i).get_y1()
                    if kz_use_alerts and i == 0
                        alert("Broke " + k._title + " Low", alert.freq_once_per_bar)
                    k._lo_valid.set(i, false)
                    if kz_show_labels and kz_label_right
                        k._lo_label.get(i).set_style(label.style_label_up)
                else if kz_use_cutoff ? kz_t_co : false
                    k._lo_valid.set(i, false)

                if kz_show_midpoints and not t
                    if kz_stop_midpoints ? k._md_valid.get(i) : true
                        k._md_line.get(i).set_x2(time)
                        if k._md_valid.get(i) and low <= k._md_line.get(i).get_y1() and high >= k._md_line.get(i).get_y1()
                            k._md_valid.set(i, false)
            else
                break

// ── Manage KZ ─────────────────────────────────────────────
kz_manage(kz_helper_t h) =>
    k   = h._kz
    c   = h.c
    if kz_tf_ok
        _t   = time("", h.session, kz_gmt_tz)
        _tp  = time("", h.session, kz_gmt_tz, bars_back = 1)
        t      = not na(_t)
        t_prev = not na(_tp)
        if t and not t_prev
            _bc = kz_box_color(c)
            _tc = kz_tc(c)
            k._box.unshift(box.new(time, high, time, low,
                           xloc=xloc.bar_time,
                           border_color = kz_show_kz ? _bc : na,
                           bgcolor      = kz_show_kz ? _bc : na,
                           text         = kz_show_kz and kz_show_txt ? h.box_txt : na,
                           text_color   = _tc))
            if kz_show_pivots
                k._hi_line.unshift(line.new(time, high, time, high, xloc=xloc.bar_time, style=kz_kzp_style, color=c, width=kz_kzp_width))
                k._lo_line.unshift(line.new(time, low,  time, low,  xloc=xloc.bar_time, style=kz_kzp_style, color=c, width=kz_kzp_width))
                if kz_show_midpoints
                    k._md_line.unshift(line.new(time, math.avg(high,low), time, math.avg(high,low), xloc=xloc.bar_time, style=kz_kzm_style, color=c, width=kz_kzm_width))
                    k._md_valid.unshift(true)
                k._hi_valid.unshift(true)
                k._lo_valid.unshift(true)
                if kz_show_labels
                    _ht = kz_label_price ? str.format("{0} ({1})", h.hi_txt, high) : h.hi_txt
                    _lt = kz_label_price ? str.format("{0} ({1})", h.lo_txt, low)  : h.lo_txt
                    if kz_label_right
                        k._hi_label.unshift(label.new(time, high, _ht, xloc=xloc.bar_time, color=kz_transparent, textcolor=kz_txt_color, style=label.style_label_left, size=kz_lbl_size))
                        k._lo_label.unshift(label.new(time, low,  _lt, xloc=xloc.bar_time, color=kz_transparent, textcolor=kz_txt_color, style=label.style_label_left, size=kz_lbl_size))
                    else
                        k._hi_label.unshift(label.new(time, high, _ht, xloc=xloc.bar_time, color=kz_transparent, textcolor=kz_txt_color, style=label.style_label_down, size=kz_lbl_size))
                        k._lo_label.unshift(label.new(time, low,  _lt, xloc=xloc.bar_time, color=kz_transparent, textcolor=kz_txt_color, style=label.style_label_up,   size=kz_lbl_size))
            kz_del(k)
        kz_adjust_in(k, t)
        kz_adjust_out(k, t, t_prev)

for [_, v] in _kz_arr
    kz_manage(v)

// ── Day of week labels ────────────────────────────────────
kz_new_dow_time = kz_dow_xloc == "Midday" ? time - timeframe.in_seconds("D") / 2 * 1000 : time
kz_new_day      = dayofweek(kz_new_dow_time, kz_gmt_tz) != dayofweek(kz_new_dow_time, kz_gmt_tz)[1]
var kz_dow_top  = kz_dow_yloc == "Top"

plotchar(kz_dow_labels and timeframe.isintraday and dayofweek(kz_new_dow_time, kz_gmt_tz)==1 and kz_new_day and not kz_dow_hide_wknd, location=kz_dow_top?location.top:location.bottom, char="", textcolor=kz_txt_color, text="SUNDAY")
plotchar(kz_dow_labels and timeframe.isintraday and dayofweek(kz_new_dow_time, kz_gmt_tz)==2 and kz_new_day, location=kz_dow_top?location.top:location.bottom, char="", textcolor=kz_txt_color, text="MONDAY")
plotchar(kz_dow_labels and timeframe.isintraday and dayofweek(kz_new_dow_time, kz_gmt_tz)==3 and kz_new_day, location=kz_dow_top?location.top:location.bottom, char="", textcolor=kz_txt_color, text="TUESDAY")
plotchar(kz_dow_labels and timeframe.isintraday and dayofweek(kz_new_dow_time, kz_gmt_tz)==4 and kz_new_day, location=kz_dow_top?location.top:location.bottom, char="", textcolor=kz_txt_color, text="WEDNESDAY")
plotchar(kz_dow_labels and timeframe.isintraday and dayofweek(kz_new_dow_time, kz_gmt_tz)==5 and kz_new_day, location=kz_dow_top?location.top:location.bottom, char="", textcolor=kz_txt_color, text="THURSDAY")
plotchar(kz_dow_labels and timeframe.isintraday and dayofweek(kz_new_dow_time, kz_gmt_tz)==6 and kz_new_day, location=kz_dow_top?location.top:location.bottom, char="", textcolor=kz_txt_color, text="FRIDAY")
plotchar(kz_dow_labels and timeframe.isintraday and dayofweek(kz_new_dow_time, kz_gmt_tz)==7 and kz_new_day and not kz_dow_hide_wknd, location=kz_dow_top?location.top:location.bottom, char="", textcolor=kz_txt_color, text="SATURDAY")

// ── Range table ───────────────────────────────────────────
kz_get_min_days() =>
    store = array.new_int()
    for [_, v] in _kz_arr
        sz = v._kz._range_store.size()
        if sz > 0
            store.push(sz)
    store.min()

if kz_show_range and barstate.islast
    var tbl = table.new(kz_range_pos, 10, 10, chart.bg_color, chart.fg_color, 2, chart.fg_color, 1)
    table.cell(tbl, 0, 0, "Killzone", text_size=kz_range_sz, text_color=kz_txt_color)
    table.cell(tbl, 1, 0, "Range",    text_size=kz_range_sz, text_color=kz_txt_color)
    if kz_show_range_avg
        table.cell(tbl, 2, 0, "Avg (" + str.tostring(kz_get_min_days()) + ")", text_size=kz_range_sz, text_color=kz_txt_color)
    for [index, v] in _kz_arr
        k   = v._kz
        col = v.c
        in_s = not na(time("", v.session, kz_gmt_tz))
        table.cell(tbl, 0, index+1, v.box_txt,                    text_size=kz_range_sz, bgcolor=kz_box_color(col), text_color=kz_txt_color)
        table.cell(tbl, 1, index+1, str.tostring(k._range_current),text_size=kz_range_sz, bgcolor=in_s?kz_box_color(col):na, text_color=kz_txt_color)
        if kz_show_range_avg
            table.cell(tbl, 2, index+1, str.tostring(k._range_store.avg()), text_size=kz_range_sz, text_color=kz_txt_color)


// ═══════════════════════════════════════════════════════════
//  📦  3) SUPPLY / DEMAND + SWING H/L
// ═══════════════════════════════════════════════════════════
var G_SD = "📦 Supply / Demand"

// ── S/D inputs ───────────────────────────────────────────
switch_poi              = input.bool(true,   "Supply/Demand Zone",          group = G_SD, inline = "Switch1")
swing_length            = input.int (10,     "Swing H/L Length",            group = G_SD, inline = "Switch2", minval = 1, maxval = 50)
history_of_demand       = input.int (20,     "History",                     group = G_SD, inline = "Switch2", minval = 5, maxval = 50)
sd_box_width            = input.float(5,     "S/D Box Width",               group = G_SD, inline = "Switch2", minval = 1, maxval = 10, step = 0.5)
show_pa_labels          = input.bool(true,   "Show Price Action Labels",     group = G_SD)
supply_color            = input.color(color.new(#f02c2c, 70), "Supply",     group = G_SD, inline = "3")
supply_outline_color    = input.color(color.new(#858181, 100), "Outline",   group = G_SD, inline = "3")
demand_color            = input.color(color.new(#00FFFF, 70),  "Demand",    group = G_SD, inline = "3")
demand_outline_color    = input.color(color.new(#797474, 100), "Outline",   group = G_SD, inline = "3")
poi_label_color         = input.color(color.rgb(0, 0, 0),      "POI Label", group = G_SD, inline = "7")
swing_type_color        = input.color(color.black, "Price Action Label",    group = G_SD, inline = "7")

// ── Swing buy/sell inputs ────────────────────────────────
sd_no          = input.int  (3,    "Swing",           group = G_SD)
sd_showBuySell = input.bool (false,"Show Buy/Sell",   group = G_SD)
sd_showTSL     = input.bool (true, "Show TSL Line",   group = G_SD)
sd_showBarCol  = input.bool (false,"Enable Barcolor",  group = G_SD)
sd_showBgCol   = input.bool (false,"Enable Bgcolor",   group = G_SD)

// ── S/D helpers ──────────────────────────────────────────
atrpoi = ta.atr(50)

f_array_add_pop_float(arrFloat, val) =>
    array.unshift(arrFloat, val)
    array.pop(arrFloat)

f_array_add_pop_int(arrInt, val) =>
    array.unshift(arrInt, val)
    array.pop(arrInt)

f_sh_sl_labels(arrFloat, swing_type) =>
    if array.size(arrFloat) >= 2
        curr = array.get(arrFloat, 0)
        prev = array.get(arrFloat, 1)
        if swing_type == 1
            txt = curr >= prev ? "HH" : "LH"
            label.new(bar_index - swing_length, curr, text=txt, style=label.style_label_down, textcolor=swing_type_color, color=color.new(swing_type_color, 100), size=size.tiny)
        else if swing_type == -1
            txt = curr >= prev ? "HL" : "LL"
            label.new(bar_index - swing_length, curr, text=txt, style=label.style_label_up, textcolor=swing_type_color, color=color.new(swing_type_color, 100), size=size.tiny)

f_check_overlapping(new_poi, box_arr, _atrpoi) =>
    atr_threshold = _atrpoi * 2.0
    ok = true
    sz = array.size(box_arr)
    for i = 0 to sz - 1
        b = array.get(box_arr, i)
        if not na(b)
            top    = box.get_top(b)
            bottom = box.get_bottom(b)
            poi    = (top + bottom) * 0.5
            if new_poi >= poi - atr_threshold and new_poi <= poi + atr_threshold
                ok := false
                break
    ok

f_supply_demand(val_arr, bn_arr, box_arr, label_arr, box_type, _atrpoi) =>
    atr_buffer = _atrpoi * (sd_box_width / 10.0)
    left_ix    = array.get(bn_arr, 0)
    right_ix   = bar_index
    float box_top    = na
    float box_bottom = na
    float poi        = na
    if box_type == 1
        box_top    := array.get(val_arr, 0)
        box_bottom := box_top - atr_buffer
        poi        := (box_top + box_bottom) * 0.5
    else if box_type == -1
        box_bottom := array.get(val_arr, 0)
        box_top    := box_bottom + atr_buffer
        poi        := (box_top + box_bottom) * 0.5
    if na(poi) or na(left_ix)
        na
    else
        can_draw = f_check_overlapping(poi, box_arr, _atrpoi)
        if can_draw and switch_poi
            lastBox = array.get(box_arr, array.size(box_arr) - 1)
            if not na(lastBox)
                box.delete(lastBox)
            lastLbl = array.get(label_arr, array.size(label_arr) - 1)
            if not na(lastLbl)
                box.delete(lastLbl)
            if box_type == 1
                nb = box.new(left=left_ix, top=box_top, right=right_ix, bottom=box_bottom,
                             border_color=supply_outline_color, bgcolor=supply_color, extend=extend.right,
                             text="SUPPLY", text_halign=text.align_center, text_valign=text.align_center,
                             text_color=poi_label_color, text_size=size.small, xloc=xloc.bar_index)
                f_array_add_pop_float(box_arr, nb)
            else
                nb = box.new(left=left_ix, top=box_top, right=right_ix, bottom=box_bottom,
                             border_color=demand_outline_color, bgcolor=demand_color, extend=extend.right,
                             text="DEMAND", text_halign=text.align_center, text_valign=text.align_center,
                             text_color=poi_label_color, text_size=size.small, xloc=xloc.bar_index)
                f_array_add_pop_float(box_arr, nb)
            npl = box.new(left=left_ix, top=poi, right=right_ix, bottom=poi,
                          border_color=color.new(poi_label_color, 90), bgcolor=color.new(poi_label_color, 90),
                          extend=extend.right, text="POI", text_halign=text.align_left, text_valign=text.align_center,
                          text_color=poi_label_color, text_size=size.small, xloc=xloc.bar_index)
            f_array_add_pop_float(label_arr, npl)

f_sd_to_bos(box_arr, bos_arr, label_arr, zone_type) =>
    if switch_poi
        for i = array.size(box_arr) - 1 to 0
            b = array.get(box_arr, i)
            if na(b)
                continue
            float lvl_to_break = na
            if zone_type == 1
                lvl_to_break := box.get_top(b)
                if close >= lvl_to_break
                    cb = box.copy(b)
                    f_array_add_pop_float(bos_arr, cb)
                    top    = box.get_top(b)
                    bottom = box.get_bottom(b)
                    mid    = (top + bottom) * 0.5
                    box.set_top(cb, mid)
                    box.set_bottom(cb, mid)
                    box.set_extend(cb, extend.none)
                    box.set_right(cb, bar_index)
                    box.set_text(cb, "")
                    box.delete(b)
                    lb = array.get(label_arr, i)
                    if not na(lb)
                        box.delete(lb)
                    array.set(box_arr, i, na)
                    array.set(label_arr, i, na)
            else if zone_type == -1
                lvl_to_break := box.get_bottom(b)
                if close <= lvl_to_break
                    cb = box.copy(b)
                    f_array_add_pop_float(bos_arr, cb)
                    top    = box.get_top(b)
                    bottom = box.get_bottom(b)
                    mid    = (top + bottom) * 0.5
                    box.set_top(cb, mid)
                    box.set_bottom(cb, mid)
                    box.set_extend(cb, extend.none)
                    box.set_right(cb, bar_index)
                    box.set_text(cb, "")
                    box.delete(b)
                    lb = array.get(label_arr, i)
                    if not na(lb)
                        box.delete(lb)
                    array.set(box_arr, i, na)
                    array.set(label_arr, i, na)

f_extend_box_endpoint(box_arr) =>
    sz = array.size(box_arr)
    for i = 0 to sz - 1
        b = array.get(box_arr, i)
        if not na(b)
            box.set_right(b, bar_index + 100)

// ── S/D arrays ───────────────────────────────────────────
swing_high_sd = ta.pivothigh(high, swing_length, swing_length)
swing_low_sd  = ta.pivotlow (low,  swing_length, swing_length)

var swing_high_values = array.new_float(5, 0.0)
var swing_low_values  = array.new_float(5, 0.0)
var swing_high_bns    = array.new_int(5, 0)
var swing_low_bns     = array.new_int(5, 0)

var current_supply_box = array.new_box(history_of_demand, na)
var current_demand_box = array.new_box(history_of_demand, na)
var current_supply_poi = array.new_box(history_of_demand, na)
var current_demand_poi = array.new_box(history_of_demand, na)

var supply_bos = array.new_box(5, na)
var demand_bos = array.new_box(5, na)

if not na(swing_high_sd)
    f_array_add_pop_float(swing_high_values, swing_high_sd)
    f_array_add_pop_int(swing_high_bns, bar_index[swing_length])
    if show_pa_labels
        f_sh_sl_labels(swing_high_values, 1)
    f_supply_demand(swing_high_values, swing_high_bns, current_supply_box, current_supply_poi, 1, atrpoi)
else if not na(swing_low_sd)
    f_array_add_pop_float(swing_low_values, swing_low_sd)
    f_array_add_pop_int(swing_low_bns, bar_index[swing_length])
    if show_pa_labels
        f_sh_sl_labels(swing_low_values, -1)
    f_supply_demand(swing_low_values, swing_low_bns, current_demand_box, current_demand_poi, -1, atrpoi)

f_sd_to_bos(current_supply_box, supply_bos, current_supply_poi, 1)
f_sd_to_bos(current_demand_box, demand_bos, current_demand_poi, -1)
f_extend_box_endpoint(current_supply_box)
f_extend_box_endpoint(current_demand_box)

// ── Swing Buy/Sell (TSL) ─────────────────────────────────
sd_res = ta.highest(high, sd_no)
sd_sup = ta.lowest (low,  sd_no)
sd_avd = close > sd_res[1] ? 1 : close < sd_sup[1] ? -1 : 0
sd_avn = ta.valuewhen(sd_avd != 0, sd_avd, 0)
sd_tsl = sd_avn == 1 ? sd_sup : sd_res

sd_Buy  = ta.crossover (close, sd_tsl)
sd_Sell = ta.crossunder(close, sd_tsl)
sd_colr = close >= sd_tsl ? color.green : close <= sd_tsl ? color.red : na

plotshape(sd_showBuySell and sd_Buy,  "BUY",  shape.labelup,   location.belowbar, color=color.green, text="BUY",  textcolor=color.black)
plotshape(sd_showBuySell and sd_Sell, "SELL", shape.labeldown, location.abovebar, color=color.red,   text="SELL", textcolor=color.black)
plot(sd_showTSL ? sd_tsl : na, color=sd_colr, linewidth=3, title="TSL")
barcolor(sd_showBarCol ? sd_colr : na)
bgcolor(sd_showBgCol  ? sd_colr : na)

alertcondition(sd_Buy,  title="Buy Signal",  message="Buy")
alertcondition(sd_Sell, title="Sell Signal", message="Sell")



// ═══════════════════════════════════════════════════════════
//  📍  4) KEY LEVELS — Full SpacemanBTC IDWM port
// ═══════════════════════════════════════════════════════════
var G_KL = "📍 Key Levels"

kl_display    = input.string("Standard", "Display Style", options = ["Standard", "Right Anchored"], inline = "kld",  group = G_KL)
kl_merge      = input.bool  (true,       "Merge Levels",  inline = "kld",  group = G_KL)
kl_dist       = input.int   (30,  "Distance",        minval = 5, maxval = 500, inline = "kldist", group = G_KL)
kl_radist     = input.int   (250, "Anchor Distance", minval = 5, maxval = 500, inline = "kldist", group = G_KL)
kl_lblsz      = input.string("Medium", "Text Size",  options = ["Small","Medium","Large"],          group = G_KL)
kl_linesz     = input.string("Small",  "Line Width", options = ["Small","Medium","Large"],  inline = "klls", group = G_KL)
kl_linesty    = input.string("Solid",  "Line Style", options = ["Solid","Dashed","Dotted"], inline = "klls", group = G_KL)
kl_globaltext = input.bool  (false, "Global ShortHand", group = G_KL)
kl_globalcol  = input.bool  (false, "Global Coloring",  inline = "klgc", group = G_KL)
kl_gcol       = input.color (color.white, "",            inline = "klgc", group = G_KL)

kl_4h_o  = input.bool(false,"Open",     inline="kl4h",  group=G_KL)
kl_4h_hl = input.bool(false,"Prev H/L", inline="kl4h",  group=G_KL)
kl_4h_m  = input.bool(false,"Prev Mid", inline="kl4h",  group=G_KL)
kl_4h_sh = input.bool(false,"ShortHand",inline="kl4hsh",group=G_KL)
kl_4h_c  = input.color(color.orange,"", inline="kl4hsh",group=G_KL)

kl_d_o   = input.bool(true, "Open",     inline="kld1",  group=G_KL)
kl_d_hl  = input.bool(false,"Prev H/L", inline="kld1",  group=G_KL)
kl_d_m   = input.bool(false,"Prev Mid", inline="kld1",  group=G_KL)
kl_d_sh  = input.bool(false,"ShortHand",inline="kldag", group=G_KL)
kl_d_c   = input.color(#08bcd4,"",      inline="kldag", group=G_KL)

kl_mon_hl = input.bool(true, "Mon Range",inline="klmon",  group=G_KL)
kl_mon_m  = input.bool(true, "Mid",      inline="klmon",  group=G_KL)
kl_mon_sh = input.bool(false,"ShortHand",inline="klmonsh",group=G_KL)
kl_mon_c  = input.color(color.white,"", inline="klmonsh",group=G_KL)

kl_w_o   = input.bool(true, "Open",     inline="klw1",  group=G_KL)
kl_w_hl  = input.bool(true, "Prev H/L", inline="klw1",  group=G_KL)
kl_w_m   = input.bool(true, "Prev Mid", inline="klw1",  group=G_KL)
kl_w_sh  = input.bool(false,"ShortHand",inline="klwsh", group=G_KL)
kl_w_c   = input.color(#fffcbc,"",      inline="klwsh", group=G_KL)

kl_mo_o  = input.bool(true, "Open",     inline="klmo1", group=G_KL)
kl_mo_hl = input.bool(true, "Prev H/L", inline="klmo1", group=G_KL)
kl_mo_m  = input.bool(true, "Prev Mid", inline="klmo1", group=G_KL)
kl_mo_sh = input.bool(false,"ShortHand",inline="klmosh",group=G_KL)
kl_mo_c  = input.color(#08d48c,"",      inline="klmosh",group=G_KL)

kl_q_o   = input.bool(true, "Open",     inline="klq1",  group=G_KL)
kl_q_hl  = input.bool(false,"Prev H/L", inline="klq1",  group=G_KL)
kl_q_m   = input.bool(true, "Prev Mid", inline="klq1",  group=G_KL)
kl_q_sh  = input.bool(false,"ShortHand",inline="klqsh", group=G_KL)
kl_q_c   = input.color(color.red,"",    inline="klqsh", group=G_KL)

kl_y_o   = input.bool(true, "Open",     inline="kly1",  group=G_KL)
kl_y_hl  = input.bool(false,"H/L",      inline="kly1",  group=G_KL)
kl_y_m   = input.bool(true, "Mid",      inline="kly1",  group=G_KL)
kl_y_sh  = input.bool(false,"ShortHand",inline="klysh", group=G_KL)
kl_y_c   = input.color(color.red,"",    inline="klysh", group=G_KL)

kl_lon_en = input.bool(false,"London",  inline="klfx",  group=G_KL)
kl_us_en  = input.bool(false,"NY",      inline="klfx",  group=G_KL)
kl_as_en  = input.bool(false,"Asia",    inline="klfx",  group=G_KL)
kl_fx_sh  = input.bool(false,"ShortHand",inline="klfxsh",group=G_KL)
kl_lon_c  = input.color(color.white,"London",inline="klfxc",group=G_KL)
kl_us_c   = input.color(color.white,"NY",    inline="klfxc",group=G_KL)
kl_as_c   = input.color(color.white,"Asia",  inline="klfxc",group=G_KL)

kl_lon_ses = input.session("0800-1600","London Session",  group=G_KL)
kl_us_ses  = input.session("1400-2100","New York Session",group=G_KL)
kl_as_ses2 = input.session("0000-0900","Tokyo Session",   group=G_KL)

var kl_4h_cv  = kl_4h_c
var kl_d_cv   = kl_d_c
var kl_mon_cv = kl_mon_c
var kl_w_cv   = kl_w_c
var kl_mo_cv  = kl_mo_c
var kl_q_cv   = kl_q_c
var kl_y_cv   = kl_y_c
var kl_lon_cv = kl_lon_c
var kl_us_cv  = kl_us_c
var kl_as_cv  = kl_as_c

if kl_globalcol
    kl_4h_cv  := kl_gcol
    kl_d_cv   := kl_gcol
    kl_mon_cv := kl_gcol
    kl_w_cv   := kl_gcol
    kl_mo_cv  := kl_gcol
    kl_q_cv   := kl_gcol
    kl_y_cv   := kl_gcol
    kl_lon_cv := kl_gcol
    kl_us_cv  := kl_gcol
    kl_as_cv  := kl_gcol

_kl_lw = kl_linesz  == "Large" ? 3 : kl_linesz  == "Medium" ? 2 : 1
_kl_fs = kl_lblsz   == "Large" ? size.large : kl_lblsz == "Small" ? size.small : size.normal
_kl_ls = kl_linesty == "Dashed" ? line.style_dashed : kl_linesty == "Dotted" ? line.style_dotted : line.style_solid
kl_t(string sh, string full, bool use_sh) => use_sh or kl_globaltext ? sh : full

[_4ht, _4ho]   = request.security(syminfo.tickerid,"240",[time,    open],    lookahead=barmerge.lookahead_on)
[_4hht,_4hh]   = request.security(syminfo.tickerid,"240",[time[1], high[1]], lookahead=barmerge.lookahead_on)
[_4hlt,_4hl]   = request.security(syminfo.tickerid,"240",[time[1], low[1]],  lookahead=barmerge.lookahead_on)
[_dt,  _do]    = request.security(syminfo.tickerid,"D",  [time,    open],    lookahead=barmerge.lookahead_on)
[_dht, _dh]    = request.security(syminfo.tickerid,"D",  [time[1], high[1]], lookahead=barmerge.lookahead_on)
[_dlt, _dl]    = request.security(syminfo.tickerid,"D",  [time[1], low[1]],  lookahead=barmerge.lookahead_on)
_cdh           = request.security(syminfo.tickerid,"D",  high,               lookahead=barmerge.lookahead_on)
_cdl           = request.security(syminfo.tickerid,"D",  low,                lookahead=barmerge.lookahead_on)
[_wt,  _wo]    = request.security(syminfo.tickerid,"W",  [time,    open],    lookahead=barmerge.lookahead_on)
[_wht, _wh]    = request.security(syminfo.tickerid,"W",  [time[1], high[1]], lookahead=barmerge.lookahead_on)
[_wlt, _wl]    = request.security(syminfo.tickerid,"W",  [time[1], low[1]],  lookahead=barmerge.lookahead_on)
[_mt,  _mo]    = request.security(syminfo.tickerid,"M",  [time,    open],    lookahead=barmerge.lookahead_on)
[_mht, _mh]    = request.security(syminfo.tickerid,"M",  [time[1], high[1]], lookahead=barmerge.lookahead_on)
[_mlt, _ml]    = request.security(syminfo.tickerid,"M",  [time[1], low[1]],  lookahead=barmerge.lookahead_on)
[_qt,  _qo]    = request.security(syminfo.tickerid,"3M", [time,    open],    lookahead=barmerge.lookahead_on)
[_qht, _qh]    = request.security(syminfo.tickerid,"3M", [time[1], high[1]], lookahead=barmerge.lookahead_on)
[_qlt, _ql]    = request.security(syminfo.tickerid,"3M", [time[1], low[1]],  lookahead=barmerge.lookahead_on)
[_yt,  _yo]    = request.security(syminfo.tickerid,"12M",[time,    open],    lookahead=barmerge.lookahead_on)
[_yht, _yh]    = request.security(syminfo.tickerid,"12M",[time,    high],    lookahead=barmerge.lookahead_on)
[_ylt, _yl]    = request.security(syminfo.tickerid,"12M",[time,    low],     lookahead=barmerge.lookahead_on)

var int   _mon_t  = time
var float _mon_h  = high
var float _mon_l  = low
var bool  _mon_ok = false
if _wt != _wt[1]
    _mon_ok := false
if kl_mon_hl and not _mon_ok
    _mon_ok := true
    _mon_t  := _dt
    _mon_h  := _cdh
    _mon_l  := _cdl

var float _lh=0.0, var float _ll=close, var int _lt=time
var float _flh=0.0, var float _fll=0.0, var float _flo=0.0
var bool _lon_off=false
_lon_in = not na(time("",kl_lon_ses))
if _lon_in
    if high>_lh
        _lh:=high
    if low<_ll
        _ll:=low
    if _lon_off
        _lt:=time
        _flo:=open
    _flh:=_lh
    _fll:=_ll
    _lon_off:=false
else
    if not _lon_off
        _flh:=_lh
        _fll:=_ll
    _lon_off:=true
    _lh:=0.0
    _ll:=close

var float _uh=0.0, var float _ul=close, var int _ut=time
var float _fuh=0.0, var float _ful=0.0, var float _fuo=0.0
var bool _us_off=false
_us_in = not na(time("",kl_us_ses))
if _us_in
    if high>_uh
        _uh:=high
    if low<_ul
        _ul:=low
    if _us_off
        _ut:=time
        _fuo:=open
    _fuh:=_uh
    _ful:=_ul
    _us_off:=false
else
    if not _us_off
        _fuh:=_uh
        _ful:=_ul
    _us_off:=true
    _uh:=0.0
    _ul:=close

var float _ah=0.0, var float _al=close, var int _at2=time
var float _fah=0.0, var float _fal=0.0, var float _fao=0.0
var bool _as_off=false
_as_in = not na(time("",kl_as_ses2))
if _as_in
    if high>_ah
        _ah:=high
    if low<_al
        _al:=low
    if _as_off
        _at2:=time
        _fao:=open
    _fah:=_ah
    _fal:=_al
    _as_off:=false
else
    if not _as_off
        _fah:=_ah
        _fal:=_al
    _as_off:=true
    _ah:=0.0
    _al:=close

var float[] _pa = array.new<float>()
var label[] _la = array.new<label>()

kl_mrg(float[] pa, label[] la, float price, label lbl, color c) =>
    if pa.includes(price)
        idx  = pa.indexof(price)
        hold = la.get(idx)
        hold.set_text(lbl.get_text() + " / " + hold.get_text())
        lbl.set_text("")
        hold.set_textcolor(c)
    else
        pa.push(price)
        la.push(lbl)

kl_draw(int x1, float y, int x2, string txt, color c) =>
    var line  _l  = line.new (x1, y, x2, y, xloc=xloc.bar_time, color=c, style=_kl_ls, width=_kl_lw)
    var label _lb = label.new(x2, y, txt,   xloc=xloc.bar_time, style=label.style_none, textcolor=c, size=_kl_fs)
    line.set_x1(_l, x1)
    line.set_x2(_l, x2)
    line.set_y1(_l, y)
    line.set_y2(_l, y)
    label.set_x(_lb, x2)
    label.set_y(_lb, y)
    label.set_text(_lb, txt)
    _lb

if barstate.islast
    _rl  = int(timenow + (time - time[1]) * kl_dist)
    _rla = int(timenow + (time - time[1]) * kl_radist)
    _ra  = kl_display == "Right Anchored"
    _pa.clear()
    _la.clear()

    t4o = _ra ? _rla : _4ht
    t4h = _ra ? _rla : _4hht
    if kl_4h_o
        lb = kl_draw(t4o, _4ho, _rl, kl_t("4H-O","4H Open",kl_4h_sh), kl_4h_cv)
        if kl_merge
            kl_mrg(_pa,_la,_4ho,lb,kl_4h_cv)
    if kl_4h_hl
        lb1 = kl_draw(t4h, _4hh, _rl, kl_t("P-4H-H","Prev 4H High",kl_4h_sh), kl_4h_cv)
        lb2 = kl_draw(t4h, _4hl, _rl, kl_t("P-4H-L","Prev 4H Low", kl_4h_sh), kl_4h_cv)
        if kl_merge
            kl_mrg(_pa,_la,_4hh,lb1,kl_4h_cv)
            kl_mrg(_pa,_la,_4hl,lb2,kl_4h_cv)
    if kl_4h_m
        v = (_4hh+_4hl)/2
        lb = kl_draw(t4h, v, _rl, kl_t("P-4H-M","Prev 4H Mid",kl_4h_sh), kl_4h_cv)
        if kl_merge
            kl_mrg(_pa,_la,v,lb,kl_4h_cv)

    tmon = _ra ? _rla : _mon_t
    if kl_mon_hl
        lb1 = kl_draw(tmon, _mon_h, _rl, kl_t("MDAY-H","Monday High",kl_mon_sh), kl_mon_cv)
        lb2 = kl_draw(tmon, _mon_l, _rl, kl_t("MDAY-L","Monday Low", kl_mon_sh), kl_mon_cv)
        if kl_merge
            kl_mrg(_pa,_la,_mon_h,lb1,kl_mon_cv)
            kl_mrg(_pa,_la,_mon_l,lb2,kl_mon_cv)
    if kl_mon_m
        v = (_mon_h+_mon_l)/2
        lb = kl_draw(tmon, v, _rl, kl_t("MDAY-M","Monday Mid",kl_mon_sh), kl_mon_cv)
        if kl_merge
            kl_mrg(_pa,_la,v,lb,kl_mon_cv)

    tdo = _ra ? _rla : _dt
    tdh = _ra ? _rla : _dht
    if kl_d_o
        lb = kl_draw(tdo, _do, _rl, kl_t("DO","Daily Open",kl_d_sh), kl_d_cv)
        if kl_merge
            kl_mrg(_pa,_la,_do,lb,kl_d_cv)
    if kl_d_hl
        lb1 = kl_draw(tdh, _dh, _rl, kl_t("PDH","Prev Day High",kl_d_sh), kl_d_cv)
        lb2 = kl_draw(tdh, _dl, _rl, kl_t("PDL","Prev Day Low", kl_d_sh), kl_d_cv)
        if kl_merge
            kl_mrg(_pa,_la,_dh,lb1,kl_d_cv)
            kl_mrg(_pa,_la,_dl,lb2,kl_d_cv)
    if kl_d_m
        v = (_dh+_dl)/2
        lb = kl_draw(tdh, v, _rl, kl_t("PDM","Prev Day Mid",kl_d_sh), kl_d_cv)
        if kl_merge
            kl_mrg(_pa,_la,v,lb,kl_d_cv)

    two = _ra ? _rla : _wt
    twh = _ra ? _rla : _wht
    if kl_w_o
        lb = kl_draw(two, _wo, _rl, kl_t("WO","Weekly Open",kl_w_sh), kl_w_cv)
        if kl_merge
            kl_mrg(_pa,_la,_wo,lb,kl_w_cv)
    if kl_w_hl
        lb1 = kl_draw(twh, _wh, _rl, kl_t("PWH","Prev Week High",kl_w_sh), kl_w_cv)
        lb2 = kl_draw(twh, _wl, _rl, kl_t("PWL","Prev Week Low", kl_w_sh), kl_w_cv)
        if kl_merge
            kl_mrg(_pa,_la,_wh,lb1,kl_w_cv)
            kl_mrg(_pa,_la,_wl,lb2,kl_w_cv)
    if kl_w_m
        v = (_wh+_wl)/2
        lb = kl_draw(twh, v, _rl, kl_t("PWM","Prev Week Mid",kl_w_sh), kl_w_cv)
        if kl_merge
            kl_mrg(_pa,_la,v,lb,kl_w_cv)

    tmo = _ra ? _rla : _mt
    tmh = _ra ? _rla : _mht
    if kl_mo_o
        lb = kl_draw(tmo, _mo, _rl, kl_t("MO","Monthly Open",kl_mo_sh), kl_mo_cv)
        if kl_merge
            kl_mrg(_pa,_la,_mo,lb,kl_mo_cv)
    if kl_mo_hl
        lb1 = kl_draw(tmh, _mh, _rl, kl_t("PMH","Prev Month High",kl_mo_sh), kl_mo_cv)
        lb2 = kl_draw(tmh, _ml, _rl, kl_t("PML","Prev Month Low", kl_mo_sh), kl_mo_cv)
        if kl_merge
            kl_mrg(_pa,_la,_mh,lb1,kl_mo_cv)
            kl_mrg(_pa,_la,_ml,lb2,kl_mo_cv)
    if kl_mo_m
        v = (_mh+_ml)/2
        lb = kl_draw(tmh, v, _rl, kl_t("PMM","Prev Month Mid",kl_mo_sh), kl_mo_cv)
        if kl_merge
            kl_mrg(_pa,_la,v,lb,kl_mo_cv)

    tqo = _ra ? _rla : _qt
    tqh = _ra ? _rla : _qht
    if kl_q_o
        lb = kl_draw(tqo, _qo, _rl, kl_t("QO","Quarterly Open",kl_q_sh), kl_q_cv)
        if kl_merge
            kl_mrg(_pa,_la,_qo,lb,kl_q_cv)
    if kl_q_hl
        lb1 = kl_draw(tqh, _qh, _rl, kl_t("PQH","Prev Quarter High",kl_q_sh), kl_q_cv)
        lb2 = kl_draw(tqh, _ql, _rl, kl_t("PQL","Prev Quarter Low", kl_q_sh), kl_q_cv)
        if kl_merge
            kl_mrg(_pa,_la,_qh,lb1,kl_q_cv)
            kl_mrg(_pa,_la,_ql,lb2,kl_q_cv)
    if kl_q_m
        v = (_qh+_ql)/2
        lb = kl_draw(tqh, v, _rl, kl_t("PQM","Prev Quarter Mid",kl_q_sh), kl_q_cv)
        if kl_merge
            kl_mrg(_pa,_la,v,lb,kl_q_cv)

    tyo = _ra ? _rla : _yt
    if kl_y_o
        lb = kl_draw(tyo, _yo, _rl, kl_t("YO","Yearly Open",kl_y_sh), kl_y_cv)
        if kl_merge
            kl_mrg(_pa,_la,_yo,lb,kl_y_cv)
    if kl_y_hl
        lb1 = kl_draw(tyo, _yh, _rl, kl_t("CYH","Current Year High",kl_y_sh), kl_y_cv)
        lb2 = kl_draw(tyo, _yl, _rl, kl_t("CYL","Current Year Low", kl_y_sh), kl_y_cv)
        if kl_merge
            kl_mrg(_pa,_la,_yh,lb1,kl_y_cv)
            kl_mrg(_pa,_la,_yl,lb2,kl_y_cv)
    if kl_y_m
        v = (_yh+_yl)/2
        lb = kl_draw(tyo, v, _rl, kl_t("CYM","Current Year Mid",kl_y_sh), kl_y_cv)
        if kl_merge
            kl_mrg(_pa,_la,v,lb,kl_y_cv)

    tlt = _ra ? _rla : _lt
    tut = _ra ? _rla : _ut
    tat = _ra ? _rla : _at2
    if kl_lon_en
        lb1 = kl_draw(tlt, _flh, _rl, kl_t("Lon-H","London High", kl_fx_sh), kl_lon_cv)
        lb2 = kl_draw(tlt, _fll, _rl, kl_t("Lon-L","London Low",  kl_fx_sh), kl_lon_cv)
        lb3 = kl_draw(tlt, _flo, _rl, kl_t("Lon-O","London Open", kl_fx_sh), kl_lon_cv)
        if kl_merge
            kl_mrg(_pa,_la,_flh,lb1,kl_lon_cv)
            kl_mrg(_pa,_la,_fll,lb2,kl_lon_cv)
            kl_mrg(_pa,_la,_flo,lb3,kl_lon_cv)
    if kl_us_en
        lb1 = kl_draw(tut, _fuh, _rl, kl_t("NY-H","New York High", kl_fx_sh), kl_us_cv)
        lb2 = kl_draw(tut, _ful, _rl, kl_t("NY-L","New York Low",  kl_fx_sh), kl_us_cv)
        lb3 = kl_draw(tut, _fuo, _rl, kl_t("NY-O","New York Open", kl_fx_sh), kl_us_cv)
        if kl_merge
            kl_mrg(_pa,_la,_fuh,lb1,kl_us_cv)
            kl_mrg(_pa,_la,_ful,lb2,kl_us_cv)
            kl_mrg(_pa,_la,_fuo,lb3,kl_us_cv)
    if kl_as_en
        lb1 = kl_draw(tat, _fah, _rl, kl_t("AS-H","Asia High", kl_fx_sh), kl_as_cv)
        lb2 = kl_draw(tat, _fal, _rl, kl_t("AS-L","Asia Low",  kl_fx_sh), kl_as_cv)
        lb3 = kl_draw(tat, _fao, _rl, kl_t("AS-O","Asia Open", kl_fx_sh), kl_as_cv)
        if kl_merge
            kl_mrg(_pa,_la,_fah,lb1,kl_as_cv)
            kl_mrg(_pa,_la,_fal,lb2,kl_as_cv)
            kl_mrg(_pa,_la,_fao,lb3,kl_as_cv)


// ── END ───────────────────────────────────────────────────
