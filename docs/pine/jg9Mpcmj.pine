//@version=6
strategy("MTF EMA Pullback Strategy - Compras y Ventas", overlay = true, max_labels_count = 500, pyramiding = 0, calc_on_every_tick = true, process_orders_on_close = true)

// =========================
// GRUPOS
// =========================
htfGroup = "Temporalidad Mayor"
ltfGroup = "Temporalidad de Entrada"
rsiGroup = "Filtro RSI"
riskGroup = "Riesgo"
sessionGroup = "Sesión"
styleGroup = "Visual"

// =========================
// INPUTS
// =========================
htf1 = input.timeframe("60", "HTF 1", options = ["60", "240", "D"], group = htfGroup)
htf2 = input.timeframe("240", "HTF 2", options = ["60", "240", "D"], group = htfGroup)
htf3 = input.timeframe("D", "HTF 3", options = ["60", "240", "D"], group = htfGroup)
htfEmaLen = input.int(50, "EMA HTF", minval = 1, group = htfGroup)

emaFastLen = input.int(20, "EMA rápida LTF", minval = 1, group = ltfGroup)
emaSlowLen = input.int(50, "EMA lenta LTF", minval = 1, group = ltfGroup)
touchBufferAtr = input.float(0.20, "Buffer toque EMA50 (ATR)", minval = 0.0, step = 0.05, group = ltfGroup)

rsiLen = input.int(14, "RSI", minval = 1, group = rsiGroup)
rsiBuyMin = input.int(50, "RSI mínimo BUY", minval = 0, maxval = 100, group = rsiGroup)
rsiBuyMax = input.int(70, "RSI máximo BUY", minval = 0, maxval = 100, group = rsiGroup)
rsiSellMin = input.int(30, "RSI mínimo SELL", minval = 0, maxval = 100, group = rsiGroup)
rsiSellMax = input.int(50, "RSI máximo SELL", minval = 0, maxval = 100, group = rsiGroup)

atrLen = input.int(14, "ATR", minval = 1, group = riskGroup)
slMult = input.float(1.5, "SL x ATR", minval = 0.1, step = 0.1, group = riskGroup)
tpMult = input.float(2.0, "TP x ATR", minval = 0.1, step = 0.1, group = riskGroup)

sessionInput = input.session("1100-0000", "Horario NYC", group = sessionGroup)
timezone = "America/New_York"
showSessionBg = input.bool(true, "Mostrar fondo de sesión", group = styleGroup)

bullColor = input.color(#089981, "Color BUY", group = styleGroup)
bearColor = input.color(#f23645, "Color SELL", group = styleGroup)
emaFastColor = input.color(#5b9cf6, "Color EMA rápida", group = styleGroup)
emaSlowBaseColor = input.color(#808080, "Color EMA lenta", group = styleGroup)

// =========================
// SESIÓN
// =========================
inSession = not na(time(timeframe.period, sessionInput, timezone))

// =========================
// INDICADORES LTF
// =========================
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsiVal = ta.rsi(close, rsiLen)
atrVal = ta.atr(atrLen)

crossUp = ta.crossover(emaFast, emaSlow)
crossDown = ta.crossunder(emaFast, emaSlow)

touchLong = low <= emaSlow + atrVal * touchBufferAtr and close >= emaSlow
touchShort = high >= emaSlow - atrVal * touchBufferAtr and close <= emaSlow

// =========================
// CONTEXTO HTF
// =========================
f_htfContext(_tf) =>
    [c, e] = request.security(syminfo.tickerid, _tf, [close, ta.ema(close, htfEmaLen)], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
    bull = c > e
    bear = c < e
    [bull, bear]

[bull1, bear1] = f_htfContext(htf1)
[bull2, bear2] = f_htfContext(htf2)
[bull3, bear3] = f_htfContext(htf3)

allBull = bull1 and bull2 and bull3
allBear = bear1 and bear2 and bear3

// =========================
// SEÑALES
// =========================
rawLongSignal = allBull and touchLong and crossUp and rsiVal >= rsiBuyMin and rsiVal <= rsiBuyMax and inSession
rawShortSignal = allBear and touchShort and crossDown and rsiVal >= rsiSellMin and rsiVal <= rsiSellMax and inSession

longCondition = rawLongSignal
shortCondition = rawShortSignal

// =========================
// ÓRDENES
// =========================
if longCondition and strategy.position_size == 0
    slPrice = close - atrVal * slMult
    tpPrice = close + atrVal * tpMult
    strategy.entry("Long", strategy.long)
    strategy.exit("Salir Long", from_entry = "Long", stop = slPrice, limit = tpPrice)

if shortCondition and strategy.position_size == 0
    slPrice = close + atrVal * slMult
    tpPrice = close - atrVal * tpMult
    strategy.entry("Short", strategy.short)
    strategy.exit("Salir Short", from_entry = "Short", stop = slPrice, limit = tpPrice)

// =========================
// VISUAL
// =========================
plot(emaFast, "EMA 20", color = emaFastColor)
plot(emaSlow, "EMA 50", color = color.new(emaSlowBaseColor, 30))
bgcolor(showSessionBg and inSession ? color.new(#5b9cf6, 90) : na)

plotshape(longCondition, title = "BUY", location = location.belowbar, style = shape.triangleup, color = bullColor, size = size.small, text = "BUY", textcolor = bullColor)
plotshape(shortCondition, title = "SELL", location = location.abovebar, style = shape.triangledown, color = bearColor, size = size.small, text = "SELL", textcolor = bearColor)