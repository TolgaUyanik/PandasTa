// ============================================================================
//  QuantLine · Bottom Indicator Lite  (PUBLIC / EDUCATIONAL VERSION)
// ----------------------------------------------------------------------------
//  Simplified public "bottoming process" scoreboard. Counts 5 PUBLIC price/
//  volume exhaustion conditions into score X/5. No on-chain data, no proprietary
//  calibration. Best on Daily / Weekly. Context / education only — NOT a buy
//  signal. Open-source. Not financial advice.
//
//  House Rules: English UI. Publish with a CLEAN chart (this script only).
// ============================================================================
//@version=6
indicator("QuantLine Bottom Indicator Lite", shorttitle="QLSbi", overlay=true)

maLen     = input.int(200, "Long MA (Mayer)", minval=20, tooltip="Classic 200 on Daily. Mayer = price / MA.")
mayerThr  = input.float(0.8, "Lamp 1 · Mayer ≤", step=0.05, tooltip="Price below 0.8×MA = deep undervaluation proxy.")
rsiLen    = input.int(14,  "RSI length", minval=2)
rsiHTF    = input.string("W", "Lamp 2 · RSI timeframe", options=["D","W","M"])
rsiThr    = input.float(35, "Lamp 2 · RSI(HTF) ≤", step=1, tooltip="Higher-TF oversold proxy.")
volLen    = input.int(20,  "Volume MA length", minval=2)
volMult   = input.float(2.0, "Lamp 3 · volume spike ≥ ×avg", step=0.1, tooltip="Large volume on a red candle = capitulation proxy.")
ddLen     = input.int(200, "Drawdown lookback", minval=10)
ddThr     = input.float(40, "Lamp 4 · drawdown from high ≥ %", step=1)
bbLen     = input.int(20,  "Bollinger length", minval=2)
bbMult    = input.float(2.0,"Bollinger ×StDev", step=0.1)
alertScore= input.int(3,   "Highlight / alert when score ≥", minval=1, maxval=5)
showBG    = input.bool(true,"Background tint when exhausted")
tblPos    = input.string("top_right","Table position", options=["top_right","top_left","bottom_right","bottom_left"])

ma     = ta.sma(close, maLen)
mayer  = close / math.max(ma, 1e-9)
lamp1  = mayer <= mayerThr

htfRSI = request.security(syminfo.tickerid, rsiHTF, ta.rsi(close, rsiLen))
lamp2  = htfRSI <= rsiThr

volMA  = ta.sma(volume, volLen)
volRat = volume / math.max(volMA, 1e-9)
lamp3  = (volRat >= volMult) and (close < open)

hiN    = ta.highest(high, ddLen)
ddPct  = (close / math.max(hiN, 1e-9) - 1.0) * 100.0
lamp4  = ddPct <= -ddThr

basis  = ta.sma(close, bbLen)
dev    = bbMult * ta.stdev(close, bbLen)
lower  = basis - dev
belowP = (close / math.max(lower, 1e-9) - 1.0) * 100.0
lamp5  = close < lower

score  = (lamp1?1:0) + (lamp2?1:0) + (lamp3?1:0) + (lamp4?1:0) + (lamp5?1:0)
scoreCol = score >= 4 ? color.new(color.lime, 0) : score >= alertScore ? color.new(#7CFC00, 0) : score >= 1 ? color.new(color.orange, 0) : color.new(color.gray, 0)
bgcolor(showBG and score >= alertScore ? color.new(color.green, 90) : na)

f_pos(p) => p=="top_left" ? position.top_left : p=="bottom_right" ? position.bottom_right : p=="bottom_left" ? position.bottom_left : position.top_right
dot(b)  => b ? "●" : "○"
dcol(b) => b ? color.new(color.lime,0) : color.new(color.gray,30)

var table tbl = table.new(f_pos(tblPos), 4, 8, bgcolor=color.new(color.black, 10), frame_color=color.new(color.gray, 40), frame_width=2, border_color=color.new(color.gray, 70), border_width=1)
if barstate.islast
    blk = color.new(color.black, 10)
    table.cell(tbl, 0, 0, "🔻 QLS Bottom · Lite", text_color=color.white, bgcolor=blk, text_size=size.small)
    table.cell(tbl, 1, 0, "", bgcolor=blk)
    table.cell(tbl, 2, 0, "score", text_color=color.silver, bgcolor=blk, text_size=size.tiny)
    table.cell(tbl, 3, 0, str.tostring(score) + "/5", text_color=scoreCol, bgcolor=blk, text_size=size.large)

    table.cell(tbl, 0, 1, "1 Undervaluation (Mayer)", text_color=color.silver, text_size=size.tiny)
    table.cell(tbl, 1, 1, str.tostring(mayer, "0.00"), text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 2, 1, "≤" + str.tostring(mayerThr, "0.00"), text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 3, 1, dot(lamp1), text_color=dcol(lamp1), text_size=size.large)

    table.cell(tbl, 0, 2, "2 Oversold " + rsiHTF + "-RSI", text_color=color.silver, text_size=size.tiny)
    table.cell(tbl, 1, 2, str.tostring(htfRSI, "#"), text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 2, 2, "≤" + str.tostring(rsiThr, "#"), text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 3, 2, dot(lamp2), text_color=dcol(lamp2), text_size=size.large)

    table.cell(tbl, 0, 3, "3 Volume capitulation", text_color=color.silver, text_size=size.tiny)
    table.cell(tbl, 1, 3, str.tostring(volRat, "0.0") + "×", text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 2, 3, "≥" + str.tostring(volMult, "0.0") + "×↓", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 3, 3, dot(lamp3), text_color=dcol(lamp3), text_size=size.large)

    table.cell(tbl, 0, 4, "4 Drawdown from high", text_color=color.silver, text_size=size.tiny)
    table.cell(tbl, 1, 4, str.tostring(ddPct, "#") + "%", text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 2, 4, "≤-" + str.tostring(ddThr, "#") + "%", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 3, 4, dot(lamp4), text_color=dcol(lamp4), text_size=size.large)

    table.cell(tbl, 0, 5, "5 Stretch (lower BB)", text_color=color.silver, text_size=size.tiny)
    table.cell(tbl, 1, 5, str.tostring(belowP, "#") + "%", text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 2, 5, "< band", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 3, 5, dot(lamp5), text_color=dcol(lamp5), text_size=size.large)

    state = score >= 4 ? "deep exhaustion" : score >= alertScore ? "exhaustion building — watch" : score >= 1 ? "partial" : "no bottom signs"
    table.cell(tbl, 0, 6, state, text_color=scoreCol, text_size=size.tiny)
    table.cell(tbl, 1, 6, "", text_size=size.tiny)
    table.cell(tbl, 2, 6, "", text_size=size.tiny)
    table.cell(tbl, 3, 6, "", text_size=size.tiny)

    table.cell(tbl, 0, 7, "Lite · not a signal", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 3, 7, "not financial advice", text_color=color.gray, text_size=size.tiny)

flipOn = ta.crossover(score, alertScore - 0.5)
plotshape(flipOn, title="bottom-watch", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.tiny)

alertcondition(flipOn, "QLS Bottom: exhaustion", "QLS Bottom Lite: score hit exhaustion threshold — watch only, not an entry")