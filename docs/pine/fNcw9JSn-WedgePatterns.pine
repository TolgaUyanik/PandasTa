//@version=6

// @description Library for detecting Wedge patterns (Rising and Falling Wedges)
library("WedgePatterns", overlay=true)

// ==================== TYPES ====================

// @type WedgeResult
// @field isValid (bool) Whether a valid pattern was found
// @field patternType (string) Type of pattern detected ("rising" or "falling")
// @field isBullish (bool) Whether the pattern is bullish (falling wedge) or bearish (rising wedge)
// @field allPivotBars (array<int>) All pivot bars used in the pattern (for overlap detection)
// @field firstHighBar (int) First high bar for upper trendline
// @field lastHighBar (int) Last high bar for upper trendline  
// @field firstLowBar (int) First low bar for lower trendline
// @field lastLowBar (int) Last low bar for lower trendline
// @field firstHigh (float) First high price for upper trendline
// @field lastHigh (float) Last high price for upper trendline
// @field firstLow (float) First low price for lower trendline
// @field lastLow (float) Last low price for lower trendline
// @field patternLength (int) Number of pivots in the wedge
// @field convergenceRatio (float) Quality score of convergence
// @field volumeConfirmed (bool) Whether volume decreases during pattern
export type WedgeResult
    bool isValid
    string patternType
    bool isBullish
    array<int> allPivotBars
    int firstHighBar
    int lastHighBar
    int firstLowBar
    int lastLowBar
    float firstHigh
    float lastHigh
    float firstLow
    float lastLow
    int patternLength
    float convergenceRatio
    bool volumeConfirmed

// ==================== UTILITY FUNCTIONS ====================

// @function Check if volume is decreasing over pattern duration (matches original exactly)
// @param startBar (int) Start bar of the pattern
// @param endBar (int) End bar of the pattern
// @param volumeMaLength (int) Moving average length for volume analysis
// @returns bool True if volume is consistently decreasing
checkVolumeDecreasing(int startBar, int endBar, int volumeMaLength) =>
    int patternDuration = endBar - startBar
    
    if patternDuration < volumeMaLength * 2
        false
    else
        float startVolumeMA = 0.0
        int startOffset = bar_index - startBar
        
        if startOffset >= 0 and startOffset < 5000
            for i = 0 to volumeMaLength - 1
                startVolumeMA := startVolumeMA + volume[startOffset + i]
            startVolumeMA := startVolumeMA / volumeMaLength
        else
            startVolumeMA := na
        
        // Calculate current volume MA
        float endVolumeMA = 0.0
        for i = 0 to volumeMaLength - 1
            endVolumeMA := endVolumeMA + volume[i]
        endVolumeMA := endVolumeMA / volumeMaLength
        
        // Check for decreasing trend
        bool volumeDecreasing = not na(startVolumeMA) and not na(endVolumeMA) and endVolumeMA < startVolumeMA
        
        // Additional consistency check
        bool consistentDecrease = true
        int checkPoints = 3
        
        if patternDuration >= checkPoints * volumeMaLength
            array<float> volumePoints = array.new<float>()
            
            for j = 0 to checkPoints - 1
                int sampleBar = math.round(startBar + (patternDuration * j / (checkPoints - 1)))
                int sampleOffset = bar_index - sampleBar
                
                if sampleOffset >= 0 and sampleOffset < 5000
                    float sampleVolumeMA = 0.0
                    for k = 0 to volumeMaLength - 1
                        if sampleOffset + k < 5000
                            sampleVolumeMA := sampleVolumeMA + volume[sampleOffset + k]
                    sampleVolumeMA := sampleVolumeMA / volumeMaLength
                    array.push(volumePoints, sampleVolumeMA)
            
            // Verify decreasing trend
            if array.size(volumePoints) >= 2
                for i = 1 to array.size(volumePoints) - 1
                    if array.get(volumePoints, i) >= array.get(volumePoints, i - 1)
                        consistentDecrease := false
                        break
        
        volumeDecreasing and consistentDecrease

// @function Detect wedge pattern from pivot data
// @param pivotValues (array<float>) Array of pivot values (must have at least 6 points)
// @param pivotBars (array<int>) Array of pivot bar indices
// @param volumeMaLength (int) Moving average length for volume analysis
// @param maxPivotsToCheck (int) Maximum number of pivots to analyze
// @returns WedgeResult Pattern detection result
export detectPattern(array<float> pivotValues, array<int> pivotBars, int volumeMaLength, int maxPivotsToCheck = 12) =>
    WedgeResult result = WedgeResult.new()
    result.isValid := false
    result.allPivotBars := array.new<int>()
    
    if array.size(pivotValues) < 6
        result
    else
        // Variables to track the best wedge found
        int bestWedgeStart = -1
        int bestWedgeEnd = -1
        string bestWedgeType = ""
        float bestConvergenceRatio = 0.0
        bool bestVolumeConfirm = false
        
        // Check all possible wedge lengths starting from 6 pivots
        int maxPivotsCheck = math.min(array.size(pivotValues), maxPivotsToCheck)
        
        for wedgeLength = 6 to maxPivotsCheck
            int wedgeStartIndex = array.size(pivotValues) - wedgeLength
            int wedgeEndIndex = array.size(pivotValues) - 1
            
            // Extract pivot points for current wedge length
            array<float> wedgePivots = array.new<float>()
            array<int> wedgeBars = array.new<int>()
            
            for k = wedgeStartIndex to wedgeEndIndex
                array.push(wedgePivots, array.get(pivotValues, k))
                array.push(wedgeBars, array.get(pivotBars, k))
            
            // Determine if pattern starts with high or low
            float firstPivot = array.get(wedgePivots, 0)
            float secondPivot = array.get(wedgePivots, 1)
            bool startsWithHigh = firstPivot > secondPivot
            
            // Separate highs and lows
            array<float> highs = array.new<float>()
            array<float> lows = array.new<float>()
            array<int> highBars = array.new<int>()
            array<int> lowBars = array.new<int>()
            
            for m = 0 to array.size(wedgePivots) - 1
                bool isHighPivot = startsWithHigh ? (m % 2 == 0) : (m % 2 == 1)
                
                if isHighPivot
                    array.push(highs, array.get(wedgePivots, m))
                    array.push(highBars, array.get(wedgeBars, m))
                else
                    array.push(lows, array.get(wedgePivots, m))
                    array.push(lowBars, array.get(wedgeBars, m))
            
            // Need at least 3 highs and 3 lows for a valid wedge
            if array.size(highs) >= 3 and array.size(lows) >= 3
                // Get first and last points for trendlines
                float firstHigh = array.get(highs, 0)
                float lastHigh = array.get(highs, array.size(highs) - 1)
                int firstHighBar = array.get(highBars, 0)
                int lastHighBar = array.get(highBars, array.size(highBars) - 1)
                
                float firstLow = array.get(lows, 0)
                float lastLow = array.get(lows, array.size(lows) - 1)
                int firstLowBar = array.get(lowBars, 0)
                int lastLowBar = array.get(lowBars, array.size(lowBars) - 1)
                
                // STRICT VALIDATION: Check if this could be a valid wedge structure
                // Calculate trendline slopes
                int highBarDelta = lastHighBar - firstHighBar
                int lowBarDelta = lastLowBar - firstLowBar
                
                // Prevent division by zero
                if highBarDelta == 0 or lowBarDelta == 0
                    continue
                
                float highSlope = (lastHigh - firstHigh) / highBarDelta
                float lowSlope = (lastLow - firstLow) / lowBarDelta
                
                // STRICT CONVERGENCE CHECK
                float initialSpread = math.abs(firstHigh - firstLow)
                float finalSpread = math.abs(lastHigh - lastLow)
                
                // Must have meaningful convergence (at least 20% reduction)
                if initialSpread <= 0 or finalSpread >= initialSpread * 0.8
                    continue
                
                float convergenceRatio = finalSpread / initialSpread
                
                // STRICT WEDGE TYPE VALIDATION
                bool isValidRisingWedge = false
                bool isValidFallingWedge = false
                
                // Rising wedge: both slopes positive, upper slope less steep, converging upward
                if highSlope > 0 and lowSlope > 0 and highSlope < lowSlope
                    // Validate that highs and lows are actually rising
                    bool highsRising = true
                    bool lowsRising = true
                    
                    for n = 1 to array.size(highs) - 1
                        if array.get(highs, n) < array.get(highs, n - 1)
                            highsRising := false
                            break
                    
                    for n = 1 to array.size(lows) - 1
                        if array.get(lows, n) < array.get(lows, n - 1)
                            lowsRising := false
                            break
                    
                    isValidRisingWedge := highsRising and lowsRising
                
                // Falling wedge: both slopes negative, upper slope less steep, converging downward
                else if highSlope < 0 and lowSlope < 0 and highSlope < lowSlope
                    // Validate that highs and lows are actually falling (matches original)
                    bool highsFalling = true
                    bool lowsFalling = true
                    
                    for n = 1 to array.size(highs) - 1
                        if array.get(highs, n) > array.get(highs, n - 1)
                            highsFalling := false
                            break
                    
                    for n = 1 to array.size(lows) - 1
                        if array.get(lows, n) > array.get(lows, n - 1)
                            lowsFalling := false
                            break
                    
                    isValidFallingWedge := highsFalling and lowsFalling
                
                // Skip if not a valid wedge type
                if not isValidRisingWedge and not isValidFallingWedge
                    continue
                
                // STRICT TRENDLINE ADHERENCE CHECK
                bool allPointsValid = true
                float tolerancePercent = 0.03  // 3% tolerance
                
                // Check that ALL intermediate high points are close to the high trendline
                for n = 1 to array.size(highs) - 2  // Skip first and last (they define the line)
                    float checkHigh = array.get(highs, n)
                    int checkHighBar = array.get(highBars, n)
                    
                    // Calculate expected value on trendline
                    float progress = (checkHighBar - firstHighBar) / highBarDelta
                    float expectedHigh = firstHigh + (lastHigh - firstHigh) * progress
                    float tolerance = math.abs(expectedHigh) * tolerancePercent
                    
                    // For wedges, points should be very close to trendlines
                    if math.abs(checkHigh - expectedHigh) > tolerance
                        allPointsValid := false
                        break
                
                // Check that ALL intermediate low points are close to the low trendline
                if allPointsValid
                    for n = 1 to array.size(lows) - 2  // Skip first and last
                        float checkLow = array.get(lows, n)
                        int checkLowBar = array.get(lowBars, n)
                        
                        // Calculate expected value on trendline
                        float progress = (checkLowBar - firstLowBar) / lowBarDelta
                        float expectedLow = firstLow + (lastLow - firstLow) * progress
                        float tolerance = math.abs(expectedLow) * tolerancePercent
                        
                        if math.abs(checkLow - expectedLow) > tolerance
                            allPointsValid := false
                            break
                
                // VOLUME CONFIRMATION
                bool volumeConfirms = false
                if allPointsValid
                    int firstBar = array.get(wedgeBars, 0)
                    int lastBar = array.get(wedgeBars, array.size(wedgeBars) - 1)
                    volumeConfirms := checkVolumeDecreasing(firstBar, lastBar, volumeMaLength)
                
                // CALCULATE FINAL PATTERN QUALITY SCORE
                if allPointsValid and volumeConfirms  // Require volume confirmation
                    string wedgeType = isValidRisingWedge ? "rising" : "falling"
                    
                    // Score based on: length, convergence quality, and volume confirmation
                    float lengthScore = wedgeLength / 6.0  // Normalize to 6-pivot baseline
                    float convergenceScore = 1.0 - convergenceRatio  // Better convergence = higher score
                    float volumeScore = volumeConfirms ? 1.0 : 0.0
                    
                    float patternQuality = lengthScore * convergenceScore * volumeScore
                    
                    // Check if this is the best wedge so far (must beat previous score significantly)
                    if patternQuality > bestConvergenceRatio + 0.1  // Require meaningful improvement
                        bestWedgeStart := wedgeStartIndex
                        bestWedgeEnd := wedgeEndIndex
                        bestWedgeType := wedgeType
                        bestConvergenceRatio := patternQuality
                        bestVolumeConfirm := volumeConfirms
        
        // Set result if valid wedge found (matches original output structure)
        if bestWedgeStart >= 0 and bestWedgeEnd >= 0 and bestConvergenceRatio > 0.1
            // Extract the best wedge data for trendline endpoints
            array<float> bestPivots = array.new<float>()
            array<int> bestPivotBars = array.new<int>()
            
            for k = bestWedgeStart to bestWedgeEnd
                array.push(bestPivots, array.get(pivotValues, k))
                array.push(bestPivotBars, array.get(pivotBars, k))
            
            // Separate highs and lows for the best wedge to get trendline endpoints
            float firstPivot = array.get(bestPivots, 0)
            float secondPivot = array.get(bestPivots, 1)
            bool startsWithHigh = firstPivot > secondPivot
            
            array<float> bestHighs = array.new<float>()
            array<float> bestLows = array.new<float>()
            array<int> bestHighBars = array.new<int>()
            array<int> bestLowBars = array.new<int>()
            
            for m = 0 to array.size(bestPivots) - 1
                bool isHighPivot = startsWithHigh ? (m % 2 == 0) : (m % 2 == 1)
                
                if isHighPivot
                    array.push(bestHighs, array.get(bestPivots, m))
                    array.push(bestHighBars, array.get(bestPivotBars, m))
                else
                    array.push(bestLows, array.get(bestPivots, m))
                    array.push(bestLowBars, array.get(bestPivotBars, m))
            
            // Get trendline endpoints
            float firstHigh = array.get(bestHighs, 0)
            float lastHigh = array.get(bestHighs, array.size(bestHighs) - 1)
            int firstHighBar = array.get(bestHighBars, 0)
            int lastHighBar = array.get(bestHighBars, array.size(bestHighBars) - 1)
            
            float firstLow = array.get(bestLows, 0)
            float lastLow = array.get(bestLows, array.size(bestLows) - 1)
            int firstLowBar = array.get(bestLowBars, 0)
            int lastLowBar = array.get(bestLowBars, array.size(bestLowBars) - 1)
            
            bool isBullishPattern = bestWedgeType == "falling"
            
            // Set result
            result.isValid := true
            result.patternType := bestWedgeType
            result.isBullish := isBullishPattern
            result.allPivotBars := array.copy(bestPivotBars)
            result.firstHighBar := firstHighBar
            result.lastHighBar := lastHighBar
            result.firstLowBar := firstLowBar
            result.lastLowBar := lastLowBar
            result.firstHigh := firstHigh
            result.lastHigh := lastHigh
            result.firstLow := firstLow
            result.lastLow := lastLow
            result.patternLength := array.size(bestPivots)
            result.convergenceRatio := bestConvergenceRatio
            result.volumeConfirmed := bestVolumeConfirm
        
        result
