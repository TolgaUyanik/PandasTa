//@version=6
library("CoreMACDHTF", false)

// ——— SECTION: Constants & Enums
string GROUP_INPUTS = "Inputs"
string GROUP_DISPLAY = "Display"
string GROUP_FILTER = "Filter"
const int MS_IN_MIN = 60 * 1000
const int MS_IN_HOUR = MS_IN_MIN * 60
const int MS_IN_DAY = MS_IN_HOUR * 24

// ——— SECTION: Inputs (Demo/Standalone-Use)
src_input = input.source(close, "Source", group=GROUP_INPUTS, inline="core", tooltip="Input data for MACD.")
preset_input = input.string("3,10,16", "Preset", options=["3,10,16","12,26,9"], group=GROUP_INPUTS, inline="core", tooltip="Preset A=3/10/16, B=12/26/9.")
table_position_input = input.string("top_right", "Table Position", options=["top_left","top_center","top_right","middle_left","middle_center","middle_right","bottom_left","bottom_center","bottom_right"], group=GROUP_DISPLAY, inline="tbl", tooltip="Anchor position for info table.")
table_size_input = input.string("normal", "Table Size", options=["auto","tiny","small","normal","large","huge"], group=GROUP_DISPLAY, inline="tbl", tooltip="Text size for the info table.")
is_dark_mode_input = input.bool(true, "Dark Mode", group=GROUP_DISPLAY, inline="tbl", tooltip="Toggle dark/light table theme.")
show_table_input = input.bool(true, "Show Table", group=GROUP_DISPLAY, inline="tbl", tooltip="Show or hide the info table.")
eps_zero_input = input.float(0.0, "Zero dead-band (epsilon)", step=0.0001, group=GROUP_FILTER, inline="flt", tooltip="±epsilon around 0 for MACD/Histogram classification.")
accept_bars_input = input.int(3, "Acceptance bars (n)", minval=1, group=GROUP_FILTER, inline="flt", tooltip="Regime becomes valid after n consecutive bars.")

// ——— SECTION: Persistent Vars → Runtime Vars
var table info_table = na

// ——— SECTION: Helpers (pure, no side effects)
size_from_string(s) =>
    s == "auto" ? size.auto : s == "tiny" ? size.tiny : s == "small" ? size.small : s == "large" ? size.large : s == "huge" ? size.huge : size.normal

pos_from_string(s) =>
    s == "top_left" ? position.top_left : s == "top_center" ? position.top_center : s == "top_right" ? position.top_right : s == "middle_left" ? position.middle_left : s == "middle_center" ? position.middle_center : s == "middle_right" ? position.middle_right : s == "bottom_left" ? position.bottom_left : s == "bottom_center" ? position.bottom_center : position.bottom_right

autotimeframe() =>
    int tf_in_sec = timeframe.in_seconds(timeframe.period)
    int tf_in_ms = tf_in_sec * 1000
    simple string step = switch
        tf_in_ms <= MS_IN_MIN => "60"
        tf_in_ms <= MS_IN_MIN * 5 => "240"
        tf_in_ms <= MS_IN_HOUR => "1D"
        tf_in_ms <= MS_IN_HOUR * 4 => "3D"
        tf_in_ms <= MS_IN_HOUR * 12 => "7D"
        tf_in_ms <= MS_IN_DAY => "1M"
        tf_in_ms <= MS_IN_DAY * 7 => "3M"
        => "12M"
    step

resolve_lengths(simple string preset_str) =>
    simple string bucket = autotimeframe()
    simple int f = 0
    simple int s = 0
    simple int g = 0
    simple string tag = ""
