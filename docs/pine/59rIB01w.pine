    [f, s, g, tag]

regime_desc(r) =>
    r == 0 ? "Neutral (within ±epsilon)" : r == 1 ? "Bullish (MACD > 0, Hist > 0)" : r == 2 ? "Weak Bull (MACD > 0, Hist < 0)" : r == 3 ? "Bearish (MACD < 0, Hist < 0)" : r == 4 ? "Weak Bear (MACD < 0, Hist > 0)" : "Invalid"

as_float(cond) =>
    cond ? 1.0 : 0.0

smoother(float src, int len) =>
    var float wrk = na
    var float wrk2 = na
    var float wrk4 = na
    var float wrk0 = 0.0
    var float wrk1 = 0.0
    var float wrk3 = 0.0
    float alpha = 0.45 * (len - 1.0) / (0.45 * (len - 1.0) + 2.0)
    wrk0 := src + alpha * (nz(wrk[1]) - src)
    wrk1 := (src - nz(wrk)) * (1.0 - alpha) + alpha * nz(wrk1[1])
    wrk2 := wrk0 + wrk1
    wrk3 := (wrk2 - nz(wrk4[1])) * math.pow(1.0 - alpha, 2.0) + math.pow(alpha, 2.0) * nz(wrk3[1])
    wrk4 := wrk3 + nz(wrk4[1])
    wrk := src
    wrk4

// ——— SECTION: Exports
export calc_macd_htf(float src, simple string preset_str, int smooth_len) =>
    [fast_len, slow_len, signal_len, tf_tag] = resolve_lengths(preset_str)
    fast_ma = ta.ema(src, fast_len)
    slow_ma = ta.ema(src, slow_len)
    macd = fast_ma - slow_ma
    signal = ta.ema(macd, signal_len)
    hist = macd - signal
    hist_sm = smoother(hist, smooth_len)
    [macd, signal, hist_sm, fast_len, slow_len, signal_len, tf_tag]

export is_hist_rising(float src, simple string preset_str, int smooth_len) =>
    [macd, signal, hist_sm, fast_len, slow_len, signal_len, tf_tag] = calc_macd_htf(src, preset_str, smooth_len)
    na(hist_sm[1]) ? true : hist_sm > hist_sm[1]

export hist_rising_01(float src, simple string preset_str, int smooth_len) =>
    is_hist_rising(src, preset_str, smooth_len) ? 1.0 : 0.0

// ——— SECTION: Core Calculations (Demo)
pos = pos_from_string(table_position_input)
tsize = size_from_string(table_size_input)
bg_color = is_dark_mode_input ? color.new(color.black, 20) : color.new(color.white, 20)
header_bg = is_dark_mode_input ? color.new(color.blue, 50) : color.new(color.gray, 50)
text_color = is_dark_mode_input ? color.white : color.black
border_color = color.gray

len = input(9)
[macd, signal, hist, fast_len, slow_len, signal_len, tf_tag] = calc_macd_htf(src_input, preset_input, len)

is_hist_up = hist >= 0
is_hist_rising_demo = na(hist[1]) ? true : hist > hist[1]
plot(is_hist_rising_demo ? 1 : 0, "", color.red)
