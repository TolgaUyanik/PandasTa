        tag := "A(3/10/16) "
        if bucket == "60"
            f := 173
            s := 598
            g := 959
            tag += "1m->60m"
        else if bucket == "240"
            if timeframe.isminutes and timeframe.multiplier == 2
                f := 346
                s := 1196
                g := 1917
                tag += "2m->240m"
