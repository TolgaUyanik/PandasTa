//@version=6
indicator(
     "Universal Spot–Perpetual Divergence v6",
     shorttitle="Universal SPD v6",
     overlay=false,
     max_labels_count=500,
     dynamic_requests=true
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// MARKET PAIRING
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
groupMarkets = "Market Pairing"

pairMode = input.string(
     "Automatic TradingView .P Pair",
     "Pairing Mode",
     options=["Automatic TradingView .P Pair", "Manual Comparison Symbol"],
     group=groupMarkets
)

manualComparisonSymbol = input.symbol(
     "BINANCE:BTCUSDT",
     "Manual Comparison Symbol",
     group=groupMarkets
)

marketTypeOverride = input.string(
     "Auto",
     "Chart Market Type",
     options=["Auto", "Spot", "Perpetual"],
     group=groupMarkets
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// EVENT DIVERGENCE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
groupEvent = "Event Divergence"

eventLookback = input.int(
     12,
     "Event Lookback Bars",
     minval=1,
     maxval=500,
     group=groupEvent,
     tooltip="Compares spot and perpetual movement over this many chart bars. On a 30-minute chart, 12 bars represents six hours."
)

minimumDifference = input.float(
     0.50,
     "Minimum Divergence (%)",
     minval=0.01,
     step=0.05,
     group=groupEvent
)

signalMode = input.string(
     "Threshold Cross",
     "Signal Mode",
     options=["Threshold Cross", "Every New Extreme"],
     group=groupEvent,
     tooltip="Threshold Cross prints once when divergence first exceeds the threshold. Every New Extreme can print again when divergence expands by the selected rearm amount."
)

extremeRearm = input.float(
     0.15,
     "New Extreme Rearm (%)",
     minval=0.01,
     step=0.05,
     group=groupEvent
)

confirmOnClose = input.bool(
     true,
     "Confirm on Candle Close",
     group=groupEvent
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// DETECTION FAMILIES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
groupFamilies = "Detection Families"

showCumulativeClose = input.bool(
     true,
     "Cumulative Close Divergence",
     group=groupFamilies,
     tooltip="Compares spot and perpetual percentage returns over the full event lookback."
)

showDownsideExcursion = input.bool(
     true,
     "Downside Excursion Divergence",
     group=groupFamilies,
     tooltip="Compares each market's lowest price during the event window against its own event starting price."
)

showUpsideExcursion = input.bool(
     true,
     "Upside Excursion Divergence",
     group=groupFamilies,
     tooltip="Compares each market's highest price during the event window against its own event starting price."
)

showSingleBarWick = input.bool(
     true,
     "Single-Bar Wick Divergence",
     group=groupFamilies,
     tooltip="Compares spot and perpetual wick excursions candle by candle."
)

showBasis = input.bool(
     true,
     "Direct Perpetual Premium / Discount",
     group=groupFamilies
)

basisSmoothing = input.int(
     3,
     "Basis EMA Smoothing",
     minval=1,
     maxval=100,
     group=groupFamilies
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// DISPLAY
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
groupDisplay = "Display"

showSignals = input.bool(true, "Show Signals In Oscillator", group=groupDisplay)

showPriceChartSignals = input.bool(
     true,
     "Show Signals On Candle Chart",
     group=groupDisplay,
     tooltip="Prints the same divergence signals on the main candle chart. Enabled by default."
)

showBackground = input.bool(true, "Highlight Active Divergence", group=groupDisplay)
showTable = input.bool(true, "Show Live Table", group=groupDisplay)

tablePositionInput = input.string(
     "Top Right",
     "Table Position",
     options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"],
     group=groupDisplay
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// HELPERS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
f_pct(float currentValue, float referenceValue) =>
    not na(referenceValue) and referenceValue != 0.0 ?
         ((currentValue - referenceValue) / referenceValue) * 100.0 :
         na

f_table_position(string positionName) =>
    switch positionName
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left"  => position.bottom_left
        => position.top_right

f_cross_up(float value, float threshold) =>
    value >= threshold and nz(value[1]) < threshold

f_cross_down(float value, float threshold) =>
    value <= -threshold and nz(value[1]) > -threshold

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// BIDIRECTIONAL SYMBOL DETECTION AND DATA
// Both spot and perpetual are always requested explicitly.
// This makes results identical whether the indicator is opened
// on the spot chart or on the perpetual chart.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
chartTickerIdUpper = str.upper(syminfo.tickerid)
chartTickerUpper = str.upper(syminfo.ticker)

autoPerpetual =
     str.contains(chartTickerIdUpper, ".P") or
     str.contains(chartTickerUpper, "PERP") or
     syminfo.type == "futures"

chartIsPerpetual =
     marketTypeOverride == "Perpetual" ? true :
     marketTypeOverride == "Spot" ? false :
     autoPerpetual

// Build one canonical pair independently of chart direction.
automaticSpotSymbol =
     chartIsPerpetual ?
     str.replace_all(syminfo.tickerid, ".P", "") :
     syminfo.tickerid

automaticPerpSymbol =
     chartIsPerpetual ?
     syminfo.tickerid :
     syminfo.tickerid + ".P"

// In manual mode, the chart symbol and selected comparison symbol
// are sorted into spot/perp roles using the detected chart type.
manualSpotSymbol =
     chartIsPerpetual ?
     manualComparisonSymbol :
     syminfo.tickerid

manualPerpSymbol =
     chartIsPerpetual ?
     syminfo.tickerid :
     manualComparisonSymbol

spotSymbol =
     pairMode == "Automatic TradingView .P Pair" ?
     automaticSpotSymbol :
     manualSpotSymbol

perpSymbol =
     pairMode == "Automatic TradingView .P Pair" ?
     automaticPerpSymbol :
     manualPerpSymbol

comparisonSymbol = chartIsPerpetual ? spotSymbol : perpSymbol
tf = timeframe.period

// IMPORTANT:
// Never use the native chart OHLC for one side and request.security()
// for the other side. Both markets are requested in exactly the same
// way, using the same timeframe and barmerge settings.
spotOpen = request.security(
     spotSymbol,
     tf,
     open,
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off
)

spotHigh = request.security(
     spotSymbol,
     tf,
     high,
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off
)

spotLow = request.security(
     spotSymbol,
     tf,
     low,
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off
)

spotClose = request.security(
     spotSymbol,
     tf,
     close,
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off
)

perpOpen = request.security(
     perpSymbol,
     tf,
     open,
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off
)

perpHigh = request.security(
     perpSymbol,
     tf,
     high,
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off
)

perpLow = request.security(
     perpSymbol,
     tf,
     low,
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off
)

perpClose = request.security(
     perpSymbol,
     tf,
     close,
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off
)

dataAvailable =
     not na(spotOpen) and
     not na(spotHigh) and
     not na(spotLow) and
     not na(spotClose) and
     not na(perpOpen) and
     not na(perpHigh) and
     not na(perpLow) and
     not na(perpClose) and
     spotClose > 0 and
     perpClose > 0

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CORE CALCULATIONS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
spotAnchor = spotClose[eventLookback]
perpAnchor = perpClose[eventLookback]

// Cumulative return divergence.
// Positive = perp performed better than spot.
// Negative = spot performed better than perp.
spotEventReturn = dataAvailable ? f_pct(spotClose, spotAnchor) : na
perpEventReturn = dataAvailable ? f_pct(perpClose, perpAnchor) : na
cumulativeDifference = perpEventReturn - spotEventReturn

// Event downside excursion.
// Positive = spot dropped farther than perp.
spotWindowLow = ta.lowest(spotLow, eventLookback + 1)
perpWindowLow = ta.lowest(perpLow, eventLookback + 1)

spotEventDown = dataAvailable ? f_pct(spotWindowLow, spotAnchor) : na
perpEventDown = dataAvailable ? f_pct(perpWindowLow, perpAnchor) : na
downsideDifference = perpEventDown - spotEventDown

// Event upside excursion.
// Positive = perp rose farther than spot.
// Negative = spot rose farther than perp.
spotWindowHigh = ta.highest(spotHigh, eventLookback + 1)
perpWindowHigh = ta.highest(perpHigh, eventLookback + 1)

spotEventUp = dataAvailable ? f_pct(spotWindowHigh, spotAnchor) : na
perpEventUp = dataAvailable ? f_pct(perpWindowHigh, perpAnchor) : na
upsideDifference = perpEventUp - spotEventUp

// Single-bar wick divergence.
spotBarDown = f_pct(spotLow, spotOpen)
perpBarDown = f_pct(perpLow, perpOpen)
singleBarDownDifference = perpBarDown - spotBarDown

spotBarUp = f_pct(spotHigh, spotOpen)
perpBarUp = f_pct(perpHigh, perpOpen)
singleBarUpDifference = perpBarUp - spotBarUp

// Direct basis.
rawBasis = dataAvailable ? ((perpClose - spotClose) / spotClose) * 100.0 : na
basis = ta.ema(rawBasis, basisSmoothing)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SIGNAL ENGINE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
barConfirmed = not confirmOnClose or barstate.isconfirmed

var float lastPositiveExtreme = 0.0
var float lastNegativeExtreme = 0.0

f_positive_signal(float value) =>
    crossed = f_cross_up(value, minimumDifference)
    expanded = value >= minimumDifference and value >= lastPositiveExtreme + extremeRearm
    signalMode == "Threshold Cross" ? crossed : crossed or expanded

f_negative_signal(float value) =>
    crossed = f_cross_down(value, minimumDifference)
    expanded = value <= -minimumDifference and value <= lastNegativeExtreme - extremeRearm
    signalMode == "Threshold Cross" ? crossed : crossed or expanded

sigCumPositive = barConfirmed and showCumulativeClose and f_positive_signal(cumulativeDifference)
sigCumNegative = barConfirmed and showCumulativeClose and f_negative_signal(cumulativeDifference)

sigDownSpot = barConfirmed and showDownsideExcursion and f_positive_signal(downsideDifference)
sigDownPerp = barConfirmed and showDownsideExcursion and f_negative_signal(downsideDifference)

sigUpPerp = barConfirmed and showUpsideExcursion and f_positive_signal(upsideDifference)
sigUpSpot = barConfirmed and showUpsideExcursion and f_negative_signal(upsideDifference)

sigWickSpotDown = barConfirmed and showSingleBarWick and f_positive_signal(singleBarDownDifference)
sigWickPerpDown = barConfirmed and showSingleBarWick and f_negative_signal(singleBarDownDifference)

sigWickPerpUp = barConfirmed and showSingleBarWick and f_positive_signal(singleBarUpDifference)
sigWickSpotUp = barConfirmed and showSingleBarWick and f_negative_signal(singleBarUpDifference)

currentPositiveExtreme = math.max(
     math.max(cumulativeDifference, downsideDifference),
     math.max(upsideDifference, math.max(singleBarDownDifference, singleBarUpDifference))
)

currentNegativeExtreme = math.min(
     math.min(cumulativeDifference, downsideDifference),
     math.min(upsideDifference, math.min(singleBarDownDifference, singleBarUpDifference))
)

if currentPositiveExtreme < minimumDifference
    lastPositiveExtreme := 0.0
else if currentPositiveExtreme > lastPositiveExtreme
    lastPositiveExtreme := currentPositiveExtreme

if currentNegativeExtreme > -minimumDifference
    lastNegativeExtreme := 0.0
else if currentNegativeExtreme < lastNegativeExtreme
    lastNegativeExtreme := currentNegativeExtreme

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// PLOTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
plot(
     showCumulativeClose ? cumulativeDifference : na,
     "Cumulative Return Difference %",
     color=color.white,
     linewidth=2
)

plot(
     showDownsideExcursion ? downsideDifference : na,
     "Event Downside Difference %",
     color=color.orange,
     linewidth=2
)

plot(
     showUpsideExcursion ? upsideDifference : na,
     "Event Upside Difference %",
     color=color.aqua,
     linewidth=2
)

plot(
     showSingleBarWick ? singleBarDownDifference : na,
     "Single-Bar Downside Wick Difference %",
     color=color.yellow,
     linewidth=1,
     style=plot.style_histogram
)

plot(
     showSingleBarWick ? singleBarUpDifference : na,
     "Single-Bar Upside Wick Difference %",
     color=color.blue,
     linewidth=1,
     style=plot.style_histogram
)

plot(
     showBasis ? basis : na,
     "Direct Perpetual Basis %",
     color=color.purple,
     linewidth=1
)

hline(0.0, "Zero", color=color.new(color.gray, 40))
hline(minimumDifference, "Positive Threshold", color=color.new(color.green, 40))
hline(-minimumDifference, "Negative Threshold", color=color.new(color.red, 40))

activePositive = currentPositiveExtreme >= minimumDifference
activeNegative = currentNegativeExtreme <= -minimumDifference

bgcolor(
     showBackground ?
     activePositive ? color.new(color.green, 89) :
     activeNegative ? color.new(color.red, 89) :
     na :
     na
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SIGNAL LABELS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
highestSeries = math.max(
     math.max(cumulativeDifference, downsideDifference),
     math.max(upsideDifference, math.max(singleBarDownDifference, singleBarUpDifference))
)

lowestSeries = math.min(
     math.min(cumulativeDifference, downsideDifference),
     math.min(upsideDifference, math.min(singleBarDownDifference, singleBarUpDifference))
)

topY = math.max(
     minimumDifference * 1.25,
     nz(ta.highest(highestSeries, 100), minimumDifference) * 1.10
)

bottomY = math.min(
     -minimumDifference * 1.25,
     nz(ta.lowest(lowestSeries, 100), -minimumDifference) * 1.10
)

if showSignals and sigDownSpot
    label.new(
         bar_index, topY, "SD",
         style=label.style_label_down,
         color=color.green,
         textcolor=color.white,
         tooltip="Spot Dropped More: over the selected event window, spot's lowest excursion was at least the threshold deeper than perpetual's. This is the core signal for cases such as spot falling 1.25% more than perp."
    )

if showSignals and sigDownPerp
    label.new(
         bar_index, bottomY, "PD",
         style=label.style_label_up,
         color=color.red,
         textcolor=color.white,
         tooltip="Perp Dropped More: over the selected event window, perpetual's lowest excursion was at least the threshold deeper than spot's."
    )

if showSignals and sigCumPositive
    label.new(
         bar_index, topY, "SC",
         style=label.style_label_down,
         color=color.teal,
         textcolor=color.white,
         tooltip="Spot Cumulative Underperformance: over the selected event window, spot's total return underperformed perpetual by at least the threshold."
    )

if showSignals and sigCumNegative
    label.new(
         bar_index, bottomY, "PC",
         style=label.style_label_up,
         color=color.maroon,
         textcolor=color.white,
         tooltip="Perp Cumulative Underperformance: over the selected event window, perpetual's total return underperformed spot by at least the threshold."
    )

if showSignals and sigUpPerp
    label.new(
         bar_index, topY, "PU",
         style=label.style_circle,
         color=color.aqua,
         textcolor=color.black,
         tooltip="Perp Rose More: over the selected event window, perpetual's upside excursion exceeded spot's by at least the threshold."
    )

if showSignals and sigUpSpot
    label.new(
         bar_index, bottomY, "SU",
         style=label.style_circle,
         color=color.orange,
         textcolor=color.black,
         tooltip="Spot Rose More: over the selected event window, spot's upside excursion exceeded perpetual's by at least the threshold."
    )

if showSignals and sigWickSpotDown
    label.new(
         bar_index, topY, "SW",
         style=label.style_diamond,
         color=color.yellow,
         textcolor=color.black,
         tooltip="Spot Wick Deeper: on this candle, spot printed a downside wick at least the threshold deeper than perpetual."
    )

if showSignals and sigWickPerpDown
    label.new(
         bar_index, bottomY, "PW",
         style=label.style_diamond,
         color=color.red,
         textcolor=color.white,
         tooltip="Perp Wick Deeper: on this candle, perpetual printed a downside wick at least the threshold deeper than spot."
    )

if showSignals and sigWickPerpUp
    label.new(
         bar_index, topY, "P↑",
         style=label.style_circle,
         color=color.blue,
         textcolor=color.white,
         tooltip="Perp Upside Wick Higher: on this candle, perpetual's upside excursion exceeded spot's by at least the threshold."
    )

if showSignals and sigWickSpotUp
    label.new(
         bar_index, bottomY, "S↑",
         style=label.style_circle,
         color=color.orange,
         textcolor=color.black,
         tooltip="Spot Upside Wick Higher: on this candle, spot's upside excursion exceeded perpetual's by at least the threshold."
    )

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CANDLE-CHART SIGNAL LABELS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
if showPriceChartSignals and sigDownSpot
    label.new(bar_index, na, "SD", xloc=xloc.bar_index, yloc=yloc.abovebar,
         style=label.style_label_down, color=color.green, textcolor=color.white,
         size=size.tiny, force_overlay=true,
         tooltip="Spot Dropped More: spot's lowest excursion was deeper than perpetual's by at least the selected threshold.")

if showPriceChartSignals and sigDownPerp
    label.new(bar_index, na, "PD", xloc=xloc.bar_index, yloc=yloc.belowbar,
         style=label.style_label_up, color=color.red, textcolor=color.white,
         size=size.tiny, force_overlay=true,
         tooltip="Perp Dropped More: perpetual's lowest excursion was deeper than spot's by at least the selected threshold.")

if showPriceChartSignals and sigCumPositive
    label.new(bar_index, na, "SC", xloc=xloc.bar_index, yloc=yloc.abovebar,
         style=label.style_label_down, color=color.teal, textcolor=color.white,
         size=size.tiny, force_overlay=true,
         tooltip="Spot Cumulative Underperformance: spot's return underperformed perpetual over the event window.")

if showPriceChartSignals and sigCumNegative
    label.new(bar_index, na, "PC", xloc=xloc.bar_index, yloc=yloc.belowbar,
         style=label.style_label_up, color=color.maroon, textcolor=color.white,
         size=size.tiny, force_overlay=true,
         tooltip="Perp Cumulative Underperformance: perpetual's return underperformed spot over the event window.")

if showPriceChartSignals and sigUpPerp
    label.new(bar_index, na, "PU", xloc=xloc.bar_index, yloc=yloc.abovebar,
         style=label.style_circle, color=color.aqua, textcolor=color.black,
         size=size.tiny, force_overlay=true,
         tooltip="Perp Rose More: perpetual's upside excursion exceeded spot's by at least the threshold.")

if showPriceChartSignals and sigUpSpot
    label.new(bar_index, na, "SU", xloc=xloc.bar_index, yloc=yloc.belowbar,
         style=label.style_circle, color=color.orange, textcolor=color.black,
         size=size.tiny, force_overlay=true,
         tooltip="Spot Rose More: spot's upside excursion exceeded perpetual's by at least the threshold.")

if showPriceChartSignals and sigWickSpotDown
    label.new(bar_index, na, "SW", xloc=xloc.bar_index, yloc=yloc.abovebar,
         style=label.style_diamond, color=color.yellow, textcolor=color.black,
         size=size.tiny, force_overlay=true,
         tooltip="Spot Wick Deeper: spot printed a deeper downside wick than perpetual on this candle.")

if showPriceChartSignals and sigWickPerpDown
    label.new(bar_index, na, "PW", xloc=xloc.bar_index, yloc=yloc.belowbar,
         style=label.style_diamond, color=color.red, textcolor=color.white,
         size=size.tiny, force_overlay=true,
         tooltip="Perp Wick Deeper: perpetual printed a deeper downside wick than spot on this candle.")

if showPriceChartSignals and sigWickPerpUp
    label.new(bar_index, na, "P↑", xloc=xloc.bar_index, yloc=yloc.abovebar,
         style=label.style_circle, color=color.blue, textcolor=color.white,
         size=size.tiny, force_overlay=true,
         tooltip="Perp Upside Wick Higher: perpetual's upside wick exceeded spot's by at least the threshold.")

if showPriceChartSignals and sigWickSpotUp
    label.new(bar_index, na, "S↑", xloc=xloc.bar_index, yloc=yloc.belowbar,
         style=label.style_circle, color=color.orange, textcolor=color.black,
         size=size.tiny, force_overlay=true,
         tooltip="Spot Upside Wick Higher: spot's upside wick exceeded perpetual's by at least the threshold.")

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// LIVE TABLE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var table liveTable = table.new(
     f_table_position(tablePositionInput),
     2,
     14,
     border_width=1
)

if barstate.islast
    if showTable
        table.cell(liveTable, 0, 0, "Universal SPD v6", bgcolor=color.black, text_color=color.white)
        table.cell(liveTable, 1, 0, timeframe.period, bgcolor=color.black, text_color=color.white)

        table.cell(liveTable, 0, 1, "Chart")
        table.cell(liveTable, 1, 1, syminfo.tickerid)

        table.cell(liveTable, 0, 2, "Detected")
        table.cell(liveTable, 1, 2, chartIsPerpetual ? "Perpetual" : "Spot")

        table.cell(liveTable, 0, 3, "Spot symbol")
        table.cell(liveTable, 1, 3, spotSymbol)

        table.cell(liveTable, 0, 4, "Perp symbol")
        table.cell(liveTable, 1, 4, perpSymbol)

        table.cell(liveTable, 0, 5, "Event window")
        table.cell(liveTable, 1, 5, str.tostring(eventLookback) + " bars")

        table.cell(liveTable, 0, 6, "Spot return")
        table.cell(liveTable, 1, 6, str.tostring(spotEventReturn, "#.###") + "%")

        table.cell(liveTable, 0, 7, "Perp return")
        table.cell(liveTable, 1, 7, str.tostring(perpEventReturn, "#.###") + "%")

        table.cell(liveTable, 0, 8, "Cumulative diff")
        table.cell(liveTable, 1, 8, str.tostring(cumulativeDifference, "#.###") + "%")

        table.cell(liveTable, 0, 9, "Spot event low")
        table.cell(liveTable, 1, 9, str.tostring(spotEventDown, "#.###") + "%")

        table.cell(liveTable, 0, 10, "Perp event low")
        table.cell(liveTable, 1, 10, str.tostring(perpEventDown, "#.###") + "%")

        table.cell(
             liveTable, 0, 11, "Downside diff",
             bgcolor=downsideDifference >= minimumDifference ? color.new(color.green, 65) :
                     downsideDifference <= -minimumDifference ? color.new(color.red, 65) :
                     na
        )
        table.cell(
             liveTable, 1, 11,
             str.tostring(downsideDifference, "#.###") + "%",
             bgcolor=downsideDifference >= minimumDifference ? color.new(color.green, 65) :
                     downsideDifference <= -minimumDifference ? color.new(color.red, 65) :
                     na,
             text_color=color.white
        )

        table.cell(liveTable, 0, 12, "Single-bar down")
        table.cell(liveTable, 1, 12, str.tostring(singleBarDownDifference, "#.###") + "%")

        table.cell(liveTable, 0, 13, "Data")
        table.cell(
             liveTable, 1, 13,
             dataAvailable ? "BIDIRECTIONAL OK" : "CHECK PAIR",
             bgcolor=dataAvailable ? color.new(color.green, 70) : color.new(color.red, 40),
             text_color=color.white
        )
    else
        table.clear(liveTable, 0, 0, 1, 13)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ALERTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
alertcondition(sigDownSpot, "Spot Dropped More", "Spot dropped farther than perpetual over the selected event window.")
alertcondition(sigDownPerp, "Perpetual Dropped More", "Perpetual dropped farther than spot over the selected event window.")
alertcondition(sigCumPositive, "Spot Cumulative Underperformance", "Spot underperformed perpetual over the selected event window.")
alertcondition(sigCumNegative, "Perp Cumulative Underperformance", "Perpetual underperformed spot over the selected event window.")
alertcondition(sigUpPerp, "Perpetual Rose More", "Perpetual rose farther than spot over the selected event window.")
alertcondition(sigUpSpot, "Spot Rose More", "Spot rose farther than perpetual over the selected event window.")
alertcondition(sigWickSpotDown, "Spot Wick Deeper", "Spot printed a deeper downside wick than perpetual.")
alertcondition(sigWickPerpDown, "Perp Wick Deeper", "Perpetual printed a deeper downside wick than spot.")
