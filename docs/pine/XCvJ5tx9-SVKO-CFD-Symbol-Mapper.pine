findForwardMappedSymbol(map<string, string> userMappings, map<string, string> fallbackMappings, string chartSymbol) =>
    string result = ""
    if map.contains(userMappings, chartSymbol)
        result := map.get(userMappings, chartSymbol)
    else if map.contains(fallbackMappings, chartSymbol)
        result := map.get(fallbackMappings, chartSymbol)
    result

findFirstSourceForTarget(map<string, string> mappings, string targetSymbol) =>
    string result = ""
    for [sourceSymbol, mappedTarget] in mappings
        if result == "" and mappedTarget == targetSymbol
            result := sourceSymbol
    result

findInverseInMap(map<string, string> mappings, string chartSymbol) =>
    string result = ""
    int separator = str.pos(chartSymbol, ":")
    if not na(separator)
        string prefix = str.substring(chartSymbol, 0, separator)
        string tickerName = str.substring(chartSymbol, separator + 1, str.length(chartSymbol))
        if prefix == "NASDAQ" or prefix == "NYSE" or prefix == "BATS"
            result := findFirstSourceForTarget(mappings, "NASDAQ:" + tickerName)
            if result == ""
                result := findFirstSourceForTarget(mappings, "NYSE:" + tickerName)
            if result == ""
                result := findFirstSourceForTarget(mappings, "BATS:" + tickerName)
        else
            result := findFirstSourceForTarget(mappings, chartSymbol)
    result

findInverseMappedSymbol(map<string, string> userMappings, map<string, string> fallbackMappings, string chartSymbol) =>
    string result = findInverseInMap(userMappings, chartSymbol)
    if result == ""
        result := findInverseInMap(fallbackMappings, chartSymbol)
    result

chartSymbol = normaliseDelayedChartSymbol(formatChartTickerId(syminfo.tickerid))

var map<string, string> userMappings = map.new<string, string>()
var map<string, string> fallbackMappings = map.new<string, string>()
var int mappedCode1 = na
var int mappedCode2 = na

if barstate.isfirst
    loadMappingPairs(userMappings, mappingPairsInput)
    loadFallbackMappings(fallbackMappings)
    string mappedSymbol = isBrokerSymbol(chartSymbol) ? findForwardMappedSymbol(userMappings, fallbackMappings, chartSymbol) : findInverseMappedSymbol(userMappings, fallbackMappings, chartSymbol)
    [firstCode, secondCode] = encodeSymbol(compactTransportSymbol(mappedSymbol))
    mappedCode1 := firstCode
    mappedCode2 := secondCode

plot(mappedCode1, "1st code", display = display.data_window)
plot(mappedCode2, "2nd code", display = display.data_window)
