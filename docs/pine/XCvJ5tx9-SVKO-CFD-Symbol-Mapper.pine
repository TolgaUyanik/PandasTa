//@version=6
indicator("SVKO CFD Symbol Mapper", shorttitle = "Map", overlay = true)

const string ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-:._"
const int BASE = 41
const int CHUNK_LENGTH = 9
const string DEFAULT_MAPPING_PAIRS = "TRADENATION:NVDA.EX = NASDAQ:NVDA\nIG:AAPL = NASDAQ:AAPL"
const string SYMBOL_MAPPINGS_TOOLTIP = "Enter one CFD source = native target pair per line, using complete TradingView ticker IDs. For example: TRADENATION:NVDA.EX = NASDAQ:NVDA or IG:AAPL = NASDAQ:AAPL. SVKO CFD Symbol Mapper resolves the counterpart of the current chart symbol. On IG, Trade Nation and Trade Nation SB CFD charts, it uses a forward lookup to map the broker symbol to its native TradingView symbol. On native TradingView charts, it uses a reverse lookup and returns the first matching CFD symbol. Symbol Mappings are checked first in both directions and override the built in Trade Nation map. Add this indicator to the same chart as a receiving indicator, such as SVKO Info or SVKO CFD Stocks & NQ-ES Real Volume. In that indicator's source settings, select Map: 1st code and Map: 2nd code from this instance. Both codes are required because the counterpart ticker ID is split into two numeric plot values that Pine can pass through input.source(). The receiving indicator joins and decodes them. This indicator stays visually silent and does not request price, volume, fundamentals or any other data from the mapped symbol. If no mapping is found, it sends zero through both codes."

mappingPairsInput = input.text_area(DEFAULT_MAPPING_PAIRS, "Symbol Mappings", tooltip = SYMBOL_MAPPINGS_TOOLTIP, display = display.data_window)

encodeChunk(string chunkText) =>
    int result = 0
    int length = str.length(chunkText)
    if length > CHUNK_LENGTH
        runtime.error("Each encoded symbol chunk must contain 9 characters or fewer.")
    if length > 0
        for i = 0 to length - 1
            string character = str.substring(chunkText, i, i + 1)
            int position = str.pos(ALPHABET, character)
            if na(position)
                runtime.error("Unsupported mapped symbol character: " + character)
            result := result * BASE + position + 1
    result

encodeSymbol(string symbol) =>
    int length = str.length(symbol)
    if length > CHUNK_LENGTH * 2
        runtime.error("Mapped symbol must contain 18 characters or fewer.")
    int splitPosition = math.min(length, CHUNK_LENGTH)
    string firstPart = str.substring(symbol, 0, splitPosition)
    string secondPart = str.substring(symbol, splitPosition, length)
    [encodeChunk(firstPart), encodeChunk(secondPart)]

compactTransportSymbol(string symbol) =>
    str.pos(symbol, "TRADENATIONSB:") == 0 ? "TNSB_" + str.substring(symbol, 14, str.length(symbol)) : str.pos(symbol, "TRADENATION:") == 0 ? "TN_" + str.substring(symbol, 12, str.length(symbol)) : symbol

compactSymbol(string rawSymbol) => str.replace_all(rawSymbol, " ", "")

formatChartTickerId(string tickerId) =>
    ticker.standard(tickerId)

normaliseDelayedChartSymbol(string symbol) =>
    string result = symbol
    int separator = str.pos(symbol, ":")
    if separator > 0
        string exchange = str.substring(symbol, 0, separator)
        int exchangeLength = str.length(exchange)
        int suffixLength = exchangeLength >= 4 and str.substring(exchange, exchangeLength - 4, exchangeLength) == "_DLY" ? 4 : exchangeLength >= 3 and str.substring(exchange, exchangeLength - 3, exchangeLength) == "_DL" ? 3 : 0
        if suffixLength > 0
            result := str.substring(exchange, 0, exchangeLength - suffixLength) + str.substring(symbol, separator, str.length(symbol))
    result

isBrokerSymbol(string symbol) =>
    str.pos(symbol, "TRADENATION:") == 0 or str.pos(symbol, "TRADENATIONSB:") == 0 or str.pos(symbol, "IG:") == 0

loadMappingPairs(map<string, string> mappings, string mappingPairs) =>
    array<string> lines = str.split(mappingPairs, "\n")
    int lineCount = array.size(lines)
    if lineCount > 0
        for lineIndex = 0 to lineCount - 1
            string line = array.get(lines, lineIndex)
            int separator = str.pos(line, "=")
            if not na(separator)
                string sourceSymbol = compactSymbol(str.substring(line, 0, separator))
                string targetSymbol = compactSymbol(str.substring(line, separator + 1, str.length(line)))
                if sourceSymbol != "" and targetSymbol != ""
                    map.put(mappings, sourceSymbol, targetSymbol)

