//@version=6
indicator("HOLY Vegas SUPER 17", overlay=true)

// === S ===
emaFastLen = input.int(12, "YELLOW EMA")
blueFastLen = input.int(144, "BULE EMA 1")
blueSlowLen = input.int(169, "BULE EMA 2")
redFastLen = input.int(576, "RED EMA 1")
redSlowLen = input.int(676, "RED EMA 2")

showSignal = input.bool(true, "LONG SHORT")

// === EMA  ===
emaFast = ta.ema(close, emaFastLen)

blue1 = ta.ema(close, blueFastLen)
blue2 = ta.ema(close, blueSlowLen)

red1 = ta.ema(close, redFastLen)
red2 = ta.ema(close, redSlowLen)

// === LIGHT ===
plot(emaFast, "YELLOW EMA", color=color.rgb(236, 236, 231, 100), linewidth=2)

pBlue1 = plot(blue1, "BULE 144", color=color.rgb(33, 149, 243, 65), linewidth=2)
pBlue2 = plot(blue2, "BULE 169", color=color.rgb(33, 149, 243, 67), linewidth=2)
fill(pBlue1, pBlue2, color=color.new(#2195f3, 62), title="BULE C")

pRed1 = plot(red1, "RED 576", color=color.rgb(226, 84, 132, 95), linewidth=2)
pRed2 = plot(red2, "RED 676", color=color.rgb(201, 115, 143, 95), linewidth=2)
fill(pRed1, pRed2, color=color.new(#e2658b, 65), title="RED C")

// === LONG SHORT ===
blueTop = math.max(blue1, blue2)
blueBottom = math.min(blue1, blue2)

redTop = math.max(red1, red2)
redBottom = math.min(red1, red2)

// LONG
longSignal = ta.crossover(close, blueTop) and emaFast > blueTop

// SHORT
shortSignal = ta.crossunder(close, blueBottom) and emaFast < blueBottom

// === SIGHT ===
plotshape(
showSignal and longSignal,
title="LONG S",
text="LONG S",
style=shape.labelup,
location=location.belowbar,
color=color.rgb(9, 129, 89),
textcolor=color.white,
size=size.normal)

plotshape(
showSignal and shortSignal,
title="SHORT S",
text="SHORT S",
style=shape.labeldown,
location=location.abovebar,
color=color.red,
textcolor=color.white,
size=size.normal)

