//@version=6
indicator("Kalman Filter-Optimized RSI", shorttitle="Kalman Filter-Optimized RSI", overlay=false, precision=2)



rsiLength = input.int(5, "RSI Length", minval=1, group="RSI Settings")



processNoise = input.float(0.01, "Kalman Process Noise", minval=0.000001, step=0.001, group="Kalman Filter Settings")
measurementNoise = input.float(1.0, "Kalman Measurement Noise", minval=0.000001, step=0.1, group="Kalman Filter Settings")
initialError = input.float(1.0, "Kalman Initial Error", minval=0.000001, step=0.1, group="Kalman Filter Settings")



showMomentumBars = input.bool(true, "顯示動能柱", group="Visual Settings")
showBackgroundZones = input.bool(true, "顯示超買超賣背景", group="Visual Settings")
showCurrentValue = input.bool(true, "顯示目前數值", group="Visual Settings")



var float kalmanPrice = na
var float kalmanError = initialError

float predictedPrice = na(kalmanPrice[1]) ? close : kalmanPrice[1]
float predictedError = nz(kalmanError[1], initialError) + processNoise
float kalmanGain = predictedError / (predictedError + measurementNoise)

kalmanPrice := predictedPrice + kalmanGain * (close - predictedPrice)
kalmanError := (1.0 - kalmanGain) * predictedError



float kalmanRsi = ta.rsi(kalmanPrice, rsiLength)



float momentum = kalmanRsi - 50.0


bool risingMomentum = kalmanRsi > kalmanRsi[1]
bool fallingMomentum = kalmanRsi < kalmanRsi[1]


color overboughtColor = color.rgb(20, 20, 20)


color bullishColor = color.rgb(45, 135, 210)


color bearishColor = color.rgb(225, 145, 65)


color oversoldColor = color.rgb(215, 75, 130)

color kalmanRsiColor = kalmanRsi >= 70.0 ? overboughtColor : kalmanRsi >= 50.0 ? bullishColor : kalmanRsi <= 30.0 ? oversoldColor : bearishColor


color momentumColor = momentum >= 0.0 ? risingMomentum ? color.new(color.rgb(55, 190, 165), 30) : color.new(color.rgb(70, 145, 210), 50) : fallingMomentum ? color.new(color.rgb(220, 75, 110), 30) : color.new(color.rgb(225, 145, 65), 50)



upperExtreme = hline(80, " ", color=color.new(overboughtColor, 65), linestyle=hline.style_dotted)
upperBand = hline(70, "  ", color=color.new(color.gray, 20), linestyle=hline.style_solid)
middleUpper = hline(55, "   ", color=color.new(color.gray, 88), linestyle=hline.style_dotted)
middleLine = hline(50, "    ", color=color.new(color.gray, 50), linestyle=hline.style_dashed)
middleLower = hline(45, "     ", color=color.new(color.gray, 88), linestyle=hline.style_dotted)
lowerBand = hline(30, "      ", color=color.new(color.gray, 20), linestyle=hline.style_solid)
lowerExtreme = hline(20, "       ", color=color.new(oversoldColor, 75), linestyle=hline.style_dotted)


fill(
     upperExtreme,
     upperBand,
     color=showBackgroundZones ? color.new(overboughtColor, 93) : na,
     title="        "
)


fill(
     upperBand,
     middleUpper,
     color=showBackgroundZones ? color.new(bullishColor, 95) : na,
     title="         "
)


fill(
     middleUpper,
     middleLower,
     color=showBackgroundZones ? color.new(color.rgb(120, 125, 145), 96) : na,
     title="          "
)


fill(
     middleLower,
     lowerBand,
     color=showBackgroundZones ? color.new(bearishColor, 95) : na,
     title="           "
)


fill(
     lowerBand,
     lowerExtreme,
     color=showBackgroundZones ? color.new(oversoldColor, 89) : na,
     title="            "
)


plot(
     showMomentumBars ? 50.0 + momentum * 0.28 : na,
     title="             ",
     style=plot.style_histogram,
     histbase=50.0,
     color=momentumColor,
     linewidth=3
)


plot(
     kalmanRsi,
     title="              ",
     color=color.new(kalmanRsiColor, 88),
     linewidth=4
)


plot(
     kalmanRsi,
     title="Kalman RSI",
     color=kalmanRsiColor,
     linewidth=2
)



color zoneBackground = kalmanRsi >= 70.0 ? color.new(overboughtColor, 96) : kalmanRsi <= 30.0 ? color.new(oversoldColor, 94) : na

bgcolor(
     showBackgroundZones ? zoneBackground : na,
     title="               "
)



var label currentValueLabel = na

if barstate.islast
    label.delete(currentValueLabel)

    if showCurrentValue and not na(kalmanRsi)
        string zoneText = kalmanRsi >= 70.0 ? "OVERBOUGHT" : kalmanRsi <= 30.0 ? "OVERSOLD" : kalmanRsi >= 50.0 ? "BULLISH" : "BEARISH"

        color valueLabelColor = kalmanRsi >= 70.0 ? overboughtColor : kalmanRsi <= 30.0 ? oversoldColor : kalmanRsi >= 50.0 ? bullishColor : bearishColor

        currentValueLabel := label.new(
             bar_index,
             kalmanRsi,
             "  " + str.tostring(kalmanRsi, "#.00") + "  " + zoneText + "  ",
             style=label.style_label_left,
             color=color.new(valueLabelColor, 8),
             textcolor=color.white,
             size=size.small
        )
