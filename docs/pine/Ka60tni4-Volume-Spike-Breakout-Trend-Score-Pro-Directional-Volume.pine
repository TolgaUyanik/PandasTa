//@version=6
strategy("Volume Spike + Breakout Trend Score Pro + Directional Volume",
     overlay = true,
     initial_capital = 10000,
     pyramiding = 0,
     commission_type = strategy.commission.percent,
     commission_value = 0.01,
     calc_on_every_tick = false,
     process_orders_on_close = true)

//=========================
// Inputs
//=========================
groupTrend  = "Trend"
fastLen     = input.int(8, "Fast EMA", minval = 1, group = groupTrend)
slowLen     = input.int(21, "Slow EMA", minval = 1, group = groupTrend)
longLen     = input.int(50, "Long SMA", minval = 1, group = groupTrend)

groupVol    = "Volume Spike"
volLen      = input.int(20, "Volume MA Length", minval = 1, group = groupVol)
volMult     = input.float(1.5, "Volume Spike Multiplier", minval = 0.1, step = 0.1, group = groupVol)
useHL2Bias  = input.bool(true, "Use HL2 directional bias", group = groupVol)

groupBreak  = "Breakout"
breakLen    = input.int(20, "Breakout Lookback", minval = 1, group = groupBreak)
confirmMode = input.string("Close", "Breakout Confirmation", options = ["Close", "Wick"], group = groupBreak)

groupScore  = "Score Filter"
useScore    = input.bool(true, "Enable Trend Score Filter", group = groupScore)
minLongScore  = input.int(3, "Min Long Score", minval = 1, maxval = 6, group = groupScore)
minShortScore = input.int(3, "Min Short Score", minval = 1, maxval = 6, group = groupScore)

groupRisk   = "Risk"
useATR      = input.bool(true, "Use ATR Exits", group = groupRisk)
atrLen      = input.int(14, "ATR Length", minval = 1, group = groupRisk)
atrStopMult = input.float(1.5, "ATR Stop Mult", minval = 0.1, step = 0.1, group = groupRisk)
atrTpMult   = input.float(2.5, "ATR Target Mult", minval = 0.1, step = 0.1, group = groupRisk)

groupSess   = "Session"
useSession  = input.bool(false, "Use Session Filter", group = groupSess)
sess        = input.session("0930-1600", "Session", group = groupSess)

groupVis    = "Display"
showSignals = input.bool(true, "Show Signals", group = groupVis)
showBg      = input.bool(false, "Color Background", group = groupVis)
showLevels  = input.bool(true, "Plot MA/VWAP", group = groupVis)

//=========================
// Core calculations
//=========================
emaFast   = ta.ema(close, fastLen)
emaSlow   = ta.ema(close, slowLen)
smaLong   = ta.sma(close, longLen)
vwapValue = ta.vwap(hlc3)
atr       = ta.atr(atrLen)
volMA     = ta.sma(volume, volLen)
rsi       = ta.rsi(close, 14)

[macdLine, signalLine, macdHist] = ta.macd(close, 12, 26, 9)

inSession = not useSession or not na(time(timeframe.period, sess))

trendBull = close > emaFast and emaFast > emaSlow
trendBear = close < emaFast and emaFast < emaSlow
vwapBull  = close > vwapValue
vwapBear  = close < vwapValue

emaSpreadPct = emaSlow != 0 ? ((emaFast - emaSlow) / emaSlow) * 100.0 : 0.0
macdHistPct  = close != 0 ? (macdHist / close) * 100.0 : 0.0
vwapDistPct  = vwapValue != 0 ? ((close - vwapValue) / vwapValue) * 100.0 : 0.0

//=========================
// Directional volume spike
//=========================
isVolSpike   = volume > volMA * volMult
bullBody     = close > open
bearBody     = close < open
bullPressure = close > hl2
bearPressure = close < hl2

upVolSpike   = isVolSpike and (useHL2Bias ? bullPressure : bullBody)
downVolSpike = isVolSpike and (useHL2Bias ? bearPressure : bearBody)

//=========================
// Breakout logic
//=========================
priorHigh = ta.highest(high[1], breakLen)
priorLow  = ta.lowest(low[1], breakLen)

breakoutUp   = confirmMode == "Close" ? close > priorHigh : high > priorHigh
breakoutDown = confirmMode == "Close" ? close < priorLow  : low < priorLow

//=========================
// Score engine
//=========================
longScore = 0
longScore += trendBull ? 1 : 0
longScore += vwapBull ? 1 : 0
longScore += close > smaLong ? 1 : 0
longScore += rsi > 55 ? 1 : 0
longScore += macdHist > 0 ? 1 : 0
longScore += emaSpreadPct > 0 ? 1 : 0

shortScore = 0
shortScore += trendBear ? 1 : 0
shortScore += vwapBear ? 1 : 0
shortScore += close < smaLong ? 1 : 0
shortScore += rsi < 45 ? 1 : 0
shortScore += macdHist < 0 ? 1 : 0
shortScore += emaSpreadPct < 0 ? 1 : 0

scoreLongPass  = not useScore or longScore >= minLongScore
scoreShortPass = not useScore or shortScore >= minShortScore

//=========================
// Entry logic
//=========================
bullSpikeConfirmed = upVolSpike and trendBull and vwapBull
bearSpikeConfirmed = downVolSpike and trendBear and vwapBear

longSignal  = inSession and bullSpikeConfirmed and breakoutUp and scoreLongPass
shortSignal = inSession and bearSpikeConfirmed and breakoutDown and scoreShortPass

if longSignal and strategy.position_size <= 0
    strategy.entry("Long", strategy.long)

if shortSignal and strategy.position_size >= 0
    strategy.entry("Short", strategy.short)

//=========================
// Exit logic
//=========================
if useATR
    longStop  = strategy.position_avg_price - atr * atrStopMult
    longLimit = strategy.position_avg_price + atr * atrTpMult
    shortStop = strategy.position_avg_price + atr * atrStopMult
    shortLimit= strategy.position_avg_price - atr * atrTpMult

    strategy.exit("Long Exit", from_entry = "Long", stop = longStop, limit = longLimit)
    strategy.exit("Short Exit", from_entry = "Short", stop = shortStop, limit = shortLimit)

// Optional logic exits
exitLongLogic  = strategy.position_size > 0 and (trendBear or close < emaFast)
exitShortLogic = strategy.position_size < 0 and (trendBull or close > emaFast)

if not useATR and exitLongLogic
    strategy.close("Long")

if not useATR and exitShortLogic
    strategy.close("Short")

//=========================
// Plots
//=========================
plot(showLevels ? emaFast : na, "EMA Fast", color = color.new(color.lime, 0), linewidth = 2)
plot(showLevels ? emaSlow : na, "EMA Slow", color = color.new(color.orange, 0), linewidth = 2)
plot(showLevels ? smaLong : na, "SMA Long", color = color.new(color.blue, 0), linewidth = 2)
plot(showLevels ? vwapValue : na, "VWAP", color = color.new(color.purple, 0), linewidth = 2)

plotshape(showSignals and upVolSpike, title = "Upside Volume Spike", style = shape.triangleup, location = location.belowbar, color = color.lime, size = size.tiny, text = "UVS")
plotshape(showSignals and downVolSpike, title = "Downside Volume Spike", style = shape.triangledown, location = location.abovebar, color = color.red, size = size.tiny, text = "DVS")

plotshape(showSignals and longSignal, title = "Long Entry", style = shape.labelup, location = location.belowbar, color = color.new(color.green, 0), textcolor = color.white, size = size.small, text = "LONG")
plotshape(showSignals and shortSignal, title = "Short Entry", style = shape.labeldown, location = location.abovebar, color = color.new(color.red, 0), textcolor = color.white, size = size.small, text = "SHORT")

bgcolor(showBg ? longSignal ? color.new(color.green, 88) : shortSignal ? color.new(color.red, 88) : na : na)

//=========================
// Alerts
//=========================
alertcondition(upVolSpike, "Upside Volume Spike", "Upside volume spike detected")
alertcondition(downVolSpike, "Downside Volume Spike", "Downside volume spike detected")
alertcondition(longSignal, "Long Signal", "Long breakout with bullish volume spike")
alertcondition(shortSignal, "Short Signal", "Short breakdown with bearish volume spike")

//=========================
// Status line values
//=========================
plotchar(longScore, "Long Score", "", location.top, size = size.tiny, display = display.status_line)
plotchar(shortScore, "Short Score", "", location.top, size = size.tiny, display = display.status_line)
plotchar(emaSpreadPct, "EMA Spread %", "", location.top, size = size.tiny, display = display.status_line)
plotchar(macdHistPct, "MACD Hist %", "", location.top, size = size.tiny, display = display.status_line)
plotchar(vwapDistPct, "VWAP Dist %", "", location.top, size = size.tiny, display = display.status_line)