//@version=6
library("FvgTypes", true)

// FvgTypes Library
// v2 2025.06.12

// This code's style is based on the recommendations from the Pine Script User Manual's Style guide:
//    https://www.tradingview.com/pine-script-docs/writing/style-guide/



//#region ———————————————————— Types


// @enum      tfType Defines the types of timeframes.
// @field LTF Low Timeframe (represents the current chart timeframe).
// @field MTF Medium Timeframe.
// @field HTF High Timeframe.
export enum tfType
    LTF
    MTF
    HTF


// @type  fvgObject                     Represents a Fair Value Gap (FVG) object.
// @field top                  (float)  The top price level of the FVG.
// @field bottom               (float)  The bottom price level of the FVG.
// @field startTime            (int)    The start time (timestamp) of the bar where the FVG formed.
// @field isBullish            (bool)   Indicates if the FVG is bullish (true) or bearish (false).
// @field isLV                 (bool)   Indicates if the FVG is a Large Volume FVG.
// @field tfType               (tfType) The timeframe type (LTF, MTF, HTF) to which this FVG belongs.
// @field isMitigated          (bool)   Indicates if the FVG has been fully mitigated.
// @field mitigationTime       (int)    The time (timestamp) when the FVG was mitigated.
// @field isVisible            (bool)   The current visibility status of the FVG, typically managed by drawing logic based on filters.
// @field isMidlineTouched     (bool)   Indicates if the price has touched the FVG's midline (50% level).
// @field currentTop           (float)  The current top level of the FVG after partial fills.
// @field currentBottom        (float)  The current bottom level of the FVG after partial fills.
// @field boxId                (box)    The drawing ID for the main FVG box.
// @field mitigatedBoxId       (box)    The drawing ID for the box representing the partially filled (mitigated) area.
// @field midLineId            (line)   The drawing ID for the FVG's midline.
// @field mitLineId            (line)   The drawing ID for the FVG's mitigation line.
// @field boxLabelId           (label)  The drawing ID for the FVG box label.
// @field mitLineLabelId       (label)  The drawing ID for the mitigation line label.
// @field testedBoxId          (box)    The drawing ID for the box of a fully mitigated (tested) FVG, if kept visible.
// @field keptMitLineId        (line)   The drawing ID for a mitigation line that is kept after full mitigation.
// @field prevIsMitigated      (bool)   Stores the `isMitigated` state from the previous bar for optimization.
// @field prevCurrentTop       (float)  Stores the `currentTop` value from the previous bar for optimization.
// @field prevCurrentBottom    (float)  Stores the `currentBottom` value from the previous bar for optimization.
// @field prevIsVisible        (bool)   Stores the visibility status from the previous bar for optimization (derived from isVisibleNow passed to updateDrawings).
// @field prevIsMidlineTouched (bool)   Stores the `isMidlineTouched` status from the previous bar for optimization.
export type fvgObject
    float  top                   = na
    float  bottom                = na
    int    startTime             = na
    bool   isBullish             = false
    bool   isLV                  = false
    tfType tfType                = tfType.LTF
    bool   isMitigated           = false
    int    mitigationTime        = na
    bool   isVisible             = true
    bool   isMidlineTouched      = false 
    float  currentTop            = na
    float  currentBottom         = na
    box    boxId                 = na
    box    mitigatedBoxId        = na
    line   midLineId             = na
    line   mitLineId             = na
    label  boxLabelId            = na
    label  mitLineLabelId        = na
    box    testedBoxId           = na
    line   keptMitLineId         = na

    // --- START: Optimization Fields for Previous State ---
    bool   prevIsMitigated       = false
    float  prevCurrentTop        = na
    float  prevCurrentBottom     = na
    bool   prevIsVisible         = false
    bool   prevIsMidlineTouched  = false 
    // --- END: Optimization Fields ---


// @type  drawSettings                              A structure containing settings for drawing FVGs.
// @field shouldClassifyLV                 (bool)   Whether to classify FVGs as Large Volume (LV) based on ATR.
// @field shouldHideMitigated              (bool)   Whether to hide FVG boxes once they are fully mitigated.
// @field currentTime                      (int)    The current bar's time, used for extending drawings.
// @field lvBullColor                      (color)  Color for Large Volume Bullish FVGs.
// @field mitigatedLvBullColor             (color)  Color for mitigated Large Volume Bullish FVGs.
// @field lvBearColor                      (color)  Color for Large Volume Bearish FVGs.
// @field mitigatedLvBearColor             (color)  Color for mitigated Large Volume Bearish FVGs.
// @field shouldShowBoxes                  (bool)   Whether to show FVG boxes for the LTF.
// @field bullBoxColor                     (color)  Color for LTF Bullish FVG boxes.
// @field mitigatedBullBoxColor            (color)  Color for mitigated LTF Bullish FVG boxes.
// @field bearBoxColor                     (color)  Color for LTF Bearish FVG boxes.
// @field mitigatedBearBoxColor            (color)  Color for mitigated LTF Bearish FVG boxes.
// @field boxLengthBars                    (int)    Length of LTF FVG boxes in bars (if not extended).
// @field shouldExtendBoxes                (bool)   Whether to extend LTF FVG boxes to the right.
// @field shouldShowCurrentTfBoxLabels     (bool)   Whether to show labels on LTF FVG boxes.
// @field boxLabelFormat                   (string) The selected display format for the FVG box label.
// @field boxLabelOffsetX                  (float)  The horizontal offset for the LTF box label.
// @field boxLabelTextColor                (color)  Text color for LTF FVG box labels. 
// @field boxLabelTextSize                 (string) Text size for LTF FVG box labels (e.g., size.small).
// @field shouldShowBoxBorder              (bool)   Whether to show a border for LTF FVG boxes.
// @field boxBorderWidth                   (int)    Border width for LTF FVG boxes.
// @field boxBorderStyle                   (string) Border style for LTF FVG boxes (e.g., line.style_solid).
// @field boxBorderColor                   (color)  Border color for LTF FVG boxes.
// @field shouldShowMidpoint               (bool)   Whether to show the midline (50% level) for LTF FVGs.
// @field midLineWidthInput                (int)    Width of the LTF FVG midline.
// @field midpointLineStyleInput           (string) Style of the LTF FVG midline.
// @field midpointColorInput               (color)  Color of the LTF FVG midline.
// @field shouldShowMitigationLine         (bool)   Whether to show the mitigation line for LTF FVGs. (Line always extends if shown)
// @field mitLineWidthInput                (int)    Width of the LTF FVG mitigation line.
// @field mitigationLineStyleInput         (string) Style of the LTF FVG mitigation line.
// @field mitigationLineColorInput         (color)  Color of the LTF FVG mitigation line.
// @field shouldShowCurrentTfMitLineLabels (bool)   Whether to show labels on LTF FVG mitigation lines.
// @field shouldLtfUseCustomMitLabelColor  (bool)   Whether to use a custom color for the LTF mitigation line's label.
// @field currentTfMitLineLabelCustomColor (color)  The custom text color for the LTF mitigation line's label.
// @field currentTfMitLineLabelSize        (string) The text size for the LTF mitigation line's label.
// @field currentTfMitLineLabelOffsetX     (float)  The horizontal offset value for the LTF mitigation line's label.
// @field shouldKeepLtfMitigatedLines      (bool)   Whether to keep showing mitigation lines of fully mitigated LTF FVGs.
// @field mitigatedMitLineColor            (color)  Color for kept mitigation lines of mitigated LTF FVGs.
// @field tfString                         (string) Display string for the LTF (e.g., "Current TF").
// @field shortTfString                    (string) Short display string for the LTF (e.g., "5").
// @field shouldShowMtfBoxes               (bool)   Whether to show FVG boxes for the MTF.
// @field mtfBullBoxColor                  (color)  Color for MTF Bullish FVG boxes.
// @field mtfMitigatedBullBoxColor         (color)  Color for mitigated MTF Bullish FVG boxes.
// @field mtfBearBoxColor                  (color)  Color for MTF Bearish FVG boxes.
// @field mtfMitigatedBearBoxColor         (color)  Color for mitigated MTF Bearish FVG boxes.
// @field mtfBoxLengthBars                 (int)    Length of MTF FVG boxes in bars (if not extended).
// @field shouldExtendMtfBoxes             (bool)   Whether to extend MTF FVG boxes to the right.
// @field shouldShowMtfBoxLabels           (bool)   Whether to show labels on MTF FVG boxes.
// @field mtfBoxLabelFormat                (string) The selected display format for the MTF FVG box label.
// @field mtfBoxLabelOffsetX               (float)  The horizontal offset for the MTF box label.
// @field mtfBoxLabelTextColor             (color)  Text color for MTF FVG box labels.
// @field mtfBoxLabelTextSize              (string) Text size for MTF FVG box labels.
// @field shouldShowMtfBoxBorder           (bool)   Whether to show a border for MTF FVG boxes.
// @field mtfBoxBorderWidth                (int)    Border width for MTF FVG boxes.
// @field mtfBoxBorderStyle                (string) Border style for MTF FVG boxes.
// @field mtfBoxBorderColor                (color)  Border color for MTF FVG boxes.
// @field shouldShowMtfMidpoint            (bool)   Whether to show the midline for MTF FVGs.
// @field mtfMidLineWidthInput             (int)    Width of the MTF FVG midline.
// @field mtfMidpointLineStyleInput        (string) Style of the MTF FVG midline.
// @field mtfMidpointColorInput            (color)  Color of the MTF FVG midline.
// @field shouldShowMtfMitigationLine      (bool)   Whether to show the mitigation line for MTF FVGs. (Line always extends if shown)
// @field mtfMitLineWidthInput             (int)    Width of the MTF FVG mitigation line.
// @field mtfMitigationLineStyleInput      (string) Style of the MTF FVG mitigation line.
// @field mtfMitigationLineColorInput      (color)  Color of the MTF FVG mitigation line.
// @field shouldShowMtfMitLineLabels       (bool)   Whether to show labels on MTF FVG mitigation lines.
// @field shouldMtfUseCustomMitLabelColor  (bool)   Whether to use a custom color for the MTF mitigation line's label.
// @field mtfMitLineLabelCustomColor       (color)  The custom text color for the MTF mitigation line's label.
// @field mtfMitLineLabelSize              (string) The text size for the MTF mitigation line's label.
// @field mtfMitLineLabelOffsetX           (float)  The horizontal offset value for the MTF mitigation line's label.
// @field shouldKeepMtfMitigatedLines      (bool)   Whether to keep showing mitigation lines of fully mitigated MTF FVGs.
// @field mtfMitigatedMitLineColor         (color)  Color for kept mitigation lines of mitigated MTF FVGs.
// @field mtfTfString                      (string) Display string for the MTF (e.g., "MTF").
// @field mtfShortTfString                 (string) Short display string for the MTF (e.g., "60").
// @field shouldShowHtfBoxes               (bool)   Whether to show FVG boxes for the HTF.
// @field htfBullBoxColor                  (color)  Color for HTF Bullish FVG boxes.
// @field htfMitigatedBullBoxColor         (color)  Color for mitigated HTF Bullish FVG boxes.
// @field htfBearBoxColor                  (color)  Color for HTF Bearish FVG boxes.
// @field htfMitigatedBearBoxColor         (color)  Color for mitigated HTF Bearish FVG boxes.
// @field htfBoxLengthBars                 (int)    Length of HTF FVG boxes in bars (if not extended).
// @field shouldExtendHtfBoxes             (bool)   Whether to extend HTF FVG boxes to the right.
// @field shouldShowHtfBoxLabels           (bool)   Whether to show labels on HTF FVG boxes.
// @field htfBoxLabelFormat                (string) The selected display format for the HTF FVG box label.
// @field htfBoxLabelOffsetX               (float)  The horizontal offset for the HTF box label.
// @field htfBoxLabelTextColor             (color)  Text color for HTF FVG box labels.
// @field htfBoxLabelTextSize              (string) Text size for HTF FVG box labels.
// @field shouldShowHtfBoxBorder           (bool)   Whether to show a border for HTF FVG boxes.
// @field htfBoxBorderWidth                (int)    Border width for HTF FVG boxes.
// @field htfBoxBorderStyle                (string) Border style for HTF FVG boxes.
// @field htfBoxBorderColor                (color)  Border color for HTF FVG boxes.
// @field shouldShowHtfMidpoint            (bool)   Whether to show the midline for HTF FVGs.
// @field htfMidLineWidthInput             (int)    Width of the HTF FVG midline.
// @field htfMidpointLineStyleInput        (string) Style of the HTF FVG midline.
// @field htfMidpointColorInput            (color)  Color of the HTF FVG midline.
// @field shouldShowHtfMitigationLine      (bool)   Whether to show the mitigation line for HTF FVGs. (Line always extends if shown)
// @field htfMitLineWidthInput             (int)    Width of the HTF FVG mitigation line.
// @field htfMitigationLineStyleInput      (string) Style of the HTF FVG mitigation line.
// @field htfMitigationLineColorInput      (color)  Color of the HTF FVG mitigation line.
// @field shouldShowHtfMitLineLabels       (bool)   Whether to show labels on HTF FVG mitigation lines.
// @field shouldHtfUseCustomMitLabelColor  (bool)   Whether to use a custom color for the HTF mitigation line's label.
// @field htfMitLineLabelCustomColor       (color)  The custom text color for the HTF mitigation line's label.
// @field htfMitLineLabelSize              (string) The text size for the HTF mitigation line's label.
// @field htfMitLineLabelOffsetX           (float)  The horizontal offset value for the HTF mitigation line's label.
// @field shouldKeepHtfMitigatedLines      (bool)   Whether to keep showing mitigation lines of fully mitigated HTF FVGs.
// @field htfMitigatedMitLineColor         (color)  Color for kept mitigation lines of mitigated HTF FVGs.
// @field htfTfString                      (string) Display string for the HTF (e.g., "HTF").
// @field htfShortTfString                 (string) Short display string for the HTF (e.g., "D").
export type drawSettings
    // General Classification & Behavior
    bool   shouldClassifyLV
    bool   shouldHideMitigated
    int    currentTime
    color  lvBullColor
    color  mitigatedLvBullColor
    color  lvBearColor
    color  mitigatedLvBearColor

    // LTF (Current Timeframe) Drawing Settings
    bool   shouldShowBoxes
    color  bullBoxColor
    color  mitigatedBullBoxColor
    color  bearBoxColor
    color  mitigatedBearBoxColor
    int    boxLengthBars
    bool   shouldExtendBoxes
    bool   shouldShowCurrentTfBoxLabels
    string boxLabelFormat
    float  boxLabelOffsetX
    color  boxLabelTextColor 
    string boxLabelTextSize 
    bool   shouldShowBoxBorder
    int    boxBorderWidth
    string boxBorderStyle
    color  boxBorderColor
    bool   shouldShowMidpoint
    int    midLineWidthInput
    string midpointLineStyleInput
    color  midpointColorInput
    bool   shouldShowMitigationLine
    int    mitLineWidthInput
    string mitigationLineStyleInput
    color  mitigationLineColorInput
    bool   shouldShowCurrentTfMitLineLabels
    bool   shouldLtfUseCustomMitLabelColor
    color  currentTfMitLineLabelCustomColor
    string currentTfMitLineLabelSize
    float  currentTfMitLineLabelOffsetX
    bool   shouldKeepLtfMitigatedLines
    color  mitigatedMitLineColor
    string tfString
    string shortTfString

    // MTF (Medium Timeframe) Drawing Settings
    bool   shouldShowMtfBoxes
    color  mtfBullBoxColor
    color  mtfMitigatedBullBoxColor
    color  mtfBearBoxColor
    color  mtfMitigatedBearBoxColor
    int    mtfBoxLengthBars
    bool   shouldExtendMtfBoxes
    bool   shouldShowMtfBoxLabels
    string mtfBoxLabelFormat
    float  mtfBoxLabelOffsetX
    color  mtfBoxLabelTextColor
    string mtfBoxLabelTextSize
    bool   shouldShowMtfBoxBorder
    int    mtfBoxBorderWidth
    string mtfBoxBorderStyle
    color  mtfBoxBorderColor
    bool   shouldShowMtfMidpoint
    int    mtfMidLineWidthInput
    string mtfMidpointLineStyleInput
    color  mtfMidpointColorInput
    bool   shouldShowMtfMitigationLine
    int    mtfMitLineWidthInput
    string mtfMitigationLineStyleInput
    color  mtfMitigationLineColorInput
    bool   shouldShowMtfMitLineLabels
    bool   shouldMtfUseCustomMitLabelColor
    color  mtfMitLineLabelCustomColor
    string mtfMitLineLabelSize
    float  mtfMitLineLabelOffsetX
    bool   shouldKeepMtfMitigatedLines
    color  mtfMitigatedMitLineColor
    string mtfTfString
    string mtfShortTfString

    // HTF (High Timeframe) Drawing Settings
    bool   shouldShowHtfBoxes
    color  htfBullBoxColor
    color  htfMitigatedBullBoxColor
    color  htfBearBoxColor
    color  htfMitigatedBearBoxColor
    int    htfBoxLengthBars
    bool   shouldExtendHtfBoxes
    bool   shouldShowHtfBoxLabels
    string htfBoxLabelFormat
    float  htfBoxLabelOffsetX
    color  htfBoxLabelTextColor
    string htfBoxLabelTextSize
    bool   shouldShowHtfBoxBorder
    int    htfBoxBorderWidth
    string htfBoxBorderStyle
    color  htfBoxBorderColor
    bool   shouldShowHtfMidpoint
    int    htfMidLineWidthInput
    string htfMidpointLineStyleInput
    color  htfMidpointColorInput
    bool   shouldShowHtfMitigationLine
    int    htfMitLineWidthInput
    string htfMitigationLineStyleInput
    color  htfMitigationLineColorInput
    bool   shouldShowHtfMitLineLabels
    bool   shouldHtfUseCustomMitLabelColor
    color  htfMitLineLabelCustomColor
    string htfMitLineLabelSize
    float  htfMitLineLabelOffsetX
    bool   shouldKeepHtfMitigatedLines
    color  htfMitigatedMitLineColor
    string htfTfString
    string htfShortTfString
//#endregion
