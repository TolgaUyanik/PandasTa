//@version=6
library("MathHelpers")

// MathHelpers Library
// ===================
// 1. calculateATR
// 2. CDF
// 3. logReturns

//===== calculateATR
// @function Calculates the Average True Range (ATR) or Log ATR based on the 'log' parameter. Sans Wilder's Smoothing
// @param simple int length The number of periods over which to calculate ATR.
// @param simple bool log Determines the type of ATR calculation. Set to true for Log ATR, false for standard ATR.
// @returns float The calculated ATR value. Returns Log ATR if `log` is true, otherwise returns standard ATR.
export calculateATR(simple int length, simple bool log) =>
	float atr = 0
    if not log
        // Standard ATR Calculation
        tr1 = high - low
        tr2 = math.abs(high - close[1])
        tr3 = math.abs(low - close[1])
        true_range = math.max(math.max(tr1, tr2), tr3)
        atr := ta.sma(true_range, length)
    else
        // Log ATR Calculation
        // Ensure no division by zero by substituting very small numbers if necessary
        safe_low = low > 0 ? low : 1e-10
        safe_prev_close = close[1] > 0 ? close : 1e-10
        log_tr1 = high / safe_low
        log_tr2 = high / safe_prev_close
        log_tr3 = safe_prev_close / safe_low
        log_true_range = math.max(math.max(log_tr1, log_tr2), log_tr3)
        log_atr = ta.sma(math.log(log_true_range), length)
        atr := log_atr
    atr

//===== CDF
// @function Computes the Cumulative Distribution Function (CDF) for a given value 'z', mimicking the CDF function in "Statistically Sound Indicators" by Timothy Masters.
// @param simple float z The input value for which to calculate the CDF.
// @returns float The CDF value corresponding to the input `z`, ranging between 0 and 1.
export CDF(float z) =>
    zz = math.abs(z)
    pdf = math.exp(-0.5 * zz * zz) / math.sqrt(2.0 * 3.141592653589793)
    t = 1.0 / (1.0 + zz * 0.2316419)
    poly = ((((1.330274429 * t - 1.821255978) * t + 1.781477937) * t - 0.356563782) * t + 0.319381530) * t
    cdf = (z > 0.0) ? 1.0 - pdf * poly : pdf * poly
    cdf

//===== logReturns
// @function Calculates the logarithmic returns over a specified lookback period.
// @param simple int lookback The number of periods over which to calculate the log return (e.g., 3 for 3-day returns).
// @returns float The calculated logarithmic return. Returns `na` if insufficient data is available.
export logReturns(simple int lookback) =>
    float log_returns = na
    float current_log_return = math.log(close / close[1])
    float sum_log_returns = math.sum(current_log_return, lookback)
    
    // Handle lookback = 1
    if lookback <= 1 and bar_index >= 1
        log_returns := current_log_return
    
    // Handle lookback > 1
    else if lookback > 1 and bar_index >= lookback
        log_returns := sum_log_returns

    log_returns