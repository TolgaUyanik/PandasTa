//@version=6
indicator(
     title="RSi Regime",
     shorttitle="RSi Regime",
     overlay=false,
     precision=2,
     explicit_plot_zorder=true
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// INPUTS
// display.none chỉ ẩn thông số khỏi status line.
// Vẫn chỉnh bình thường trong tab Inputs.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
group_rsi   = "RSI & SMA"
group_fills = "FILLS"

src = input.source(
     close,
     "RSI Source",
     group=group_rsi,
     display=display.none
)

rsi_length = input.int(
     14,
     "RSI Length",
     minval=1,
     group=group_rsi,
     display=display.none
)

sma_length = input.int(
     14,
     "SMA Length",
     minval=1,
     group=group_rsi,
     display=display.none
)

show_rsi_sma_fill = input.bool(
     false,
     "Fill RSI ↔ SMA",
     group=group_fills,
     display=display.none
)

show_sma50_fill = input.bool(
     true,
     "Fill SMA ↔ 50",
     group=group_fills,
     display=display.none
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CALCULATE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
rsi_value = ta.rsi(src, rsi_length)
sma_value = ta.sma(rsi_value, sma_length)

level_high = 70.0
level_mid  = 50.0
level_low  = 30.0

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// LEVELS
// Mặc định:
// 70: #B8B8B8, nét gạch nối
// 50: #B8B8B8, nét liền
// 30: #B8B8B8, nét gạch nối
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
hline(
     level_high,
     title="Level High",
     color=#B8B8B8,
     linestyle=hline.style_dashed,
     linewidth=1,
     editable=true
)


hline(
     level_mid,
     title="Level Mid",
     color=#B8B8B8,
     linestyle=hline.style_solid,
     linewidth=1,
     editable=true
)

hline(
     level_low,
     title="Level Low",
     color=#B8B8B8,
     linestyle=hline.style_dashed,
     linewidth=1,
     editable=true
)


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// LAYER 1 — SMA ↔ 50 FILL
// Tách Above/Below để chỉnh riêng trong Style.
//
// SMA Above 50: #81D98A
// SMA Below 50: #E78A96
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
sma_above_50 = show_sma50_fill and sma_value >= level_mid
sma_below_50 = show_sma50_fill and sma_value < level_mid

p_sma_above_50 = plot(
     sma_above_50 ? sma_value : na,
     title="",
     display=display.none,
     editable=false
)

p_mid_above_50 = plot(
     sma_above_50 ? level_mid : na,
     title="",
     display=display.none,
     editable=false
)

fill(
     p_sma_above_50,
     p_mid_above_50,
     color=color.new(#81D98A, 50),
     title="SMA Above 50",
     editable=true,
     fillgaps=false
)

p_sma_below_50 = plot(
     sma_below_50 ? sma_value : na,
     title="",
     display=display.none,
     editable=false
)

p_mid_below_50 = plot(
     sma_below_50 ? level_mid : na,
     title="",
     display=display.none,
     editable=false
)

fill(
     p_sma_below_50,
     p_mid_below_50,
     color=color.new(#E78A96, 50),
     title="SMA Below 50",
     editable=true,
     fillgaps=false
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// LAYER 2 — RSI ↔ SMA FILL
//
// RSI trên SMA: xanh
// RSI dưới SMA: đỏ
//
// Hai trạng thái tách riêng để chỉnh màu độc lập
// trong tab Style.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
rsi_above_sma = show_rsi_sma_fill and rsi_value >= sma_value
rsi_below_sma = show_rsi_sma_fill and rsi_value < sma_value

p_rsi_above_sma = plot(
     rsi_above_sma ? rsi_value : na,
     title="",
     display=display.none,
     editable=false
)

p_sma_under_rsi = plot(
     rsi_above_sma ? sma_value : na,
     title="",
     display=display.none,
     editable=false
)

fill(
     p_rsi_above_sma,
     p_sma_under_rsi,
     color=color.new(#81D98A, 65),
     title="RSI Above SMA",
     editable=true,
     fillgaps=false
)

p_rsi_below_sma = plot(
     rsi_below_sma ? rsi_value : na,
     title="",
     display=display.none,
     editable=false
)

p_sma_over_rsi = plot(
     rsi_below_sma ? sma_value : na,
     title="",
     display=display.none,
     editable=false
)

fill(
     p_rsi_below_sma,
     p_sma_over_rsi,
     color=color.new(#E78A96, 65),
     title="RSI Below SMA",
     editable=true,
     fillgaps=false
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// LAYER 3 — RSI
//
// Mặc định:
// Color: #C8E6C9
// Width: 1
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
plot(
     rsi_value,
     title="RSI",
     color=#C8E6C9,
     linewidth=1,
     display=display.all - display.status_line,
     editable=true
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// LAYER 4 — SMA
//
// Mặc định opacity 0:
// đường không nhìn thấy nhưng vẫn được tính.
//
// Viết sau RSI để nếu tăng opacity thì SMA nằm trên RSI.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
plot(
     sma_value,
     title="SMA",
     color=color.new(#f23645, 100),
     linewidth=1,
     display=display.all - display.status_line,
     editable=true
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// STATUS LINE VALUES
// Chỉ hiện giá trị RSI và SMA, không hiện thông số input.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
plot(
     rsi_value,
     title="",
     color=color.new(#C8E6C9, 100),
     display=display.status_line,
     editable=false
)

plot(
     sma_value,
     title="",
     color=color.new(#FFFFFF, 100),
     display=display.status_line,
     editable=false
)