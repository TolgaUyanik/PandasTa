//@version=6
// @description Optimized S/R Box utilities. v6 method syntax throughout.
library("BoxesLib")

// --- Internal ---
_broken(bool isBo, float price, float top, float bot) =>
    isBo ? price < bot : price > top

// --- Create ---
// Unified box creation with overlap-strengthen logic.
// _bgCol/_borderCol/_txtCol       : normal state colors
// _strongBgCol/_strongBorderCol   : confluent/overlap zone colors
// _isBo    : true = support box, false = resistance box
// _conf    : true  = gate on barstate.isconfirmed; scan also prunes broken boxes
//           false = create on every bar (footprint sequence boxes, no pruning)
// _close   : price used for broken-box pruning (_conf=true only)
// Overlap found -> strengthens existing box (strong colors, border_width=2). Returns na.
// No overlap   -> creates new box (normal colors, border_width=1). Returns the box.
export createBox(array<box> _boxes, float _top, float _bot, int _left,
                 color _bgCol, color _borderCol, color _txtCol,
                 color _strongBgCol, color _strongBorderCol,
                 string _txt, int _cap,
                 bool _isBo, bool _conf, float _close) =>
    box result = na
    if not _conf or barstate.isconfirmed
        while _boxes.size() >= _cap
            box old = _boxes.shift()
            if not na(old)
                old.delete()
        bool overlap = false
        int i = _boxes.size() - 1
        while i >= 0
            box b = _boxes.get(i)
            if na(b)
                _boxes.remove(i)
            else
                float bt = b.get_top()
                float bb = b.get_bottom()
                if _conf and _broken(_isBo, _close, bt, bb)
                    b.delete()
                    _boxes.remove(i)
                else if not overlap
                    if math.min(_top, bt) >= math.max(_bot, bb)
                        overlap := true
                        b.set_bgcolor(_strongBgCol)
                        b.set_border_color(_strongBorderCol)
                        b.set_border_width(0)
                        b.set_text("Strong " + str.tostring(bt, format.mintick) + "-" + str.tostring(bb, format.mintick) + " R:" + str.tostring(bt - bb, format.mintick))
                        b.set_text_color(color.white)
            i -= 1
        if not overlap
            result := box.new(left=_left, top=_top, right=bar_index, bottom=_bot,
                 bgcolor=_bgCol, border_color=_borderCol, border_width=0,
                 text=_txt, text_halign=text.align_right,
                 text_valign=text.align_center, text_size=size.small,
                 text_color=_txtCol, text_wrap=text.wrap_none, force_overlay=true)
            _boxes.push(result)
    result

// --- Manage ---
// Extends each box right edge and removes boxes broken by price.
// _extendRight : false = right=bar_index      (S/R boxes, follows current bar)
//                true  = right=last_bar_index (imbalance boxes, chart edge)
// _conf        : true  = deletion only on barstate.isconfirmed
//                false = deletion on every bar update (real-time breakout)
export manageBoxes(array<box> _boxes, bool _isBo, float _close, bool _conf, bool _extendRight) =>
    int i = _boxes.size() - 1
    while i >= 0
        box b = _boxes.get(i)
        if na(b)
            _boxes.remove(i)
        else
            b.set_right(_extendRight ? last_bar_index : bar_index)
            if (not _conf or barstate.isconfirmed) and _broken(_isBo, _close, b.get_top(), b.get_bottom())
                b.delete()
                _boxes.remove(i)
        i -= 1