// © richardgong1988 — 26年信号维度 strategy.
// Each signal is independent: disabled = library never called, enabled = its own entry + alert.
// Design: docs/design/seven_signals_strategy.md

//@version=6
strategy("5大信号 / 7形态", overlay = true,
         default_qty_type = strategy.fixed, default_qty_value = 1,
         margin_long = 0, margin_short = 0,
         pyramiding = 7)

import richardgong1988/HanJinSignals26/4 as S

// ─── Inputs ────────────────────────────────────────────────────────
pinLong   = input.float(0.667, "Pinbar long ≥",  0.5, 0.95, 0.01, group = "Params")
pinShort  = input.float(0.2,   "Pinbar short ≤", 0.05, 0.5, 0.01, group = "Params")
pinStrict = input.bool (true,  "Pinbar strict",                    group = "Params")
bigFrac   = input.float(0.7,   "Big body ≥",    0.5, 0.95, 0.01, group = "Params")
useS1  = input.bool(true, "① Pinbar",         group = "Enable")
useS2  = input.bool(true, "② 吞没",      group = "Enable")
useS3a = input.bool(true, "③顶分型",   group = "Enable")
useS3b = input.bool(true, "③底分型",   group = "Enable")
useS4  = input.bool(true, "④单孕线",         group = "Enable")
useS5  = input.bool(true, "④双孕线", group = "Enable")
useS6  = input.bool(true, "⑤ 大实体K",       group = "Enable")
secret = input.string("demo-secret-change-me", "Webhook secret", group = "Bridge")


// ─── Repository: webhook + entry per signal ────────────────────────
payload(string side, string tag) =>
    '{"secret":"' + secret + '","id":"' + tag + '-' + side + '-{{timenow}}","ts":"{{timenow}}","symbol":"' + syminfo.ticker + '","side":"' + side + '","comment":"' + tag + '"}'

fire(string side, string tag) =>
    if barstate.isconfirmed and not na(side)
        strategy.entry(tag + "_" + (side == "BUY" ? "L" : "S"), side == "BUY" ? strategy.long : strategy.short)
        alert(payload(side, tag), alert.freq_once_per_bar_close)

// ─── Orchestrator ──────────────────────────────────────────────────
// Flow:
// 1. Lazy-detect each enabled signal (disabled → library never called)
// 2. Plot per-signal markers
// 3. Fire entry + alert for each enabled signal independently

// Step 1: Lazy detection
sPin = useS1 ? S.pinbar(pinLong, pinShort, pinStrict) : na
sEng = useS2 ? S.engulf() : na
[fTop, fBot] = if useS3a or useS3b
    S.fractal()
else
    [string(na), string(na)]
sTop = useS3a ? fTop : na
sBot = useS3b ? fBot : na
[fHar, fDbl] = if useS4 or useS5
    S.harami()
else
    [string(na), string(na)]
sHar = useS4 ? fHar : na
sDbl = useS5 ? fDbl : na
sBig = useS6 ? S.bigbody(bigFrac) : na

// Step 2: Markers
plotshape(sPin == "BUY",  "Pinbar BUY",    shape.triangleup,   location.belowbar, color.lime,   text = "Pin",  size = size.tiny)
plotshape(sPin == "SELL", "Pinbar SELL",   shape.triangledown, location.abovebar, color.red,    text = "Pin",  size = size.tiny)
plotshape(sEng == "BUY",  "吞没 BUY",    shape.labelup,      location.belowbar, color.green,  text = "Eng",  textcolor = color.white, size = size.tiny)
plotshape(sEng == "SELL", "吞没 SELL",   shape.labeldown,    location.abovebar, color.maroon, text = "Eng",  textcolor = color.white, size = size.tiny)

plotshape(sTop == "SELL", "顶分型", shape.xcross, location.abovebar,
          color.orange, text = "Top", size = size.tiny, offset = -1)

plotshape(sBot == "BUY", "底分型", shape.xcross, location.belowbar,
          color.aqua, text = "Bot", size = size.tiny, offset = -1)
plotshape(sHar == "BUY",  "单孕线 BUY",    shape.circle,       location.belowbar, color.teal,   text = "Hrm",  size = size.tiny)
plotshape(sHar == "SELL", "单孕线 SELL",   shape.circle,       location.abovebar, color.purple, text = "Hrm",  size = size.tiny)
plotshape(sDbl == "BUY",  "双孕线 BUY",  shape.diamond,      location.belowbar, color.teal,   text = "2Hrm", size = size.tiny)
plotshape(sDbl == "SELL", "双孕线 SELL", shape.diamond,      location.abovebar, color.purple, text = "2Hrm", size = size.tiny)
plotshape(sBig == "BUY",  "大实体K BUY",   shape.flag,         location.belowbar, color.green,  text = "Big",  size = size.tiny)
plotshape(sBig == "SELL", "大实体K SELL",  shape.flag,         location.abovebar, color.red,    text = "Big",  size = size.tiny)


// Step 3: Fire each independently — own strategy.entry ID + own webhook tag
fire(sPin, "pinbar")
fire(sEng, "吞没")
fire(sTop, "顶分型")
fire(sBot, "底分型")
fire(sHar, "单孕线")
fire(sDbl, "双孕线")
fire(sBig, "大实体K")
