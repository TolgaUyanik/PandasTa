//@version=6

indicator("Combined Market Breadth Table", overlay=true)

// --- Color Definitions ---
color c_200   = color.rgb(255, 235, 59)  // Yellow
color c_50    = color.rgb(33, 150, 243)  // Blue
color c_20    = color.rgb(76, 175, 80)   // Green
color c_5     = color.rgb(255, 152, 0)   // Orange
color bg_c    = color.rgb(19, 23, 34)    // Dark Background
color head_c  = color.rgb(42, 46, 57)   // Header Background
color border_c = color.rgb(120, 123, 134) // Gray border color

// --- Fetch Data ---
// SPX
s_200 = request.security("S5TH", timeframe.period, close)
s_50  = request.security("S5FI", timeframe.period, close)
s_20  = request.security("S5TW", timeframe.period, close)
s_5   = request.security("S5FD", timeframe.period, close)
// NDX
n_200 = request.security("NDTH", timeframe.period, close)
n_50  = request.security("NDFI", timeframe.period, close)
n_20  = request.security("NDTW", timeframe.period, close)
n_5   = request.security("NDFD", timeframe.period, close)

// --- Table Setup ---
// Position: top_right | Frame and Border added for the "box" effect
var table bTable = table.new(position.top_right, columns = 3, rows = 5, 
     frame_color = border_c, frame_width = 2, 
     border_color = border_c, border_width = 1)

if barstate.islast
    // Headers
    table.cell(bTable, 0, 0, "Period",      text_color = color.white, bgcolor = head_c)
    table.cell(bTable, 1, 0, "NDX Breadth", text_color = color.white, bgcolor = head_c)
    table.cell(bTable, 2, 0, "SPX Breadth", text_color = color.white, bgcolor = head_c)

    // Row 1: 200-Day
    table.cell(bTable, 0, 1, "200-Day", text_color = c_200, bgcolor = bg_c)
    table.cell(bTable, 1, 1, str.tostring(n_200, "#.##"), text_color = c_200, bgcolor = bg_c)
    table.cell(bTable, 2, 1, str.tostring(s_200, "#.##"), text_color = c_200, bgcolor = bg_c)

    // Row 2: 50-Day
    table.cell(bTable, 0, 2, "50-Day",  text_color = c_50,  bgcolor = bg_c)
    table.cell(bTable, 1, 2, str.tostring(n_50, "#.##"),  text_color = c_50,  bgcolor = bg_c)
    table.cell(bTable, 2, 2, str.tostring(s_50, "#.##"),  text_color = c_50,  bgcolor = bg_c)

    // Row 3: 20-Day
    table.cell(bTable, 0, 3, "20-Day",  text_color = c_20,  bgcolor = bg_c)
    table.cell(bTable, 1, 3, str.tostring(n_20, "#.##"),  text_color = c_20,  bgcolor = bg_c)
    table.cell(bTable, 2, 3, str.tostring(s_20, "#.##"),  text_color = c_20,  bgcolor = bg_c)

    // Row 4: 5-Day
    table.cell(bTable, 0, 4, "5-Day",   text_color = c_5,   bgcolor = bg_c)
    table.cell(bTable, 1, 4, str.tostring(n_5, "#.##"),   text_color = c_5,   bgcolor = bg_c)
    table.cell(bTable, 2, 4, str.tostring(s_5, "#.##"),   text_color = c_5,   bgcolor = bg_c)