//@version=6
indicator("HTF Low Bounce Scan (Month/Week)", shorttitle="HTF Low Bounce", overlay=true, max_labels_count=500)

// ─────────────────────────────────────────────────────────────
// Run on the 1D timeframe. Two mutually exclusive scan criteria
// vs the PRIOR completed month's range (or week's, via dropdown):
//
// Scan 1 (Held the level): green day (close > open), close within
//   lower X% of prior HTF range, and price has NOT dipped below
//   the prior HTF low anywhere in the lookback window.
//
// Scan 2 (Reclaimed prior low): price DID dip below the prior HTF
//   low somewhere in the lookback window, but close is back above
//   it and the day is green.
// ─────────────────────────────────────────────────────────────

// ── Inputs ──
htfChoice = input.string("Month", "Prior range timeframe", options = ["Month", "Week"])
zonePct   = input.float(10.0, "Scan 1: lower zone, % of prior range above its low", minval = 1, maxval = 100, step = 1)
lookback  = input.int(20, "Lookback for hold/dip check (bars)", minval = 1, maxval = 60)
lblSizeIn = input.string("normal", "Label text size", options = ["tiny", "small", "normal", "large", "huge"])
showLines = input.bool(true, "Show prior HTF low + zone top lines")

// ── Prior completed HTF ranges (non-repainting) ──
[pmH, pmL] = request.security(syminfo.tickerid, "M", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pwH, pwL] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)

htfHigh  = htfChoice == "Month" ? pmH : pwH
htfLow   = htfChoice == "Month" ? pmL : pwL
htfRange = htfHigh - htfLow
zoneTop  = htfLow + htfRange * zonePct / 100

greenDay = close > open
inLowerZone = close > htfLow and close <= zoneTop
lowestInWindow = ta.lowest(low, lookback)
neverDipped    = lowestInWindow >= htfLow
didDip         = lowestInWindow < htfLow
reclaimed      = close > htfLow

// ── Scan 1: held the level (no breach anywhere in the window) ──
scan1 = greenDay and inLowerZone and neverDipped

// ── Scan 2: dipped below prior HTF low in the window, now reclaimed ──
scan2 = greenDay and didDip and reclaimed

// ── Chart markers ──
string txt = ""
if scan1
    txt += "1"
if scan2
    txt += (txt == "" ? "" : "\n") + "R"

color mkColor = scan2 ? color.new(color.orange, 0) : color.new(color.teal, 0)

if txt != ""
    lblSize = lblSizeIn == "tiny" ? size.tiny : lblSizeIn == "small" ? size.small : lblSizeIn == "normal" ? size.normal : lblSizeIn == "large" ? size.large : size.huge
    label.new(bar_index, na, txt, yloc = yloc.belowbar, style = label.style_none, textcolor = mkColor, size = lblSize)

// ── Reference lines ──
plot(showLines ? htfLow  : na, "Prior HTF Low",  color = color.new(color.purple, 0),  style = plot.style_steplinebr, linewidth = 2)
plot(showLines ? zoneTop : na, "Lower Zone Top", color = color.new(color.purple, 60), style = plot.style_steplinebr)

// ── Screener outputs ──
plot(scan1          ? 1 : 0, "Scan 1: Held the level",     display = display.data_window)
plot(scan2          ? 1 : 0, "Scan 2: Reclaimed prior low", display = display.data_window)
plot(scan1 or scan2 ? 1 : 0, "Scan 1 or Scan 2",           display = display.data_window)

// ── Alerts ──
alertcondition(scan1,          "Held the level (green day)",       "{{ticker}}: green day, held prior HTF low, in lower zone")
alertcondition(scan2,          "Reclaimed prior HTF low (green day)","{{ticker}}: dipped below prior HTF low and reclaimed it, green day")
alertcondition(scan1 or scan2, "Scan 1 or Scan 2",                 "{{ticker}}: HTF low bounce signal")
