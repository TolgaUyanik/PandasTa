// © Kpt-Ahab
// This script incorporates ideas and code snippets shared by the TradingView Community.
// Thank you to all contributors!
// [Kpt-Ahab] Rotation & Relative Flow Heatmap

//@version=6
indicator(title = "[Kpt-Ahab] Rotation & Relative Flow Heatmap")

// ---------------------------------------------------
// Input Groups
// ---------------------------------------------------

const string group_heatmap = "Heatmap Settings"
const string group_symbols = "Symbols"
const string group_labels  = "Labels"

// ---------------------------------------------------
// Indicator Selection
// ---------------------------------------------------

selected_indicator = input.string(
     defval = "PRICE",
     title = "Indicator",
     options = [
          "PRICE",
          "VOLUME",
          "REL_DOLLAR_VOL",
          "SIGNED_FLOW_RET_X_RELVOL",
          "SIGNED_FLOW_RET_X_ZSCORE"
     ],
     group = group_heatmap,
     tooltip = "PRICE: Price direction combined with its position inside the lookback range.\n" +
               "VOLUME: Volume direction combined with its position inside the lookback range. This does not represent bullish or bearish price direction.\n" +
               "REL_DOLLAR_VOL: Current dollar volume relative to its moving average.\n" +
               "SIGNED_FLOW_RET_X_RELVOL: One-bar price return weighted by relative dollar volume.\n" +
               "SIGNED_FLOW_RET_X_ZSCORE: One-bar price return weighted only by the positive dollar-volume Z-score."
)

bool is_price_mode        = selected_indicator == "PRICE"
bool is_volume_mode       = selected_indicator == "VOLUME"
bool is_rel_dollar_mode   = selected_indicator == "REL_DOLLAR_VOL"
bool is_flow_relvol_mode  = selected_indicator == "SIGNED_FLOW_RET_X_RELVOL"
bool is_flow_zscore_mode  = selected_indicator == "SIGNED_FLOW_RET_X_ZSCORE"
bool is_flow_mode         = is_flow_relvol_mode or is_flow_zscore_mode

// ---------------------------------------------------
// Color Scheme
// ---------------------------------------------------

selected_color_scheme = input.string(
     defval = "Classic Dark",
     title = "Color Scheme",
     options = [
          "Classic Light",
          "Classic Dark",
          "Colorblind Light",
          "Colorblind Dark",
          "Purple ⇅ Cyan"
     ],
     group = group_heatmap,
     tooltip = "Selects the negative, neutral, and positive colors used by the heatmap. Neutral colors are intentionally opaque so the vertical gradient remains consistent across different chart backgrounds."
)

bool scheme_classic_light =
     selected_color_scheme == "Classic Light"

bool scheme_classic_dark =
     selected_color_scheme == "Classic Dark"

bool scheme_colorblind_light =
     selected_color_scheme == "Colorblind Light"

bool scheme_colorblind_dark =
     selected_color_scheme == "Colorblind Dark"

bool scheme_purple_cyan =
     selected_color_scheme == "Purple ⇅ Cyan"

color color_negative = na
color color_neutral  = na
color color_positive = na

if scheme_classic_light
    color_negative := #D84A4A
    color_neutral  := #E8ECEF
    color_positive := #2FA66A

else if scheme_classic_dark
    color_negative := #FF5865
    color_neutral  := #202833
    color_positive := #36D486

else if scheme_colorblind_light
    color_negative := #E67E22
    color_neutral  := #DDE3E8
    color_positive := #2F80ED

else if scheme_colorblind_dark
    color_negative := #FF9F43
    color_neutral  := #222A35
    color_positive := #4DA3FF

else
    color_negative := #A044C5
    color_neutral  := #222631
    color_positive := #00B8C8

// ---------------------------------------------------
// Symbol Input
// ---------------------------------------------------

symbol_01 = input.symbol(defval = "XLRE", title = "Symbol 01", group = group_symbols)
symbol_02 = input.symbol(defval = "XLF",  title = "Symbol 02", group = group_symbols)
symbol_03 = input.symbol(defval = "XLY",  title = "Symbol 03", group = group_symbols)
symbol_04 = input.symbol(defval = "XLI",  title = "Symbol 04", group = group_symbols)
symbol_05 = input.symbol(defval = "XLK",  title = "Symbol 05", group = group_symbols)
symbol_06 = input.symbol(defval = "XLC",  title = "Symbol 06", group = group_symbols)
symbol_07 = input.symbol(defval = "XLB",  title = "Symbol 07", group = group_symbols)
symbol_08 = input.symbol(defval = "XLE",  title = "Symbol 08", group = group_symbols)
symbol_09 = input.symbol(defval = "XLU",  title = "Symbol 09", group = group_symbols)
symbol_10 = input.symbol(defval = "XLP",  title = "Symbol 10", group = group_symbols)
symbol_11 = input.symbol(defval = "XLV",  title = "Symbol 11", group = group_symbols)

smooth_metric = input.bool(
     defval = true,
     title = "Smooth Heatmap Metric",
     group = group_symbols,
     inline = "metric_smoothing",
     tooltip = "Smooths the displayed heatmap metric with a short EMA. The statistical lookback and row-sorting smoothing remain independent."
)

metric_smooth_length = input.int(
     defval = 120,
     title = "Smooth Length",
     minval = 1,
     group = group_symbols,
     inline = "metric_smoothing",
     tooltip = "EMA length used only for heatmap colors and automatic metric labels. Lower values produce faster and stronger color changes."
)

lookback_length = input.int(
     defval = 60,
     title = "Lookback",
     minval = 2,
     group = group_symbols,
     tooltip = "Statistical lookback used for relative dollar volume, Z-scores, and PRICE/VOLUME range calculations."
)

// ---------------------------------------------------
// Flow Settings
// ---------------------------------------------------

relative_dollar_scale_max = input.float(
     defval = 0.50,
     title = "Relative Dollar Volume Scale",
     minval = 0.05,
     step = 0.05,
     group = group_heatmap,
     tooltip = "Defines the distance from 1.0x relative dollar volume that maps to maximum color intensity. A value of 0.50 means that 1.50x or 0.50x reaches maximum intensity. Lower values produce stronger colors."
)

rotation_scale_max = input.float(
     defval = 0.005,
     title = "Rotation Scale Max",
     minval = 0.0001,
     step = 0.001,
     group = group_heatmap,
     tooltip = "Defines the absolute relative-flow value that maps to maximum color intensity. Flow values are decimal returns, so 0.01 equals 1%. Lower values produce stronger signed-flow colors."
)

color_response_curve = input.float(
     defval = 0.40,
     title = "Color Response Curve",
     minval = 0.20,
     maxval = 1.00,
     step = 0.05,
     group = group_heatmap,
     tooltip = "Boosts low and medium color intensities. 1.00 is linear. Lower values produce stronger colors without changing the sign or maximum intensity."
)

sort_flow_rows = input.bool(
     defval = false,
     title = "Sort Flow Rows",
     group = group_heatmap,
     tooltip = "Sorts the heatmap rows by relative flow strength in the signed-flow modes. Rank 1 shows the strongest symbol and Rank 11 the weakest symbol on each bar. Because the ranking is recalculated historically, a row represents a rank position and not one fixed symbol."
)

sort_smooth_length = input.int(
     defval = 3,
     title = "Sort Smooth Length",
     minval = 1,
     group = group_heatmap,
     tooltip = "Defines how many bars of relative flow are averaged for the row ranking. A value of 1 sorts by the current bar only and reacts quickly. Higher values create a more stable ranking but respond more slowly to changes."
)

// ---------------------------------------------------
// Metric Display
// ---------------------------------------------------

show_metric_value = input.bool(
     defval = true,
     title = "Show Metric Value",
     group = group_labels
)

metric_value_mode = input.string(
     defval = "Auto",
     title = "Metric Display",
     options = [
          "Auto",
          "Off",
          "RelVol x",
          "Metric",
          "Z-Score σ",
          "Relative Flow"
     ],
     group = group_labels,
     tooltip = "Auto displays the value most relevant to the selected indicator. Metric shows the active heatmap metric. RelVol x shows relative dollar volume. Z-Score σ shows the dollar-volume Z-score. Relative Flow shows the symbol's flow relative to the average of all valid symbols."
)

label_mode = input.string(
     defval = "Ticker",
     title = "Label Text",
     options = ["Ticker", "Sector", "Full", "Type"],
     group = group_labels,
     tooltip = "Ticker: Shows the selected symbol.\n" +
               "Sector: Attempts to extract a sector name from the TradingView description.\n" +
               "Full: Shows the complete TradingView symbol description.\n" +
               "Type: Classifies the description as ETF, Fund, Trust, or Asset."
)

// ---------------------------------------------------
// Symbol Data
// ---------------------------------------------------

[price_01, volume_01] = request.security(symbol_01, timeframe.period, [close, volume])
[price_02, volume_02] = request.security(symbol_02, timeframe.period, [close, volume])
[price_03, volume_03] = request.security(symbol_03, timeframe.period, [close, volume])
[price_04, volume_04] = request.security(symbol_04, timeframe.period, [close, volume])
[price_05, volume_05] = request.security(symbol_05, timeframe.period, [close, volume])
[price_06, volume_06] = request.security(symbol_06, timeframe.period, [close, volume])
[price_07, volume_07] = request.security(symbol_07, timeframe.period, [close, volume])
[price_08, volume_08] = request.security(symbol_08, timeframe.period, [close, volume])
[price_09, volume_09] = request.security(symbol_09, timeframe.period, [close, volume])
[price_10, volume_10] = request.security(symbol_10, timeframe.period, [close, volume])
[price_11, volume_11] = request.security(symbol_11, timeframe.period, [close, volume])

// ---------------------------------------------------
// Helper Functions
// ---------------------------------------------------

clamp(value, minimum, maximum) =>
    math.max(minimum, math.min(value, maximum))

boost_color_intensity(raw_intensity) =>
    clamped_intensity =
         clamp(raw_intensity, 0.0, 1.0)

    math.pow(
         clamped_intensity,
         color_response_curve
    )

blend(color_1, color_2, factor) =>
    clamped_factor = clamp(factor, 0.0, 1.0)

    red_value =
         color.r(color_1) +
         (color.r(color_2) - color.r(color_1)) * clamped_factor

    green_value =
         color.g(color_1) +
         (color.g(color_2) - color.g(color_1)) * clamped_factor

    blue_value =
         color.b(color_1) +
         (color.b(color_2) - color.b(color_1)) * clamped_factor

    transparency_value =
         color.t(color_1) +
         (color.t(color_2) - color.t(color_1)) * clamped_factor

    color.rgb(
         math.round(red_value),
         math.round(green_value),
         math.round(blue_value),
         transparency_value
    )

calc_intensity(value, minimum, maximum) =>
    span = math.max(maximum - minimum, 1e-10)
    percentage = (value - minimum) / span * 100.0
    clamp(percentage, 0.0, 100.0)

calc_relative_dollar_volume(price_series, volume_series, length) =>
    dollar_volume = price_series * volume_series
    average_dollar_volume = ta.sma(dollar_volume, length)

    not na(average_dollar_volume) and average_dollar_volume != 0.0 ?
         dollar_volume / average_dollar_volume :
         na

calc_dollar_volume_zscore(price_series, volume_series, length) =>
    dollar_volume = price_series * volume_series
    average_dollar_volume = ta.sma(dollar_volume, length)
    standard_deviation = ta.stdev(dollar_volume, length)

    not na(average_dollar_volume) and
     not na(standard_deviation) and
     standard_deviation != 0.0 ?
         (dollar_volume - average_dollar_volume) / standard_deviation :
         na

calc_price_change_percent(price_series) =>
    previous_price = price_series[1]

    not na(previous_price) and previous_price != 0.0 ?
         price_series / previous_price - 1.0 :
         na

calc_metric(price_series, volume_series, length) =>
    relative_dollar_volume =
         calc_relative_dollar_volume(
              price_series,
              volume_series,
              length)

    dollar_volume_zscore =
         calc_dollar_volume_zscore(
              price_series,
              volume_series,
              length)

    one_bar_return =
         calc_price_change_percent(price_series)

    flow_relative_volume =
         one_bar_return * relative_dollar_volume

    positive_zscore_weight =
         math.max(dollar_volume_zscore, 0.0)

    flow_zscore =
         one_bar_return * positive_zscore_weight

    selected_metric =
         is_price_mode ? price_series :
         is_volume_mode ? volume_series :
         is_rel_dollar_mode ? relative_dollar_volume :
         is_flow_relvol_mode ? flow_relative_volume :
         flow_zscore

    [selected_metric, relative_dollar_volume, dollar_volume_zscore, flow_relative_volume, flow_zscore]

average_valid_11(
     value_01,
     value_02,
     value_03,
     value_04,
     value_05,
     value_06,
     value_07,
     value_08,
     value_09,
     value_10,
     value_11
) =>
    valid_count =
         (not na(value_01) ? 1 : 0) +
         (not na(value_02) ? 1 : 0) +
         (not na(value_03) ? 1 : 0) +
         (not na(value_04) ? 1 : 0) +
         (not na(value_05) ? 1 : 0) +
         (not na(value_06) ? 1 : 0) +
         (not na(value_07) ? 1 : 0) +
         (not na(value_08) ? 1 : 0) +
         (not na(value_09) ? 1 : 0) +
         (not na(value_10) ? 1 : 0) +
         (not na(value_11) ? 1 : 0)

    valid_sum =
         nz(value_01, 0.0) +
         nz(value_02, 0.0) +
         nz(value_03, 0.0) +
         nz(value_04, 0.0) +
         nz(value_05, 0.0) +
         nz(value_06, 0.0) +
         nz(value_07, 0.0) +
         nz(value_08, 0.0) +
         nz(value_09, 0.0) +
         nz(value_10, 0.0) +
         nz(value_11, 0.0)

    valid_count > 0 ? valid_sum / valid_count : na

is_better(value_a, value_b, index_a, index_b) =>
    not na(value_a) and
     not na(value_b) and
     (value_a > value_b or (value_a == value_b and index_a < index_b))

// ---------------------------------------------------
// Metric Calculation
// ---------------------------------------------------

[metric_01, rel_vol_01, z_vol_01, flow_rel_01, flow_z_01] = calc_metric(price_01, volume_01, lookback_length)
[metric_02, rel_vol_02, z_vol_02, flow_rel_02, flow_z_02] = calc_metric(price_02, volume_02, lookback_length)
[metric_03, rel_vol_03, z_vol_03, flow_rel_03, flow_z_03] = calc_metric(price_03, volume_03, lookback_length)
[metric_04, rel_vol_04, z_vol_04, flow_rel_04, flow_z_04] = calc_metric(price_04, volume_04, lookback_length)
[metric_05, rel_vol_05, z_vol_05, flow_rel_05, flow_z_05] = calc_metric(price_05, volume_05, lookback_length)
[metric_06, rel_vol_06, z_vol_06, flow_rel_06, flow_z_06] = calc_metric(price_06, volume_06, lookback_length)
[metric_07, rel_vol_07, z_vol_07, flow_rel_07, flow_z_07] = calc_metric(price_07, volume_07, lookback_length)
[metric_08, rel_vol_08, z_vol_08, flow_rel_08, flow_z_08] = calc_metric(price_08, volume_08, lookback_length)
[metric_09, rel_vol_09, z_vol_09, flow_rel_09, flow_z_09] = calc_metric(price_09, volume_09, lookback_length)
[metric_10, rel_vol_10, z_vol_10, flow_rel_10, flow_z_10] = calc_metric(price_10, volume_10, lookback_length)
[metric_11, rel_vol_11, z_vol_11, flow_rel_11, flow_z_11] = calc_metric(price_11, volume_11, lookback_length)

// ---------------------------------------------------
// Cross-Sectional Relative Flow
// ---------------------------------------------------

average_flow_rel = average_valid_11(
     flow_rel_01,
     flow_rel_02,
     flow_rel_03,
     flow_rel_04,
     flow_rel_05,
     flow_rel_06,
     flow_rel_07,
     flow_rel_08,
     flow_rel_09,
     flow_rel_10,
     flow_rel_11
)

average_flow_z = average_valid_11(
     flow_z_01,
     flow_z_02,
     flow_z_03,
     flow_z_04,
     flow_z_05,
     flow_z_06,
     flow_z_07,
     flow_z_08,
     flow_z_09,
     flow_z_10,
     flow_z_11
)

relative_flow_01 = is_flow_zscore_mode ? flow_z_01 - average_flow_z : flow_rel_01 - average_flow_rel
relative_flow_02 = is_flow_zscore_mode ? flow_z_02 - average_flow_z : flow_rel_02 - average_flow_rel
relative_flow_03 = is_flow_zscore_mode ? flow_z_03 - average_flow_z : flow_rel_03 - average_flow_rel
relative_flow_04 = is_flow_zscore_mode ? flow_z_04 - average_flow_z : flow_rel_04 - average_flow_rel
relative_flow_05 = is_flow_zscore_mode ? flow_z_05 - average_flow_z : flow_rel_05 - average_flow_rel
relative_flow_06 = is_flow_zscore_mode ? flow_z_06 - average_flow_z : flow_rel_06 - average_flow_rel
relative_flow_07 = is_flow_zscore_mode ? flow_z_07 - average_flow_z : flow_rel_07 - average_flow_rel
relative_flow_08 = is_flow_zscore_mode ? flow_z_08 - average_flow_z : flow_rel_08 - average_flow_rel
relative_flow_09 = is_flow_zscore_mode ? flow_z_09 - average_flow_z : flow_rel_09 - average_flow_rel
relative_flow_10 = is_flow_zscore_mode ? flow_z_10 - average_flow_z : flow_rel_10 - average_flow_rel
relative_flow_11 = is_flow_zscore_mode ? flow_z_11 - average_flow_z : flow_rel_11 - average_flow_rel

// ---------------------------------------------------
// Heatmap Metric Smoothing
// ---------------------------------------------------

display_metric_01 = smooth_metric ? ta.ema(metric_01, metric_smooth_length) : metric_01
display_metric_02 = smooth_metric ? ta.ema(metric_02, metric_smooth_length) : metric_02
display_metric_03 = smooth_metric ? ta.ema(metric_03, metric_smooth_length) : metric_03
display_metric_04 = smooth_metric ? ta.ema(metric_04, metric_smooth_length) : metric_04
display_metric_05 = smooth_metric ? ta.ema(metric_05, metric_smooth_length) : metric_05
display_metric_06 = smooth_metric ? ta.ema(metric_06, metric_smooth_length) : metric_06
display_metric_07 = smooth_metric ? ta.ema(metric_07, metric_smooth_length) : metric_07
display_metric_08 = smooth_metric ? ta.ema(metric_08, metric_smooth_length) : metric_08
display_metric_09 = smooth_metric ? ta.ema(metric_09, metric_smooth_length) : metric_09
display_metric_10 = smooth_metric ? ta.ema(metric_10, metric_smooth_length) : metric_10
display_metric_11 = smooth_metric ? ta.ema(metric_11, metric_smooth_length) : metric_11

display_relative_flow_01 = smooth_metric ? ta.ema(relative_flow_01, metric_smooth_length) : relative_flow_01
display_relative_flow_02 = smooth_metric ? ta.ema(relative_flow_02, metric_smooth_length) : relative_flow_02
display_relative_flow_03 = smooth_metric ? ta.ema(relative_flow_03, metric_smooth_length) : relative_flow_03
display_relative_flow_04 = smooth_metric ? ta.ema(relative_flow_04, metric_smooth_length) : relative_flow_04
display_relative_flow_05 = smooth_metric ? ta.ema(relative_flow_05, metric_smooth_length) : relative_flow_05
display_relative_flow_06 = smooth_metric ? ta.ema(relative_flow_06, metric_smooth_length) : relative_flow_06
display_relative_flow_07 = smooth_metric ? ta.ema(relative_flow_07, metric_smooth_length) : relative_flow_07
display_relative_flow_08 = smooth_metric ? ta.ema(relative_flow_08, metric_smooth_length) : relative_flow_08
display_relative_flow_09 = smooth_metric ? ta.ema(relative_flow_09, metric_smooth_length) : relative_flow_09
display_relative_flow_10 = smooth_metric ? ta.ema(relative_flow_10, metric_smooth_length) : relative_flow_10
display_relative_flow_11 = smooth_metric ? ta.ema(relative_flow_11, metric_smooth_length) : relative_flow_11

display_low_01 = ta.lowest(display_metric_01, lookback_length)
display_high_01 = ta.highest(display_metric_01, lookback_length)
display_low_02 = ta.lowest(display_metric_02, lookback_length)
display_high_02 = ta.highest(display_metric_02, lookback_length)
display_low_03 = ta.lowest(display_metric_03, lookback_length)
display_high_03 = ta.highest(display_metric_03, lookback_length)
display_low_04 = ta.lowest(display_metric_04, lookback_length)
display_high_04 = ta.highest(display_metric_04, lookback_length)
display_low_05 = ta.lowest(display_metric_05, lookback_length)
display_high_05 = ta.highest(display_metric_05, lookback_length)
display_low_06 = ta.lowest(display_metric_06, lookback_length)
display_high_06 = ta.highest(display_metric_06, lookback_length)
display_low_07 = ta.lowest(display_metric_07, lookback_length)
display_high_07 = ta.highest(display_metric_07, lookback_length)
display_low_08 = ta.lowest(display_metric_08, lookback_length)
display_high_08 = ta.highest(display_metric_08, lookback_length)
display_low_09 = ta.lowest(display_metric_09, lookback_length)
display_high_09 = ta.highest(display_metric_09, lookback_length)
display_low_10 = ta.lowest(display_metric_10, lookback_length)
display_high_10 = ta.highest(display_metric_10, lookback_length)
display_low_11 = ta.lowest(display_metric_11, lookback_length)
display_high_11 = ta.highest(display_metric_11, lookback_length)

// ---------------------------------------------------
// Flow Row Sorting
// ---------------------------------------------------

sort_flow_01 = ta.sma(relative_flow_01, sort_smooth_length)
sort_flow_02 = ta.sma(relative_flow_02, sort_smooth_length)
sort_flow_03 = ta.sma(relative_flow_03, sort_smooth_length)
sort_flow_04 = ta.sma(relative_flow_04, sort_smooth_length)
sort_flow_05 = ta.sma(relative_flow_05, sort_smooth_length)
sort_flow_06 = ta.sma(relative_flow_06, sort_smooth_length)
sort_flow_07 = ta.sma(relative_flow_07, sort_smooth_length)
sort_flow_08 = ta.sma(relative_flow_08, sort_smooth_length)
sort_flow_09 = ta.sma(relative_flow_09, sort_smooth_length)
sort_flow_10 = ta.sma(relative_flow_10, sort_smooth_length)
sort_flow_11 = ta.sma(relative_flow_11, sort_smooth_length)

sort_ready =
     not na(sort_flow_01) and
     not na(sort_flow_02) and
     not na(sort_flow_03) and
     not na(sort_flow_04) and
     not na(sort_flow_05) and
     not na(sort_flow_06) and
     not na(sort_flow_07) and
     not na(sort_flow_08) and
     not na(sort_flow_09) and
     not na(sort_flow_10) and
     not na(sort_flow_11)

use_sorted_rows = is_flow_mode and sort_flow_rows and sort_ready

rank_01 = 1 +
     (is_better(sort_flow_02, sort_flow_01, 2, 1) ? 1 : 0) +
     (is_better(sort_flow_03, sort_flow_01, 3, 1) ? 1 : 0) +
     (is_better(sort_flow_04, sort_flow_01, 4, 1) ? 1 : 0) +
     (is_better(sort_flow_05, sort_flow_01, 5, 1) ? 1 : 0) +
     (is_better(sort_flow_06, sort_flow_01, 6, 1) ? 1 : 0) +
     (is_better(sort_flow_07, sort_flow_01, 7, 1) ? 1 : 0) +
     (is_better(sort_flow_08, sort_flow_01, 8, 1) ? 1 : 0) +
     (is_better(sort_flow_09, sort_flow_01, 9, 1) ? 1 : 0) +
     (is_better(sort_flow_10, sort_flow_01, 10, 1) ? 1 : 0) +
     (is_better(sort_flow_11, sort_flow_01, 11, 1) ? 1 : 0)

rank_02 = 1 +
     (is_better(sort_flow_01, sort_flow_02, 1, 2) ? 1 : 0) +
     (is_better(sort_flow_03, sort_flow_02, 3, 2) ? 1 : 0) +
     (is_better(sort_flow_04, sort_flow_02, 4, 2) ? 1 : 0) +
     (is_better(sort_flow_05, sort_flow_02, 5, 2) ? 1 : 0) +
     (is_better(sort_flow_06, sort_flow_02, 6, 2) ? 1 : 0) +
     (is_better(sort_flow_07, sort_flow_02, 7, 2) ? 1 : 0) +
     (is_better(sort_flow_08, sort_flow_02, 8, 2) ? 1 : 0) +
     (is_better(sort_flow_09, sort_flow_02, 9, 2) ? 1 : 0) +
     (is_better(sort_flow_10, sort_flow_02, 10, 2) ? 1 : 0) +
     (is_better(sort_flow_11, sort_flow_02, 11, 2) ? 1 : 0)

rank_03 = 1 +
     (is_better(sort_flow_01, sort_flow_03, 1, 3) ? 1 : 0) +
