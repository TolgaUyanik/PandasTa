// ---------------------------------------------------
// Symbol Descriptions
// ---------------------------------------------------

get_description(symbol) =>
    request.security(
         symbol,
         timeframe.period,
         syminfo.description,
         gaps = barmerge.gaps_off
    )

description_01 = get_description(symbol_01)
description_02 = get_description(symbol_02)
description_03 = get_description(symbol_03)
description_04 = get_description(symbol_04)
description_05 = get_description(symbol_05)
description_06 = get_description(symbol_06)
description_07 = get_description(symbol_07)
description_08 = get_description(symbol_08)
description_09 = get_description(symbol_09)
description_10 = get_description(symbol_10)
description_11 = get_description(symbol_11)

// ---------------------------------------------------
// Label Helper Functions
// ---------------------------------------------------

sector_from(description) =>
    cleaned_description = na(description) ? "" : description
    cleaned_description := str.replace_all(cleaned_description, "Select Sector SPDR Fund", "")
    cleaned_description := str.replace_all(cleaned_description, "SPDR Fund", "")
    cleaned_description := str.replace_all(cleaned_description, "ETF", "")
    str.trim(cleaned_description)

type_from(description) =>
    safe_description = na(description) ? "" : description

    str.contains(safe_description, "ETF") ? "ETF" :
     str.contains(safe_description, "Fund") ? "Fund" :
     str.contains(safe_description, "Trust") ? "Trust" :
     "Asset"

choose_label(symbol, description) =>
    switch label_mode
        "Ticker" => symbol
        "Full"   => na(description) ? "" : description
        "Sector" => sector_from(description)
        "Type"   => type_from(description)

format_metric_value(metric, relative_volume, zscore, relative_flow) =>
    if metric_value_mode == "Off"
        ""
    else if metric_value_mode == "RelVol x"
        str.format("{0,number,#.##}x", relative_volume)
    else if metric_value_mode == "Metric"
        str.format("{0,number,#.####}", metric)
    else if metric_value_mode == "Z-Score σ"
        str.format("{0,number,#.##}σ", zscore)
    else if metric_value_mode == "Relative Flow"
        str.format("{0,number,#.####}", relative_flow)
    else
        is_price_mode ? str.format("{0,number,#.####}", metric) :
         is_volume_mode ? str.format("{0,number,#}", metric) :
         is_rel_dollar_mode ? str.format("{0,number,#.##}x", metric) :
         is_flow_mode ? str.format("{0,number,#.####}", relative_flow) :
         ""

build_label_text(symbol, description, metric, relative_volume, zscore, relative_flow) =>
    base_text = choose_label(symbol, description)
    metric_text = show_metric_value ? format_metric_value(metric, relative_volume, zscore, relative_flow) : ""

    str.length(metric_text) > 0 ? base_text + "  " + metric_text : base_text

create_heatmap_label(y_value, label_text) =>
    label.new(
         x = bar_index + 35,
         y = y_value,
         text = label_text,
         color = color.new(color.white, 20),
         style = label.style_none,
         textcolor = #fefeff,
         yloc = yloc.price,
         xloc = xloc.bar_index,
         size = size.normal,
         textalign = text.align_right
    )

// ---------------------------------------------------
// Sorted Row Mapping
// ---------------------------------------------------

get_sorted_color(row_rank) =>
    rank_01 == row_rank ? color_symbol_01() :
     rank_02 == row_rank ? color_symbol_02() :
     rank_03 == row_rank ? color_symbol_03() :
     rank_04 == row_rank ? color_symbol_04() :
     rank_05 == row_rank ? color_symbol_05() :
     rank_06 == row_rank ? color_symbol_06() :
     rank_07 == row_rank ? color_symbol_07() :
     rank_08 == row_rank ? color_symbol_08() :
     rank_09 == row_rank ? color_symbol_09() :
     rank_10 == row_rank ? color_symbol_10() :
     rank_11 == row_rank ? color_symbol_11() :
     color_neutral

get_sorted_label_text(row_rank) =>
    rank_01 == row_rank ? build_label_text(symbol_01, description_01, display_metric_01, rel_vol_01, z_vol_01, display_relative_flow_01) :
     rank_02 == row_rank ? build_label_text(symbol_02, description_02, display_metric_02, rel_vol_02, z_vol_02, display_relative_flow_02) :
     rank_03 == row_rank ? build_label_text(symbol_03, description_03, display_metric_03, rel_vol_03, z_vol_03, display_relative_flow_03) :
     rank_04 == row_rank ? build_label_text(symbol_04, description_04, display_metric_04, rel_vol_04, z_vol_04, display_relative_flow_04) :
     rank_05 == row_rank ? build_label_text(symbol_05, description_05, display_metric_05, rel_vol_05, z_vol_05, display_relative_flow_05) :
     rank_06 == row_rank ? build_label_text(symbol_06, description_06, display_metric_06, rel_vol_06, z_vol_06, display_relative_flow_06) :
     rank_07 == row_rank ? build_label_text(symbol_07, description_07, display_metric_07, rel_vol_07, z_vol_07, display_relative_flow_07) :
     rank_08 == row_rank ? build_label_text(symbol_08, description_08, display_metric_08, rel_vol_08, z_vol_08, display_relative_flow_08) :
     rank_09 == row_rank ? build_label_text(symbol_09, description_09, display_metric_09, rel_vol_09, z_vol_09, display_relative_flow_09) :
     rank_10 == row_rank ? build_label_text(symbol_10, description_10, display_metric_10, rel_vol_10, z_vol_10, display_relative_flow_10) :
     rank_11 == row_rank ? build_label_text(symbol_11, description_11, display_metric_11, rel_vol_11, z_vol_11, display_relative_flow_11) :
     ""

// ---------------------------------------------------
// Vertical Heatmap Smoothing
// ---------------------------------------------------

heatmap_row_color_01 = use_sorted_rows ? get_sorted_color(1)  : color_symbol_01()
heatmap_row_color_02 = use_sorted_rows ? get_sorted_color(2)  : color_symbol_02()
heatmap_row_color_03 = use_sorted_rows ? get_sorted_color(3)  : color_symbol_03()
heatmap_row_color_04 = use_sorted_rows ? get_sorted_color(4)  : color_symbol_04()
heatmap_row_color_05 = use_sorted_rows ? get_sorted_color(5)  : color_symbol_05()
