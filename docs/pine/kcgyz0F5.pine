heatmap_row_color_07 = use_sorted_rows ? get_sorted_color(7)  : color_symbol_07()
heatmap_row_color_08 = use_sorted_rows ? get_sorted_color(8)  : color_symbol_08()
heatmap_row_color_09 = use_sorted_rows ? get_sorted_color(9)  : color_symbol_09()
heatmap_row_color_10 = use_sorted_rows ? get_sorted_color(10) : color_symbol_10()
heatmap_row_color_11 = use_sorted_rows ? get_sorted_color(11) : color_symbol_11()

get_heatmap_row_color(row_index) =>
    row_index == 1  ? heatmap_row_color_01 :
     row_index == 2  ? heatmap_row_color_02 :
     row_index == 3  ? heatmap_row_color_03 :
     row_index == 4  ? heatmap_row_color_04 :
     row_index == 5  ? heatmap_row_color_05 :
     row_index == 6  ? heatmap_row_color_06 :
     row_index == 7  ? heatmap_row_color_07 :
     row_index == 8  ? heatmap_row_color_08 :
     row_index == 9  ? heatmap_row_color_09 :
     row_index == 10 ? heatmap_row_color_10 :
     heatmap_row_color_11

get_vertical_gradient_color(strip_number) =>
    strip_height = 10.0 / 3.0
    strip_center_y = 110.0 - (strip_number - 0.5) * strip_height

    anchor_position =
         clamp(
              (105.0 - strip_center_y) / 10.0,
              0.0,
              10.0
         )

    upper_row_index = int(math.floor(anchor_position)) + 1
    lower_row_index = upper_row_index < 11 ? upper_row_index + 1 : 11
    blend_factor = anchor_position - math.floor(anchor_position)

    blend(
         get_heatmap_row_color(upper_row_index),
         get_heatmap_row_color(lower_row_index),
         blend_factor
    )

