// ---------------------------------------------------
// Metric Color
// ---------------------------------------------------

metric_to_color(metric_now, metric_previous, relative_flow, metric_low, metric_high) =>
    color output_color = color_neutral

    if is_price_mode or is_volume_mode
        range_ready =
             not na(metric_now) and
             not na(metric_previous) and
             not na(metric_low) and
             not na(metric_high)

        if range_ready
            range_position =
                 calc_intensity(
                      metric_now,
                      metric_low,
                      metric_high
                 ) / 100.0

            bullish_intensity =
                 boost_color_intensity(range_position)

            bearish_intensity =
                 boost_color_intensity(1.0 - range_position)

            output_color :=
                 metric_now > metric_previous ?
                      blend(
                           color_neutral,
                           color_positive,
                           bullish_intensity
                      ) :
                 metric_now < metric_previous ?
                      blend(
                           color_neutral,
                           color_negative,
                           bearish_intensity
                      ) :
                 color_neutral

    else if is_rel_dollar_mode
        if not na(metric_now) and not na(metric_previous)
            raw_intensity =
                 clamp(
                      math.abs(metric_now - 1.0) /
                           relative_dollar_scale_max,
                      0.0,
                      1.0
                 )

            intensity =
                 boost_color_intensity(raw_intensity)

            output_color :=
                 metric_now > metric_previous ?
                      blend(
                           color_neutral,
                           color_positive,
                           intensity
                      ) :
                 metric_now < metric_previous ?
                      blend(
                           color_neutral,
                           color_negative,
                           intensity
                      ) :
                 color_neutral

    else if not na(relative_flow)
        raw_intensity =
             clamp(
                  math.abs(relative_flow) /
                       rotation_scale_max,
                  0.0,
                  1.0
             )

        intensity =
             boost_color_intensity(raw_intensity)

        output_color :=
             relative_flow > 0.0 ?
                  blend(
                       color_neutral,
                       color_positive,
                       intensity
                  ) :
             relative_flow < 0.0 ?
                  blend(
                       color_neutral,
                       color_negative,
                       intensity
                  ) :
             color_neutral

    output_color

// ---------------------------------------------------
// Symbol Heatmap Colors
// ---------------------------------------------------

color_symbol_01() =>
    metric_to_color(display_metric_01, display_metric_01[1], display_relative_flow_01, display_low_01, display_high_01)

