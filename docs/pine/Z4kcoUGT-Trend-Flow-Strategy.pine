//@version=5
strategy("Trend Flow Strategy", overlay=true, process_orders_on_close=true, default_qty_type=strategy.fixed, default_qty_value=2000, initial_capital=10000, currency=currency.USD, pyramiding=0, slippage=20)

trade_mode     = input.string("ema_cross", "Entry Style", options=["ema_cross","ema_side","dual_ema_cross","rsi_reversal","rsi_trend","macd_cross","bb_reversion","bb_breakout","supertrend_flip","supertrend_ema","stoch_reversal","ichimoku_breakout","cmf_ema","psar_flip","squeeze_breakout","sr_breakout","fib_bounce","vpvr_breakout","weis_wave_trend","confluence_score"])
ema_fast       = input.int(5,   "Fast EMA",        minval=1)
ema_slow       = input.int(21,  "Slow EMA",        minval=1)
rsi_period     = input.int(21,  "RSI Period",      minval=2)
atr_period     = input.int(7,   "ATR Period",      minval=1)
vol_filter     = input.float(0.35,"Volume Filter",  minval=0.0)
use_adx        = input.bool(true, "Use ADX Filter")
adx_period     = input.int(21,  "ADX Period",      minval=1)
adx_min        = input.int(0,   "ADX Minimum",     minval=0)
vwap_style     = input.string("off", "VWAP Mode",  options=["off","side","cross"])
lookback_days  = input.int(0,   "Lookback Days (0=all)", minval=0)

stop_mult      = input.float(2.0,  "Stop Loss (ATR)",    minval=0.1)
tp_mult        = input.float(1.25, "Take Profit (ATR)",  minval=0.1)
trail_mult     = input.float(0.02, "Trail Distance (ATR)", minval=0.0)
use_trail      = input.bool(true,  "Use Trailing Stop")

macd_f         = input.int(12, "",  group="MACD", inline="macd")
macd_s         = input.int(26, "",  group="MACD", inline="macd")
macd_sig       = input.int(9,  "",  group="MACD", inline="macd")
bb_len         = input.int(14, "BB Length",  group="Bollinger")
bb_width       = input.float(2.0, "BB Std Dev",  group="Bollinger", minval=0.1)
stoch_len      = input.int(9,  "Stoch Length",  group="Stochastic")
stoch_sm       = input.int(3,  "Stoch Smoothing", group="Stochastic")
super_len      = input.int(14, "SuperTrend Length",  group="SuperTrend")
super_mult_    = input.float(3.0, "SuperTrend Multiplier", group="SuperTrend", minval=0.5)
sr_len         = input.int(40, "S/R Lookback",  group="Support/Resistance", inline="sr")
vpvr_len       = input.int(120,"VPVR Lookback", group="Support/Resistance", inline="sr")
fib_len        = input.int(120,"Fibonacci Lookback",  group="Fibonacci")

fast_ema = ta.ema(close, ema_fast)
slow_ema = ta.ema(close, ema_slow)
the_atr  = ta.atr(atr_period)
rsi_line = ta.rsi(close, rsi_period)
vol_avg  = ta.sma(volume, 20)

[macd1, macd2, macd_h] = ta.macd(close, macd_f, macd_s, macd_sig)

m = ta.sma(close, bb_len)
d = ta.stdev(close, bb_len) * bb_width
bu = m + d
bl = m - d

stochk = ta.stoch(close, high, low, stoch_len)
stochd = ta.sma(stochk, stoch_sm)

[st_dir, st_line] = ta.supertrend(super_mult_, super_len)

tnk = (ta.highest(high, 9) + ta.lowest(low, 9)) / 2
kjn = (ta.highest(high, 26) + ta.lowest(low, 26)) / 2

mf_mult = ((close - low) - (high - close)) / math.max(high - low, 0.000001)
mf_vol  = mf_mult * volume
cmf     = ta.sma(mf_vol, 20) / ta.sma(volume, 20)

psar   = ta.sar(0.02, 0.02, 0.2)
psar_d = close > psar ? 1 : -1

s20  = ta.sma(close, 20)
bbwu = s20 + ta.stdev(close, 20) * 2.0
bbwl = s20 - ta.stdev(close, 20) * 2.0
kcw  = ta.atr(20) * 1.5
sqz  = bbwl > s20 - kcw and bbwu < s20 + kcw
mlr  = 0.0
for q = 0 to 19
    hh = ta.highest(high, 20)[q]
    ll = ta.lowest(low, 20)[q]
    src = close[q] - (hh + ll) / 2.0
    mlr := mlr + (q - 9.5) * src
sqz_mom = mlr

s1 = ta.lowest(low, sr_len)
r1 = ta.highest(high, sr_len)

fhh = ta.highest(high, fib_len)
fll = ta.lowest(low, fib_len)
frr = fhh - fll
f382 = fhh - frr * 0.382
f618 = fhh - frr * 0.618

poc = ta.vwma(close, vpvr_len)

[di_p, di_n, adx] = ta.dmi(adx_period, adx_period)

vwap = ta.vwap(hlc3)

var float ww_v = 0.0
var float ww_w = 0.0
var int ww_pd = 0
ww_d = close > close[1] ? 1 : (close < close[1] ? -1 : nz(ww_pd, 0))
if ww_d == 0
    ww_w := ww_v * ww_pd
else
    if ww_pd == 0 or ww_d == ww_pd
        ww_v := ww_v + volume
    else
        ww_v := volume
    ww_pd := ww_d
    ww_w := ww_v * ww_d

up = close > open
dn = close < open

vol_good = volume > vol_avg * vol_filter
adx_good = use_adx ? adx >= adx_min : true
vwap_buy  = vwap_style == "off" ? true : (vwap_style == "side" ? close > vwap : ta.crossover(close, vwap))
vwap_sell = vwap_style == "off" ? true : (vwap_style == "side" ? close < vwap : ta.crossunder(close, vwap))

buy = switch trade_mode
    "ema_cross"        => up and ta.crossover(close, fast_ema)
    "ema_side"         => up and close > fast_ema
    "dual_ema_cross"   => up and ta.crossover(fast_ema, slow_ema)
    "rsi_reversal"     => rsi_line[1] <= 30 and rsi_line > 30
    "rsi_trend"        => close > fast_ema and rsi_line > 55
    "macd_cross"       => ta.crossover(macd1, macd2)
    "bb_reversion"     => close[1] < bl[1] and close > bl
    "bb_breakout"      => close > bu and up
    "supertrend_flip"  => st_dir > 0 and st_dir[1] < 0
    "supertrend_ema"   => st_dir > 0 and close > fast_ema
    "stoch_reversal"   => stochk[1] < 20 and ta.crossover(stochk, stochd)
    "ichimoku_breakout"=> close > math.max(tnk, kjn) and tnk > kjn
    "cmf_ema"          => close > fast_ema and cmf > 0.05
    "psar_flip"        => psar_d > 0 and psar_d[1] < 0
    "squeeze_breakout" => sqz[1] and not sqz and sqz_mom > 0
    "sr_breakout"      => close > r1[1] and up
    "fib_bounce"       => low <= f618 and close > f382 and close > fast_ema
    "vpvr_breakout"    => ta.crossover(close, poc) and close > fast_ema
    "weis_wave_trend"  => ww_w > ww_w[1] and close > fast_ema
    => false

sell = switch trade_mode
    "ema_cross"        => dn and ta.crossunder(close, fast_ema)
    "ema_side"         => dn and close < fast_ema
    "dual_ema_cross"   => dn and ta.crossunder(fast_ema, slow_ema)
    "rsi_reversal"     => rsi_line[1] >= 70 and rsi_line < 70
    "rsi_trend"        => close < fast_ema and rsi_line < 45
    "macd_cross"       => ta.crossunder(macd1, macd2)
    "bb_reversion"     => close[1] > bu[1] and close < bu
    "bb_breakout"      => close < bl and dn
    "supertrend_flip"  => st_dir < 0 and st_dir[1] > 0
    "supertrend_ema"   => st_dir < 0 and close < fast_ema
    "stoch_reversal"   => stochk[1] > 80 and ta.crossunder(stochk, stochd)
    "ichimoku_breakout"=> close < math.min(tnk, kjn) and tnk < kjn
    "cmf_ema"          => close < fast_ema and cmf < -0.05
    "psar_flip"        => psar_d < 0 and psar_d[1] > 0
    "squeeze_breakout" => sqz[1] and not sqz and sqz_mom < 0
    "sr_breakout"      => close < s1[1] and dn
    "fib_bounce"       => high >= f382 and close < f618 and close < fast_ema
    "vpvr_breakout"    => ta.crossunder(close, poc) and close < fast_ema
    "weis_wave_trend"  => ww_w < ww_w[1] and close < fast_ema
    => false

if trade_mode == "confluence_score"
    v1 = (close > fast_ema ? 1 : 0) + (rsi_line > 55 ? 1 : 0) + (macd_h > 0 ? 1 : 0) + (st_dir > 0 ? 1 : 0) + (cmf > 0 ? 1 : 0)
    v2 = (close < fast_ema ? 1 : 0) + (rsi_line < 45 ? 1 : 0) + (macd_h < 0 ? 1 : 0) + (st_dir < 0 ? 1 : 0) + (cmf < 0 ? 1 : 0)
    buy  := v1 >= 4 and v1 > v2 and up
    sell := v2 >= 4 and v2 > v1 and dn

in_range = lookback_days <= 0 or time > timenow - lookback_days * 86400000

go_long  = buy  and vol_good and vwap_buy  and adx_good and in_range
go_short = sell and vol_good and vwap_sell and adx_good and in_range

if go_long and strategy.position_size <= 0
    strategy.entry("L", strategy.long)
if go_short and strategy.position_size <= 0
    strategy.entry("S", strategy.short)

if strategy.position_size != 0
    sd = the_atr * stop_mult
    td = the_atr * trail_mult
    pd = the_atr * tp_mult
    if use_trail
        strategy.exit("X", "L", loss=int(sd/syminfo.mintick), trail_points=int(td/syminfo.mintick), trail_offset=int(td/syminfo.mintick))
        strategy.exit("X", "S", loss=int(sd/syminfo.mintick), trail_points=int(td/syminfo.mintick), trail_offset=int(td/syminfo.mintick))
    else
        strategy.exit("X", "L", profit=int(pd/syminfo.mintick), loss=int(sd/syminfo.mintick))
        strategy.exit("X", "S", profit=int(pd/syminfo.mintick), loss=int(sd/syminfo.mintick))

plot(fast_ema, "EMA", color=color.blue, linewidth=1)
plotshape(go_long,  style=shape.triangleup,   location=location.belowbar, color=color.green, size=size.small)
plotshape(go_short, style=shape.triangledown, location=location.abovebar, color=color.red,   size=size.small)
