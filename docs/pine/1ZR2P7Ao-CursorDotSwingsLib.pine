//@version=6
// Shared Dot / SuperTrend swing state for use inside request.security() (MTF table, etc.).
library("CursorDotSwingsLib", overlay=false)

// Returns packed int state (bitmask) to minimize memory usage in request.security().
// Bit layout:
// - bit 0: stBull (1=bull,0=bear)
// - bits 1..2: dotTrend encoded as (dotTrend + 1) => 0..2 (0=down,1=none,2=up)
// - bit 3: dot1Up
// - bit 4: dot2Up
// - bit 5: dot1Down
// - bit 6: dot2Down
export packDotStateInt(float multFactor, int atrLength, int trendEndTicks) =>
    var float runHigh = na
    var int runHighBar = na
    var int runHighTime = na
    var float runLow = na
    var int runLowBar = na
    var int runLowTime = na
    var float prevSwingHigh = na
    var float prevSwingLow = na
    var int lastHighClass = 0
    var int lastLowClass = 0
    var bool dot1Up = false
    var bool dot2Up = false
    var bool dot1Down = false
    var bool dot2Down = false
    var int dotTrend = 0

    [_, stDirection] = ta.supertrend(multFactor, atrLength)
    bullTrend = stDirection < 0
    bearTrend = stDirection > 0
    stBull = bullTrend

    flipLongToShort = bullTrend[1] and bearTrend
    flipShortToLong = bearTrend[1] and bullTrend

    trendEndOffset = trendEndTicks * syminfo.mintick

    if barstate.isfirst
        runHigh := high
        runHighBar := bar_index
        runHighTime := time
        runLow := low
        runLowBar := bar_index
        runLowTime := time

    if bullTrend
        if na(runHigh) or high >= runHigh
            runHigh := high
            runHighBar := bar_index
            runHighTime := time
    else if bearTrend
        if na(runLow) or low <= runLow
            runLow := low
            runLowBar := bar_index
            runLowTime := time

    if barstate.isconfirmed and flipLongToShort
        hhPrice = runHigh
        priorHigh = prevSwingHigh
        isHH = na(priorHigh) or hhPrice > priorHigh
        isLH = not na(priorHigh) and hhPrice < priorHigh
        lastHighClass := isHH ? 1 : isLH ? -1 : 0

        if dotTrend == 0 and lastLowClass == -1 and isLH
            dot1Down := true
            dot2Down := false
            dot1Up := false
            dot2Up := false
            dotTrend := -1

        if dotTrend == -1 and isHH and not na(priorHigh)
            trendEndPriceDown = priorHigh + trendEndOffset
            if close > trendEndPriceDown
                dot1Down := false
                dot2Down := false
                dotTrend := 0
            else
                dot2Down := true

        prevSwingHigh := hhPrice
        runLow := low
        runLowBar := bar_index
        runLowTime := time

    if barstate.isconfirmed and flipShortToLong
        llPrice = runLow
        priorLow = prevSwingLow
        isHL = not na(priorLow) and llPrice > priorLow
        isLL = na(priorLow) ? false : llPrice < priorLow
        lastLowClass := isHL ? 1 : isLL ? -1 : 0

        if dotTrend == 0 and lastHighClass == 1 and isHL
            dot1Up := true
            dot2Up := false
            dot1Down := false
            dot2Down := false
            dotTrend := 1

        if dotTrend == 1 and isLL and not na(priorLow)
            trendEndPriceUp = priorLow - trendEndOffset
            if close < trendEndPriceUp
                dot1Up := false
                dot2Up := false
                dotTrend := 0
            else
                dot2Up := true

        prevSwingLow := llPrice
        runHigh := high
        runHighBar := bar_index
        runHighTime := time

    if (dot1Up or dot2Up) and not na(prevSwingLow) and close < (prevSwingLow - trendEndOffset)
        dot1Up := false
        dot2Up := false
        dotTrend := 0

    if (dot1Down or dot2Down) and not na(prevSwingHigh) and close > (prevSwingHigh + trendEndOffset)
        dot1Down := false
        dot2Down := false
        dotTrend := 0

    stBit = stBull ? 1 : 0
    dtEnc = dotTrend + 1  // -1/0/1 -> 0/1/2
    state = stBit
    state += dtEnc * 2
    state += (dot1Up ? 1 : 0) * 8
    state += (dot2Up ? 1 : 0) * 16
    state += (dot1Down ? 1 : 0) * 32
    state += (dot2Down ? 1 : 0) * 64
    state
