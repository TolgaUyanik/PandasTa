// --- DECLARATION ------------------------------------------------------------------------------------

//@version=6
library(
       title             = "AxiomMovingAverageLibrary",
       overlay           = false,
       dynamic_requests  = true
       )

// --- MA TYPE ENUM & CONSTANTS ----------------------------------------------------------------------

//@enum Moving average types supported by this lite library for use with input.enum() and routing helpers.
//@field SMA       Simple moving average.
//@field EMA       Exponential moving average.
//@field RMA       Wilder/relative moving average (SMMA-style).
//@field WMA       Weighted moving average.
//@field VWMA      Volume-weighted moving average.
//@field SWMA      Symmetrically weighted moving average.
export enum MaType
    SMA       = "SMA"
    EMA       = "EMA"
    RMA       = "RMA"
    WMA       = "WMA"
    VWMA      = "VWMA"
    SWMA      = "SWMA"

// --- PUBLIC API ------------------------------------------------------------------------------------

// @function Simple Moving Average wrapper.
// @param src (series float) Source series to smooth.
// @param length (simple int) Number of bars in the averaging window.
// @returns (series float) Simple moving average of src over length bars.
export ma_sma(series float src, simple int length) =>
    ta.sma(src, length)

// @function Exponential Moving Average wrapper.
// @param src (series float) Source series to smooth.
// @param length (simple int) Number of bars in the averaging window.
// @returns (series float) Exponential moving average of src over length bars.
export ma_ema(series float src, simple int length) =>
    ta.ema(src, length)

// @function Wilder/Relative Moving Average wrapper.
// @param src (series float) Source series to smooth.
// @param length (simple int) Number of bars in the averaging window.
// @returns (series float) RMA/Wilder-style moving average of src.
export ma_rma(series float src, simple int length) =>
    ta.rma(src, length)

// @function Weighted Moving Average wrapper.
// @param src (series float) Source series to smooth.
// @param length (simple int) Number of bars in the averaging window.
// @returns (series float) Weighted moving average of src.
export ma_wma(series float src, simple int length) =>
    ta.wma(src, length)

// @function Volume-Weighted Moving Average wrapper.
// @param src (series float) Source series to smooth.
// @param length (simple int) Number of bars in the averaging window.
// @returns (series float) Volume-weighted moving average of src.
export ma_vwma(series float src, simple int length) =>
    ta.vwma(src, length)

// @function Symmetrically Weighted Moving Average wrapper (fixed length = 4).
// @param src (series float) Source series to smooth.
// @returns (series float) Symmetrically weighted moving average of src.
export ma_swma(series float src) =>
    ta.swma(src)

// --- META-DISPATCH HELPERS -------------------------------------------------------------------------

// @function Generic moving average dispatcher (lite).
// @param maType (MaType) Moving average type identifier.
// @param src (series float) Source series to smooth.
// @param length (simple int) Core length parameter used by most MAs.
// @returns (series float) Selected moving average series. Defaults to SMA when maType is unrecognized.
// Note: Only lite MA types are routed.
export get_ma(
     MaType maType,
     series float src,
     simple int length
     ) =>

    switch maType
        MaType.SMA       => ma_sma(src, length)
        MaType.EMA       => ma_ema(src, length)
        MaType.RMA       => ma_rma(src, length)
        MaType.WMA       => ma_wma(src, length)
        MaType.VWMA      => ma_vwma(src, length)
        MaType.SWMA      => ma_swma(src)
        => ma_sma(src, length)