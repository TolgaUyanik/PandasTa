//@version=6

// @description TODO: add library description here
library("Jags_Lib", overlay=true)

// General candle dynamics used within the library
CtopWick    = high - math.max(open, close)
CbottomWick = math.min(open, close) - low
Cheight     = high - low
Cup         = close > open
Cdown       = close < open
CBody       = math.max(open, close) - math.min(open, close)

wickVHratio = 0.455
badRejVal	= 0.4 // CBody > Cheight * badRejVal


// Uses ratio of wicks to identify rejection, rather than "close inside"
Cbearish    = CtopWick > Cheight * wickVHratio and high > high[1] and CtopWick > CbottomWick
Cbullish    = CbottomWick > Cheight * wickVHratio and low < low[1] and CbottomWick > CtopWick

// Normal rejection from one side, excludes single candle negations
CbearRej    = high > high[1] and close < high[1] and not (low < low[1] and close > low[1])
CbullRej    = low < low[1] and close > low[1] and not (high > high[1] and close < high[1])

// Normal FUs
CbearFU     = high > high[1] and close < low[1]
CbullFU     = low < low[1] and close > high[1]

// Purely a comparison of wick sizes to see which is greater rejection
CbearWick   = CtopWick > CbottomWick
CbullWick   = CbottomWick > CtopWick

// Identifies rejections that are strong moves against (for exclusion purposes)
BadBullRej  = (low < low[1] and close > low[1]) and (Cdown and CBody > Cheight * badRejVal)
BadBearRej  = (high > high[1] and close < high[1]) and (Cup and CBody > Cheight * badRejVal)

// COmbines all the above
RejBear = (((Cbearish or CbearRej) and CbearWick) or CbearFU) and not BadBearRej
RejBull = (((Cbullish or CbullRej) and CbullWick) or CbullFU) and not BadBullRej


// IB
IB = high < high[1] and low > low[1]





// ***************************************************************************************************************************************************************
// ONE CANDLE FUNCTIONS
// ***************************************************************************************************************************************************************


// @function Returns whether candle is a rejection based on complex rules within library
// @param int _can is the candle you want to reference. If current candle then 0
// @returns true/false

export RejBear(int _can) =>
	(((Cbearish[_can] or CbearRej[_can]) and CbearWick[_can]) or CbearFU[_can]) and not BadBearRej[_can]

// @function Returns whether candle is a rejection based on complex rules within library
// @param int _can is the candle you want to reference. If current candle then 0
// @returns true/false

export RejBull(int _can) =>
	(((Cbullish[_can] or CbullRej[_can]) and CbullWick[_can]) or CbullFU[_can]) and not BadBullRej[_can]


// ***************************************************************************************************************************************************************
// HCS FUNCTIONS
// ***************************************************************************************************************************************************************

// @function Returns whether current candle is creating a bull HCS
// @param int _can is the last candle of the HCS (0 = current candle, 1 = previous candle)
// @param int _lookback is the number of candles you want to look back to find HCS
// @returns integer value representing the first candle in the HCS. 0 = no HCS
export bullHCS(int _can, int _lookback) =>
	_reshbull = 0
	if RejBull[_can]
		for count = _can + 2 to _lookback + _can + 2
			if low[count] < low[_can] and not RejBull[count]
				break
			if RejBull[count] and low[count] < low[_can]
				_reshbull := count
				break
	_reshbull

// @function Returns whether current candle is creating a bear HCS
// @param int _can is the last candle of the HCS (0 = current candle, 1 = previous candle)
// @param int _lookback is the number of candles you want to look back to find HCS
// @returns integer value representing the first candle in the HCS. 0 = no HCS
export bearHCS(int _can, int _lookback) =>
	_reshbear = 0
	if RejBear[_can]
		for count = _can + 2 to _lookback + _can + 2
			if high[count] > high[_can] and not RejBear[count]
				break
			if RejBear[count] and high[count] > high[_can]
				_reshbear := count
				break
	_reshbear



// ***************************************************************************************************************************************************************
// IB Liquidity take
// ***************************************************************************************************************************************************************

// @function Returns whether current candle is is a BullRej which has taken IB liquidiy in the last _lookback candles
// @param int _can is rejection candle to be ckecked (0 = current candle, 1 = previous candle)
// @param int _lookback is the number of candles you want to look back to find IB where liquidity has been taken
// @returns integer value representing the IB that was found and it's liquidity taken. 0 = not found
export bullIBLQtake(int _can, int _lookback) =>
	_res = 0
	if RejBull[_can]
		minL = IB[_can + 1] ? close[_can + 1] : low[_can + 1]
		for c = _can + 1 to _can + _lookback + 1
			if IB[c] and low[_can] < low[c] and close[_can] > low[c] and minL > low[c]
				_res := c
				break
			minL := low[c] < minL ? low[c] : minL
	_res


// @function Returns whether current candle is is a BearRej which has taken IB liquidiy in the last _lookback candles
// @param int _can is rejection candle to be ckecked (0 = current candle, 1 = previous candle)
// @param int _lookback is the number of candles you want to look back to find IB where liquidity has been taken
// @returns integer value representing the IB that was found and it's liquidity taken. 0 = not found
export bearIBLQtake(int _can, int _lookback) =>
	_res = 0
	if RejBear[_can]
		maxH = IB[_can + 1] ? close[_can + 1] : high[_can + 1]
		for c = _can + 1 to _can + _lookback + 1
			if IB[c] and high[_can] > high[c] and close[_can] < high[c] and maxH < high[c]
				_res := c
				break
			maxH := high[c] > maxH ? high[c] : maxH
	_res




