//@version=5
library("PRINT_TYPE")

//@type Inputs objects
//@field inbalance_percent percentage coefficient to determine the Imbalance of price levels
//@field stacked_input minimum number of consecutive Imbalance levels required to draw extended lines 
//@field procent_volume_area definition size Value area
//@fieldshow_volume_profile bool input for show volume profile 
//@field new_imbalance_cond bool input for setup alert on new imbalance buy and sell
//@field new_imbalance_line_cond bool input for setup alert on new imbalance line buy and sell
//@field stop_past_imbalance_line_cond bool input for setup alert on stop past imbalance line buy and sell
export type Inputs
    int inbalance_percent
    int stacked_input
    bool show_summary_footprint
    int procent_volume_area

    bool new_imbalance_cond
    bool new_imbalance_line_cond
    bool stop_past_imbalance_line_cond
//@type Constants all Constants objects
//@field imbalance_high_char char for printing buy imbalance
//@field imbalance_low_char char for printing sell imbalance
//@field color_title_sell color for footprint sell  
//@field color_title_buy color for footprint buy  
//@field color_line_sell color for sell line
//@field color_line_buy color for buy line
//@field color_title_none color None 
export type Constants
    string imbalance_high_char
    string imbalance_low_char
    color color_title_sell
    color color_title_buy

    color color_line_sell
    color color_line_buy

    color color_title_none
//@type Calculation_data data for calculating
//@field detail_open array open from calculation timeframe
//@field detail_high array high from calculation timeframe
//@field detail_low array low from calculation timeframe
//@field detail_close array close from calculation timeframe
//@field detail_vol array volume from calculation timeframe
//@field previos_detail_close array close[1] from calculation timeframe
//@field isBuyVolume attribute previosly bar buy or sell
export type Calculation_data
    float [] detail_open
    float [] detail_high
    float [] detail_low
    float [] detail_close
    float [] detail_vol
    float [] previos_detail_close
    bool isBuyVolume
//@type Footprint_row objects one footprint row
//@field price row price 
//@field buy_vol buy volume
//@field sell_vol sell volume
//@field imbalance_buy attribute buy inbalance
//@field imbalance_sell attribute sell imbalance
//@field buy_vol_box for ptinting buy volume
//@field sell_vol_box for printing sell volume
//@field buy_vp_box for ptinting volume profile buy 
//@field sell_vp_box for ptinting volume profile sell 
//@field row_line for ptinting row price
//@field empty = true attribute row with zero volume buy and zero volume sell
export type Footprint_row
    float price
    float buy_vol = 0.
    float sell_vol = 0.
    bool imbalance_buy = false
    bool imbalance_sell = false
    box buy_vol_box
    box sell_vol_box
    //vp
    box buy_vp_box
    box sell_vp_box

    label row_line

    bool empty = true

//@type Imbalance_line_var_object var objects printing and calculation imbalance line
//@field cum_buy_line line array for saving all history buy imbalance line 
//@field cum_sell_line line array for saving all history sell imbalance line 
export type Imbalance_line_var_object
    line [] cum_buy_line
    line [] cum_sell_line
//@type Imbalance_line objects printing and calculation imbalance line
//@field buy_price_line float array for saving buy imbalance price level
//@field sell_price_line float array for saving sell imbalance price level
//@field var_imba_line var objects this type
export type Imbalance_line
    float [] buy_price_line
    float [] sell_price_line

    Imbalance_line_var_object var_imba_line
//@type Footprint_bar all objects one bar with footprint
//@field foot_rows objects one row footprint
//@field imba_line objects imbalance line
//@field info objects info - table,label and their variable
//@field row_size size rows
//@field total_vol total volume one footprint bar
//@field foot_buy_vol buy volume one footprint bar
//@field foot_sell_vol sell volume one footprint bar
//@field foot_max_price_vol map with one value - price row with max volume buy + sell
//@field calc_data objects with detail data from calculation resolution
export type Footprint_bar
    Footprint_row [] foot_rows
    Imbalance_line imba_line
    float row_size
    float total_vol = 0.
    float foot_buy_vol = 0.
    float foot_sell_vol = 0.
    map <float,float> foot_max_price_vol
    Calculation_data calc_data

//@type Support_objects support object for footprint calculation
//@field consts all consts objects
//@field inp all input objects
//@field bar_index_show_condition calculation bool value for show all objects footprint
//@field row_line_color calculation value - color for row price
export type Support_objects
    Constants consts
    Inputs inp
    bool bar_index_show_condition
    color row_line_color
    string dop_info = ""
    bool show_table_cond = barstate.islast
