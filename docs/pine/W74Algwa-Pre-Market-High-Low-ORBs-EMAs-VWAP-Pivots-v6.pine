//@version=6
indicator("Pre-Market High/Low + ORBs + EMAs + VWAP + Pivots [v6]", overlay=true)

// =============================================================================
// Sessions
// =============================================================================
preMarketSession = not na(time(timeframe.period, "0400-0930", "America/New_York"))
firstORBSession  = not na(time(timeframe.period, "0930-0945", "America/New_York"))
secondORBSession = not na(time(timeframe.period, "1430-1440", "America/New_York"))

// Pre-market variables
var float pmHigh = na
var float pmLow = na

// First ORB variables (9:30-9:45 AM)
var float orb1High = na
var float orb1Low = na

// Second ORB variables (2:30-2:40 PM)
var float orb2High = na
var float orb2Low = na

// ORB sizes
var float orb1Size = na
var float orb2Size = na

// Track ORB completion
var bool orb1Built = false
var bool orb2Built = false

// ORB 100% projection targets
var float orbTargetUp100 = na
var float orbTargetDown100 = na

// Reset all intraday levels on each new exchange day.
newDay = ta.change(time("1D")) != 0
if newDay
    pmHigh := na
    pmLow := na
    orb1High := na
    orb1Low := na
    orb2High := na
    orb2Low := na
    orb1Size := na
    orb2Size := na
    orb1Built := false
    orb2Built := false
    orbTargetUp100 := na
    orbTargetDown100 := na

// Calculate pre-market high and low.
if preMarketSession
    if na(pmHigh) or na(pmLow)
        pmHigh := high
        pmLow := low
    else
        pmHigh := math.max(pmHigh, high)
        pmLow := math.min(pmLow, low)

// Calculate first ORB (9:30-9:45 AM).
if firstORBSession
    if na(orb1High) or na(orb1Low)
        orb1High := high
        orb1Low := low
    else
        orb1High := math.max(orb1High, high)
        orb1Low := math.min(orb1Low, low)

// Mark ORB1 as built when its session ends.
if firstORBSession[1] and not firstORBSession and not na(orb1High) and not na(orb1Low)
    orb1Size := orb1High - orb1Low
    orb1Built := true

// Calculate second ORB (2:30-2:40 PM).
if secondORBSession
    if na(orb2High) or na(orb2Low)
        orb2High := high
        orb2Low := low
    else
        orb2High := math.max(orb2High, high)
        orb2Low := math.min(orb2Low, low)

// Mark ORB2 as built when its session ends.
if secondORBSession[1] and not secondORBSession and not na(orb2High) and not na(orb2Low)
    orb2Size := orb2High - orb2Low
    orb2Built := true

// Set targets after the first ORB completes.
if orb1Built and not na(orb1Size)
    orbTargetUp100 := orb1High + orb1Size
    orbTargetDown100 := orb1Low - orb1Size

// Replace the targets after the second ORB completes.
if orb2Built and not na(orb2Size)
    orbTargetUp100 := orb2High + orb2Size
    orbTargetDown100 := orb2Low - orb2Size

// =============================================================================
// EMAs and VWAP
// =============================================================================
ema9 = ta.ema(close, 9)
ema21 = ta.ema(close, 21)
ema50 = ta.ema(close, 50)
ema100 = ta.ema(close, 100)
ema200 = ta.ema(close, 200)
vwapValue = ta.vwap(close)

// Pre-market levels
plot(pmHigh, "PM High", color=color.green, linewidth=2)
plot(pmLow, "PM Low", color=color.red, linewidth=2)

// First ORB levels and fill
orb1HighPlot = plot(orb1High, "ORB1 High (9:30-9:45)", color=color.purple, linewidth=2)
orb1LowPlot = plot(orb1Low, "ORB1 Low (9:30-9:45)", color=color.purple, linewidth=2)
fill(orb1HighPlot, orb1LowPlot, color=color.new(color.purple, 85), title="ORB1 Fill")

// Second ORB levels and fill
orb2HighPlot = plot(orb2High, "ORB2 High (2:30-2:40)", color=color.purple, linewidth=2)
orb2LowPlot = plot(orb2Low, "ORB2 Low (2:30-2:40)", color=color.purple, linewidth=2)
fill(orb2HighPlot, orb2LowPlot, color=color.new(color.purple, 85), title="ORB2 Fill")

// Moving averages and VWAP
plot(ema9, "EMA 9", color=color.rgb(135, 206, 250), linewidth=1)
plot(ema21, "EMA 21", color=color.orange, linewidth=1)
plot(ema50, "EMA 50", color=color.green, linewidth=1)
plot(ema100, "EMA 100", color=color.gray, linewidth=1)
plot(ema200, "EMA 200", color=color.black, linewidth=2)
plot(vwapValue, "VWAP", color=color.blue, linewidth=2)

// ORB 100% projection lines
plot(orbTargetUp100, "ORB 100% Target Up", color=color.green, linewidth=2, style=plot.style_linebr)
plot(orbTargetDown100, "ORB 100% Target Down", color=color.red, linewidth=2, style=plot.style_linebr)

// =============================================================================
// Confirmed pivot highs and lows
// =============================================================================
pivotGroup = "Pivot Points"
pivotPeriod = input.int(2, "Pivot Period", minval=1, maxval=50, group=pivotGroup)
showPivotHighs = input.bool(true, "Show Pivot Highs", group=pivotGroup)
showPivotLows = input.bool(true, "Show Pivot Lows", group=pivotGroup)

// Each pivot is confirmed after `pivotPeriod` bars close to its right. The marker
// is then placed back on the candle where the swing actually occurred.
pivotHigh = ta.pivothigh(high, pivotPeriod, pivotPeriod)
pivotLow = ta.pivotlow(low, pivotPeriod, pivotPeriod)

plotshape(showPivotHighs and not na(pivotHigh), title="Pivot High", text="H", style=shape.labeldown, color=color.new(color.white, 100), textcolor=color.red, location=location.abovebar, offset=-pivotPeriod, size=size.tiny)
plotshape(showPivotLows and not na(pivotLow), title="Pivot Low", text="L", style=shape.labelup, color=color.new(color.white, 100), textcolor=color.lime, location=location.belowbar, offset=-pivotPeriod, size=size.tiny)
