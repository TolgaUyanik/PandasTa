//@version=5
// --- ESTRATEGIA DUAL: LONG & SHORT ---
indicator("RSI+BOLLINGER (LONG & SHORT)", "RSI+BB LS", overlay=true, linktoseries=true, max_labels_count=500)

// =======================
// Inputs
// =======================
// --- General ---
src         = input.source(close, "Fuente de precio")
bbLen       = input.int(20, "Bollinger - Período", minval=1, group="Parámetros Generales")
bbMult      = input.float(2.0, "Bollinger - Desviación", step=0.1, group="Parámetros Generales")
rsiLen      = input.int(14, "RSI - Longitud", minval=1, group="Parámetros Generales")

// --- Long Strategy ---
rsiBuyLevel = input.float(29.0, "RSI - Nivel de Compra", step=0.1, group="Estrategia LONG")
dropPct     = input.float(5.0, "Filtro Re-Compra: Caída Mínima (%)", minval=0.0, step=0.1, group="Estrategia LONG")

// --- Short Strategy ---
rsiSellLevel = input.float(71.0, "RSI - Nivel de Venta", step=0.1, group="Estrategia SHORT")
risePct      = input.float(5.0, "Filtro Re-Venta: Subida Mínima (%)", minval=0.0, step=0.1, group="Estrategia SHORT")

// --- Visuals ---
showMid     = input.bool(true, "Mostrar Señales MID (Cruce de Base)", group="Visualización")
debugMode   = input.bool(false, "DEBUG: Plotear Close del Símbolo", group="Visualización")

// =======================
// Cálculos Base
// =======================
rsiValue = ta.rsi(src, rsiLen)
basis = ta.sma(src, bbLen)
dev   = bbMult * ta.stdev(src, bbLen)
upper = basis + dev
lower = basis - dev

// =======================
// Señales Crudas (Raw Signals) al Cierre de Vela
// =======================
isClose    = barstate.isconfirmed
// --- Long ---
buyRaw     = ta.crossover(rsiValue, rsiBuyLevel)      // BUY: RSI cruza hacia arriba nivel de sobreventa
coverLongRaw = ta.crossunder(src, upper)              // COVER LONG: Precio cruza hacia abajo BB Superior
// --- Short ---
sellShortRaw = ta.crossunder(rsiValue, rsiSellLevel)  // SELL SHORT: RSI cruza hacia abajo nivel de sobrecompra
coverShortRaw= ta.crossover(src, lower)               // COVER SHORT: Precio cruza hacia arriba BB Inferior
// --- Mid ---
midUpRaw   = ta.crossover(src, basis)
midDownRaw = ta.crossunder(src, basis)

// =======================
// Filtros de Cascada y Lógica de Estado
// =======================
// --- Long Filter ---
var float lastBuyPrice = na
buyAllowed = na(lastBuyPrice) or (close <= lastBuyPrice * (1.0 - dropPct/100.0))
buyCond     = isClose and buyRaw and buyAllowed
coverLongCond = isClose and coverLongRaw

if coverLongCond
    lastBuyPrice := na
else if buyCond
    lastBuyPrice := close

// --- Short Filter ---
var float lastShortPrice = na
// CORRECCIÓN: Se cambió 1.O por 1.0
sellShortAllowed = na(lastShortPrice) or (close >= lastShortPrice * (1.0 + risePct/100.0))
sellShortCond = isClose and sellShortRaw and sellShortAllowed
coverShortCond = isClose and coverShortRaw

if coverShortCond
    lastShortPrice := na
else if sellShortCond
    lastShortPrice := close
    
// --- Mid Conditions ---
midUpCond   = isClose and midUpRaw
midDownCond = isClose and midDownRaw

// =======================
// Plots en Gráfico
// =======================
// --- Bandas de Bollinger ---
pBasis = plot(basis, "BB Base (SMA)", color=color.new(color.orange, 0), linewidth=2, format=format.price)
pUpper = plot(upper, "BB Superior",  color=color.new(color.gray, 0), format=format.price)
pLower = plot(lower, "BB Inferior",  color=color.new(color.gray, 0), format=format.price)
fill(pUpper, pLower, color=color.new(color.gray, 90))

// --- Debug ---
plot(debugMode ? close : na, "DEBUG_CLOSE", color=color.new(color.fuchsia, 0), linewidth=1, style=plot.style_linebr, format=format.price)

// --- Plots Ocultos para Tokens de Alertas ---
plot(rsiValue, "RSI", display=display.none)
plot(dropPct,  "DROP_PCT", display=display.none)
plot(risePct,  "RISE_PCT", display=display.none)

// =======================
// Señales Visuales (Shapes)
// =======================
// --- Long ---
plotshape(buyCond,       title="BUY",          style=shape.triangleup,   location=location.belowbar, color=color.new(color.lime, 0),   size=size.small, text="BUY")
plotshape(coverLongCond, title="COVER LONG",   style=shape.triangledown, location=location.abovebar, color=color.new(color.maroon, 0), size=size.tiny,  text="C.L")
// --- Short ---
plotshape(sellShortCond,  title="SELL SHORT",   style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0),    size=size.small, text="SHORT")
plotshape(coverShortCond, title="COVER SHORT",  style=shape.triangleup,   location=location.belowbar, color=color.new(color.navy, 0),   size=size.tiny,  text="C.S")
// --- Mid ---
plotshape(showMid and midUpCond,   title="MID UP", style=shape.circle, location=location.belowbar, color=color.new(color.blue, 0), size=size.tiny)
plotshape(showMid and midDownCond, title="MID DN", style=shape.circle, location=location.abovebar, color=color.new(color.teal, 0), size=size.tiny)

// =======================
// Alertas (JSON)
// =======================
// Los mensajes para alertcondition DEBEN ser 'const string' literales.
const string MSG_BUY         = "{\"version\":\"2.0.0\",\"indicator\":\"RSI+BOLLINGER (L/S)\",\"event\":\"BUY\",\"symbol\":\"{{ticker}}\",\"exchange\":\"{{exchange}}\",\"interval\":\"{{interval}}\",\"time\":\"{{time}}\",\"open\":{{open}},\"high\":{{high}},\"low\":{{low}},\"close\":{{close}},\"rsi\":{{plot(\"RSI\")}},\"bb_upper\":{{plot(\"BB Superior\")}},\"bb_lower\":{{plot(\"BB Inferior\")}},\"bb_basis\":{{plot(\"BB Base (SMA)\")}},\"drop_filter_pct\":{{plot(\"DROP_PCT\")}}}"
const string MSG_COVER_LONG  = "{\"version\":\"2.0.0\",\"indicator\":\"RSI+BOLLINGER (L/S)\",\"event\":\"COVER_LONG\",\"symbol\":\"{{ticker}}\",\"exchange\":\"{{exchange}}\",\"interval\":\"{{interval}}\",\"time\":\"{{time}}\",\"open\":{{open}},\"high\":{{high}},\"low\":{{low}},\"close\":{{close}},\"rsi\":{{plot(\"RSI\")}},\"bb_upper\":{{plot(\"BB Superior\")}},\"bb_lower\":{{plot(\"BB Inferior\")}},\"bb_basis\":{{plot(\"BB Base (SMA)\")}}}"
const string MSG_SELL_SHORT  = "{\"version\":\"2.0.0\",\"indicator\":\"RSI+BOLLINGER (L/S)\",\"event\":\"SELL_SHORT\",\"symbol\":\"{{ticker}}\",\"exchange\":\"{{exchange}}\",\"interval\":\"{{interval}}\",\"time\":\"{{time}}\",\"open\":{{open}},\"high\":{{high}},\"low\":{{low}},\"close\":{{close}},\"rsi\":{{plot(\"RSI\")}},\"bb_upper\":{{plot(\"BB Superior\")}},\"bb_lower\":{{plot(\"BB Inferior\")}},\"bb_basis\":{{plot(\"BB Base (SMA)\")}},\"rise_filter_pct\":{{plot(\"RISE_PCT\")}}}"
const string MSG_COVER_SHORT = "{\"version\":\"2.0.0\",\"indicator\":\"RSI+BOLLINGER (L/S)\",\"event\":\"COVER_SHORT\",\"symbol\":\"{{ticker}}\",\"exchange\":\"{{exchange}}\",\"interval\":\"{{interval}}\",\"time\":\"{{time}}\",\"open\":{{open}},\"high\":{{high}},\"low\":{{low}},\"close\":{{close}},\"rsi\":{{plot(\"RSI\")}},\"bb_upper\":{{plot(\"BB Superior\")}},\"bb_lower\":{{plot(\"BB Inferior\")}},\"bb_basis\":{{plot(\"BB Base (SMA)\")}}}"
const string MSG_UP          = "{\"version\":\"2.0.0\",\"indicator\":\"RSI+BOLLINGER (L/S)\",\"event\":\"CROSS_BASE_UP\",\"symbol\":\"{{ticker}}\",\"exchange\":\"{{exchange}}\",\"interval\":\"{{interval}}\",\"time\":\"{{time}}\",\"open\":{{open}},\"high\":{{high}},\"low\":{{low}},\"close\":{{close}},\"rsi\":{{plot(\"RSI\")}},\"bb_basis\":{{plot(\"BB Base (SMA)\")}}}"
const string MSG_DN          = "{\"version\":\"2.0.0\",\"indicator\":\"RSI+BOLLINGER (L/S)\",\"event\":\"CROSS_BASE_DOWN\",\"symbol\":\"{{ticker}}\",\"exchange\":\"{{exchange}}\",\"interval\":\"{{interval}}\",\"time\":\"{{time}}\",\"open\":{{open}},\"high\":{{high}},\"low\":{{low}},\"close\":{{close}},\"rsi\":{{plot(\"RSI\")}},\"bb_basis\":{{plot(\"BB Base (SMA)\")}}}"

// --- Condiciones de Alerta ---
alertcondition(buyCond,        "BUY - RSI cruza Nivel Compra (Filtro Cascada)", MSG_BUY)
alertcondition(coverLongCond,  "COVER LONG - Precio cruza abajo BB Superior",   MSG_COVER_LONG)
alertcondition(sellShortCond,  "SELL SHORT - RSI cruza Nivel Venta (Filtro Cascada)", MSG_SELL_SHORT)
alertcondition(coverShortCond, "COVER SHORT - Precio cruza arriba BB Inferior", MSG_COVER_SHORT)
alertcondition(midUpCond,      "CROSS UP - Precio cruza BASE",                  MSG_UP)
alertcondition(midDownCond,    "CROSS DOWN - Precio cruza BASE",                MSG_DN)
