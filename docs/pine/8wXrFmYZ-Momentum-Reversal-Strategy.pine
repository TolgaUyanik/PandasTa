//@version=6
indicator("long short automated trade AKC", overlay=true, max_lines_count=500, max_labels_count=500)

// === INPUTS ===
emaFastLen = input.int(20, "EMA Fast Length")
emaSlowLen = input.int(50, "EMA Slow Length")
atrLen = input.int(14, "ATR Length")
rr = input.float(2.0, "Risk:Reward Ratio", step=0.1)
volumeMultiplier = input.float(1.5, "Volume Spike Multiplier", step=0.1)
swingLookback = input.int(50, "Swing Lookback (15min approx)")

// === CALCULATIONS ===
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
atr = ta.atr(atrLen)
volMA = ta.sma(volume, 20)
volSpike = volume > volMA * volumeMultiplier

// === PREVIOUS DAY HIGH/LOW ===
pdHigh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
pdLow = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_on)

// === RECENT SWING HIGH/LOW FROM 15min CHART ===
high15 = request.security(syminfo.tickerid, "15", high, lookahead=barmerge.lookahead_on)
low15 = request.security(syminfo.tickerid, "15", low, lookahead=barmerge.lookahead_on)
swingHigh = ta.highest(high15[1], swingLookback)
swingLow = ta.lowest(low15[1], swingLookback)

// === BREAKOUT CONDITIONS (REQUIRES CURRENT BAR TO CLOSE ABOVE/BELOW PD HIGH/LOW) ===
closedAbovePDHigh = close > pdHigh and close[1] <= pdHigh
closedBelowPDLow = close < pdLow and close[1] >= pdLow

// === TRADE CONDITIONS ===
rawLong = closedAbovePDHigh and close > swingHigh and close > emaFast and close > emaSlow and volSpike
rawShort = closedBelowPDLow and close < swingLow and close < emaFast and close < emaSlow and volSpike

// === TRADE LIMITATION: MAX 2 PER DAY ===
currentDay = dayofmonth + month * 100 + year * 10000
var int tradesToday = 0
var int lastDay = na

if (na(lastDay) or currentDay != lastDay)
    tradesToday := 0
    lastDay := currentDay

// Allow only the first 2 strongest trades based on volume spike
volRank = ta.highest(volume, 20)
isStrongVolume = volume >= volRank
longCond = rawLong and tradesToday < 2 and isStrongVolume
shortCond = rawShort and tradesToday < 2 and isStrongVolume

if longCond or shortCond
    tradesToday += 1

// === ENTRY SIGNALS ===
plotshape(longCond, title="Buy Signal", location=location.belowbar, color=color.green, style=shape.labelup, text="Buy")
plotshape(shortCond, title="Sell Signal", location=location.abovebar, color=color.red, style=shape.labeldown, text="Sell")

// === TARGET & STOP ===
longSL = low - atr * 1.0
shortSL = high + atr * 1.0
longTP = close + rr * (close - longSL)
shortTP = close - rr * (shortSL - close)

plot(longCond ? longSL : na, title="Long SL", color=color.red, style=plot.style_linebr)
plot(shortCond ? shortSL : na, title="Short SL", color=color.red, style=plot.style_linebr)
plot(longCond ? longTP : na, title="Long TP", color=color.green, style=plot.style_linebr)
plot(shortCond ? shortTP : na, title="Short TP", color=color.green, style=plot.style_linebr)

// === EXIT LABELS ===
if longCond
    label.new(bar_index, longTP, text="Target", style=label.style_label_up, color=color.green, textcolor=color.white)
    label.new(bar_index, longSL, text="SL", style=label.style_label_down, color=color.red, textcolor=color.white)
if shortCond
    label.new(bar_index, shortTP, text="Target", style=label.style_label_down, color=color.green, textcolor=color.white)
    label.new(bar_index, shortSL, text="SL", style=label.style_label_up, color=color.red, textcolor=color.white)

// === ENTRY PRICE LINE ===
plot(longCond ? close : na, title="Long Entry Line", color=color.lime, style=plot.style_linebr, linewidth=2)
plot(shortCond ? close : na, title="Short Entry Line", color=color.maroon, style=plot.style_linebr, linewidth=2)

// === PREVIOUS DAY HIGH/LOW ===
plot(pdHigh, title="Prev Day High", color=color.blue, style=plot.style_line, linewidth=1)
plot(pdLow, title="Prev Day Low", color=color.orange, style=plot.style_line, linewidth=1)
