//@version=6

// @description Pine3D - 3D rendering engine for TradingView Pine Script.
//              Layer 1 exposes the raw mesh / camera / light API.
//              Layer 2 wraps it with data-vis primitives (surface, bars3D, trail3D).
library("Pine3D", overlay = false)

// v 1.3: UDT Sorting

// ============================================================================
// CONSTANTS
// ============================================================================

float NEAR_PLANE_EPSILON     = 0.001
float UP_VECTOR_DEGENERACY   = 0.999
float BEHIND_CAMERA_FACTOR   = 0.9
int   COLOR_CHANNEL_MAX      = 255
float NORMALIZE_EPSILON      = 1e-10
float CONTOUR_SCREEN_EPSILON = 1e-8
float CONTOUR_SAMPLE_EPSILON = 1e-4
float CONTOUR_SNAP_EPSILON   = 1e-3
float CONTOUR_SNAP_SCALE     = 1e3
int   CONTOUR_SNAP_OFFSET    = 20000001
// Pre-computed squares for snap distance comparisons (avoids per-call multiplies)
float CONTOUR_SNAP_EPSILON_SQ      = 1e-6   // CONTOUR_SNAP_EPSILON^2
float CONTOUR_SNAP_EPSILON_SQ_HALF = 2.5e-7 // (CONTOUR_SNAP_EPSILON/2)^2
float CONTOUR_SCREEN_EPSILON_SQ    = 1e-16  // CONTOUR_SCREEN_EPSILON^2
float DEPTH_TIE_EPSILON         = 1e-3


// ============================================================================
// SECTION 1: TYPE DEFINITIONS
// ============================================================================

//@type A 3D vector used for positions, directions, normals, and scales.
//@field x (float) X component
//@field y (float) Y component
//@field z (float) Z component
export type Vec3
    float x = 0.0
    float y = 0.0
    float z = 0.0

//@type A polygon face defined by vertex indices into a Mesh's vertex array.
//@field vi (array<int>) Indices into the parent mesh's vertices array
//@field col (color) The color of this face
export type Face
    array<int> vi
    color col = #808080

// Internal cache structure for face preprocessing results (SOA layout).
// Stores only faces that survived culling and behind-camera tests.
export type _FaceCacheData
    array<int> origIdx          // index into mesh.faces for each cached face
    array<float> depths         // avgDepth per face
    array<float> cx             // world centroid X
    array<float> cy             // world centroid Y
    array<float> cz             // world centroid Z
    array<float> nx             // world normal X
    array<float> ny             // world normal Y
    array<float> nz             // world normal Z
    array<float> cpNx           // camera-space plane normal X
    array<float> cpNy           // camera-space plane normal Y
    array<float> cpNz           // camera-space plane normal Z
    array<float> cpNum          // plane numerator for sample-depth queries
    array<float> sxMin          // projected face min X
    array<float> sxMax          // projected face max X
    array<float> syMin          // projected face min Y
    array<float> syMax          // projected face max Y

//@type A 3D label positioned in world space. Projected automatically by render().
//@field position (Vec3) World-space position
//@field txt (string) Label text
//@field textColor (color) Text color
//@field bgColor (color) Background color (use color(na) for transparent)
//@field labelStyle (string) Label style: uses label.style_* constants. Default label.style_text_outline.
//@field labelSize (string) Text size: uses size.* constants. Default size.normal.
//@field fontFamily (string) Font family: font.family_default or font.family_monospace. Default font.family_default.
//@field tooltip (string) Hover tooltip text
//@field visible (bool) Whether to render this label
//@field tag (string) Optional identifier for scene lookups
export type Label3D
    Vec3 position
    string txt = ""
    color textColor = color.white
    color bgColor = #00000000
    string labelStyle = label.style_text_outline
    string labelSize = size.normal
    string fontFamily = font.family_default
    string tooltip = ""
    bool visible = true
    string tag = ""

//@type A 3D line connecting two points in world space. Projected automatically by render().
//@field start (Vec3) Start point in world space
//@field end (Vec3) End point in world space
//@field col (color) Line color
//@field width (int) Line width in pixels
//@field lineStyle (string) Line style: line.style_solid (default), line.style_dashed, line.style_dotted, line.style_arrow_left, line.style_arrow_right, or line.style_arrow_both. Mutate via direct field assignment.
//@field visible (bool) Whether to render this line
//@field tag (string) Optional identifier for scene lookups
export type Line3D
    Vec3 start
    Vec3 end
    color col = color.white
    int width = 1
    bool visible = true
    string tag = ""
    string lineStyle = line.style_solid

//@type A 3D polyline connecting multiple points in world space. Projected automatically by render().
//@field points (array<Vec3>) Ordered vertices in world space
//@field col (color) Line color
//@field fillColor (color) Fill color (use color(na) for no fill)
//@field width (int) Line width in pixels
//@field lineStyle (string) Line style: line.style_solid (default), line.style_dashed, or line.style_dotted. TradingView's polyline primitive does not support arrow styles. Mutate via direct field assignment.
//@field closed (bool) Whether to close the shape (connect last point to first)
//@field visible (bool) Whether to render this polyline
//@field tag (string) Optional identifier for scene lookups
export type Polyline3D
    array<Vec3> points
    color col = color.white
    color fillColor = #00000000
    int width = 1
    bool closed = false
    bool visible = true
    string tag = ""
    string lineStyle = line.style_solid

// Internal metadata for contour-style terrain meshes.
// Stores grid dimensions and color gradient for banded contour rendering.
export type _ContourMeta
    int   cols              // grid column count (rows = vertices.size() / cols)
    int   rows              // grid row count
    float size              // world-space bounding cube edge length
    int   levels            // quantization band count
    color lowCol            // color for lowest elevation
    color highCol           // color for highest elevation
    // --- Original data ranges (for inverse-normalization) ---
    float _dataXMin = na
    float _dataXMax = na
    float _dataYMin = na
    float _dataYMax = na
    float _dataZMin = na
    float _dataZMax = na
    // --- Geometry cache (local-space clipped fragments) ---
    float _geomFirstY      = na // first vertex Y when cache was built
    float _geomLastY       = na // last vertex Y when cache was built
    int   _geomVertCount   = na // vertex count when cache was built
    array<int>   _cachePtSrcA          = na // source vertex A index per unique point
    array<int>   _cachePtSrcB          = na // source vertex B index (-1 = mesh vertex)
    array<float> _cachePtMix           = na // interpolation factor (0.0 for mesh verts)
    array<int>   _cacheFragPointRef    = na // fragment point -> unique contour point index
    array<int>   _cacheFragStarts      = na // start offset per fragment
    array<int>   _cacheFragLens        = na // point count per fragment
    array<int>   _cacheBandFragStarts  = na // start fragment index per band
    array<int>   _cacheBandFragLens    = na // fragment count per band
    array<color> _cacheBandColors      = na // color per band
    array<float> _cacheBandDepthOffsets = na // depth offset per band
    // --- Projection cache (screen-space coordinates) ---
    array<float> _cacheProjSx  = na // perspective X per point
    array<float> _cacheProjSy  = na // perspective Y per point
    array<float> _cacheScreenPathX = na // final screen-path X per band point
    array<float> _cacheScreenPathY = na // final screen-path Y per band point
    // --- Grid-label refs (kept so updateSurface can refresh tick-value text) ---
    array<Label3D> _tickLabelsX = na // X-axis tick labels (refs into scene.labels)
    array<Label3D> _tickLabelsY = na // Y-axis tick labels
    array<Label3D> _tickLabelsZ = na // Z-axis tick labels
    string _tickFmt = na             // str.tostring format used at gridLabels() time
    array<int>   _cacheScreenStarts = na // start offset per rendered band path
    array<int>   _cacheScreenLens   = na // point count per rendered band path
    float _projCamPosX         = na // camera position X key
    float _projCamPosY         = na // camera position Y key
    float _projCamPosZ         = na // camera position Z key
    float _projFwdX            = na // camera forward X key
    float _projFwdY            = na // camera forward Y key
    float _projFwdZ            = na // camera forward Z key
    float _projFov             = na // FOV key

// Internal context bundling shared contour processing arrays to reduce call-site param count.
type _ContourCtx
    int numVerts
    int meshEdgeCount
    array<Vec3> localVerts
    int rows
    int cols
    array<float> pointX
    array<float> pointY
    array<float> pointZ
    array<int> pointSrcA
    array<int> pointSrcB
    array<float> pointSrcMix
    array<int> pointEpoch
    int bandStamp
    array<int> prevUpperProjId
    array<int> prevUpperProjEpoch
    array<int> lowerProjId
    array<int> lowerProjEpoch
    array<int> upperProjId
    array<int> upperProjEpoch
    array<int> allSrcA
    array<int> allSrcB
    array<float> allSrcMix
    array<int> allFragRefs
    array<int> fragStarts
    array<int> fragLens

//@type A 3D mesh containing geometry and transform state.
//@field vertices (array<Vec3>) Vertex positions in local/object space
//@field faces (array<Face>) Polygon faces referencing vertex indices
//@field position (Vec3) World-space position (translation)
//@field rotation (Vec3) Euler rotation stored in radians (XYZ order)
//@field meshScale (Vec3) Per-axis scale factors
//@field visible (bool) Whether to render this mesh
//@field tag (string) Optional identifier for scene lookups
//@field castShadow (bool) Whether this mesh blocks light for shadow tests. Default true.
//@field drawMode (string) Drawing backend for solid faces: "linefill" (default, 250-face capacity, updatable) or "poly" (legacy polyline, 100-face capacity)
//@field lineWidth (int) Stroke width in pixels for visible mesh edges (wireframe / wireframe_front, and the outline of poly-mode solid faces). Default 1. Mutate via direct field assignment, e.g. `mesh.lineWidth := 3`.
//@field lineStyle (string) Line style for visible mesh edges. Use line.style_solid (default), line.style_dashed, or line.style_dotted. Mutate via direct field assignment.
export type Mesh
    array<Vec3> vertices
    array<Face> faces
    Vec3 position
    Vec3 rotation
    Vec3 meshScale
    bool visible = true
    string tag = ""
    string style = "solid"
    array<int> wirePath = na
    bool castShadow = true
    string drawMode = "linefill"
    int    lineWidth = 1
    string lineStyle = line.style_solid
    // --- World-vert cache (internal) ---
    array<Vec3> _cacheWorldVerts = na
    Vec3 _cachePos = na
    Vec3 _cacheRot = na
    Vec3 _cacheScl = na
    Vec3 _cacheFirstVert = na
    float _cacheBCX = na
    float _cacheBCY = na
    float _cacheBCZ = na
    float _cacheBR  = na
    int   _cacheVertCount = na
    // --- View projection cache (internal) ---
    array<float> _cacheScreenXs = na
    array<float> _cacheScreenYs = na
    array<float> _cacheCamXs = na
    array<float> _cacheCamYs = na
    array<float> _cacheCamZs = na
    float _cacheMeshAvgDepth = na
    float _cacheViewCamPosX = na
    float _cacheViewCamPosY = na
    float _cacheViewCamPosZ = na
    float _cacheViewCamTgtX = na
    float _cacheViewCamTgtY = na
    float _cacheViewCamTgtZ = na
    float _cacheViewFov = na
    // --- Face preprocessing cache (internal) ---
    _FaceCacheData _cacheFaceData = na
    int _cacheFaceCullingStamp = na
    // --- Optional grouped-depth sorting metadata (internal) ---
    // Cumulative face/vert boundaries per sub-mesh group.
    // Group i owns faces [_depthGroupFaceEnds[i-1] .. _depthGroupFaceEnds[i]-1]
    // and verts [_depthGroupVertEnds[i-1] .. _depthGroupVertEnds[i]-1].
    array<int> _depthGroupFaceEnds = na
    array<int> _depthGroupVertEnds = na
    // --- Contour terrain metadata (internal) ---
    _ContourMeta _contourMeta = na
    // --- Deferred overlays from chainable helpers like gridBox()/gridLabels()/barLabels() ---
    // Drained into the Scene's polylines3D / labels arrays when scene.add(mesh) runs.
    array<Polyline3D> _pendingPolylines = na
    array<Label3D>    _pendingLabels    = na
    // --- Bar-label refresh metadata (internal) ---
    // Refs into scene.labels populated by barLabels(). updateBars() refreshes their
    // positions (and optionally text) in place.
    array<Label3D> _barNameLabels  = na
    array<Label3D> _barValueLabels = na
    float _barLabelGap = na
    // --- bars3D creation params (for updateBars keep-current defaults) ---
    float _barWidth    = na
    float _barDepth    = na
    float _barSpacing  = na
    color _barLowCol   = na
    color _barHighCol  = na
    float _barMaxHeight = na

//@type Camera defining the rendering viewpoint.
//@field position (Vec3) Camera world-space position
//@field target (Vec3) The point the camera looks at
//@field fov (float) Perspective scale factor - higher = less distortion, lower = more dramatic
export type Camera
    Vec3 position
    Vec3 target
    float fov = 800.0

//@type Light source for scene illumination and shadow casting.
//@field mode (string) "directional" or "point"
//@field direction (Vec3) For directional: points TOWARD the light
//@field position (Vec3) For point: world position of the source
//@field ambient (float) Minimum brightness floor (0.0-1.0)
//@field shadowStr (float) Shadow strength (0.0 = no shadow, 1.0 = full)
//@field shadowBias (float) Ray origin offset along normal (anti-acne)
//@field selfShadow (bool) Allow a mesh to shadow its own faces
//@field showSource (bool) Draw a label at point light position
//@field enabled (bool) Master toggle
export type Light
    string  mode       = "directional"
    Vec3    direction  = na
    Vec3    position   = na
    float   ambient    = 0.3
    float   shadowStr  = 0.0
    float   shadowBias = 0.5
    bool    selfShadow = false
    bool    showSource = false
    bool    enabled    = true
    // --- Shadow grid cache (internal) ---
    float _sgCacheLdX = na
    float _sgCacheLdY = na
    float _sgCacheLdZ = na
    float _sgCacheBoundsSum = na
    Vec3 _sgCacheLightRight = na
    Vec3 _sgCacheLightUp = na
    map<int, int> _sgCacheCellStarts = na
    map<int, int> _sgCacheCellCounts = na
    array<int> _sgCacheCellMeshes = na
    float _sgCacheCellSize = na
    float _sgCacheGridRange = na

//@type Top-level scene container holding meshes and camera.
//@field meshes (array<Mesh>) All meshes in the scene
//@field camera (Camera) The active viewpoint
//@field guiShift (int) Horizontal bar-index offset for chart positioning
//@field yOffset (float) Vertical offset in price/scale units
//@field light (Light) Scene light source (na uses render defaults)
//@field labels (array<Label3D>) 3D labels projected during render
//@field lines3D (array<Line3D>) 3D lines projected during render
//@field polylines3D (array<Polyline3D>) 3D polylines projected during render
//@field yScale (float) Vertical projection multiplier. Useful when drawing on large price scales.
export type Scene
    array<Mesh> meshes
    Camera camera
    int guiShift = 0
    float yOffset = 0.0
    Light light = na
    array<Label3D> labels = na
    array<Line3D> lines3D = na
    array<Polyline3D> polylines3D = na
    float yScale = 1.0


// ============================================================================
// SECTION 2: VEC3 METHODS
// ============================================================================

//@function Creates a new Vec3. Shorthand constructor.
//@param x (float) X component
//@param y (float) Y component
//@param z (float) Z component
//@returns (Vec3) A new vector
export vec3(float x, float y, float z) =>
    Vec3.new(x, y, z)

//@function Component-wise addition of two vectors.
//@param other (Vec3) Vector to add
//@returns (Vec3) Result vector
export method add(Vec3 self, Vec3 other) =>
    Vec3.new(self.x + other.x, self.y + other.y, self.z + other.z)

//@function Component-wise subtraction.
//@param other (Vec3) Vector to subtract
//@returns (Vec3) Result vector
export method sub(Vec3 self, Vec3 other) =>
    Vec3.new(self.x - other.x, self.y - other.y, self.z - other.z)

//@function Multiply vector by a scalar.
//@param s (float) Scalar multiplier
//@returns (Vec3) Scaled vector
export method scale(Vec3 self, float s) =>
    Vec3.new(self.x * s, self.y * s, self.z * s)

//@function Negate all components.
//@returns (Vec3) Negated vector
export method negate(Vec3 self) =>
    Vec3.new(-self.x, -self.y, -self.z)

//@function Dot product of two vectors.
//@param other (Vec3) Second vector
//@returns (float) Dot product scalar
export method dot(Vec3 self, Vec3 other) =>
    self.x * other.x + self.y * other.y + self.z * other.z

//@function Cross product of two vectors.
//@param other (Vec3) Second vector
//@returns (Vec3) Cross product vector (perpendicular to both inputs)
export method cross(Vec3 self, Vec3 other) =>
    Vec3.new(
      self.y * other.z - self.z * other.y,
      self.z * other.x - self.x * other.z,
      self.x * other.y - self.y * other.x)

//@function Magnitude (length) of the vector.
//@returns (float) The length
export method length(Vec3 self) =>
    math.sqrt(self.x * self.x + self.y * self.y + self.z * self.z)

//@function Normalize to a unit vector. Returns zero vector if length is 0.
//@returns (Vec3) Unit vector
export method normalize(Vec3 self) =>
    float len = self.length()
    len > NORMALIZE_EPSILON ? Vec3.new(self.x / len, self.y / len, self.z / len) : Vec3.new(0.0, 0.0, 0.0)

//@function Distance between two points.
//@param other (Vec3) The other point
//@returns (float) Euclidean distance
export method distanceTo(Vec3 self, Vec3 other) =>
    float dx = self.x - other.x
    float dy = self.y - other.y
    float dz = self.z - other.z
    math.sqrt(dx * dx + dy * dy + dz * dz)

//@function Linear interpolation between two vectors.
//@param other (Vec3) Target vector
//@param t (float) Interpolation factor (0.0 = self, 1.0 = other)
//@returns (Vec3) Interpolated vector
export method lerp(Vec3 self, Vec3 other, float t) =>
    Vec3.new(
      self.x + (other.x - self.x) * t,
      self.y + (other.y - self.y) * t,
      self.z + (other.z - self.z) * t)

//@function Rotate the vector around the X axis.
//@param angle (float) Rotation angle in radians
//@returns (Vec3) Rotated vector
export method rotateX(Vec3 self, float angle) =>
    float c = math.cos(angle)
    float s = math.sin(angle)
    Vec3.new(self.x, self.y * c - self.z * s, self.y * s + self.z * c)

//@function Rotate the vector around the Y axis.
//@param angle (float) Rotation angle in radians
//@returns (Vec3) Rotated vector
export method rotateY(Vec3 self, float angle) =>
    float c = math.cos(angle)
    float s = math.sin(angle)
    Vec3.new(self.x * c + self.z * s, self.y, -self.x * s + self.z * c)

//@function Rotate the vector around the Z axis.
//@param angle (float) Rotation angle in radians
//@returns (Vec3) Rotated vector
export method rotateZ(Vec3 self, float angle) =>
    float c = math.cos(angle)
    float s = math.sin(angle)
    Vec3.new(self.x * c - self.y * s, self.x * s + self.y * c, self.z)

//@function Create an independent copy of this vector.
//@returns (Vec3) A new vector with the same values
export method copy(Vec3 self) =>
    Vec3.new(self.x, self.y, self.z)

//@function String representation for debugging.
//@returns (string) Formatted string "(x, y, z)"
export method toString(Vec3 self) =>
    "(" + str.tostring(self.x, "#.##") + ", " + str.tostring(self.y, "#.##") + ", " + str.tostring(self.z, "#.##") + ")"


// ============================================================================
// SECTION 3: MESH METHODS (all return Mesh for chaining)
// ============================================================================

//@function Set the mesh's absolute world position.
//@param x (float) X position
//@param y (float) Y position
//@param z (float) Z position
//@returns (Mesh) Self for chaining
export method moveTo(Mesh self, float x, float y, float z) =>
    self.position := Vec3.new(x, y, z)
    self

//@function Translate the mesh by a relative offset.
//@param dx (float) X offset
//@param dy (float) Y offset
//@param dz (float) Z offset
//@returns (Mesh) Self for chaining
export method moveBy(Mesh self, float dx, float dy, float dz) =>
    self.position := Vec3.new(self.position.x + dx, self.position.y + dy, self.position.z + dz)
    self

//@function Set absolute rotation in degrees.
//@param x (float) X rotation in degrees
//@param y (float) Y rotation in degrees
//@param z (float) Z rotation in degrees
//@returns (Mesh) Self for chaining
export method rotateTo(Mesh self, float x, float y, float z) =>
    self.rotation := Vec3.new(math.toradians(x), math.toradians(y), math.toradians(z))
    self

//@function Add incremental rotation in degrees.
//@param dx (float) X rotation to add in degrees
//@param dy (float) Y rotation to add in degrees
//@param dz (float) Z rotation to add in degrees
//@returns (Mesh) Self for chaining
export method rotateBy(Mesh self, float dx, float dy, float dz) =>
    self.rotation := Vec3.new(self.rotation.x + math.toradians(dx), self.rotation.y + math.toradians(dy), self.rotation.z + math.toradians(dz))
    self

//@function Set absolute scale per axis.
//@param x (float) X scale factor
//@param y (float) Y scale factor
//@param z (float) Z scale factor
//@returns (Mesh) Self for chaining
export method scaleTo(Mesh self, float x, float y, float z) =>
    self.meshScale := Vec3.new(x, y, z)
    self

//@function Set uniform scale on all axes.
//@param s (float) Uniform scale factor
//@returns (Mesh) Self for chaining
export method scaleUniform(Mesh self, float s) =>
    self.meshScale := Vec3.new(s, s, s)
    self

//@function Invalidate the world-vert cache. Call after mutating vertex positions
//          directly (e.g. `mesh.vertices.set(i, newVec)`). Transform mutators
//          like moveTo / rotateBy detect their own changes and do not need this.
//@returns (Mesh) Self for chaining
export method invalidateCache(Mesh self) =>
    self._cacheWorldVerts := na
    self._cacheScreenXs := na
    self._cacheScreenYs := na
    self._cacheCamXs := na
    self._cacheCamYs := na
    self._cacheCamZs := na
    self._cacheMeshAvgDepth := na
    self._cacheViewCamPosX := na
    self._cacheFaceData := na
    self._cacheFaceCullingStamp := na
    if not na(self._contourMeta)
        self._contourMeta._geomVertCount := na
        self._contourMeta._cacheProjSx := na
        self._contourMeta._cacheScreenPathX := na
    self
//          Call when light direction or mesh bounds have changed externally.
//@returns (Scene) Self for chaining
export method invalidateLightCache(Scene self) =>
    if not na(self.light)
        self.light._sgCacheLdX := na
        self.light._sgCacheLdY := na
        self.light._sgCacheLdZ := na
        self.light._sgCacheBoundsSum := na
        self.light._sgCacheCellStarts := na
        self.light._sgCacheCellCounts := na
        self.light._sgCacheCellMeshes := na
    self

//@function Invalidate all caches - light cache + every mesh's world-vert cache.
//@returns (Scene) Self for chaining
export method invalidateAllCaches(Scene self) =>
    self.invalidateLightCache()
    for mesh in self.meshes
        mesh.invalidateCache()
    self

//@function Set a single color on all faces.
//@param c (color) The color to apply
//@returns (Mesh) Self for chaining
export method setColor(Mesh self, color c) =>
    for f in self.faces
        f.col := c
    self

//@function Set color on a specific face by index.
//@param faceIndex (int) Index of the face to color
//@param c (color) The color to apply
//@returns (Mesh) Self for chaining
export method setFaceColor(Mesh self, int faceIndex, color c) =>
    if faceIndex >= 0 and faceIndex < self.faces.size()
        Face f = self.faces.get(faceIndex)
        f.col := c
    self

//@function Make the mesh visible.
//@returns (Mesh) Self for chaining
export method show(Mesh self) =>
    self.visible := true
    self

//@function Hide the mesh from rendering.
//@returns (Mesh) Self for chaining
export method hide(Mesh self) =>
    self.visible := false
    self

//@function Assign an identifier tag for scene lookups.
//@param t (string) The tag string
//@returns (Mesh) Self for chaining
export method setTag(Mesh self, string t) =>
    self.tag := t
    self

//@function Change the rendering style of the mesh ("solid", "wireframe", or "wireframe_front").
//          "wireframe" draws all edges (full geometry). "wireframe_front" draws only front-facing edges (culled).
//@param newStyle (string) The new rendering style
//@returns (Mesh) The updated mesh for method chaining
export method setStyle(Mesh self, string newStyle) =>
    self.style := newStyle
    self

//@function Returns the number of faces (polyline budget cost).
//@returns (int) Face count
export method faceCount(Mesh self) =>
    self.faces.size()

//@function Create a deep copy of this mesh.
//@returns (Mesh) An independent clone
export method clone(Mesh self) =>
    array<Vec3> nv = array.new<Vec3>()
    for v in self.vertices
        nv.push(Vec3.new(v.x, v.y, v.z))
    array<Face> nf = array.new<Face>()
    for f in self.faces
        nf.push(Face.new(f.vi.copy(), f.col))
    Mesh result = Mesh.new(nv, nf,
      Vec3.new(self.position.x, self.position.y, self.position.z),
      Vec3.new(self.rotation.x, self.rotation.y, self.rotation.z),
      Vec3.new(self.meshScale.x, self.meshScale.y, self.meshScale.z),
      self.visible, self.tag, self.style)
    if not na(self._depthGroupFaceEnds)
        result._depthGroupFaceEnds := self._depthGroupFaceEnds.copy()
        result._depthGroupVertEnds := self._depthGroupVertEnds.copy()
    // Copy contour metadata if present
    if not na(self._contourMeta)
        result._contourMeta := _ContourMeta.new(
          self._contourMeta.cols,
          self._contourMeta.rows,
          self._contourMeta.size,
          self._contourMeta.levels,
          self._contourMeta.lowCol,
          self._contourMeta.highCol)
    result


// ============================================================================
// SECTION 4: CAMERA METHODS
// ============================================================================

//@function Set the camera's world position.
//@param x (float) X position
//@param y (float) Y position
//@param z (float) Z position
//@returns (Camera) Self for chaining
export method setPosition(Camera self, float x, float y, float z) =>
    self.position := Vec3.new(x, y, z)
    self

//@function Set the point the camera looks at.
//@param x (float) X target
//@param y (float) Y target
//@function Set the point the camera looks at.
//@param x (float) X target
//@param y (float) Y target
//@param z (float) Z target
//@returns (Camera) Self for chaining
export method lookAt(Camera self, float x, float y, float z) =>
    self.target := Vec3.new(x, y, z)
    self

//@function Set the point the camera looks at from a Vec3.
//@param tgt (Vec3) The target coordinate
//@returns (Camera) Self for chaining
export method lookAt(Camera self, Vec3 tgt) =>
    if not na(tgt)
        self.target := Vec3.new(tgt.x, tgt.y, tgt.z)
    self

//@function Position the camera by orbiting around its target point.
//          Uses spherical coordinates: angleX = horizontal (azimuth), angleY = vertical (elevation).
//          orbit(0,0,d) = front view, orbit(90,0,d) = side, orbit(0,90,d) = top-down.
//@param angleX (float) Horizontal orbit angle in degrees
//@param angleY (float) Vertical orbit angle in degrees
//@param distance (float) Distance from target
//@returns (Camera) Self for chaining
export method orbit(Camera self, float angleX, float angleY, float distance) =>
    float ax = math.toradians(angleX)
    float ay = math.toradians(angleY)
    float cy = math.cos(ay)
    self.position := Vec3.new(
      self.target.x + distance * cy * math.sin(ax),
      self.target.y + distance * math.sin(ay),
      self.target.z + distance * cy * math.cos(ax))
    self

//@function Set the camera's field-of-view (perspective scale factor).
//          Higher = less distortion (telephoto), lower = more dramatic (wide-angle).
//@param val (float) The FOV value
//@returns (Camera) Self for chaining
export method setFov(Camera self, float val) =>
    self.fov := val
    self


// ============================================================================
// SECTION 4B: LIGHT CONVENIENCE METHODS
// ============================================================================

// Internal: ensures Scene.light is allocated. Used by all set* light helpers.
_ensureLight(Scene s) =>
    if na(s.light)
        s.light := Light.new()

//@function Set the light direction (directional mode). Allocates default Light if na.
//@param x (float) X component of direction toward the light
//@param y (float) Y component
//@param z (float) Z component
//@returns (Scene) Self for chaining
export method setLightDir(Scene self, float x, float y, float z) =>
    _ensureLight(self)
    self.light.direction := Vec3.new(x, y, z)
    self

//@function Set the light position (point mode). Allocates default Light if na.
//@param x (float) X world position
//@param y (float) Y world position
//@param z (float) Z world position
//@returns (Scene) Self for chaining
export method setLightPos(Scene self, float x, float y, float z) =>
    _ensureLight(self)
    self.light.position := Vec3.new(x, y, z)
    self

//@function Set the light mode ("directional" or "point"). Allocates default Light if na.
//@param mode (string) Light mode
//@returns (Scene) Self for chaining
export method setLightMode(Scene self, string mode) =>
    _ensureLight(self)
    self.light.mode := mode
    self

//@function Set the ambient brightness floor. Allocates default Light if na.
//@param a (float) Ambient level (0.0-1.0)
//@returns (Scene) Self for chaining
export method setAmbient(Scene self, float a) =>
    _ensureLight(self)
    self.light.ambient := a
    self

//@function Set the shadow strength. Allocates default Light if na.
//@param s (float) Shadow strength (0.0 = none, 1.0 = full)
//@returns (Scene) Self for chaining
export method setShadowStrength(Scene self, float s) =>
    _ensureLight(self)
    self.light.shadowStr := s
    self

//@function Toggle point-light source label visibility. Allocates default Light if na.
//@param show (bool) Whether to show the light source marker
//@returns (Scene) Self for chaining
export method showLightSource(Scene self, bool show) =>
    _ensureLight(self)
    self.light.showSource := show
    self


// ============================================================================
// SECTION 5: SCENE METHODS
// ============================================================================

//@function Add a mesh to the scene. If the mesh has pending overlay primitives queued
//          by chainable helpers like `gridBox()` / `gridLabels()` / `barLabels()`, they
//          are drained into the scene's polylines/labels arrays automatically.
//@param m (Mesh) The mesh to add
//@returns (Scene) Self for chaining
export method add(Scene self, Mesh m) =>
    self.meshes.push(m)
    bool shiftContourOverlays = not na(m._contourMeta)
    Vec3 mp = m.position
    if not na(m._pendingPolylines)
        if na(self.polylines3D)
            self.polylines3D := array.new<Polyline3D>()
        for pl in m._pendingPolylines
            if shiftContourOverlays
                for i = 0 to pl.points.size() - 1
                    Vec3 p = pl.points.get(i)
                    pl.points.set(i, Vec3.new(p.x + mp.x, p.y + mp.y, p.z + mp.z))
            self.polylines3D.push(pl)
        m._pendingPolylines := na
    if not na(m._pendingLabels)
        if na(self.labels)
            self.labels := array.new<Label3D>()
        for lbl in m._pendingLabels
            if shiftContourOverlays
                lbl.position := lbl.position.add(mp)
            self.labels.push(lbl)
        m._pendingLabels := na
    self

//@function Remove a mesh by index.
//@param i (int) Index to remove
//@returns (Scene) Self for chaining
export method remove(Scene self, int i) =>
    if i >= 0 and i < self.meshes.size()
        self.meshes.remove(i)
    self

//@function Remove any object (Mesh, Label3D, Line3D, or Polyline3D) by its tag. Removes the first match found.
//@param t (string) Tag to search for across all scene arrays
//@returns (Scene) Self for chaining
export method remove(Scene self, string t) =>
    bool found = false
    for i = 0 to self.meshes.size() - 1
        if self.meshes.get(i).tag == t
            self.meshes.remove(i)
            found := true
            break
    if not found and not na(self.labels)
        for i = 0 to self.labels.size() - 1
            if self.labels.get(i).tag == t
                self.labels.remove(i)
                found := true
                break
    if not found and not na(self.lines3D)
        for i = 0 to self.lines3D.size() - 1
            if self.lines3D.get(i).tag == t
                self.lines3D.remove(i)
                found := true
                break
    if not found and not na(self.polylines3D)
        for i = 0 to self.polylines3D.size() - 1
            if self.polylines3D.get(i).tag == t
                self.polylines3D.remove(i)
                break
    self

//@function Remove all objects (meshes and overlays) from the scene.
//@returns (Scene) Self for chaining
export method clear(Scene self) =>
    self.meshes.clear()
    if not na(self.labels)
        self.labels.clear()
    if not na(self.lines3D)
        self.lines3D.clear()
    if not na(self.polylines3D)
        self.polylines3D.clear()
    self

//@function Find a mesh by its tag. Returns na if not found.
//@param t (string) The tag to search for
//@returns (Mesh) The first mesh matching the tag, or na
export method getMesh(Scene self, string t) =>
    Mesh result = na
    for m in self.meshes
        if m.tag == t
            result := m
            break
    result

//@function Point the camera at a specific mesh using its tag.
//@param t (string) The tag of the target mesh
//@returns (Scene) Self for chaining
export method lookAt(Scene self, string t) =>
    Mesh m = self.getMesh(t)
    if not na(m)
        self.camera.lookAt(m.position)
    self

//@function Total face count across all visible meshes (polyline budget cost).
//@returns (int) Total faces
export method totalFaces(Scene self) =>
    int total = 0
    for m in self.meshes
        if m.visible
            total += m.faces.size()
    total


// ============================================================================
// SECTION 5B: OVERLAY PRIMITIVE METHODS (Label3D, Line3D, Polyline3D)
// ============================================================================

// ----- Label3D Methods -----

//@function Set the label's world-space position.
//@param x (float) X position
//@param y (float) Y position
//@param z (float) Z position
//@returns (Label3D) Self for chaining
export method moveTo(Label3D self, float x, float y, float z) =>
    self.position := Vec3.new(x, y, z)
    self

//@function Translate the label by a relative offset.
//@param dx (float) X offset
//@param dy (float) Y offset
//@param dz (float) Z offset
//@returns (Label3D) Self for chaining
export method moveBy(Label3D self, float dx, float dy, float dz) =>
    self.position := Vec3.new(self.position.x + dx, self.position.y + dy, self.position.z + dz)
    self

//@function Set the label text.
//@param t (string) New text
//@returns (Label3D) Self for chaining
export method setText(Label3D self, string t) =>
    self.txt := t
    self

//@function Set the label text color.
//@param c (color) New text color
//@returns (Label3D) Self for chaining
export method setTextColor(Label3D self, color c) =>
    self.textColor := c
    self

//@function Set the label tooltip.
//@param t (string) Tooltip text
//@returns (Label3D) Self for chaining
export method setTooltip(Label3D self, string t) =>
    self.tooltip := t
    self

//@function Make the label visible.
//@returns (Label3D) Self for chaining
export method show(Label3D self) =>
    self.visible := true
    self

//@function Hide the label from rendering.
//@returns (Label3D) Self for chaining
export method hide(Label3D self) =>
    self.visible := false
    self

//@function Assign an identifier tag.
//@param t (string) The tag string
//@returns (Label3D) Self for chaining
export method setTag(Label3D self, string t) =>
    self.tag := t
    self

// ----- Line3D Methods -----

//@function Set the line's start point.
//@param x (float) X position
//@param y (float) Y position
//@param z (float) Z position
//@returns (Line3D) Self for chaining
export method setStart(Line3D self, float x, float y, float z) =>
    self.start := Vec3.new(x, y, z)
    self

//@function Set the line's end point.
//@param x (float) X position
//@param y (float) Y position
//@param z (float) Z position
//@returns (Line3D) Self for chaining
export method setEnd(Line3D self, float x, float y, float z) =>
    self.end := Vec3.new(x, y, z)
    self

//@function Set both endpoints of the line.
//@param x1 (float) Start X
//@param y1 (float) Start Y
//@param z1 (float) Start Z
//@param x2 (float) End X
//@param y2 (float) End Y
//@param z2 (float) End Z
//@returns (Line3D) Self for chaining
export method setPoints(Line3D self, float x1, float y1, float z1, float x2, float y2, float z2) =>
    self.start := Vec3.new(x1, y1, z1)
    self.end   := Vec3.new(x2, y2, z2)
    self

//@function Set the line color.
//@param c (color) New color
//@returns (Line3D) Self for chaining
export method setColor(Line3D self, color c) =>
    self.col := c
    self

//@function Make the line visible.
//@returns (Line3D) Self for chaining
export method show(Line3D self) =>
    self.visible := true
    self

//@function Hide the line from rendering.
//@returns (Line3D) Self for chaining
export method hide(Line3D self) =>
    self.visible := false
    self

//@function Assign an identifier tag.
//@param t (string) The tag string
//@returns (Line3D) Self for chaining
export method setTag(Line3D self, string t) =>
    self.tag := t
    self

// ----- Polyline3D Methods -----

//@function Set the polyline color.
//@param c (color) New line color
//@returns (Polyline3D) Self for chaining
export method setColor(Polyline3D self, color c) =>
    self.col := c
    self

//@function Make the polyline visible.
//@returns (Polyline3D) Self for chaining
export method show(Polyline3D self) =>
    self.visible := true
    self

//@function Hide the polyline from rendering.
//@returns (Polyline3D) Self for chaining
export method hide(Polyline3D self) =>
    self.visible := false
    self

//@function Assign an identifier tag.
//@param t (string) The tag string
//@returns (Polyline3D) Self for chaining
export method setTag(Polyline3D self, string t) =>
    self.tag := t
    self

// ----- Scene add/get overloads for overlay primitives -----

//@function Add a Label3D to the scene.
//@param lbl (Label3D) The label to add
//@returns (Scene) Self for chaining
export method add(Scene self, Label3D lbl) =>
    if na(self.labels)
        self.labels := array.new<Label3D>()
    self.labels.push(lbl)
    self

//@function Add a Line3D to the scene.
//@param ln (Line3D) The line to add
//@returns (Scene) Self for chaining
export method add(Scene self, Line3D ln) =>
    if na(self.lines3D)
        self.lines3D := array.new<Line3D>()
    self.lines3D.push(ln)
    self

//@function Add a Polyline3D to the scene.
//@param pl (Polyline3D) The polyline to add
//@returns (Scene) Self for chaining
export method add(Scene self, Polyline3D pl) =>
    if na(self.polylines3D)
        self.polylines3D := array.new<Polyline3D>()
    self.polylines3D.push(pl)
    self

//@function Add an array of Label3D objects to the scene in one call.
//          Each label is depth-sorted and occludes against opaque meshes.
//          Consumes the label budget (500 max), not the polyline budget.
//          The array is held by reference, so per-bar field mutation propagates to
//          the next render() without an explicit sync.
//@param labels (array<Label3D>) The labels to add. na entries are skipped.
//@returns (Scene) Self for chaining.
export method add(Scene self, array<Label3D> labels) =>
    if not na(labels)
        if na(self.labels)
            self.labels := array.new<Label3D>()
        for lbl in labels
            if not na(lbl)
                self.labels.push(lbl)
    self

//@function Find a Label3D by its tag. Returns na if not found.
//@param t (string) The tag to search for
//@returns (Label3D) The first matching label, or na
export method getLabel(Scene self, string t) =>
    Label3D result = na
    if not na(self.labels)
        for lbl in self.labels
            if lbl.tag == t
                result := lbl
                break
    result

//@function Find a Line3D by its tag. Returns na if not found.
//@param t (string) The tag to search for
//@returns (Line3D) The first matching line, or na
export method getLine(Scene self, string t) =>
    Line3D result = na
    if not na(self.lines3D)
        for ln in self.lines3D
            if ln.tag == t
                result := ln
                break
    result

//@function Find a Polyline3D by its tag. Returns na if not found.
//@param t (string) The tag to search for
//@returns (Polyline3D) The first matching polyline, or na
export method getPolyline(Scene self, string t) =>
    Polyline3D result = na
    if not na(self.polylines3D)
        for pl in self.polylines3D
            if pl.tag == t
                result := pl
                break
    result

// ----- Scene remove overloads for overlay primitives -----




// Internal helper: creates a Mesh at origin with identity transform.
// Eliminates repeated Vec3.new(0,0,0) / Vec3.new(1,1,1) boilerplate across all generators.
_newMesh(array<Vec3> v, array<Face> f, string style = "solid", string tag = "") =>
    Mesh.new(v, f, Vec3.new(0,0,0), Vec3.new(0,0,0), Vec3.new(1,1,1), true, tag, style)


// ============================================================================
// SECTION 6: PRIMITIVE GENERATORS
// ============================================================================

//@function Creates a cuboid mesh with different width, height, and depth.
//@param w (float) Width (X axis)
//@param h (float) Height (Y axis)
//@param d (float) Depth (Z axis)
//@param col (color) Face color
//@returns (Mesh) A cuboid with 6 faces
export cuboid(float w, float h, float d, color col) =>
    float hw = w / 2.0
    float hh = h / 2.0
    float hd = d / 2.0
    array<Vec3> v = array.from(
      Vec3.new(-hw, -hh, -hd), Vec3.new( hw, -hh, -hd), Vec3.new( hw,  hh, -hd), Vec3.new(-hw,  hh, -hd),
      Vec3.new(-hw, -hh,  hd), Vec3.new( hw, -hh,  hd), Vec3.new( hw,  hh,  hd), Vec3.new(-hw,  hh,  hd))
    array<Face> f = array.from(
      Face.new(array.from(0, 3, 2, 1), col),
      Face.new(array.from(5, 6, 7, 4), col),
      Face.new(array.from(4, 7, 3, 0), col),
      Face.new(array.from(1, 2, 6, 5), col),
      Face.new(array.from(0, 1, 5, 4), col),
      Face.new(array.from(3, 7, 6, 2), col))
    _newMesh(v, f)

//@function Creates a cube mesh (equal sides) centered at the origin. Wrapper for cuboid().
//@param size (float) Side length
//@param col (color) Face color
//@returns (Mesh) A cube with 6 faces
export cube(float size, color col) =>
    cuboid(size, size, size, col)

//@function Creates a 4-sided pyramid centered at origin, base on XZ plane.
//@param base (float) Base side length
//@param height (float) Pyramid height
//@param col (color) Face color
//@returns (Mesh) A pyramid with 5 faces (4 sides + base)
export pyramid(float base, float height, color col) =>
    float hb = base / 2.0
    array<Vec3> v = array.from(
      Vec3.new(-hb, 0, -hb),   // 0: base front-left
      Vec3.new( hb, 0, -hb),   // 1: base front-right
      Vec3.new( hb, 0,  hb),   // 2: base back-right
      Vec3.new(-hb, 0,  hb),   // 3: base back-left
      Vec3.new(0, height, 0))  // 4: apex
    array<Face> f = array.from(
      Face.new(array.from(0, 4, 1), col),   // Front side
      Face.new(array.from(1, 4, 2), col),   // Right side
      Face.new(array.from(2, 4, 3), col),   // Back side
      Face.new(array.from(3, 4, 0), col),   // Left side
      Face.new(array.from(0, 1, 2, 3), col)) // Base
    _newMesh(v, f)

//@function Creates a single-quad plane on the XY plane.
//@param w (float) Width (X axis)
//@param h (float) Height (Y axis)
//@param col (color) Face color
//@returns (Mesh) A plane with 1 face
export plane(float w, float h, color col) =>
    float hw = w / 2.0
    float hh = h / 2.0
    array<Vec3> v = array.from(
      Vec3.new(-hw, -hh, 0), Vec3.new( hw, -hh, 0),
      Vec3.new( hw,  hh, 0), Vec3.new(-hw,  hh, 0))
    array<Face> f = array.from(Face.new(array.from(0, 3, 2, 1), col))
    _newMesh(v, f)

//@function Creates a UV sphere centered at origin.
//@param radius (float) Sphere radius
//@param seg (int) Longitude segments (around the equator). More = smoother, costs more faces.
//@param ring (int) Latitude rings (pole to pole). More = smoother, costs more faces.
//@param col (color) Face color
//@returns (Mesh) A sphere with seg × ring faces
export sphere(float radius, int seg, int ring, color col) =>
    array<Vec3> verts = array.new<Vec3>()
    // Generate vertices using spherical coordinates (no seam duplicates)
    for i = 0 to ring
        float phi = math.pi * float(i) / float(ring)
        float cp  = math.cos(phi)
        float sp  = math.sin(phi)
        for j = 0 to seg - 1
            float theta = 2.0 * math.pi * float(j) / float(seg)
            float ct = math.cos(theta)
            float st = math.sin(theta)
            verts.push(Vec3.new(radius * sp * ct, radius * cp, radius * sp * st))
    // Generate faces (quads between adjacent rings, modulo wrap at seam)
    array<Face> faces = array.new<Face>()
    for i = 0 to ring - 1
        for j = 0 to seg - 1
            int j1 = (j + 1) % seg
            int i0 = i * seg + j
            int i1 = i * seg + j1
            int i2 = (i + 1) * seg + j1
            int i3 = (i + 1) * seg + j
            if i == 0
                // Top cap: triangles avoid degenerate quads because the pole row collapses to one point.
                faces.push(Face.new(array.from(i0, i2, i3), col))
            else if i == ring - 1
                // Bottom cap: same fix for the south pole.
                faces.push(Face.new(array.from(i0, i1, i2), col))
            else
                faces.push(Face.new(array.from(i0, i1, i2, i3), col))
    _newMesh(verts, faces)

//@function Creates a cylinder centered at origin, along the Y axis.
//@param radius (float) Cylinder radius
//@param height (float) Cylinder height
//@param seg (int) Number of segments around the circumference
//@param col (color) Face color
//@returns (Mesh) A cylinder with seg side faces + 2 cap faces = seg + 2 faces
export cylinder(float radius, float height, int seg, color col) =>
    float hh = height / 2.0
    array<Vec3> verts = array.new<Vec3>()
    // Bottom ring (y = -hh) and top ring (y = +hh), sharing trig per angle
    for i = 0 to seg - 1
        float angle = 2.0 * math.pi * float(i) / float(seg)
        float cx = radius * math.cos(angle)
        float cz = radius * math.sin(angle)
        verts.push(Vec3.new(cx, -hh, cz))  // bottom vertex
        verts.push(Vec3.new(cx,  hh, cz))  // top vertex

    array<Face> faces = array.new<Face>()
    // Side faces
    for i = 0 to seg - 1
        int next = (i + 1) % seg
        int b0 = i * 2
        int b1 = next * 2
        int t0 = i * 2 + 1
        int t1 = next * 2 + 1
        faces.push(Face.new(array.from(b0, b1, t1, t0), col))
    // Bottom cap (facing -Y)
    array<int> botFace = array.new<int>()
    for i = seg - 1 to 0
        botFace.push(i * 2)
    faces.push(Face.new(botFace, col))
    // Top cap (facing +Y)
    array<int> topFace = array.new<int>()
    for i = 0 to seg - 1
        topFace.push(i * 2 + 1)
    faces.push(Face.new(topFace, col))
    _newMesh(verts, faces)

//@function Creates a torus centered at origin on the XZ plane.
//@param majorR (float) Major radius (center of tube to center of torus)
//@param minorR (float) Minor radius (tube radius)
//@param seg (int) Segments around the tube cross-section
//@param ring (int) Rings around the torus
//@param col (color) Face color
//@returns (Mesh) A torus with seg × ring faces
export torus(float majorR, float minorR, int seg, int ring, color col) =>
    array<Vec3> verts = array.new<Vec3>()
    // No seam duplicates: loop to ring-1 and seg-1, use modulo for face winding
    for i = 0 to ring - 1
        float theta = 2.0 * math.pi * float(i) / float(ring)
        float ct = math.cos(theta)
        float st = math.sin(theta)
        for j = 0 to seg - 1
            float phi = 2.0 * math.pi * float(j) / float(seg)
            float cp  = math.cos(phi)
            float sp  = math.sin(phi)
            float rx  = (majorR + minorR * cp) * ct
            float ry  = minorR * sp
            float rz  = (majorR + minorR * cp) * st
            verts.push(Vec3.new(rx, ry, rz))
    array<Face> faces = array.new<Face>()
    for i = 0 to ring - 1
        int i1row = (i + 1) % ring
        for j = 0 to seg - 1
            int j1 = (j + 1) % seg
            int i0 = i * seg + j
            int i1 = i * seg + j1
            int i2 = i1row * seg + j1
            int i3 = i1row * seg + j
            faces.push(Face.new(array.from(i0, i1, i2, i3), col))
    _newMesh(verts, faces)

//@function Creates a subdivided grid on the XZ plane (useful for terrain, surfaces).
//@param w (float) Total width (X axis)
//@param d (float) Total depth (Z axis)
//@param divX (int) Divisions along X
//@param divZ (int) Divisions along Z
//@param col (color) Face color
//@returns (Mesh) A grid with divX × divZ faces
export grid(float w, float d, int divX, int divZ, color col) =>
    array<Vec3> verts = array.new<Vec3>()
    float hw = w / 2.0
    float hd = d / 2.0
    for iz = 0 to divZ
        for ix = 0 to divX
            float px = -hw + w * float(ix) / float(divX)
            float pz = -hd + d * float(iz) / float(divZ)
            verts.push(Vec3.new(px, 0.0, pz))
    array<Face> faces = array.new<Face>()
    int stride = divX + 1
    for iz = 0 to divZ - 1
        for ix = 0 to divX - 1
            int i0 = iz * stride + ix
            int i1 = i0 + 1
            int i2 = (iz + 1) * stride + ix + 1
            int i3 = (iz + 1) * stride + ix
            faces.push(Face.new(array.from(i0, i1, i2, i3), col))
    _newMesh(verts, faces)

//@function Creates an elliptical disc (ring) on the XZ plane centered at origin.
//          Default style is "wireframe" (outline only). Use setStyle("solid") for a filled disc.
//          Faces: 1 (single n-gon).
//@param radiusX (float) Semi-axis along X
//@param radiusZ (float) Semi-axis along Z
//@param seg (int) Number of vertices around the perimeter. More = smoother.
//@param col (color) Line/fill color
//@returns (Mesh) A disc with 1 face
export disc(float radiusX, float radiusZ, int seg, color col) =>
    array<Vec3> verts = array.new<Vec3>()
    array<int> vi = array.new<int>()
    for i = 0 to seg - 1
        float angle = 2.0 * math.pi * float(i) / float(seg)
        verts.push(Vec3.new(radiusX * math.cos(angle), 0.0, radiusZ * math.sin(angle)))
        vi.push(i)
    array<Face> faces = array.from(Face.new(vi, col))
    _newMesh(verts, faces, "wireframe")

//@function Creates a mesh from user-supplied vertices and faces. Full DIY mode.
//@param verts (array<Vec3>) Custom vertex positions
//@param faces (array<Face>) Custom face definitions
//@returns (Mesh) A custom mesh
export customMesh(array<Vec3> verts, array<Face> faces) =>
    _newMesh(verts, faces)

// ============================================================================
// SECTION 6B: WORLD TRANSFORM & MERGE UTILITIES
// ============================================================================

// Transforms a vertex from local mesh space to world space.
// Trig values (cx, sx_, cy, sy_, cz, sz_) must be precomputed once per mesh by the caller.
_toWorld(Vec3 v, Vec3 pos, Vec3 scl, float cx, float sx_, float cy, float sy_, float cz, float sz_) =>
    // 1. Scale
    float _sx = v.x * scl.x
    float _sy = v.y * scl.y
    float _sz = v.z * scl.z
    // 2. Rotate X
    float ry = _sy * cx - _sz * sx_
    float rz = _sy * sx_ + _sz * cx
    float rx = _sx
    // 3. Rotate Y
    float rx2 = rx * cy + rz * sy_
    float rz2 = -rx * sy_ + rz * cy
    // 4. Rotate Z
    float rx3 = rx2 * cz - ry * sz_
    float ry3 = rx2 * sz_ + ry * cz
    // 5. Translate
    Vec3.new(rx3 + pos.x, ry3 + pos.y, rz2 + pos.z)

//@function Merges multiple meshes into a single mesh. Each mesh's transform
//          (position, rotation, scale) is baked into its vertices so the result
//          sits at the origin with identity transform. Useful for combining many
//          small meshes (e.g. a grid of cubes) to reduce per-mesh overhead in
//          the render pipeline, especially shadow queries.
//          When removeInterior is true, coincident faces with opposing normals
//          (e.g. shared walls between adjacent cubes) are automatically removed,
//          keeping only the exterior shell.
//          When all source meshes share the same face/vertex counts, depth grouping
//          is auto-derived so each sub-mesh sorts by its own radial distance.
//@param meshes (array<Mesh>) The meshes to merge
//@param tag (string) Optional tag for the merged mesh
//@param removeInterior (bool) Remove coincident interior faces. Default false.
//@returns (Mesh) A single mesh containing all vertices and faces
export mergeMeshes(array<Mesh> meshes, string tag = "", bool removeInterior = false) =>
    array<Vec3> mergedVerts = array.new<Vec3>()
    array<Face> mergedFaces = array.new<Face>()
    // Track cumulative face/vert boundaries per sub-mesh for depth grouping
    array<int> faceEnds = array.new<int>()
    array<int> vertEnds = array.new<int>()
    string resultStyle = meshes.size() > 0 ? meshes.first().style : "solid"
    for mesh in meshes
        int baseIdx = mergedVerts.size()
        // Bake transform into vertices
        float cx = math.cos(mesh.rotation.x)
        float sx = math.sin(mesh.rotation.x)
        float cy = math.cos(mesh.rotation.y)
        float sy = math.sin(mesh.rotation.y)
        float cz = math.cos(mesh.rotation.z)
        float sz = math.sin(mesh.rotation.z)
        for v in mesh.vertices
            mergedVerts.push(_toWorld(v, mesh.position, mesh.meshScale, cx, sx, cy, sy, cz, sz))
        // Remap face indices
        for face in mesh.faces
            array<int> newVi = array.new<int>()
            for idx in face.vi
                newVi.push(idx + baseIdx)
            mergedFaces.push(Face.new(newVi, face.col))
        faceEnds.push(mergedFaces.size())
        vertEnds.push(mergedVerts.size())
    // --- Interior face removal: discard coincident faces with opposing normals ---
    if removeInterior and mergedFaces.size() > 1
        int fCount = mergedFaces.size()
        array<bool> removeMask = array.new<bool>(fCount, false)
        array<float> faceNx = array.new<float>(fCount, 0.0)
        array<float> faceNy = array.new<float>(fCount, 0.0)
        array<float> faceNz = array.new<float>(fCount, 0.0)
        map<string, int> centroidMap = map.new<string, int>()
        for fi = 0 to fCount - 1
            Face face = mergedFaces.get(fi)
            if face.vi.size() < 3
                continue
            // Centroid
            float sumX = 0.0
            float sumY = 0.0
            float sumZ = 0.0
            for idx in face.vi
                Vec3 v = mergedVerts.get(idx)
                sumX += v.x
                sumY += v.y
                sumZ += v.z
            float inv = 1.0 / float(face.vi.size())
            float fcx = sumX * inv
            float fcy = sumY * inv
            float fcz = sumZ * inv
            // Normal (cross product of first two edges)
            Vec3 v0 = mergedVerts.get(face.vi.get(0))
            Vec3 v1 = mergedVerts.get(face.vi.get(1))
            Vec3 v2 = mergedVerts.get(face.vi.get(2))
            float nx = (v1.y - v0.y) * (v2.z - v0.z) - (v1.z - v0.z) * (v2.y - v0.y)
            float ny = (v1.z - v0.z) * (v2.x - v0.x) - (v1.x - v0.x) * (v2.z - v0.z)
            float nz = (v1.x - v0.x) * (v2.y - v0.y) - (v1.y - v0.y) * (v2.x - v0.x)
            faceNx.set(fi, nx)
            faceNy.set(fi, ny)
            faceNz.set(fi, nz)
            // Quantized centroid key (0.01 precision)
            string key = str.tostring(math.round(fcx * 100.0)) + "," +
              str.tostring(math.round(fcy * 100.0)) + "," +
              str.tostring(math.round(fcz * 100.0))
            if centroidMap.contains(key)
                int other = centroidMap.get(key)
                if removeMask.get(other)
                    // Previous match already removed; store this as new candidate
                    centroidMap.put(key, fi)
                else
                    // Check opposing normals (dot < 0 means they face each other)
                    float dot = faceNx.get(fi) * faceNx.get(other) +
                      faceNy.get(fi) * faceNy.get(other) +
                      faceNz.get(fi) * faceNz.get(other)
                    if dot < 0.0
                        removeMask.set(fi, true)
                        removeMask.set(other, true)
            else
                centroidMap.put(key, fi)
        // Rebuild without interior faces
        array<Face> cleanFaces = array.new<Face>()
        for fi = 0 to fCount - 1
            if not removeMask.get(fi)
                cleanFaces.push(mergedFaces.get(fi))
        mergedFaces := cleanFaces
    Mesh result = _newMesh(mergedVerts, mergedFaces, resultStyle, tag)
    result.drawMode := meshes.size() > 0 ? meshes.first().drawMode : "linefill"
    // Store depth group boundaries for any multi-mesh merge
    if meshes.size() > 1
        result._depthGroupFaceEnds := faceEnds
        result._depthGroupVertEnds := vertEnds
    result


// ============================================================================
// SECTION 7: DATA VISUALIZATION WRAPPERS (Layer 2)
// ============================================================================

// Internal helper: lerp between two colors by normalized factor t (0.0 = colA, 1.0 = colB).
_colorLerp(color colA, color colB, float t) => color.rgb(int(color.r(colA) + (color.r(colB) - color.r(colA)) * t), int(color.g(colA) + (color.g(colB) - color.g(colA)) * t), int(color.b(colA) + (color.b(colB) - color.b(colA)) * t))

// Default-value helpers used by updateBars() / updateSurface() to coalesce
// caller-supplied na with cached field value, falling back to a literal default.
_dN(float v, float field, float fb) => nz(v, nz(field, fb))
_dC(color v, color field, color fb) => na(v) ? (na(field) ? fb : field) : v

// Refreshes a row of tick-value labels in place. Used by updateSurface() per axis.
_refreshTicks(array<Label3D> arr, float lo, float rn, int t1, string fmt) =>
    if not na(arr) and arr.size() > t1
        for i = 0 to t1
            lbl = arr.get(i)
            lbl.txt := str.tostring(lo + float(i) / float(t1) * rn, fmt)

// Pushes one cuboid quad face onto `faces` with optional winding flip. The flipped
// case (a,d,c,b) reverses the polygon's orientation, used by bars3D when val < 0.
_pushBarFace(array<Face> faces, int v0, int a, int b, int c, int d, color col, bool flip) =>
    array<int> vi = flip ? array.from(v0+a, v0+d, v0+c, v0+b) : array.from(v0+a, v0+b, v0+c, v0+d)
    faces.push(Face.new(vi, col))

// Internal: Builds (vertices, _ContourMeta) for a surface() / updateSurface() call.
// Geometry follows the contour-mesh layout - verts row-major, faces empty
// (rendering handled specially via _contourMeta).
_buildSurfaceGeom(matrix<float> heights, float size, color lowCol, color highCol, int levels, array<float> axisX, array<float> axisZ) =>
    int rows = matrix.rows(heights)
    int cols = matrix.columns(heights)
    float halfSize = size / 2.0
    // --- Resolve X axis positions ---
    bool customX = not na(axisX)
    float xMin = 0.0
    float xMax = float(cols - 1)
    if customX
        xMin := axisX.min()
        xMax := axisX.max()
    float xRange = xMax - xMin
    if xRange < NORMALIZE_EPSILON
        xRange := 1.0
    // --- Resolve Z axis positions ---
    bool customZ = not na(axisZ)
    float zMin = 0.0
    float zMax = float(rows - 1)
    if customZ
        zMin := axisZ.min()
        zMax := axisZ.max()
    float zRange = zMax - zMin
    if zRange < NORMALIZE_EPSILON
        zRange := 1.0
    // --- Normalize Y (height) range ---
    float yMin   = matrix.min(heights)
    float yMax   = matrix.max(heights)
    float yRange = yMax - yMin
    if yRange < NORMALIZE_EPSILON
        yRange := 1.0
    // --- Build vertices (row-major) ---
    array<Vec3> verts = array.new<Vec3>()
    for r = 0 to rows - 1
        float zVal = float(r)
        if customZ
            zVal := nz(axisZ.get(r))
        float pz = (zVal - zMin) / zRange * size - halfSize
        for c = 0 to cols - 1
            float val = nz(matrix.get(heights, r, c))
            float xVal = float(c)
            if customX
                xVal := nz(axisX.get(c))
            float px  = halfSize - (xVal - xMin) / xRange * size
            float py  = (val - yMin) / yRange * size - halfSize
            verts.push(Vec3.new(px, py, pz))
    _ContourMeta meta = _ContourMeta.new(cols, rows, size, math.max(2, levels), lowCol, highCol)
    meta._dataXMin := xMin
    meta._dataXMax := xMax
    meta._dataYMin := yMin
    meta._dataYMax := yMax
    meta._dataZMin := zMin
    meta._dataZMax := zMax
    [verts, meta]

//@function Creates a contour-style 3D surface from a matrix of height values.
//          Follows the Plotly convention: heights (z) is required, axis positions (x/z) are optional.
//          When axisX or axisZ are omitted, uniform integer indices are used.
//          All three dimensions are auto-normalized into a world-space bounding cube of the given size,
//          preserving proportional spacing within each axis. Any input range maps to the same geometry.
//          Matrix [0,0] is anchored at the +X / -Z corner of the cube so surfaces start on the X-side edge by default.
//          Handles edge cases: flat data (zero range), na gaps (treated as 0), single-value matrices.
//          Renders as surface-clipped contour bands with flat per-band coloring (no per-face lighting).
//          Grid dimensions: rows × cols from the matrix. Vertices laid out row-major.
//@param heights (matrix<float>) 2D grid of height values. Rows map to Z axis, columns to X axis, values to Y.
//@param size    (float) World-space bounding cube edge. Each axis fills [-size/2, +size/2].
//@param lowCol  (color) Color for the lowest elevation.
//@param highCol (color) Color for the highest elevation.
//@param levels  (int) Number of contour bands to quantize into. Default 20.
//@param axisX   (array<float>) Optional column positions for non-uniform X spacing. Length must equal matrix columns. When na, uses uniform indices.
//@param axisZ   (array<float>) Optional row positions for non-uniform Z spacing. Length must equal matrix rows. When na, uses uniform indices.
//@returns (Mesh) A contour terrain mesh (style = "contour")
export surface(matrix<float> heights, float size, color lowCol, color highCol, int levels = 20, array<float> axisX = na, array<float> axisZ = na) =>
    [verts, meta] = _buildSurfaceGeom(heights, size, lowCol, highCol, levels, axisX, axisZ)
    Mesh result = _newMesh(verts, array.new<Face>(), "contour")
    result._contourMeta := meta
    result

//@function Updates a surface() mesh in place with new height data, preserving its position,
//          rotation, and scale. Use this to animate a contour surface per bar without
//          rebuilding the scene.
//          Style params (`size`, `lowCol`, `highCol`, `levels`) fall back to the values used
//          at creation time when passed as na.
//@param self    (Mesh) The contour mesh to mutate
//@param heights (matrix<float>) New 2D height grid
//@param size    (float) World-space bounding cube edge. na = keep current.
//@param lowCol  (color) Color for the lowest elevation. na = keep current.
//@param highCol (color) Color for the highest elevation. na = keep current.
//@param levels  (int)   Number of contour bands. na = keep current.
//@param axisX   (array<float>) Optional X axis positions
//@param axisZ   (array<float>) Optional Z axis positions
//@returns (Mesh) Self for chaining
export method updateSurface(Mesh self, matrix<float> heights, float size = na, color lowCol = na, color highCol = na, int levels = na, array<float> axisX = na, array<float> axisZ = na) =>
    _ContourMeta prev = self._contourMeta
    float _sz = _dN(size,    na(prev) ? na : prev.size,    100.0)
    color _lc = _dC(lowCol,  na(prev) ? na : prev.lowCol,  #2196F3)
    color _hc = _dC(highCol, na(prev) ? na : prev.highCol, #FF5722)
    int   _lv = na(levels)  ? (na(prev) ? 20 : prev.levels) : levels
    [verts, meta] = _buildSurfaceGeom(heights, _sz, _lc, _hc, _lv, axisX, axisZ)
    // Carry over grid-label refs from the previous meta so tick-value text can be
    // refreshed in place. Titles and positions stay fixed.
    if not na(self._contourMeta)
        meta._tickLabelsX := self._contourMeta._tickLabelsX
        meta._tickLabelsY := self._contourMeta._tickLabelsY
        meta._tickLabelsZ := self._contourMeta._tickLabelsZ
        meta._tickFmt     := self._contourMeta._tickFmt
    self.vertices     := verts
    self.faces        := array.new<Face>()
    self._contourMeta := meta
    self.invalidateCache()
    // Refresh tick-value labels from the new data ranges.
    if not na(meta._tickLabelsX) and not na(meta._tickFmt) and meta._tickLabelsX.size() > 1
        int t1 = meta._tickLabelsX.size() - 1
        string fmt = meta._tickFmt
        _refreshTicks(meta._tickLabelsX, meta._dataXMin, meta._dataXMax - meta._dataXMin, t1, fmt)
        _refreshTicks(meta._tickLabelsY, meta._dataYMin, meta._dataYMax - meta._dataYMin, t1, fmt)
        _refreshTicks(meta._tickLabelsZ, meta._dataZMin, meta._dataZMax - meta._dataZMin, t1, fmt)
    self

// Internal: applies a mesh's full transform (scale -> rotate XYZ -> translate) to a local
// anchor point at (lx, ly, 0), then adds a rotation-only displacement of (0, dY, 0).
// Used by both _buildBarLabels (initial placement) and _refreshBarLabels (updateBars refresh)
// to keep label positioning math in one place.
_barAnchorWorld(Mesh m, float lx, float ly, float dY) =>
    float cbx = lx * m.meshScale.x
    float cby = ly * m.meshScale.y
    float cx = math.cos(m.rotation.x), float sx = math.sin(m.rotation.x)
    float cy = math.cos(m.rotation.y), float sy = math.sin(m.rotation.y)
    float cz = math.cos(m.rotation.z), float sz = math.sin(m.rotation.z)
    // Rotate anchor (cbx, cby, 0): X then Y then Z
    float rx1 = cbx, ry1 = cby * cx, rz1 = cby * sx
    float rx2 = rx1 * cy + rz1 * sy, ry2 = ry1, rz2 = -rx1 * sy + rz1 * cy
    float wx = rx2 * cz - ry2 * sz + m.position.x
    float wy = rx2 * sz + ry2 * cz + m.position.y
    float wz = rz2 + m.position.z
    // Rotate displacement (0, dY, 0): no scale, no translate
    float dr1y = dY * cx, dr1z = dY * sx
    float dr2x = dr1z * sy, dr2y = dr1y, dr2z = dr1z * cy
    float dwx = dr2x * cz - dr2y * sz, dwy = dr2x * sz + dr2y * cz, dwz = dr2z
    Vec3.new(wx + dwx, wy + dwy, wz + dwz)

// Internal: builds the Label3D objects that barLabels() creates.
// Stores refs on the mesh (`_barNameLabels` / `_barValueLabels`) so updateBars()
// can refresh positions and text in place. Returns the flat array of created labels.
_buildBarLabels(Mesh m, array<string> names, array<string> values, color col, string nameSize, string valSize, float gap) =>
    array<Label3D> result = array.new<Label3D>()
    if m.vertices.size() >= 8
        int barCount = int(m.vertices.size() / 8)
        m._barLabelGap := gap
        bool wantNames = not na(names)
        bool wantVals  = not na(values)
        if wantNames
            m._barNameLabels := array.new<Label3D>()
        if wantVals
            m._barValueLabels := array.new<Label3D>()
        for i = 0 to barCount - 1
            Vec3 v0 = m.vertices.get(i * 8)
            Vec3 v1 = m.vertices.get(i * 8 + 1)
            float lx = (v0.x + v1.x) / 2.0
            // Category label below bar (anchor at bar base, gap downward)
            if wantNames and i < names.size()
                Vec3 pos = _barAnchorWorld(m, lx, 0.0, -gap)
                Label3D lbl = Label3D.new(pos, names.get(i), col, color(na))
                lbl.labelSize := nameSize
                m._barNameLabels.push(lbl)
                result.push(lbl)
            // Value label above bar (anchor at bar top vertex, gap upward)
            if wantVals and i < values.size()
                Vec3 vTop = m.vertices.get(i * 8 + 2)
                Vec3 pos  = _barAnchorWorld(m, lx, vTop.y, gap)
                Label3D top = Label3D.new(pos, values.get(i), col, color(na))
                top.labelSize := valSize
                m._barValueLabels.push(top)
                result.push(top)
    result

// Internal: refreshes positions of existing bar labels to match the mesh's current geometry,
// and optionally updates label text from new catLabels / valLabels arrays. Called by updateBars()
// so labels created by barLabels() stay in sync as the
// underlying values change. No-op when the mesh has no bar-label refs.
_refreshBarLabels(Mesh m, array<string> catLabels, array<string> valLabels) =>
    bool hasName = not na(m._barNameLabels)
    bool hasVal  = not na(m._barValueLabels)
    if (hasName or hasVal) and m.vertices.size() >= 8
        int barCount = int(m.vertices.size() / 8)
        float gap = nz(m._barLabelGap, 5.0)
        int nameRefs = hasName ? m._barNameLabels.size() : 0
        int valRefs  = hasVal  ? m._barValueLabels.size() : 0
        for i = 0 to barCount - 1
            Vec3 v0 = m.vertices.get(i * 8)
            Vec3 v1 = m.vertices.get(i * 8 + 1)
            float lx = (v0.x + v1.x) / 2.0
            if hasName and i < nameRefs
                Label3D lbl = m._barNameLabels.get(i)
                lbl.position := _barAnchorWorld(m, lx, 0.0, -gap)
                if not na(catLabels) and i < catLabels.size()
                    lbl.txt := catLabels.get(i)
            if hasVal and i < valRefs
                Vec3 vTop = m.vertices.get(i * 8 + 2)
                Label3D lbl = m._barValueLabels.get(i)
                lbl.position := _barAnchorWorld(m, lx, vTop.y, gap)
                if not na(valLabels) and i < valLabels.size()
                    lbl.txt := valLabels.get(i)

// Internal: Builds the (vertices, faces, faceEnds, vertEnds) geometry for a bars3D mesh,
// baked at the world origin. Each bar is registered as its own depth group so render()
// can sort bars correctly relative to each other (a tall back bar vs. a short front bar).
// Used by both the initial factory bars3D() and the in-place mutator updateBars().
_buildBarsGeom(array<float> values, float barWidth, float barDepth, float spacing, color lowCol, color highCol, float maxHeight) =>
    int count = values.size()
    float totalWidth = float(count) * (barWidth + spacing) - spacing
    float originX = -totalWidth / 2.0
    // Find min/max for color grading (nz maps na to 0)
    float minVal = nz(values.get(0))
    float maxVal = minVal
    for i = 1 to count - 1
        float v = nz(values.get(i))
        minVal := math.min(minVal, v)
        maxVal := math.max(maxVal, v)
    float valRange = maxVal - minVal
    if valRange == 0.0
        valRange := 1.0
    float absMax = math.max(math.abs(maxVal), math.abs(minVal))
    float hScale = absMax > 1e-10 ? maxHeight / absMax : 1.0
    float hw = barWidth / 2.0
    float hd = barDepth / 2.0
    array<Vec3> verts    = array.new<Vec3>()
    array<Face> faces    = array.new<Face>()
    array<int>  faceEnds = array.new<int>()
    array<int>  vertEnds = array.new<int>()
    for i = 0 to count - 1
        float val = nz(values.get(i))
        float cx  = originX + float(i) * (barWidth + spacing) + hw
        float h   = math.max(math.abs(val) * hScale, NEAR_PLANE_EPSILON)
        float s   = val < 0 ? -1.0 : 1.0
        int   v0  = verts.size()
        // Bar verts baked at world position (cx, 0, 0)
        verts.push(Vec3.new(cx - hw, 0,     -hd))
        verts.push(Vec3.new(cx + hw, 0,     -hd))
        verts.push(Vec3.new(cx + hw, h * s, -hd))
        verts.push(Vec3.new(cx - hw, h * s, -hd))
        verts.push(Vec3.new(cx - hw, 0,      hd))
        verts.push(Vec3.new(cx + hw, 0,      hd))
        verts.push(Vec3.new(cx + hw, h * s,  hd))
        verts.push(Vec3.new(cx - hw, h * s,  hd))
        float t   = (val - minVal) / valRange
        color bCol = _colorLerp(lowCol, highCol, t)
        bool flip = val < 0
        // Faces: back, front, left, right, bottom-cap, top-cap. flip reverses winding for negative bars.
        _pushBarFace(faces, v0, 0, 3, 2, 1, bCol, flip)
        _pushBarFace(faces, v0, 5, 6, 7, 4, bCol, flip)
        _pushBarFace(faces, v0, 4, 7, 3, 0, bCol, flip)
        _pushBarFace(faces, v0, 1, 2, 6, 5, bCol, flip)
        _pushBarFace(faces, v0, 3, 7, 6, 2, bCol, flip)
        _pushBarFace(faces, v0, 0, 1, 5, 4, bCol, flip)
        // Register this bar as its own depth group (cumulative end indices)
        faceEnds.push(faces.size())
        vertEnds.push(verts.size())
    [verts, faces, faceEnds, vertEnds]

//@function Creates a 3D bar chart mesh from an array of values.
//          Each bar is a vertical cuboid along the Y axis, laid out along the X axis.
//          Colors are auto-graded by value. All bars are combined into one mesh.
//          Values are auto-normalized so the tallest bar equals maxHeight world units.
//          Faces: 6 per bar × number of values.
//          Add labels with the chainable `barLabels()` method - they refresh automatically when `updateBars()` runs.
//@param values    (array<float>) The data value of each bar
//@param barWidth  (float) Width of each bar
//@param barDepth  (float) Depth of each bar
//@param spacing   (float) Gap between bars. Default 4.0.
//@param lowCol    (color) Color for the lowest bar
//@param highCol   (color) Color for the highest bar
//@param maxHeight (float) World-space height of the tallest bar. All bars scaled proportionally. Default 100.
//@returns (Mesh) A combined bar chart mesh
export bars3D(array<float> values, float barWidth, float barDepth, float spacing = 4.0, color lowCol = #2196F3, color highCol = #FF5722, float maxHeight = 100.0) =>
    [verts, faces, faceEnds, vertEnds] = _buildBarsGeom(values, barWidth, barDepth, spacing, lowCol, highCol, maxHeight)
    Mesh m = _newMesh(verts, faces)
    m.drawMode := "poly"
    if values.size() > 1
        m._depthGroupFaceEnds := faceEnds
        m._depthGroupVertEnds := vertEnds
    m._barWidth    := barWidth
    m._barDepth    := barDepth
    m._barSpacing  := spacing
    m._barLowCol   := lowCol
    m._barHighCol  := highCol
    m._barMaxHeight := maxHeight
    m

//@function Updates a bars3D mesh in place with new values, preserving its position,
//          rotation, and scale. Use this to animate or refresh a persistent bars3D
//          mesh per bar without rebuilding the scene.
//          Style params (`barWidth`, `barDepth`, `spacing`, `lowCol`, `highCol`, `maxHeight`)
//          fall back to the values used at creation time when passed as na.
//          Any bar labels created by `barLabels()` have their positions refreshed automatically.
//          Value labels are auto-refreshed via `str.tostring(value)` unless `valLabels` is passed.
//          Pass `catLabels` to also update category-label texts.
//@param self      (Mesh) The bars3D mesh to mutate
//@param values    (array<float>) New data values
//@param barWidth  (float) Width of each bar. na = keep current.
//@param barDepth  (float) Depth of each bar. na = keep current.
//@param spacing   (float) Gap between bars. na = keep current.
//@param lowCol    (color) Color for the lowest bar. na = keep current.
//@param highCol   (color) Color for the highest bar. na = keep current.
//@param maxHeight (float) World-space height of the tallest bar. na = keep current.
//@param catLabels (array<string>) Optional new category-label texts (below bars). When omitted, existing texts are kept.
//@param valLabels (array<string>) Optional new value-label texts (above bars). When omitted and the mesh has
//                                 value labels, they are auto-refreshed via plain `str.tostring(value)`. Pass
//                                 your own pre-formatted array to control formatting.
//@returns (Mesh) Self for chaining
export method updateBars(Mesh self, array<float> values, float barWidth = na, float barDepth = na, float spacing = na, color lowCol = na, color highCol = na, float maxHeight = na, array<string> catLabels = na, array<string> valLabels = na) =>
    float _bw = _dN(barWidth,  self._barWidth,     10.0)
    float _bd = _dN(barDepth,  self._barDepth,     10.0)
    float _sp = _dN(spacing,   self._barSpacing,    4.0)
    color _lc = _dC(lowCol,    self._barLowCol,    #2196F3)
    color _hc = _dC(highCol,   self._barHighCol,   #FF5722)
    float _mh = _dN(maxHeight, self._barMaxHeight, 100.0)
    [verts, faces, faceEnds, vertEnds] = _buildBarsGeom(values, _bw, _bd, _sp, _lc, _hc, _mh)
    self.vertices := verts
    self.faces    := faces
    bool multi = values.size() > 1
    self._depthGroupFaceEnds := multi ? faceEnds : na
    self._depthGroupVertEnds := multi ? vertEnds : na
    self.invalidateCache()
    // Auto-refresh value labels with plain str.tostring(v) when caller didn't provide them.
    array<string> autoVals = valLabels
    if na(autoVals) and not na(self._barValueLabels)
        autoVals := array.new<string>()
        for v in values
            autoVals.push(str.tostring(nz(v)))
    _refreshBarLabels(self, catLabels, autoVals)
    self

//@function Creates a circle (equal-radius disc) on the XZ plane. Layer 2 wrapper for disc().
//          Default style is "wireframe". Use setStyle("solid") for a filled disc.
//          Faces: 1.
//@param radius (float) Circle radius
//@param seg (int) Number of vertices around the perimeter. More = smoother.
//@param col (color) Line/fill color
//@returns (Mesh) A circle with 1 face
export circle(float radius, int seg, color col) =>
    disc(radius, radius, seg, col)

//@function Chainable bar-label helper. Mirrors `gridLabels()` for bars3D meshes:
//          builds the same category + value labels as `barLabels()`, but queues them on
//          the mesh instead of adding to the scene immediately. They are drained into
//          the scene by `scene.add(mesh)`. Order of `barLabels()` and `scene.add(mesh)`
//          does not matter.
//          Calling bare (`mesh.barLabels()`) creates empty value-label slots that
//          `updateBars()` will fill via plain `str.tostring(value)` on the next call.
//@param self     (Mesh) This bars3D mesh (must have 8 vertices per bar)
//@param names    (array<string>) Category labels below each bar. Pass na to skip.
//@param values   (array<string>) Formatted value labels above each bar. Pass na to skip.
//@param col      (color) Label text color. Default white.
//@param nameSize (string) Size for category labels. Default "small".
//@param valSize  (string) Size for value labels. Default "tiny".
//@param gap      (float) Vertical gap between bar top/bottom and label. Default 5.0.
//@returns (Mesh) Self for chaining
export method barLabels(Mesh self, array<string> names = na, array<string> values = na, color col = color.white, string nameSize = "small", string valSize = "tiny", float gap = 5.0) =>
    array<string> resolved = values
    if na(values) and self.vertices.size() >= 8
        resolved := array.new<string>(int(self.vertices.size() / 8), "")
    array<Label3D> built = _buildBarLabels(self, names, resolved, col, nameSize, valSize, gap)
    if built.size() > 0
        if na(self._pendingLabels)
            self._pendingLabels := array.new<Label3D>()
        for lbl in built
            self._pendingLabels.push(lbl)
    self

// Camera basis vectors. Computed once per frame and reused across render() and wireGrid().
type _CamBasis
    Vec3 camPos
    Vec3 forward
    Vec3 right
    Vec3 up
    Vec3 eyePos
    float fov

// Computes camera basis from a Scene's camera. Call once per frame.
_camBasis(Scene scene) =>
    Vec3 camPos = scene.camera.position
    Vec3 camTgt = scene.camera.target
    float fov   = scene.camera.fov
    Vec3 forward = camTgt.sub(camPos).normalize()
    Vec3 worldUp = math.abs(forward.dot(Vec3.new(0.0, 1.0, 0.0))) > UP_VECTOR_DEGENERACY ? Vec3.new(0.0, 0.0, 1.0) : Vec3.new(0.0, 1.0, 0.0)
    Vec3 right   = forward.cross(worldUp).normalize()
    Vec3 up      = right.cross(forward)
    Vec3 eyePos  = camPos.sub(forward.scale(fov))
    _CamBasis.new(camPos, forward, right, up, eyePos, fov)

// Internal helper to clamp the per-bar X offset (in bar units) of a projected point.
// All drawings are emitted with xloc.bar_time so the historical buffer never has to grow
// to the requested bar index - but TradingView still caps drawings at ~500 bars to the
// right of the last bar, so we clamp the future side. The negative side is bounded
// loosely as a sanity guard; deep history offsets are safe under bar_time.
_clampOffset(int targetOffset) =>
    math.max(-4900, math.min(490, targetOffset))

// Projects a 3D world-space point through the camera basis.
// `baseTime` is `time + guiShift * barMs` precomputed once per render(). `barMs` is the
// chart's bar duration in ms - used to synthesize off-bar timestamps without consuming
// historical buffer slots. Returns [chart.point (time-based), camera-depth, visible-bool].
_projectPt(float wx, float wy, float wz, _CamBasis cb, int baseTime, int barMs, float yBase, float yScale) =>
    float relX = wx - cb.camPos.x
    float relY = wy - cb.camPos.y
    float relZ = wz - cb.camPos.z
    float cvz = relX * cb.forward.x + relY * cb.forward.y + relZ * cb.forward.z
    float denom = math.max(cvz + cb.fov, NEAR_PLANE_EPSILON)
    float sx = (relX * cb.right.x + relY * cb.right.y + relZ * cb.right.z) * cb.fov / denom
    float sy = (relX * cb.up.x + relY * cb.up.y + relZ * cb.up.z) * cb.fov / denom
    [chart.point.from_time(baseTime + _clampOffset(int(math.round(sx))) * barMs, sy * yScale + yBase), cvz, cvz > -cb.fov * BEHIND_CAMERA_FACTOR]

// Walks every edge of an undirected graph as a single path (DFS with backtracks).
// Returns the materialized world-space vertex sequence.
_dfsWalk(array<Vec3> pts, array<int> eA, array<int> eB, int maxDeg) =>
    int nodeCount = pts.size()
    int edgeCount = eA.size()
    array<int> deg = array.new<int>(nodeCount, 0)
    matrix<int> adjMat = matrix.new<int>(nodeCount, maxDeg, -1)
    matrix<int> adjEid = matrix.new<int>(nodeCount, maxDeg, -1)
    if edgeCount > 0
        for i = 0 to edgeCount - 1
            int a = eA.get(i)
            int b = eB.get(i)
            int da = deg.get(a)
            adjMat.set(a, da, b)
            adjEid.set(a, da, i)
            deg.set(a, da + 1)
            int db = deg.get(b)
            adjMat.set(b, db, a)
            adjEid.set(b, db, i)
            deg.set(b, db + 1)
    array<Vec3> path = array.new<Vec3>()
    if edgeCount > 0
        array<bool> eUsed = array.new<bool>(edgeCount, false)
        int startNode = -1
        for i = 0 to nodeCount - 1
            if deg.get(i) > 0
                startNode := i
                break
        if startNode >= 0
            array<int> stack = array.new<int>()
            stack.push(startNode)
            path.push(pts.get(startNode))
            while stack.size() > 0
                int cur = stack.get(stack.size() - 1)
                int nextNode = -1
                for j = 0 to deg.get(cur) - 1
                    if nextNode != -1
                        break
                    int eId = adjEid.get(cur, j)
                    if not eUsed.get(eId)
                        eUsed.set(eId, true)
                        nextNode := adjMat.get(cur, j)
                if nextNode != -1
                    stack.push(nextNode)
                    path.push(pts.get(nextNode))
                else
                    stack.pop()
                    if stack.size() > 0
                        path.push(pts.get(stack.get(stack.size() - 1)))
    path

// Sqrt-transparency compensation: offsets the visual overdraw caused by DFS backtracks
// so a 2x-overdrawn stroke renders close to the user's requested alpha.
_compTrans(color col) =>
    color.new(col, int(math.round(10.0 * math.sqrt(math.max(0.0, math.min(100.0, color.t(col)))))))

// Adds a subdivided rectangular face to a graph: splits the c00->c01 and c10->c11 edges
// into K+1 segments each and adds K interior cross-lines between corresponding subs.
// Returns [leftCol, rightCol] node-id arrays so the caller can stitch shared corners
// or add top/bottom cross edges as needed.
_addFace(array<Vec3> nodes, array<int> eA, array<int> eB, Vec3 c00, Vec3 c10, Vec3 c11, Vec3 c01, int K) =>
    array<int> leftIds = array.new<int>()
    array<int> rightIds = array.new<int>()
    for i = 0 to K + 1
        float t = float(i) / float(K + 1)
        leftIds.push(nodes.size())
        nodes.push(c00.lerp(c01, t))
        rightIds.push(nodes.size())
        nodes.push(c10.lerp(c11, t))
    for i = 0 to K
        eA.push(leftIds.get(i))
        eB.push(leftIds.get(i + 1))
        eA.push(rightIds.get(i))
        eB.push(rightIds.get(i + 1))
    for i = 1 to K
        eA.push(leftIds.get(i))
        eB.push(rightIds.get(i))
    [leftIds, rightIds]

//@function Adds a wireframe reference grid (XZ plane) to the scene as a single Polyline3D.
//          Uses a DFS walk over the grid's adjacency graph to visit every edge once,
//          producing one polyline that covers the entire grid. Depth-sorted by render().
//          Call once during setup OR after scene.clear() - repeated calls accumulate.
//@param scene (Scene) Scene to add the grid to
//@param w     (float) Total width of the grid (X)
//@param d     (float) Total depth of the grid (Z)
//@param divX  (int)   Divisions along X
//@param divZ  (int)   Divisions along Z
//@param col   (color) Grid line color
//@returns (Scene) Self for chaining
export wireGrid(Scene scene, float w, float d, int divX, int divZ, color col) =>
    int nx = divX + 1
    int nodeCount = nx * (divZ + 1)
    float hw = w / 2.0
    float hd = d / 2.0
    // Build node positions in world space
    array<Vec3> pts = array.new<Vec3>(nodeCount)
    for iz = 0 to divZ
        float pz = -hd + d * float(iz) / float(divZ)
        for ix = 0 to divX
            float px = -hw + w * float(ix) / float(divX)
            pts.set(iz * nx + ix, Vec3.new(px, 0.0, pz))
    // Build edge list (horizontal + vertical grid edges)
    array<int> eA = array.new<int>()
    array<int> eB = array.new<int>()
    for iz = 0 to divZ
        for ix = 0 to divX - 1
            int a = iz * nx + ix
            eA.push(a)
            eB.push(a + 1)
    for iz = 0 to divZ - 1
        for ix = 0 to divX
            int a = iz * nx + ix
            eA.push(a)
            eB.push(a + nx)
    // DFS walk + transparency compensation, materialize as a single polyline
    array<Vec3> path = _dfsWalk(pts, eA, eB, 4)
    if path.size() > 1
        scene.add(Polyline3D.new(path, _compTrans(col), color(na), 1, false))
    scene

// Internal: builds the contour box wireframe as a single Polyline3D. Returns na if the
// mesh has no _contourMeta. Used by contourBox() and the chainable gridBox() method.
_buildContourBoxPolyline(Mesh m, color col, int divs) =>
    Polyline3D result = na
    if not na(m._contourMeta)
        float h = m._contourMeta.size / 2.0
        float step = 2.0 * h / float(divs)
        int N = divs + 1
        int N2 = N * N
        // --- 1. Enumerate unique 3D nodes ---
        // Key = ix * N2 + iy * N + iz - deduped via map across shared face edges
        map<int, int> km = map.new<int, int>()
        array<float> nxA = array.new<float>()
        array<float> nyA = array.new<float>()
        array<float> nzA = array.new<float>()
        // Face params (bottom iy=0, left ix=0, back iz=0).
        //   U-axis is always X or Y (never Z); V-axis is always Y or Z (never X).
        //   So wzU and wxV are always zero and omitted from the math below.
        for fi = 0 to 2
            int uS    = fi == 1 ? N    : N2
            int vS    = fi == 2 ? N    : 1
            float wxU = fi == 1 ? 0.0  : step
            float wyU = fi == 1 ? step : 0.0
            float wyV = fi == 2 ? step : 0.0
            float wzV = fi == 2 ? 0.0  : step
            for v = 0 to divs
                for u = 0 to divs
                    int key = u * uS + v * vS
                    if not km.contains(key)
                        km.put(key, nxA.size())
                        nxA.push(-h + float(u) * wxU)
                        nyA.push(-h + float(u) * wyU + float(v) * wyV)
                        nzA.push(-h + float(v) * wzV)
        int nodeCount = nxA.size()
        // --- 2. Materialize world-space node positions ---
        array<Vec3> pts = array.new<Vec3>(nodeCount)
        for i = 0 to nodeCount - 1
            pts.set(i, Vec3.new(nxA.get(i), nyA.get(i), nzA.get(i)))
        // --- 3. Build edge list (deduped across shared face boundaries) ---
        array<int> eA = array.new<int>()
        array<int> eB = array.new<int>()
        map<int, bool> eSet = map.new<int, bool>()
        for fi = 0 to 2
            int uS = fi == 1 ? N : N2
            int vS = fi == 2 ? N : 1
            for v = 0 to divs
                for u = 0 to divs
                    int keyA = u * uS + v * vS
                    int idxA = km.get(keyA)
                    if u < divs
                        int idxB = km.get(keyA + uS)
                        int lo = math.min(idxA, idxB)
                        int hi = math.max(idxA, idxB)
                        int ek = lo * nodeCount + hi
                        if not eSet.contains(ek)
                            eSet.put(ek, true)
                            eA.push(lo)
                            eB.push(hi)
                    if v < divs
                        int idxC = km.get(keyA + vS)
                        int lo2 = math.min(idxA, idxC)
                        int hi2 = math.max(idxA, idxC)
                        int ek2 = lo2 * nodeCount + hi2
                        if not eSet.contains(ek2)
                            eSet.put(ek2, true)
                            eA.push(lo2)
                            eB.push(hi2)
        // --- 4. DFS walk + transparency compensation, materialize polyline ---
        array<Vec3> path = _dfsWalk(pts, eA, eB, 6)
        if path.size() > 1
            result := Polyline3D.new(path, _compTrans(col), color(na), 1, false)
    result

// Internal: builds all contour title + tick labels and registers tick refs on the meta
// so updateSurface() can refresh them. Returns the full array of Label3D objects (titles
// first, then ticks). Used by the chainable gridLabels() method.
_buildContourLabels(Mesh m, color col, string xName, string yName, string zName, int ticks, string fmt) =>
    array<Label3D> result = array.new<Label3D>()
    if not na(m._contourMeta)
        _ContourMeta cm = m._contourMeta
        float h   = cm.size / 2.0
        float s   = cm.size
        float pad = s * 0.12
        // X title - centred on lower-left edge, padded outward (+z, -y)
        Label3D lblX = Label3D.new(Vec3.new(0.0, -h - pad, h + pad), xName, col)
        result.push(lblX)
        // Y title - centred on vertical-right edge, padded outward (+x, -z)
        Label3D lblY = Label3D.new(Vec3.new(h + pad, 0.0, -h - pad), yName, col)
        result.push(lblY)
        // Z title - centred on lower-right edge, padded outward (+x, -y)
        Label3D lblZ = Label3D.new(Vec3.new(h + pad, -h - pad, 0.0), zName, col)
        result.push(lblZ)
        // Tick-value labels along each visible edge
        if ticks > 1 and not na(cm._dataXMin)
            float tp   = s * 0.04
            int   t1   = ticks - 1
            float dxMn = cm._dataXMin, float dxRn = cm._dataXMax - dxMn
            float dyMn = cm._dataYMin, float dyRn = cm._dataYMax - dyMn
            float dzMn = cm._dataZMin, float dzRn = cm._dataZMax - dzMn
            color tc = color.new(col, 30)
            // Track tick-label refs on the meta so updateSurface() can refresh them.
            array<Label3D> txArr = array.new<Label3D>()
            array<Label3D> tyArr = array.new<Label3D>()
            array<Label3D> tzArr = array.new<Label3D>()
            for i = 0 to t1
                float f = float(i) / float(t1)
                // X ticks - lower-left edge (z=+h, y=-h, x from +h to -h = xMin to xMax)
                Label3D tx = Label3D.new(Vec3.new(h - f * s, -h - tp, h + tp), str.tostring(dxMn + f * dxRn, fmt), tc, #00000000, label.style_text_outline, size.tiny)
                txArr.push(tx)
                result.push(tx)
                // Y ticks - vertical-right edge (x=+h, z=-h, y from -h to +h = yMin to yMax)
                Label3D ty = Label3D.new(Vec3.new(h + tp, -h + f * s, -h - tp), str.tostring(dyMn + f * dyRn, fmt), tc, #00000000, label.style_text_outline, size.tiny)
                tyArr.push(ty)
                result.push(ty)
                // Z ticks - lower-right edge (x=+h, y=-h, z from -h to +h = zMin to zMax)
                Label3D tz = Label3D.new(Vec3.new(h + tp, -h - tp, -h + f * s), str.tostring(dzMn + f * dzRn, fmt), tc, #00000000, label.style_text_outline, size.tiny)
                tzArr.push(tz)
                result.push(tz)
            cm._tickLabelsX := txArr
            cm._tickLabelsY := tyArr
            cm._tickLabelsZ := tzArr
            cm._tickFmt     := fmt
    result

//@function Adds a wireframe bounding-box cage around this contour mesh, chainable on the
//          mesh itself. The overlay is queued on the mesh and drained into the scene by
//          `scene.add(mesh)`. Order of `gridBox()` and `scene.add(mesh)` does not matter.
//@param self (Mesh)  This contour mesh
//@param col  (color) Grid line color
//@param divs (int)   Grid subdivisions per face axis. Default 8.
//@returns (Mesh) Self for chaining
export method gridBox(Mesh self, color col = #99999999, int divs = 8) =>
    Polyline3D pl = _buildContourBoxPolyline(self, col, divs)
    if not na(pl)
        if na(self._pendingPolylines)
            self._pendingPolylines := array.new<Polyline3D>()
        self._pendingPolylines.push(pl)
    self

//@function Adds axis titles + tick-value labels to this contour mesh's bounding box,
//          chainable on the mesh itself. The overlays are queued on the mesh and drained
//          into the scene by `scene.add(mesh)`. Tick label refs are stored on the mesh so
//          `updateSurface()` refreshes their text from new data ranges automatically -
//          titles and positions stay constant.
//@param self  (Mesh)  This contour mesh
//@param col   (color) Label text color. Default white.
//@param xName (string) Display name for X axis. Default "X".
//@param yName (string) Display name for Y axis. Default "Y".
//@param zName (string) Display name for Z axis. Default "Z".
//@param ticks (int)    Number of tick-value labels per axis. Default 5.
//@param fmt   (string) str.tostring format for tick values. Default "#.##".
//@returns (Mesh) Self for chaining
export method gridLabels(Mesh self, color col = color.white, string xName = "X", string yName = "Y", string zName = "Z", int ticks = 5, string fmt = "#.##") =>
    array<Label3D> built = _buildContourLabels(self, col, xName, yName, zName, ticks, fmt)
    if not na(built)
        if na(self._pendingLabels)
            self._pendingLabels := array.new<Label3D>()
        for lbl in built
            self._pendingLabels.push(lbl)
    self


// ============================================================================
// SECTION 7B: TRAIL3D - STREAMED 3D OSCILLATOR PRIMITIVE
// ============================================================================
//
// Streamed 3D polyline that travels along the X axis from right to left and
// deflects on Y (u) and Z (v) from a pair of caller-supplied component series.
// Owns four Polyline3D overlays drawn through the scene's polylines3D pipeline:
//
//   _trail  : the combined 3D path (travel, u, v)
//   _uProj  : vertical-component projection onto the back wall (Z = +h)
//   _vProj  : lateral-component projection onto the floor      (Y = -h)
//   _cage   : static wireframe of the back-wall + floor faces
//
// Normalization is per-component, expand-only auto-fit. Toggle a projection or
// cage by mutating its `.visible` field directly (e.g. `t._cage.visible := false`).

//@type A streamed 3D trajectory inside a bounding cube. Two component series
//      drive deflection from the travel axis; auto-projections onto the cube
//      walls visualize each component independently.
//@field position (Vec3)  Cube center in world space
//@field size     (float) Edge length of the bounding cube
//@field capacity (int)   Maximum samples retained (oldest drops on overflow)
//@field uSamples (array<float>) Buffered vertical-component samples
//@field vSamples (array<float>) Buffered lateral-component samples
export type Trail3D
    Vec3   position
    float  size
    int    capacity
    array<float> uSamples
    array<float> vSamples
    Polyline3D _trail
    Polyline3D _uProj
    Polyline3D _vProj
    Polyline3D _cage
    array<Label3D> _pendingLabels = na
    float  _uMin = na
    float  _uMax = na
    float  _vMin = na
    float  _vMax = na
    int    minSamples = 60
    bool   rollingBounds = true

// ----- Internal helpers -----

// Map a raw component value into [-h, +h]. Handles zero-range and na bounds.
_trailMap(float raw, float lo, float hi, float h) =>
    float rng = hi - lo
    rng <= 0 or na(rng) or na(raw) ? 0.0 : ((raw - lo) / rng) * (2.0 * h) - h

// Rebuild trail/projection polylines in-place from current samples + bounds.
// Cage grows leftward as samples accumulate (newest sample anchored at the right edge),
// and includes 4 internal horizontal subdivision lines on each face.
_buildTrailPolylines(Trail3D self) =>
    int n = self.uSamples.size()
    float h = self.size * 0.5
    Vec3  c = self.position
    array<Vec3> trailPts = self._trail.points
    array<Vec3> uPts     = self._uProj.points
    array<Vec3> vPts     = self._vProj.points
    array<Vec3> cagePts  = self._cage.points
    trailPts.clear()
    uPts.clear()
    vPts.clear()
    cagePts.clear()
    // Cage width: cube-shaped while n <= minSamples (samples stretched across the cube),
    // then grows rightward at a fixed dx (= size / (minSamples-1)) until capacity is hit.
    // Newest sample anchored at xL (renders on the right under typical camera framing).
    int   m  = math.max(self.minSamples, 2)
    float dx = self.size / float(m - 1)
    float xL = c.x - h
    float xR = n <= m ? c.x + h : xL + float(n - 1) * dx
    float sdx = n <= m ? self.size / float(math.max(n - 1, 1)) : dx
    if n >= 1
        float zWall  = c.z + h
        float yFloor = c.y - h
        for i = 0 to n - 1
            float t = xL + float(n - 1 - i) * sdx
            float u = _trailMap(self.uSamples.get(i), self._uMin, self._uMax, h)
            float v = _trailMap(self.vSamples.get(i), self._vMin, self._vMax, h)
            trailPts.push(Vec3.new(t, c.y + u, c.z + v))
            uPts.push(Vec3.new(t, c.y + u, zWall))
            vPts.push(Vec3.new(t, yFloor, c.z + v))
    // Cage: back wall (z=+h) + floor (y=-h), each subdivided into K=4 internal lines.
    int K = 4
    array<Vec3> nodes = array.new<Vec3>()
    array<int>  eA    = array.new<int>()
    array<int>  eB    = array.new<int>()
    [bwL, bwR] = _addFace(nodes, eA, eB,
      Vec3.new(xL, c.y - h, c.z + h), Vec3.new(xR, c.y - h, c.z + h),
      Vec3.new(xR, c.y + h, c.z + h), Vec3.new(xL, c.y + h, c.z + h), K)
    [flL, flR] = _addFace(nodes, eA, eB,
      Vec3.new(xL, c.y - h, c.z - h), Vec3.new(xR, c.y - h, c.z - h),
      Vec3.new(xR, c.y - h, c.z + h), Vec3.new(xL, c.y - h, c.z + h), K)
    int last = K + 1
    // Back wall bottom (= shared back-floor edge) + back wall top + floor front edge.
    eA.push(bwL.get(0))
    eB.push(bwR.get(0))
    eA.push(bwL.get(last))
    eB.push(bwR.get(last))
    eA.push(flL.get(0))
    eB.push(flR.get(0))
    // Zero-length bridges fuse the floor's back corners (spatially identical to the back
    // wall's bottom corners) into one connected component for DFS.
    eA.push(flL.get(last))
    eB.push(bwL.get(0))
    eA.push(flR.get(last))
    eB.push(bwR.get(0))
    for p in _dfsWalk(nodes, eA, eB, 4)
        cagePts.push(p)

//@function Creates a streamed 3D trail primitive. Returns the Trail3D so the caller
//          can chain `axisLabels()` and pass it to `scene.add(trail)`. The cage and
//          projection polylines derive their colors from `trailCol`. To toggle any
//          sub-polyline, set its `.visible` field directly (e.g. `t._cage.visible := false`).
//          The cage stays cube-shaped while `n <= minSamples` (samples stretched), then
//          grows leftward at a fixed per-sample width until `capacity` (hard-capped at 300).
//@param size       (float) Edge length of the bounding cube
//@param capacity   (int)   Max retained samples (oldest drops on overflow). Capped at 300. Default 300.
//@param trailCol   (color) Color of the combined 3D path. Default yellow.
//@param minSamples (int)   Sample count at which the cage reaches its cube width. Below this the cage stays cube-shaped and samples stretch across it. Default 60.
//@param rollingBounds (bool) When true (default), recomputes per-component min/max from the current sample window on every push so samples dropped via capacity overflow no longer influence normalization. When false, bounds are expand-only across the trail's lifetime.
//@returns (Trail3D) New trail. Pass to scene.add(trail) to register its polylines.
export trail3D(float size, int capacity = 300, color trailCol = #FFEB3B, int minSamples = 60, bool rollingBounds = true) =>
    color projCol = color.new(trailCol, 50)
    // Pre-compensated cage alpha so DFS backtrack overdraw renders close to target #99999930.
    color cageCol = #99999950
    Polyline3D trailPl = Polyline3D.new(array.new<Vec3>(), trailCol, color(na), 2, false, true, "")
    Polyline3D uPl     = Polyline3D.new(array.new<Vec3>(), projCol,  color(na), 1, false, true, "")
    Polyline3D vPl     = Polyline3D.new(array.new<Vec3>(), projCol,  color(na), 1, false, true, "")
    Polyline3D cagePl  = Polyline3D.new(array.new<Vec3>(), cageCol,  color(na), 1, false, true, "")
    Trail3D self = Trail3D.new(Vec3.new(0.0, 0.0, 0.0), size, math.min(capacity, 300), array.new<float>(), array.new<float>(), trailPl, uPl, vPl, cagePl)
    self.minSamples := minSamples
    self.rollingBounds := rollingBounds
    _buildTrailPolylines(self)
    self

//@function Adds a Trail3D's four sub-polylines (and any pending axis labels) to the scene.
//@param tr (Trail3D) The trail to register
//@returns (Scene) Self for chaining
export method add(Scene self, Trail3D tr) =>
    if na(self.polylines3D)
        self.polylines3D := array.new<Polyline3D>()
    self.polylines3D.push(tr._cage)
    self.polylines3D.push(tr._vProj)
    self.polylines3D.push(tr._uProj)
    self.polylines3D.push(tr._trail)
    if not na(tr._pendingLabels)
        if na(self.labels)
            self.labels := array.new<Label3D>()
        for lbl in tr._pendingLabels
            self.labels.push(lbl)
        tr._pendingLabels := na
    self

//@function Pushes one (u, v) sample to the trail. Oldest sample drops when capacity is
//          reached. Recomputes bounds and rebuilds the four polylines in place.
//@param u (float) Vertical-component value (Y axis deflection)
//@param v (float) Lateral-component value (Z axis deflection)
//@returns (Trail3D) Self for chaining
export method pushSample(Trail3D self, float u, float v) =>
    if self.uSamples.size() >= self.capacity
        self.uSamples.shift()
        self.vSamples.shift()
    self.uSamples.push(u)
    self.vSamples.push(v)
    if self.rollingBounds
        self._uMin := na
        self._uMax := na
        self._vMin := na
        self._vMax := na
        for i = 0 to self.uSamples.size() - 1
            float uu = self.uSamples.get(i)
            float vv = self.vSamples.get(i)
            if not na(uu)
                self._uMin := na(self._uMin) ? uu : math.min(self._uMin, uu)
                self._uMax := na(self._uMax) ? uu : math.max(self._uMax, uu)
            if not na(vv)
                self._vMin := na(self._vMin) ? vv : math.min(self._vMin, vv)
                self._vMax := na(self._vMax) ? vv : math.max(self._vMax, vv)
    else
        if not na(u)
            self._uMin := na(self._uMin) ? u : math.min(self._uMin, u)
            self._uMax := na(self._uMax) ? u : math.max(self._uMax, u)
        if not na(v)
            self._vMin := na(self._vMin) ? v : math.min(self._vMin, v)
            self._vMax := na(self._vMax) ? v : math.max(self._vMax, v)
    _buildTrailPolylines(self)
    self

//@function Adds three axis-end labels (travel / u / v) anchored to the cage corners.
//          Queued on the trail and drained into the scene by scene.add(trail).
//@param uName      (string) Label for the vertical-component axis (Y). Default "U".
//@param vName      (string) Label for the lateral-component axis (Z). Default "V".
//@param col        (color)  Text color. Default white.
//@returns (Trail3D) Self for chaining
export method axisLabels(Trail3D self, string uName = "U", string vName = "V", color col = color.white) =>
    float h   = self.size * 0.5
    float pad = self.size * 0.08
    Vec3  c   = self.position
    if na(self._pendingLabels)
        self._pendingLabels := array.new<Label3D>()
    self._pendingLabels.push(Label3D.new(Vec3.new(c.x - h - pad, c.y + h + pad, c.z + h),       uName, col, color(na)))
    self._pendingLabels.push(Label3D.new(Vec3.new(c.x - h - pad, c.y - h,       c.z - h - pad), vName, col, color(na)))
    self

//@function Toggles the bounding-cage polyline. Mirrors Mesh.gridBox() conceptually.
//@param show (bool) true to show, false to hide. Default true.
//@returns (Trail3D) Self for chaining
export method cage(Trail3D self, bool show = true) =>
    self._cage.visible := show
    self

//@function Sets the trail's cube center in world space. Mirrors Mesh.moveTo().
//@param x (float) X position
//@param y (float) Y position
//@param z (float) Z position
//@returns (Trail3D) Self for chaining
export method moveTo(Trail3D self, float x, float y, float z) =>
    self.position := Vec3.new(x, y, z)
    _buildTrailPolylines(self)
    self

//@function Hides every sub-polyline (trail, projections, cage). Mirrors Mesh.hide().
//@returns (Trail3D) Self for chaining
export method hide(Trail3D self) =>
    self._trail.visible := false
    self._uProj.visible := false
    self._vProj.visible := false
    self._cage.visible  := false
    self

//@function Shows every sub-polyline. Mirrors Mesh.show().
//@returns (Trail3D) Self for chaining
export method show(Trail3D self) =>
    self._trail.visible := true
    self._uProj.visible := true
    self._vProj.visible := true
    self._cage.visible  := true
    self


// ============================================================================
// SECTION 8: INTERNAL RENDER HELPERS (not exported)
// ============================================================================

// Returns 1 when two rails match in the same direction, -1 when reversed, 0 otherwise.
_railMatchDir(int a1x, float a1y, int a2x, float a2y,
  int b1x, float b1y, int b2x, float b2y) =>
    bool fwd = a1x == b1x and a1y == b1y and a2x == b2x and a2y == b2y
    bool rev = a1x == b2x and a1y == b2y and a2x == b1x and a2y == b1y
    fwd ? 1 : rev ? -1 : 0

// Returns true when two 2D line segments properly intersect (crossing, not touching).
// Uses the standard parametric intersection test. Strict inequalities exclude
// endpoint-contact from shared vertices between adjacent faces.
_segmentsIntersect(int a1x, float a1y, int a2x, float a2y,
  int b1x, float b1y, int b2x, float b2y) =>
    float d1x = float(a2x - a1x)
    float d1y = a2y - a1y
    float d2x = float(b2x - b1x)
    float d2y = b2y - b1y
    float crossVal = d1x * d2y - d1y * d2x
    if math.abs(crossVal) < 1e-10
        false
    else
        float ex = float(b1x - a1x)
        float ey = b1y - a1y
        float t = (ex * d2y - ey * d2x) / crossVal
        float u = (ex * d1y - ey * d1x) / crossVal
        t > 0.0 and t < 1.0 and u > 0.0 and u < 1.0

// Internal type for the render pipeline - a processed face ready for drawing.
type _DrawFace
    array<chart.point> pts
    color col
    float depth
    string style = "solid"
    bool closed = true
    string _drawMode = "linefill"
    // Overlay-specific references (na for mesh faces)
    Label3D  _label3d  = na
    Line3D   _line3d   = na
    Polyline3D _poly3d = na
    // Mesh-derived stroke styling (forwarded to polyline.new at draw time).
    int    lineWidth = 1
    string lineStyle = line.style_solid

// Lightweight descriptor for solid faces - defers chart.point materialization until after depth sort.
// Pass 1 stores unlit baseCol + stashed centroid/normal. Pass 3 overwrites col with lit color.
type _SolidDesc
    float depth
    color col                   // unlit base color (Pass 1); lit color after Pass 3
    array<int> vi               // reference to face vertex indices
    array<chart.point> screen   // reference to mesh's projected screen vertices
    array<float> sxVals         // reference to mesh projected X coordinates
    array<float> syVals         // reference to mesh projected Y coordinates
    float cx                    // world centroid X
    float cy                    // world centroid Y
    float cz                    // world centroid Z
    float nx                    // world normal X
    float ny                    // world normal Y
    float nz                    // world normal Z
    int   meshIdx               // index into scene.meshes for self-shadow filtering
    float camPlaneNx            // camera-space plane normal X
    float camPlaneNy            // camera-space plane normal Y
    float camPlaneNz            // camera-space plane normal Z
    float camPlaneNum           // plane numerator for sample-depth queries
    float sxMin                 // projected face min X
    float sxMax                 // projected face max X
    float syMin                 // projected face min Y
    float syMax                 // projected face max Y
    string drawMode = "linefill"  // "linefill" or "poly"
    int    lineWidth = 1          // stroke width forwarded to poly-fallback outline
    string lineStyle = line.style_solid // line style forwarded to poly-fallback outline


//@function Adjusts a color's brightness. Useful for manual lighting effects.
//@param c (color) Input color
//@param factor (float) Brightness multiplier (0.0 = black, 1.0 = unchanged)
//@returns (color) Adjusted color
export colorBrightness(color c, float factor) => color.rgb(math.min(COLOR_CHANNEL_MAX, int(color.r(c) * factor)), math.min(COLOR_CHANNEL_MAX, int(color.g(c) * factor)), math.min(COLOR_CHANNEL_MAX, int(color.b(c) * factor)), color.t(c))

// Ray-sphere occlusion test core. Returns [updatedVis, stop]. stop=true means caller can early-exit.
// Shared by _isShadowed (linear) and _isShadowedGrid (cell scan).
_raySphereOcclude(float vis, float bcjx, float bcjy, float bcjz, float rj,
  float px, float py, float pz, float dx, float dy, float dz, float maxDist) =>
    float result = vis
    bool stop = false
    float mx = bcjx - px
    float my = bcjy - py
    float mz = bcjz - pz
    float tProj = mx * dx + my * dy + mz * dz
    if tProj > 0.0 and tProj <= maxDist
        float distSq = mx * mx + my * my + mz * mz - tProj * tProj
        float rrSq = rj * rj
        if distSq < rrSq
            float occVis = math.max(0.0, (distSq / rrSq - 0.2) / 0.8)
            result := math.min(result, occVis)
            if result < 0.01
                result := 0.0
                stop := true
    [result, stop]

// Ray-sphere shadow test: returns true if any occluder mesh's bounding sphere blocks the
// ray from (px,py,pz) in direction (dx,dy,dz). Uses flat parallel arrays for speed.
_isShadowed(
  float px, float py, float pz,
  float dx, float dy, float dz,
  float maxDist,
  int selfMeshIdx, bool selfShadow,
  array<float> bcx, array<float> bcy, array<float> bcz, array<float> br,
  array<bool> isSolid
  ) =>
    float vis = 1.0
    int numOccluders = bcx.size()
    if numOccluders > 0
        int last = numOccluders - 1
        for j = 0 to last
            if j == selfMeshIdx and not selfShadow
                continue
            if not isSolid.get(j)
                continue
            [newVis, stop] = _raySphereOcclude(vis, bcx.get(j), bcy.get(j), bcz.get(j), br.get(j), px, py, pz, dx, dy, dz, maxDist)
            vis := newVis
            if stop
                break
    vis

_clampInt(int value, int low, int high) =>
    math.max(low, math.min(high, value))

// ----- Shadow Grid: light-space spatial hash for O(K) shadow queries -----
// For directional lights the shadow ray direction is constant, so projecting all mesh
// bounding spheres into the plane perpendicular to the light gives a 2-D spatial index.
// Shadow queries then check only the ~1-3 meshes in the query point's grid cell instead
// of all M meshes.  Build cost is O(M), per-query cost is O(K) where K << M.
int SHADOW_GRID_RES = 16

// Build shadow grid from mesh bounding spheres projected into light-perpendicular space.
// Returns: grid (map<int,int> cellKey->offset into flat cellMeshes), cellMeshes (flat list of
// mesh indices per cell), cellCounts (entries per cell), cellSize, gridRange.
// Encoding: each cell maps to a contiguous block in cellMeshes starting at cellOffsets[key].
// Since Pine maps can't hold arrays, we use a flat array + offset/count arrays:
//   cellStarts: map<int, int> - cell key -> start index in cellMeshes
//   cellCounts: map<int, int> - cell key -> number of meshes in that cell
_buildShadowGrid(
  Vec3 ld, Vec3 lightRight, Vec3 lightUp,
  array<float> bcx, array<float> bcy, array<float> bcz, array<float> br,
  array<bool> isSolid
  ) =>
    int gridRes = SHADOW_GRID_RES
    // First pass: compute grid range from bounding sphere extents
    float maxExtent = 0.0
    int numMeshes = bcx.size()
    if numMeshes > 0
        for j = 0 to numMeshes - 1
            if not isSolid.get(j)
                continue
            float cxj = bcx.get(j)
            float cyj = bcy.get(j)
            float czj = bcz.get(j)
            float rj  = br.get(j)
            float lr = cxj * lightRight.x + cyj * lightRight.y + czj * lightRight.z
            float lu = cxj * lightUp.x    + cyj * lightUp.y    + czj * lightUp.z
            float ext1 = math.abs(lr) + rj
            float ext2 = math.abs(lu) + rj
            if ext1 > maxExtent
                maxExtent := ext1
            if ext2 > maxExtent
                maxExtent := ext2
    float gridRange = maxExtent < 1.0 ? 1.0 : maxExtent * 1.05
    float cellSize  = 2.0 * gridRange / float(gridRes)
    // Precompute (r0,r1,u0,u1) per solid mesh so passes 2 & 3 don't re-project.
    array<int> sjIdx = array.new<int>()
    array<int> sR0 = array.new<int>()
    array<int> sR1 = array.new<int>()
    array<int> sU0 = array.new<int>()
    array<int> sU1 = array.new<int>()
    if numMeshes > 0
        for j = 0 to numMeshes - 1
            if not isSolid.get(j)
                continue
            float cxj = bcx.get(j)
            float cyj = bcy.get(j)
            float czj = bcz.get(j)
            float rj  = br.get(j)
            float lr = cxj * lightRight.x + cyj * lightRight.y + czj * lightRight.z
            float lu = cxj * lightUp.x    + cyj * lightUp.y    + czj * lightUp.z
            sjIdx.push(j)
            sR0.push(_clampInt(int(math.floor((lr - rj + gridRange) / cellSize)), 0, gridRes - 1))
            sR1.push(_clampInt(int(math.floor((lr + rj + gridRange) / cellSize)), 0, gridRes - 1))
            sU0.push(_clampInt(int(math.floor((lu - rj + gridRange) / cellSize)), 0, gridRes - 1))
            sU1.push(_clampInt(int(math.floor((lu + rj + gridRange) / cellSize)), 0, gridRes - 1))
    int solidCount = sjIdx.size()
    // Second pass: count how many meshes land in each cell
    map<int, int> cellCounts = map.new<int, int>()
    if solidCount > 0
        for k = 0 to solidCount - 1
            int r0 = sR0.get(k), int r1 = sR1.get(k)
            int u0 = sU0.get(k), int u1 = sU1.get(k)
            for gu = u0 to u1
                int row = gu * gridRes
                for gr = r0 to r1
                    int key = row + gr
                    cellCounts.put(key, nz(cellCounts.get(key), 0) + 1)
    // Allocate flat array with prefix-sum offsets
    array<int> cellKeys = cellCounts.keys()
    map<int, int> cellStarts = map.new<int, int>()
    int totalSlots = 0
    if cellKeys.size() > 0
        for i = 0 to cellKeys.size() - 1
            int key = cellKeys.get(i)
            cellStarts.put(key, totalSlots)
            totalSlots += cellCounts.get(key)
    array<int> cellMeshes = array.new<int>(totalSlots, 0)
    map<int, int> cellFill = map.new<int, int>()
    // Third pass: insert mesh indices into flat array
    if solidCount > 0
        for k = 0 to solidCount - 1
            int r0 = sR0.get(k), int r1 = sR1.get(k)
            int u0 = sU0.get(k), int u1 = sU1.get(k)
            int j  = sjIdx.get(k)
            for gu = u0 to u1
                int row = gu * gridRes
                for gr = r0 to r1
                    int key = row + gr
                    int startPos = cellStarts.get(key)
                    int filled   = nz(cellFill.get(key), 0)
                    cellMeshes.set(startPos + filled, j)
                    cellFill.put(key, filled + 1)
    [cellStarts, cellCounts, cellMeshes, cellSize, gridRange]

// Shadow query using the light-space spatial grid.
// Projects the query point into light-perpendicular space, looks up the single
// grid cell, and tests only the meshes registered there.
_isShadowedGrid(
  float px, float py, float pz,
  float dx, float dy, float dz,
  float maxDist,
  int selfMeshIdx, bool selfShadow,
  array<float> bcx, array<float> bcy, array<float> bcz, array<float> br,
  Vec3 lightRight, Vec3 lightUp,
  map<int, int> cellStarts, map<int, int> cellCountsMap, array<int> cellMeshes,
  float cellSize, float gridRange
  ) =>
    float vis = 1.0
    int gridRes = SHADOW_GRID_RES
    float lr = px * lightRight.x + py * lightRight.y + pz * lightRight.z
    float lu = px * lightUp.x    + py * lightUp.y    + pz * lightUp.z
    int gr = _clampInt(int(math.floor((lr + gridRange) / cellSize)), 0, gridRes - 1)
    int gu = _clampInt(int(math.floor((lu + gridRange) / cellSize)), 0, gridRes - 1)
    int key = gu * gridRes + gr
    if cellStarts.contains(key)
        int startPos = cellStarts.get(key)
        int count    = cellCountsMap.get(key)
        if count > 0
            for ci = 0 to count - 1
                int j = cellMeshes.get(startPos + ci)
                if j == selfMeshIdx and not selfShadow
                    continue
                [newVis, stop] = _raySphereOcclude(vis, bcx.get(j), bcy.get(j), bcz.get(j), br.get(j), px, py, pz, dx, dy, dz, maxDist)
                vis := newVis
                if stop
                    break
    vis

// Internal UDT for per-vertex adjacency list (wraps array since maps can't hold arrays)
type _AdjList
    array<int> edges

_wireHasUnusedEdge(array<_AdjList> adj, array<bool> edgeUsed, int vi) =>
    bool found = false
    if vi >= 0 and vi < adj.size()
        array<int> inc = adj.get(vi).edges
        if inc.size() > 0
            for i = 0 to inc.size() - 1
                if not edgeUsed.get(inc.get(i))
                    found := true
                    break
    found

_wireNextEdge(array<_AdjList> adj, array<int> edgeV1, array<int> edgeV2, array<bool> edgeUsed, int vi) =>
    int edgeIdx = -1
    if vi >= 0 and vi < adj.size()
        array<int> inc = adj.get(vi).edges
        if inc.size() > 0
            for i = 0 to inc.size() - 1
                int e = inc.get(i)
                if not edgeUsed.get(e)
                    edgeIdx := e
                    break
    edgeIdx

_wireBuildPath(Mesh mesh) =>
    array<int> edgeV1 = array.new<int>()
    array<int> edgeV2 = array.new<int>()
    int numVerts = mesh.vertices.size()
    array<int> wireDegree = array.new<int>(numVerts, 0)
    map<int, bool> edgeMap = map.new<int, bool>()
    array<_AdjList> adj = array.new<_AdjList>()
    for i = 0 to numVerts - 1
        adj.push(_AdjList.new(array.new<int>()))

    for face in mesh.faces
        if face.vi.size() < 2
            continue
        for k = 0 to face.vi.size() - 1
            int va = face.vi.get(k)
            int vb = face.vi.get((k + 1) % face.vi.size())
            int edgeLo = va < vb ? va : vb
            int edgeHi = va < vb ? vb : va
            int edgeKey = edgeLo * 100000 + edgeHi
            if not edgeMap.contains(edgeKey)
                edgeMap.put(edgeKey, true)
                int ei = edgeV1.size()
                edgeV1.push(edgeLo)
                edgeV2.push(edgeHi)
                adj.get(edgeLo).edges.push(ei)
                adj.get(edgeHi).edges.push(ei)
                wireDegree.set(edgeLo, wireDegree.get(edgeLo) + 1)
                wireDegree.set(edgeHi, wireDegree.get(edgeHi) + 1)

    array<int> wirePath = array.new<int>()
    if edgeV1.size() > 0
        int usedEdges = 0
        array<bool> edgeUsed = array.new<bool>(edgeV1.size(), false)
        while usedEdges < edgeV1.size()
            int startVi = -1
            for vi = 0 to wireDegree.size() - 1
                if wireDegree.get(vi) % 2 == 1 and _wireHasUnusedEdge(adj, edgeUsed, vi)
                    startVi := vi
                    break
            if startVi == -1
                for e = 0 to edgeV1.size() - 1
                    if not edgeUsed.get(e)
                        startVi := edgeV1.get(e)
                        break
            if startVi == -1
                break

            if wirePath.size() > 0
                wirePath.push(-1)

            array<int> stack = array.new<int>()
            stack.push(startVi)
            wirePath.push(startVi)

            while stack.size() > 0
                int currentVi = stack.get(stack.size() - 1)
                int nextEdge = _wireNextEdge(adj, edgeV1, edgeV2, edgeUsed, currentVi)
                if nextEdge != -1
                    edgeUsed.set(nextEdge, true)
                    usedEdges += 1
                    int nextVi = edgeV1.get(nextEdge) == currentVi ? edgeV2.get(nextEdge) : edgeV1.get(nextEdge)
                    stack.push(nextVi)
                    wirePath.push(nextVi)
                else
                    bool stackHasUnused = false
                    for si = 0 to stack.size() - 1
                        if _wireHasUnusedEdge(adj, edgeUsed, stack.get(si))
                            stackHasUnused := true
                            break
                    if stackHasUnused and stack.size() > 1
                        stack.pop()
                        wirePath.push(stack.get(stack.size() - 1))
                    else
                        break

    wirePath

_keepNearestSorted(array<int> sortedDesc, int maxFaces) =>
    array<int> kept = array.new<int>()
    if sortedDesc.size() > 0
        int skip = math.max(0, sortedDesc.size() - maxFaces)
        for i = skip to sortedDesc.size() - 1
            kept.push(sortedDesc.get(i))
    kept

// Internal: depth-buffer write for occlusion rasterizer. Returns true when this
// (cellKey, depth) won the per-cell test (used by centroid fallback to break early).
_writeDepth(map<int, float> depthMap, map<int, int> ownerMap, array<int> ownerCounts, int cellKey, float depth, int poolPos) =>
    bool wrote = false
    float prevDepth = nz(depthMap.get(cellKey), 1e10)
    if depth < prevDepth
        if prevDepth < 1e10
            int prevOwner = ownerMap.get(cellKey)
            ownerCounts.set(prevOwner, ownerCounts.get(prevOwner) - 1)
        depthMap.put(cellKey, depth)
        ownerMap.put(cellKey, poolPos)
        ownerCounts.set(poolPos, ownerCounts.get(poolPos) + 1)
        wrote := true
    wrote

_refinePoolSelection(array<_SolidDesc> solidList, array<int> poolSorted, int maxFaces, float fov, int rasterSize) =>
    int sampleCount = math.max(16, rasterSize)
    float occRange = fov
    float sampleSize = 2.0 * occRange / float(sampleCount)
    float negOcc = -occRange
    float negFov = -fov
    map<int, float> depthMap = map.new<int, float>()
    map<int, int> ownerMap = map.new<int, int>()
    array<int> ownerCounts = array.new<int>(poolSorted.size(), 0)
    if poolSorted.size() > 0
        for poolPos = poolSorted.size() - 1 to 0
            int solidIndex = poolSorted.get(poolPos)
            _SolidDesc sd = solidList.get(solidIndex)
            int pixelX0 = _clampInt(int(math.floor((sd.sxMin + occRange) / sampleSize)), 0, sampleCount - 1)
            int pixelX1 = _clampInt(int(math.floor((sd.sxMax + occRange) / sampleSize)), 0, sampleCount - 1)
            int pixelY0 = _clampInt(int(math.floor((sd.syMin + occRange) / sampleSize)), 0, sampleCount - 1)
            int pixelY1 = _clampInt(int(math.floor((sd.syMax + occRange) / sampleSize)), 0, sampleCount - 1)
            if pixelY1 >= pixelY0 and pixelX1 >= pixelX0
                // Pre-extract depth plane parameters (avoid UDT field access per pixel)
                float cpNx = sd.camPlaneNx
                float cpNy = sd.camPlaneNy
                float cpNzFov = sd.camPlaneNz * fov
                float cpNum = sd.camPlaneNum
                int vertCount = sd.vi.size()
                if vertCount == 3
                    // --- Triangle fast path: inlined point-in-polygon ---
                    int ti0 = sd.vi.get(0), int ti1 = sd.vi.get(1), int ti2 = sd.vi.get(2)
                    float tax0 = sd.sxVals.get(ti0), float tay0 = sd.syVals.get(ti0)
                    float tax1 = sd.sxVals.get(ti1), float tay1 = sd.syVals.get(ti1)
                    float tax2 = sd.sxVals.get(ti2), float tay2 = sd.syVals.get(ti2)
                    float tdx0 = tax1 - tax0, float tdy0 = tay1 - tay0
                    float tdx1 = tax2 - tax1, float tdy1 = tay2 - tay1
                    float tdx2 = tax0 - tax2, float tdy2 = tay0 - tay2
                    // Incremental step constants (linear in pixelX)
                    float tcs0 = -tdy0 * sampleSize
                    float tcs1 = -tdy1 * sampleSize
                    float tcs2 = -tdy2 * sampleSize
                    float denomStep = cpNx * sampleSize
                    float sampleX0 = negOcc + (float(pixelX0) + 0.5) * sampleSize
                    for pixelY = pixelY0 to pixelY1
                        float sampleY = negOcc + (float(pixelY) + 0.5) * sampleSize
                        int rowOffset = pixelY * sampleCount
                        float ryd0 = tdx0 * (sampleY - tay0)
                        float ryd1 = tdx1 * (sampleY - tay1)
                        float ryd2 = tdx2 * (sampleY - tay2)
                        float denomBase = cpNy * sampleY + cpNzFov
                        // Seed values at pixelX0
                        float c0 = ryd0 - tdy0 * (sampleX0 - tax0)
                        float c1 = ryd1 - tdy1 * (sampleX0 - tax1)
                        float c2 = ryd2 - tdy2 * (sampleX0 - tax2)
                        float denom = cpNx * sampleX0 + denomBase
                        for pixelX = pixelX0 to pixelX1
                            if ((c0 >= 0.0 and c1 >= 0.0 and c2 >= 0.0) or (c0 <= 0.0 and c1 <= 0.0 and c2 <= 0.0)) and
                              math.abs(denom) > NORMALIZE_EPSILON
                                float rayT = cpNum / denom
                                if rayT > 0.0
                                    _writeDepth(depthMap, ownerMap, ownerCounts, rowOffset + pixelX, negFov + fov * rayT, poolPos)
                            c0 += tcs0
                            c1 += tcs1
                            c2 += tcs2
                            denom += denomStep
                else if vertCount == 4
                    // --- Quad fast path: inlined point-in-polygon ---
                    int qi0 = sd.vi.get(0), int qi1 = sd.vi.get(1)
                    int qi2 = sd.vi.get(2), int qi3 = sd.vi.get(3)
                    float qx0 = sd.sxVals.get(qi0), float qy0 = sd.syVals.get(qi0)
                    float qx1 = sd.sxVals.get(qi1), float qy1 = sd.syVals.get(qi1)
                    float qx2 = sd.sxVals.get(qi2), float qy2 = sd.syVals.get(qi2)
                    float qx3 = sd.sxVals.get(qi3), float qy3 = sd.syVals.get(qi3)
                    float qdx0 = qx1 - qx0, float qdy0 = qy1 - qy0
                    float qdx1 = qx2 - qx1, float qdy1 = qy2 - qy1
                    float qdx2 = qx3 - qx2, float qdy2 = qy3 - qy2
                    float qdx3 = qx0 - qx3, float qdy3 = qy0 - qy3
                    // Incremental step constants (linear in pixelX)
                    float qcs0 = -qdy0 * sampleSize
                    float qcs1 = -qdy1 * sampleSize
                    float qcs2 = -qdy2 * sampleSize
                    float qcs3 = -qdy3 * sampleSize
                    float denomStep = cpNx * sampleSize
                    float sampleX0 = negOcc + (float(pixelX0) + 0.5) * sampleSize
                    for pixelY = pixelY0 to pixelY1
                        float sampleY = negOcc + (float(pixelY) + 0.5) * sampleSize
                        int rowOffset = pixelY * sampleCount
                        float ryd0 = qdx0 * (sampleY - qy0)
                        float ryd1 = qdx1 * (sampleY - qy1)
                        float ryd2 = qdx2 * (sampleY - qy2)
                        float ryd3 = qdx3 * (sampleY - qy3)
                        float denomBase = cpNy * sampleY + cpNzFov
                        // Seed values at pixelX0
                        float c0 = ryd0 - qdy0 * (sampleX0 - qx0)
                        float c1 = ryd1 - qdy1 * (sampleX0 - qx1)
                        float c2 = ryd2 - qdy2 * (sampleX0 - qx2)
                        float c3 = ryd3 - qdy3 * (sampleX0 - qx3)
                        float denom = cpNx * sampleX0 + denomBase
                        for pixelX = pixelX0 to pixelX1
                            if ((c0 >= 0.0 and c1 >= 0.0 and c2 >= 0.0 and c3 >= 0.0) or
                              (c0 <= 0.0 and c1 <= 0.0 and c2 <= 0.0 and c3 <= 0.0)) and
                              math.abs(denom) > NORMALIZE_EPSILON
                                float rayT = cpNum / denom
                                if rayT > 0.0
                                    _writeDepth(depthMap, ownerMap, ownerCounts, rowOffset + pixelX, negFov + fov * rayT, poolPos)
                            c0 += qcs0
                            c1 += qcs1
                            c2 += qcs2
                            c3 += qcs3
                            denom += denomStep
                else
                    // --- N-gon fallback: pre-extract coords to avoid double indirection ---
                    array<float> faceSx = array.new<float>(vertCount)
                    array<float> faceSy = array.new<float>(vertCount)
                    for vi = 0 to vertCount - 1
                        int idx = sd.vi.get(vi)
                        faceSx.set(vi, sd.sxVals.get(idx))
                        faceSy.set(vi, sd.syVals.get(idx))
                    for pixelY = pixelY0 to pixelY1
                        float sampleY = negOcc + (float(pixelY) + 0.5) * sampleSize
                        int rowOffset = pixelY * sampleCount
                        float denomBase = cpNy * sampleY + cpNzFov
                        for pixelX = pixelX0 to pixelX1
                            float sampleX = negOcc + (float(pixelX) + 0.5) * sampleSize
                            bool inside = vertCount >= 3
                            if inside
                                float winding = 0.0
                                for i = 0 to vertCount - 1
                                    float eax = faceSx.get(i)
                                    float eay = faceSy.get(i)
                                    int nextI = i + 1 < vertCount ? i + 1 : 0
                                    float ebx = faceSx.get(nextI)
                                    float eby = faceSy.get(nextI)
                                    float cross = (ebx - eax) * (sampleY - eay) - (eby - eay) * (sampleX - eax)
                                    if math.abs(cross) <= NORMALIZE_EPSILON
                                        continue
                                    if winding == 0.0
                                        winding := cross > 0.0 ? 1.0 : -1.0
                                    else if cross * winding < -NORMALIZE_EPSILON
                                        inside := false
                                        break
                            if not inside
                                continue
                            float denom = cpNx * sampleX + denomBase
                            if math.abs(denom) <= NORMALIZE_EPSILON
                                continue
                            float rayT = cpNum / denom
                            if rayT <= 0.0
                                continue
                            _writeDepth(depthMap, ownerMap, ownerCounts, rowOffset + pixelX, negFov + fov * rayT, poolPos)
                // Small projected faces can miss every cell center in the sparse raster.
                // Sample centroid + each vertex so visible caps/slivers survive.
                if ownerCounts.get(poolPos) == 0
                    float centroidSx = 0.0
                    float centroidSy = 0.0
                    for vi = 0 to vertCount - 1
                        int idx = sd.vi.get(vi)
                        centroidSx += sd.sxVals.get(idx)
                        centroidSy += sd.syVals.get(idx)
                    float invVertCount = 1.0 / float(vertCount)
                    // Try centroid first, then each vertex until one wins
                    for sampleIdx = 0 to vertCount
                        float sampleX = na
                        float sampleY = na
                        if sampleIdx == 0
                            sampleX := centroidSx * invVertCount
                            sampleY := centroidSy * invVertCount
                        else
                            int idx = sd.vi.get(sampleIdx - 1)
                            sampleX := sd.sxVals.get(idx)
                            sampleY := sd.syVals.get(idx)
                        int pixelX = _clampInt(int(math.floor((sampleX + occRange) / sampleSize)), 0, sampleCount - 1)
                        int pixelY = _clampInt(int(math.floor((sampleY + occRange) / sampleSize)), 0, sampleCount - 1)
                        float denom = cpNx * sampleX + cpNy * sampleY + cpNzFov
                        if math.abs(denom) > NORMALIZE_EPSILON
                            float rayT = cpNum / denom
                            if rayT > 0.0
                                if _writeDepth(depthMap, ownerMap, ownerCounts, pixelY * sampleCount + pixelX, negFov + fov * rayT, poolPos)
                                    break
    array<int> visiblePool = array.new<int>()
    if ownerCounts.size() > 0
        for poolPos = 0 to ownerCounts.size() - 1
            if ownerCounts.get(poolPos) > 0
                visiblePool.push(poolSorted.get(poolPos))
    _keepNearestSorted(visiblePool, maxFaces)

// ----- Contour terrain rendering helpers -----

// Internal wrapper for loop vertex indices (Pine doesn't allow array<array<int>>)
type _IntLoop
    array<int> vi

type _Point2
    float x
    float z



_contourPointRef(
  int pointId,
  _ContourCtx ctx
  ) =>
    int projId = pointId
    if pointId >= ctx.numVerts and pointId < ctx.numVerts + ctx.meshEdgeCount
        int edgeId = pointId - ctx.numVerts
        int prevProjId = ctx.prevUpperProjId.get(edgeId)
        if ctx.prevUpperProjEpoch.get(edgeId) == ctx.bandStamp - 1 and prevProjId != -1
            projId := prevProjId
        else
            if ctx.lowerProjEpoch.get(edgeId) != ctx.bandStamp
                projId := ctx.allSrcA.size()
                ctx.lowerProjId.set(edgeId, projId)
                ctx.lowerProjEpoch.set(edgeId, ctx.bandStamp)
                ctx.allSrcA.push(ctx.pointSrcA.get(pointId))
                ctx.allSrcB.push(ctx.pointSrcB.get(pointId))
                ctx.allSrcMix.push(ctx.pointSrcMix.get(pointId))
            else
                projId := ctx.lowerProjId.get(edgeId)
    else if pointId >= ctx.numVerts + ctx.meshEdgeCount
        int edgeId = pointId - ctx.numVerts - ctx.meshEdgeCount
        if ctx.upperProjEpoch.get(edgeId) != ctx.bandStamp
            projId := ctx.allSrcA.size()
            ctx.upperProjId.set(edgeId, projId)
            ctx.upperProjEpoch.set(edgeId, ctx.bandStamp)
            ctx.allSrcA.push(ctx.pointSrcA.get(pointId))
            ctx.allSrcB.push(ctx.pointSrcB.get(pointId))
            ctx.allSrcMix.push(ctx.pointSrcMix.get(pointId))
        else
            projId := ctx.upperProjId.get(edgeId)
    projId

_contourCacheFrag(array<int> pts, _ContourCtx ctx) =>
    int n = pts.size()
    if n >= 3
        ctx.fragStarts.push(ctx.allFragRefs.size())
        ctx.fragLens.push(n)
        for i = 0 to n - 1
            ctx.allFragRefs.push(_contourPointRef(pts.get(i), ctx))
    int(na)

// Specialized fast-path for the full-cell quad case (cell entirely inside band).
// Avoids the temporary array.from() allocation + 4 array.size()/get() calls
// in the dominant interior-cell emission path.
_contourCacheFragQuad(int v0, int v1, int v2, int v3, _ContourCtx ctx) =>
    ctx.fragStarts.push(ctx.allFragRefs.size())
    ctx.fragLens.push(4)
    ctx.allFragRefs.push(_contourPointRef(v0, ctx))
    ctx.allFragRefs.push(_contourPointRef(v1, ctx))
    ctx.allFragRefs.push(_contourPointRef(v2, ctx))
    ctx.allFragRefs.push(_contourPointRef(v3, ctx))
    int(na)

// Trace closed loops from the remaining oriented boundary edges.
// Flat linked-list adjacency with reusable epoch-stamped scratch arrays.
_contourTraceLoops(
  array<int> edgeStart,
  array<int> edgeEnd,
  array<bool> edgeAlive,
  array<int> headByStart,
  array<int> headEpoch,
  array<int> nextSameStart,
  array<int> edgeUsedEpoch,
  int traceEpoch
  ) =>
    int numEdges = edgeStart.size()
    array<_IntLoop> loops = array.new<_IntLoop>()
    for ei = 0 to (numEdges == 0 ? na : numEdges - 1)
        nextSameStart.set(ei, -1)
        if edgeAlive.get(ei)
            int sv = edgeStart.get(ei)
            int prevHead = headEpoch.get(sv) == traceEpoch ? headByStart.get(sv) : -1
            nextSameStart.set(ei, prevHead)
            headByStart.set(sv, ei)
            headEpoch.set(sv, traceEpoch)
    for startEi = 0 to (numEdges == 0 ? na : numEdges - 1)
        if not edgeAlive.get(startEi) or edgeUsedEpoch.get(startEi) == traceEpoch
            continue
        array<int> loop = array.new<int>()
        int curEi = startEi
        bool closedLoop = false
        while true
            if edgeUsedEpoch.get(curEi) == traceEpoch or not edgeAlive.get(curEi)
                break
            edgeUsedEpoch.set(curEi, traceEpoch)
            loop.push(edgeStart.get(curEi))
            int endV = edgeEnd.get(curEi)
            if endV == edgeStart.get(startEi)
                closedLoop := true
                break
            int nextEi = -1
            int candEi = headEpoch.get(endV) == traceEpoch ? headByStart.get(endV) : -1
            while candEi != -1
                if edgeAlive.get(candEi) and edgeUsedEpoch.get(candEi) != traceEpoch
                    nextEi := candEi
                    break
                candEi := nextSameStart.get(candEi)
            if nextEi == -1
                break
            curEi := nextEi
        if closedLoop and loop.size() >= 3
            loops.push(_IntLoop.new(loop))
    loops

// Compute intersection point ID on a mesh edge at a given threshold.
_contourCut(
  int edgeId,
  int vA,
  int vB,
  float thresholdY,
  bool useUpper,
  _ContourCtx ctx
  ) =>
    int pointId = ctx.numVerts + (useUpper ? ctx.meshEdgeCount : 0) + edgeId
    if pointId >= 0 and pointId < ctx.pointX.size() and ctx.pointEpoch.get(pointId) != ctx.bandStamp
        Vec3 a = ctx.localVerts.get(vA)
        Vec3 b = ctx.localVerts.get(vB)
        float denom = b.y - a.y
        float mix = math.abs(denom) < NORMALIZE_EPSILON ? 0.5 : math.max(0.0, math.min(1.0, (thresholdY - a.y) / denom))
        ctx.pointX.set(pointId, a.x + (b.x - a.x) * mix)
        ctx.pointY.set(pointId, thresholdY)
        ctx.pointZ.set(pointId, a.z + (b.z - a.z) * mix)
        ctx.pointSrcA.set(pointId, vA)
        ctx.pointSrcB.set(pointId, vB)
        ctx.pointSrcMix.set(pointId, mix)
        ctx.pointEpoch.set(pointId, ctx.bandStamp)
    pointId

// Clips a triangle to the [lowerY, upperY] band using edge-walk.
// Walks the 3 edges in order; at each threshold crossing emits a cut point,
// and emits any vertex that lies inside the band. Produces 3-5 point polygons
// identical to the former 27-case lookup.
_contourProcessBandTriangle(int v0, int v1, int v2, int edge01, int edge12, int edge20, float lowerY, float upperY, _ContourCtx ctx) =>
    float y0 = ctx.pointY.get(v0)
    float y1 = ctx.pointY.get(v1)
    float y2 = ctx.pointY.get(v2)
    int s0 = y0 < lowerY - NORMALIZE_EPSILON ? 0 : y0 > upperY + NORMALIZE_EPSILON ? 2 : 1
    int s1 = y1 < lowerY - NORMALIZE_EPSILON ? 0 : y1 > upperY + NORMALIZE_EPSILON ? 2 : 1
    int s2 = y2 < lowerY - NORMALIZE_EPSILON ? 0 : y2 > upperY + NORMALIZE_EPSILON ? 2 : 1
    if s0 == 0 and s1 == 0 and s2 == 0
        int(na)
    else if s0 == 2 and s1 == 2 and s2 == 2
        int(na)
    else
        array<int> poly = array.new<int>()
        if s0 < s1
            if s0 == 0
                poly.push(_contourCut(edge01, v0, v1, lowerY, false, ctx))
            if s1 == 1
                poly.push(v1)
            if s1 == 2
                poly.push(_contourCut(edge01, v0, v1, upperY, true, ctx))
        else if s0 > s1
            if s0 == 2
                poly.push(_contourCut(edge01, v0, v1, upperY, true, ctx))
            if s1 == 1
                poly.push(v1)
            if s1 == 0
                poly.push(_contourCut(edge01, v0, v1, lowerY, false, ctx))
        else if s1 == 1
            poly.push(v1)

        if s1 < s2
            if s1 == 0
                poly.push(_contourCut(edge12, v1, v2, lowerY, false, ctx))
            if s2 == 1
                poly.push(v2)
            if s2 == 2
                poly.push(_contourCut(edge12, v1, v2, upperY, true, ctx))
        else if s1 > s2
            if s1 == 2
                poly.push(_contourCut(edge12, v1, v2, upperY, true, ctx))
            if s2 == 1
                poly.push(v2)
            if s2 == 0
                poly.push(_contourCut(edge12, v1, v2, lowerY, false, ctx))
        else if s2 == 1
            poly.push(v2)

        if s2 < s0
            if s2 == 0
                poly.push(_contourCut(edge20, v2, v0, lowerY, false, ctx))
            if s0 == 1
                poly.push(v0)
            if s0 == 2
                poly.push(_contourCut(edge20, v2, v0, upperY, true, ctx))
        else if s2 > s0
            if s2 == 2
                poly.push(_contourCut(edge20, v2, v0, upperY, true, ctx))
            if s0 == 1
                poly.push(v0)
            if s0 == 0
                poly.push(_contourCut(edge20, v2, v0, lowerY, false, ctx))
        else if s0 == 1
            poly.push(v0)
        _contourCacheFrag(poly, ctx)

_contourLoopArea(array<int> loop, array<float> pointX, array<float> pointZ) =>
    float area = 0.0
    int n = loop.size()
    if n > 1
        for i = 0 to n - 1
            int next = i == n - 1 ? 0 : i + 1
            int a = loop.get(i)
            int b = loop.get(next)
            area += pointX.get(a) * pointZ.get(b) - pointZ.get(a) * pointX.get(b)
    area * 0.5

_contourOrientedLoop(array<int> srcLoop, bool wantPositive, float precomputedArea, array<float> pointX, array<float> pointZ) =>
    // Skip copy when orientation already matches - callers only iterate, never mutate
    bool isPositive = precomputedArea > 0.0
    array<int> out = isPositive == wantPositive ? srcLoop : array.copy(srcLoop)
    if isPositive != wantPositive
        array.reverse(out)
    out

_contourPointInLoop(float x, float z, array<int> loop, array<float> pointX, array<float> pointZ) =>
    bool inside = false
    int n = loop.size()
    if n > 1
        for i = 0 to n - 1
            int next = i == n - 1 ? 0 : i + 1
            int a = loop.get(i)
            int b = loop.get(next)
            float ax = pointX.get(a)
            float az = pointZ.get(a)
            float bx = pointX.get(b)
            float bz = pointZ.get(b)
            bool crosses = (az > z) != (bz > z)
            if crosses
                float xAtZ = ax + (z - az) * (bx - ax) / (bz - az)
                if xAtZ > x
                    inside := not inside
    inside

_contourAssignOuter(
  float sampleX,
  float sampleZ,
  array<_IntLoop> outerLoops,
  array<float> outerAreas,
  array<float> outerBboxMinX,
  array<float> outerBboxMaxX,
  array<float> outerBboxMinZ,
  array<float> outerBboxMaxZ,
  array<float> pointX,
  array<float> pointZ
  ) =>
    int bestOuter = -1
    float bestArea = 1e38
    int nOuterLoops = outerLoops.size()
    for oi = 0 to (nOuterLoops == 0 ? na : nOuterLoops - 1)
                // Tier 3: Bbox rejection before expensive ray-cast
        if sampleX < outerBboxMinX.get(oi) or sampleX > outerBboxMaxX.get(oi) or sampleZ < outerBboxMinZ.get(oi) or sampleZ > outerBboxMaxZ.get(oi)
            continue
        array<int> loop = outerLoops.get(oi).vi
        if _contourPointInLoop(sampleX, sampleZ, loop, pointX, pointZ)
            float areaAbs = outerAreas.get(oi)
            if areaAbs < bestArea
                bestArea := areaAbs
                bestOuter := oi
    bestOuter

_contourAnchorIndex(array<int> loop, array<float> pointX, array<float> pointZ) =>
    int bestIdx = 0
    float bestX = pointX.get(loop.get(0))
    float bestZ = pointZ.get(loop.get(0))
    int loopLen = loop.size()
    for i = 1 to loopLen - 1
        int pointId = loop.get(i)
        float x = pointX.get(pointId)
        float z = pointZ.get(pointId)
        if x > bestX or (x == bestX and z < bestZ)
            bestX := x
            bestZ := z
            bestIdx := i
    bestIdx

_contourNearestIndex(array<int> loop, float anchorX, float anchorZ, array<float> pointX, array<float> pointZ) =>
    int bestIdx = 0
    float bestDist = 1e38
    int loopLen = loop.size()
    for i = 0 to (loopLen == 0 ? na : loopLen - 1)
        int pointId = loop.get(i)
        float dx = pointX.get(pointId) - anchorX
        float dz = pointZ.get(pointId) - anchorZ
        float dist = dx * dx + dz * dz
        if dist < bestDist
            bestDist := dist
            bestIdx := i
    bestIdx

_contourLoopCentroid(array<int> loop, array<float> pointX, array<float> pointZ) =>
    float signedArea = 0.0
    float centroidX = 0.0
    float centroidZ = 0.0
    float avgX = 0.0
    float avgZ = 0.0
    int n = loop.size()
    if n > 0
        for i = 0 to n - 1
            int next = i == n - 1 ? 0 : i + 1
            int a = loop.get(i)
            int b = loop.get(next)
            float ax = pointX.get(a)
            float az = pointZ.get(a)
            float bx = pointX.get(b)
            float bz = pointZ.get(b)
            float cross = ax * bz - bx * az
            signedArea += cross
            centroidX += (ax + bx) * cross
            centroidZ += (az + bz) * cross
            avgX += ax
            avgZ += az
    if math.abs(signedArea) > NORMALIZE_EPSILON
        float invArea = 1.0 / (3.0 * signedArea)
        _Point2.new(centroidX * invArea, centroidZ * invArea)
    else
        float invN = n > 0 ? 1.0 / float(n) : 0.0
        _Point2.new(avgX * invN, avgZ * invN)

// ----- Screen-space contour union helpers -----

_contourCross2D(float ax, float ay, float bx, float bY) =>
    ax * bY - ay * bx

_contourDot2D(float ax, float ay, float bx, float bY) =>
    ax * bx + ay * bY

// Integer coordinate key for screen-point deduplication.
// Quantizes to a CONTOUR_SNAP_SCALE grid (cell size = 1 / CONTOUR_SNAP_SCALE).
_contourIntKey2(float x, float y) =>
    int(math.round(x * CONTOUR_SNAP_SCALE)) * CONTOUR_SNAP_OFFSET + int(math.round(y * CONTOUR_SNAP_SCALE))

_contourAppendUniqueSplit(int segId, float t, array<int> splitHead, array<float> splitTVal, array<int> splitNext) =>
    int cur = splitHead.get(segId)
    while cur != -1
        if math.abs(splitTVal.get(cur) - t) <= CONTOUR_SCREEN_EPSILON
            break
        cur := splitNext.get(cur)
    if cur == -1
        int newIdx = splitTVal.size()
        splitTVal.push(t)
        splitNext.push(splitHead.get(segId))
        splitHead.set(segId, newIdx)
    int(na)

_contourCollectSegSplitParams(
  int segA,
  int segB,
  float a0x,
  float a0y,
  float a1x,
  float a1y,
  float b0x,
  float b0y,
  float b1x,
  float b1y,
  array<int> splitHead,
  array<float> splitTVal,
  array<int> splitNext
  ) =>
    float ax = a1x - a0x
    float ay = a1y - a0y
    float bx = b1x - b0x
    float bY = b1y - b0y
    float qpx = b0x - a0x
    float qpy = b0y - a0y
    float rxs = _contourCross2D(ax, ay, bx, bY)
    float qpxr = _contourCross2D(qpx, qpy, ax, ay)
    if math.abs(rxs) <= CONTOUR_SCREEN_EPSILON and math.abs(qpxr) <= CONTOUR_SCREEN_EPSILON
        float rr = _contourDot2D(ax, ay, ax, ay)
        float ss = _contourDot2D(bx, bY, bx, bY)
        if rr > CONTOUR_SCREEN_EPSILON and ss > CONTOUR_SCREEN_EPSILON
            float t0 = _contourDot2D(b0x - a0x, b0y - a0y, ax, ay) / rr
            float t1 = _contourDot2D(b1x - a0x, b1y - a0y, ax, ay) / rr
            float u0 = _contourDot2D(a0x - b0x, a0y - b0y, bx, bY) / ss
            float u1 = _contourDot2D(a1x - b0x, a1y - b0y, bx, bY) / ss
            float loT = math.max(0.0, math.min(t0, t1))
            float hiT = math.min(1.0, math.max(t0, t1))
            float loU = math.max(0.0, math.min(u0, u1))
            float hiU = math.min(1.0, math.max(u0, u1))
            if hiT - loT > CONTOUR_SCREEN_EPSILON and hiU - loU > CONTOUR_SCREEN_EPSILON
                _contourAppendUniqueSplit(segA, loT, splitHead, splitTVal, splitNext)
                _contourAppendUniqueSplit(segA, hiT, splitHead, splitTVal, splitNext)
                _contourAppendUniqueSplit(segB, loU, splitHead, splitTVal, splitNext)
                _contourAppendUniqueSplit(segB, hiU, splitHead, splitTVal, splitNext)
    else if math.abs(rxs) > CONTOUR_SCREEN_EPSILON
        float t = _contourCross2D(qpx, qpy, bx, bY) / rxs
        float u = _contourCross2D(qpx, qpy, ax, ay) / rxs
        if t >= -CONTOUR_SCREEN_EPSILON and t <= 1.0 + CONTOUR_SCREEN_EPSILON and u >= -CONTOUR_SCREEN_EPSILON and u <= 1.0 + CONTOUR_SCREEN_EPSILON
            _contourAppendUniqueSplit(segA, math.max(0.0, math.min(1.0, t)), splitHead, splitTVal, splitNext)
            _contourAppendUniqueSplit(segB, math.max(0.0, math.min(1.0, u)), splitHead, splitTVal, splitNext)
    int(na)

_ensureExplicit(int segId, array<int> splitHead, array<float> splitTVal, array<int> splitNext) =>
    if splitHead.get(segId) == -1
        int idx0 = splitTVal.size()
        splitTVal.push(0.0)
        splitNext.push(-1)
        int idx1 = splitTVal.size()
        splitTVal.push(1.0)
        splitNext.push(idx0)
        splitHead.set(segId, idx1)
    int(na)

_contourInlineContains(float sx, float sy, int owner, bool seedOnly, int bandFragStart, int bandFragCount, int gridDim, int gdMax, float bandMinX, float bandMinY, float invStepX, float invStepY, array<int> cellCountArr, array<int> cellHead, array<int> cellFragId, array<int> cellFragNext, array<float> fragMinX, array<float> fragMaxX, array<float> fragMinY, array<float> fragMaxY, array<int> cFragStarts, array<int> cFragLens, array<int> cFragPointRef, array<float> cProjSx, array<float> cProjSy) =>
    bool inside = false
    if gridDim > 1
        int cxi = int((sx - bandMinX) * invStepX)
        if cxi < 0
            cxi := 0
        else if cxi > gdMax
            cxi := gdMax
        int cyi = int((sy - bandMinY) * invStepY)
        if cyi < 0
            cyi := 0
        else if cyi > gdMax
            cyi := gdMax
        int cellIdx = cxi * gridDim + cyi
        int cellCount = cellCountArr.get(cellIdx)
        bool skipOwnerOnly = seedOnly and cellCount == 1
        if not skipOwnerOnly
            int node = cellHead.get(cellIdx)
            while node != -1
                int localFrag = cellFragId.get(node)
                node := cellFragNext.get(node)
                if seedOnly and localFrag == owner
                    continue
                if sx < fragMinX.get(localFrag) or sx > fragMaxX.get(localFrag) or sy < fragMinY.get(localFrag) or sy > fragMaxY.get(localFrag)
                    continue
                int fragIdx2 = bandFragStart + localFrag
                int fStart = cFragStarts.get(fragIdx2)
                int fLen = cFragLens.get(fragIdx2)
                if fLen < 2
                    continue
                int prevRef2 = cFragPointRef.get(fStart + fLen - 1)
                float ax2 = cProjSx.get(prevRef2)
                float ay2 = cProjSy.get(prevRef2)
                for offset = 0 to fLen - 1
                    int bRef2 = cFragPointRef.get(fStart + offset)
                    float bx2 = cProjSx.get(bRef2)
                    float by2 = cProjSy.get(bRef2)
                    if (ay2 > sy) != (by2 > sy)
                        float xAtY = ax2 + (sy - ay2) * (bx2 - ax2) / (by2 - ay2 + 1e-12)
                        if xAtY > sx
                            inside := not inside
                    ax2 := bx2
                    ay2 := by2
                if inside
                    break
    else
        for localFrag = 0 to (bandFragCount == 0 ? na : bandFragCount - 1)
            if seedOnly and localFrag == owner
                continue
            if sx < fragMinX.get(localFrag) or sx > fragMaxX.get(localFrag) or sy < fragMinY.get(localFrag) or sy > fragMaxY.get(localFrag)
                continue
            int fragIdx2 = bandFragStart + localFrag
            int fStart = cFragStarts.get(fragIdx2)
            int fLen = cFragLens.get(fragIdx2)
            if fLen < 2
                continue
            int prevRef2 = cFragPointRef.get(fStart + fLen - 1)
            float ax2 = cProjSx.get(prevRef2)
            float ay2 = cProjSy.get(prevRef2)
            for offset = 0 to fLen - 1
                int bRef2 = cFragPointRef.get(fStart + offset)
                float bx2 = cProjSx.get(bRef2)
                float by2 = cProjSy.get(bRef2)
                if (ay2 > sy) != (by2 > sy)
                    float xAtY = ax2 + (sy - ay2) * (bx2 - ax2) / (by2 - ay2 + 1e-12)
                    if xAtY > sx
                        inside := not inside
                ax2 := bx2
                ay2 := by2
            if inside
                break
    inside

// Quantize to a CONTOUR_SNAP_SCALE grid, then scan the 3x3 neighbourhood so
// coincident points that land just across a cell boundary still snap together
// (within CONTOUR_SNAP_EPSILON). This avoids a single missed vertex merge that
// would otherwise break closed-loop tracing at perspective-sensitive frames.
_contourFindOrAddScreenPoint(float x, float y, array<float> pointX, array<float> pointY, map<int, int> pointMap) =>
    int ix = int(math.round(x * CONTOUR_SNAP_SCALE))
    int iy = int(math.round(y * CONTOUR_SNAP_SCALE))
    // Fast path: check primary cell with half-snap threshold before full 3x3 scan
    int primaryKey = ix * CONTOUR_SNAP_OFFSET + iy
    int primaryCand = nz(pointMap.get(primaryKey), -1)
    int pointId = -1
    if primaryCand != -1
        float pdx = pointX.get(primaryCand) - x
        float pdy = pointY.get(primaryCand) - y
        if pdx * pdx + pdy * pdy <= CONTOUR_SNAP_EPSILON_SQ_HALF
            pointId := primaryCand
    // Full 3×3 scan only if primary cell didn't match closely enough
    if pointId == -1
        int bestId = -1
        float bestDsq = CONTOUR_SNAP_EPSILON_SQ
        for dix = -1 to 1
            int baseKey = (ix + dix) * CONTOUR_SNAP_OFFSET
            for diy = -1 to 1
                int probe = baseKey + (iy + diy)
                int cand = nz(pointMap.get(probe), -1)
                if cand != -1
                    float dx = pointX.get(cand) - x
                    float dy = pointY.get(cand) - y
                    float dsq = dx * dx + dy * dy
                    if dsq <= bestDsq
                        bestDsq := dsq
                        bestId := cand
        pointId := bestId
    if pointId == -1
        pointId := pointX.size()
        pointX.push(x)
        pointY.push(y)
        pointMap.put(ix * CONTOUR_SNAP_OFFSET + iy, pointId)
    pointId

// Registers one (aRef -> bRef) edge into the canonical-edge group table.
// Called twice in the fragment-scan pass-2 below (per-offset + closing edge).
_contourRegisterEdge(int aRef, int bRef, float aX, float aY, float bX, float bY,
  int localFrag, bool isPositive,
  array<float> edgeCanAx, array<float> edgeCanAy, array<float> edgeCanBx, array<float> edgeCanBy,
  array<bool> edgeHasPos, array<bool> edgeHasNeg, array<int> edgeOwnerFrag,
  map<int, int> edgeGroupMap) =>
    float dx = bX - aX
    float dy = bY - aY
    if dx * dx + dy * dy > CONTOUR_SCREEN_EPSILON_SQ
        bool forward = aX < bX - CONTOUR_SCREEN_EPSILON or (math.abs(aX - bX) <= CONTOUR_SCREEN_EPSILON and aY < bY - CONTOUR_SCREEN_EPSILON)
        bool hasPos = forward ? isPositive : not isPositive
        int loRef = math.min(aRef, bRef)
        int hiRef = math.max(aRef, bRef)
        int edgeKey = loRef * 100000 + hiRef
        int groupIdx = nz(edgeGroupMap.get(edgeKey), -1)
        if groupIdx == -1
            groupIdx := edgeHasPos.size()
            edgeGroupMap.put(edgeKey, groupIdx)
            if forward
                edgeCanAx.push(aX)
                edgeCanAy.push(aY)
                edgeCanBx.push(bX)
                edgeCanBy.push(bY)
            else
                edgeCanAx.push(bX)
                edgeCanAy.push(bY)
                edgeCanBx.push(aX)
                edgeCanBy.push(aY)
            edgeHasPos.push(false)
            edgeHasNeg.push(false)
            edgeOwnerFrag.push(localFrag)
        if hasPos
            edgeHasPos.set(groupIdx, true)
        else
            edgeHasNeg.set(groupIdx, true)
    int(na)

// Emits one boundary segment: degeneracy check, perpendicular midpoint sample,
// containment test, dedup endpoints, push to boundary. Called twice in the boundary
// phase below (seed-only branch + sub-segment loop).
_contourEmitBoundarySeg(float p0x, float p0y, float p1x, float p1y,
  int owner, bool seedOnly,
  int bandFragStart, int bandFragCount, int gridDim, int gdMax,
  float bandMinX, float bandMinY, float invStepX, float invStepY,
  array<int> cellCountArr, array<int> cellHead, array<int> cellFragId, array<int> cellFragNext,
  array<float> fragMinX, array<float> fragMaxX, array<float> fragMinY, array<float> fragMaxY,
  array<int> cFragStarts, array<int> cFragLens, array<int> cFragPointRef,
  array<float> cProjSx, array<float> cProjSy,
  array<float> screenPointX, array<float> screenPointY, map<int, int> screenPointMap,
  array<int> boundaryStart, array<int> boundaryEnd, array<bool> boundaryAlive) =>
    float dx = p1x - p0x
    float dy = p1y - p0y
    float segLenSq = dx * dx + dy * dy
    if segLenSq > CONTOUR_SCREEN_EPSILON_SQ
        float invLen = 1.0 / math.sqrt(segLenSq)
        float midX = (p0x + p1x) * 0.5
        float midY = (p0y + p1y) * 0.5
        float sx = midX + dy * invLen * CONTOUR_SAMPLE_EPSILON
        float sy = midY - dx * invLen * CONTOUR_SAMPLE_EPSILON
        bool inside = _contourInlineContains(sx, sy, owner, seedOnly, bandFragStart, bandFragCount, gridDim, gdMax, bandMinX, bandMinY, invStepX, invStepY, cellCountArr, cellHead, cellFragId, cellFragNext, fragMinX, fragMaxX, fragMinY, fragMaxY, cFragStarts, cFragLens, cFragPointRef, cProjSx, cProjSy)
        if not inside
            int startId = _contourFindOrAddScreenPoint(p0x, p0y, screenPointX, screenPointY, screenPointMap)
            int endId   = _contourFindOrAddScreenPoint(p1x, p1y, screenPointX, screenPointY, screenPointMap)
            if startId != endId
                boundaryStart.push(startId)
                boundaryEnd.push(endId)
                boundaryAlive.push(true)
    int(na)

_contourBuildScreenUnionLoops(int bandFragStart, int bandFragCount, _ContourMeta meta) =>
    array<float> fragMinX = array.new<float>(bandFragCount, 0.0)
    array<float> fragMaxX = array.new<float>(bandFragCount, 0.0)
    array<float> fragMinY = array.new<float>(bandFragCount, 0.0)
    array<float> fragMaxY = array.new<float>(bandFragCount, 0.0)
    array<float> edgeCanAx = array.new<float>()
    array<float> edgeCanAy = array.new<float>()
    array<float> edgeCanBx = array.new<float>()
    array<float> edgeCanBy = array.new<float>()
    array<bool> edgeHasPos = array.new<bool>()
    array<bool> edgeHasNeg = array.new<bool>()
    array<int> edgeOwnerFrag = array.new<int>()
    map<int, int> edgeGroupMap = map.new<int, int>()

    // Hoist UDT field refs for fragment extraction
    array<int>   eFragStarts   = meta._cacheFragStarts
    array<int>   eFragLens     = meta._cacheFragLens
    array<int>   eFragPointRef = meta._cacheFragPointRef
    array<float> eProjSx       = meta._cacheProjSx
    array<float> eProjSy       = meta._cacheProjSy
    float bandMinX = 1e38
    float bandMaxX = -1e38
    float bandMinY = 1e38
    float bandMaxY = -1e38

    // Two-pass fragment scan with immediate has_pos resolution.
    for localFrag = 0 to (bandFragCount == 0 ? na : bandFragCount - 1)
        int fragIdx = bandFragStart + localFrag
        int fragStart = eFragStarts.get(fragIdx)
        int fragLen = eFragLens.get(fragIdx)
        if fragLen <= 1
            continue
        int firstRef = eFragPointRef.get(fragStart)
        float firstX = eProjSx.get(firstRef)
        float firstY = eProjSy.get(firstRef)
        int prevRef = firstRef
        float prevX = firstX
        float prevY = firstY
        float minX = firstX
        float maxX = firstX
        float minY = firstY
        float maxY = firstY
        float signedArea = 0.0
        
        // Pass 1: Compute signedArea and bounding box
        for offset = 1 to fragLen - 1
            int bRef = eFragPointRef.get(fragStart + offset)
            float bx = eProjSx.get(bRef)
            float bY = eProjSy.get(bRef)
            signedArea += prevX * bY - bx * prevY
            if bx < minX
                minX := bx
            else if bx > maxX
                maxX := bx
            if bY < minY
                minY := bY
            else if bY > maxY
                maxY := bY
            prevX := bx
            prevY := bY
        signedArea += prevX * firstY - firstX * prevY

        fragMinX.set(localFrag, minX)
        fragMaxX.set(localFrag, maxX)
        fragMinY.set(localFrag, minY)
        fragMaxY.set(localFrag, maxY)
        if minX < bandMinX
            bandMinX := minX
        if maxX > bandMaxX
            bandMaxX := maxX
        if minY < bandMinY
            bandMinY := minY
        if maxY > bandMaxY
            bandMaxY := maxY

        // Pass 2: Edge walk with immediate has_pos resolution
        bool isPositive = signedArea > 0.0
        prevRef := firstRef
        prevX := firstX
        prevY := firstY
        for offset = 1 to fragLen - 1
            int bRef = eFragPointRef.get(fragStart + offset)
            float bx = eProjSx.get(bRef)
            float bY = eProjSy.get(bRef)
            _contourRegisterEdge(prevRef, bRef, prevX, prevY, bx, bY, localFrag, isPositive,
              edgeCanAx, edgeCanAy, edgeCanBx, edgeCanBy,
              edgeHasPos, edgeHasNeg, edgeOwnerFrag, edgeGroupMap)
            prevRef := bRef
            prevX := bx
            prevY := bY
        // Closing edge
        _contourRegisterEdge(prevRef, firstRef, prevX, prevY, firstX, firstY, localFrag, isPositive,
          edgeCanAx, edgeCanAy, edgeCanBx, edgeCanBy,
          edgeHasPos, edgeHasNeg, edgeOwnerFrag, edgeGroupMap)

    // Cancel + pack
    array<float> segAx = array.new<float>()
    array<float> segAy = array.new<float>()
    array<float> segBx = array.new<float>()
    array<float> segBy = array.new<float>()
    array<int> segOwnerFrag = array.new<int>()
    int edgeCanCount = edgeCanAx.size()
    for i = 0 to (edgeCanCount == 0 ? na : edgeCanCount - 1)
        bool hasPos = edgeHasPos.get(i)
        bool hasNeg = edgeHasNeg.get(i)
        if hasPos and hasNeg
            continue
        if hasPos
            segAx.push(edgeCanAx.get(i))
            segAy.push(edgeCanAy.get(i))
            segBx.push(edgeCanBx.get(i))
            segBy.push(edgeCanBy.get(i))
        else
            segAx.push(edgeCanBx.get(i))
            segAy.push(edgeCanBy.get(i))
            segBx.push(edgeCanAx.get(i))
            segBy.push(edgeCanAy.get(i))
        segOwnerFrag.push(edgeOwnerFrag.get(i))

    int segCount = segAx.size()
    // Lazy split heads - no eager seeding (ensure_explicit on real intersect only)
    array<int> splitHead = array.new<int>(segCount, -1)
    array<float> splitTVal = array.new<float>()
    array<int> splitNext = array.new<int>()
    // Precompute per-segment bboxes and snap keys
    array<float> segMinX = array.new<float>(segCount)
    array<float> segMaxX = array.new<float>(segCount)
    array<float> segMinY = array.new<float>(segCount)
    array<float> segMaxY = array.new<float>(segCount)
    array<int> segKeyA = array.new<int>(segCount)
    array<int> segKeyB = array.new<int>(segCount)
    for i = 0 to (segCount == 0 ? na : segCount - 1)
        segMinX.set(i, math.min(segAx.get(i), segBx.get(i)))
        segMaxX.set(i, math.max(segAx.get(i), segBx.get(i)))
        segMinY.set(i, math.min(segAy.get(i), segBy.get(i)))
        segMaxY.set(i, math.max(segAy.get(i), segBy.get(i)))
        segKeyA.set(i, _contourIntKey2(segAx.get(i), segAy.get(i)))
        segKeyB.set(i, _contourIntKey2(segBx.get(i), segBy.get(i)))
    // Sort indices by minX for sweep-and-prune
    array<int> sortOrder = segMinX.sort_indices(order.ascending)
    for ii = 0 to (segCount == 0 ? na : segCount - 1)
        int sa = sortOrder.get(ii)
        float aMaxX = segMaxX.get(sa)
        float aMinY = segMinY.get(sa)
        float aMaxY = segMaxY.get(sa)
        float a0x = segAx.get(sa)
        float a0y = segAy.get(sa)
        float a1x = segBx.get(sa)
        float a1y = segBy.get(sa)
        float aDx = a1x - a0x
        float aDy = a1y - a0y
        int aKeyA = segKeyA.get(sa)
        int aKeyB = segKeyB.get(sa)
        for jj = ii + 1 to (ii + 1 > segCount - 1 ? na : segCount - 1)
            int sb = sortOrder.get(jj)
            if segMinX.get(sb) > aMaxX + CONTOUR_SCREEN_EPSILON
                break
            // Y-bbox short-circuit first (X overlap already guaranteed by sweep break)
            if aMaxY + CONTOUR_SCREEN_EPSILON < segMinY.get(sb) or segMaxY.get(sb) + CONTOUR_SCREEN_EPSILON < aMinY
                continue
            int bKeyA = segKeyA.get(sb)
            int bKeyB = segKeyB.get(sb)
            if aKeyA == bKeyA or aKeyA == bKeyB or aKeyB == bKeyA or aKeyB == bKeyB
                float bDx = segBx.get(sb) - segAx.get(sb)
                float bDy = segBy.get(sb) - segAy.get(sb)
                if math.abs(aDx * bDy - aDy * bDx) > CONTOUR_SCREEN_EPSILON
                    continue
            // Inline pre-check: only ensure_explicit + collect on real intersect
            float b0x = segAx.get(sb)
            float b0y = segAy.get(sb)
            float b1x = segBx.get(sb)
            float b1y = segBy.get(sb)
            float bx_ = b1x - b0x
            float bY_ = b1y - b0y
            float qpx = b0x - a0x
            float qpy = b0y - a0y
            float rxs = aDx * bY_ - aDy * bx_
            float qpxr = qpx * aDy - qpy * aDx
            if math.abs(rxs) <= CONTOUR_SCREEN_EPSILON and math.abs(qpxr) <= CONTOUR_SCREEN_EPSILON
                _ensureExplicit(sa, splitHead, splitTVal, splitNext)
                _ensureExplicit(sb, splitHead, splitTVal, splitNext)
                _contourCollectSegSplitParams(sa, sb, a0x, a0y, a1x, a1y, b0x, b0y, b1x, b1y, splitHead, splitTVal, splitNext)
            else if math.abs(rxs) > CONTOUR_SCREEN_EPSILON
                float t = (qpx * bY_ - qpy * bx_) / rxs
                float u = (qpx * aDy - qpy * aDx) / rxs
                if t >= -CONTOUR_SCREEN_EPSILON and t <= 1.0 + CONTOUR_SCREEN_EPSILON and u >= -CONTOUR_SCREEN_EPSILON and u <= 1.0 + CONTOUR_SCREEN_EPSILON
                    _ensureExplicit(sa, splitHead, splitTVal, splitNext)
                    _ensureExplicit(sb, splitHead, splitTVal, splitNext)
                    _contourCollectSegSplitParams(sa, sb, a0x, a0y, a1x, a1y, b0x, b0y, b1x, b1y, splitHead, splitTVal, splitNext)

    // Spatial grid with cell_count_arr and inv_step multiply
    int gridDim = math.max(1, int(math.round(math.sqrt(float(bandFragCount)) * 0.75)))
    float gridStepX = math.max((bandMaxX - bandMinX) / float(gridDim), CONTOUR_SCREEN_EPSILON)
    float gridStepY = math.max((bandMaxY - bandMinY) / float(gridDim), CONTOUR_SCREEN_EPSILON)
    float invStepX = 1.0 / gridStepX
    float invStepY = 1.0 / gridStepY
    int gdMax = gridDim - 1
    array<int> cellHead = array.new<int>(gridDim > 1 ? gridDim * gridDim : 0, -1)
    array<int> cellCountArr = array.new<int>(gridDim > 1 ? gridDim * gridDim : 0, 0)
    array<int> cellFragId = array.new<int>()
    array<int> cellFragNext = array.new<int>()
    if gridDim > 1
        for localFrag = 0 to (bandFragCount == 0 ? na : bandFragCount - 1)
            int mcx = int((fragMinX.get(localFrag) - bandMinX) * invStepX)
            if mcx < 0
                mcx := 0
            else if mcx > gdMax
                mcx := gdMax
            int Mcx = int((fragMaxX.get(localFrag) - bandMinX) * invStepX)
            if Mcx < 0
                Mcx := 0
            else if Mcx > gdMax
                Mcx := gdMax
            int mcy = int((fragMinY.get(localFrag) - bandMinY) * invStepY)
            if mcy < 0
                mcy := 0
            else if mcy > gdMax
                mcy := gdMax
            int Mcy = int((fragMaxY.get(localFrag) - bandMinY) * invStepY)
            if Mcy < 0
                Mcy := 0
            else if Mcy > gdMax
                Mcy := gdMax
            for cellX = mcx to Mcx
                int base = cellX * gridDim
                for cellY = mcy to Mcy
                    int ci = base + cellY
                    cellCountArr.set(ci, cellCountArr.get(ci) + 1)
                    int prevHead = cellHead.get(ci)
                    cellHead.set(ci, cellFragId.size())
                    cellFragId.push(localFrag)
                    cellFragNext.push(prevHead)

    // Boundary phase: inline containment + dedup
    array<float> screenPointX = array.new<float>()
    array<float> screenPointY = array.new<float>()
    map<int, int> screenPointMap = map.new<int, int>()
    array<int> boundaryStart = array.new<int>()
    array<int> boundaryEnd = array.new<int>()
    array<bool> boundaryAlive = array.new<bool>()

    // Hoist UDT field refs for containment testing
    array<int>   cFragStarts   = meta._cacheFragStarts
    array<int>   cFragLens     = meta._cacheFragLens
    array<int>   cFragPointRef = meta._cacheFragPointRef
    array<float> cProjSx       = meta._cacheProjSx
    array<float> cProjSy       = meta._cacheProjSy

    for segId = 0 to (segCount == 0 ? na : segCount - 1)
        int head = splitHead.get(segId)
        float a0x = segAx.get(segId)
        float a0y = segAy.get(segId)
        float a1x = segBx.get(segId)
        float a1y = segBy.get(segId)
        int owner = segOwnerFrag.get(segId)
        if head == -1
            // Seed-only shortcut: no splits, use exact coordinates
            _contourEmitBoundarySeg(a0x, a0y, a1x, a1y, owner, true,
              bandFragStart, bandFragCount, gridDim, gdMax,
              bandMinX, bandMinY, invStepX, invStepY,
              cellCountArr, cellHead, cellFragId, cellFragNext,
              fragMinX, fragMaxX, fragMinY, fragMaxY,
              cFragStarts, cFragLens, cFragPointRef, cProjSx, cProjSy,
              screenPointX, screenPointY, screenPointMap,
              boundaryStart, boundaryEnd, boundaryAlive)
        else
            // Non-seed path: traverse linked-list, sort, iterate sub-segments
            array<float> tVals = array.new<float>()
            int cur = head
            while cur != -1
                tVals.push(splitTVal.get(cur))
                cur := splitNext.get(cur)
            if tVals.size() >= 2
                array.sort(tVals, order.ascending)
                bool seedOnly = tVals.size() == 2
                int tLast = tVals.size() - 2
                for ti = 0 to tLast
                    float t0 = tVals.get(ti)
                    float t1 = tVals.get(ti + 1)
                    if t1 - t0 <= CONTOUR_SCREEN_EPSILON
                        continue
                    float p0x = na
                    float p0y = na
                    float p1x = na
                    float p1y = na
                    if seedOnly
                        p0x := a0x
                        p0y := a0y
                        p1x := a1x
                        p1y := a1y
                    else
                        p0x := a0x + (a1x - a0x) * t0
                        p0y := a0y + (a1y - a0y) * t0
                        p1x := a0x + (a1x - a0x) * t1
                        p1y := a0y + (a1y - a0y) * t1
                    _contourEmitBoundarySeg(p0x, p0y, p1x, p1y, owner, seedOnly,
                      bandFragStart, bandFragCount, gridDim, gdMax,
                      bandMinX, bandMinY, invStepX, invStepY,
                      cellCountArr, cellHead, cellFragId, cellFragNext,
                      fragMinX, fragMaxX, fragMinY, fragMaxY,
                      cFragStarts, cFragLens, cFragPointRef, cProjSx, cProjSy,
                      screenPointX, screenPointY, screenPointMap,
                      boundaryStart, boundaryEnd, boundaryAlive)

    array<_IntLoop> loops = array.new<_IntLoop>()
    int pointCount = screenPointX.size()
    int edgeCount = boundaryStart.size()
    if pointCount > 0 and edgeCount > 0
        // Fast path: compute per-vertex directed imbalance (out - in). Only if
        // any vertex is unbalanced do we run the nearest-neighbour repair that
        // patches the rare seam-misclassification dropouts in
        // the inlined containment. Edges in this function are always
        // alive when pushed, so the alive check is unnecessary.
        array<int> balance = array.new<int>(pointCount, 0)
        for i = 0 to edgeCount - 1
            int s = boundaryStart.get(i)
            int e = boundaryEnd.get(i)
            balance.set(s, balance.get(s) + 1)
            balance.set(e, balance.get(e) - 1)
        bool imbalanced = false
        for p = 0 to pointCount - 1
            if balance.get(p) != 0
                imbalanced := true
                break
        if imbalanced
            array<int> needOut = array.new<int>()
            array<int> needIn  = array.new<int>()
            for p = 0 to pointCount - 1
                int d = balance.get(p)
                if d < 0
                    for _r = 0 to -d - 1
                        needOut.push(p)
                else if d > 0
                    for _r = 0 to d - 1
                        needIn.push(p)
            while needOut.size() > 0 and needIn.size() > 0
                int src = needOut.pop()
                float sx_ = screenPointX.get(src)
                float sy_ = screenPointY.get(src)
                int bestIdx = 0
                float bestDsq = 1e38
                int nInSize = needIn.size()
                for k = 0 to nInSize - 1
                    int cand = needIn.get(k)
                    float dx = screenPointX.get(cand) - sx_
                    float dy = screenPointY.get(cand) - sy_
                    float dsq = dx * dx + dy * dy
                    if dsq < bestDsq
                        bestDsq := dsq
                        bestIdx := k
                int dst = needIn.remove(bestIdx)
                boundaryStart.push(src)
                boundaryEnd.push(dst)
                boundaryAlive.push(true)
            edgeCount := boundaryStart.size()
        array<int> headByStart = array.new<int>(pointCount, -1)
        array<int> headEpoch = array.new<int>(pointCount, 0)
        array<int> nextSameStart = array.new<int>(edgeCount, -1)
        array<int> edgeUsedEpoch = array.new<int>(edgeCount, 0)
        loops := _contourTraceLoops(boundaryStart, boundaryEnd, boundaryAlive, headByStart, headEpoch, nextSameStart, edgeUsedEpoch, 1)
    [loops, screenPointX, screenPointY]

_contourBuildScreenPath(array<_IntLoop> bandLoops, array<float> pointX, array<float> pointY) =>
    array<float> pathX = array.new<float>()
    array<float> pathY = array.new<float>()
    if bandLoops.size() == 0
        [pathX, pathY]
    else
        int nBandLoops = bandLoops.size()
        array<float> loopAreas = array.new<float>()
        bool outerPositive = true
        bool outerFound = false
        float maxAreaAbs = -1.0
        for i = 0 to nBandLoops - 1
            float area = _contourLoopArea(bandLoops.get(i).vi, pointX, pointY)
            loopAreas.push(area)
            float absArea = math.abs(area)
            if absArea > CONTOUR_SCREEN_EPSILON and absArea > maxAreaAbs
                maxAreaAbs := absArea
                outerPositive := area > 0.0
                outerFound := true

        if outerFound
            array<_IntLoop> outerLoops = array.new<_IntLoop>()
            array<float> outerAreas = array.new<float>()
            array<float> outerBboxMinX = array.new<float>()
            array<float> outerBboxMaxX = array.new<float>()
            array<float> outerBboxMinY = array.new<float>()
            array<float> outerBboxMaxY = array.new<float>()
            array<_IntLoop> holeLoops = array.new<_IntLoop>()
            for i = 0 to nBandLoops - 1
                array<int> rawLoop = bandLoops.get(i).vi
                float area = loopAreas.get(i)
                if math.abs(area) <= CONTOUR_SCREEN_EPSILON
                    continue
                bool isOuter = (area > 0.0) == outerPositive
                if isOuter
                    array<int> oriented = _contourOrientedLoop(rawLoop, outerPositive, area, pointX, pointY)
                    outerLoops.push(_IntLoop.new(oriented))
                    outerAreas.push(math.abs(area))
                    float bMinX = 1e38
                    float bMaxX = -1e38
                    float bMinY = 1e38
                    float bMaxY = -1e38
                    int orientedLen = oriented.size()
                    for vi = 0 to orientedLen - 1
                        int pid = oriented.get(vi)
                        float px = pointX.get(pid)
                        float py = pointY.get(pid)
                        if px < bMinX
                            bMinX := px
                        if px > bMaxX
                            bMaxX := px
                        if py < bMinY
                            bMinY := py
                        if py > bMaxY
                            bMaxY := py
                    outerBboxMinX.push(bMinX)
                    outerBboxMaxX.push(bMaxX)
                    outerBboxMinY.push(bMinY)
                    outerBboxMaxY.push(bMaxY)
                else
                    array<int> oriented = _contourOrientedLoop(rawLoop, not outerPositive, area, pointX, pointY)
                    holeLoops.push(_IntLoop.new(oriented))

            if outerLoops.size() > 0
                int nOuterLoops = outerLoops.size()
                int nHoleLoops = holeLoops.size()
                array<int> holeOwner = array.new<int>(nHoleLoops, -1)
                for hi = 0 to (nHoleLoops == 0 ? na : nHoleLoops - 1)
                    array<int> holeLoop = holeLoops.get(hi).vi
                    if holeLoop.size() < 3
                        continue
                    _Point2 sample = _contourLoopCentroid(holeLoop, pointX, pointY)
                    int ownerIdx = _contourAssignOuter(sample.x, sample.z, outerLoops, outerAreas, outerBboxMinX, outerBboxMaxX, outerBboxMinY, outerBboxMaxY, pointX, pointY)
                    holeOwner.set(hi, ownerIdx)

                array<int> outerAnchorIdx = array.new<int>(nOuterLoops, -1)
                array<int> outerAnchorId = array.new<int>(nOuterLoops, -1)
                array<float> outerAnchorX = array.new<float>(nOuterLoops, na)
                array<float> outerAnchorY = array.new<float>(nOuterLoops, na)
                int masterOuter = -1
                float masterAnchorX = -1e38
                float masterAnchorY = 1e38
                for oi = 0 to nOuterLoops - 1
                    array<int> outerLoop = outerLoops.get(oi).vi
                    int outerLen = outerLoop.size()
                    if outerLen < 3
                        continue
                    int anchorIdx = _contourAnchorIndex(outerLoop, pointX, pointY)
                    int anchorId = outerLoop.get(anchorIdx)
                    float anchorX = pointX.get(anchorId)
                    float anchorY = pointY.get(anchorId)
                    outerAnchorIdx.set(oi, anchorIdx)
                    outerAnchorId.set(oi, anchorId)
                    outerAnchorX.set(oi, anchorX)
                    outerAnchorY.set(oi, anchorY)
                    if masterOuter == -1 or anchorX > masterAnchorX or (anchorX == masterAnchorX and anchorY < masterAnchorY)
                        masterOuter := oi
                        masterAnchorX := anchorX
                        masterAnchorY := anchorY

                if masterOuter != -1
                    array<int> pathIds = array.new<int>()
                    int masterAnchorId = outerAnchorId.get(masterOuter)
                    int masterAnchorIdx = outerAnchorIdx.get(masterOuter)
                    array<int> masterLoop = outerLoops.get(masterOuter).vi
                    int masterLen = masterLoop.size()
                    for step = 1 to masterLen
                        int loopIdx = (masterAnchorIdx + step) % masterLen
                        pathIds.push(masterLoop.get(loopIdx))

                    for hi = 0 to (nHoleLoops == 0 ? na : nHoleLoops - 1)
                        if holeOwner.get(hi) != masterOuter
                            continue
                        array<int> holeLoop = holeLoops.get(hi).vi
                        int holeLen = holeLoop.size()
                        if holeLen < 3
                            continue
                        int startIdx = _contourNearestIndex(holeLoop, masterAnchorX, masterAnchorY, pointX, pointY)
                        for step = 0 to holeLen - 1
                            int loopIdx = (startIdx + step) % holeLen
                            pathIds.push(holeLoop.get(loopIdx))
                        pathIds.push(holeLoop.get(startIdx))
                        pathIds.push(masterAnchorId)

                    for oi = 0 to nOuterLoops - 1
                        if oi == masterOuter
                            continue
                        array<int> outerLoop = outerLoops.get(oi).vi
                        int outerLen = outerLoop.size()
                        int anchorIdx = outerAnchorIdx.get(oi)
                        int anchorId = outerAnchorId.get(oi)
                        if outerLen < 3 or anchorIdx == -1 or anchorId == -1
                            continue
                        float anchorX = outerAnchorX.get(oi)
                        float anchorY = outerAnchorY.get(oi)
                        pathIds.push(anchorId)
                        for step = 1 to outerLen
                            int loopIdx = (anchorIdx + step) % outerLen
                            pathIds.push(outerLoop.get(loopIdx))
                        for hi = 0 to (nHoleLoops == 0 ? na : nHoleLoops - 1)
                            if holeOwner.get(hi) != oi
                                continue
                            array<int> holeLoop = holeLoops.get(hi).vi
                            int holeLen = holeLoop.size()
                            if holeLen < 3
                                continue
                            int startIdx = _contourNearestIndex(holeLoop, anchorX, anchorY, pointX, pointY)
                            for step = 0 to holeLen - 1
                                int loopIdx = (startIdx + step) % holeLen
                                pathIds.push(holeLoop.get(loopIdx))
                            pathIds.push(holeLoop.get(startIdx))
                            pathIds.push(anchorId)
                        pathIds.push(masterAnchorId)

                    int pathLen = pathIds.size()
                    if pathLen > 1
                        array<int> deduped = array.new<int>()
                        int prevId = pathIds.get(0)
                        deduped.push(prevId)
                        for i = 1 to pathLen - 1
                            int pointId = pathIds.get(i)
                            if pointId != prevId
                                deduped.push(pointId)
                                prevId := pointId
                        pathIds := deduped
                    if pathIds.size() >= 3
                        int nPathIds = pathIds.size()
                        for i = 0 to nPathIds - 1
                            int pointId = pathIds.get(i)
                            pathX.push(pointX.get(pointId))
                            pathY.push(pointY.get(pointId))
        [pathX, pathY]


// Internal: render a contour-band surface mesh.
// Each rendered band is clipped from the actual surface so adjacent levels share boundaries.
// Fragment-based geometry caching + screen-space union loop construction.
_renderContour(
  Mesh mesh,
  array<Vec3> worldVerts,
  bool worldDirty,
  float meshAvgDepth,
  Vec3 camPos,
  Vec3 forward,
  Vec3 right,
  Vec3 up,
  float fov,
  int guiShift,
  float yOffset,
  float yScale,
  array<_DrawFace> drawList
  ) =>
    _ContourMeta meta = mesh._contourMeta
    int cols = meta.cols
    array<Vec3> verts = mesh.vertices
    int numVerts = verts.size()
    int rows = numVerts / cols
    int levels = meta.levels

    bool _cBehind = not na(mesh._cacheBR) and mesh._cacheBR > 0.0 and not na(mesh._cacheBCX) and (mesh._cacheBCX - camPos.x) * forward.x + (mesh._cacheBCY - camPos.y) * forward.y + (mesh._cacheBCZ - camPos.z) * forward.z + mesh._cacheBR < 0.0
    if rows < 2 or cols < 2 or _cBehind
        int(na)
    else
        float firstY = verts.get(0).y
        float lastY  = verts.get(numVerts - 1).y
        bool geomDirty = na(meta._geomVertCount) or meta._geomVertCount != numVerts
          or meta._geomFirstY != firstY or meta._geomLastY != lastY

        if geomDirty
            // Precompute per-vertex Y into flat array to avoid UDT access in cell loop
            array<float> vertY = array.new<float>(numVerts)
            vertY.set(0, firstY)
            float minY = firstY
            float maxY = minY
            for i = 1 to numVerts - 1
                float y = verts.get(i).y
                vertY.set(i, y)
                if y < minY
                    minY := y
                if y > maxY
                    maxY := y
            float rangeY = maxY - minY
            if rangeY < NORMALIZE_EPSILON
                rangeY := 1.0
            float stepY = rangeY / float(levels)

            array<int>   allSrcA          = array.new<int>()
            array<int>   allSrcB          = array.new<int>()
            array<float> allSrcMix        = array.new<float>()
            array<int>   allFragRefs       = array.new<int>()
            array<int>   fragStarts        = array.new<int>()
            array<int>   fragLens          = array.new<int>()
            array<int>   gBandFragStarts   = array.new<int>()
            array<int>   gBandFragLens     = array.new<int>()
            array<color> gBandColors       = array.new<color>()
            array<float> gBandDepthOffsets = array.new<float>()

            int horizCount = rows * (cols - 1)
            int vertCount = (rows - 1) * cols
            int diagCount = (rows - 1) * (cols - 1)
            int cellCount = (rows - 1) * (cols - 1)
            array<float> cellMinYArr = array.new<float>(cellCount)
            array<float> cellMaxYArr = array.new<float>(cellCount)
            array<int> cellTopLeftArr = array.new<int>(cellCount)
            array<int> cellTopEdgeArr = array.new<int>(cellCount)
            array<int> cellBottomEdgeArr = array.new<int>(cellCount)
            array<int> cellLeftEdgeArr = array.new<int>(cellCount)
            array<int> cellRightEdgeArr = array.new<int>(cellCount)
            array<int> cellDiagEdgeArr = array.new<int>(cellCount)
            // Cache firstBand/lastBand per cell to avoid recomputing in second pass
            array<int> cellFirstBand = array.new<int>(cellCount)
            array<int> cellLastBand = array.new<int>(cellCount)
            array<int> bandCellCounts = array.new<int>(levels, 0)
            for r = 0 to rows - 2
                for c = 0 to cols - 2
                    int cIdx = r * (cols - 1) + c
                    int _tl = r * cols + c
                    float _tlY = vertY.get(_tl)
                    float _trY = vertY.get(_tl + 1)
                    float _blY = vertY.get((r + 1) * cols + c)
                    float _brY = vertY.get((r + 1) * cols + c + 1)
                    float cellMinY = math.min(math.min(_tlY, _trY), math.min(_blY, _brY))
                    float cellMaxY = math.max(math.max(_tlY, _trY), math.max(_blY, _brY))
                    cellMinYArr.set(cIdx, cellMinY)
                    cellMaxYArr.set(cIdx, cellMaxY)
                    cellTopLeftArr.set(cIdx, _tl)
                    int topEdge = r * (cols - 1) + c
                    int leftEdge = horizCount + r * cols + c
                    cellTopEdgeArr.set(cIdx, topEdge)
                    cellBottomEdgeArr.set(cIdx, topEdge + (cols - 1))
                    cellLeftEdgeArr.set(cIdx, leftEdge)
                    cellRightEdgeArr.set(cIdx, leftEdge + 1)
                    cellDiagEdgeArr.set(cIdx, horizCount + vertCount + r * (cols - 1) + c)
                    int firstBand = _clampInt(int((cellMinY - minY - NORMALIZE_EPSILON) / stepY), 0, levels - 1)
                    int lastBand = _clampInt(int((cellMaxY - minY + NORMALIZE_EPSILON) / stepY), 0, levels - 1)
                    cellFirstBand.set(cIdx, firstBand)
                    cellLastBand.set(cIdx, lastBand)
                    for bandIdx = firstBand to lastBand
                        bandCellCounts.set(bandIdx, bandCellCounts.get(bandIdx) + 1)

            array<int> bandCellStarts = array.new<int>(levels, 0)
            int totalBandCellRefs = 0
            for bandIdx = 0 to levels - 1
                bandCellStarts.set(bandIdx, totalBandCellRefs)
                totalBandCellRefs += bandCellCounts.get(bandIdx)
            array<int> bandCellRefs = array.new<int>(totalBandCellRefs, 0)
            array<int> bandCellWrite = array.copy(bandCellStarts)
            for cellIdx = 0 to cellCount - 1
                int firstBand = cellFirstBand.get(cellIdx)
                int lastBand = cellLastBand.get(cellIdx)
                for bandIdx = firstBand to lastBand
                    int writeIdx = bandCellWrite.get(bandIdx)
                    bandCellRefs.set(writeIdx, cellIdx)
                    bandCellWrite.set(bandIdx, writeIdx + 1)

            int meshEdgeCount   = horizCount + vertCount + diagCount
            int totalPointCount = numVerts + meshEdgeCount * 2
            array<float> pointX = array.new<float>(totalPointCount)
            array<float> pointY = array.new<float>(totalPointCount)
            array<float> pointZ = array.new<float>(totalPointCount)
            array<int>   pointSrcA   = array.new<int>(totalPointCount, -1)
            array<int>   pointSrcB   = array.new<int>(totalPointCount, -1)
            array<float> pointSrcMix = array.new<float>(totalPointCount, 0.0)
            array<int> pointEpoch = array.new<int>(totalPointCount, 0)
            for i = 0 to numVerts - 1
                Vec3 v = verts.get(i)
                pointX.set(i, v.x)
                pointY.set(i, v.y)
                pointZ.set(i, v.z)
                pointSrcA.set(i, i)
                allSrcA.push(i)
                allSrcB.push(-1)
                allSrcMix.push(0.0)
            array<int> prevUpperProjId    = array.new<int>(meshEdgeCount, -1)
            array<int> prevUpperProjEpoch = array.new<int>(meshEdgeCount, 0)
            array<int> lowerProjId        = array.new<int>(meshEdgeCount, -1)
            array<int> lowerProjEpoch     = array.new<int>(meshEdgeCount, 0)
            array<int> upperProjId        = array.new<int>(meshEdgeCount, -1)
            array<int> upperProjEpoch     = array.new<int>(meshEdgeCount, 0)

            _ContourCtx ctx = _ContourCtx.new(
              numVerts, meshEdgeCount,
              verts, rows, cols,
              pointX, pointY, pointZ,
              pointSrcA, pointSrcB, pointSrcMix,
              pointEpoch, 0,
              prevUpperProjId, prevUpperProjEpoch,
              lowerProjId, lowerProjEpoch,
              upperProjId, upperProjEpoch,
              allSrcA, allSrcB, allSrcMix,
              allFragRefs, fragStarts, fragLens)

            for L = 0 to levels - 1
                int bandStamp = L + 1
                ctx.bandStamp := bandStamp
                float lowerY = minY + float(L) * stepY
                float upperY = L < levels - 1 ? minY + float(L + 1) * stepY : maxY
                float levelT = float(L) / float(math.max(1, levels - 1))
                color levelCol = _colorLerp(meta.lowCol, meta.highCol, levelT)

                int bandFragStart = fragStarts.size()
                int bandCellStart = bandCellStarts.get(L)
                int bandCellCount = bandCellCounts.get(L)
                for refIdx = bandCellStart to (bandCellCount == 0 ? na : bandCellStart + bandCellCount - 1)
                    int cellIdx = bandCellRefs.get(refIdx)
                    if cellMaxYArr.get(cellIdx) < lowerY - NORMALIZE_EPSILON or cellMinYArr.get(cellIdx) > upperY + NORMALIZE_EPSILON
                        continue
                    int tl = cellTopLeftArr.get(cellIdx)
                    int tr = tl + 1
                    int bl = tl + cols
                    int br = bl + 1
                    if cellMinYArr.get(cellIdx) >= lowerY - NORMALIZE_EPSILON and cellMaxYArr.get(cellIdx) <= upperY + NORMALIZE_EPSILON
                        _contourCacheFragQuad(tl, bl, br, tr, ctx)
                    else
                        _contourProcessBandTriangle(tl, bl, br, cellLeftEdgeArr.get(cellIdx), cellBottomEdgeArr.get(cellIdx), cellDiagEdgeArr.get(cellIdx), lowerY, upperY, ctx)
                        _contourProcessBandTriangle(tl, br, tr, cellDiagEdgeArr.get(cellIdx), cellRightEdgeArr.get(cellIdx), cellTopEdgeArr.get(cellIdx), lowerY, upperY, ctx)

                int bandFragCount = fragStarts.size() - bandFragStart
                if bandFragCount > 0
                    gBandFragStarts.push(bandFragStart)
                    gBandFragLens.push(bandFragCount)
                    gBandColors.push(levelCol)
                    gBandDepthOffsets.push(float(levels - L))

                array<int> swapProjId = ctx.prevUpperProjId
                ctx.prevUpperProjId := ctx.upperProjId
                ctx.upperProjId := swapProjId
                array<int> swapProjEpoch = ctx.prevUpperProjEpoch
                ctx.prevUpperProjEpoch := ctx.upperProjEpoch
                ctx.upperProjEpoch := swapProjEpoch

            meta._cachePtSrcA          := allSrcA
            meta._cachePtSrcB          := allSrcB
            meta._cachePtMix           := allSrcMix
            meta._cacheFragPointRef    := allFragRefs
            meta._cacheFragStarts      := fragStarts
            meta._cacheFragLens        := fragLens
            meta._cacheBandFragStarts  := gBandFragStarts
            meta._cacheBandFragLens    := gBandFragLens
            meta._cacheBandColors      := gBandColors
            meta._cacheBandDepthOffsets := gBandDepthOffsets
            meta._geomFirstY           := firstY
            meta._geomLastY            := lastY
            meta._geomVertCount        := numVerts
            meta._cacheProjSx := na
            meta._cacheScreenPathX := na

        // --- Projection cache check ---
        bool projDirty = worldDirty
          or na(meta._cacheProjSx) or na(meta._projCamPosX)
          or na(meta._cacheScreenPathX)
          or meta._projCamPosX != camPos.x or meta._projCamPosY != camPos.y
          or meta._projCamPosZ != camPos.z
          or meta._projFwdX != forward.x or meta._projFwdY != forward.y
          or meta._projFwdZ != forward.z
          or meta._projFov != fov

        if projDirty
            // Hoist UDT field refs to flat locals to avoid per-iter UDT field dispatch
            array<int>   ptSrcA = meta._cachePtSrcA
            array<int>   ptSrcB = meta._cachePtSrcB
            array<float> ptMix  = meta._cachePtMix
            int totalPts = ptSrcA.size()
            array<float> projSx = array.new<float>(totalPts)
            array<float> projSy = array.new<float>(totalPts)
            float camPX = camPos.x,  float camPY = camPos.y,  float camPZ = camPos.z
            float rX = right.x,     float rY = right.y,     float rZ = right.z
            float uX = up.x,        float uY = up.y,        float uZ = up.z
            float fX = forward.x,   float fY = forward.y,   float fZ = forward.z
            if totalPts > 0
                for i = 0 to totalPts - 1
                    int srcA = ptSrcA.get(i)
                    int srcB = ptSrcB.get(i)
                    float wX = na
                    float wY = na
                    float wZ = na
                    if srcB == -1
                        Vec3 w = worldVerts.get(srcA)
                        wX := w.x
                        wY := w.y
                        wZ := w.z
                    else
                        Vec3 wA = worldVerts.get(srcA)
                        Vec3 wB = worldVerts.get(srcB)
                        float m = ptMix.get(i)
                        wX := wA.x + (wB.x - wA.x) * m
                        wY := wA.y + (wB.y - wA.y) * m
                        wZ := wA.z + (wB.z - wA.z) * m
                    float relX = wX - camPX
                    float relY = wY - camPY
                    float relZ = wZ - camPZ
                    float cvx  = relX * rX + relY * rY + relZ * rZ
                    float cvy  = relX * uX + relY * uY + relZ * uZ
                    float cvz  = relX * fX + relY * fY + relZ * fZ
                    float denom = cvz + fov
                    if denom <= 0.0
                        denom := NEAR_PLANE_EPSILON
                    projSx.set(i, cvx * fov / denom)
                    projSy.set(i, cvy * fov / denom)
            meta._cacheProjSx  := projSx
            meta._cacheProjSy  := projSy
            meta._projCamPosX  := camPos.x
            meta._projCamPosY  := camPos.y
            meta._projCamPosZ  := camPos.z
            meta._projFwdX     := forward.x
            meta._projFwdY     := forward.y
            meta._projFwdZ     := forward.z
            meta._projFov      := fov

            // --- Screen-space union loop construction per band ---
            array<float> screenPathX = array.new<float>()
            array<float> screenPathY = array.new<float>()
            array<int> screenStarts = array.new<int>()
            array<int> screenLens = array.new<int>()
            int totalFragBands = meta._cacheBandFragStarts.size()
            for bIdx = 0 to (totalFragBands == 0 ? na : totalFragBands - 1)
                int bandFragStart = meta._cacheBandFragStarts.get(bIdx)
                int bandFragCount = meta._cacheBandFragLens.get(bIdx)
                [screenLoops, screenPointX, screenPointY] = _contourBuildScreenUnionLoops(bandFragStart, bandFragCount, meta)
                [pathX, pathY] = _contourBuildScreenPath(screenLoops, screenPointX, screenPointY)
                screenStarts.push(screenPathX.size())
                int pathLen = pathX.size()
                screenLens.push(pathLen)
                for i = 0 to (pathLen == 0 ? na : pathLen - 1)
                    screenPathX.push(pathX.get(i))
                    screenPathY.push(pathY.get(i))
            meta._cacheScreenPathX := screenPathX
            meta._cacheScreenPathY := screenPathY
            meta._cacheScreenStarts := screenStarts
            meta._cacheScreenLens := screenLens

        // Reconstruct chart.points from cached screen-space paths
        array<int>   sStarts  = meta._cacheScreenStarts
        array<int>   sLens    = meta._cacheScreenLens
        array<float> sPathX   = meta._cacheScreenPathX
        array<float> sPathY   = meta._cacheScreenPathY
        array<float> sDepthOff = meta._cacheBandDepthOffsets
        array<color> sColors  = meta._cacheBandColors
        int totalBands = sStarts.size()
        int barMs = na(time[1]) ? 60000 : int(math.max(1.0, float(time - time[1])))
        int baseTime = time + guiShift * barMs
        float yBase    = fov + yOffset
        for bIdx = 0 to (totalBands == 0 ? na : totalBands - 1)
            int bStart = sStarts.get(bIdx)
            int bLen   = sLens.get(bIdx)
            if bLen < 3
                continue
            array<chart.point> bandPath = array.new<chart.point>()
            for i = 0 to bLen - 1
                float _tsx = sPathX.get(bStart + i)
                float _tsy = sPathY.get(bStart + i)
                bandPath.push(chart.point.from_time(baseTime + int(math.round(_tsx * float(barMs))), _tsy * yScale + yBase))
            float bandDepth = meshAvgDepth + sDepthOff.get(bIdx)
            drawList.push(_DrawFace.new(bandPath, sColors.get(bIdx), bandDepth, "contour", true))

        int(na)


// ============================================================================
// SECTION 8: RENDER PIPELINE (exported)
// ============================================================================

//@function Renders the scene to the chart. Pipeline: world transform, camera transform,
//          back-face culling, occlusion culling, depth sort, directional/point lighting
//          with shadows, perspective projection. Contour meshes take a fast path that
//          projects directly from cached vertex descriptors. All chart drawings
//          (polylines, labels, lines, linefills) are cleared at the start of each call.
//@param scene (Scene) The scene to render.
//@param maxFaces (series int) Max faces to draw (capped by polyline budget). Default 100.
//@param culling (series bool) Enable back-face culling. Default true.
//@param lighting (series bool) Enable directional lighting. Default false.
//@param lightDir (Vec3) Light direction vector (points toward the light). Default: upper-left-front.
//@param ambient (series float) Minimum brightness for shadowed faces (0.0-1.0). Default 0.3.
//@param wireframe (series bool) If true, draw outlines only (no fill). Default false.
//@param occlusion (series bool) Enable occlusion culling. When true, a sparse raster pass removes hidden faces before drawing. Default true.
//@param occlusionRaster (series int) Raster resolution for occlusion visibility testing. Default 768.
export render(
      Scene scene,
      series int maxFaces = 100,
      series bool culling = true,
      series bool lighting = false,
      Vec3 lightDir = na,
      series float ambient = 0.3,
      series bool wireframe = false,
      series bool occlusion = true,
      series int occlusionRaster = 768
  ) =>
    // --- Wipe last frame's chart drawings before drawing this frame ---
    for lf in linefill.all
        linefill.delete(lf)
    for p in polyline.all
        polyline.delete(p)
    for l in label.all
        label.delete(l)
    for ln in line.all
        line.delete(ln)
    // --- Light resolution: explicit params > scene.light > hardcoded defaults ---
    float amb = ambient
    float shadowStr = 0.0
    float shadowBias = 0.5
    bool  selfShadow = false
    string lightMode = "directional"
    Vec3 lightPos = na
    Vec3 ld = Vec3.new(0.0, 0.0, 0.0)
    if not na(lightDir)
        // Explicit render() params override scene.light
        ld := lightDir.normalize()
    else if not na(scene.light) and scene.light.enabled
        ld := not na(scene.light.direction) ? scene.light.direction.normalize() : Vec3.new(-0.4, 0.7, -0.5).normalize()
        amb := scene.light.ambient
        shadowStr := scene.light.shadowStr
        shadowBias := scene.light.shadowBias
        selfShadow := scene.light.selfShadow
        lightMode := scene.light.mode
        lightPos := scene.light.position
    else
        ld := Vec3.new(-0.4, 0.7, -0.5).normalize()
    bool shadowEnabled = lighting and shadowStr > 0.0

    // --- Camera setup (shared basis computation) ---
    _CamBasis cb = _camBasis(scene)
    Vec3 camPos  = cb.camPos
    float fov    = cb.fov
    Vec3 forward = cb.forward
    Vec3 right   = cb.right
    Vec3 up      = cb.up
    Vec3 eyePos  = cb.eyePos
    float nearPlaneThresh = -fov * BEHIND_CAMERA_FACTOR

    // --- Time-based projection anchors (avoids historical buffer growth) ---
    // All drawings emitted via xloc.bar_time so projected points can sit arbitrarily
    // far in the past/future without forcing Pine to grow its bar_index history buffer.
    int barMs    = na(time[1]) ? 60000 : int(math.max(1.0, float(time - time[1])))
    int baseTime = time + scene.guiShift * barMs

    // --- Collect and process all faces ---
    array<_DrawFace> drawList = array.new<_DrawFace>()
    array<_SolidDesc> solidList = array.new<_SolidDesc>()

    // Bounding sphere arrays - one entry per mesh (indexed by meshCounter)
    array<float> meshBCX = array.new<float>()
    array<float> meshBCY = array.new<float>()
    array<float> meshBCZ = array.new<float>()
    array<float> meshBR  = array.new<float>()
    array<bool>  meshIsSolid = array.new<bool>()

    int meshCounter = -1
    for mesh in scene.meshes
        meshCounter += 1
        if not mesh.visible
            // Still push placeholder so meshIdx stays aligned
            meshBCX.push(0.0)
            meshBCY.push(0.0)
            meshBCZ.push(0.0)
            meshBR.push(0.0)
            meshIsSolid.push(false)
            continue

        // --- World-vert cache: skip _toWorld() + AABB when mesh transform is unchanged ---
        // Nested `if` chain instead of a single compound `or` so each branch can guard
        // its own UDT field access. Pine v6 short-circuit on long compound boolean
        // expressions with UDT fields cannot be relied on.
        bool worldDirty = false
        if na(mesh._cacheWorldVerts) or na(mesh._cachePos) or na(mesh._cacheRot) or na(mesh._cacheScl)
            worldDirty := true
        else if mesh.vertices.size() != mesh._cacheVertCount
            worldDirty := true
        else if mesh.position.x != mesh._cachePos.x or mesh.position.y != mesh._cachePos.y or mesh.position.z != mesh._cachePos.z
            worldDirty := true
        else if mesh.rotation.x != mesh._cacheRot.x or mesh.rotation.y != mesh._cacheRot.y or mesh.rotation.z != mesh._cacheRot.z
            worldDirty := true
        else if mesh.meshScale.x != mesh._cacheScl.x or mesh.meshScale.y != mesh._cacheScl.y or mesh.meshScale.z != mesh._cacheScl.z
            worldDirty := true
        else if mesh.vertices.size() > 0 and not na(mesh._cacheFirstVert)
            Vec3 fv = mesh.vertices.first()
            if fv.x != mesh._cacheFirstVert.x or fv.y != mesh._cacheFirstVert.y or fv.z != mesh._cacheFirstVert.z
                worldDirty := true
        array<Vec3> worldVerts = na
        if worldDirty
            worldVerts := array.new<Vec3>()
            // Precompute trig values once per mesh
            float _cx = math.cos(mesh.rotation.x)
            float _sx = math.sin(mesh.rotation.x)
            float _cy = math.cos(mesh.rotation.y)
            float _sy = math.sin(mesh.rotation.y)
            float _cz = math.cos(mesh.rotation.z)
            float _sz = math.sin(mesh.rotation.z)
            // AABB tracking for bounding sphere computation
            float aabbMinX =  1e10, float aabbMaxX = -1e10
            float aabbMinY =  1e10, float aabbMaxY = -1e10
            float aabbMinZ =  1e10, float aabbMaxZ = -1e10
            for v in mesh.vertices
                Vec3 world = _toWorld(v, mesh.position, mesh.meshScale, _cx, _sx, _cy, _sy, _cz, _sz)
                worldVerts.push(world)
                float wx = world.x
                float wy = world.y
                float wz = world.z
                if wx < aabbMinX
                    aabbMinX := wx
                if wx > aabbMaxX
                    aabbMaxX := wx
                if wy < aabbMinY
                    aabbMinY := wy
                if wy > aabbMaxY
                    aabbMaxY := wy
                if wz < aabbMinZ
                    aabbMinZ := wz
                if wz > aabbMaxZ
                    aabbMaxZ := wz
            // Derive bounding sphere from AABB
            float bsDx = aabbMaxX - aabbMinX
            float bsDy = aabbMaxY - aabbMinY
            float bsDz = aabbMaxZ - aabbMinZ
            float bcx = (aabbMinX + aabbMaxX) * 0.5
            float bcy = (aabbMinY + aabbMaxY) * 0.5
            float bcz = (aabbMinZ + aabbMaxZ) * 0.5
            float br  = 0.5 * math.sqrt(bsDx * bsDx + bsDy * bsDy + bsDz * bsDz)
            meshBCX.push(bcx)
            meshBCY.push(bcy)
            meshBCZ.push(bcz)
            meshBR.push(br)
            // Store cache snapshot
            mesh._cacheWorldVerts := worldVerts
            mesh._cachePos := Vec3.new(mesh.position.x, mesh.position.y, mesh.position.z)
            mesh._cacheRot := Vec3.new(mesh.rotation.x, mesh.rotation.y, mesh.rotation.z)
            mesh._cacheScl := Vec3.new(mesh.meshScale.x, mesh.meshScale.y, mesh.meshScale.z)
            mesh._cacheFirstVert := mesh.vertices.size() > 0 ? Vec3.new(mesh.vertices.first().x, mesh.vertices.first().y, mesh.vertices.first().z) : na
            mesh._cacheBCX := bcx
            mesh._cacheBCY := bcy
            mesh._cacheBCZ := bcz
            mesh._cacheBR  := br
            mesh._cacheVertCount := mesh.vertices.size()
        else
            // Reuse cached world verts and bounding sphere
            worldVerts := mesh._cacheWorldVerts
            meshBCX.push(mesh._cacheBCX)
            meshBCY.push(mesh._cacheBCY)
            meshBCZ.push(mesh._cacheBCZ)
            meshBR.push(mesh._cacheBR)
        meshIsSolid.push(mesh.style == "solid" and mesh.castShadow)

        // --- Bounding-sphere behind-camera early-out (all mesh styles) ---
        // Cull only when the full sphere sits behind the (negative) near plane.
        // A `< 0.0` test would also kill spheres whose far side is still in front
        // of the near plane and is the visually correct part of the silhouette.
        float _bsRelX = mesh._cacheBCX - camPos.x
        float _bsRelY = mesh._cacheBCY - camPos.y
        float _bsRelZ = mesh._cacheBCZ - camPos.z
        float _bsDepth = _bsRelX * forward.x + _bsRelY * forward.y + _bsRelZ * forward.z
        if _bsDepth + mesh._cacheBR < nearPlaneThresh
            continue
        bool nearPlaneRisk = _bsDepth - mesh._cacheBR < nearPlaneThresh

        // --- Contour fast path: skip generic projection ---
        if mesh.style == "contour" and not na(mesh._contourMeta)
            float cBcx = mesh._cacheBCX
            float cBcy = mesh._cacheBCY
            float cBcz = mesh._cacheBCZ
            float meshAvgDepth = (cBcx - camPos.x) * forward.x
              + (cBcy - camPos.y) * forward.y
              + (cBcz - camPos.z) * forward.z
            _renderContour(mesh, worldVerts, worldDirty, meshAvgDepth, camPos, forward, right, up, fov, scene.guiShift, scene.yOffset, scene.yScale, drawList)
            continue

        // --- Camera + screen projection (cached when camera + mesh are static) ---
        bool viewDirty = (worldDirty or
          na(mesh._cacheScreenXs) or na(mesh._cacheViewCamPosX) or
          mesh._cacheViewCamPosX != scene.camera.position.x or
          mesh._cacheViewCamPosY != scene.camera.position.y or
          mesh._cacheViewCamPosZ != scene.camera.position.z or
          mesh._cacheViewCamTgtX != scene.camera.target.x or
          mesh._cacheViewCamTgtY != scene.camera.target.y or
          mesh._cacheViewCamTgtZ != scene.camera.target.z or
          mesh._cacheViewFov != scene.camera.fov)
        array<float> camXs = na
        array<float> camYs = na
        array<float> camZs = na
        array<float> screenXs = na
        array<float> screenYs = na
        float meshAvgDepth = 0.0

        if viewDirty
            camXs := array.new<float>()
            camYs := array.new<float>()
            camZs := array.new<float>()
            screenXs := array.new<float>()
            screenYs := array.new<float>()
            float meshDepthSum = 0.0
            // Extract camera basis scalars for inlined dot products
            float camPosX = camPos.x
            float camPosY = camPos.y
            float camPosZ = camPos.z
            float rightX = right.x, float rightY = right.y, float rightZ = right.z
            float upX = up.x, float upY = up.y, float upZ = up.z
            float fwdX = forward.x, float fwdY = forward.y, float fwdZ = forward.z
            for i = 0 to worldVerts.size() - 1
                Vec3 w = worldVerts.get(i)
                float wx = w.x
                float wy = w.y
                float wz = w.z
                // To camera space: inline subtraction and dot products
                float relX = wx - camPosX
                float relY = wy - camPosY
                float relZ = wz - camPosZ
                float cvx = relX * rightX + relY * rightY + relZ * rightZ
                float cvy = relX * upX    + relY * upY    + relZ * upZ
                float cvz = relX * fwdX   + relY * fwdY   + relZ * fwdZ
                camXs.push(cvx)
                camYs.push(cvy)
                camZs.push(cvz)
                meshDepthSum += cvz
                float denom = cvz + fov
                if denom <= 0.0
                    denom := NEAR_PLANE_EPSILON
                float sx = cvx * fov / denom
                float sy = cvy * fov / denom
                screenXs.push(sx)
                screenYs.push(sy)
            meshAvgDepth := mesh.vertices.size() > 0 ? meshDepthSum / float(mesh.vertices.size()) : 0.0
            // Store view cache
            mesh._cacheScreenXs := screenXs
            mesh._cacheScreenYs := screenYs
            mesh._cacheCamXs := camXs
            mesh._cacheCamYs := camYs
            mesh._cacheCamZs := camZs
            mesh._cacheMeshAvgDepth := meshAvgDepth
            mesh._cacheViewCamPosX := scene.camera.position.x
            mesh._cacheViewCamPosY := scene.camera.position.y
            mesh._cacheViewCamPosZ := scene.camera.position.z
            mesh._cacheViewCamTgtX := scene.camera.target.x
            mesh._cacheViewCamTgtY := scene.camera.target.y
            mesh._cacheViewCamTgtZ := scene.camera.target.z
            mesh._cacheViewFov := scene.camera.fov
        else
            // Reuse cached projection
            screenXs := mesh._cacheScreenXs
            screenYs := mesh._cacheScreenYs
            camXs := mesh._cacheCamXs
            camYs := mesh._cacheCamYs
            camZs := mesh._cacheCamZs
            meshAvgDepth := mesh._cacheMeshAvgDepth

        // Always rebuild chart.points (time changes every bar)
        array<chart.point> screenVerts = array.new<chart.point>()
        for i = 0 to screenXs.size() - 1
            screenVerts.push(chart.point.from_time(baseTime + _clampOffset(int(math.round(screenXs.get(i)))) * barMs, screenYs.get(i) * scene.yScale + fov + scene.yOffset))

        // Wireframe meshes are topology-only; cache their edge walk once and reuse it.
        // This avoids the per-frame face/edge rebuild cost that becomes prohibitive on dense meshes.
        if mesh.style == "wireframe"
            if na(mesh.wirePath)
                mesh.wirePath := _wireBuildPath(mesh)

            color wireCol = mesh.faces.size() > 0 ? mesh.faces.get(0).col : color.white
            int    wireLW = mesh.lineWidth
            string wireLS = mesh.lineStyle
            if mesh.wirePath.size() > 0
                array<chart.point> componentPath = array.new<chart.point>()
                for pi = 0 to mesh.wirePath.size() - 1
                    int pathIdx = mesh.wirePath.get(pi)
                    if pathIdx == -1
                        if componentPath.size() > 1
                            _DrawFace dfW = _DrawFace.new(componentPath, wireCol, meshAvgDepth, "wireframe", false)
                            dfW.lineWidth := wireLW
                            dfW.lineStyle := wireLS
                            drawList.push(dfW)
                        componentPath := array.new<chart.point>()
                    else
                        componentPath.push(screenVerts.get(pathIdx))
                if componentPath.size() > 1
                    _DrawFace dfW = _DrawFace.new(componentPath, wireCol, meshAvgDepth, "wireframe", false)
                    dfW.lineWidth := wireLW
                    dfW.lineStyle := wireLS
                    drawList.push(dfW)
            continue

        // Shared face preprocessing for solid and wireframe_front styles.
        // Both need: normal, centroid, back-face culling, depth check.
        // Only the output diverges: wireframe_front -> drawList, solid -> deferred solidList.
        bool isCulledWire = mesh.style == "wireframe_front"
        color wfCol = isCulledWire and mesh.faces.size() > 0 ? mesh.faces.get(0).col : color(na)
        bool useDepthGroups = false
        if not na(mesh._depthGroupFaceEnds)
            useDepthGroups := mesh._depthGroupFaceEnds.size() > 0

        // Face cache: skip full preprocessing when view + world + culling are unchanged
        int cullingStamp = culling ? 1 : 0
        bool faceCacheDirty = viewDirty or isCulledWire or
          na(mesh._cacheFaceData) or
          na(mesh._cacheFaceCullingStamp) or
          mesh._cacheFaceCullingStamp != cullingStamp

        if not faceCacheDirty
            // Reconstruct solidList from cached face data
            _FaceCacheData fc = mesh._cacheFaceData
            if fc.origIdx.size() > 0
                for i = 0 to fc.origIdx.size() - 1
                    int fIdx = fc.origIdx.get(i)
                    Face face = mesh.faces.get(fIdx)
                    solidList.push(_SolidDesc.new(
                      fc.depths.get(i), face.col, face.vi, screenVerts, screenXs, screenYs,
                      fc.cx.get(i), fc.cy.get(i), fc.cz.get(i),
                      fc.nx.get(i), fc.ny.get(i), fc.nz.get(i), meshCounter,
                      fc.cpNx.get(i), fc.cpNy.get(i), fc.cpNz.get(i), fc.cpNum.get(i),
                      fc.sxMin.get(i), fc.sxMax.get(i), fc.syMin.get(i), fc.syMax.get(i),
                      mesh.drawMode))
        else
            // Full face preprocessing - cache results for solid meshes
            _FaceCacheData fc = _FaceCacheData.new(
              array.new<int>(), array.new<float>(),
              array.new<float>(), array.new<float>(), array.new<float>(),
              array.new<float>(), array.new<float>(), array.new<float>(),
              array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(),
              array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>())
            int faceIdx = -1
            int depthGroupIdx = na
            float depthGroupMax = na
            for face in mesh.faces
                faceIdx += 1
                if face.vi.size() < 3
                    continue

                // Face normal via inlined cross product of first two edges
                int vi0 = face.vi.get(0), int vi1 = face.vi.get(1), int vi2 = face.vi.get(2)
                Vec3 wv0 = worldVerts.get(vi0)
                Vec3 wv1 = worldVerts.get(vi1)
                Vec3 wv2 = worldVerts.get(vi2)
                float e1x = wv1.x - wv0.x
                float e1y = wv1.y - wv0.y
                float e1z = wv1.z - wv0.z
                float e2x = wv2.x - wv0.x
                float e2y = wv2.y - wv0.y
                float e2z = wv2.z - wv0.z
                float nx  = e1y * e2z - e1z * e2y
                float ny  = e1z * e2x - e1x * e2z
                float nz  = e1x * e2y - e1y * e2x

                // Centroid in world space and average depth in camera space
                int viSize = face.vi.size()
                float wSumX = 0.0
                float wSumY = 0.0
                float wSumZ = 0.0
                float cSumZ = 0.0
                float sxMin =  1e10
                float sxMax = -1e10
                float syMin =  1e10
                float syMax = -1e10
                if viSize == 3
                    wSumX := wv0.x + wv1.x + wv2.x
                    wSumY := wv0.y + wv1.y + wv2.y
                    wSumZ := wv0.z + wv1.z + wv2.z
                    float cz0 = camZs.get(vi0), float cz1 = camZs.get(vi1), float cz2 = camZs.get(vi2)
                    cSumZ := cz0 + cz1 + cz2
                    if nearPlaneRisk and (cz0 < nearPlaneThresh or cz1 < nearPlaneThresh or cz2 < nearPlaneThresh)
                        continue
                    float fsx0 = screenXs.get(vi0), float fsx1 = screenXs.get(vi1), float fsx2 = screenXs.get(vi2)
                    float fsy0 = screenYs.get(vi0), float fsy1 = screenYs.get(vi1), float fsy2 = screenYs.get(vi2)
                    sxMin := math.min(fsx0, math.min(fsx1, fsx2))
                    sxMax := math.max(fsx0, math.max(fsx1, fsx2))
                    syMin := math.min(fsy0, math.min(fsy1, fsy2))
                    syMax := math.max(fsy0, math.max(fsy1, fsy2))
                else if viSize == 4
                    int vi3 = face.vi.get(3)
                    Vec3 wv3 = worldVerts.get(vi3)
                    wSumX := wv0.x + wv1.x + wv2.x + wv3.x
                    wSumY := wv0.y + wv1.y + wv2.y + wv3.y
                    wSumZ := wv0.z + wv1.z + wv2.z + wv3.z
                    float cz0 = camZs.get(vi0), float cz1 = camZs.get(vi1)
                    float cz2 = camZs.get(vi2), float cz3 = camZs.get(vi3)
                    cSumZ := cz0 + cz1 + cz2 + cz3
                    if nearPlaneRisk and (cz0 < nearPlaneThresh or cz1 < nearPlaneThresh or cz2 < nearPlaneThresh or cz3 < nearPlaneThresh)
                        continue
                    float fsx0 = screenXs.get(vi0), float fsx1 = screenXs.get(vi1)
                    float fsx2 = screenXs.get(vi2), float fsx3 = screenXs.get(vi3)
                    float fsy0 = screenYs.get(vi0), float fsy1 = screenYs.get(vi1)
                    float fsy2 = screenYs.get(vi2), float fsy3 = screenYs.get(vi3)
                    sxMin := math.min(math.min(fsx0, fsx1), math.min(fsx2, fsx3))
                    sxMax := math.max(math.max(fsx0, fsx1), math.max(fsx2, fsx3))
                    syMin := math.min(math.min(fsy0, fsy1), math.min(fsy2, fsy3))
                    syMax := math.max(math.max(fsy0, fsy1), math.max(fsy2, fsy3))
                else
                    float czMin = 1e10
                    for idx in face.vi
                        Vec3 wv = worldVerts.get(idx)
                        wSumX += wv.x
                        wSumY += wv.y
                        wSumZ += wv.z
                        float czV = camZs.get(idx)
                        cSumZ += czV
                        if nearPlaneRisk and czV < czMin
                            czMin := czV
                        float sxv = screenXs.get(idx)
                        float syv = screenYs.get(idx)
                        if sxv < sxMin
                            sxMin := sxv
                        if sxv > sxMax
                            sxMax := sxv
                        if syv < syMin
                            syMin := syv
                        if syv > syMax
                            syMax := syv
                    if nearPlaneRisk and czMin < nearPlaneThresh
                        continue
                float invN = 1.0 / float(viSize)

                float cv0x = camXs.get(vi0)
                float cv0y = camYs.get(vi0)
                float cv0z = camZs.get(vi0)
                float cv1x = camXs.get(vi1)
                float cv1y = camYs.get(vi1)
                float cv1z = camZs.get(vi1)
                float cv2x = camXs.get(vi2)
                float cv2y = camYs.get(vi2)
                float cv2z = camZs.get(vi2)
                float ce1x = cv1x - cv0x
                float ce1y = cv1y - cv0y
                float ce1z = cv1z - cv0z
                float ce2x = cv2x - cv0x
                float ce2y = cv2y - cv0y
                float ce2z = cv2z - cv0z
                float camPlaneNx = ce1y * ce2z - ce1z * ce2y
                float camPlaneNy = ce1z * ce2x - ce1x * ce2z
                float camPlaneNz = ce1x * ce2y - ce1y * ce2x
                float camPlaneNum = camPlaneNx * cv0x + camPlaneNy * cv0y + camPlaneNz * (cv0z + fov)

                // Back-face culling: viewRay = centroid - eyePos, dot with normal
                float vrx = wSumX * invN - eyePos.x
                float vry = wSumY * invN - eyePos.y
                float vrz = wSumZ * invN - eyePos.z
                if culling and nx * vrx + ny * vry + nz * vrz >= 0.0
                    continue

                float avgDepth = cSumZ * invN
                if avgDepth < -fov * BEHIND_CAMERA_FACTOR
                    continue
                float sortDepth = avgDepth
                if useDepthGroups
                    // Find which depth group this face belongs to via boundary arrays
                    if na(depthGroupIdx) or faceIdx >= mesh._depthGroupFaceEnds.get(depthGroupIdx)
                        // Advance to the group that contains this faceIdx
                        if na(depthGroupIdx)
                            depthGroupIdx := 0
                        while depthGroupIdx < mesh._depthGroupFaceEnds.size() and faceIdx >= mesh._depthGroupFaceEnds.get(depthGroupIdx)
                            depthGroupIdx += 1
                        
                        depthGroupMax := -1e10
                        int groupBaseVi = depthGroupIdx > 0 ? mesh._depthGroupVertEnds.get(depthGroupIdx - 1) : 0
                        int groupLastVi = mesh._depthGroupVertEnds.get(depthGroupIdx) - 1
                        if groupLastVi >= worldVerts.size()
                            groupLastVi := worldVerts.size() - 1
                        if groupBaseVi <= groupLastVi
                            for groupVi = groupBaseVi to groupLastVi
                                Vec3 wv = worldVerts.get(groupVi)
                                float dX = wv.x - camPos.x, dY = wv.y - camPos.y, dZ = wv.z - camPos.z
                                depthGroupMax := math.max(depthGroupMax, math.sqrt(dX*dX + dY*dY + dZ*dZ))
                    if not na(depthGroupMax)
                        sortDepth := depthGroupMax + avgDepth * DEPTH_TIE_EPSILON

                // Style-specific output
                if isCulledWire
                    array<chart.point> projected = array.new<chart.point>()
                    for idx in face.vi
                        projected.push(screenVerts.get(idx))
                    _DrawFace dfWF = _DrawFace.new(projected, wfCol, sortDepth, "wireframe", true)
                    dfWF.lineWidth := mesh.lineWidth
                    dfWF.lineStyle := mesh.lineStyle
                    drawList.push(dfWF)
                else
                    float fcx = wSumX * invN
                    float fcy = wSumY * invN
                    float fcz = wSumZ * invN
                    _SolidDesc sdNew = _SolidDesc.new(sortDepth, face.col, face.vi, screenVerts, screenXs, screenYs,
                      fcx, fcy, fcz,
                      nx, ny, nz, meshCounter,
                      camPlaneNx, camPlaneNy, camPlaneNz, camPlaneNum,
                      sxMin, sxMax, syMin, syMax,
                      mesh.drawMode)
                    sdNew.lineWidth := mesh.lineWidth
                    sdNew.lineStyle := mesh.lineStyle
                    solidList.push(sdNew)
                    // Cache face data
                    fc.origIdx.push(faceIdx)
                    fc.depths.push(sortDepth)
                    fc.cx.push(fcx)
                    fc.cy.push(fcy)
                    fc.cz.push(fcz)
                    fc.nx.push(nx)
                    fc.ny.push(ny)
                    fc.nz.push(nz)
                    fc.cpNx.push(camPlaneNx)
                    fc.cpNy.push(camPlaneNy)
                    fc.cpNz.push(camPlaneNz)
                    fc.cpNum.push(camPlaneNum)
                    fc.sxMin.push(sxMin)
                    fc.sxMax.push(sxMax)
                    fc.syMin.push(syMin)
                    fc.syMax.push(syMax)
            // Store face cache (solid meshes only)
            if not isCulledWire
                mesh._cacheFaceData := fc
                mesh._cacheFaceCullingStamp := cullingStamp

    float yBase = fov + scene.yOffset

    // --- Pass 2: Select receivers - sort by depth, cut to maxFaces ---
    if solidList.size() > 0
        array<int> solidSorted = solidList.sort_indices(order.ascending, sort_field = 0)
        array.reverse(solidSorted)
        array<int> selectedSolidIndices = not occlusion ? _keepNearestSorted(solidSorted, maxFaces) : _refinePoolSelection(solidList, solidSorted, maxFaces, fov, occlusionRaster)

        // --- Pass 3: Lighting + Shadows (deferred - only on selected faces) ---
        if lighting
            float ldx = ld.x
            float ldy = ld.y
            float ldz = ld.z
            bool isPoint = lightMode == "point" and not na(lightPos)
            float lpx = isPoint ? lightPos.x : 0.0
            float lpy = isPoint ? lightPos.y : 0.0
            float lpz = isPoint ? lightPos.z : 0.0
            // Build shadow grid for directional lights (O(M) build, O(K) per query)
            Vec3 sgLightRight = na
            Vec3 sgLightUp    = na
            map<int, int> sgCellStarts  = map.new<int, int>()
            map<int, int> sgCellCounts  = map.new<int, int>()
            array<int> sgCellMeshes     = array.new<int>()
            float sgCellSize  = 1.0
            float sgGridRange = 1.0
            bool useShadowGrid = shadowEnabled and not isPoint and meshBCX.size() > 3
            if useShadowGrid
                // Shadow grid cache: skip rebuild when light direction + mesh bounds unchanged
                float boundsSum = 0.0
                if meshBCX.size() > 0
                    for i = 0 to meshBCX.size() - 1
                        boundsSum += meshBCX.get(i) + meshBCY.get(i) + meshBCZ.get(i) + meshBR.get(i)
                bool sgCacheHit = not na(scene.light) and
                  not na(scene.light._sgCacheLdX) and
                  ldx == scene.light._sgCacheLdX and
                  ldy == scene.light._sgCacheLdY and
                  ldz == scene.light._sgCacheLdZ and
                  boundsSum == scene.light._sgCacheBoundsSum
                if sgCacheHit
                    sgLightRight := scene.light._sgCacheLightRight
                    sgLightUp    := scene.light._sgCacheLightUp
                    sgCellStarts := scene.light._sgCacheCellStarts
                    sgCellCounts := scene.light._sgCacheCellCounts
                    sgCellMeshes := scene.light._sgCacheCellMeshes
                    sgCellSize   := scene.light._sgCacheCellSize
                    sgGridRange  := scene.light._sgCacheGridRange
                else
                    Vec3 worldUp = math.abs(ld.dot(Vec3.new(0.0, 1.0, 0.0))) > UP_VECTOR_DEGENERACY ? Vec3.new(0.0, 0.0, 1.0) : Vec3.new(0.0, 1.0, 0.0)
                    Vec3 lRight = ld.cross(worldUp).normalize()
                    Vec3 lUp = lRight.cross(ld)
                    sgLightRight := lRight
                    sgLightUp    := lUp
                    [cStarts, cCounts, cMeshes, cSize, gRange] = _buildShadowGrid(
                      ld, lRight, lUp,
                      meshBCX, meshBCY, meshBCZ, meshBR, meshIsSolid)
                    sgCellStarts  := cStarts
                    sgCellCounts  := cCounts
                    sgCellMeshes  := cMeshes
                    sgCellSize    := cSize
                    sgGridRange   := gRange
                    // Store in cache
                    if not na(scene.light)
                        scene.light._sgCacheLdX        := ldx
                        scene.light._sgCacheLdY        := ldy
                        scene.light._sgCacheLdZ        := ldz
                        scene.light._sgCacheBoundsSum  := boundsSum
                        scene.light._sgCacheLightRight := lRight
                        scene.light._sgCacheLightUp    := lUp
                        scene.light._sgCacheCellStarts := cStarts
                        scene.light._sgCacheCellCounts := cCounts
                        scene.light._sgCacheCellMeshes := cMeshes
                        scene.light._sgCacheCellSize   := cSize
                        scene.light._sgCacheGridRange  := gRange
            if selectedSolidIndices.size() > 0
                for solidIndex in selectedSolidIndices
                    _SolidDesc sd = solidList.get(solidIndex)
                    float nLen = math.sqrt(sd.nx * sd.nx + sd.ny * sd.ny + sd.nz * sd.nz)
                    // Compute per-face light direction for point lights; reuse for diffuse + shadow
                    // Convention: flx/fly/flz points FROM light TO surface (same as directional ld)
                    float flx = ldx
                    float fly = ldy
                    float flz = ldz
                    float toLLen = 1e10
                    if isPoint
                        float tlx = sd.cx - lpx
                        float tly = sd.cy - lpy
                        float tlz = sd.cz - lpz
                        toLLen := math.sqrt(tlx * tlx + tly * tly + tlz * tlz)
                        if toLLen > 0.0
                            float invL = 1.0 / toLLen
                            flx := tlx * invL
                            fly := tly * invL
                            flz := tlz * invL
                    float rawDiffuse = nLen > 0.0 ? -(sd.nx * flx + sd.ny * fly + sd.nz * flz) / nLen : 0.0
                    float halfLambert = rawDiffuse * 0.5 + 0.5
                    float diffuse = halfLambert * halfLambert
                    // Shadow query: skip if shadows off or face is facing away from light
                    float vis = 1.0
                    if shadowEnabled and rawDiffuse > 0.0
                        // Compute ray origin (optionally biased along normal for self-shadow)
                        float rpx = sd.cx
                        float rpy = sd.cy
                        float rpz = sd.cz
                        if selfShadow and nLen > 0.0
                            float invNLen = shadowBias / nLen
                            rpx += sd.nx * invNLen
                            rpy += sd.ny * invNLen
                            rpz += sd.nz * invNLen
                        if useShadowGrid
                            vis := _isShadowedGrid(rpx, rpy, rpz, -flx, -fly, -flz, toLLen,
                              sd.meshIdx, selfShadow, meshBCX, meshBCY, meshBCZ, meshBR,
                              sgLightRight, sgLightUp,
                              sgCellStarts, sgCellCounts, sgCellMeshes,
                              sgCellSize, sgGridRange)
                        else
                            vis := _isShadowed(rpx, rpy, rpz, -flx, -fly, -flz, toLLen,
                              sd.meshIdx, selfShadow, meshBCX, meshBCY, meshBCZ, meshBR,
                              meshIsSolid)
                    float brightness = amb + diffuse * (1.0 - amb) * ((1.0 - shadowStr) + shadowStr * vis)
                    sd.col := colorBrightness(sd.col, brightness)

        // --- Pass 4: Materialize chart.points and push to drawList ---
        if selectedSolidIndices.size() > 0
            for solidIndex in selectedSolidIndices
                _SolidDesc sd = solidList.get(solidIndex)
                array<chart.point> projected = array.new<chart.point>()
                for idx in sd.vi
                    projected.push(sd.screen.get(idx))
                _DrawFace dfS = _DrawFace.new(projected, sd.col, sd.depth, "solid", true, sd.drawMode)
                dfS.lineWidth := sd.lineWidth
                dfS.lineStyle := sd.lineStyle
                drawList.push(dfS)

    // --- Collect overlay primitives into drawList for depth-sorted rendering ---

    // Label3D collection
    if not na(scene.labels)
        for lbl in scene.labels
            if lbl.visible and not na(lbl.position)
                [pt, depth, vis] = _projectPt(lbl.position.x, lbl.position.y, lbl.position.z, cb, baseTime, barMs, yBase, scene.yScale)
                if vis
                    _DrawFace df = _DrawFace.new(array.from(pt), lbl.textColor, depth, "label3d", false)
                    df._label3d := lbl
                    drawList.push(df)

    // Line3D collection
    if not na(scene.lines3D)
        for ln in scene.lines3D
            if ln.visible and not na(ln.start) and not na(ln.end)
                [sPt, sDepth, sVis] = _projectPt(ln.start.x, ln.start.y, ln.start.z, cb, baseTime, barMs, yBase, scene.yScale)
                [ePt, eDepth, eVis] = _projectPt(ln.end.x, ln.end.y, ln.end.z, cb, baseTime, barMs, yBase, scene.yScale)
                if sVis and eVis
                    _DrawFace df = _DrawFace.new(array.from(sPt, ePt), ln.col, (sDepth + eDepth) * 0.5, "line3d", false)
                    df._line3d := ln
                    drawList.push(df)

    // Polyline3D collection
    if not na(scene.polylines3D)
        for pl in scene.polylines3D
            if pl.visible and not na(pl.points) and pl.points.size() > 0
                array<chart.point> projected = array.new<chart.point>()
                float depthSum = 0.0
                bool allVisible = true
                for pt in pl.points
                    [prjPt, pDepth, pVis] = _projectPt(pt.x, pt.y, pt.z, cb, baseTime, barMs, yBase, scene.yScale)
                    if not pVis
                        allVisible := false
                        break
                    depthSum += pDepth
                    projected.push(prjPt)
                if allVisible
                    _DrawFace df = _DrawFace.new(projected, pl.col, depthSum / pl.points.size(), "polyline3d", pl.closed)
                    df._poly3d := pl
                    drawList.push(df)

    // --- Depth sort ALL scene primitives (painter's algorithm: farthest first) ---
    array<int> sortedIdx = drawList.sort_indices(order.ascending, sort_field = 2)
    array.reverse(sortedIdx)

    // --- Linefill strip state: share rail lines between adjacent faces ---
    line  prevRailA = na
    line  prevRailB = na
    int   prA1x = na
    float prA1y = na
    int   prA2x = na
    float prA2y = na
    int   prB1x = na
    float prB1y = na
    int   prB2x = na
    float prB2y = na

    // --- Draw in depth order. Nearer scene elements are created later, so they sit on top.
    for i = 0 to sortedIdx.size() - 1
        int di = sortedIdx.get(i)
        _DrawFace df = drawList.get(di)
        bool stripActive = false
        if df.style == "wireframe"
            polyline.new(df.pts, closed = df.closed, xloc = xloc.bar_time, line_color = df.col, fill_color = color(na), line_style = df.lineStyle, line_width = df.lineWidth)
            0
        else if df.style == "label3d"
            Label3D lbl = df._label3d
            chart.point pt = df.pts.first()
            label.new(pt.time, pt.price, lbl.txt, xloc = xloc.bar_time,
              color = lbl.bgColor, textcolor = lbl.textColor,
              style = lbl.labelStyle,
              size = lbl.labelSize,
              text_font_family = lbl.fontFamily,
              tooltip = lbl.tooltip)
            0
        else if df.style == "line3d"
            chart.point p1 = df.pts.first()
            chart.point p2 = df.pts.last()
            line.new(p1.time, p1.price, p2.time, p2.price, xloc = xloc.bar_time,
              color = df._line3d.col, width = df._line3d.width, style = df._line3d.lineStyle)
            0
        else if df.style == "polyline3d"
            polyline.new(df.pts, closed = df.closed, xloc = xloc.bar_time,
              line_color = df._poly3d.col, fill_color = df._poly3d.fillColor,
              line_width = df._poly3d.width, line_style = df._poly3d.lineStyle)
            0
        else if df.style == "contour"
            // Contour level band: transparent line hides path, solid fill for terrain
            polyline.new(df.pts, closed = true, xloc = xloc.bar_time, line_color = color.new(df.col, 100), fill_color = df.col)
            0
        else if wireframe
            polyline.new(df.pts, closed = true, xloc = xloc.bar_time, line_color = df.col, fill_color = color(na), line_style = df.lineStyle, line_width = df.lineWidth)
            0
        else if df._drawMode == "linefill"
            // Linefill rendering with strip optimization: share rails between adjacent faces
            int numPts = df.pts.size()
            if numPts >= 4
                chart.point p0 = df.pts.get(0)
                chart.point p1 = df.pts.get(1)
                chart.point p2 = df.pts.get(2)
                chart.point p3 = df.pts.get(3)
                // Test both opposite-edge pairings for segment intersection.
                // Pairing 1: (p0,p1) vs (p3,p2)    Pairing 2: (p0,p3) vs (p1,p2)
                bool cross1 = _segmentsIntersect(
                  p0.time, p0.price, p1.time, p1.price,
                  p3.time, p3.price, p2.time, p2.price)
                bool cross2 = _segmentsIntersect(
                  p0.time, p0.price, p3.time, p3.price,
                  p1.time, p1.price, p2.time, p2.price)
                // Pick valid pairing; prefer wider x-span as tiebreaker
                bool useP1 = true
                if cross1 and not cross2
                    useP1 := false
                else if not cross1 and not cross2
                    int dx01 = math.abs(p1.time - p0.time)
                    int dx03 = math.abs(p3.time - p0.time)
                    useP1 := dx01 >= dx03
                if cross1 and cross2
                    // Degenerate self-intersecting quad - render as two fan triangles
                    color transparentCol2 = color.new(df.col, 100)
                    line lA1 = line.new(p0, p1, xloc = xloc.bar_time, color = transparentCol2)
                    line lA2 = line.new(p0, p2, xloc = xloc.bar_time, color = transparentCol2)
                    linefill.new(lA1, lA2, df.col)
                    line lB2 = line.new(p0, p3, xloc = xloc.bar_time, color = transparentCol2)
                    linefill.new(lA2, lB2, df.col)
                    prevRailA := na
                else
                    // Set rail endpoints from the chosen pairing
                    chart.point rA1 = p0
                    chart.point rA2 = useP1 ? p1 : p3
                    chart.point rB1 = useP1 ? p3 : p1
                    chart.point rB2 = p2
                    // Check if either chosen rail matches a previous rail
                    line reusedLine = na
                    bool reuseOnA = false
                    int reusedDir = 0
                    if not na(prevRailA)
                        int matchDir = _railMatchDir(rA1.time, rA1.price, rA2.time, rA2.price,
                          prA1x, prA1y, prA2x, prA2y)
                        if matchDir != 0
                            reusedLine := prevRailA
                            reuseOnA := true
                            reusedDir := matchDir
                        else
                            matchDir := _railMatchDir(rA1.time, rA1.price, rA2.time, rA2.price,
                              prB1x, prB1y, prB2x, prB2y)
                            if matchDir != 0
                                reusedLine := prevRailB
                                reuseOnA := true
                                reusedDir := matchDir
                            else
                                matchDir := _railMatchDir(rB1.time, rB1.price, rB2.time, rB2.price,
                                  prA1x, prA1y, prA2x, prA2y)
                                if matchDir != 0
                                    reusedLine := prevRailA
                                    reusedDir := matchDir
                                else
                                    matchDir := _railMatchDir(rB1.time, rB1.price, rB2.time, rB2.price,
                                      prB1x, prB1y, prB2x, prB2y)
                                    if matchDir != 0
                                        reusedLine := prevRailB
                                        reusedDir := matchDir
                    // Draw with or without reuse
                    color transparentCol = color.new(df.col, 100)
                    bool reverseRails = reusedDir == -1
                    chart.point a1 = reverseRails ? rA2 : rA1
                    chart.point a2 = reverseRails ? rA1 : rA2
                    chart.point b1 = reverseRails ? rB2 : rB1
                    chart.point b2 = reverseRails ? rB1 : rB2
                    if not na(reusedLine)
                        if reuseOnA
                            line newB = line.new(b1, b2, xloc = xloc.bar_time, color = transparentCol)
                            linefill.new(reusedLine, newB, df.col)
                            prevRailA := reusedLine
                            prevRailB := newB
                        else
                            line newA = line.new(a1, a2, xloc = xloc.bar_time, color = transparentCol)
                            linefill.new(newA, reusedLine, df.col)
                            prevRailA := newA
                            prevRailB := reusedLine
                    else
                        line lA = line.new(a1, a2, xloc = xloc.bar_time, color = transparentCol)
                        line lB = line.new(b1, b2, xloc = xloc.bar_time, color = transparentCol)
                        linefill.new(lA, lB, df.col)
                        prevRailA := lA
                        prevRailB := lB
                    // Store current endpoints for next iteration
                    prA1x := a1.time
                    prA1y := a1.price
                    prA2x := a2.time
                    prA2y := a2.price
                    prB1x := b1.time
                    prB1y := b1.price
                    prB2x := b2.time
                    prB2y := b2.price
                    stripActive := true
            else if numPts == 3
                chart.point p0 = df.pts.get(0)
                chart.point p1 = df.pts.get(1)
                chart.point p2 = df.pts.get(2)
                // Triangle: shared endpoint converges two lines to a point
                line l1 = line.new(p0, p2, xloc = xloc.bar_time, color = color.new(df.col, 100))
                line l2 = line.new(p1, p2, xloc = xloc.bar_time, color = color.new(df.col, 100))
                linefill.new(l1, l2, df.col)
            0
        else
            polyline.new(df.pts, closed = true, xloc = xloc.bar_time, line_color = df.col, fill_color = df.col, line_style = df.lineStyle, line_width = df.lineWidth)
            0
        // Break strip continuity for non-quad-linefill faces
        if not stripActive
            prevRailA := na

    // --- Show light source marker (point lights only) ---
    if not na(scene.light) and scene.light.showSource and scene.light.mode == "point" and not na(scene.light.position)
        Vec3 lp = scene.light.position
        [lpPt, lpDepth, lpVis] = _projectPt(lp.x, lp.y, lp.z, cb, baseTime, barMs, yBase, scene.yScale)
        if lpVis
            label.new(lpPt.time, lpPt.price, "☀", xloc = xloc.bar_time,
              color = color(na), textcolor = color.yellow,
              style = label.style_label_center, size = size.normal)

// ============================================================================
// SECTION 9: Init
// ============================================================================

//@function Creates a new Scene with a default camera.
//          Camera defaults to position (0, 0, 500) looking at origin with fov 800.
//@returns (Scene) A ready-to-use scene
export newScene() =>
    Scene.new(
      array.new<Mesh>(),
      Camera.new(Vec3.new(0.0, 0.0, 500.0), Vec3.new(0.0, 0.0, 0.0), 800.0),
      0,
      0.0,
      Light.new(
        "directional",
        Vec3.new(-0.4, 0.7, -0.5),
        na,
        0.3,
        0.0),
      array.new<Label3D>(),
      array.new<Line3D>(),
      array.new<Polyline3D>(),
      1.0)
