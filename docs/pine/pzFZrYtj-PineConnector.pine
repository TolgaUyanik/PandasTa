// @param debug Turns on/off debug label
// @returns A stop order alert string with valid PC syntax based on supplied parameters
export buystop(  string licenseID, 
                 float entry_price = na, 
                 float entry_pips = na,
                 float entry_pct = na,
				 float vol_lots = na, 
				 float vol_dollar = na,
				 float vol_pct_bal_loss = na,
				 float vol_pct_eq_loss = na,
				 float vol_pct_bal_margin = na,
                 float sl_pips = na, 
                 float sl_price = na,
                 float sl_pct = na,
                 float tp_pips = na, 
                 float tp_price = na,
                 float tp_pct = na,
                 float betrigger = na, 
                 float beoffset = na, 
                 float spread = na, 
                 float trailtrig = na, 
                 float traildist = na, 
                 float trailstep = na, 
                 int atrtimeframe = na, 
