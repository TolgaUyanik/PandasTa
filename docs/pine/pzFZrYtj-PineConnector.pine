                 int atrtrigger = na, 
                 string symbol = syminfo.ticker, 
                 float accfilter = na, 
                 string comment = "", 
                 string secret = "", 
                 string freq = "all", 
                 bool debug = false) =>
    string _return = stop_order(licenseID, true, entry_price, entry_pips, entry_pct, vol_lots, vol_dollar, vol_pct_bal_loss, vol_pct_eq_loss, 
                                 vol_pct_bal_margin, sl_pips, sl_price, sl_pct, tp_pips, tp_price, tp_pct, betrigger, 
                                 beoffset, spread, trailtrig, traildist, trailstep, atrtimeframe, atrperiod, atrmultiplier, atrshift, 
                                 atrtrigger, symbol, accfilter, comment, secret, freq, debug)

