                        float traildist = na, 
                        float trailstep = na, 
                        int atrtimeframe = na, 
                        int atrperiod = na, 
                        float atrmultiplier = na, 
                        int atrshift = na, 
                        int atrtrigger = na, 
                        string symbol = syminfo.ticker, 
                        float accfilter = na, 
                        string comment = "", 
                        string secret = "", 
