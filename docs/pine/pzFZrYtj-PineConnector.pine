// @function Updates the stop loss and/or take profit of any open trade on the given symbol with the given values. Required params: licenseID, sl and/or tp.
// @param licenseID Your PC license ID 
// @param breakEven If enabled the SL=0 command will be sent alongside any other parameters
// @param sl_pips Sets the Stop-Loss a specific number of pips away from the entry price
// @param sl_price Sets the Stop-Loss at a specific absolute price level
// @param sl_pct Sets the Stop-Loss a percentage distance away from the entry price
// @param tp_pips Sets the Take-Profit a specific number of pips away from the entry price
// @param tp_price Sets the Take-Profit at a specific absolute price level
// @param tp_pct Sets the Take-Profit a percentage distance away from the entry price
// @param symbol Symbol to act on (defaults to current symbol)
// @param comment Optional comment to include (max 20 characters)
// @param secret Optional secret key (must be enabled in dashboard)
// @param freq Alert frequency. Default = "all", options = "once_per_bar", "once_per_bar_close" and "none"
// @param debug Turns on/off debug label
// @returns The required alert syntax as a string
export _newsltporder(string licenseID, string command,
                bool breakEven = false,
                float sl_pips = na, 
                float sl_price = na,
                float sl_pct = na,
                float tp_pips = na, 
                float tp_price = na,
                float tp_pct = na,
                string symbol = syminfo.ticker,
                string comment = "", 
                string secret = "", 
                string freq = "all", 
                bool debug = false) =>
    _params = ""
    if (breakEven)
        _params := _params + ",sl=0"
    else if (not na(sl_pips))
        _params := _params + ",sl_pips=" + truncate(sl_pips)
    else if (not na(sl_price))
        _params := _params + ",sl_price=" + truncate(sl_price)
    else if (not na(sl_pct))
        _params := _params + ",sl_pct=" + truncate(sl_pct)
    if (not na0(tp_pips))
        _params := _params + ",tp_pips=" + truncate(tp_pips)
    else if (not na0(tp_price))
        _params := _params + ",tp_price=" + truncate(tp_price)
    else if (not na0(tp_pct))
        _params := _params + ",tp_pct=" + truncate(tp_pct)
    string _return = order(licenseID, command, symbol, _params, na, comment, secret, freq, debug)

// @function Updates the stop loss and/or take profit of any open long trades on the given symbol with the given values. Required params: licenseID, sl and/or tp.
// @param licenseID Your PC license ID 
// @param breakEven If enabled the SL=0 command will be sent alongside any other parameters
// @param sl_pips Sets the Stop-Loss a specific number of pips away from the entry price
// @param sl_price Sets the Stop-Loss at a specific absolute price level
// @param sl_pct Sets the Stop-Loss a percentage distance away from the entry price
// @param tp_pips Sets the Take-Profit a specific number of pips away from the entry price
// @param tp_price Sets the Take-Profit at a specific absolute price level
// @param tp_pct Sets the Take-Profit a percentage distance away from the entry price
// @param symbol Symbol to act on (defaults to current symbol)
// @param comment Optional comment to include (max 20 characters)
// @param secret Optional secret key (must be enabled in dashboard)
// @param freq Alert frequency. Default = "all", options = "once_per_bar", "once_per_bar_close" and "none"
// @param debug Turns on/off debug label
// @returns The required alert syntax as a string
export newsltplong(string licenseID, 
                bool breakEven = false,
                float sl_pips = na, 
                float sl_price = na,
                float sl_pct = na,
                float tp_pips = na, 
                float tp_price = na,
                float tp_pct = na,
                string symbol = syminfo.ticker,
                string comment = "", 
                string secret = "", 
                string freq = "all", 
                bool debug = false) =>
    string _return = _newsltporder(licenseID, "newsltplong", breakEven, sl_pips, sl_price, sl_pct, tp_pips, tp_price, tp_pct, symbol, comment, secret, freq, debug)

// @function Updates the stop loss and/or take profit of any open short trades on the given symbol with the given values. Required params: licenseID, sl and/or tp.
// @param licenseID Your PC license ID 
// @param breakEven If enabled the SL=0 command will be sent alongside any other parameters
// @param sl Stop loss pips or price (according to EA settings)
// @param tp Take profit pips or price (according to EA settings)
// @param symbol Symbol to act on (defaults to current symbol)
// @param comment Optional comment to include (max 20 characters)
// @param secret Optional secret key (must be enabled in dashboard)
// @param freq Alert frequency. Default = "all", options = "once_per_bar", "once_per_bar_close" and "none"
// @param debug Turns on/off debug label
// @returns The required alert syntax as a string
export newsltpshort( string licenseID,
                bool breakEven = false,
                float sl_pips = na, 
                float sl_price = na,
                float sl_pct = na,
                float tp_pips = na, 
                float tp_price = na,
                float tp_pct = na,
                string symbol = syminfo.ticker, 
                string comment = "", 
                string secret = "", 
                string freq = "all", 
                bool debug = false) =>
    string _return = _newsltporder(licenseID, "newsltpshort", breakEven, sl_pips, sl_price, sl_pct, tp_pips, tp_price, tp_pct, symbol, comment, secret, freq, debug)

// @function Close a percentage of open long positions (according to EA settings). Required params: licenseID.
// @param licenseID Your PC license ID 
// @param symbol Symbol to act on (defaults to current symbol)
// @param comment Optional comment to include (max 20 characters)
// @param secret Optional secret key (must be enabled in dashboard)
// @param freq Alert frequency. Default = "all", options = "once_per_bar", "once_per_bar_close" and "none"
// @param debug Turns on/off debug label
// @returns The required alert syntax as a string
export closelongpct( string licenseID, 
                    string symbol = syminfo.ticker, 
                    bool breakEvenAfter = false,
                    string comment = "", 
                    string secret = "", 
                    string freq = "all", 
                    bool debug = false) =>
    string _return = order(licenseID, "closelongpct", symbol, breakEvenAfter ? "sl=0" : "", na, comment, secret, freq, debug)

// @function Close a percentage of open short positions (according to EA settings). Required params: licenseID.
// @param licenseID Your PC license ID 
// @param symbol Symbol to act on (defaults to current symbol)
// @param comment Optional comment to include (max 20 characters)
// @param secret Optional secret key (must be enabled in dashboard)
// @param freq Alert frequency. Default = "all", options = "once_per_bar", "once_per_bar_close" and "none"
// @param debug Turns on/off debug label
// @returns The required alert syntax as a string
export closeshortpct(string licenseID, 
                    string symbol = syminfo.ticker, 
                    bool breakEvenAfter = false,
                    string comment = "", 
                    string secret = "", 
                    string freq = "all", 
                    bool debug = false) =>
    string _return = order(licenseID, "closeshortpct", symbol, breakEvenAfter ? "sl=0" : "", na, comment, secret, freq, debug)
 
// @function Close all open long contracts on the current symbol until the given risk value is remaining. Required params: licenseID, risk.
// @param licenseID Your PC license ID 
// @param risk Is a required parameter and represents the volume to close.
// @param symbol Symbol to act on (defaults to current symbol)
// @param breakEvenAfter Move SL to break-even on remainder of position?
// @param comment Optional comment to include (max 20 characters)
// @param secret Optional secret key (must be enabled in dashboard)
// @param freq Alert frequency. Default = "all", options = "once_per_bar", "once_per_bar_close" and "none"
// @param debug Turns on/off debug label
// @returns The required alert syntax as a string
export closelongvol( string licenseID, 
                    float risk, 
                    string symbol = syminfo.ticker, 
                    bool breakEvenAfter = false,
                    string comment = "", 
                    string secret = "", 
                    string freq = "all", 
                    bool debug = false) =>
    string _return = order(licenseID, "closelongvol", symbol, ("risk=" + str.tostring(risk)) + (breakEvenAfter ? ",sl=0" : ""), na, comment, secret, freq, debug)

// @function Close all open short contracts on the current symbol until the given risk value is remaining. Required params: licenseID, risk.
// @param licenseID Your PC license ID 
// @param risk Is a required parameter and represents the volume to close.
// @param symbol Symbol to act on (defaults to current symbol)
// @param breakEvenAfter Move SL to break-even on remainder of position?
// @param comment Optional comment to include (max 20 characters)
// @param secret Optional secret key (must be enabled in dashboard)
// @param freq Alert frequency. Default = "all", options = "once_per_bar", "once_per_bar_close" and "none"
// @param debug Turns on/off debug label
// @returns The required alert syntax as a string
export closeshortvol(string licenseID, 
                    float risk, 
                    string symbol = syminfo.ticker, 
                    bool breakEvenAfter = false,
                    string comment = "", 
                    string secret = "", 
                    string freq = "all", 
                    bool debug = false) =>
    string _return = order(licenseID, "closeshortvol", symbol, ("risk=" + str.tostring(risk)) + (breakEvenAfter ? ",sl=0" : ""), na, comment, secret, freq, debug)

