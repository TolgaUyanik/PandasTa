    string _return = market_order(licenseID, false, vol_lots, vol_dollar, vol_pct_bal_loss, vol_pct_eq_loss, 
         vol_pct_bal_margin, sl_pips, sl_price, sl_pct, tp_pips, tp_price, tp_pct, betrigger, 
