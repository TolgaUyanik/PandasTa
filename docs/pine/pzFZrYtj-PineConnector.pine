library("PineConnector")

//=========================================================================
//! MISC FUNCTIONS 
//{

// @function Usage: pc.buy(pc_id, freq=pc.all())
// @returns "all"
export all() => "all"

// @function Usage: pc.buy(pc_id, freq=pc.once_per_bar())
// @returns "once_per_bar"
export once_per_bar() => "once_per_bar"

// @function Usage: pc.buy(pc_id, freq=pc.once_per_bar_close())
// @returns "once_per_bar_close"
export once_per_bar_close() => "once_per_bar_close"

// @function Checks if given value is either 'na' or 0. Useful for streamlining scripts with float user setting inputs which default values to 0 since na is unavailable as a user input default.
// @param value The value to check 
// @returns True if the given value is 0 or na
export na0(float value) =>
    bool _return = na(value) or value == 0

// @function Calculates how many decimals are on the quote price of the current market.
// @returns The current decimal places on the market quote price
export getDecimals() => 
    var int _return = na
    if (na(_return))
        price_str = str.tostring(close)
        dot_pos = str.pos(price_str, ".")
        if dot_pos != -1
            _return := str.length(price_str) - dot_pos - 1
    _return

// @function Truncates the given number. Required params: mumber.
// @param number Number to truncate 
// @param decimals Decimal places to cut down to 
// @returns The input number, but as a string truncated to X decimals
export truncate(float number, int decimals = -1) =>
    float _decimals = decimals
    if (_decimals == -1)
        _decimals := getDecimals()
    _formatter = "{0,number,#."
    for i = 0 to _decimals - 1 by 1
        _formatter := _formatter + "#"
    string _return = str.format(_formatter + "}", number)

// @function PineConnector pip size (PC defines 1 pip = 10 points)
// @param point Point size (defaults to syminfo.mintick)
// @param pip_points How many points make a pip (default 10)
export pc_pip_size(float point = syminfo.mintick, int pip_points = 10) =>
    point * pip_points

// @function Convert PineConnector pips to price distance
// @param pc_pips PineConnector pips to calculate into price difference
// @param point Defaults to syminfo.mintick
export pc_pips_to_price(float pc_pips, float point = syminfo.mintick) =>
    pc_pips * pc_pip_size(point)

// @function Convert price distance into PineConnector pips
// @param price_dist Price distance to calculate into PineConnector Pips
// @param point Defaults to syminfo.mintick
export price_to_pc_pips(float price_dist, float point = syminfo.mintick) =>
    price_dist / pc_pip_size(point)

// @function Calculates the pip size of the current market.
// @param multiplier The mintick point multiplier (1 by default, 10 for FX/Crypto/CFD but can be used to override when certain markets require)
// @returns The pip size for the current market
export getPipSize(int multiplier = 1) => 
    float _return = syminfo.mintick * ((multiplier == 1 and (syminfo.type == "forex" or syminfo.type == "crypto" or syminfo.type == "cfd")) ? 10 : multiplier)

// @function Converts pips into whole numbers. Required params: number.
// @param number The pip number to convert into a whole number
// @returns The converted number
export toWhole(float number) =>
    float _return = number / getPipSize() / syminfo.pointvalue

// @function Converts whole numbers back into pips. Required params: number.
// @param number The whole number to convert into pips
// @returns The converted number
export toPips(float number) =>
    float _return = number * syminfo.mintick * (syminfo.type == "forex" or syminfo.type == "crypto" ? 10 : 1)

// @function Prints to console and generates a debug label with the given text. Required params: txt.
// @param txt Text to display
// @param tooltip Tooltip to display (optional)
// @param displayLabel Turns on/off chart label (default: off)
// @returns Nothing
export debug(string txt, string tooltip = "", bool displayLabel = false) =>
    log.warning("\n" + txt)
    if (displayLabel)
        label.new(bar_index, high, txt, tooltip=tooltip, color=color.white, style=label.style_label_down, textcolor=color.black, force_overlay=true)
    
// @function Generates an alert string. Required params: licenseID, command.
// @param licenseID Your PC license ID 
// @param command Command to send
// @param symbol The symbol to trigger this order on
// @param parameters Other optional parameters to include
// @param accfilter Optional minimum account balance filter
// @param comment Optional comment (maximum 20 characters)
// @param secret Optional secret key (must be enabled in dashboard)
// @param freq Alert frequency. Default = "all", options = "once_per_bar", "once_per_bar_close" and "none"
// @param debug Turns on/off debug label
// @returns An alert string with valid PC syntax based on supplied parameters
export order(string licenseID, 
            string command, 
            string symbol = syminfo.ticker, 
            string parameters = "", 
            float accfilter = na, 
            string comment = "", 
            string secret = "", 
            string freq = "all", 
            bool debug = true) =>
    string _return = licenseID + "," + command + "," + symbol
    if (parameters != "")
        _return := _return + (not str.startswith(parameters, ",") ? "," + parameters : parameters)
    if (not na(accfilter))
        _return := _return + ",accfilter=" + str.tostring(accfilter)
    if (comment != "")
        _return := _return + (not str.startswith(comment, ",") ? (",comment=" + comment) : ("comment=" + comment))
    if (secret != "")
        _return := _return + (not str.startswith(secret, ",") ? (",secret=" + secret) : ("secret=" + secret))
    if (str.endswith(_return, ","))
        _return := str.substring(_return, 0, str.length(_return) - 1)
    debug(_return, "", debug)
    if (freq == "all")
        alert(_return, alert.freq_all)
    else if (freq == "once_per_bar")
        alert(_return, alert.freq_once_per_bar)
    else if (freq == "once_per_bar_close")
        alert(_return, alert.freq_once_per_bar_close)
    else // no alert
        na
    _return

// } 
// END MISC FUNCTIONS
//=========================================================================

//=========================================================================
//! MARKET ORDERS
//{

// @function Generates a market entry alert with relevant syntax commands. Required params: licenseID, buy, risk.
// @param licenseID Your PC license ID 
// @param buy true=buy/long, false=sell/short
// @param vol_lots Sets the trade volume directly in lots. The EA executes exactly what is written
// @param vol_dollar Calculates the lot size based on a specific cash amount (in your account currency) you are willing to lose if the Stop-Loss is hit
// @param vol_pct_bal_loss Calculates the lot size so that the potential loss (if SL is hit) equals a specific percentage of your current Account Balance
// @param vol_pct_eq_loss Identical to vol_pct_bal_loss, but calculates risk based on Account Equity (Balance +/- Open Floating P/L)
// @param vol_pct_bal_margin Calculates the lot size based on using a percentage of your Account Balance as margin. This ignores Stop-Loss distance
// @param sl_pips Sets the Stop-Loss a specific number of pips away from the entry price
// @param sl_price Sets the Stop-Loss at a specific absolute price level
// @param sl_pct Sets the Stop-Loss a percentage distance away from the entry price
// @param tp_pips Sets the Take-Profit a specific number of pips away from the entry price
// @param tp_price Sets the Take-Profit at a specific absolute price level
// @param tp_pct Sets the Take-Profit a percentage distance away from the entry price
// @param betrigger Breakeven will be activated after the position gains this number of pips
// @param beoffset Offset from entry price. This is the amount of pips you'd like to protect
// @param spread Enter the position only if the spread is equal or less than the specified value in pips
// @param trailtrig Trailing stop-loss will be activated after a trade gains this number of pips
// @param traildist Distance of the trailing stop-loss from current price
// @param trailstep Moves trailing stop-loss once price moves to favourable by a specified number of pips
// @param atrtimeframe ATR Trailing Stop timeframe, only updates once per bar close. Options: 1, 5, 15, 30, 60, 240, 1440
// @param atrperiod ATR averaging period
// @param atrmultiplier Multiple of ATR to utilise in the new SL computation, default = 1
// @param atrshift Relative shift of price information, 0 uses latest candle, 1 uses second last, etc. Default = 0
// @param atrtrigger Activate the trigger of ATR Trailing after market moves favourably by a number of pips. Default = 0 (instant)
// @param symbol The symbol to trigger this order on (defaults to current symbol)
// @param accfilter Optional minimum account balance filter
// @param comment Optional comment (maximum 20 characters)
// @param secret Optional secret key (must be enabled in dashboard)
// @param freq Alert frequency. Default = "all", options = "once_per_bar", "once_per_bar_close" and "none"
// @param debug Turns on/off debug label
// @returns A market order alert string with valid PC syntax based on supplied parameters
export market_order( string licenseID, 
                    bool buy, 
                    float vol_lots = na, 
                    float vol_dollar = na,
                    float vol_pct_bal_loss = na,
                    float vol_pct_eq_loss = na,
                    float vol_pct_bal_margin = na,
                    float sl_pips = na, 
                    float sl_price = na,
                    float sl_pct = na,
                    float tp_pips = na, 
                    float tp_price = na,
                    float tp_pct = na,
                    float betrigger = na, 
                    float beoffset = na, 
                    float spread = na, 
                    float trailtrig = na, 
                    float traildist = na, 
                    float trailstep = na, 
                    int atrtimeframe = na, 
                    int atrperiod = na, 
                    float atrmultiplier = na, 
                    int atrshift = na, 
                    int atrtrigger = na, 
                    string symbol = syminfo.ticker, 
                    float accfilter = na, 
                    string comment = "",
                    string secret = "", 
                    string freq = "all", 
                    bool debug = false) =>
    string _return = order(licenseID, (buy ? "long" : "short"), symbol, freq="none", debug=false)
    _return := _return + (na(vol_lots) ? ""                                         : ",vol_lots=" + truncate(vol_lots))
    _return := _return + (na(vol_dollar) ? ""                                       : ",vol_dollar=" + truncate(vol_dollar))
    _return := _return + (na(vol_pct_bal_loss) ? ""                                 : ",vol_pct_bal_loss=" + truncate(vol_pct_bal_loss))
    _return := _return + (na(vol_pct_eq_loss) ? ""                                  : ",vol_pct_eq_loss=" + truncate(vol_pct_eq_loss))
    _return := _return + (na(vol_pct_bal_margin) ? ""                               : ",vol_pct_bal_margin=" + truncate(vol_pct_bal_margin))
    _return := _return + (na(sl_pips) ? ""                                          : ",sl_pips=" + truncate(sl_pips))
    _return := _return + (na(sl_price) ? ""                                         : ",sl_price=" + truncate(sl_price))
    _return := _return + (na(sl_pct) ? ""                                           : ",sl_pct=" + truncate(sl_pct))
    _return := _return + (na(tp_pips) ? ""                                          : ",tp_pips=" + truncate(tp_pips))
    _return := _return + (na(tp_price) ? ""                                         : ",tp_price=" + truncate(tp_price))
    _return := _return + (na(tp_pct) ? ""                                           : ",tp_pct=" + truncate(tp_pct))
    _return := _return + (na0(betrigger) or na(beoffset) ? ""                       : ",betrigger=" + truncate(betrigger))
    _return := _return + (na(beoffset) or na0(betrigger) ? ""                       : ",beoffset=" + truncate(beoffset))
    _return := _return + (na0(spread) ? ""                                          : ",spread=" + truncate(spread))
    _return := _return + (na(trailtrig) or na0(traildist) or na0(trailstep) ? ""    : ",trailtrig=" + truncate(trailtrig))
    _return := _return + (na0(traildist) or na(trailtrig) or na0(trailstep) ? ""    : ",traildist=" + truncate(traildist))
    _return := _return + (na0(trailstep) or na(trailtrig) or na0(traildist) ? ""    : ",trailstep=" + truncate(trailstep))
    _return := _return + (na0(atrtimeframe) ? ""                                    : ",atrtimeframe=" + str.tostring(atrtimeframe))
    _return := _return + (na0(atrperiod) ? ""                                       : ",atrperiod=" + str.tostring(atrperiod))
    _return := _return + (na0(atrmultiplier) ? ""                                   : ",atrmultiplier=" + truncate(atrmultiplier))
    _return := _return + (na0(atrshift) ? ""                                        : ",atrshift=" + str.tostring(atrshift))
    _return := _return + (na0(atrtrigger) ? ""                                      : ",atrtrigger=" + str.tostring(atrtrigger))
    _return := _return + (na0(accfilter) ? ""                                       : ",accfilter=" + str.tostring(accfilter))
    _return := _return + (comment == "" ? ""                                        : ",comment=" + comment)
    _return := _return + (secret == "" ? ""                                         : ",secret=" + secret)
    debug(_return, "", debug)
    if (freq == "all")
        alert(_return, alert.freq_all)
    else if (freq == "once_per_bar")
        alert(_return, alert.freq_once_per_bar)
    else if (freq == "once_per_bar_close")
        alert(_return, alert.freq_once_per_bar_close)
    else // no alert
        na
    _return

// @function Generates a market buy alert with relevant syntax commands. Required params: licenseID, risk.
// @param licenseID Your PC license ID 
// @param buy true=buy/long, false=sell/short
// @param vol_lots Sets the trade volume directly in lots. The EA executes exactly what is written
// @param vol_dollar Calculates the lot size based on a specific cash amount (in your account currency) you are willing to lose if the Stop-Loss is hit
// @param vol_pct_bal_loss Calculates the lot size so that the potential loss (if SL is hit) equals a specific percentage of your current Account Balance
// @param vol_pct_eq_loss Identical to vol_pct_bal_loss, but calculates risk based on Account Equity (Balance +/- Open Floating P/L)
// @param vol_pct_bal_margin Calculates the lot size based on using a percentage of your Account Balance as margin. This ignores Stop-Loss distance
// @param sl_pips Sets the Stop-Loss a specific number of pips away from the entry price
// @param sl_price Sets the Stop-Loss at a specific absolute price level
// @param sl_pct Sets the Stop-Loss a percentage distance away from the entry price
// @param tp_pips Sets the Take-Profit a specific number of pips away from the entry price
// @param tp_price Sets the Take-Profit at a specific absolute price level
// @param tp_pct Sets the Take-Profit a percentage distance away from the entry price
// @param betrigger Breakeven will be activated after the position gains this number of pips
// @param beoffset Offset from entry price. This is the amount of pips you'd like to protect
// @param spread Enter the position only if the spread is equal or less than the specified value in pips
// @param trailtrig Trailing stop-loss will be activated after a trade gains this number of pips
// @param traildist Distance of the trailing stop-loss from current price
// @param trailstep Moves trailing stop-loss once price moves to favourable by a specified number of pips
// @param atrtimeframe ATR Trailing Stop timeframe, only updates once per bar close. Options: 1, 5, 15, 30, 60, 240, 1440
// @param atrperiod ATR averaging period
// @param atrmultiplier Multiple of ATR to utilise in the new SL computation, default = 1
// @param atrshift Relative shift of price information, 0 uses latest candle, 1 uses second last, etc. Default = 0
// @param atrtrigger Activate the trigger of ATR Trailing after market moves favourably by a number of pips. Default = 0 (instant)
// @param symbol The symbol to trigger this order on (defaults to current symbol)
// @param accfilter Optional minimum account balance filter
// @param comment Optional comment (maximum 20 characters)
// @param secret Optional secret key (must be enabled in dashboard)
// @param freq Alert frequency. Default = "all", options = "once_per_bar", "once_per_bar_close" and "none"
// @param debug Turns on/off debug label
// @returns A market order alert string with valid PC syntax based on supplied parameters
export buy(  string licenseID, 
             float vol_lots = na, 
             float vol_dollar = na,
             float vol_pct_bal_loss = na,
             float vol_pct_eq_loss = na,
             float vol_pct_bal_margin = na,
             float sl_pips = na, 
             float sl_price = na,
             float sl_pct = na,
             float tp_pips = na, 
             float tp_price = na,
             float tp_pct = na,
             float betrigger = na, 
             float beoffset = na, 
             float spread = na, 
             float trailtrig = na, 
             float traildist = na, 
             float trailstep = na, 
             int atrtimeframe = na, 
             int atrperiod = na, 
             float atrmultiplier = na,
             int atrshift = na, 
             int atrtrigger = na, 
             string symbol = syminfo.ticker,
             float accfilter = na, 
             string comment = "", 
             string secret = "", 
             string freq = "all", 
             bool debug = false) =>
    string _return = market_order(licenseID, true, vol_lots, vol_dollar, vol_pct_bal_loss, vol_pct_eq_loss, 
         vol_pct_bal_margin, sl_pips, sl_price, sl_pct, tp_pips, tp_price, tp_pct, betrigger, 
         beoffset, spread, trailtrig, traildist, trailstep, atrtimeframe, atrperiod, atrmultiplier, atrshift, 
         atrtrigger, symbol, accfilter, comment, secret, freq, debug)

