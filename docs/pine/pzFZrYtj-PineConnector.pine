// @function Close given position and open new given position AT MARKET
// @param licenseID Your PC license ID 
// @param vol_lots Sets the trade volume directly in lots. The EA executes exactly what is written
// @param vol_dollar Calculates the lot size based on a specific cash amount (in your account currency) you are willing to lose if the Stop-Loss is hit
// @param vol_pct_bal_loss Calculates the lot size so that the potential loss (if SL is hit) equals a specific percentage of your current Account Balance
// @param vol_pct_eq_loss Identical to vol_pct_bal_loss, but calculates risk based on Account Equity (Balance +/- Open Floating P/L)
// @param vol_pct_bal_margin Calculates the lot size based on using a percentage of your Account Balance as margin. This ignores Stop-Loss distance
// @param symbol Symbol to act on (defaults to current symbol)
// @param comment Optional comment to include (max 20 characters)
// @param secret Optional secret key (must be enabled in dashboard)
// @param freq Alert frequency. Default = "all", options = "once_per_bar", "once_per_bar_close" and "none"
// @param debug Turns on/off debug label
// @returns The required alert syntax as a string
_closepositionopennewposition( string licenseID, string command,
                    float vol_lots = na, 
                    float vol_dollar = na,
                    float vol_pct_bal_loss = na,
                    float vol_pct_eq_loss = na,
                    float vol_pct_bal_margin = na,
                    string symbol = syminfo.ticker, 
                    string comment = "", 
                    string secret = "", 
                    string freq = "all",
                    bool debug = false) =>
    string _return = order(licenseID, command, symbol, freq="none", debug=false)
    _return := _return + (na(vol_lots) ? ""                 : ",vol_lots=" + truncate(vol_lots))
    _return := _return + (na(vol_dollar) ? ""               : ",vol_dollar=" + truncate(vol_dollar))
    _return := _return + (na(vol_pct_bal_loss) ? ""         : ",vol_pct_bal_loss=" + truncate(vol_pct_bal_loss))
    _return := _return + (na(vol_pct_eq_loss) ? ""          : ",vol_pct_eq_loss=" + truncate(vol_pct_eq_loss))
    _return := _return + (na(vol_pct_bal_margin) ? ""       : ",vol_pct_bal_margin=" + truncate(vol_pct_bal_margin))
    _return := _return + (comment == "" ? ""                : ",comment=" + comment)
    _return := _return + (secret == "" ? ""                 : ",secret=" + secret)
    debug(_return, "", debug)
    if (freq == "all")
        alert(_return, alert.freq_all)
    else if (freq == "once_per_bar")
        alert(_return, alert.freq_once_per_bar)
    else if (freq == "once_per_bar_close")
        alert(_return, alert.freq_once_per_bar_close)
    else // no alert
        na
    _return

// @function Closes all open buy positions for the specified symbol and then immediately opens a new buy market order. Either of the volume parameter (vol_lots, vol_dollar, vol_pct_bal_loss, etc) is required.
// @param licenseID Your PC license ID 
// @param vol_lots Sets the trade volume directly in lots. The EA executes exactly what is written
// @param vol_dollar Calculates the lot size based on a specific cash amount (in your account currency) you are willing to lose if the Stop-Loss is hit
// @param vol_pct_bal_loss Calculates the lot size so that the potential loss (if SL is hit) equals a specific percentage of your current Account Balance
// @param vol_pct_eq_loss Identical to vol_pct_bal_loss, but calculates risk based on Account Equity (Balance +/- Open Floating P/L)
// @param vol_pct_bal_margin Calculates the lot size based on using a percentage of your Account Balance as margin. This ignores Stop-Loss distance
// @param symbol Symbol to act on (defaults to current symbol)
// @param comment Optional comment to include (max 20 characters)
// @param secret Optional secret key (must be enabled in dashboard)
// @param freq Alert frequency. Default = "all", options = "once_per_bar", "once_per_bar_close" and "none"
// @param debug Turns on/off debug label
// @returns The required alert syntax as a string
export closelongopenlong( string licenseID, 
                    float vol_lots = na, 
                    float vol_dollar = na,
                    float vol_pct_bal_loss = na,
                    float vol_pct_eq_loss = na,
                    float vol_pct_bal_margin = na,
                    string symbol = syminfo.ticker, 
                    string comment = "", 
                    string secret = "", 
                    string freq = "all",
                    bool debug = false) =>
    string _return = _closepositionopennewposition(licenseID, "closelongopenlong", vol_lots, vol_dollar, vol_pct_bal_loss, vol_pct_eq_loss, vol_pct_bal_margin, symbol, comment, secret, freq, debug)

