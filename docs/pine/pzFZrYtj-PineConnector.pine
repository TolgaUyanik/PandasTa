// @function Cancels all pending long orders with the specified symbol. Required params: licenseID.
// @param licenseID Your PC license ID
// @param symbol Symbol to act on (defaults to current symbol)
// @param comment Optional comment to include (max 20 characters)
// @param secret Optional secret key (must be enabled in dashboard)
// @param freq Alert frequency. Default = "all", options = "once_per_bar", "once_per_bar_close" and "none"
// @param debug Turns on/off debug label
// @returns A cancel long alert command
export cancellong(string licenseID, 
                  string symbol = syminfo.ticker, 
                  string comment="", 
                  string secret = "", 
                  string freq = "all", 
                  bool debug = false) =>
    string _return = order(licenseID, "cancellong", symbol, "", na, comment, secret, freq, debug)

// @function Cancels all pending short orders with the specified symbol. Required params: licenseID.
// @param licenseID Your PC license ID
// @param symbol Symbol to act on (defaults to current symbol)
// @param comment Optional comment to include (max 20 characters)
// @param secret Optional secret key (must be enabled in dashboard)
// @param freq Alert frequency. Default = "all", options = "once_per_bar", "once_per_bar_close" and "none"
// @param debug Turns on/off debug label
// @returns A cancel short alert command
export cancelshort(string licenseID, 
                   string symbol = syminfo.ticker, 
                   string comment="", 
                   string secret = "", 
                   string freq = "all", 
                   bool debug = false) =>
    string _return = order(licenseID, "cancelshort", symbol, "", na, comment, secret, freq, debug)

// @function Cancels all pending orders with the specified symbol. Required params: licenseID.
// @param licenseID Your PC license ID
// @param symbol Symbol to act on (defaults to current symbol)
// @param comment Optional comment to include (max 20 characters)
// @param secret Optional secret key (must be enabled in dashboard)
// @param freq Alert frequency. Default = "all", options = "once_per_bar", "once_per_bar_close" and "none"
// @param debug Turns on/off debug label
export cancelall(string licenseID, 
                   string symbol = syminfo.ticker, 
                   string comment="", 
                   string secret = "", 
                   string freq = "all", 
                   bool debug = false) =>
    cancellong(licenseID, symbol, comment, secret, freq, false)
    cancelshort(licenseID, symbol, comment, secret, freq, false)
    debugString1 = licenseID + ",cancellong," + symbol
    debugString2 = licenseID + ",cancelshort," + symbol
    debugString = (comment == "" ? "" : ",comment=" + comment)
    debugString := debugString + (secret == "" ? "" : ",secret=" + secret)
    debug(debugString1 + debugString + "\n" + debugString2 + debugString, displayLabel=debug)

// }
// END PENDING ORDERS
//=========================================================================

//! POSITION MANAGEMENT ORDERS
