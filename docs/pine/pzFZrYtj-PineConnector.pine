// @function Updates the stop loss and/or take profit of any pending buy stop orders on the given symbol.
// @param licenseID Your PC license ID 
// @param sl_pips Sets the Stop-Loss a specific number of pips away from the entry price
// @param sl_price Sets the Stop-Loss at a specific absolute price level
// @param sl_pct Sets the Stop-Loss a percentage distance away from the entry price
// @param tp_pips Sets the Take-Profit a specific number of pips away from the entry price
// @param tp_price Sets the Take-Profit at a specific absolute price level
// @param tp_pct Sets the Take-Profit a percentage distance away from the entry price
// @param symbol Symbol to act on (defaults to current symbol)
// @param comment Optional comment to include (max 20 characters)
// @param secret Optional secret key (must be enabled in dashboard)
// @param freq Alert frequency. Default = "all", options = "once_per_bar", "once_per_bar_close" and "none"
// @param debug Turns on/off debug label
// @returns The required alert syntax as a string
export newsltpbuystop(string licenseID, 
                     float sl_pips = na, 
                     float sl_price = na,
                     float sl_pct = na,
                     float tp_pips = na, 
                     float tp_price = na,
                     float tp_pct = na,
                     string symbol = syminfo.ticker,
                     string comment = "", 
                     string secret = "",
                     string freq = "all", 
                     bool debug = false) =>
    _params = ""
    if (not na(sl_pips))
        _params := _params + ",sl_pips=" + truncate(sl_pips)
    if (not na(sl_price))
        _params := _params + ",sl_price=" + truncate(sl_price)
    if (not na(sl_pct))
        _params := _params + ",sl_pct=" + truncate(sl_pct)
    if (not na(tp_pips))
        _params := _params + ",tp_pips=" + truncate(tp_pips)
    if (not na(tp_price))
        _params := _params + ",tp_price=" + truncate(tp_price)
    if (not na(tp_pct))
        _params := _params + ",tp_pct=" + truncate(tp_pct)
    string _return = order(licenseID, "newsltpbuystop", symbol, _params, na, comment, secret, freq, debug)

