//@version=5
library("TrendPivots", overlay = true)
import TradingView/ta/7

//@desciption This library provides functions to detect higher high pivots in an uptrend or lower lows in downtrend, singaling if a divergence between price and a custom indicator. You can use the indicator of your choice. For this purpose, I created a UDT variable to store the values.

//@type The coordinates of a pivot point and corresponding indicator value.
//@field x (int) Time.
//@field y (float) Price.
//@field indicator (float) Indicator value.
export type pivotPoint
    int x = time
    float y = close
    float indicator = na

//@function Method function to get the maximum price before the last, stored in an array pivotPoint.
//@param id (array pivotPoint) The pivotPoint array to inspect.
//@returns pivotPoint The last higher high pivot coordinates and indicator before current.
export method maxBeforeLast(array<pivotPoint> id) =>
    idSize = array.size(id)
    pricesArray = array.new<float>()
    pivotPoint currentPivot = na
    pivotPoint max_before_currentPivot = na
    if idSize >= 2
        currentPivot := id.get(idSize - 1)  // latest pivot
        max_before_currentPivot := id.get(0)
        maxPrice = 0.
        for i = 0 to idSize - 2
            pivotPoint pivot = array.get(id, i)
            maxPrice := math.max(maxPrice, pivot.y)
            if maxPrice <= currentPivot.y
                max_before_currentPivot := pivot.copy()
            else
                break
    max_before_currentPivot

//@function Method function to get the minimum price before the last, stored in an array pivotPoint.
//@param id (array pivotPoint) The pivotPoint array to inspect.
//@returns pivotPoint The last lower low pivot coordinates and indicator before current.
export method minBeforeLast(array<pivotPoint> id) =>
    idSize = array.size(id)
    pricesArray = array.new<float>()
    pivotPoint currentPivot = na
    pivotPoint min_before_currentPivot = na
    if idSize >= 2
        currentPivot := id.get(idSize - 1)  // latest pivot
        min_before_currentPivot := id.get(0)
        minPrice = currentPivot.y
        for i = 0 to idSize - 2
            pivotPoint pivot = array.get(id, i)
            minPrice := math.min(minPrice, pivot.y)
            if minPrice >= currentPivot.y
                min_before_currentPivot := pivot.copy()
            else
                break
    min_before_currentPivot

//@function Sets the coordinates of a given line using two pivotPoint variables.
//@param id (line) Existing line
//@param a (pivotPoint) First pivotPoint.
//@param b (pivotPoint) Second pivotPoint.
//@param color (color) The desired color. Default is red.
//@returns void
export method pivotLine(line id, pivotPoint a, pivotPoint b, color color = color.red) =>
    if not na(a.y) and not na(b.y)
        id.set_xy1(a.x, a.y)
        id.set_xy2(b.x, b.y)
        id.set_color(color)

//@function Look for bearish divergence in a pivotPoint array cointaining pivot highs.
//@param pivotArray (array pivotPoint) The pivotPoint array to inspect.
//@returns series bool True if bearish divergence was found.
export bearishDivergence(array<pivotPoint> pivotArray) =>
    bearish_divergence_detected = false
    pivotArraySize = array.size(pivotArray)
    if pivotArraySize >= 2
        pivotPoint currentPivot = pivotArray.get(pivotArraySize - 1)  // latest pivot
        pivotPoint max_before_currentPivot = pivotArray.maxBeforeLast()
        bearish_divergence_detected := currentPivot.y >= max_before_currentPivot.y and currentPivot.indicator < max_before_currentPivot.indicator
    bearish_divergence_detected

//@function Look for bullish divergence in a pivotPoint array cointaining pivot lows.
//@param pivotArray (array pivotPoint) The pivotPoint array to inspect.
//@returns series bool True if bullish divergence was found.
export bullishDivergence(array<pivotPoint> pivotArray) =>
    bullish_divergence_detected = false
    pivotArraySize = array.size(pivotArray)
    if pivotArraySize >= 2
        pivotPoint currentPivot = pivotArray.get(pivotArraySize - 1)  // latest pivot
        pivotPoint min_before_currentPivot = pivotArray.minBeforeLast()
        bullish_divergence_detected := currentPivot.y <= min_before_currentPivot.y and currentPivot.indicator > min_before_currentPivot.indicator
    bullish_divergence_detected

//@function Detects higher highs, higher lows and bearish divergence in an uptrend. Creates a line linking two pivot highs (red when bearish divergence, otherwise green), and labels.
//@param leftBars (int)
//@param rightBars (int)
//@param indicator (float) RSI, MACD or other value.
//@param reset (bool) A bool variable to reinitiates the pivot computation, such as time changes, crossovers, or another.
//@param plotLabel (bool) If true (default), plots labels to higher highs and for each pivot low. Default = true.
//@param plotLine (bool) If true (default), plots a line linking the lower lows with divergence. Default = true.
//@returns [var pivotPoint pH_point, var pivotPoint pL_point, series bool higherHigh, series bool higherLow, series bool bearish_divergence] -> The most recent higher high pivot, the most recent pivot low, true when higher high, true when higher low, true when bearish divergence.
export uptrendPivot(int leftBars, int rightBars, float indicator, bool reset, bool plotLabel = true, bool plotLine = true) =>
    // Arrays
    var array<pivotPoint> pivotHighArray_up = array.new<pivotPoint>()
    var array<pivotPoint> pivotLowArray_up = array.new<pivotPoint>()

    // pivotPoints
    var pivotPoint pH_point = pivotPoint.new()
    var pivotPoint pL_point = pivotPoint.new()

    // Variables
    higherHigh = false
    higherLow = false
    bearish_divergence = false
    var line bearishLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)

    // Reset variables
    if pivotHighArray_up.size() == 0 or reset
        pivotHighArray_up.clear()
        pivotLowArray_up.clear()
        pH_point := pivotPoint.new(time, high, indicator)
        pL_point := pivotPoint.new(time, low, indicator)
        pivotHighArray_up.push(pH_point)
        pivotLowArray_up.push(pL_point)

    // Detect pivots
    pH = ta.pivothigh(leftBars, rightBars)
    pL = ta.pivotlow(leftBars, rightBars)
    pH_found = not na(pH)
    pL_found = not na(pL)
    last_pH_point = pivotHighArray_up.last()
    last_pL_point = pivotLowArray_up.last()

    // Higher high
    if pH_found
        if pH > last_pH_point.y
            pH_point := pivotPoint.new(time[rightBars], pH, indicator[rightBars])
            pivotHighArray_up.push(pH_point)
            higherHigh := true
            bearish_divergence := bearishDivergence(pivotHighArray_up)
            if plotLine
                bearishLine.pivotLine(last_pH_point, pH_point, bearish_divergence ? color.red : color.green)
            if plotLabel
                label.new(pH_point.x, pH_point.y, text = (higherHigh ? "hH: " : "lH: ") + str.tostring(pH_point.indicator, "#.##"), style = label.style_label_down, color = higherHigh ? color.green : color.red, xloc = xloc.bar_time)
        else
            higherHigh := false

    // Pivot lows
    if pL_found
        pL_point := pivotPoint.new(time[rightBars], pL, indicator[rightBars])
        higherLow := pL_point.y > last_pL_point.y
        if plotLabel
            label.new(pL_point.x, pL_point.y, text = (higherLow ? "hL: " : "lL: ") + str.tostring(pL_point.indicator, "#.##"), style = label.style_label_up, color = higherLow ? color.green : color.red, xloc = xloc.bar_time)  
    [pH_point, pL_point, higherHigh, higherLow, bearish_divergence]

//@function Detects lower lows, lower highs, and bullish divergence in a downtrend. Creates a line linking two pivot lows (green when bullish divergence, otherwise red), and labels.
//@param leftBars (int)
//@param rightBars (int)
//@param indicator (float) RSI, MACD or other value.
//@param reset (bool) A bool variable to reinitiates the pivot computation, such as time changes, crossovers, or another.
//@param plotLabel (bool) If true (default), plots labels to lower lows, and for each pivot low.
//@param plotLine (bool) If true (default), plots a line linking the lower lows with divergence. Default = true.
//@returns [var pivotPoint pL_point, var pivotPoint pH_point, series bool lowerLow, series bool lowerHigh, series bool bullish_divergence] -> The most recent lower low pivot, the most recent pivot high, true if lower low, true if lower high, true when bullish divergence.
export downtrendPivot(int leftBars, int rightBars, float indicator, bool reset, bool plotLabel = true, bool plotLine = true) =>
    // Arrays
    var array<pivotPoint> pivotHighArray_down = array.new<pivotPoint>()
    var array<pivotPoint> pivotLowArray_down = array.new<pivotPoint>()

    // pivotPoints
    var pivotPoint pH_point = pivotPoint.new()
    var pivotPoint pL_point = pivotPoint.new()

    // Variables
    lowerLow = false
    lowerHigh = false
    bullish_divergence = false
    var line bullishLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)

    // Reset variables
    if pivotHighArray_down.size() == 0 or reset
        pivotHighArray_down.clear()
        pivotLowArray_down.clear()
        pH_point := pivotPoint.new()
        pL_point := pivotPoint.new()
        pivotHighArray_down.push(pH_point)
        pivotLowArray_down.push(pL_point)

    // Detect pivots
    pH = ta.pivothigh(leftBars, rightBars)
    pL = ta.pivotlow(leftBars, rightBars)
    pH_found = not na(pH)
    pL_found = not na(pL)
    last_pH_point = pivotHighArray_down.last()
    last_pL_point = pivotLowArray_down.last()

    // Lower lows
    if pL_found
        if pL < last_pL_point.y
            pL_point := pivotPoint.new(time[rightBars], pL, indicator[rightBars])
            pivotLowArray_down.push(pL_point)
            lowerLow := true
            bullish_divergence := bullishDivergence(pivotLowArray_down)
            if plotLine
                bullishLine.pivotLine(last_pL_point, pL_point, bullish_divergence ? color.green : color.red)
            if plotLabel
                label.new(pL_point.x, pL_point.y, text = (lowerLow ? "lL: " : "hL: ") + str.tostring(pL_point.indicator, "#.##"), style = label.style_label_up, color = lowerLow ? color.red :  color.green, xloc = xloc.bar_time)
        else
            lowerLow := false
    
    // Pivot highs
    if pH_found
        pH_point := pivotPoint.new(time[rightBars], pH, indicator[rightBars])
        pivotHighArray_down.push(pH_point)
        lowerHigh := pH_point.y < last_pH_point.y
        if plotLabel
            label.new(pH_point.x, pH_point.y, text = (lowerHigh ? "lH: " : "hH: ") + str.tostring(pH_point.indicator, "#.##"), style = label.style_label_down, color = lowerHigh ? color.red : color.green, xloc = xloc.bar_time) 
    [pL_point, pH_point, lowerLow, lowerHigh, bullish_divergence]

// Use your own parameters.
// Example:
length = 14
leftBars = 30
rightBars = 30

// RSI
RSI = ta.rsi(close, 14)
ma1= ta.ema(close, 50)
ma2 = ta.ema(close, 200)
MA_crossover = ta.crossover(ma1, ma2)
MA_crossunder = ta.crossunder(ma1, ma2)
trend = ma1 > ma2 ? 1 : -1

reset = MA_crossover or MA_crossunder
plot(ma1)
plot(ma2)

[ut_ph, _, _,_,_] = uptrendPivot(leftBars, rightBars, RSI, reset, trend == 1, trend == 1)
[dt_pl, _, _, _, _] = downtrendPivot(leftBars, rightBars, RSI, reset, trend == -1, trend == -1)