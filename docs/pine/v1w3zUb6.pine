
//@version=6

// =================================================================================
//  SuperTrend + TrailingStop + Chandelier Exit/Stop +Autotrade by Flamo
// =================================================================================

// ATR Trend-Following + Fully Automated Execution (SuperTrend / Chandelier / Trailing Stop 3-in-1)
//
// This is a trend reversal indicator based on ATR trailing stop lines (combining SuperTrend, Trailing Stop, and Chandelier Exit、Stop).
// The underlying ATR tracking logic is identical; they only differ by anchor points: hl2, high/low, or close/extremums.
// Powered by [FlamoHub], every signal triggers a fully automated trade:
// Automatic entry, automatic SL/TP placement, and automatic reverse position closing — all executed server-side with zero manual monitoring required.

// ==============================================

//ATR 趋势跟踪 + 全自动交易执行（SuperTrend / Chandelier / TrailingStop 三合一）
//
//这是一个基于ATR止损线的趋势反转指标（SuperTrend、TrailingStop、Chandelier Exit/Stop）
//底层都是同一套ATR跟踪逻辑，差别只在锚点：hl2、K线高低点、或收盘价/极值）
//配合[FlamoHub]，每一次信号都能变成一笔全自动交易：
//自动开仓、自动设置止损止盈、自动平掉反向仓位——全部在服务端完成，不需要你盯盘。

//   SuperTrend      hl2 ± ATR
//   TrailingStop    high/low ± ATR
//   ChandelierExit  close ± ATR (usePeriod → N close max/min)
//   ChandelierStop  low/high ± ATR (usePeriod → classic Chandelier:Lowest(Low,N)+ATR/Highest(High,N)−ATR

indicator("SuperTrend+TrailingStop+ChandelierExit/Stop", overlay=true)

Var_Func(source, length) =>
    valpha = 2 / (length + 1)
    vud1 = source > source[1] ? source - source[1] : 0
    vdd1 = source < source[1] ? source[1] - source : 0
    vUD = math.sum(vud1, 9)
    vDD = math.sum(vdd1, 9)
    vCMO = nz((vUD - vDD) / (vUD + vDD))
    VAR = 0.0
    VAR := nz(valpha * math.abs(vCMO) * source) + (1 - valpha * math.abs(vCMO)) * nz(VAR[1])

dema(source,period)=>
    e1 = ta.ema(source, period)
    e2 = ta.ema(e1, period)
    2 * e1 - e2

ma(source, length, type) =>
    switch type
        "SMA"  => ta.sma(source, length)
        "EMA"  => ta.ema(source, length)
        "RMA(SMMA)" => ta.rma(source, length)
        "WMA"  => ta.wma(source, length)
        "VWMA" => ta.vwma(source, length)
        "DEMA" => dema(source, length)
        "VAR"  => Var_Func(source, length)
        => na

//input variables
trendStop = input.string(defval="SuperTrend",title = "TYPE",options = ["SuperTrend","TrailingStop","ChandelierExit","ChandelierStop"],inline ="0")
period    = input.int(title="Price Period", defval=10,step = 1,minval = 1,maxval = 100, inline = "0")
usePeriod = input(false,"UsedbyChandelier",inline = "0",tooltip = 'Toggle whether to use the "Price Period" to calculate ChandelierExit/ChandelierStop indicator.')

atrLen   = input.int(title="ATR: Length", defval=14,step = 1,minval = 1,maxval = 100, inline = "1")
atrMult  = input.float(title="Multiply", defval=2,step = 0.1,minval = 1,maxval = 10,inline = "1")
atrSmooth= input.string(defval="RMA(SMMA)",title = 'MA', options=["RMA(SMMA)", "SMA", "EMA", "WMA", "VWMA","DEMA", "VAR"], inline = "1")

webhook   = input(true,"Webhook Data",inline = "2", active = false)
showAtr   = input(false,"Show ATR Upper And Lower",inline = "2")
offset    = input(false,"Offset ATR",inline = "2" )

//flamohub
autotrade = input(true,'+Autotrade JSON Alert',active = false, tooltip = 'Alert Autotrade JSON Order to Crypto Exchanges is added by flamo. Details in script description. You need only get Webhook URL from [FlamoHub].')

atr = ma(ta.tr(true), atrLen, atrSmooth)
ATR = atr*atrMult

float short_stop=0,float long_stop=0

if trendStop=="SuperTrend"
	short_stop := hl2 + ATR
	long_stop  := hl2 - ATR

if trendStop=="TrailingStop"
	short_stop := high + ATR
	long_stop  := low  - ATR

if trendStop=="ChandelierExit"
	short_stop := close + ATR
	long_stop  := close - ATR
	if usePeriod
        short_stop := ta.lowest(close,period) + ATR
        long_stop  := ta.highest(close,period)- ATR

if trendStop=="ChandelierStop"
	short_stop := low  + ATR
	long_stop  := high - ATR
	if usePeriod
        short_stop := ta.lowest(low,period) + ATR
        long_stop  := ta.highest(high,period)- ATR

offbar = 0
if offset and showAtr
    offbar:=1

plot(webhook or showAtr? short_stop[offbar]:na,'ATRU',color=showAtr?color.new(color.red,50):color.new(color.red,95))
plot(webhook or showAtr? long_stop[offbar]:na, 'ATRL',color=showAtr?color.new(color.green,50):color.new(color.green,95))

plot(webhook? ta.highest(high,period):na,"PriceMax",color.new(color.green,95))
plot(webhook? ta.lowest(low,period):na,  "PriceMin",color.new(color.red,95))


float shortvs=na,float longvs=na
shortvs:=na(shortvs[1])? short_stop : (close>shortvs[1]? short_stop : math.min(short_stop,shortvs[1]))
longvs :=na(longvs[1]) ? long_stop  : (close<longvs[1]?  long_stop  : math.max(long_stop,longvs[1]))

longswitch = (close>shortvs[1] and close[1]<shortvs[1] ? 1 : 0)
shortswitch= (close<longvs[1]  and close[1]>longvs[1] ?  1 : 0)

int direction=na
direction:= (na(direction[1])? 0 : (direction[1]<=0 and longswitch==1? 1 : (direction[1]>=0 and shortswitch==1? -1 : direction[1])))
stopLine=direction>0?longvs:shortvs

plot(direction>0?longvs:na, 'longStop', color=color.new(color.aqua,20),    style=plot.style_circles, linewidth=1)
plot(direction>0?na:shortvs,'shortStop', color=color.new(color.fuchsia,20), style=plot.style_circles, linewidth=1)
plot(stopLine,'StopLine', color=direction>0?color.new(color.aqua,70):color.new(color.fuchsia,70), style=plot.style_line, linewidth=1)

// ========== Alertcondition ==========
string buyMsg     = '{\n "action": "create",\n "account": "ALL",\n "symbol": "{{syminfo.basecurrency}}",\n "side": "BUY",\n "amount": "0",\n "usd": "100",\n "price": "{{close}}",\n "stopPrice": "{{plot("ATRL")}}",\n "profitPrice": "{{close}}+({{close}}-{{plot("ATRL")}})*3.0",\n "orderType": "LIMIT",\n "closeLast": "reverse",\n "reduceOnly": "false",\n "memo": "[FlamoHub] to get your webhook url"\n }'
string sellMsg    = '{\n "action": "create",\n "account": "ALL",\n "symbol": "{{syminfo.basecurrency}}",\n "side": "SELL",\n "amount": "0",\n "usd": "100",\n "price": "{{close}}",\n "stopPrice": "{{plot("ATRU")}}",\n "profitPrice": "{{close}}-({{plot("ATRU")}}-{{close}})*3.0",\n "orderType": "LIMIT",\n "closeLast": "reverse",\n "reduceOnly": "false",\n "memo": "[FlamoHub] to get your webhook url"\n }'
string cloBuyMsg  = '{\n "action": "closePosition",\n "account": "ALL",\n "symbol": "{{syminfo.basecurrency}}",\n "side": "CLOSEBUY",\n "amount": "0",\n "usd": "0",\n "ratio": "1.0",\n "price": "{{close}}",\n "orderType": "market",\n "cancelLast": "true",\n "memo": "[FlamoHub] to get your webhook url"\n }'
string cloSellMsg = '{\n "action": "closePosition",\n "account": "ALL",\n "symbol": "{{syminfo.basecurrency}}",\n "side": "CLOSESELL",\n "amount": "0",\n "usd": "0",\n "ratio": "1.0",\n "price": "{{close}}",\n "orderType": "market",\n "cancelLast": "true",\n "memo": "[FlamoHub] to get your webhook url"\n }'

alertcondition(ta.crossunder(close,stopLine),'Close Long  Position (平多仓)', cloBuyMsg)
alertcondition(ta.crossover(close, stopLine),'Close Short Position (平空仓)',cloSellMsg)

alertcondition(ta.crossover(close, stopLine), 'Over StopLine  to BUY  (做多)', buyMsg)
alertcondition(ta.crossunder(close,stopLine), 'Under StopLine to SELL (做空)',sellMsg)

alertcondition(direction==1, 'Trend is UP','Trend is in Up!')
alertcondition(direction==-1,'Trend is DN','Trend is in Down!')
