//@version=5
library("MonthlyReturnsTable", overlay = true)

// @function 显示月度和年度收益率表格
// @param show (bool) 是否显示表格
// @returns [bool, float] 返回一个数组，包含是否显示表格的状态和当前月度收益率
export showMonthlyReturns(bool show = true) =>
    var float monthReturn = 0.0
    if not show
        [false, monthReturn]
    else
        var MONTHS = array.from("一月", "二月", "三月", "四月", "五月", "六月", "七月", "八月", "九月", "十月", "十一月", "十二月")
        var table monthlyTable = na
        var float monthStartEquity = na
        var float yearStartEquity = na
        var int lastMonth = na
        var int lastYear = na
        var int tableStartYear = na
        var int tableEndYear = na

        // 获取年份范围
        if barstate.isfirst
            startYear = year
            endYear = year(timenow)
            lookback = 0
            while lookback <= 9999 and not na(time[lookback])
                startYear := math.min(startYear, year(time[lookback]))
                lookback += 1
            
            tableStartYear := startYear
            tableEndYear := endYear
            numYears = tableEndYear - tableStartYear + 1
            
            // 创建表格，增加一列用于年度收益率
            monthlyTable := table.new(position=position.top_right, columns=14, rows=numYears + 1, bgcolor=color.new(color.black, 80))
            
            // 设置表头
            table.cell(monthlyTable, 0, 0, "年份", bgcolor=color.new(color.black, 20), text_color=color.white)
            table.cell(monthlyTable, 1, 0, "年度收益", bgcolor=color.new(color.black, 20), text_color=color.white)
            for monthIdx = 0 to 11
                table.cell(monthlyTable, monthIdx + 2, 0, array.get(MONTHS, monthIdx), bgcolor=color.new(color.black, 20), text_color=color.white)
            
            // 初始化年份行和空单元格
            for yearIdx = 1 to numYears
                currentYear = str.tostring(tableStartYear + yearIdx - 1)
                table.cell(monthlyTable, 0, yearIdx, currentYear, bgcolor=color.new(color.black, 20), text_color=color.white)
                table.cell(monthlyTable, 1, yearIdx, "", bgcolor=color.new(color.black, 80))  // 年度收益率单元格
                for monthIdx = 1 to 12
                    table.cell(monthlyTable, monthIdx + 1, yearIdx, "", bgcolor=color.new(color.black, 80))
            
            monthStartEquity := strategy.equity
            yearStartEquity := strategy.equity
            lastMonth := month
            lastYear := year

        // 计算月度和年度收益
        currentMonth = month
        currentYear = year
        yearRow = currentYear - tableStartYear + 1

        // 在年份变更时更新yearStartEquity
        if currentYear != lastYear
            yearStartEquity := monthStartEquity
        
        // 在月份变更时更新monthStartEquity
        if currentMonth != lastMonth
            monthStartEquity := strategy.equity
            lastMonth := currentMonth
            lastYear := currentYear

        // 计算当前月度收益率
        if yearRow > 0 and yearRow <= tableEndYear - tableStartYear + 1 and 
           currentMonth > 0 and currentMonth <= 12
            monthReturn := (strategy.equity - monthStartEquity) / monthStartEquity * 100
            monthCellColor = monthReturn >= 0 ? color.new(color.red, 20) : color.new(color.green, 20)
            table.cell(monthlyTable, currentMonth + 1, yearRow, 
                      str.tostring(monthReturn, "#.##") + "%", 
                      bgcolor=monthCellColor,
                      text_color=color.white)

            // 计算当前年度收益率
            yearReturn = (strategy.equity - yearStartEquity) / yearStartEquity * 100
            yearCellColor = yearReturn >= 0 ? color.new(color.red, 20) : color.new(color.green, 20)
            table.cell(monthlyTable, 1, yearRow,
                      str.tostring(yearReturn, "#.##") + "%",
                      bgcolor=yearCellColor,
                      text_color=color.white)
            
        [true, monthReturn]