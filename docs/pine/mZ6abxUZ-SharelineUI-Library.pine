//@version=6
library("SharelineUI_Library", overlay = false)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// TEXT-GRÖSSEN HELFER (HUD)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
export get_text_size(string opt) =>
    opt == "Auto"   ? size.auto  :
     opt == "Tiny"  ? size.tiny  :
     opt == "Small" ? size.small :
     opt == "Normal"? size.normal:
     opt == "Large" ? size.large :
     size.huge

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// STATUSFARBEN (für Komponenten: >0 / <0 / 0)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
export status_color(float val) =>
    val > 0.0 ? color.new(color.green, 0) :
     val < 0.0 ? color.new(color.red, 0) :
     color.new(color.yellow, 0)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// TREND-FARBEN (für SMC Trend-Kategorien)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
export trend_color(string trend_cat) =>
    trend_cat == "Top Bull" ? color.new(color.green, 0) :
     trend_cat == "Bull"    ? color.new(color.green, 30) :
     trend_cat == "Top Bear"? color.new(color.red, 0) :
     trend_cat == "Bear"    ? color.new(color.red, 30) :
     color.new(color.yellow, 0)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// MOMENTUM-FARBE (Basierend auf Schwellen)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
export momentum_color(float score, float bullTh, float bearTh) =>
    score > bullTh  ? color.new(color.green, 0) :
     score < bearTh ? color.new(color.red, 0) :
     color.new(color.orange, 0)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// STANDARD HUD-TABLE HELFER
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Einheitliches HUD-Layout für alle Indikatoren
export create_standard_hud(string pos, int cols, int rows) =>
    table.new(
        pos,
        cols,
        rows,
        bgcolor      = color.new(color.black, 85),
        frame_width  = 0,
        border_width = 0
    )
