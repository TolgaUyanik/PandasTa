//@version=6
strategy("UT Bot + STC Conjunction Strategy Tester (v4.6 Lag Window)", overlay=true, precision=5, initial_capital=10000, default_qty_type=strategy.cash, margin_long=0, margin_short=0)

// ==========================================
// --- MANDATORY BOILERPLATE INPUTS ---------
// ==========================================
useSession   = input.bool(true, "Enable Session Filter", group="Mandatory Core Settings")
allowedSess  = input.session("0730-1900", "Allowed Trading Session", group="Mandatory Core Settings", tooltip="v4.5 optimized session window.")
sessTimezone = input.string("UTC", "Session Timezone", group="Mandatory Core Settings")

accountRisk  = input.float(1.0, "Account Risk % Per Trade", minval=0.1, maxval=10.0, step=0.5, group="Mandatory Core Settings")
minStopDist  = input.float(0.00100, "Min Stop Distance (e.g. 0.00100 = 10 Pips)", minval=0.0, step=0.00010, group="Mandatory Core Settings")

// ==========================================
// --- v4.6 SIGNAL LAG WINDOW SETTINGS ------
// ==========================================
useLagWindow = input.bool(true, "Enable STC Lag Confirmation Window", group="v4.6 Signal Lag Settings")
maxLagBars   = input.int(2, "Max Allowed STC Confirmation Lag (Bars)", minval=1, maxval=5, group="v4.6 Signal Lag Settings", tooltip="Number of bars to hold a UT Bot signal open while waiting for STC color confirmation.")

// ==========================================
// --- v4.3 WEEKLY CIRCUIT BREAKER ----------
// ==========================================
useCircuitBreaker = input.bool(true, "Enable Weekly Drawdown Circuit Breaker", group="v4.3 Circuit Breaker Settings")
maxWeeklyLossPct  = input.float(3.0, "Max Allowed Weekly Equity Loss %", minval=0.5, maxval=20.0, step=0.5, group="v4.3 Circuit Breaker Settings")

// ==========================================
// --- v4.2 DYNAMIC OFFSET SETTINGS ---------
// ==========================================
useDynamicOffset = input.bool(true, "Enable Volatility-Scaled Entry Offset", group="v4.2 Dynamic Offset Settings")
lowVolOffset     = input.float(0.0, "Low Vol Offset (Pippettes)", minval=0.0, step=0.5, group="v4.2 Dynamic Offset Settings")
normalVolOffset  = input.float(2.0, "Normal Vol Offset (Pippettes)", minval=0.0, step=0.5, group="v4.2 Dynamic Offset Settings")
highVolOffset    = input.float(6.0, "High Vol Breakout Filter (Pippettes)", minval=0.0, step=0.5, group="v4.2 Dynamic Offset Settings")

// ==========================================
// --- v3.9 DYNAMIC STOP LOSS SETTINGS ------
// ==========================================
normalSwingLookback = input.int(10, "Normal/Low Vol Swing Lookback", minval=1, group="v3.9 Dynamic Stop Loss Scaling")
highVolSwingLookback = input.int(7, "High Vol Dynamic Swing Lookback", minval=1, group="v3.9 Dynamic Stop Loss Scaling")

// ==========================================
// --- v2.2 & v3.8 CANDLE RANGE FILTERS -----
// ==========================================
filterAtrLen    = input.int(50, "ATR Volatility Baseline Period", minval=5, group="Candle Range Filters (v2.2 & v3.8)")
useRangeFilter  = input.bool(true, "Enable Floor Filter (Block Too Small)", group="Candle Range Filters (v2.2 & v3.8)")
minRangePercent = input.float(40.0, "Min Candle Range (% of ATR)", minval=0.0, maxval=200.0, step=5.0, group="Candle Range Filters (v2.2 & v3.8)")

useMaxCandleFilter = input.bool(true, "Enable Ceiling Filter (Block Too Large)", group="Candle Range Filters (v2.2 & v3.8)")
maxRangePercent    = input.float(375.0, "Max Allowed Candle Range (% of ATR)", minval=50.0, maxval=1000.0, step=5.0, group="Candle Range Filters (v2.2 & v3.8)")

// ==========================================
// --- v2.4 VALUE ZONE BOUNDARIES -----------
// ==========================================
stcLowerZone = input.float(25.0, "Max STC for Longs (Oversold Floor)", minval=1.0, maxval=50.0, group="v2.4 Value Zone Settings")
stcUpperZone = input.float(75.0, "Min STC for Shorts (Overbought Ceiling)", minval=50.0, maxval=99.0, group="v2.4 Value Zone Settings")

// ==========================================
// --- v2.7 VOLUME INTENSITY SETTINGS -------
// ==========================================
useVolumeFilter = input.bool(true, "Enable Volume Intensity Filter", group="v2.7 Volume Filter Settings")
volFastLen      = input.int(5, "Volume Fast EMA Length", minval=1, group="v2.7 Volume Filter Settings")
volSlowLen      = input.int(10, "Volume Slow EMA Length", minval=2, group="v2.7 Volume Filter Settings")

// ==========================================
// --- v2.8 BREAKEVEN PROTECTION SETTINGS ---
// ==========================================
useBreakeven    = input.bool(true, "Enable Breakeven Protection", group="v2.8 Breakeven Settings")
beMilestoneR    = input.float(1.5, "Trigger Milestone R-Multiple", minval=0.1, step=0.1, group="v2.8 Breakeven Settings")

// ==========================================
// --- v3.0 CANDLE REJECTION SETTINGS -------
// ==========================================
useWickFilter   = input.bool(true, "Enable Rejection Wick Filter", group="v3.0 Candle Rejection Settings")
maxWickPercent  = input.float(50.0, "Max Allowed Counter-Wick %", minval=1.0, maxval=100.0, step=2.5, group="v3.0 Candle Rejection Settings")

// ==========================================
// --- v3.1 LOCKED SWEET SPOT PARAMETERS ----
// ==========================================
useVelocityFilter = input.bool(true, "Enable Trend Velocity Blocker", group="v3.1 Velocity Settings")
trendEmaLen       = input.int(25, "Velocity Baseline EMA Length", minval=5, group="v3.1 Velocity Settings")
velocityLookback  = input.int(3, "Velocity Evaluation Window (Bars)", minval=1, group="v3.1 Velocity Settings")
maxAllowedSlope   = input.float(0.0010, "Max Allowed EMA Change (Pips)", step=0.0001, group="v3.1 Velocity Settings")

// ==========================================
// --- v3.2: PARTIAL TAKE PROFIT ENGINE -----
// ==========================================
usePartialTP     = input.bool(false, "Enable 50% Partial Take Profit", group="v3.2 Partial Management")
partialMilestone = input.float(1.5, "Partial TP Milestone R-Multiple", minval=0.1, step=0.1, group="v3.2 Partial Management")

// ==========================================
// --- v4.4 DYNAMIC R:R REGIME INPUTS -------
// ==========================================
regimeFastAtrLen  = input.int(14, "Fast Regime ATR Period", minval=3, group="v3.7 Dynamic R:R Regime Settings")
regimeSlowAtrLen  = input.int(200, "Slow Baseline ATR Period", minval=50, group="v3.7 Dynamic R:R Regime Settings")
highVolThreshold  = input.float(1.2, "High Volatility Threshold Ratio", minval=1.0, step=0.05, group="v3.7 Dynamic R:R Regime Settings")
lowVolThreshold   = input.float(0.8, "Low Volatility Threshold Ratio", maxval=1.0, step=0.05, group="v3.7 Dynamic R:R Regime Settings")

normalRrTarget    = input.float(3.0, "Normal Regime R-Multiple Target", minval=0.1, step=0.1, group="v3.7 Dynamic R:R Regime Settings")
highVolRrTarget   = input.float(3.0, "High Volatility Expansion Target", minval=0.1, step=0.1, group="v3.7 Dynamic R:R Regime Settings", tooltip="v4.4 Adjustment: Tighter targets for high volatility regimes.")
lowVolRrTarget    = input.float(4.0, "Low Volatility Compression Target", minval=0.1, step=0.1, group="v3.7 Dynamic R:R Regime Settings")

// ==========================================
// --- INDICATOR SPECIFIC INPUTS ------------
// ==========================================
utKeyV       = input.float(2.0, "UT Bot Key Value (Sensitivity)", step=0.1, group="UT Bot Alerts Settings")
utAtrLen     = input.int(1, "UT Bot ATR Period", minval=1, group="UT Bot Alerts Settings")

stcLength    = input.int(80, "STC Length", group="STC Settings")
stcFastLen   = input.int(27, "STC Fast Length", group="STC Settings")
stcSlowLen   = input.int(50, "STC Slow Length", group="STC Settings")
stcAaa       = input.float(0.5, "STC AAA Factor", step=0.05, group="STC Settings")

// ==========================================
// --- CORE LOGIC: UT BOT ALERTS ------------
// ==========================================
utSrc = close
utAtr = ta.atr(utAtrLen)
utLoss = utKeyV * utAtr

var float utTrailingStop = na
if na(utTrailingStop)
    utTrailingStop := utSrc - utLoss
else
    if utSrc > utTrailingStop[1] and utSrc[1] > utTrailingStop[1]
        utTrailingStop := math.max(utTrailingStop[1], utSrc - utLoss)
    else if utSrc < utTrailingStop[1] and utSrc[1] < utTrailingStop[1]
        utTrailingStop := math.min(utTrailingStop[1], utSrc + utLoss)
    else
        utTrailingStop := utSrc > utTrailingStop[1] ? utSrc - utLoss : utSrc + utLoss

var int utPos = 0
if utSrc[1] < utTrailingStop[1] and utSrc > utTrailingStop
    utPos := 1
else if utSrc[1] > utTrailingStop[1] and utSrc < utTrailingStop
    utPos := -1
else
    utPos := utPos[1]

utEma = ta.ema(utSrc, 1)
utAbove = ta.crossover(utEma, utTrailingStop)
utBelow = ta.crossover(utTrailingStop, utEma)

utBuySignal  = utSrc > utTrailingStop and utAbove
utSellSignal = utSrc < utTrailingStop and utBelow

// ==========================================
// --- CORE LOGIC: SCHAFF TREND CYCLE (STC) -
// ==========================================
stcMacdCalc(src, fastLen, slowLen) =>
    fastMA = ta.ema(src, fastLen)
    slowMA = ta.ema(src, slowLen)
    fastMA - slowMA

stcFunction(length, fastLen, slowLen, factor) =>
    var float cVal = 0.0
    var float dVal = 0.0
    var float dVal6 = 0.0
    var float eVal = 0.0
    
    macdVal = stcMacdCalc(close, fastLen, slowLen)
    lowestMacd = ta.lowest(macdVal, length)
    rangeMacd = ta.highest(macdVal, length) - lowestMacd
    
    cVal := rangeMacd > 0 ? (macdVal - lowestMacd) / rangeMacd * 100 : nz(cVal[1])
    dVal := na(dVal[1]) ? cVal : dVal[1] + factor * (cVal - dVal[1])
    
    lowestD = ta.lowest(dVal, length)
    rangeD = ta.highest(dVal, length) - lowestD
    
    dVal6 := rangeD > 0 ? (dVal - lowestD) / rangeD * 100 : nz(dVal6[1])
    eVal := na(eVal[1]) ? dVal6 : eVal[1] + factor * (dVal6 - eVal[1])
    eVal

mSTC = stcFunction(stcLength, stcFastLen, stcSlowLen, stcAaa)
stcIsUp   = mSTC > mSTC[1]
stcIsDown = mSTC < mSTC[1]

// ==========================================
// --- ENVIRONMENT FILTERS ------------------
// ==========================================
currentBarRange  = high - low
baselineFilterAtr = ta.atr(filterAtrLen)

rangeFloorPassed = not useRangeFilter or (currentBarRange >= (baselineFilterAtr * (minRangePercent / 100.0)))
rangeCeilingPassed = not useMaxCandleFilter or (currentBarRange <= (baselineFilterAtr * (maxRangePercent / 100.0)))

fastVolEma = ta.ema(volume, volFastLen)
slowVolEma = ta.ema(volume, volSlowLen)
volumeOscillator = slowVolEma != 0 ? ((fastVolEma - slowVolEma) / slowVolEma) * 100 : 0.0
volumeFilterPassed = not useVolumeFilter or (volumeOscillator > 0.0)

candleTotalRange = high - low
longUpperRejectionWick = high - math.max(open, close)
shortLowerRejectionWick = math.min(open, close) - low
longWickPercent  = candleTotalRange > 0 ? (longUpperRejectionWick / candleTotalRange) * 100.0 : 0.0
shortWickPercent = candleTotalRange > 0 ? (shortLowerRejectionWick / candleTotalRange) * 100.0 : 0.0
longWickFilterPassed  = not useWickFilter or (longWickPercent <= maxWickPercent)
shortWickFilterPassed = not useWickFilter or (shortWickPercent <= maxWickPercent)

baselineEma = ta.ema(close, trendEmaLen)
emaDelta = baselineEma - baselineEma[velocityLookback]
longVelocityBlock = useVelocityFilter and (emaDelta < -maxAllowedSlope)
shortVelocityBlock = useVelocityFilter and (emaDelta > maxAllowedSlope)

// ==========================================
// --- REGIME DETECTION & TARGET ASSIGNMENT --
// ==========================================
fastRegimeAtr = ta.atr(regimeFastAtrLen)
slowRegimeAtr = ta.atr(regimeSlowAtrLen)
volatilityRatio = slowRegimeAtr != 0 ? (fastRegimeAtr / slowRegimeAtr) : 1.0

currentActiveRr = normalRrTarget
if volatilityRatio >= highVolThreshold
    currentActiveRr := highVolRrTarget
else if volatilityRatio <= lowVolThreshold
    currentActiveRr := lowVolRrTarget

activeSwingLookback = volatilityRatio >= highVolThreshold ? highVolSwingLookback : normalSwingLookback

var float activeOffsetPippettes = 0.0
if useDynamicOffset
    if volatilityRatio >= highVolThreshold
        activeOffsetPippettes := highVolOffset
    else if volatilityRatio <= lowVolThreshold
        activeOffsetPippettes := lowVolOffset
    else
        activeOffsetPippettes := normalVolOffset
else
    activeOffsetPippettes := 0.0

dynamicOffsetValue = activeOffsetPippettes * 0.00001

// ==========================================
// --- v4.3 RUNTIME CIRCUIT BREAKER ENGINE ---
// ==========================================
var float weeklyHighEquity = strategy.equity
var bool circuitBreakerTripped = false

isNewWeek = not na(ta.change(time("W"))) and ta.change(time("W")) != 0

if isNewWeek
    weeklyHighEquity := strategy.equity
    circuitBreakerTripped := false
else
    weeklyHighEquity := math.max(weeklyHighEquity, strategy.equity)

if useCircuitBreaker and not circuitBreakerTripped and strategy.position_size == 0
    weeklyDrawdownPct = ((weeklyHighEquity - strategy.equity) / weeklyHighEquity) * 100.0
    if weeklyDrawdownPct >= maxWeeklyLossPct
        circuitBreakerTripped := true

// ==========================================
// --- STRATEGY CONDITIONS & EXECUTION ------
// ==========================================
inTradingWindow = not useSession or not na(time(timeframe.period, allowedSess, sessTimezone))

globalLowestLow   = ta.lowest(low, activeSwingLookback)
globalHighestHigh = ta.highest(high, activeSwingLookback)

// Persistent Position Brackets
var float slLevel = na
var float tpLevel = na
var float partialTpLevel = na
var float entryPrice = na
var float initialRisk = na
var bool beTriggered = false
var bool partialExecuted = false

var float maxPriceSinceEntry = 0.0
var float minPriceSinceEntry = 0.0

// v4.6 Lag Tracker Registers
var bool longAlertPending = false
var int longAlertAge = 0
var float pendingLongSl = na

var bool shortAlertPending = false
var int shortAlertAge = 0
var float pendingShortSl = na

riskCash = strategy.equity * (accountRisk / 100)

// Evaluates every single structural rule EXCEPT the directional STC line color
coreLongFiltersPassed = utBuySignal and (mSTC <= stcLowerZone) and inTradingWindow and rangeFloorPassed and rangeCeilingPassed and volumeFilterPassed and longWickFilterPassed and not longVelocityBlock and not circuitBreakerTripped
coreShortFiltersPassed = utSellSignal and (mSTC >= stcUpperZone) and inTradingWindow and rangeFloorPassed and rangeCeilingPassed and volumeFilterPassed and shortWickFilterPassed and not shortVelocityBlock and not circuitBreakerTripped

// --- LAG WINDOW STATE ENGINE ---
if useLagWindow
    // Long Trackers
    if coreLongFiltersPassed and strategy.position_size == 0
        longAlertPending := true
        longAlertAge := 0
        pendingLongSl := globalLowestLow
        shortAlertPending := false // Cancel conflicting setup
    else if longAlertPending
        longAlertAge += 1
        
    // Short Trackers
    if coreShortFiltersPassed and strategy.position_size == 0
        shortAlertPending := true
        shortAlertAge := 0
        pendingShortSl := globalHighestHigh
        longAlertPending := false // Cancel conflicting setup
    else if shortAlertPending
        shortAlertAge += 1

    // Expiration Gate
    if longAlertAge > maxLagBars or not inTradingWindow or circuitBreakerTripped
        longAlertPending := false
    if shortAlertAge > maxLagBars or not inTradingWindow or circuitBreakerTripped
        shortAlertPending := false
else
    // Fallback to traditional immediate conjunction
    longAlertPending := coreLongFiltersPassed
    shortAlertPending := coreShortFiltersPassed
    pendingLongSl := globalLowestLow
    pendingShortSl := globalHighestHigh

// Clear states if active position exists
if strategy.position_size != 0
    longAlertPending := false
    shortAlertPending := false

// Final Signal Drivers
finalBuySignal = longAlertPending and (useLagWindow ? stcIsUp : stcIsUp[0]) and strategy.position_size == 0
finalSellSignal = shortAlertPending and (useLagWindow ? stcIsDown : stcIsDown[0]) and strategy.position_size == 0

// Reset tracking states when fully flat
if strategy.position_size == 0
    slLevel := na
    tpLevel := na
    partialTpLevel := na
    entryPrice := na
    initialRisk := na
    beTriggered := false
    partialExecuted := false
    maxPriceSinceEntry := 0.0
    minPriceSinceEntry := 0.0

if circuitBreakerTripped or not inTradingWindow
    strategy.cancel_all()

// LONG ORDER EXECUTION
if finalBuySignal
    calculatedEntry = close + dynamicOffsetValue
    riskPrice = calculatedEntry - pendingLongSl
    
    if riskPrice >= minStopDist
        tradeQty = riskCash / riskPrice
        strategy.entry("Long", strategy.long, qty=tradeQty, comment="Market Long")
        
        slLevel := pendingLongSl
        tpLevel := calculatedEntry + (riskPrice * currentActiveRr)
        partialTpLevel := calculatedEntry + (riskPrice * partialMilestone)
        entryPrice := close
        initialRisk := riskPrice
        beTriggered := false
        partialExecuted := false
        maxPriceSinceEntry := high
        longAlertPending := false

// SHORT ORDER EXECUTION
if finalSellSignal
    calculatedEntry = close - dynamicOffsetValue
    riskPrice = pendingShortSl - calculatedEntry
    
    if riskPrice >= minStopDist
        tradeQty = riskCash / riskPrice
        strategy.entry("Short", strategy.short, qty=tradeQty, comment="Market Short")
        
        slLevel := pendingShortSl
        tpLevel := calculatedEntry - (riskPrice * currentActiveRr)
        partialTpLevel := calculatedEntry - (riskPrice * partialMilestone)
        entryPrice := close
        initialRisk := riskPrice
        beTriggered := false
        partialExecuted := false
        minPriceSinceEntry := low
        shortAlertPending := false

// ==========================================
// --- ACTIVE MANAGEMENT & EXITS ------------
// ==========================================
if strategy.position_size > 0
    maxPriceSinceEntry := math.max(maxPriceSinceEntry, high)
    if useBreakeven and not beTriggered
        highestProfitPoints = maxPriceSinceEntry - entryPrice
        beMilestonePoints = initialRisk * beMilestoneR
        if highestProfitPoints >= beMilestonePoints
            slLevel := entryPrice
            beTriggered := true

if strategy.position_size < 0
    minPriceSinceEntry := math.min(minPriceSinceEntry, low)
    if useBreakeven and not beTriggered
        lowestProfitPoints = entryPrice - minPriceSinceEntry
        beMilestonePoints = initialRisk * beMilestoneR
        if lowestProfitPoints >= beMilestonePoints
            slLevel := entryPrice
            beTriggered := true

if strategy.position_size > 0
    if usePartialTP and not partialExecuted
        strategy.exit("Part Long", "Long", qty_percent=50, limit=partialTpLevel, stop=slLevel, comment_profit="Partial TP Long", comment_loss="SL Long")
    strategy.exit("Exit Long", "Long", stop=slLevel, limit=tpLevel, comment_profit="Full TP Long", comment_loss="SL Long")

if strategy.position_size < 0
    if usePartialTP and not partialExecuted
        strategy.exit("Part Short", "Short", qty_percent=50, limit=partialTpLevel, stop=slLevel, comment_profit="Partial TP Short", comment_loss="SL Short")
    strategy.exit("Exit Short", "Short", stop=slLevel, limit=tpLevel, comment_profit="Full TP Short", comment_loss="SL Short")

if strategy.position_size != 0 and strategy.position_size[1] != 0 and math.abs(strategy.position_size) < math.abs(strategy.position_size[1])
    partialExecuted := true

// ==========================================
// --- VISUAL PLOTS -------------------------
// ==========================================
bgcolor(circuitBreakerTripped ? color.new(color.red, 93) : (useSession and inTradingWindow ? color.new(color.blue, 97) : na), title="Breaker Active vs Session Active")
plot(strategy.position_size != 0 ? slLevel : na, title="Dynamic Stop Loss Line", color=beTriggered ? color.orange : color.red, style=plot.style_linebr, linewidth=2)
plot(strategy.position_size != 0 ? tpLevel : na, title="Active Take Profit", color=color.green, style=plot.style_linebr)