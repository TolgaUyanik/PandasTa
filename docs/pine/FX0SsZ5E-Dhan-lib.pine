// __________________________________________________ Options Buying _______________________________________________________________ \\ 

// ------------------ Call Option Buying -------------------- \\
//@function to buy CE option 
//@param secret_key string Secret Key of the Dhan Account eg-> "S1HgS".
//@param symbol string Index / Stock symbol eg-> "NIFTY", "BANKNIFTY".
//@param lots int Number of lots eg-> 1.
//@param expiry_date string Option expiry date in YYYY-MM-DD format eg-> "2026-01-20".
//@param intraday bool Set true for intraday order, set false for delivery order eg-> true.
//@param strike_price_base float Strike price step size eg-> 50, 100 (default is 100).
//@param ITM_points float Points below CMP to select ITM strike eg-> 100 (default is 0).
//@param OTM_points float Points above CMP to select OTM strike eg-> 100 (default is 0).
//@param exchange string Trading Exchange eg-> "NSE" (default is NSE).
//@returns order string.
export buy_CE_option(string secret_key,
             string symbol, 
             int lots, 
             string expiry_date = "2026-01-20",
             bool intraday = true,
             float strike_price_base = 100,  
             float ITM_points = 0,
             float OTM_points = 0,    
             string exchange = "NSE")=>

    expiry_date_              = timestamp(expiry_date)
    // _______________________________ Webhook essentials ______________________________________________\\
    day_                     = dayofmonth(expiry_date_, "GMT+0530")
    month_                   = month(expiry_date_, "GMT+0530")
    year_                    = year(expiry_date_, "GMT+0530")
    day_string               = day_ < 10 ? "0" + str.tostring(day_) : str.tostring(day_)
    month_string             = month_ < 10 ? "0" + str.tostring(month_) : str.tostring(month_)
    year_string              = str.tostring(year_)

    // _______________________________ ATM, OTM , ITM Selection _______________________________________ \\
    float strike_price             = na 

    if ITM_points > 0 
        strike_price             := math.round(math.round((close - ITM_points )/strike_price_base) * strike_price_base, 1) 

    else if OTM_points > 0 
        strike_price             := math.round(math.round((close + OTM_points )/strike_price_base) * strike_price_base, 1) 

    else
        strike_price             := math.round(math.round((close)/strike_price_base) * strike_price_base, 1) 

    // _______________________________ Coneverting into string ______________________________________________\\
    key_str                  = '"' + secret_key + '"'
    symbol_str               = '"' + symbol + '"'
    exchange_str             = '"' + exchange + '"'
    strike_price_str         = '"' + str.tostring(strike_price, "##.##") + ".0" + '"'
    lots_str                 = '"' + str.tostring(lots) + '"'
    expiry_date_str          = '"' + year_string + "-" + month_string + "-" + day_string + '"'

    CE_buy_syntex_str        = ""
    if intraday 
        CE_buy_syntex_str        := '{"secret":' + key_str + ',"alertType":"multi_leg_order","order_legs":[{"transactionType":"B","orderType":"MKT","quantity":' + lots_str + ',"exchange":' + exchange_str + ',"symbol":' + symbol_str + ',"instrument":"OPT","productType":"I","sort_order":"1","price":"0","option_type":"CE","strike_price":' + strike_price_str + ',"expiry_date":' + expiry_date_str + '}]}'
    else  
        CE_buy_syntex_str        := '{"secret":' + key_str + ',"alertType":"multi_leg_order","order_legs":[{"transactionType":"B","orderType":"MKT","quantity":' + lots_str + ',"exchange":' + exchange_str + ',"symbol":' + symbol_str + ',"instrument":"OPT","productType":"M","sort_order":"1","price":"0","option_type":"CE","strike_price":' + strike_price_str + ',"expiry_date":' + expiry_date_str + '}]}'

    CE_buy_syntex_str



// ------------------ Put Option Buying -------------------- \\
