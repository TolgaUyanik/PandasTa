// _________________________________________________________ Future buy and selling ________________________________________________________ \\ 
// ------------------------ buy ----------------- \\
//@function to buy the Future
//@param secret_key string Secret Key of the Dhan Account eg-> "S1HgS".
//@param symbol string Stock symbol eg-> "NIFTY".
//@param lot int quantity for the order eg-> 1.
//@param intraday bool Set true for intraday order, set false for delivery order eg-> true.
//@param exchange string Trading Exchange eg-> "NSE".
//@returns order string.
export buy_future(string secret_key, string symbol, int lot, bool intraday = true,  string exchange = 'NSE') => 
    secret_key_  = '"' + secret_key + '"'
    symbol_      = '"' + symbol + '1!' + '"'     // imp for futures only
    qty_         = '"' + str.tostring(lot) + '"'
    exchange_    = '"' + exchange + '"'

    FUT_buy_syntex_str  = ""
    if intraday
        FUT_buy_syntex_str := '{"secret":' + secret_key_ + ',"alertType":"multi_leg_order","order_legs":[{"transactionType":"B","orderType":"MKT","quantity":' + qty_ + ',"exchange":' + exchange_ + ',"symbol":' + symbol_ + ',"instrument":"FUT","productType":"I","sort_order":"1","price":"0"}]}'
    else
        FUT_buy_syntex_str := '{"secret":' + secret_key_ + ',"alertType":"multi_leg_order","order_legs":[{"transactionType":"B","orderType":"MKT","quantity":' + qty_ + ',"exchange":' + exchange_ + ',"symbol":' + symbol_ + ',"instrument":"FUT","productType":"M","sort_order":"1","price":"0"}]}'



    FUT_buy_syntex_str


