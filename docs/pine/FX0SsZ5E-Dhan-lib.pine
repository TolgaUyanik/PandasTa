// __________________________________________________ stock Intraday orders _______________________________________________________________ \\ 

// ------------------------ buy ----------------- \\
//@function to buy the stock Intraday
//@param secret_key string Secret Key of the Dhan Account eg-> "S1HgS".
//@param symbol string Stock symbol eg-> "TATASTEEL".
//@param qty int quantity for the order eg-> 1.
//@param exchange string Trading Exchange eg-> "NSE".
//@returns order string.
export buy_stock_intraday(string secret_key, string symbol, int qty, string exchange = 'NSE') => 
    secret_key_  = '"' + secret_key + '"'
    symbol_      = '"' + symbol + '"'
    qty_         = '"' + str.tostring(qty) + '"'
    exchange_    = '"' + exchange + '"'

    EQ_buy_syntex_str = '{"secret":' + secret_key_ + ',"alertType":"multi_leg_order","order_legs":[{"transactionType":"B","orderType":"MKT","quantity":' + qty_ + ',"exchange":' + exchange_ + ',"symbol":' + symbol_ + ',"instrument":"EQ","productType":"I","sort_order":"1","price":"0"}]}'

    EQ_buy_syntex_str

// ------------------------ sell ----------------- \\
//@function to sell the stock Intraday
//@param secret_key string Secret Key of the Dhan Account eg-> "S1HgS".
//@param symbol string Stock symbol eg-> "TATASTEEL".
//@param qty int quantity for the order eg-> 1.
//@param exchange string Trading Exchange eg-> "NSE".
//@returns order string.
export sell_stock_intraday(string secret_key, string symbol, int qty, string exchange = "NSE") => 
    secret_key_  = '"' + secret_key + '"'
    symbol_      = '"' + symbol + '"'
    qty_         = '"' + str.tostring(qty) + '"'
    exchange_    = '"' + exchange + '"'

    EQ_sell_syntex_str = '{"secret":' + secret_key_ + ',"alertType":"multi_leg_order","order_legs":[{"transactionType":"S","orderType":"MKT","quantity":' + qty_ + ',"exchange":' + exchange_ + ',"symbol":' + symbol_ + ',"instrument":"EQ","productType":"I","sort_order":"1","price":"0"}]}'

    EQ_sell_syntex_str






