    PE_buy_syntex_str        = ""

    if intraday 
        PE_buy_syntex_str        := '{"secret":' + key_str + ',"alertType":"multi_leg_order","order_legs":[{"transactionType":"B","orderType":"MKT","quantity":' + lots_str + ',"exchange":' + exchange_str + ',"symbol":' + symbol_str + ',"instrument":"OPT","productType":"I","sort_order":"1","price":"0","option_type":"PE","strike_price":' + strike_price_str + ',"expiry_date":' + expiry_date_str + '}]}'
    else  
        PE_buy_syntex_str        := '{"secret":' + key_str + ',"alertType":"multi_leg_order","order_legs":[{"transactionType":"B","orderType":"MKT","quantity":' + lots_str + ',"exchange":' + exchange_str + ',"symbol":' + symbol_str + ',"instrument":"OPT","productType":"M","sort_order":"1","price":"0","option_type":"PE","strike_price":' + strike_price_str + ',"expiry_date":' + expiry_date_str + '}]}'

    PE_buy_syntex_str


