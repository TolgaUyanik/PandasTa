//@version=6
indicator("SHK RSI STRENGTH & PRICE MOMENTUM", shorttitle="SHK RSI S&PM", overlay=false)

// ───────────────────────── Inputs ─────────────────────────
rsiLen    = input.int(14, title="Length", minval=1, group="Inputs")
rsiSrc    = input.source(close, title="Source", group="Inputs")

strengthType = input.string("WMA", title="Strength MA Type", options=["SMA", "EMA", "WMA", "HMA", "ALMA", "DWMA"], group="Inputs")
strengthLen  = input.int(21, title="Strength Length", minval=1, group="Inputs")

priceType    = input.string("EMA", title="Price MA Type", options=["SMA", "EMA", "WMA", "HMA", "ALMA", "DWMA"], group="Inputs")
priceLen     = input.int(3,  title="Price Length",   minval=1, group="Inputs")

almaOffset = input.float(0.85, title="ALMA Offset", minval=0, maxval=1, step=0.05, group="Inputs")
almaSigma  = input.float(6.0,  title="ALMA Sigma",  minval=0.1, group="Inputs")

midLine     = input.int(50, title="Mid Line", minval=35, maxval=55, group="Inputs")

showCrosses = input.bool(true, title="Show Cross Markers", group="Inputs")

// ───────────────────────── MA Type Dispatcher ─────────────────────────
f_ma(src, len, matype) =>
    switch matype
        "SMA"  => ta.sma(src, len)
        "EMA"  => ta.ema(src, len)
        "WMA"  => ta.wma(src, len)
        "HMA"  => ta.hma(src, len)
        "ALMA" => ta.alma(src, len, almaOffset, almaSigma)
        "DWMA" => ta.wma(ta.wma(src, len), len)
        => ta.wma(src, len)

// ───────────────────────── Colors (Style tab) ─────────────────────────
rsiColor      = input.color(color.white,                title="RSI",              group="Style", inline="rsi")
line50Color   = input.color(color.new(#00c8d8, 0),       title="Line 50",          group="Style", inline="l50")
strengthColor = input.color(#d6006e,                     title="Strength (WMA)",   group="Style", inline="str")
priceColor    = input.color(color.yellow,                title="Price (EMA)",      group="Style", inline="prc")
bullFillColor = input.color(color.new(color.green, 55),  title="Above 50 (Bullish)", group="Style", inline="bull")
bearFillColor = input.color(color.new(color.red, 55),    title="Below 50 (Bearish)", group="Style", inline="bear")
bullCrossColor = input.color(color.new(color.lime, 0),   title="Bull Cross",       group="Style", inline="bcross")
bearCrossColor = input.color(color.new(color.red, 0),    title="Bear Cross",       group="Style", inline="bcross")

// ───────────────────────── Calculations ─────────────────────────
rsiVal      = ta.rsi(rsiSrc, rsiLen)
line50      = float(midLine)
strengthVal = f_ma(rsiVal, strengthLen, strengthType)   // "Strength" = smoothed RSI trend
priceVal    = f_ma(rsiVal, priceLen, priceType)         // "Price"    = fast smoothed RSI

// ───────────────────────── Plots ─────────────────────────
pRsi   = plot(rsiVal,      title="RSI",              color=rsiColor,      linewidth=1)
pLine50= plot(line50,      title="Line 50",          color=line50Color,   linewidth=1)
pStr   = plot(strengthVal, title="Strength",         color=strengthColor, linewidth=2)
pPrc   = plot(priceVal,    title="Price",            color=priceColor,    linewidth=2)

// Fill between RSI and the 50 line — bullish above, bearish below
fill(pRsi, pLine50, color = rsiVal >= line50 ? bullFillColor : bearFillColor, title="Above/Below 50 Fill")

hline(70, "Overbought", color=color.new(color.gray, 70), linestyle=hline.style_dotted)
hline(30, "Oversold",   color=color.new(color.gray, 70), linestyle=hline.style_dotted)

// ───────────────────────── Cross markers (the little "o" circles) ─────────────────────────
bullCross = ta.crossover(priceVal, strengthVal)
bearCross = ta.crossunder(priceVal, strengthVal)

plotshape(showCrosses and bullCross ? priceVal : na, title="Bull Cross", style=shape.circle,
     location=location.absolute, color=bullCrossColor, size=size.tiny)
plotshape(showCrosses and bearCross ? priceVal : na, title="Bear Cross", style=shape.circle,
     location=location.absolute, color=bearCrossColor, size=size.tiny)

// ───────────────────────── Alerts ─────────────────────────
alertcondition(bullCross, title="Momentum Bull Cross", message="RSI Price line crossed above Strength line")
alertcondition(bearCross, title="Momentum Bear Cross", message="RSI Price line crossed below Strength line")
