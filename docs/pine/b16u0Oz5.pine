//@version=6
indicator("SkyStory", overlay=false, max_lines_count=500, max_labels_count=500)

//=========================
// ====== INPUT DATI =====
//=========================

// tipo di dati
string skyTypeData = input.string("close","tipo di dati",options=["close","high","low"])

// Qui incolli il CHUNK 1 dei dati MKR già back-adjusted
string mkrChunk1 = input.string("", "MKR adjusted data (chunk 1)")

// Qui incolli il CHUNK 2
string mkrChunk2 = input.string("", "MKR adjusted data (chunk 2)")

// Simbolo SKY live
string skySymbol = input.symbol("KRAKEN:SKYUSD", "Simbolo SKY (live)")

// Data di raccordo
string spliceDateStr = input.string("2024-10-03", "Data di raccordo (YYYY-MM-DD)")

bool showRaccordo = input.bool(false,"Mostra l'etichetta di raccordo dati")

//=========================
// ===== FUNZIONI ========
//=========================

// Converte una data in formato anno-mese-giorno in un numero intero YYYYMMDD
f_dateToKey(int y, int m, int d) =>
    y * 10000 + m * 100 + d

// Converte stringa "YYYY-MM-DD" in chiave numerica YYYYMMDD
f_keyFromDateStr(string s) =>
    y = math.round(str.tonumber(str.substring(s, 0, 4)))
    m = math.round(str.tonumber(str.substring(s, 5, 7)))
    d = math.round(str.tonumber(str.substring(s, 8, 10)))
    f_dateToKey(y, m, d)

// Chiave numerica della data di raccordo
spliceKey = f_keyFromDateStr(spliceDateStr)


//---------------------------------------------------------
// Funzione che legge il testo incollato e lo trasforma
// in due array: uno con le date (chiavi) e uno con i valori
//---------------------------------------------------------
f_parseChunk(string txt) =>
    array<int> keys = array.new_int()
    array<float> vals = array.new_float()

    string t = str.trim(txt)

    // Se il campo è vuoto restituiamo array vuoti
    if str.length(t) == 0
        [keys, vals]
    else
        string[] lines = str.split(t, " ")
        for i = 0 to array.size(lines) - 1
            string line = str.trim(array.get(lines, i))
            if str.length(line) == 0
                continue

            // data e valore separati da ","
            string[] parts = str.split(line, ",")

            if array.size(parts) >= 2
                string ds = str.trim(array.get(parts, 0))
                string vs = str.trim(array.get(parts, 1))

                // Trova il primo valore non vuoto dopo la data
                if str.length(vs) == 0
                    for k = 1 to array.size(parts) - 1
                        string cand = str.trim(array.get(parts, k))
                        if str.length(cand) > 0
                            vs := cand
                            break

                bool valido = str.length(ds) >= 10 and str.length(vs) > 0

                if valido
                    int key = f_keyFromDateStr(ds)
                    float v = str.tonumber(vs)

                    if not na(v)
                        array.push(keys, key)
                        array.push(vals, v)

        [keys, vals]


//=========================
// ===== COSTRUZIONE =====
//=========================

// Parsiamo i due chunk
[k1,v1] = f_parseChunk(mkrChunk1)
[k2,v2] = f_parseChunk(mkrChunk2)


// Array definitivi che conterranno tutto MKR
var array<int> mkrKeys = array.new_int()
var array<float> mkrVals = array.new_float()

// Alla prima barra carichiamo i dati nei nostri array
if barstate.isfirst
    int n1 = array.size(k1)
    if n1 > 0
        for i = 0 to n1 - 1
            array.push(mkrKeys, array.get(k1, i))
            array.push(mkrVals, array.get(v1, i))

    int n2 = array.size(k2)
    if n2 > 0
        for i = 0 to n2 - 1
            array.push(mkrKeys, array.get(k2, i))
            array.push(mkrVals, array.get(v2, i))


// Ritorna l'indice del primo elemento >= target (lower_bound).
// Se non esiste, ritorna -1.
// PRECONDIZIONE: keys ordinato in modo crescente!
f_lowerBound(array<int> keys, int target) =>
    int n = array.size(keys)
    int lo = 0
    int hi = n  // hi escluso

    while lo < hi
        int mid = lo + (hi - lo) / 2
        int km = array.get(keys, mid)
        if km >= target
            hi := mid
        else
            lo := mid + 1

    lo < n ? lo : -1


//---------------------------------------------------------
// Funzione che restituisce il valore MKR per una certa data
//---------------------------------------------------------
f_valueOnKey_Slow(int key, array<int> keys, array<float> vals) =>
    float risultato = na

    for i = 0 to array.size(keys) - 1
        if array.get(keys, i) >= key
            risultato := array.get(vals, i)
            break

    risultato

f_valueOnKey(int key, array<int> keys, array<float> vals) =>
    int idx = f_lowerBound(keys, key)
    idx == -1 ? na : array.get(vals, idx)

//=========================
// ===== SERIE LIVE ======
//=========================

// Calcoliamo la chiave della barra corrente
int y = year(time)
int m = month(time)
int d = dayofmonth(time)
int barKey = f_dateToKey(y, m, d)

// Prezzo SKY live dal simbolo TradingView
float skyData = request.security(
     skySymbol,
     timeframe.period,
     (skyTypeData=="close" ? close : (skyTypeData=="high" ? high : low)),
     barmerge.gaps_off,
     barmerge.lookahead_off)


float serieContinua=na

if barKey>array.get(mkrKeys, 0)
    if barKey < spliceKey
        // Prima della data di raccordo → usiamo MKR aggiustato
        serieContinua := f_valueOnKey(barKey, mkrKeys, mkrVals)
    else
        serieContinua := skyData


plot(serieContinua, title="sky", linewidth=1)


// Etichetta visiva nel giorno di raccordo
if barKey == spliceKey and showRaccordo
    label.new(bar_index, serieContinua, "RACCORDO", style=label.style_label_down)