_                                                                                                                                                                                                                                                                = "
  -----------------------------  -----------------------------  -----------------------------  ----------------------------
 lastSundayOfMonth() gives the last day of the month of a certain day, for example you want to know on which day is the last SUNDAY, or TUESDAY, or ... 
 Just import the library, for example:

 import fikira/X/9
 plot(X.lastSundayOfMonth('THU'))

 The optional 'adj' can be used on certain pairs (forex for example) where the start of the week is Sunday, and not Monday
 For example, on the EURUSD pair you can add 1 as 'adj':

 import fikira/X/9
 plot(X.lastSundayOfMonth('THU', 1))
 
  -----------------------------  -----------------------------  -----------------------------  ----------------------------                                                                                                                                        "            

//adj = input.int(0)

// @function lastSundayOfMonth(): Shows last x day of the month
// @param DAY: Choose the desired day ('MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT', 'SUN')
// @param adj (optional): add/subtract 1 when needed (for example on FOREX pairs)
// @returns int (day of month)
export lastSundayOfMonth(string DAY, int adj = 0) =>
    var lastSUN = 0 

    arrD = array.from('MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT', 'SUN')
    
    min = arrD.indexof(DAY) +1
    if min < 1 
        runtime.error('"DAY" must be 1 of the strings from "arrD"')
    else
        leap = 29, leap := year % 400 == 0 ? 29 : year % 100 == 0 ? 28 : year % 4 == 0 ? 29 : 28
        days = array.from(0, 31, leap, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31)

        if timeframe.change('M')
            days_in_month = days.get(month)
            day = dayofweek + adj - min  //sunday == 1
            firstSunday = 7 - day == 6 ? 1 : 9 - day
            lastSUN := days_in_month - ((days_in_month - firstSunday) % 7)
    lastSUN

//plot(lastSundayOfMonth('MON'))


// ------------------------------------------------------------------------------------------------------------------------
_                                                                                                                                                                                                                                                                = "
  -----------------------------  -----------------------------  -----------------------------  ----------------------------
 isDark() 
 The following assumption states when all 3 colour components' values are below 80, we are in the dark mode:

  -----------------------------  -----------------------------  -----------------------------  ----------------------------                                                                                                                                        "            

// @function Returns a boolean output, true when the chart background is dark, false if otherwise
// @returns  Returns a boolean output, true when the chart background is dark, false if otherwise
export isDark() => 
    r = color.r(chart.bg_color)
    g = color.g(chart.bg_color)
    b = color.b(chart.bg_color)
    isDark = r < 80 and g < 80 and b < 80


// ------------------------------------------------------------------------------------------------------------------------
_                                                                                                                                                                                                                                                                = "
  -----------------------------  -----------------------------  -----------------------------  ----------------------------
 round_sig() 
 Rounds a number to the desired amount of significant figures.

  -----------------------------  -----------------------------  -----------------------------  ----------------------------                                                                                                                                        "            

// Significant Figures (sf):

//  - Is always a sf:
//    • Non-zero digits                         -> 12345.67 (7 sf)               
//    • Zeros between non-zero digits           -> 12034056 (8 sf)

//  - Is never a sf:
//    • Leading zeros                           -> 0.00123  (3 sf)

//  - Trailing zeros are only significant 
//    if the number is above 1                  -> 12300    (5 sf) 

// EXAMPLES 
// + = sf, - = non-sf 

// Examples of Significant Figures

// 1234   -> 4 sf: 1, 2, 3, 4   )
// 12.34  -> 4 sf: 1, 2, 3, 4   )
//  0.06  -> 1 sf: 6            )
// 10.04  -> 4 sf: 1, 0, 0, 4   )
// 12300  -> 5 sf: 1, 2, 3, 0, 0)
// 123.0  -> 4 sf: 1, 2, 3, 0   ) so when rounded to 2 sf -> 120

// @function Returns a rounded number after isolating x significant numbers
// @param number    number to round
// @param round_to  round to x sign. figures
// @param only_R    if enabled, when number > 1 only the values at the right of decimal point are considered 
// @returns Rounded number to x significant figures
export method round_sig(float number, int round_to, bool only_R) => 
    log10 = math.log10(number), floor = math.floor(log10) +1, mlt = math.pow(10, floor) 
    out   = only_R and number >= 1 ? math.round(number, round_to) : math.round(number / mlt, round_to) * mlt

// Details

// math.log10() 
// given: 
//   10 * 10            = 100   -> 10^2 (math.pow(10, 2) -> 100   has 3 digits (=2+1)
//   10 * 10 * 10       = 1000  -> 10^3 (math.pow(10, 3) -> 1000  has 4 digits (=3+1)
//   10 * 10 * 10 * 10  = 10000 -> 10^4 (math.pow(10, 4) -> 10000 has 5 digits (=4+1)
//
// So, if you would know how many times 10 needs to be squared, you know how many digits that number has
// Example, 100000 -> 10 needs to be squared 5 times (10 * 10 * 10 * 10 * 10 OR 10^5) to get 100000
//
// math.log10() gives you that number -> math.log10(100000) = 5 -> 6 digits
//
// math.log10(101000) = 5.004321374, but the amount of digits needs to be an integer number, 6 OR 7 (= 5 OR 6 +1)
//
// Therefore we need to round this number, in this case we need the largest integer less than or equal to the given number.
// Why? Because every integer number between 100000 and 1000000 (not 1000000) has 6 digits.
// -> We can do this with math.floor()
//
// math.floor() - 'floor' gives you the position of the FIRST digit > 0
//
//      close           floor  
//
//    +++++.-------
//    43210.12345678
//    ||||| ||||||||
//    43805.44            4
//     2298.67            3
//      113.36            2
//       13.93            1
//       10.905           1
//       15.8008          1
//       15.8057867       1
//        2.65556341      0
//        0.61857        -1
//        0.05349        -2
//        0.002594       -3
//        0.0002532      -4
//        0.00001412     -5
//        0.00001218     -5
//        0.00000216     -6
//        0.0000001347   -7
//        0.00000004855  -8
//        0.00000005082  -8
//    ||||| ||||||||
//    43210.12345678
//    +++++.-------

// round number to x sf -> x = 2                                                                 sf 12
//                                                                                                  ||
// 43805.44 ( 4) -> 43805.44 / 100000 (or * 0.00001) -> math.round(0.4380544, x) -> 0.44 * 100000 = 44000
// 2298.67  ( 3) -> 2298.67  / 10000  (or * 0.0001 ) -> math.round(0.229867 , x) -> 0.23 * 10000  = 2300
// 113.36   ( 2) -> 113.36   / 1000   (or * 0.001  ) -> math.round(0.11336  , x) -> 0.11 * 1000   = 110
// 13.93    ( 1) -> 13.93    / 100    (or * 0.01   ) -> math.round(0.1393   , x) -> 0.14 * 100    = 14.0

//                                                                                              sf  1 2
//                                                                                                  | |
// 2.65556  ( 0) -> 2.65556  / 10     (or * 0.1    ) -> math.round(0.265556 , x) -> 0.27 * 10     = 2.70

//                                                                                              sf    12
//                                                                                                    ||
// 0.61857  (-1) -> 0.6185   /  1     (or * 1      ) -> math.round(0.6185   , x) -> 6.20 * 1      = 0.62



// ------------------------------------------------------------------------------------------------------------------------
// ------------------------------------------------------------------------------------------------------------------------
_                                                                                                                                                                                                                                                                = "
  -----------------------------  -----------------------------  -----------------------------  ----------------------------
                                                           EXAMPLES      
  -----------------------------  -----------------------------  -----------------------------  ----------------------------                                                                                                                                        "            

// ------------------------------------------------------------------------------------------------------------------------
// ------------------------------------------------------------------------------------------------------------------------

import fikira/X/5 as X
 
choice = input.string('slope'
       , options=['count number in array', 'get', 'sum all numbers till under 10'
       , 'is dark background', 'slope', 'ma with series length', 'Round to x Significant Figures'])

cnia = choice == 'count number in array'
iget = choice == 'get'
bten = choice == 'sum all numbers till under 10'
dark = choice == 'is dark background'
slop = choice == 'slope'
ixma = choice == 'ma with series length'
rtsf = choice == 'Round to x Significant Figures'

// - - - - - - - - - - - - - - - - - - - - -

// count_num_in_array(), get_() & sumAllNumbers_till_under_10()

// Typically, we use loops for counting how many values an array contains
// With count_num_in_array(), we don't use a loop, but the build-in functions array.sort(), array.includes(), array.lastindexof() and array.indexof()
// this should give us better performance due to using less loops

aF1 = array.from(3, 4, 3, 0, 1., 2, 3, 4) // array<float> -> becomes sorted by count_num_in_array() 
aI1 = array.from(3, 4, 3, 0, 1 , 2, 3, 4) // array<int>   -> becomes sorted by count_num_in_array() 

plot(cnia ? X.count_num_in_array(aF1, 3)        : na, color=color.red)      // count_num_in_array() used as FUNCTION
plot(cnia ? aF1.count_num_in_array(5)           : na, color=color.blue)     // count_num_in_array() used as  METHOD
plot(cnia ? aI1.count_num_in_array(0)           : na, color=color.white)


// - - - - - - - - - - - - - - - - - - - - -

// XYaxis() & calculate_slope()
type p 
    int b
    float p

var aPiv = array.new<p>(2, p.new(na, na))
len      = 10
ph       = ta.pivothigh(len, len)
bars     = 500
Yaxis    = bars.XYaxis() 

if not na(ph) and slop
    [slope, angle] = bars.calculate_slope(
       XYratio = 3
     , Yaxis   = Yaxis
     , x1      = aPiv.first().b
     , y1      = aPiv.first().p
     , x2      = n -len
     , y2      = ph
     )

    line.new (aPiv.first().b, aPiv.first().p, n -len, ph, color=color.fuchsia)
    label.new(                                n -len, ph
     , text      = str.format("slope: {0} / bar\nangle: {1}°", slope, angle)
     , style     = label.style_none
     , textcolor = color.yellow
     )

    aPiv.unshift(p.new(n - len, ph)), aPiv.pop() 


// - - - - - - - - - - - - - - - - - - - - -

// xma(), iType = 'ema', length = 20

// 1) XMA
var xma  = xma.new(aSrc = array.new<float>(20, na), aXma = array.new<float>(20, na)) 
_xma     = xma.xma('ema', close, 20)

// 2) XMA array length 20 -> 120
var aXma = array.new<xma>() 
if barstate.isfirst 
    for i = 0 to 99 
        aXma.unshift(
          xma.new(aSrc = array.new<float>(20 + 100, na), aXma = array.new<float>(20 + 100, na)) 
         )

for i = 0 to 99 
    aXma.get(i).xma('ema', close, 20 + i)
     
// 3) testMa
testMa  = X.testMa('ema', close, 20     )
testMa2 = X.testMa('ema', close, 20 + 30)

plot(ixma ? _xma : na, color=color.silver)

plot(ixma ? aXma.get( 0).xma : na) // index  0 is xma with iLen
plot(ixma ? testMa           : na, color=color.new(color.fuchsia, 75), linewidth=7)

plot(ixma ? aXma.get(30).xma : na, color=color.red) // index 30 is xma with iLen + 30
plot(ixma ? testMa2          : na, color=color.new(color.yellow , 75), linewidth=7)


// - - - - - - - - - - - - - - - - - - - - -

// Round to x Significant Figures 
sig             = input.int   (  2   ,                ' to x Significant Figures' , minval=1, inline='s')
only_right_side = input.bool  (false , '', tooltip='Only right side of decimal point'       , inline='s')

round_sig = close.round_sig(sig, only_right_side)

arr = array.from(3, 4, 3, 0, 1 , 2, 3, 4) // array<int>   -> not sorted

var table tab = table.new(position.middle_right, 2, 1, na, color.new(color.silver, 75), 1, color.new(color.silver, 75), 1)
if barstate.islast
    txt = '', num = 0.
    switch 
        cnia => txt :=     '4 is x times in array: '   , num := aF1.count_num_in_array(4)      
        iget => txt :=        'array.get(-3): '        , num := arr.get_(-3)    
        bten => txt := "Sum digits 'close' till < 10: ", num := close.sumAllNumbers_till_under_10()   
        rtsf => txt :=     'round_sig(source, sig)'    , num := round_sig   
        dark => txt :=    'chart background is dark?'  
    if cnia or iget or bten or rtsf or dark
        tab.cell(0, 0, text = txt, text_halign=text.align_left, text_color=chart.fg_color), table.cell(tab, 1, 0, text = dark ? str.tostring(isDark()) : str.tostring(num), text_color=chart.fg_color)

