//@version=6
library("SMCDrawing", overlay=true)

// Import SMCFunctions to access the FVGData custom type
import viorel8/SMCFunctions/6 as F // Assuming this is the correct published handle for your SMCFunctions v6 library

// --- Drawing Functions ---

// Function to draw swing point labels
export drawSwingPointLabel(int bar_idx, float price_val, string swing_type_str, color text_color_val, string size_str) =>
    string label_txt = switch swing_type_str
        "HH" => "▼"
        "LH" => "▽"
        "HL" => "▲"
        "LL" => "△"
        => ""
    label_style_val = swing_type_str == "HH" or swing_type_str == "LH" ? label.style_label_down : label.style_label_up
    label_size_val = switch size_str 
        "tiny" => size.tiny
        "small" => size.small
        "normal" => size.normal
        "large" => size.large
        "huge" => size.huge
        => size.tiny 
    if label_txt != ""
        label.new(bar_idx, price_val, label_txt, color=color.new(color.black,100), style=label_style_val, textcolor=text_color_val, size=label_size_val)

// Function to draw BOS/CHoCH lines and labels
export drawBOSLabel(int start_bar_idx, float price_val, int end_bar_idx, string bos_text_str, color line_color_val, string line_style_str, int line_width_val, color text_color_val, string size_str) =>
    line_style_enum = switch line_style_str
        "Solid" => line.style_solid
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_solid
    label_size_val = switch size_str
        "tiny" => size.tiny
        "small" => size.small
        "normal" => size.normal
        "large" => size.large
        "huge" => size.huge
        => size.tiny
        
    int actual_start_bar_idx = math.min(start_bar_idx, end_bar_idx)

    line.new(actual_start_bar_idx, price_val, end_bar_idx, price_val, color=line_color_val, style=line_style_enum, width=line_width_val)
    label.new(math.floor(end_bar_idx - (end_bar_idx - actual_start_bar_idx) / 2), price_val, bos_text_str, color=color.new(color.black,100), textcolor=text_color_val, style=price_val < close ? label.style_label_up : label.style_label_down, size=label_size_val)

// Function to draw retracement lines
export drawRetracementLine(int start_bar_idx, float price_val, int end_bar_idx, color line_color_val, string line_style_str, int line_width_val) =>
    line_style_enum = switch line_style_str
        "Solid" => line.style_solid
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_solid
    line.new(start_bar_idx, price_val, end_bar_idx, price_val, color=line_color_val, style=line_style_enum, width=line_width_val)

// Function to draw FVG boxes
// CORRECTED: fvg_data parameter is now explicitly typed using the imported FVGData type from SMCFunctions
export drawFVGBox(F.FVGData fvg_data, color fvg_box_color, bool extend_right, int current_bar_time, int current_bar_idx) => 
    box box_obj = na // Initialize box_obj to na
    if not na(fvg_data) and not fvg_data.mitigated
        // The FVG is "discovered" on fvg_data.discovery_bar_index. This is the bar that completes the 3-bar pattern.
        // The box should visually start at the time of this discovery bar.
        int x1_time_val = time[current_bar_idx - fvg_data.discovery_bar_index] 

        // If extending, x2 goes far to the right. Otherwise, make it for a few bars.
        int x2_time_val = extend_right ? current_bar_time + timeframe.in_seconds() * 1000 * 50 : x1_time_val + timeframe.in_seconds() * 1000 * 5 // Extend 5 bars if not fully extending
        
        // Ensure x1_time_val is not in the future relative to current_bar_time
        if x1_time_val > current_bar_time
            x1_time_val := current_bar_time 
            x2_time_val := current_bar_time + timeframe.in_seconds() * 1000 * (extend_right ? 50 : 5)

        // Ensure the box has a valid width
        if x2_time_val <= x1_time_val
            x2_time_val := x1_time_val + timeframe.in_seconds() * 1000 // Minimum 1 bar width

        box_obj := box.new( // Assign the created box to box_obj
             left = x1_time_val, 
             top = fvg_data.top_price, 
             right = x2_time_val, 
             bottom = fvg_data.bottom_price,
             border_color = fvg_box_color,
             bgcolor = color.new(fvg_box_color, 80), 
             xloc = xloc.bar_time,
             text = fvg_data.is_bullish ? "Bull FVG" : "Bear FVG",
             text_size = size.tiny,
             text_color = color.new(fvg_box_color,0), 
             text_halign = text.align_center,
             text_valign = text.align_center
             )
    // Return the box ID so the main script can manage it for deletion
    box_obj 

// Placeholder for BPR Label
export drawBPRLabel(int bar_time, float price, bool is_bullish, color text_color) =>
    label.new(bar_time, price, is_bullish ? "Bull BPR" : "Bear BPR", xloc=xloc.bar_time, style=label.style_none, textcolor=text_color)

