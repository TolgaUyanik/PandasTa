//@version=6
indicator('6FG Plan Checklist & Alerts - Final Version', overlay = true)

// === Toggles ===
show_session_filter = input.bool(true, 'Filter by Session (Asia/NY)')
show_4h_trend = input.bool(true, 'Use 4H Trend as Confirmation')
show_15m_confirmation = input.bool(true, 'Check 15M Candle Confirmation')
show_checklist = input.bool(true, 'Show Checklist Table')
show_a_plus_labels = input.bool(true, 'Show A+ Labels')

// === Session Filter ===
var string sessionNY = '0800-1600'
var string sessionAsia = '1700-0000'
check_session = bool(time(timeframe.period, sessionAsia)) or bool(time(timeframe.period, sessionNY))
sessionOK = not show_session_filter or check_session

// === 4H Trend (Confirmation Only) ===
h4_close = request.security(syminfo.tickerid, '240', close)
h4_sma = request.security(syminfo.tickerid, '240', ta.sma(close, 20))
check_4h_bullish = h4_close > h4_sma
check_4h_bearish = h4_close < h4_sma
trendOK = not show_4h_trend or check_4h_bullish or check_4h_bearish

// === H1 Structure & BOS (Required) ===
h1_close = request.security(syminfo.tickerid, '60', close)
h1_prev_high = request.security(syminfo.tickerid, '60', ta.highest(high[1], 10))
h1_prev_low = request.security(syminfo.tickerid, '60', ta.lowest(low[1], 10))
bos_bull = h1_close > h1_prev_high
bos_bear = h1_close < h1_prev_low
bosOK = bos_bull or bos_bear // Required

// === 15M Candle Confirmation ===
m15_open = request.security(syminfo.tickerid, '15', open)
m15_close = request.security(syminfo.tickerid, '15', close)
m15_high = request.security(syminfo.tickerid, '15', high)
m15_low = request.security(syminfo.tickerid, '15', low)

bull_engulf = m15_close > m15_open and m15_close[1] < m15_open[1] and m15_close > m15_open[1]
bear_engulf = m15_close < m15_open and m15_close[1] > m15_open[1] and m15_close < m15_open[1]
pin_bar = math.abs(m15_close - m15_open) < (m15_high - m15_low) * 0.3 and (m15_high - math.max(m15_close, m15_open) > (m15_high - m15_low) * 0.6 or math.min(m15_close, m15_open) - m15_low > (m15_high - m15_low) * 0.6)

confirmOK = not show_15m_confirmation or bull_engulf or bear_engulf or pin_bar

// === Final Entry Trigger (A+ Setup) ===
entryOK = sessionOK and bosOK and trendOK and confirmOK

// === A+ Label ===
if show_a_plus_labels and entryOK
    label.new(bar_index, high, '✅ A+ Setup', style = label.style_label_up, color = color.lime, textcolor = color.white)

// === Checklist Table ===
var table chk = table.new(position.top_right, 2, 9, border_width = 2)
if show_checklist and barstate.islast
    table.cell(chk, 0, 0, '6FG PLAN', bgcolor = color.black, text_color = color.white)
    table.cell(chk, 1, 0, '', bgcolor = color.gray)
    table.cell(chk, 0, 1, 'Item', bgcolor = color.blue, text_color = color.white)
    table.cell(chk, 1, 1, 'Status', bgcolor = color.blue, text_color = color.white)
    table.cell(chk, 0, 2, 'Session OK')
    table.cell(chk, 1, 2, sessionOK ? '✔️' : '❌', text_color = sessionOK ? color.green : color.red)
    table.cell(chk, 0, 3, '4H Bullish')
    table.cell(chk, 1, 3, check_4h_bullish ? '✔️' : '❌', text_color = check_4h_bullish ? color.green : color.red)
    table.cell(chk, 0, 4, '4H Bearish')
    table.cell(chk, 1, 4, check_4h_bearish ? '✔️' : '❌', text_color = check_4h_bearish ? color.green : color.red)
    table.cell(chk, 0, 5, 'H1 BOS')
    table.cell(chk, 1, 5, bosOK ? '✔️' : '❌', text_color = bosOK ? color.green : color.red)
    table.cell(chk, 0, 6, '15M Candle')
    table.cell(chk, 1, 6, confirmOK ? '✔️' : '❌', text_color = confirmOK ? color.green : color.red)
    table.cell(chk, 0, 7, 'Direction')
    table.cell(chk, 1, 7, bos_bull ? 'H1 Bullish BOS' : bos_bear ? 'H1 Bearish BOS' : '—', text_color = color.yellow)

// === Alert ===
alertcondition(entryOK, title = '6FG A+ Setup', message = '✅ A+ Setup aligned: Session, 4H Trend, H1 BOS, and 15M Confirmed')
