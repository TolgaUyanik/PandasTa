//@version=6
indicator('Morning Break Out', overlay = true)

// === Variablen und Session-Erkennung ===
var float sessHigh = na
var float sessLow = na
var box myBox = na
var int breakout = 0 // 0 = kein Breakout, 1 = Up, -1 = Down

// Neuer Handelstag
if bool(ta.change(time('D')))
    sessHigh := na
    sessLow := na
    breakout := 0
    myBox := na
    myBox

// 09:00–09:59: Hoch und Tief sammeln
if hour == 9
    sessHigh := na(sessHigh) ? high : math.max(sessHigh, high)
    sessLow := na(sessLow) ? low : math.min(sessLow, low)
    sessLow

// Erste 10:00‑Bar: Box zeichnen von 09:00 bis 14:00
if hour == 10 and minute == 0 and na(myBox)
    t0 = timestamp(syminfo.timezone, year(time), month(time), dayofmonth(time), 9, 0)
    t1 = timestamp(syminfo.timezone, year(time), month(time), dayofmonth(time), 17, 30)
    myBox := box.new(left = t0, top = sessHigh, right = t1, bottom = sessLow, xloc = xloc.bar_time, border_color = color.gray, border_width = 1, bgcolor = color.new(color.gray, 80))
    myBox

// Nach 10:00: Breakout erkennen und Box färben
if not na(myBox) and breakout == 0
    if high > sessHigh
        box.set_bgcolor(myBox, color.new(color.green, 80))
        breakout := 1
        breakout
    else if low < sessLow
        box.set_bgcolor(myBox, color.new(color.red, 80))
        breakout := -1
        breakout
