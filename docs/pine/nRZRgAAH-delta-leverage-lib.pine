// Main leverage lookup function (dispatches to exchange-specific functions)
export get_max_leverage(string exchangePrefix, string tvTicker) =>
    switch exchangePrefix
        "BINANCE" => get_max_leverage_binance(tvTicker)
        "BITGET" => get_max_leverage_bitget(tvTicker)
        "BITMEX" => get_max_leverage_bitmex(tvTicker)
        "BYBIT" => get_max_leverage_bybit(tvTicker)
        "KUCOIN" => get_max_leverage_kucoin(tvTicker)
        "OKX" => get_max_leverage_okx(tvTicker)
        => na

export get_max_leverage_for_chart() =>
    get_max_leverage(syminfo.prefix, syminfo.ticker)

export get_max_leverage_or_default(string exchangePrefix, string tvTicker, int defaultLev) =>
    int v = get_max_leverage(exchangePrefix, tvTicker)
    na(v) ? defaultLev : v
