//@version=5
// @description The "iterator" library provides a versatile and efficient set of functions for creating and managing iterators.
// It allows you to generate arrays of integers or floats with customizable steps, both inclusive and exclusive of the end values.
// The library also includes methods for iterating over various types, including booleans, integers, floats, strings, colors,
// and drawing objects like lines and labels. With support for reverse iteration and flexible customization options.
library("iterator")

// iterator {

_iterator(series int length, bool reverse)=>
    int start = reverse ? length - 1 : 0
    int stop = reverse ? -1 : length
    int sign = stop >= start ? 1 : -1
    int step = 1 * sign

    int[] iterator = array.new<int>()

    if start != stop
        int counter = start

        while counter != stop
            iterator.push(counter)
            counter += step

    iterator

// @function Creates an array of integers from start to stop with a specified step, excluding the stop value.
// @param stop The end value of the iterator, exclusive.
// @param start The starting value of the iterator. Default is 0.
// @param step The increment value for each step in the iterator. Default is 1. Must be greater than 0.
// @returns An array of integers incremented by the step value from start to stop. Will return and empty array if start = stop.
export iterator(series int stop, series int start = 0, series int step = 1)=>
    int size = (math.max(start, stop) - math.min(start, stop)) / step
    bool too_large = size > 100000

    if too_large
        string error = "(" + str.tostring(math.max(start, stop)) + " - " + str.tostring(math.min(start, stop)) + ") / " + str.tostring(step) + " = " + str.tostring(size)
        runtime.error("Size of iterator must be less than 100,000. " + error)

    if step <= 0
        runtime.error("Step must be greater than 0.")

    var int[] iterator = array.new<int>()
    bool direction = stop >= start
    int sign = direction ? 1 : -1
    int internal_step = math.abs(step) * sign

    bool remake_condition = stop != stop[1] or start != start[1] or step != step[1]

    if remake_condition
        iterator.clear()

    if iterator.size() == 0
        int counter = start

        while direction ? counter < stop : counter > stop
            iterator.push(counter)
            counter += internal_step

    iterator

// @function Creates an array of floats from start to stop with a specified step, excluding the stop value.
// @param stop The end value of the iterator, exclusive.
// @param start The starting value of the iterator. Default is 0.
// @param step The increment value for each step in the iterator. Default is 1. Must be greater than 0.
// @returns An array of floats incremented by the step value from start to stop. Will return and empty array if start = stop.
export iterator(series float stop, series float start = 0, series float step = 1)=>
    float size = (math.max(start, stop) - math.min(start, stop)) / step + 1
    bool too_large = size > 100000

    if too_large
        string error = "(" + str.tostring(math.max(start, stop)) + " - " + str.tostring(math.min(start, stop)) + ") / " + str.tostring(step) + " + 1 = " + str.tostring(size)
        runtime.error("Size of iterator must be less than 100,000. " + error)

    if step <= 0
        runtime.error("Step must be greater than 0.")

    var float[] iterator = array.new<float>()
    bool direction = stop >= start
    int sign = direction ? 1 : -1
    float internal_step = math.abs(step) * sign

    bool remake_condition = stop != stop[1] or start != start[1] or step != step[1]

    if remake_condition
        iterator.clear()

    if iterator.size() == 0
        float counter = start

        while direction ? counter < stop : counter > stop
            iterator.push(counter)
            counter += internal_step

    iterator

// @function Creates an array of integers from start to stop with a specified step, including the stop value.
// @param stop The end value of the iterator, inclusive.
// @param start The starting value of the iterator. Default is 0.
// @param step The increment value for each step in the iterator. Default is 1. Must be greater than 0.
// @returns An array of integers incremented by the step value from start to stop, including the stop value.
export iterator_inclusive(series int stop, series int start = 0, series int step = 1)=>
    int size = (math.max(start, stop) - math.min(start, stop)) / step
    bool too_large = size > 100000

    if too_large
        string error = "(" + str.tostring(math.max(start, stop)) + " - " + str.tostring(math.min(start, stop)) + ") / " + str.tostring(step) + " = " + str.tostring(size)
        runtime.error("Size of iterator must be less than 100,000. " + error)

    if step <= 0
        runtime.error("Step must be greater than 0.")

    var int[] iterator = array.new<int>()
    bool direction = stop >= start
    int sign = direction ? 1 : -1
    int internal_step = math.abs(step) * sign

    bool remake_condition = stop != stop[1] or start != start[1] or step != step[1]

    if remake_condition
        iterator.clear()

    if iterator.size() == 0
        int counter = start - internal_step

        while direction ? counter <= stop : counter >= stop
            counter += internal_step

            switch direction
                true => iterator.push(math.min(counter, stop))
                => iterator.push(math.max(counter, stop))

    iterator

// @function Creates an array of floats from start to stop with a specified step, including the stop value.
// @param stop The end value of the iterator, inclusive.
// @param start The starting value of the iterator. Default is 0.
// @param step The increment value for each step in the iterator. Default is 1. Must be greater than 0.
// @returns An array of floats incremented by the step value from start to stop, including the stop value.
export iterator_inclusive(series float stop, series float start = 0, series float step = 1)=>
    float size = (math.max(start, stop) - math.min(start, stop)) / step + 1
    bool too_large = size > 100000

    if too_large
        string error = "(" + str.tostring(math.max(start, stop)) + " - " + str.tostring(math.min(start, stop)) + ") / " + str.tostring(step) + " + 1 = " + str.tostring(size)
        runtime.error("Size of iterator must be less than 100,000. " + error)

    if step <= 0
        runtime.error("Step must be greater than 0.")

    var float[] iterator = array.new<float>()
    bool direction = stop >= start
    int sign = direction ? 1 : -1
    float internal_step = math.abs(step) * sign

    bool remake_condition = stop != stop[1] or start != start[1] or step != step[1]

    if remake_condition
        iterator.clear()

    if iterator.size() == 0
        float counter = start - internal_step

        while direction ? counter <= stop : counter >= stop
            counter += internal_step

            switch direction
                true => iterator.push(math.min(counter, stop))
                => iterator.push(math.max(counter, stop))

    iterator

// @function Creates an array of integers from start to stop with a specified step, excluding the stop value.
// @param stop The end value of the iterator, exclusive.
// @param start The starting value of the iterator. Default is 0.
// @param step The increment value for each step in the iterator. Default is 1. Must be greater than 0.
// @returns An array of integers incremented by the step value from start to stop.
export itr(series int stop, series int start = 0, series int step = 1)=> iterator(stop, start, step)

// @function Creates an array of floats from start to stop with a specified step, excluding the stop value.
// @param stop The end value of the iterator, exclusive.
// @param start The starting value of the iterator. Default is 0.
// @param step The increment value for each step in the iterator. Default is 1. Must be greater than 0.
// @returns An array of floats incremented by the step value from start to stop.
export itr(series float stop, series float start = 0, series float step = 1)=> iterator(stop, start, step)

// @function Creates an array of integers from start to stop with a specified step, including the stop value.
// @param stop The end value of the iterator, inclusive.
// @param start The starting value of the iterator. Default is 0.
// @param step The increment value for each step in the iterator. Default is 1. Must be greater than 0.
// @returns An array of integers incremented by the step value from start to stop, including the stop value.
export itr_in(series int stop, series int start = 0, series int step = 1)=> iterator_inclusive(stop, start, step)

// @function Creates an array of floats from start to stop with a specified step, including the stop value.
// @param stop The end value of the iterator, inclusive.
// @param start The starting value of the iterator. Default is 0.
// @param step The increment value for each step in the iterator. Default is 1. Must be greater than 0.
// @returns An array of floats incremented by the step value from start to stop, including the stop value.
export itr_in(series float stop, series float start = 0, series float step = 1)=> iterator_inclusive(stop, start, step)

