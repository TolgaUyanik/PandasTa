// array methods {

// @function Creates an iterator array for the indices of ana array, with an option to reverse the order.
// @param self The array to iterate over.
// @param reverse A boolean flag indicating whether to reverse the iterator order. Default is false.
// @returns An array of integers representing the indices of the array. The order can be reversed if specified.
export method iterate(bool[] self, bool reverse = false)=>
    int[] iterator = _iterator(self.size(), reverse)
    iterator

// @function Creates an iterator array for the indices of ana array, with an option to reverse the order.
// @param self The array to iterate over.
// @param reverse A boolean flag indicating whether to reverse the iterator order. Default is false.
// @returns An array of integers representing the indices of the array. The order can be reversed if specified.
export method iterate(int[] self, bool reverse = false)=>
    int[] iterator = _iterator(self.size(), reverse)
    iterator

// @function Creates an iterator array for the indices of ana array, with an option to reverse the order.
// @param self The array to iterate over.
// @param reverse A boolean flag indicating whether to reverse the iterator order. Default is false.
// @returns An array of integers representing the indices of the array. The order can be reversed if specified.
export method iterate(float[] self, bool reverse = false)=>
    int[] iterator = _iterator(self.size(), reverse)
    iterator

