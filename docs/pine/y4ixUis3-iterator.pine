// example {

access(int n)=>
    math.max(math.min(n, (bar_index + n) - last_bar_index), -1)

get_value(list)=>
    int i = access(list.size() - 1)
    float value = na

    if i > -1
        value := list.get(i)

    value

int[] int_iterator = iterator(14, 5, 2)
float[] float_iterator = iterator_inclusive(0, 10, 0.5)

int sum = 0

for i in float_iterator.iterate()
    sum += i

plot(sum / 10, "Example", color.green)
plot(get_value(int_iterator), "Int Iterator")
plot(get_value(float_iterator), "Float Iterator", color.red)

// }
