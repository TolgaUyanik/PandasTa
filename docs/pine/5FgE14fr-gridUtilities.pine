//@version=5

// @description TODO: add library description here
library("gridUtilities", true)
import AlgoTrader_Pro/formattingUtilities/12 as fu
import AlgoTrader_Pro/dataTableUtilities/13 as du

// CONSTANTS
//-------------
string DATATABLE_TITLE				= 'FIBONACCI GRID'
string GROUP_FIBONACCI_GRID     	= 'FIBONACCI GRID ================================'
string GROUP_DATATABLE     			= 'DATA TABLE ================================'


color   COLOR_MID_FIB   = color.orange 
color   COLOR_FIB_LEVEL = color.gray 
color	COLOR_TRANSP 	= color.new(color.gray, 100)
string  FIB_LEVEL_STYLE = line.style_dashed
string 	FIB_LABEL_SIZE	= size.small
int     FIB_LEVEL_WIDTH = 1
int     BARS_TO_RIGHT   = 5

// DataTable
dataTable_map 		    = map.new<string, string>()



// INPUTS
//-------------
bool    plot_fib_levels_input 	= input.bool(true, "Plot Fibonacci Levels", group = GROUP_FIBONACCI_GRID)
int 	length_input			= input.int(1000, "Length", group = GROUP_FIBONACCI_GRID)
string 	trend_direction_input	= input.string('Long', 'Trend Direction', options=['Long', 'Short'], group = GROUP_FIBONACCI_GRID)
bool 	plot_labels_input 		= input.bool(true, 'Plot Labels', group = GROUP_FIBONACCI_GRID, inline='1')
bool	include_levels_input 	= input.bool(false, 'Include Levels', group = GROUP_FIBONACCI_GRID, inline='1')
bool	plot_dataTable_input 	= input.bool(true, "Plot Data Table", group = GROUP_DATATABLE)
string 	tableYposInput          = input.string("Bottom", "Position", inline = "p", options = ["Top", "Middle", "Bottom"], group = GROUP_DATATABLE)
string 	tableXposInput          = input.string("Left", "", inline = "p", options = ["Left", "Center", "Right"], group = GROUP_DATATABLE)
string  table_textSize_input    = input.string('Small', 'Text Size', options = ['Auto', 'Tiny', 'Small', 'Normal'], group = GROUP_DATATABLE)


// FUNCTIONS
//-------------------
get_fibonacci_levels(length, trend_direction)=>


    // Fibonacci Levels 
    int     fibLevels_length    = not na(length) ? length : 1
    float   topFib_level        = ta.highest(fibLevels_length)
    float   bottomFib_level     = ta.lowest(fibLevels_length)
    float   fib_range           = topFib_level - bottomFib_level

	float   level_0618  		= na
	float   level_mid   		= na
	float   level_0382  		= na
	float   level_0236  		= na

	float 	level_e1618  		= na 
	float 	level_e1000			= na 
	float 	level_e0618  		= na
	float 	level_e0382  		= na
	float 	level_e0236			= na

    // Create Fib Levels
	if trend_direction == 'Long'

		// Extension levels 
		level_e1618  	:= close + (fib_range * 1.618) 
		level_e1000  	:= close + fib_range
		level_e0618  	:= close + (fib_range * 0.618) 
		level_e0382  	:= close + (fib_range * 0.382) 
		level_e0236		:= close + (fib_range * 0.236) 

		// Retracement levels 
		level_0236  := topFib_level - (fib_range * 0.236) 
		level_0382  := topFib_level - (fib_range * 0.382) 
		level_mid   := topFib_level - (fib_range * 0.5) 
		level_0618  := topFib_level - (fib_range * 0.618) 

	if trend_direction == 'Short'

		// Retracement levels 
		level_0618  := bottomFib_level + (fib_range * 0.618) 
		level_mid   := bottomFib_level + (fib_range * 0.5) 
		level_0382  := bottomFib_level + (fib_range * 0.382) 
		level_0236  := bottomFib_level + (fib_range * 0.236) 

		// Extension levels 
		level_e0236		:= close - (fib_range * 0.236) 
		level_e0382  	:= close - (fib_range * 0.382) 
		level_e0618  	:= close - (fib_range * 0.618) 
		level_e1000  	:= close - fib_range
		level_e1618  	:= close - (fib_range * 1.618) 

    // Create Fibonacci Levels Map
    levels_map = map.new<string,float>()

	// Add main levels 
    levels_map.put('top', topFib_level)
    levels_map.put('618', level_0618)
    levels_map.put('mid', level_mid)
    levels_map.put('382', level_0382)
    levels_map.put('236', level_0236)
    levels_map.put('bottom', bottomFib_level)

	// Add extensions
	if trend_direction == 'Long'

		if level_e0236 > topFib_level
			levels_map.put('e236', level_e0236)
		
		if level_e0382 > topFib_level 
			levels_map.put('e382', level_e0382)

		if level_e0618 > topFib_level 
			levels_map.put('e618', level_e0618)

		if level_e1000 > topFib_level 
			levels_map.put('e1000', level_e1000)

		if level_e1618 > topFib_level 
			levels_map.put('e1618', level_e1618)

	if trend_direction == 'Short'

		if level_e0236 < bottomFib_level
			levels_map.put('e236', level_e0236)
		
		if level_e0382 < bottomFib_level
			levels_map.put('e382', level_e0382)

		if level_e0618 < bottomFib_level
			levels_map.put('e618', level_e0618)

		if level_e1000 < bottomFib_level
			levels_map.put('e1000', level_e1000)

		if level_e1618 < bottomFib_level
			levels_map.put('e1618', level_e1618)

    levels_map

plot_fibonacci_levels(levels_map, length, plot_labels, bars_to_right, trend_direction, include_levels, delete_old_plots)=>

    // Plot Fib Levels
    if barstate.islast

		// Delete previous lines and labels
		if delete_old_plots

			for ln in line.all
				ln.delete()
			
			for lb in label.all 
				lb.delete()

        x1 = bar_index - length
        x2 = bar_index

		// Loop through all levels
        for key in levels_map.keys()

            y1 = levels_map.get(key)
            y2 = y1

			// Define format of lines
			key_level 				= key == 'mid' or key == 'top' or key == 'bottom'
            fib_level_color 		= key == 'mid' ? COLOR_MID_FIB : COLOR_FIB_LEVEL
			fib_level_line_width 	= key_level ? FIB_LEVEL_WIDTH + 1 : FIB_LEVEL_WIDTH
			fib_level_style 		= key_level ? line.style_solid : FIB_LEVEL_STYLE

			// Plot lines
            line.new(x1=x1, y1=y1, x2=x2, y2=y2,
					 xloc=xloc.bar_index,
					 color=fib_level_color, 
					 style=fib_level_style,
					 width=fib_level_line_width)

			// Plot labels
			if plot_labels

				// label_txt = 
				// 	 key == 'mid' ? 'Mid: 50' :
				// 	 (key == 'top' and trend_direction == 'Long') or (key == 'bottom' and trend_direction == 'Short')? 'Resistance: 0'	:
				// 	 (key == 'top' and trend_direction == 'Short') or (key == 'bottom' and trend_direction == 'Long')? 'Support: 1'	: key

				label_txt = 
					 key == 'mid' ? 'Mid: 50' :
					 key == 'top' ? 'Resistance: 0'	:
					 key == 'bottom' ? 'Support: 1'	: key

				if include_levels
					label_txt := label_txt + ': ' + fu.toCurrencyString(y2,1)

				label.new(x=x2 + bars_to_right,
						 y=y2,
						 text=label_txt,
						 xloc=xloc.bar_index,
					 	 color=COLOR_TRANSP,
					  	 size=FIB_LABEL_SIZE,
						 style=label.style_label_left,
						 textcolor=fib_level_color
						 )

get_direction_flag(fib_levels_map, trend_direction)=>

	// Variables

	string 	direction_flag 	= na
	bool	long_flag		= na 
	bool 	netural_flag	= na 
	bool	short_flag 		= na

	float 	level_0618		= fib_levels_map.get('618')
	float 	level_mid  		= fib_levels_map.get('mid')
	float 	level_0382		= fib_levels_map.get('382')
	float 	level_0236 		= fib_levels_map.get('236')

	// Get Direction Flag 

	if trend_direction == 'Long'

		direction_flag :=
		 close >= level_0236 ? 'Long' :
		 close < level_0236 and close >= level_0618 ? 'Neutral' :
		 close < level_0618 ? 'Short' : na

	if trend_direction == 'Short'

		direction_flag :=
		 close <= level_0236 ? 'Short' :
		 close > level_0236 and close <= level_0618 ? 'Neutral' :
		 close > level_0618 ? 'Long' : na

	direction_flag



get_fibonacci_DataTable(dataTable_map, direction_flag)=>

	// Variables 
	string data_1_txt 		= na 
	string data_3_txt 		= na
	string comment_1_txt 	= na 
	string comment_3_txt 	= na

	// Define color of data 
	color_txt = switch direction_flag
		'Long'		=> 'green'
		'Short'		=> 'red'
		'Neutral'	=> 'yellow'

	// Populate map
	dataTable_map.put('sub_title', '')

	dataTable_map.put('item_1', 'Direction')
	dataTable_map.put('data_1', direction_flag)
	dataTable_map.put('comment_1', '')
	dataTable_map.put('color_1', color_txt)

	dataTable_map


// EXPORTS
//-------------
// @function: 							Gets and plots a fibonacci grid.
// @param length (int): 				The direction flag that indicates where the trend is going.
// @param trend_direction (string): 	Direction of the trend (Long, Short or Neutral)
// @param plot_grid (bool): 			Plots the fibonacci grid.
// @param plot_labels (bool): 			Plots the labels of the grid
// @param bars_to_right (bool): 		Bars to the right of the levels.
// @param include_levels (bool): 		Includes de levels in the labels.
// @returns: 							Returns a map with the grid levels, a string with the direction of the grid and a map with the values for the dataTable. 
export get_fibonacciGrid_data(int length, string trend_direction, bool plot_grid, bool plot_labels, int bars_to_right, bool include_levels) =>

	// Define the dataTable map
	data_table_map = map.new<string, string>()

	// Generate levels
	fib_levels_map = get_fibonacci_levels(length, trend_direction)

	// Get direction flag
	direction_flag = get_direction_flag(fib_levels_map, trend_direction)

	// Build the data table 
	data_table_map := get_fibonacci_DataTable(data_table_map, direction_flag)

	// Plot Grid
	if plot_grid

		plot_fibonacci_levels(fib_levels_map, length, plot_labels, bars_to_right, trend_direction, include_levels, false)

	[fib_levels_map, direction_flag, data_table_map]


// CALCULATIONS
//============================

// Generate levels 
fib_levels_map = get_fibonacci_levels(length_input, trend_direction_input)

// Plot levels
if plot_fib_levels_input
	plot_fibonacci_levels(fib_levels_map, length_input, plot_labels_input, BARS_TO_RIGHT, trend_direction_input, include_levels_input, true)

// Get direction flag
direction_flag = get_direction_flag(fib_levels_map, trend_direction_input)

// Build the data table 
dataTable_map := get_fibonacci_DataTable(dataTable_map, direction_flag)

// Generate the table 
if plot_dataTable_input	
	du.generate_dataTable(dataTable_map, DATATABLE_TITLE, tableYposInput, tableXposInput, table_textSize_input)