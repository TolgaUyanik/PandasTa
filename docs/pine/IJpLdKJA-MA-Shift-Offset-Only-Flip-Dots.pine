//@version=6
indicator("MA Shift (Offset Only + Flip Dots)", "MA Trend Shift", overlay = true)

// --- Inputs (length=6, percent=10 defaults) ---
type_ma = input.string("SMA", "Type", options = ["SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA"])
len     = input.int(6, "Length")
src     = input.source(hl2, "Source")

mode    = input.string("Percent", "Offset Mode", options = ["Percent", "ATR"])
pct     = input.float(10.0, "Percent (%)", step = 0.1)
atrLen  = input.int(14, "ATR Length")
atrMult = input.float(1.0, "ATR ×", step = 0.1)
direction = input.string("Down", "Direction", options = ["Down", "Up"])

// Offset line glow toggle
showOffsetGlow = input.bool(true, "Show Offset Glow")

// Colors
col_up = input.color(#17a297, "Up Color")
col_dn = input.color(color.orange, "Down Color")

// --- Function ---
ma(src, length, maType) =>
    switch maType
        "SMA"        => ta.sma(src, length)
        "EMA"        => ta.ema(src, length)
        "SMMA (RMA)" => ta.rma(src, length)
        "WMA"        => ta.wma(src, length)
        "VWMA"       => ta.vwma(src, length)

// --- Base MA (internal only, not plotted) ---
baseMA   = ma(src, len, type_ma)
trendUp  = src >= baseMA
trendCol = trendUp ? col_up : col_dn

// --- Offset ---
percentOffset = baseMA * (pct / 100.0)
atrOffset     = ta.atr(atrLen) * atrMult
rawOffset     = mode == "Percent" ? percentOffset : atrOffset
signedOffset  = direction == "Down" ? -rawOffset : rawOffset
offsetMA      = baseMA + signedOffset

// --- Offset Plots Only ---
plot(showOffsetGlow ? offsetMA : na, "Offset Glow", color = color.new(trendCol, 80), linewidth = 7)
plot(offsetMA, "MA Offset", color = trendCol, linewidth = 2)

// --- Candles / Bars ---
barcolor(trendCol)
plotcandle(open, high, low, close, title="Custom Candle", color=trendCol, wickcolor=trendCol, bordercolor=trendCol)

// --- Trend Change Dots (based on baseMA flip) ---
trendFlip = ta.change(trendUp)
plotshape(trendFlip and trendUp,     title="Trend Up Flip",   style=shape.circle, location=location.belowbar, color=col_up, size=size.tiny)
plotshape(trendFlip and not trendUp, title="Trend Down Flip", style=shape.circle, location=location.abovebar, color=col_dn, size=size.tiny)

// (Optional Alerts - uncomment if needed)
// alertcondition(trendFlip and trendUp,     "Trend Up Flip",   "Trend flipped UP")
// alertcondition(trendFlip and not trendUp, "Trend Down Flip", "Trend flipped DOWN")
