// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//@version=6
indicator("Confluence Suite: PP SuperTrend + VWAP + MACD + RSI + ADX + Volume [HTF Bias]", shorttitle="Confluence Suite", overlay=true, max_labels_count=500)

// ============================================================================
// INPUTS
// ============================================================================
grp_st   = "Pivot Point SuperTrend (LonesomeTheBlue) — defaults tuned for NQ/MNQ 5min"
pp_period   = input.int(2, "Pivot Point Period", minval=1, group=grp_st)
atr_factor  = input.float(2.8, "ATR Factor", minval=0.1, step=0.1, group=grp_st, tooltip="NQ/MNQ tuning: 1-3min ~2.0-2.5, 5min ~2.5-3.0 (default), 15min ~3.0, 1H ~3.0-3.5")
atr_period  = input.int(10, "ATR Period", minval=1, group=grp_st, tooltip="NQ/MNQ tuning: 10 for 1-5min charts, 14 for 15min+ charts")
show_st     = input.bool(true, "Show SuperTrend Line", group=grp_st)
show_st_sig = input.bool(true, "Show Raw Flip Signals (triangles)", group=grp_st)

grp_vwap = "VWAP"
show_vwap = input.bool(true, "Show VWAP", group=grp_vwap)
vwap_src  = input.source(hlc3, "VWAP Source", group=grp_vwap)

grp_macd = "MACD"
macd_fast   = input.int(12, "Fast Length", group=grp_macd)
macd_slow   = input.int(26, "Slow Length", group=grp_macd)
macd_signal = input.int(9, "Signal Smoothing", group=grp_macd)
macd_src    = input.source(close, "Source", group=grp_macd)

grp_rsi = "RSI"
rsi_len = input.int(14, "RSI Length", group=grp_rsi)
rsi_ob  = input.int(70, "Overbought", group=grp_rsi)
rsi_os  = input.int(30, "Oversold", group=grp_rsi)

grp_adx = "ADX / DMI"
adx_len     = input.int(14, "DI Length", group=grp_adx)
adx_smooth  = input.int(14, "ADX Smoothing", group=grp_adx)
adx_thresh  = input.int(20, "Trend Strength Threshold", group=grp_adx)

grp_vol = "Volume"
vol_len       = input.int(20, "Volume MA Length", group=grp_vol)
vol_spike_mult = input.float(1.5, "Spike Multiplier", minval=1.0, step=0.1, group=grp_vol)

grp_htf = "HTF Bias Filter"
use_htf     = input.bool(true, "Enable HTF Bias Filter", group=grp_htf)
htf_tf      = input.timeframe("60", "Higher Timeframe", group=grp_htf, tooltip="NQ/MNQ tuning: use 15min HTF if trading a 1-3min chart, 60min HTF if trading a 5min chart, 4H if trading a 15min-1H chart")
htf_method  = input.string("EMA Trend", "HTF Bias Method", options=["EMA Trend", "ATR SuperTrend"], group=grp_htf)
htf_ema_len = input.int(50, "HTF EMA Length (EMA Trend method)", group=grp_htf)

grp_sig = "Confirmed Signal Filters"
require_htf_align = input.bool(true, "Require HTF Bias Alignment", group=grp_sig)
require_adx        = input.bool(false, "Require ADX Above Threshold", group=grp_sig)

grp_dash = "Dashboard"
show_dash = input.bool(true, "Show Dashboard", group=grp_dash)
dash_loc  = input.string("Top Right", "Location", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=grp_dash)
dash_size = input.string("Normal", "Text Size", options=["Small", "Normal", "Large"], group=grp_dash)

grp_cont = "Trend Continuation Signals"
enable_cont      = input.bool(true, "Enable Continuation Signals (multiple entries per trend)", group=grp_cont, tooltip="Fires extra entries while the SuperTrend stays in the same direction, instead of only at the initial flip.")
cont_trigger     = input.string("Any (EMA + RSI + MACD)", "Continuation Trigger", options=["EMA Pullback", "RSI Reset", "MACD Cross", "Any (EMA + RSI + MACD)"], group=grp_cont)
cont_ema_len     = input.int(21, "Continuation EMA Length", minval=1, group=grp_cont, tooltip="Pullback reference EMA. Price reclaiming this EMA in the trend direction triggers a continuation signal.")
cont_require_adx = input.bool(false, "Require ADX Trend Strength", group=grp_cont)
cont_require_htf = input.bool(false, "Require HTF Bias Alignment", group=grp_cont)
cont_cooldown    = input.int(2, "Min Bars Between Continuation Signals", minval=0, group=grp_cont, tooltip="Prevents signal clutter by spacing out repeated continuation entries. Set to 0 for a signal on every qualifying bar.")

// ============================================================================
// PIVOT POINT SUPERTREND
// ============================================================================
atr = ta.atr(atr_period)

ph = ta.pivothigh(high, pp_period, pp_period)
pl = ta.pivotlow(low, pp_period, pp_period)

var float centerLine = na
if not na(ph)
    centerLine := na(centerLine[1]) ? ph : (centerLine[1] * 2 + ph) / 3
if not na(pl)
    centerLine := na(centerLine[1]) ? pl : (centerLine[1] * 2 + pl) / 3

float upBand = centerLine - (atr_factor * atr)
float dnBand = centerLine + (atr_factor * atr)

var float Up    = na
var float Dn    = na
var int   Trend = 1

Up := close[1] > Up[1] ? math.max(upBand, Up[1]) : upBand
Dn := close[1] < Dn[1] ? math.min(dnBand, Dn[1]) : dnBand

Trend := close > Dn[1] ? 1 : close < Up[1] ? -1 : nz(Trend[1], 1)

float Tsl = Trend == 1 ? Up : Dn

stColor = Trend == 1 ? color.new(color.teal, 0) : color.new(color.red, 0)
plot(show_st ? Tsl : na, "PP SuperTrend", color=stColor, linewidth=2)

stBuySignal  = Trend == 1 and Trend[1] == -1
stSellSignal = Trend == -1 and Trend[1] == 1

plotshape(show_st and show_st_sig and stBuySignal, "ST Buy", shape.triangleup, location.belowbar, color=color.teal, size=size.tiny)
plotshape(show_st and show_st_sig and stSellSignal, "ST Sell", shape.triangledown, location.abovebar, color=color.red, size=size.tiny)

// ============================================================================
// VWAP
// ============================================================================
vwapVal = ta.vwap(vwap_src)
plot(show_vwap ? vwapVal : na, "VWAP", color=color.new(color.yellow, 0), linewidth=1)
vwapBias = close > vwapVal ? 1 : -1
// ============================================================================
// MACD
// ============================================================================
[macdLine, signalLine, histLine] = ta.macd(macd_src, macd_fast, macd_slow, macd_signal)
macdBias = macdLine > signalLine ? 1 : -1

// ============================================================================
// RSI
// ============================================================================
rsiVal   = ta.rsi(close, rsi_len)
rsiBias  = rsiVal > 50 ? 1 : -1
rsiState = rsiVal >= rsi_ob ? "OB" : rsiVal <= rsi_os ? "OS" : "Neutral"

// ============================================================================
// ADX / DMI
// ============================================================================
[diPlus, diMinus, adxVal] = ta.dmi(adx_len, adx_smooth)
adxTrending = adxVal > adx_thresh
adxBias     = diPlus > diMinus ? 1 : -1

// ============================================================================
// VOLUME
// ============================================================================
volMA    = ta.sma(volume, vol_len)
volSpike = volume > volMA * vol_spike_mult
volState = volSpike ? "Spike" : volume > volMA ? "Above Avg" : "Below Avg"

// ============================================================================
// HTF BIAS FILTER
// ============================================================================
htf_ema_bias() =>
    emaHTF = ta.ema(close, htf_ema_len)
    close > emaHTF ? 1 : -1

htf_st_bias() =>
    [_, dir] = ta.supertrend(atr_factor, atr_period)
    dir == -1 ? 1 : -1

htfBiasRaw = htf_method == "EMA Trend" ? request.security(syminfo.tickerid, htf_tf, htf_ema_bias()) : request.security(syminfo.tickerid, htf_tf, htf_st_bias())
htfBias = use_htf ? htfBiasRaw : 0
htfLabel = not use_htf ? "Off" : htfBias == 1 ? "Bullish" : "Bearish"

// ============================================================================
// CONFLUENCE SCORE
// ============================================================================
bullCount = (Trend == 1 ? 1 : 0) + (vwapBias == 1 ? 1 : 0) + (macdBias == 1 ? 1 : 0) + (rsiBias == 1 ? 1 : 0) + (adxBias == 1 ? 1 : 0) + (use_htf ? (htfBias == 1 ? 1 : 0) : 0)
totalFactors = 5 + (use_htf ? 1 : 0)
bearCount = totalFactors - bullCount

// ============================================================================
// CONFIRMED SIGNALS
// ============================================================================
htfOK = not require_htf_align or not use_htf or (stBuySignal and htfBias == 1) or (stSellSignal and htfBias == -1)
adxOK = not require_adx or adxTrending

confirmedLong  = stBuySignal  and (not require_htf_align or htfBias == 1)  and adxOK
confirmedShort = stSellSignal and (not require_htf_align or htfBias == -1) and adxOK

plotshape(confirmedLong, "Confirmed Long", shape.labelup, location.belowbar, color=color.new(color.teal, 0), text="LONG", textcolor=color.white, size=size.small)
plotshape(confirmedShort, "Confirmed Short", shape.labeldown, location.abovebar, color=color.new(color.red, 0), text="SHORT", textcolor=color.white, size=size.small)

alertcondition(confirmedLong, "Confirmed Long", "Confluence Suite: Confirmed LONG signal on {{ticker}} {{interval}}")
alertcondition(confirmedShort, "Confirmed Short", "Confluence Suite: Confirmed SHORT signal on {{ticker}} {{interval}}")
alertcondition(stBuySignal, "Raw ST Flip Long", "Confluence Suite: PP SuperTrend flipped bullish on {{ticker}} {{interval}}")
alertcondition(stSellSignal, "Raw ST Flip Short", "Confluence Suite: PP SuperTrend flipped bearish on {{ticker}} {{interval}}")

// ============================================================================
// TREND CONTINUATION SIGNALS (extra entries while the trend stays intact)
// ============================================================================
contEma = ta.ema(close, cont_ema_len)
plot(enable_cont ? contEma : na, "Continuation EMA", color=color.new(color.aqua, 60), linewidth=1)

emaPullbackLong  = Trend == 1  and ta.crossover(close, contEma)
emaPullbackShort = Trend == -1 and ta.crossunder(close, contEma)

rsiResetLong  = Trend == 1  and ta.crossover(rsiVal, 50)
rsiResetShort = Trend == -1 and ta.crossunder(rsiVal, 50)

macdContLong  = Trend == 1  and ta.crossover(macdLine, signalLine)
macdContShort = Trend == -1 and ta.crossunder(macdLine, signalLine)

contLongRaw  = cont_trigger == "EMA Pullback" ? emaPullbackLong  : cont_trigger == "RSI Reset" ? rsiResetLong  : cont_trigger == "MACD Cross" ? macdContLong  : (emaPullbackLong or rsiResetLong or macdContLong)
contShortRaw = cont_trigger == "EMA Pullback" ? emaPullbackShort : cont_trigger == "RSI Reset" ? rsiResetShort : cont_trigger == "MACD Cross" ? macdContShort : (emaPullbackShort or rsiResetShort or macdContShort)

contHtfOK = not cont_require_htf or not use_htf or (htfBias == 1 and Trend == 1) or (htfBias == -1 and Trend == -1)
contAdxOK = not cont_require_adx or adxTrending

var int lastContBarLong  = na
var int lastContBarShort = na

contLongCandidate  = enable_cont and contLongRaw  and not stBuySignal  and contAdxOK and contHtfOK
contShortCandidate = enable_cont and contShortRaw and not stSellSignal and contAdxOK and contHtfOK

contLongSignal  = contLongCandidate  and (na(lastContBarLong)  or (bar_index - lastContBarLong)  >= cont_cooldown)
contShortSignal = contShortCandidate and (na(lastContBarShort) or (bar_index - lastContBarShort) >= cont_cooldown)

if contLongSignal
    lastContBarLong := bar_index
if contShortSignal
    lastContBarShort := bar_index

plotshape(contLongSignal, "Continuation Long", shape.circle, location.belowbar, color=color.new(color.teal, 30), size=size.tiny)
plotshape(contShortSignal, "Continuation Short", shape.circle, location.abovebar, color=color.new(color.red, 30), size=size.tiny)

alertcondition(contLongSignal, "Continuation Long", "Confluence Suite: Trend continuation LONG entry on {{ticker}} {{interval}}")
alertcondition(contShortSignal, "Continuation Short", "Confluence Suite: Trend continuation SHORT entry on {{ticker}} {{interval}}")

// ============================================================================
// DASHBOARD
// ============================================================================
tablePos = dash_loc == "Top Right" ? position.top_right : dash_loc == "Top Left" ? position.top_left : dash_loc == "Bottom Right" ? position.bottom_right : position.bottom_left
txtSize  = dash_size == "Small" ? size.small : dash_size == "Large" ? size.large : size.normal

var table dash = table.new(tablePos, 2, 9, border_width=1, border_color=color.new(color.gray, 50), frame_width=1, frame_color=color.new(color.gray, 50))

biasColor(b) => b == 1 ? color.new(color.teal, 0) : b == -1 ? color.new(color.red, 0) : color.new(color.gray, 0)
biasText(b)  => b == 1 ? "Bullish" : b == -1 ? "Bearish" : "N/A"

if show_dash and barstate.islast
    table.cell(dash, 0, 0, "Confluence Dashboard", bgcolor=color.new(color.navy, 0), text_color=color.white, text_size=txtSize)
    table.cell(dash, 1, 0, str.tostring(bullCount) + "B / " + str.tostring(bearCount) + "S", bgcolor=color.new(color.navy, 0), text_color=color.white, text_size=txtSize)

    table.cell(dash, 0, 1, "PP SuperTrend", text_size=txtSize, text_halign=text.align_left)
    table.cell(dash, 1, 1, biasText(Trend), bgcolor=biasColor(Trend), text_color=color.white, text_size=txtSize)

    table.cell(dash, 0, 2, "VWAP", text_size=txtSize, text_halign=text.align_left)
    table.cell(dash, 1, 2, (vwapBias == 1 ? "Above" : "Below"), bgcolor=biasColor(vwapBias), text_color=color.white, text_size=txtSize)

    table.cell(dash, 0, 3, "MACD", text_size=txtSize, text_halign=text.align_left)
    table.cell(dash, 1, 3, biasText(macdBias), bgcolor=biasColor(macdBias), text_color=color.white, text_size=txtSize)

    table.cell(dash, 0, 4, "RSI (" + str.tostring(math.round(rsiVal)) + ")", text_size=txtSize, text_halign=text.align_left)
    table.cell(dash, 1, 4, rsiState, bgcolor=biasColor(rsiBias), text_color=color.white, text_size=txtSize)

    table.cell(dash, 0, 5, "ADX (" + str.tostring(math.round(adxVal)) + ")", text_size=txtSize, text_halign=text.align_left)
    table.cell(dash, 1, 5, (adxTrending ? "Trending" : "Weak") + " " + (adxBias == 1 ? "+DI" : "-DI"), bgcolor=biasColor(adxBias), text_color=color.white, text_size=txtSize)

    table.cell(dash, 0, 6, "Volume", text_size=txtSize, text_halign=text.align_left)
    table.cell(dash, 1, 6, volState, bgcolor=(volSpike ? color.new(color.orange, 0) : color.new(color.gray, 30)), text_color=color.white, text_size=txtSize)

    table.cell(dash, 0, 7, "HTF Bias (" + htf_tf + ")", text_size=txtSize, text_halign=text.align_left)
    table.cell(dash, 1, 7, htfLabel, bgcolor=(use_htf ? biasColor(htfBias) : color.new(color.gray, 30)), text_color=color.white, text_size=txtSize)

    contModeLabel = not enable_cont ? "Off" : (contAdxOK and contHtfOK) ? "Active" : "Waiting"
    contModeColor = not enable_cont ? color.new(color.gray, 30) : contModeLabel == "Active" ? biasColor(Trend) : color.new(color.orange, 0)
    table.cell(dash, 0, 8, "Continuation", text_size=txtSize, text_halign=text.align_left)
    table.cell(dash, 1, 8, contModeLabel, bgcolor=contModeColor, text_color=color.white, text_size=txtSize)

// ============================================================================
// OPTIONAL VISUAL AIDS
// ============================================================================
bgcolor(confirmedLong ? color.new(color.teal, 90) : confirmedShort ? color.new(color.red, 90) : na)
