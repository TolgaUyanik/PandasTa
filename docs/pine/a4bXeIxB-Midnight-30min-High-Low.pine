//@version=6
indicator("Midnight 30min High/Low", shorttitle="Mid30 H/L", overlay=true)

// Input settings
extend_days = input.int(5, "Extend Days", minval=1, maxval=30)
high_color = input.color(color.blue, "High Line Color")
low_color = input.color(color.orange, "Low Line Color")
fill_color = input.color(color.new(color.aqua, 80), "Fill Color")
show_labels = input.bool(true, "Show Session Markers")

// Variables
var float session_high = na
var float session_low = na
var int start_bar = na
var bool session_active = false

// EST timezone offset (EST is UTC-5, but we need to account for current timezone)
// Note: This assumes the chart is in EST. Adjust if needed.
current_hour = hour(time, "America/New_York")
current_minute = minute(time, "America/New_York")

// Check if we're in the 12:00-12:30 AM EST window
in_session = current_hour == 0 and current_minute >= 0 and current_minute < 30

// Check for new day
new_day = ta.change(time("1D")) != 0

// New day logic - draw previous session's lines
if new_day
    if not na(session_high) and not na(session_low) and not na(start_bar)
        // Calculate extension end point based on user input
        extension_bars = extend_days * 24 // Approximate bars per day (depends on timeframe)
        end_bar = bar_index + extension_bars
        
        // Create lines
        high_line = line.new(start_bar, session_high, end_bar, session_high, color=high_color, width=2)
        low_line = line.new(start_bar, session_low, end_bar, session_low, color=low_color, width=2)
        
        // Create fill
        linefill.new(high_line, low_line, fill_color)
    
    // Reset values
    session_high := na
    session_low := na
    start_bar := na
    session_active := false

// Start of 12:00 AM EST session
if in_session and not session_active
    start_bar := bar_index
    session_high := high
    session_low := low
    session_active := true

// Update high/low only during the 30-minute session
if in_session and session_active
    session_high := math.max(session_high, high)
    session_low := math.min(session_low, low)

// End of session (12:30 AM EST)
if not in_session and session_active
    session_active := false

// Show session start marker
if show_labels and in_session and not session_active[1]
    label.new(bar_index, low, "●", style=label.style_none, color=color.yellow, textcolor=color.yellow, size=size.tiny)

// Plots for data window
plot(session_high, "Session High", color=color.new(color.white, 100), display=display.data_window)
plot(session_low, "Session Low", color=color.new(color.white, 100), display=display.data_window)

