//@version=6
library("TA")

// "TA" Library
// Implements digital signal processing algorithms and adaptive filtering methods
// for professional technical analysis applications. All algorithms are based on
// established academic research and optimized for performance and accuracy.

// This library exports the following advanced technical analysis functions:

// • ma():                     Universal Moving Average (supports multiple types including standard and advanced)
// • ewma():                   Exponentially Weighted Moving Average with dynamic alpha
// • dema():                   Double Exponential Moving Average
// • tema():                   Triple Exponential Moving Average
// • zlema():                  Zero-Lag Exponential Moving Average
// • tma():                    Triangular Moving Average
// • frama():                  Fractal Adaptive Moving Average
// • kama():                   Kaufman's Adaptive Moving Average
// • t3():                     Tilson Moving Average (T3)
// • ultimateSmoother():       Ultimate Smoother (Advanced Digital Filter)
// • kalmanFilter():           Kalman Filter (Optimal State Estimation)
// • mcginleyDynamic():        McGinley Dynamic
// • mama():                   Mesa Adaptive Moving Average
// • fama():                   Following Adaptive Moving Average
// • mamaFama():               Mesa Adaptive Moving Average & Following Adaptive Moving Average
// • laguerreFilter():         Laguerre Filter (N-order with uniform weighting)
// • laguerreBinomialFilter(): Laguerre Binomial Filter (6-pole with binomial weighting)
// • superSmoother():          Super Smoother (Butterworth Filter)
// • rangeFilter():            Range Filter (Dynamic Noise Reduction)
// • qqe():                    Quantitative Qualitative Estimation (Enhanced RSI)
// • sslChannel():             Semaphore Signal Level (SSL) Channel
// • atr():                    Average True Range (supports different MA types)
// • macd():                   MACD (supports different MA types for main and signal lines)
// • dmao():                   Dual Moving Average Oscillator (PPO algorithm for any data series including TR, VOL)
// • continuationIndex():      Continuation Index (Inverse Fisher Transform of normalized difference)
// • stochastic():             Stochastic Oscillator (%K and %D lines for momentum and overbought/oversold signals)
// • rsi():                    Relative Strength Index (with customizable moving average type for smoothing)
// • bb():                     Bollinger Bands (volatility bands with customizable moving average type)
// • kc():                     Keltner Channel (EMA-based channel with ATR bands)
// • dc():                     Donchian Channel (price breakout channel based on highest/lowest values)


// Mathematical constants for optimized performance
const float SQRT_2 = math.sqrt(2)
const float PI = math.pi
const float PHI = (1 + math.sqrt(5)) / 2
const float PHI_SQUARED = PHI * PHI
const float PHI_CUBED = PHI * PHI * PHI

// Moving Average Type enumeration for unified interface
export enum MaType
    SMA
    EMA
    RMA
    WMA
    HMA
    VWMA
    ALMA
    LSMA
    DEMA
    TEMA
    ZLEMA
    T3
    FRAMA
    KAMA
    ULTIMATE_SMOOTHER
    MCGINLEY_DYNAMIC
    LAGUERRE_FILTER
    LAGUERRE_BINOMIAL_FILTER
    SUPER_SMOOTHER
    KALMAN_FILTER
    TMA

// @function                Calculates the Exponentially Weighted Moving Average with dynamic alpha parameter.
// @param source            (series int/float) Series of values to process.
// @param alpha             (series int/float) The smoothing parameter of the filter.
// @returns                 (float) The exponentially weighted moving average value.
export ewma(series float source, series float alpha) =>
    float result = na
    result := alpha * source + (1.0 - alpha) * nz(result[1], source)


// @function                Calculates the Double Exponential Moving Average (DEMA) of a given data series.
// @param source            (series int/float) Series of values to process.
// @param length            (simple int) Number of bars for the moving average calculation.
// @returns                 (float) The calculated Double Exponential Moving Average value.
export dema(series float source, simple int length) =>
    float ema1   = ta.ema(source, length)
    float ema2   = ta.ema(ema1, length)
    2 * ema1 - ema2


// @function                Calculates the Triple Exponential Moving Average (TEMA) of a given data series.
// @param source            (series int/float) Series of values to process.
// @param length            (simple int) Number of bars for the moving average calculation.
// @returns                 (float) The calculated Triple Exponential Moving Average value.
export tema(series float source, simple int length) =>
    float ema1   = ta.ema(source, length)
    float ema2   = ta.ema(ema1, length)
    float ema3   = ta.ema(ema2, length)
    3 * (ema1 - ema2) + ema3


// @function                Calculates the Zero-Lag Exponential Moving Average (ZLEMA) of a given data series.
//                          This indicator attempts to eliminate the lag inherent in all moving averages.
// @param source            (series int/float) Series of values to process.
// @param length            (simple int) Number of bars for the moving average calculation.
// @returns                 (float) The calculated Zero-Lag Exponential Moving Average value.
export zlema(series float source, simple int length) =>
    int lag    = math.round((length - 1) / 2)
    float ma   = source + (source - source[lag])
    ta.ema(ma, length)

// @function                Calculates the Triangular Moving Average (TMA) of a given data series.
//                          TMA is a double-smoothed simple moving average that reduces noise.
// @param source            (series int/float) Series of values to process.
// @param length            (simple int) Number of bars for the moving average calculation.
// @returns                 (float) The calculated Triangular Moving Average value.
export tma(series float source, simple int length) =>
    int n1 = math.ceil(length / 2.0)
    int n2 = math.floor(length / 2.0) + 1
    ta.sma(ta.sma(source, n1), n2)


// @function                Calculates the Fractal Adaptive Moving Average (FRAMA) of a given data series.
//                          FRAMA adapts its smoothing factor based on fractal geometry to reduce lag.
//                          Developed by John Ehlers, published in Stocks & Commodities Magazine Vol. 23:10 (October 2005).
//                          Reference: https://www.mesasoftware.com/papers/FRAMA.pdf
// @param source            (series int/float) Series of values to process.
// @param length            (simple int) Number of bars for the moving average calculation.
// @returns                 (float) The calculated Fractal Adaptive Moving Average value.
export frama(series float source, simple int length) =>
    var int halfLen      = math.round(length / 2)
    float highHalf       = ta.highest(halfLen)
    float lowHalf        = ta.lowest(halfLen)
    float highFull       = ta.highest(length)
    float lowFull        = ta.lowest(length)
    float rangeRecent    = (highHalf - lowHalf) / halfLen
    float rangePrior     = (highHalf[halfLen] - lowHalf[halfLen]) / halfLen
    float rangeFull      = (highFull - lowFull) / length
    float dimension      = math.log((rangeRecent + rangePrior) / rangeFull) / math.log(2)
    float alpha          = math.exp(-4.6 * (dimension - 1))
    ewma(source, alpha)


// @function                Calculates Kaufman's Adaptive Moving Average (KAMA) of a given data series.
//                          KAMA adjusts its smoothing based on market efficiency ratio.
//                          Developed by Perry J. Kaufman in "Smarter Trading" (1995).
// @param source            (series int/float) Series of values to process.
// @param length            (simple int) Number of bars for the efficiency calculation.
// @param fastLength        (simple int) Fast EMA length for smoothing calculation. Optional. Default is 2.
// @param slowLength        (simple int) Slow EMA length for smoothing calculation. Optional. Default is 30.
// @returns                 (float) The calculated Kaufman's Adaptive Moving Average value.
export kama(series float source, simple int length, simple int fastLength = 2, simple int slowLength = 30) =>
    var float fastAlpha  = 2 / (fastLength + 1)
    var float slowAlpha  = 2 / (slowLength + 1)
    float netChange      = math.abs(ta.change(source, length))
    float totalMovement  = math.sum(math.abs(ta.change(source)), length)
    float efficiency     = totalMovement != 0 ? netChange / totalMovement : 0
    float smoothing      = math.pow(efficiency * (fastAlpha - slowAlpha) + slowAlpha, 2)
    float kama           = na
    sma = ta.sma(source, length)
    kama := na(kama[1]) ? sma : kama[1] + smoothing * (source - kama[1])


// @function                Calculates the Generalized DEMA (GD) used in T3 calculation.
//                          This is a helper function for the Tilson Moving Average.
// @param source            (series int/float) Series of values to process.
// @param length            (simple int) Length for the smoothing parameter calculation.
// @param volumeFactor      (simple float) Volume factor affecting responsiveness.
// @returns                 (float) The Generalized DEMA value.
gd(series float source, simple int length, simple float volumeFactor) =>
    float ema1   = ta.ema(source, length)
    float ema2   = ta.ema(ema1, length)
    ema1 * (1 + volumeFactor) - ema2 * volumeFactor


// @function                Calculates the Tilson Moving Average (T3) of a given data series.
//                          T3 is a triple-smoothed exponential moving average with improved lag characteristics.
//                          Developed by Tim Tillson, published in "Better Moving Averages",
//                          Technical Analysis of Stocks & Commodities Magazine (January 1998).
// @param source            (series int/float) Series of values to process.
// @param length            (simple int) Number of bars for the moving average calculation.
// @param volumeFactor      (simple float) Volume factor affecting responsiveness. Optional. Default is 0.7.
// @returns                 (float) The calculated Tilson Moving Average value.
export t3(series float source, simple int length, simple float volumeFactor = 0.7) =>
    gd(gd(gd(source, length, volumeFactor), length, volumeFactor), length, volumeFactor)


// @function                Calculates the Ultimate Smoother of a given data series.
//                          Uses advanced filtering techniques to reduce noise while maintaining responsiveness.
//                          Based on digital signal processing principles by John Ehlers.
//                          Reference: "TASC 2024.04 The Ultimate Smoother".
// @param source            (series int/float) Series of values to process.
// @param length            (simple int) Number of bars for the smoothing calculation.
// @returns                 (float) The calculated Ultimate Smoother value.
export ultimateSmoother(series float source, simple int length) =>
    // Pre-calculate coefficients only once (performance optimization)
    var float alpha1 = math.exp(-SQRT_2 * PI / length)
    var float coeff2 = 2.0 * alpha1 * math.cos(SQRT_2 * PI / length)
    var float coeff3 = -alpha1 * alpha1
    var float coeff1 = (1.0 + coeff2 - coeff3) / 4.0
    
    float result = na
    result := bar_index >= 4 ?
              (1.0 - coeff1) * source +
              (2.0 * coeff1 - coeff2) * source[1] -
              (coeff1 + coeff3) * source[2] +
              coeff2 * nz(result[1]) + coeff3 * nz(result[2]) : source


// @function                Calculates the Kalman Filter of a given data series.
//                          Optimal estimation algorithm that estimates true value from noisy observations.
//                          Based on the Kalman Filter algorithm developed by Rudolf Kalman (1960).
//                          Widely used in control systems and signal processing applications.
// @param source            (series int/float) Series of values to process.
// @param processNoise      (simple float) Process noise variance (Q). Controls adaptation speed. Optional. Default is 0.05.
// @param measurementNoise  (simple float) Measurement noise variance (R). Controls smoothing. Optional. Default is 1.0.
// @returns                 (float) The calculated Kalman Filter value.
export kalmanFilter(series float source, simple float processNoise = 0.05, simple float measurementNoise = 1.0) =>
    var float stateEstimate     = na
    var float errorCovariance   = na
    var bool initialized        = false

    if not initialized
        stateEstimate := source
        errorCovariance := measurementNoise
        initialized := true
        source
    else
        // Step 1: Prediction phase
        float predictedState = nz(stateEstimate[1])
        float predictedCovariance = nz(errorCovariance[1]) + processNoise

        // Step 2: Update phase - Calculate Kalman Gain
        float innovation = source - predictedState
        float innovationCovariance = predictedCovariance + measurementNoise
        float kalmanGain = predictedCovariance / innovationCovariance

        // Step 3: State update
        stateEstimate := predictedState + kalmanGain * innovation

        // Step 4: Covariance update
        errorCovariance := (1 - kalmanGain) * predictedCovariance

        stateEstimate


// @function                Calculates the McGinley Dynamic of a given data series.
//                          McGinley Dynamic is an adaptive moving average that adjusts to market speed changes.
//                          Developed by John R. McGinley Jr., published in Journal of Technical Analysis (1997).
//                          Reference: https://www.mesasoftware.com/papers/McGinleyDynamic.pdf
// @param source            (series int/float) Series of values to process.
// @param length            (simple int) Number of bars for the dynamic calculation.
// @returns                 (float) The calculated McGinley Dynamic value.
export mcginleyDynamic(series float source, simple int length) =>
    float mg = na
    float ema = ta.ema(source, length)
    float factor = length * math.pow(source / mg[1], 4)
    mg := na(mg[1]) ? ema : mg[1] + (source - mg[1]) / factor


// @function                Internal helper function for truncated Hilbert Transform calculation used in MAMA.
// @param source            (series float) Data series to transform.
// @returns                 (float) Truncated Hilbert transform result.
mamaHilbertTransform(series float source) =>
    0.0962 * source + 0.5769 * nz(source[2]) - 0.5769 * nz(source[4]) - 0.0962 * nz(source[6])


// @function                Internal helper function to compute MESA component with period multiplier.
// @param source            (series float) Source data.
// @param mesaPeriodMult    (series float) MESA period multiplier.
// @returns                 (float) Computed MESA component.
mamaMesaComponent(series float source, series float mesaPeriodMult) =>
    mamaHilbertTransform(source) * mesaPeriodMult


// @function                Internal helper function for exponential smoothing used in MAMA algorithm.
// @param source            (series float) Source data to smooth.
// @returns                 (float) Exponentially smoothed value with 0.2/0.8 weighting.
mamaSmooth(series float source) =>
    0.2 * source + 0.8 * nz(source[1])


// @function                Internal helper function to compute adaptive alpha for MAMA.
// @param source            (series float) Source data.
// @param fastLimit         (simple float) Fast limit.
// @param slowLimit         (simple float) Slow limit.
// @returns                 (float) Computed alpha value.
computeAlpha(series float source, simple float fastLimit, simple float slowLimit) =>
    var float mesaPeriod = 0.0
    mesaPeriodMult = 0.075 * nz(mesaPeriod[1]) + 0.54

    smooth = (4 * source + 3 * nz(source[1]) + 2 * nz(source[2]) + nz(source[3])) / 10
    detrender = mamaMesaComponent(smooth, mesaPeriodMult)

    // Compute InPhase and Quadrature components
    inPhase1 = nz(detrender[3])
    quad1 = mamaMesaComponent(detrender, mesaPeriodMult)

    // Advance the phase of I1 and Q1 by 90 degrees
    jitterI = mamaMesaComponent(inPhase1, mesaPeriodMult)
    jitterQ = mamaMesaComponent(quad1, mesaPeriodMult)

    // Phasor addition for 3 bar averaging
    inPhase2 = inPhase1 - jitterQ
    quad2 = quad1 + jitterI

    // Smooth the I and Q components before applying the discriminator
    smoothedI2 = mamaSmooth(inPhase2)
    smoothedQ2 = mamaSmooth(quad2)

    // Homodyne Discriminator
    realPart = smoothedI2 * nz(smoothedI2[1], smoothedI2) + smoothedQ2 * nz(smoothedQ2[1], smoothedQ2)
    imagPart = smoothedI2 * nz(smoothedQ2[1], smoothedQ2) - smoothedQ2 * nz(smoothedI2[1], smoothedI2)

    smoothedRe = mamaSmooth(realPart)
    smoothedIm = mamaSmooth(imagPart)

    if smoothedRe != 0 and smoothedIm != 0
        mesaPeriod := 2 * PI / math.atan(smoothedIm / smoothedRe)

    mesaPeriod := math.min(mesaPeriod, 1.5 * nz(mesaPeriod[1], mesaPeriod))
    mesaPeriod := math.max(mesaPeriod, 0.67 * nz(mesaPeriod[1], mesaPeriod))
    mesaPeriod := math.min(math.max(mesaPeriod, 6), 50)
    mesaPeriod := mamaSmooth(mesaPeriod)

    var float phase = 0.0
    if inPhase1 != 0
        phase := 180 / PI * math.atan(quad1 / inPhase1)

    deltaPhase = nz(phase[1], phase) - phase
    deltaPhase := math.max(deltaPhase, 1)

    math.max(fastLimit / deltaPhase, slowLimit)


// @function                Calculates Mesa Adaptive Moving Average (MAMA) and Following Adaptive Moving Average (FAMA).
//                          MAMA/FAMA use Hilbert Transform Discriminator to adapt to market cycles dynamically.
//                          Developed by John F. Ehlers, published in "Rocket Science for Traders" (2001).
//                          Reference: https://www.mesasoftware.com/papers/MAMA.pdf
// @param source            (series float) Series of values to process.
// @param fastLimit         (simple float) Maximum alpha (responsiveness). Optional. Default is 0.5.
// @param slowLimit         (simple float) Minimum alpha (smoothing). Optional. Default is 0.05.
// @returns                 ([float, float]) Tuple containing [MAMA, FAMA] values.
export mamaFama(series float source, simple float fastLimit = 0.5, simple float slowLimit = 0.05) =>
    alpha = computeAlpha(source, fastLimit, slowLimit)

    float mamaValue = 0.0
    float famaValue = 0.0

    mamaValue := alpha * source + (1 - alpha) * nz(mamaValue[1], source[1])
    alpha2 = alpha / 2
    famaValue := alpha2 * mamaValue + (1 - alpha2) * nz(famaValue[1], source[1])

    if bar_index < 33
        [na, na]
    else
        [mamaValue, famaValue]


// @function                Calculates the Mesa Adaptive Moving Average (MAMA) of a given data series.
//                          MAMA uses Hilbert Transform Discriminator to adapt to market cycles dynamically.
//                          Developed by John F. Ehlers, published in "Rocket Science for Traders" (2001).
//                          Reference: https://www.mesasoftware.com/papers/MAMA.pdf
// @param source            (series int/float) Series of values to process.
// @param fastLimit         (simple float) Maximum alpha (responsiveness). Optional. Default is 0.5.
// @param slowLimit         (simple float) Minimum alpha (smoothing). Optional. Default is 0.05.
// @returns                 (float) The calculated Mesa Adaptive Moving Average value.
export mama(series float source, simple float fastLimit = 0.5, simple float slowLimit = 0.05) =>
    [mamaValue, _] = mamaFama(source, fastLimit, slowLimit)
    mamaValue


// @function                Calculates the Following Adaptive Moving Average (FAMA) of a given data series.
//                          FAMA follows MAMA with reduced responsiveness for crossover signals.
//                          Developed by John F. Ehlers, published in "Rocket Science for Traders" (2001).
//                          Reference: https://www.mesasoftware.com/papers/MAMA.pdf
// @param source            (series int/float) Series of values to process.
// @param fastLimit         (simple float) Maximum alpha (responsiveness). Optional. Default is 0.5.
// @param slowLimit         (simple float) Minimum alpha (smoothing). Optional. Default is 0.05.
// @returns                 (float) The calculated Following Adaptive Moving Average value.
export fama(series float source, simple float fastLimit = 0.5, simple float slowLimit = 0.05) =>
    [_, famaValue] = mamaFama(source, fastLimit, slowLimit)
    famaValue


// @function                Calculates the standard N-order Laguerre Filter of a given data series.
//                          Standard Laguerre Filter uses uniform weighting across all polynomial terms.
//                          Based on mathematical Laguerre polynomials with UltimateSmoother preprocessing.
//                          Developed by John F. Ehlers, supports variable order for flexible lag control.
// @param source            (series int/float) Series of values to process.
// @param length            (simple int) Length for UltimateSmoother preprocessing.
// @param gamma             (simple float) Feedback coefficient (0-1). Lower values reduce lag. Optional. Default is 0.8.
// @param order             (simple int) The order of the Laguerre filter (1-10). Higher order increases lag. Optional. Default is 8.
// @returns                 (float) The calculated standard Laguerre Filter value.
export laguerreFilter(series float source, simple int length, simple float gamma = 0.8, simple int order = 8) =>
    var matrix<float> lg = matrix.new<float>(order, 2, 0.0)
    lg.set(0, 1, lg.get(0, 0))
    lg.set(0, 0, ultimateSmoother(source, length))
    float fir = lg.get(0, 0)
    if order > 1
        for i = 1 to order - 1
            lg.set(i, 1, lg.get(i, 0))
            lg.set(i, 0, gamma * (lg.get(i, 1) - lg.get(i - 1, 1)) + lg.get(i - 1, 1))
            fir += lg.get(i, 0)
    fir / order


// @function                Calculates the Laguerre Binomial Filter of a given data series.
//                          Laguerre Binomial Filter uses 6-pole feedback with binomial weighting coefficients.
//                          Uses Pascal's triangle weights for enhanced smoothness characteristics.
//                          Developed by John F. Ehlers, published in "TASC 2025.07".
//                          Reference: https://traders.com/Documentation/FEEDbk_docs/2024/04/TradersTips.html
// @param source            (series int/float) Series of values to process.
// @param length            (simple int) Length for UltimateSmoother preprocessing.
// @param gamma             (simple float) Feedback coefficient (0-1). Lower values reduce lag. Optional. Default is 0.5.
// @returns                 (float) The calculated Laguerre Binomial Filter value.
export laguerreBinomialFilter(series float source, simple int length, simple float gamma = 0.5) =>
    // Step 1: UltimateSmoother preprocessing for L0
    float l0 = ultimateSmoother(source, length)

    // Step 2: Calculate Laguerre polynomial terms
    float l1 = 0.0
    float l2 = 0.0
    float l3 = 0.0
    float l4 = 0.0
    float l5 = 0.0

    var float g1 = 1.0 - gamma

    // Laguerre recursive calculations based on John Ehlers' formula
    l1 := g1 * nz(l0[1], source) + gamma * nz(l1[1], source)
    l2 := g1 * nz(l1[1], source) + gamma * nz(l2[1], source)
    l3 := g1 * nz(l2[1], source) + gamma * nz(l3[1], source)
    l4 := g1 * nz(l3[1], source) + gamma * nz(l4[1], source)
    l5 := g1 * nz(l4[1], source) + gamma * nz(l5[1], source)

    // Step 3: Calculate binomial weighted output
    // LF = (L0 + 4×L1 + 6×L2 + 4×L3 + L5) / 16
    (l0 + 4.0 * l1 + 6.0 * l2 + 4.0 * l3 + l5) / 16.0


// @function                Calculates the Super Smoother of a given data series.
//                          SuperSmoother is a second-order Butterworth filter from aerospace technology.
//                          Developed by John F. Ehlers, based on analog filter design principles.
//                          Reference: "Cybernetic Analysis for Stocks and Futures" (2004).
// @param source            (series int/float) Series of values to process.
// @param length            (simple int) Period for the filter calculation.
// @returns                 (float) The calculated Super Smoother value.
export superSmoother(series float source, simple int length) =>
    // Pre-calculate coefficients only once (performance optimization)
    var float a1 = math.exp(-SQRT_2 * PI / length)
    var float b1 = 2.0 * a1 * math.cos(SQRT_2 * PI / length)
    var float c2 = b1
    var float c3 = -a1 * a1
    var float c1 = 1.0 - c2 - c3

    var float prevPrice = na
    var float result = na
    var float prevResult = na

    if bar_index < 3
        // Not enough data points
        prevPrice := source
        result := source
        prevResult := source
        source
    else
        // Calculate price average
        float priceAvg = (source + nz(prevPrice)) / 2.0

        // Apply SuperSmoother formula: SS[i] = c1 * priceAvg + c2 * SS[i-1] + c3 * SS[i-2]
        float ssValue = c1 * priceAvg + c2 * nz(result[1]) + c3 * nz(prevResult)

        // Update state variables
        prevResult := nz(result[1])
        prevPrice := source
        result := ssValue

        ssValue


// @function                Calculates the Range Filter of a given data series.
//                          Range Filter reduces noise by filtering price movements within a dynamic range.
//                          Based on a smooth range calculation using exponential moving averages.
//                          Reference: https://www.tradingview.com/script/lut7sBgG-Range-Filter-DW/
// @param source            (series int/float) Series of values to process.
// @param length            (simple int) Number of bars for the average range calculation.
// @param multiplier        (simple float) Multiplier for the smooth range. Higher values increase filtering. Optional. Default is 2.618.
// @returns                 ([float, int, float, float]) Tuple containing filtered value, trend direction, upper band, and lower band.
export rangeFilter(series float source, simple int length, simple float multiplier = 2.618) =>
    var int   weightedPeriod = (length * 2) - 1
    float     priceChange    = math.abs(source - source[1])
    float     averageRange   = ta.ema(priceChange, length)
    float     smoothRange    = ta.ema(averageRange, weightedPeriod) * multiplier

    var float filterValue    = na
    var int   trendDirection = 1

    float prevFilterValue = nz(filterValue[1], source)

    // Standard Range Filter gating logic
    filterValue := source > prevFilterValue ?
                   (source - smoothRange < prevFilterValue ? prevFilterValue : source - smoothRange) :
                   source < prevFilterValue ?
                   (source + smoothRange > prevFilterValue ? prevFilterValue : source + smoothRange) :
                   prevFilterValue

    // Determine trend direction
    trendDirection := filterValue > prevFilterValue ? 1 : filterValue < prevFilterValue ? -1 : nz(trendDirection[1], 1)

    // Calculate upper and lower bands
    float upperBand = filterValue + smoothRange
    float lowerBand = filterValue - smoothRange

    [filterValue, trendDirection, upperBand, lowerBand]


// @function                Calculates the Quantitative Qualitative Estimation (QQE) of a given data series.
//                          QQE is an improved RSI that reduces noise and provides smoother signals.
//                          Developed by Igor Livshin, it combines RSI with Wilder's smoothing and ATR-based bands.
//                          Reference: https://www.tradingview.com/script/IYfA9R2k-QQE-Quantitative-Qualitative-Estimation/
// @param source            (series int/float) Series of values to process.
// @param rsiLength         (simple int) Number of bars for the RSI calculation. Optional. Default is 14.
// @param rsiSmooth         (simple int) Number of bars for smoothing the RSI. Optional. Default is 5.
// @param qqeFactor         (simple float) QQE factor for volatility band width. Optional. Default is 4.236.
// @returns                 ([float, float]) Tuple containing smoothed RSI and QQE trend line.
export qqe(series float source, simple int rsiLength = 14, simple int rsiSmooth = 5, simple float qqeFactor = 4.236) =>
    var int wildersPeriod = rsiLength * 2 - 1
    float rsi             = ta.rsi(source, rsiLength)
    float rsiSmoothed     = ta.ema(rsi, rsiSmooth)
    float rsiChange       = math.abs(rsiSmoothed[1] - rsiSmoothed)
    float avgRsiChange    = ta.ema(rsiChange, wildersPeriod)
    float volatilityBand  = ta.ema(avgRsiChange, wildersPeriod) * qqeFactor

    var float lowerBand      = na
    var float upperBand      = na
    var int   trendDirection = 1

    float newUpperBand = rsiSmoothed + volatilityBand
    float newLowerBand = rsiSmoothed - volatilityBand

    lowerBand := rsiSmoothed[1] > nz(lowerBand[1]) and rsiSmoothed > nz(lowerBand[1]) ?
                 math.max(nz(lowerBand[1]), newLowerBand) : newLowerBand
    upperBand := rsiSmoothed[1] < nz(upperBand[1]) and rsiSmoothed < nz(upperBand[1]) ?
                 math.min(nz(upperBand[1]), newUpperBand) : newUpperBand

    bool crossUpper = ta.cross(rsiSmoothed, nz(upperBand[1]))
    bool crossLower = ta.cross(nz(lowerBand[1]), rsiSmoothed)
    trendDirection  := crossUpper ? 1 : crossLower ? -1 : nz(trendDirection[1], 1)

    float qqeTrendLine = trendDirection == 1 ? lowerBand : upperBand
    [rsiSmoothed, qqeTrendLine]


// @function                Calculates the Semaphore Signal Level (SSL) Channel of a given data series.
//                          SSL Channel provides clear trend signals using moving averages of high and low prices.
//                          Developed as a trend-following indicator that switches between support and resistance levels.
//                          Reference: https://www.tradingview.com/script/xzIoaIJC-SSL-channel/
// @param source            (series int/float) Series of values to process.
// @param length            (simple int) Number of bars for the moving average calculation.
// @returns                 ([float, float]) Tuple containing SSL Up and SSL Down lines.
export sslChannel(series float source, simple int length) =>
    float maHigh = ta.sma(high, length)
    float maLow  = ta.sma(low, length)

    var int trendState = 0
    trendState := source > maHigh ? 1 : source < maLow ? -1 : nz(trendState[1])

    float sslUp   = trendState < 0 ? maLow : maHigh
    float sslDown = trendState < 0 ? maHigh : maLow

    [sslUp, sslDown]


// @function                Calculates a Moving Average based on the specified type.
//                          Universal interface supporting all moving average algorithms (standard and advanced).
//                          Provides a unified way to switch between different MA types for comparison and optimization.
// @param source            (series int/float) Series of values to process.
// @param length            (simple int) Number of bars for the moving average calculation.
// @param maType            (simple MaType) Type of moving average to calculate. Optional. Default is SMA.
// @returns                 (float) The calculated moving average value based on the specified type.
export ma(series float source, simple int length, simple MaType maType = MaType.SMA) =>
    switch maType
        MaType.SMA => ta.sma(source, length)
        MaType.EMA => ta.ema(source, length)
        MaType.RMA => ta.rma(source, length)
        MaType.WMA => ta.wma(source, length)
        MaType.HMA => ta.hma(source, length)
        MaType.VWMA => ta.vwma(source, length)
        MaType.ALMA => ta.alma(source, length, 0.85, 6.0)
        MaType.LSMA => ta.linreg(source, length, 0)
        MaType.DEMA => dema(source, length)
        MaType.TEMA => tema(source, length)
        MaType.ZLEMA => zlema(source, length)
        MaType.T3 => t3(source, length)
        MaType.FRAMA => frama(source, length)
        MaType.KAMA => kama(source, length)
        MaType.ULTIMATE_SMOOTHER => ultimateSmoother(source, length)
        MaType.MCGINLEY_DYNAMIC => mcginleyDynamic(source, length)
        MaType.LAGUERRE_FILTER => laguerreFilter(source, length)
        MaType.LAGUERRE_BINOMIAL_FILTER => laguerreBinomialFilter(source, length)
        MaType.SUPER_SMOOTHER => superSmoother(source, length)
        MaType.KALMAN_FILTER => kalmanFilter(source)
        MaType.TMA => tma(source, length)


// @function                Calculates the Average True Range (ATR) using the specified moving average type.
//                          ATR measures market volatility by averaging the True Range over a specified period.
//                          Supports multiple moving average algorithms for smoothing the True Range values.
//                          Developed by J. Welles Wilder Jr., published in \"New Concepts in Technical Trading Systems\" (1978).
// @param length            (simple int) Number of bars for the ATR calculation.
// @param maType            (simple MaType) Type of moving average to use for smoothing. Optional. Default is RMA.
// @returns                 (float) The calculated Average True Range value.
export atr(simple int length, simple MaType maType = MaType.RMA) =>
    float trueRange = ta.tr(true)
    ma(trueRange, length, maType)


// @function                Calculates the Moving Average Convergence Divergence (MACD) with customizable MA types.
//                          MACD shows the relationship between two moving averages of a security's price.
//                          The MACD line is calculated as the difference between fast and slow moving averages.
//                          Supports different moving average algorithms for both main MACD calculation and signal line.
//                          Developed by Gerald Appel in the late 1970s as a trend-following momentum indicator.
//                          Standard settings are 12/26/9 periods with EMA smoothing.
// @param source            (series float) Series of values to process.
// @param fastLength        (simple int) Period for the fast moving average.
// @param slowLength        (simple int) Period for the slow moving average.
// @param signalLength      (simple int) Period for the signal line moving average.
// @param maType            (simple MaType) Type of moving average for main MACD calculation. Optional. Default is EMA.
// @param signalMaType      (simple MaType) Type of moving average for signal line calculation. Optional. Default is EMA.
// @returns                 ([float, float, float]) Tuple containing MACD line, signal line, and histogram values.
export macd(series float source, simple int fastLength, simple int slowLength, simple int signalLength, simple MaType maType = MaType.EMA, simple MaType signalMaType = MaType.EMA) =>
    float fastMA = ma(source, fastLength, maType)
    float slowMA = ma(source, slowLength, maType)
    float macdLine = fastMA - slowMA
    float signalLine = ma(macdLine, signalLength, signalMaType)
    float histogram = macdLine - signalLine
    [macdLine, signalLine, histogram]


// @function                Calculates the Dual Moving Average Oscillator (DMAO) of a given data series.
//                          DMAO uses the same algorithm as the Percentage Price Oscillator (PPO), but
//                          can be applied to any data series including non-price data such as True Range (TR),
//                          Volume, or other technical indicators. It measures the percentage difference
//                          between fast and slow moving averages, normalized by the slow moving average.
// @param source            (series int/float) Series of values to process.
// @param fastLength        (simple int) Period for the fast moving average.
// @param slowLength        (simple int) Period for the slow moving average.
// @param maType            (simple MaType) Type of moving average to use for both calculations. Optional. Default is EMA.
// @returns                 (float) The calculated Dual Moving Average Oscillator value as a percentage.
export dmao(series float source, simple int fastLength, simple int slowLength, simple MaType maType = MaType.EMA) =>
    float fastMA = ma(source, fastLength, maType)
    float slowMA = ma(source, slowLength, maType)
    (fastMA - slowMA) / slowMA * 100.0


// @function                Calculates the Continuation Index of a given data series.
//                          The index represents the Inverse Fisher Transform of the normalized
//                          difference between an UltimateSmoother and an N-order Laguerre filter.
//                          Developed by John F. Ehlers, published in TASC 2025.09.
//                          Reference: \"Trend Onset And Trend Exhaustion - The Continuation Index\".
// @param source            (series int/float) Series of values to process.
// @param length            (simple int) The calculation length.
// @param gamma             (simple float) Controls the phase response of the Laguerre filter.
//                          With a smaller gamma, the filter is more responsive to rapid changes.
//                          With a larger gamma, the filter is more responsive to trends. Optional. Default is 0.8.
// @param order             (simple int) The order of the Laguerre filter, which directly affects its lag.
//                          Must be a value from 1 to 10. Optional. Default is 8.
// @returns                 (float) The calculated Continuation Index value.
export continuationIndex(series float source, simple int length, simple float gamma = 0.8, simple int order = 8) =>
    float smoother = ultimateSmoother(source, int(length / 2))
    float laguerre = laguerreFilter(source, length, gamma, order)
    float diff     = smoother - laguerre
    float normalized = nz(2.0 * diff / ta.sma(math.abs(diff), length))
    float exp2x    = math.exp(2.0 * normalized)
    (exp2x - 1.0) / (exp2x + 1.0)


// @function                Calculates the Stochastic Oscillator of a given data series.
//                          The Stochastic Oscillator measures the current value relative to its range
//                          over a specified period, providing momentum and overbought/oversold signals.
//                          Developed by George Lane in the 1950s as a momentum indicator.
//                          Standard interpretation: Above 80 = overbought, Below 20 = oversold.
//                          Note: Standard Stochastic uses 3-period SMA smoothing for %K (Slow Stochastic).
//                          Fast Stochastic uses raw %K without smoothing.
// @param source            (series int/float) Series of values to process (typically close price).
// @param highSource        (series int/float) Series of high values (typically high price).
// @param lowSource         (series int/float) Series of low values (typically low price).
// @param kLength           (simple int) Period for %K calculation (lookback period).
// @param kSmooth           (simple int) Smoothing period for %K line (use 1 for Fast Stochastic, 3 for Slow Stochastic).
// @param dSmooth           (simple int) Smoothing period for %D signal line (typically 3).
// @param maType            (simple MaType) Moving average type for smoothing. Optional. Default is SMA.
// @returns                 ([float, float]) Tuple containing %K and %D stochastic values.
export stochastic(series float source, series float highSource, series float lowSource, simple int kLength, simple int kSmooth, simple int dSmooth, simple MaType maType = MaType.SMA) =>
    float rawK = ta.stoch(source, highSource, lowSource, kLength)
    float percentK = ma(rawK, kSmooth, maType)
    float percentD = ma(percentK, dSmooth, maType)
    [percentK, percentD]


// @function                Calculates the Relative Strength Index (RSI) with customizable smoothing.
//                          RSI measures the magnitude of recent price changes to evaluate overbought
//                          or oversold conditions. Traditionally uses Wilder's smoothing (RMA), but
//                          this implementation allows different moving average types for flexibility.
//                          Developed by J. Welles Wilder Jr., published in "New Concepts in Technical Trading Systems" (1978).
//                          Standard interpretation: Above 70 = overbought, Below 30 = oversold.
// @param source            (series int/float) Series of values to process (typically close price).
// @param length            (simple int) Period for RSI calculation (typically 14).
// @param maType            (simple MaType) Moving average type for gain/loss smoothing. Optional. Default is RMA (Wilder's original).
// @returns                 (float) The calculated RSI value (0-100 range).
export rsi(series float source, simple int length, simple MaType maType = MaType.RMA) =>
    float change = ta.change(source)
    float gain = math.max(change, 0)
    float loss = math.max(-change, 0)
    float avgGain = ma(gain, length, maType)
    float avgLoss = ma(loss, length, maType)

    if avgLoss == 0
        100  // All gains, no losses = maximum RSI
    else
        float rs = avgGain / avgLoss
        100 - (100 / (1 + rs))


// @function                Calculates Bollinger Bands with customizable moving average type.
//                          Bollinger Bands consist of a middle band (moving average) and two outer bands
//                          placed at standard deviations above and below the middle band, providing
//                          dynamic support and resistance levels that adjust to volatility.
//                          Developed by John Bollinger in the 1980s, published in "Bollinger on Bollinger Bands" (2001).
//                          Standard interpretation: Price touching upper band suggests overbought, lower band suggests oversold.
//                          Band width expands during high volatility and contracts during low volatility.
// @param source            (series int/float) Series of values to process (typically close price).
// @param length            (simple int) Period for moving average calculation (typically 20).
// @param multiplier        (simple float) Standard deviation multiplier for band width (typically 2.0).
// @param maType            (simple MaType) Moving average type for middle band calculation. Optional. Default is SMA (Bollinger's original).
// @returns                 ([float, float, float]) Tuple containing middle band (basis), upper band, and lower band values.
export bb(series float source, simple int length, simple float multiplier = 2.0, simple MaType maType = MaType.SMA) =>
    float basis = ma(source, length, maType)
    float dev = ta.stdev(source, length)
    float upper = basis + multiplier * dev
    float lower = basis - multiplier * dev
    [basis, upper, lower]


// @function                Calculates Keltner Channel with customizable moving average types.
//                          Keltner Channel uses a moving average as the middle line and ATR (Average True Range)
//                          to set the channel bands, providing volatility-based support and resistance levels.
//                          Unlike Bollinger Bands which use standard deviation, Keltner uses ATR for band width,
//                          making it smoother and less prone to whipsaws in volatile markets.
//                          Originally developed by Chester Keltner (1960), modernized by Linda Bradford Raschke.
//                          Standard interpretation: Price above upper band = strong uptrend, below lower band = strong downtrend.
// @param source            (series int/float) Series of values for middle band calculation (typically close price).
// @param length            (simple int) Period for middle band moving average (typically 20).
// @param atrLength         (simple int) Period for ATR calculation (typically 10 or equal to length).
// @param multiplier        (simple float) ATR multiplier for band width (typically 2.0).
// @param maType            (simple MaType) Moving average type for middle band. Optional. Default is EMA (modern standard).
// @param atrMaType         (simple MaType) Moving average type for ATR smoothing. Optional. Default is RMA (Wilder's method).
// @returns                 ([float, float, float]) Tuple containing middle band (basis), upper band, and lower band values.
export kc(series float source, simple int length, simple int atrLength, simple float multiplier = 2.0, simple MaType maType = MaType.EMA, simple MaType atrMaType = MaType.RMA) =>
    float basis = ma(source, length, maType)
    float atrValue = atr(atrLength, atrMaType)
    float upper = basis + multiplier * atrValue
    float lower = basis - multiplier * atrValue
    [basis, upper, lower]


// @function                Calculates Donchian Channel based on highest and lowest values.
//                          Donchian Channel identifies the highest and lowest values over a specified period,
//                          creating a breakout channel. The middle line is the average of upper and lower bands.
//                          This is a pure price action indicator without any smoothing or volatility adjustments.
//                          Developed by Richard Donchian, known as the "father of trend following" (1970s).
//                          Standard interpretation: Breakout above upper band = buy signal, below lower band = sell signal.
// @param highSeries        (series int/float) Series of high values (typically high price, but can be any data series).
// @param lowSeries         (series int/float) Series of low values (typically low price, but can be any data series).
// @param length            (simple int) Lookback period for highest/lowest calculation (typically 20 or 50).
// @returns                 ([float, float, float]) Tuple containing middle band (basis), upper band, and lower band values.
export dc(series float highSeries, series float lowSeries, simple int length) =>
    float upper = ta.highest(highSeries, length)
    float lower = ta.lowest(lowSeries, length)
    float basis = (upper + lower) / 2
    [basis, upper, lower]


// Example usage: DMAO histogram calculation and visualization
// This example demonstrates how to use the dmao() function to calculate
// the Dual Moving Average Oscillator of volume data and display it as a histogram

// Input parameters for DMAO example
fastLengthInput = input.int(12, "Fast Length", minval=1, tooltip="Period for fast moving average")
slowLengthInput = input.int(50, "Slow Length", minval=1, tooltip="Period for slow moving average")
maTypeInput = input.enum(MaType.T3, "MA Type", tooltip="Moving average type for DMAO calculation")

// Calculate DMAO with user inputs
dmaoValue = dmao(volume, fastLengthInput, slowLengthInput, maTypeInput)

// Plot DMAO as histogram with dynamic coloring
plot(dmaoValue, "Volume DMAO", color=(dmaoValue >= 0 ? (dmaoValue[1] < dmaoValue ? #26A69A : #B2DFDB) : (dmaoValue[1] < dmaoValue ? #FFCDD2 : #FF5252)),
     style=plot.style_columns, linewidth=2)
