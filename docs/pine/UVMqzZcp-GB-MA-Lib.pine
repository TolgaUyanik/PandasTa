//@version=6

// @description Moving Average bank + timeframe helper for GB-RMBP+ strategy.
// 22 MA implementations as standalone pure functions, plus htf_for_period.
// Functions are lazy: only the one you call actually computes.
library("GB_MA_Lib", overlay = true)


// @function Simple Moving Average
// @param src Source series
// @param len Length
// @returns SMA series
export calc_sma(float src, int len) => ta.sma(src, len)

// @function Exponential Moving Average
export calc_ema(float src, int len) => ta.ema(src, len)

// @function Hull Moving Average
export calc_hma(float src, int len) =>
    ta.wma(2 * ta.wma(src, len / 2) - ta.wma(src, len), math.round(math.sqrt(len)))

// @function Weighted Moving Average
export calc_wma(float src, int len) => ta.wma(src, len)

// @function Volume Weighted Moving Average
export calc_vwma(float src, int len) => ta.vwma(src, len)

// @function Wilder/Running Moving Average
export calc_rma(float src, int len) => ta.rma(src, len)

// @function Arnaud Legoux Moving Average
export calc_alma(float src, int len) => ta.alma(src, len, 0.85, 6)

// @function Symmetrically-Weighted Moving Average (length fixed by Pine)
export calc_swma(float src) => ta.swma(src)

// @function Double Exponential Moving Average
export calc_dema(float src, int len) =>
    e1 = ta.ema(src, len)
    e2 = ta.ema(e1, len)
    2 * e1 - e2

// @function Triple Exponential Moving Average
export calc_tema(float src, int len) =>
    e1 = ta.ema(src, len)
    e2 = ta.ema(e1, len)
    e3 = ta.ema(e2, len)
    3 * (e1 - e2) + e3

// @function Zero-lag EMA variant (EMA1 + difference)
export calc_zema(float src, int len) =>
    e1 = ta.ema(src, len)
    e2 = ta.ema(e1, len)
    e1 + (e1 - e2)

// @function Zero-Lag EMA
export calc_zlema(float src, int len) =>
    lag = math.floor((len - 1) / 2)
    ta.ema(src + (src - src[lag]), len)

// @function TRAMA (Trend-Regularity Adaptive MA, Lux Algo)
export calc_trama(float src, int len) =>
    var float t = na
    hh_T = math.max(math.sign(ta.change(ta.highest(len))), 0)
    ll_T = math.max(math.sign(ta.change(ta.lowest(len)) * -1), 0)
    tc_T = math.pow(ta.sma((hh_T != 0 or ll_T != 0) ? 1 : 0, len), 2)
    t := nz(t[1] + tc_T * (src - t[1]), src)
    t

// @function P-KAMA (Power-Kaufman Adaptive MA)
export calc_pkama(float src, int len) =>
    factor_pkama = 3.0
    per = math.pow(math.abs(ta.change(src, len)) / math.sum(math.abs(ta.change(src)), len), factor_pkama)
    var float pK = na
    pK := per * src + (1 - per) * nz(pK[1], src)
    pK

// @function T3 Moving Average
export calc_t3(float src, int len) =>
    xe1 = ta.ema(src, len)
    xe2 = ta.ema(xe1, len)
    xe3 = ta.ema(xe2, len)
    xe4 = ta.ema(xe3, len)
    xe5 = ta.ema(xe4, len)
    xe6 = ta.ema(xe5, len)
    b = 0.7
    c1 = -b*b*b
    c2 = 3*b*b+3*b*b*b
    c3 = -6*b*b-3*b-3*b*b*b
    c4 = 1+3*b+b*b*b+3*b*b
    c1 * xe6 + c2 * xe5 + c3 * xe4 + c4 * xe3

// @function Triangular Moving Average
export calc_tma(float src, int len) =>
    ta.sma(ta.sma(src, math.ceil(len / 2)), math.floor(len / 2) + 1)

// @function VAR (Variable Index Dynamic MA-like)
export calc_var(float src, int len) =>
    valpha = 2 / (len + 1)
    vud1 = src > src[1] ? src - src[1] : 0
    vdd1 = src < src[1] ? src[1] - src : 0
    vUD = math.sum(vud1, 9)
    vDD = math.sum(vdd1, 9)
    vCMO = nz((vUD - vDD) / (vUD + vDD))
    var float V = na
    V := nz(valpha * math.abs(vCMO) * src) + (1 - valpha * math.abs(vCMO)) * nz(V[1])
    V

// @function Time Series Forecast
export calc_tsf(float src, int len) =>
    lrc = ta.linreg(src, len, 0)
    lrc1 = ta.linreg(src, len, 1)
    ta.linreg(src, len, 0) + (lrc - lrc1)

// @function Zero-Lag Least-Squares Moving Average
export calc_zlsma(float src, int len) =>
    lsma = ta.linreg(src, len, 0)
    lsma2 = ta.linreg(lsma, len, 0)
    lsma + (lsma - lsma2)

// @function McGinley Dynamic
export calc_mcginley(float src, int len) =>
    tempEMA = ta.ema(src, len)
    var float m = na
    m := na(m[1]) ? tempEMA : m[1] + (src - m[1]) / (len * math.pow(src / m[1], 4))
    m

// @function Zero-Lag DEMA
export calc_zldema(float src, int len) =>
    f1 = ta.ema(src, len)
    s2 = ta.ema(f1, len)
    d = 2 * f1 - s2
    fzl = ta.ema(d, len)
    szl = ta.ema(fzl, len)
    2 * fzl - szl

// @function Zero-Lag TEMA
export calc_zltema(float src, int len) =>
    f1 = ta.ema(src, len)
    s2 = ta.ema(f1, len)
    t3 = ta.ema(s2, len)
    tem = 3 * (f1 - s2) + t3
    fT = ta.ema(tem, len)
    sT = ta.ema(fT, len)
    tT = ta.ema(sT, len)
    3 * (fT - sT) + tT

// @function Maps chart timeframe to a higher timeframe string (used for HTF MA bias).
// @param tf Current timeframe.period
// @returns HTF string for request.security
export htf_for_period(string tf) =>
    switch tf
        '1'   => '15'
        '3'   => '60'
        '5'   => '15'
        '15'  => '45'
        '30'  => '120'
        '45'  => '2D'
        '60'  => '2D'
        '120' => '4D'
        '180' => '5D'
        '240' => '8D'
        '720' => 'M'
        '1D'  => '2M'
        => '2M'


// Anchor plot so the library compiles
plot(na, title = "anchor", display = display.none)
