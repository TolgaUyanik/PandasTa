//@version=6
indicator("Liquidity Thermodynamics Engine V9 Lite", shorttitle="LTE Lite", overlay=false, max_labels_count=200)

//====================================================
// INPUT GROUPS
//====================================================
groupCore      = "Core Engine"
groupDisplay   = "Display"
groupImpulse   = "Impulse Histogram"
groupAccel     = "Acceleration + Follow-Through"
groupCompress  = "Compression"
groupDiverge   = "Divergence"
groupEnergy    = "Energy Exhaustion"
groupFlow      = "Flow Map"

//====================================================
// CORE ENGINE
//====================================================
zLen = input.int(100, "Z-Score Length", minval=50, group=groupCore)
smoothLen = input.int(14, "Composite Smoothing Length", minval=1, group=groupCore)
signalLen = input.int(12, "Signal Smoothing Length", minval=2, group=groupCore)
histLen = input.int(3, "Impulse Smoothing Length", minval=1, group=groupCore)
flowLen = input.int(4, "Flow Smoothing Length", minval=1, group=groupCore)

useReservesOverlay = input.bool(true, "Use Reserve Balances Overlay", group=groupCore)
useDxyOverlay = input.bool(false, "Use DXY Inverse Overlay", group=groupCore)

wNetLiquidity = input.float(3.00, "Net Liquidity Weight", minval=0.0, step=0.25, group=groupCore)
wReserves = input.float(1.00, "Reserve Weight", minval=0.0, step=0.25, group=groupCore)
wDxy = input.float(1.00, "DXY Inverse Weight", minval=0.0, step=0.25, group=groupCore)
impulseBlend = input.float(0.15, "Impulse Blend Weight", minval=0.0, maxval=0.50, step=0.05, group=groupCore)

//====================================================
// DISPLAY
//====================================================
showZeroLine = input.bool(true, "Show Zero Line", group=groupDisplay)
showComposite = input.bool(true, "Show Composite Line", group=groupDisplay)
showSignal = input.bool(true, "Show Signal Line", group=groupDisplay)
showImpulse = input.bool(true, "Show Impulse Histogram", group=groupDisplay)

//====================================================
// IMPULSE HISTOGRAM
//====================================================
hideSmallImpulseBars = input.bool(false, "Hide Small Impulse Bars", group=groupImpulse)
fixedImpulseThreshold = input.float(0.04, "Impulse Visibility Threshold", minval=0.0, step=0.01, group=groupImpulse)
impulseStrengthScaling = input.bool(true, "Scale Histogram Opacity by Strength", group=groupImpulse)
highlightKeyPositiveImpulse = input.bool(true, "Brighten Key Positive Impulse Bars", group=groupImpulse)
keyPositiveImpulseLevel = input.float(0.10, "Key Positive Impulse Level", minval=0.0, step=0.01, group=groupImpulse)
keyPositiveImpulseOpacity = input.int(0, "Key Positive Impulse Opacity", minval=0, maxval=100, group=groupImpulse)

//====================================================
// ACCELERATION + FOLLOW-THROUGH
//====================================================
showAccelerationMarkers = input.bool(true, "Show Acceleration +/- Markers", group=groupAccel)
accelSmoothing = input.int(3, "Acceleration Smoothing Length", minval=1, group=groupAccel)
accelThreshold = input.float(0.04, "Acceleration Threshold", minval=0.0, step=0.005, group=groupAccel)
accelMinBars = input.int(3, "Minimum Bars Between Acceleration Signals", minval=1, group=groupAccel)

showImpulseAccelWindowSetup = input.bool(true, "Show Bright Impulse + Accel Window Signal", group=groupAccel)
impulseAccelWindow = input.int(7, "Impulse / Accel Window Bars", minval=1, maxval=20, group=groupAccel)

//====================================================
// COMPRESSION
//====================================================
showCompressionSignals = input.bool(true, "Show Compression", group=groupCompress)
compressionThreshold = input.float(0.03, "Compression Impulse Threshold", minval=0.0, step=0.01, group=groupCompress)
compressionSlopeThreshold = input.float(0.03, "Compression Composite Slope Threshold", minval=0.0, step=0.01, group=groupCompress)
compressionMinBars = input.int(4, "Minimum Compression Bars", minval=1, group=groupCompress)

//====================================================
// DIVERGENCE
//====================================================
showDivergenceSignals = input.bool(true, "Show Divergence", group=groupDiverge)
divergenceMode = input.string("Price vs Liquidity + Impulse", "Divergence Mode",
 options=["Off", "Price vs Liquidity", "Price vs Liquidity + Impulse"], group=groupDiverge)
divPivotLen = input.int(6, "Divergence Pivot Length", minval=2, group=groupDiverge)
divMinBars = input.int(10, "Minimum Bars Between Divergence Signals", minval=1, group=groupDiverge)

//====================================================
// ENERGY EXHAUSTION
//====================================================
showEnergyExhaustionMarker = input.bool(false, "Show Energy Exhaustion Flag", group=groupEnergy)
energyExhaustionSpikeThreshold = input.float(-30.0, "Energy Exhaustion Spike Threshold", step=1.0, group=groupEnergy)
energyExhaustionVelThreshold = input.float(-15.0, "Energy Exhaustion Cluster Threshold", step=0.5, group=groupEnergy)
energyExhaustionBars = input.int(3, "Energy Exhaustion Consecutive Bars", minval=2, maxval=6, group=groupEnergy)
useEnergyExhaustionCooldown = input.bool(true, "Use Energy Exhaustion Cooldown", group=groupEnergy)
energyExhaustionCooldownBars = input.int(40, "Energy Exhaustion Cooldown Bars", minval=1, maxval=200, group=groupEnergy)
useEnergyExhaustionFilter = input.bool(true, "Require Low / Dormant Energy", group=groupEnergy)
energyExhaustionMax = input.int(20, "Maximum Energy for Exhaustion", minval=0, maxval=100, group=groupEnergy)

//====================================================
// FLOW MAP
//====================================================
showFlowMap = input.bool(false, "Show Flow Map", group=groupFlow)
showFedFlow = input.bool(true, "Show Fed Flow", group=groupFlow)
showTgaFlow = input.bool(true, "Show Treasury Flow", group=groupFlow)
showRrpFlow = input.bool(true, "Show RRP Flow", group=groupFlow)
showReserveFlow = input.bool(true, "Show Reserve Flow", group=groupFlow)

fedFlowColor = input.color(color.aqua, "Fed Flow Color", group=groupFlow)
tgaFlowColor = input.color(color.orange, "Treasury Flow Color", group=groupFlow)
rrpFlowColor = input.color(color.purple, "RRP Flow Color", group=groupFlow)
reserveFlowColor = input.color(color.green, "Reserve Flow Color", group=groupFlow)

flowDisplayMode = input.string("Stacked Bars", "Flow Map Display Mode",
 options=["Stacked Bars", "Dominant Bars", "Stacked + Dominant Marker"], group=groupFlow)

flowThresh = input.float(0.01, "Flow Visibility Threshold", minval=0.0, step=0.005, group=groupFlow)

//====================================================
// SERIES
//====================================================
walcl    = request.security("FRED:WALCL", timeframe.period, close)
tga      = request.security("FRED:WTREGEN", timeframe.period, close)
rrp      = request.security("FRED:RRPONTSYD", timeframe.period, close)
reserves = request.security("FRED:WRESBAL", timeframe.period, close)
dxy      = request.security("TVC:DXY", timeframe.period, close)

// Original-math net liquidity behavior retained for the Lite signal profile.
netLiquidity = not na(walcl) and not na(tga) and not na(rrp) ? walcl - tga - rrp : not na(walcl) and not na(tga) ? walcl - tga : walcl

//====================================================
// HELPERS
//====================================================
f_zscore(src, len) =>
    mean = ta.sma(src, len)
    dev  = ta.stdev(src, len)
    dev != 0 ? (src - mean) / dev : na

f_clamp(v, lo, hi) =>
    math.max(lo, math.min(hi, v))

//====================================================
// CORE LIQUIDITY MODEL
//====================================================
zNetLiquidity = f_zscore(netLiquidity, zLen)
zWALCL = f_zscore(walcl, zLen)

zTgaRaw = f_zscore(tga, zLen)
zTga = not na(zTgaRaw) ? -zTgaRaw : na

zRrpRaw = f_zscore(rrp, zLen)
zRrp = not na(zRrpRaw) ? -zRrpRaw : na

zReserves = f_zscore(reserves, zLen)

zDxyRaw = f_zscore(dxy, zLen)
zDxy = not na(zDxyRaw) ? -zDxyRaw : na

netEnabled = not na(zNetLiquidity) and wNetLiquidity > 0
reservesEnabled = useReservesOverlay and not na(zReserves) and wReserves > 0
dxyEnabled = useDxyOverlay and not na(zDxy) and wDxy > 0

activeWeightSum =
     (netEnabled ? wNetLiquidity : 0.0) +
     (reservesEnabled ? wReserves : 0.0) +
     (dxyEnabled ? wDxy : 0.0)

weightedTotal =
     (netEnabled ? zNetLiquidity * wNetLiquidity : 0.0) +
     (reservesEnabled ? zReserves * wReserves : 0.0) +
     (dxyEnabled ? zDxy * wDxy : 0.0)

rawComposite = activeWeightSum != 0 ? weightedTotal / activeWeightSum : na

levelComponent = ta.ema(rawComposite, smoothLen)
impulseCoreRaw = ta.change(rawComposite)
impulseCore = ta.ema(impulseCoreRaw, histLen)

composite =
     not na(levelComponent) and not na(impulseCore) ?
     levelComponent * (1.0 - impulseBlend) + impulseCore * impulseBlend :
     levelComponent

signal = ta.ema(composite, signalLen)
impulse = ta.ema(ta.change(composite), histLen)

//====================================================
// FLOW MAP
//====================================================
fedFlowRaw = ta.change(zWALCL)
tgaFlowRaw = ta.change(zTga)
rrpFlowRaw = ta.change(zRrp)
reserveFlowRaw = ta.change(zReserves)

fedFlow = ta.ema(fedFlowRaw, flowLen) * 0.45
tgaFlow = ta.ema(tgaFlowRaw, flowLen) * 0.45
rrpFlow = ta.ema(rrpFlowRaw, flowLen) * 0.45
reserveFlow = ta.ema(reserveFlowRaw, flowLen) * 0.45

fedFlow := math.abs(fedFlow) < flowThresh ? na : fedFlow
tgaFlow := math.abs(tgaFlow) < flowThresh ? na : tgaFlow
rrpFlow := math.abs(rrpFlow) < flowThresh ? na : rrpFlow
reserveFlow := math.abs(reserveFlow) < flowThresh ? na : reserveFlow

fedAbs = na(fedFlow) ? 0.0 : math.abs(fedFlow)
tgaAbs = na(tgaFlow) ? 0.0 : math.abs(tgaFlow)
rrpAbs = na(rrpFlow) ? 0.0 : math.abs(rrpFlow)
reserveAbs = na(reserveFlow) ? 0.0 : math.abs(reserveFlow)

maxFlowAbs = math.max(fedAbs, math.max(tgaAbs, math.max(rrpAbs, reserveAbs)))

domFed = maxFlowAbs > 0 and fedAbs == maxFlowAbs
domTga = maxFlowAbs > 0 and tgaAbs == maxFlowAbs
domRrp = maxFlowAbs > 0 and rrpAbs == maxFlowAbs
domReserve = maxFlowAbs > 0 and reserveAbs == maxFlowAbs

fedFlowPlot =
     showFlowMap and
     showFedFlow and
     (
         flowDisplayMode != "Dominant Bars" or
         (flowDisplayMode == "Dominant Bars" and domFed)
     ) ? fedFlow : na

tgaFlowPlot =
     showFlowMap and
     showTgaFlow and
     (
         flowDisplayMode != "Dominant Bars" or
         (flowDisplayMode == "Dominant Bars" and domTga)
     ) ? tgaFlow : na

rrpFlowPlot =
     showFlowMap and
     showRrpFlow and
     (
         flowDisplayMode != "Dominant Bars" or
         (flowDisplayMode == "Dominant Bars" and domRrp)
     ) ? rrpFlow : na

reserveFlowPlot =
     showFlowMap and
     showReserveFlow and
     (
         flowDisplayMode != "Dominant Bars" or
         (flowDisplayMode == "Dominant Bars" and domReserve)
     ) ? reserveFlow : na

showDominantFlowMarker = showFlowMap and flowDisplayMode == "Stacked + Dominant Marker"

dominantFlowMarkerY =
     showDominantFlowMarker ?
     (
         domFed ? fedFlow :
         domTga ? tgaFlow :
         domRrp ? rrpFlow :
         domReserve ? reserveFlow :
         na
     ) :
     na

dominantFlowMarkerColor =
     domFed ? fedFlowColor :
     domTga ? tgaFlowColor :
     domRrp ? rrpFlowColor :
     reserveFlowColor

filteredImpulse = impulse
if hideSmallImpulseBars
    filteredImpulse := math.abs(impulse) >= fixedImpulseThreshold ? impulse : na

//====================================================
// ACCELERATION + BRIGHT IMPULSE FOLLOW-THROUGH
//====================================================
accelerationRaw = ta.change(impulse)
acceleration = ta.ema(accelerationRaw, accelSmoothing)

rawAccelPos = not na(acceleration) and acceleration > accelThreshold
rawAccelNeg = not na(acceleration) and acceleration < -accelThreshold

var int lastAccelPosBar = na
var int lastAccelNegBar = na

accelPos = rawAccelPos and (na(lastAccelPosBar) or bar_index - lastAccelPosBar >= accelMinBars)
accelNeg = rawAccelNeg and (na(lastAccelNegBar) or bar_index - lastAccelNegBar >= accelMinBars)

if accelPos
    lastAccelPosBar := bar_index
if accelNeg
    lastAccelNegBar := bar_index

keyPositiveImpulse =
     not na(filteredImpulse) and
     filteredImpulse > 0 and
     highlightKeyPositiveImpulse and
     filteredImpulse >= keyPositiveImpulseLevel

barsSinceAccelPos = ta.barssince(accelPos)
barsSinceKeyPositiveImpulse = ta.barssince(keyPositiveImpulse)

keyImpulseAccelWindowSetup =
     showImpulseAccelWindowSetup and
     keyPositiveImpulse and
     not na(barsSinceAccelPos) and
     barsSinceAccelPos <= impulseAccelWindow

accelAfterKeyImpulseWindowSetup =
     showImpulseAccelWindowSetup and
     accelPos and
     not na(barsSinceKeyPositiveImpulse) and
     barsSinceKeyPositiveImpulse <= impulseAccelWindow

impulseAccelWindowSignal =
     keyImpulseAccelWindowSetup or
     accelAfterKeyImpulseWindowSetup

//====================================================
// COMPRESSION
//====================================================
compressionBar =
     not na(impulse) and
     not na(composite) and
     math.abs(impulse) <= compressionThreshold and
     math.abs(ta.change(composite)) <= compressionSlopeThreshold

compressionCount = 0.0
for i = 0 to compressionMinBars - 1
    compressionCount += compressionBar[i] ? 1.0 : 0.0

compressionSignal = showCompressionSignals and compressionCount == compressionMinBars

//====================================================
// DIVERGENCE
//====================================================
pricePivotHigh = ta.pivothigh(high, divPivotLen, divPivotLen)
pricePivotLow  = ta.pivotlow(low, divPivotLen, divPivotLen)

curPriceHigh = not na(pricePivotHigh) ? high[divPivotLen] : na
curCompHigh  = not na(pricePivotHigh) ? composite[divPivotLen] : na
curImpHigh   = not na(pricePivotHigh) ? impulse[divPivotLen] : na

curPriceLow = not na(pricePivotLow) ? low[divPivotLen] : na
curCompLow  = not na(pricePivotLow) ? composite[divPivotLen] : na
curImpLow   = not na(pricePivotLow) ? impulse[divPivotLen] : na

var float prevPriceHigh = na
var float prevCompHigh = na
var int lastBearDivBar = na

var float prevPriceLow = na
var float prevCompLow = na
var int lastBullDivBar = na

bearDivRaw = false
bullDivRaw = false

if not na(curPriceHigh) and not na(curCompHigh)
    if not na(prevPriceHigh) and not na(prevCompHigh)
        bearDivRaw := curPriceHigh > prevPriceHigh and curCompHigh < prevCompHigh
        if divergenceMode == "Price vs Liquidity + Impulse"
            bearDivRaw := bearDivRaw and not na(curImpHigh) and curImpHigh < 0
    prevPriceHigh := curPriceHigh
    prevCompHigh := curCompHigh

if not na(curPriceLow) and not na(curCompLow)
    if not na(prevPriceLow) and not na(prevCompLow)
        bullDivRaw := curPriceLow < prevPriceLow and curCompLow > prevCompLow
        if divergenceMode == "Price vs Liquidity + Impulse"
            bullDivRaw := bullDivRaw and not na(curImpLow) and curImpLow > 0
    prevPriceLow := curPriceLow
    prevCompLow := curCompLow

bearDiv = showDivergenceSignals and divergenceMode != "Off" and bearDivRaw and (na(lastBearDivBar) or bar_index - lastBearDivBar >= divMinBars)
bullDiv = showDivergenceSignals and divergenceMode != "Off" and bullDivRaw and (na(lastBullDivBar) or bar_index - lastBullDivBar >= divMinBars)

if bearDiv
    lastBearDivBar := bar_index
if bullDiv
    lastBullDivBar := bar_index

//====================================================
// ENERGY EXHAUSTION
//====================================================
extremeLooseTh = 1.25
extremeTightTh = -1.25

compPressure =
     not na(composite) ?
     f_clamp(math.abs(composite) / math.max(math.abs(extremeLooseTh), math.abs(extremeTightTh)), 0.0, 1.0) :
     0.0

compressionPressure =
     compressionSignal ? 1.0 :
     (
         not na(impulse) and
         not na(composite) and
         math.abs(impulse) <= compressionThreshold * 1.5 and
         math.abs(ta.change(composite)) <= compressionSlopeThreshold * 1.5 ?
         0.65 :
         0.0
     )

expansionPressure =
     not na(impulse) ?
     f_clamp(math.abs(impulse) / math.max(fixedImpulseThreshold * 2.0, 0.0001), 0.0, 1.0) :
     0.0

pressureRaw = compPressure * 0.35 + compressionPressure * 0.40 + expansionPressure * 0.25
pressureScore = math.round(pressureRaw * 100.0)

vacuumStress =
     not na(composite) and composite < 0 ?
     f_clamp(math.abs(composite) / math.abs(extremeTightTh), 0.0, 1.0) :
     0.0

vacuumDrain =
     not na(impulse) and impulse < 0 ?
     f_clamp(math.abs(impulse) / math.max(fixedImpulseThreshold * 2.0, 0.0001), 0.0, 1.0) :
     0.0

vacuumAccelRaw = ta.change(impulse)
vacuumAccel = ta.ema(vacuumAccelRaw, 3)

vacuumAccelPart =
     not na(vacuumAccel) and vacuumAccel < 0 ?
     f_clamp(math.abs(vacuumAccel) / math.max(0.01 * 2.0, 0.0001), 0.0, 1.0) :
     0.0

vacuumCore =
     (vacuumStress * 0.5 + vacuumDrain * 0.4 + vacuumAccelPart * 0.1) *
     (1 + vacuumDrain * 1.2)

vacuumScore = math.round(f_clamp(vacuumCore * 130.0, 0.0, 100.0))

energyRaw = (pressureScore / 100.0) * (1.0 - vacuumScore / 100.0)
energyScore = math.round(f_clamp(energyRaw * 100.0, 0.0, 100.0))
energyVelocity = energyScore - energyScore[1]

energyExhaustionSpike = energyVelocity <= energyExhaustionSpikeThreshold

energyExhaustionCount = 0
for i = 0 to energyExhaustionBars - 1
    energyExhaustionCount += energyVelocity[i] <= energyExhaustionVelThreshold ? 1 : 0

energyExhaustionCluster = energyExhaustionCount == energyExhaustionBars

var int lastEnergyExhaustionBar = na

energyExhaustionEligible =
     not useEnergyExhaustionFilter or
     energyScore <= energyExhaustionMax

energyExhaustionMarkerRaw =
     showEnergyExhaustionMarker and
     energyExhaustionEligible and
     (energyExhaustionSpike or energyExhaustionCluster)

energyExhaustionMarker =
     energyExhaustionMarkerRaw and
     (
         not useEnergyExhaustionCooldown or
         na(lastEnergyExhaustionBar) or
         bar_index - lastEnergyExhaustionBar >= energyExhaustionCooldownBars
     )

if energyExhaustionMarker
    lastEnergyExhaustionBar := bar_index

//====================================================
// COLORS
//====================================================
impulseOpacity = 40
if impulseStrengthScaling and not na(filteredImpulse)
    denom = math.max(fixedImpulseThreshold * 3.0, 0.0001)
    strengthRatio = f_clamp(math.abs(filteredImpulse) / denom, 0.0, 1.0)
    impulseOpacity := 90 - int(90 * strengthRatio)

impulseColor = color.new(color.gray, 100)
if not na(filteredImpulse)
    if filteredImpulse > 0
        impulseColor := keyPositiveImpulse ? color.new(color.lime, keyPositiveImpulseOpacity) : color.new(color.green, impulseOpacity)
    else
        impulseColor := color.new(color.red, impulseOpacity)

//====================================================
// PLOTS
//====================================================
plot(showZeroLine ? 0 : na, title="Zero Line", color=color.new(color.gray, 65), linewidth=1)

plot(showImpulse ? filteredImpulse : na,
     title="Liquidity Impulse",
     style=plot.style_columns,
     color=impulseColor,
     linewidth=2)

plot(fedFlowPlot,
     title="Fed Flow",
     style=plot.style_columns,
     color=color.new(fedFlowColor, flowDisplayMode == "Dominant Bars" ? 0 : 25),
     linewidth=2)

plot(tgaFlowPlot,
     title="Treasury Flow",
     style=plot.style_columns,
     color=color.new(tgaFlowColor, flowDisplayMode == "Dominant Bars" ? 0 : 25),
     linewidth=2)

plot(rrpFlowPlot,
     title="RRP Flow",
     style=plot.style_columns,
     color=color.new(rrpFlowColor, flowDisplayMode == "Dominant Bars" ? 0 : 25),
     linewidth=2)

plot(reserveFlowPlot,
     title="Reserve Flow",
     style=plot.style_columns,
     color=color.new(reserveFlowColor, flowDisplayMode == "Dominant Bars" ? 0 : 30),
     linewidth=2)

plotshape(dominantFlowMarkerY,
     title="Dominant Flow Marker",
     style=shape.circle,
     location=location.absolute,
     color=dominantFlowMarkerColor,
     size=size.tiny)

plot(showComposite ? composite : na,
     title="Composite Line",
     color=color.white,
     linewidth=3)

plot(showSignal ? signal : na,
     title="Signal Line",
     color=color.yellow,
     linewidth=2)

plotshape(compressionSignal ? 0 : na,
     title="Compression",
     style=shape.diamond,
     location=location.absolute,
     color=color.silver,
     size=size.tiny)

plotshape(bullDiv ? composite : na,
     title="Bullish Divergence",
     style=shape.triangleup,
     location=location.absolute,
     color=color.lime,
     size=size.tiny)

plotshape(bearDiv ? composite : na,
     title="Bearish Divergence",
     style=shape.triangledown,
     location=location.absolute,
     color=color.red,
     size=size.tiny)

plotshape(showAccelerationMarkers and accelPos ? 0.12 : na,
     title="Positive Acceleration +",
     style=shape.labelup,
     location=location.absolute,
     color=color.new(color.black, 100),
     text="+",
     textcolor=color.yellow,
     size=size.tiny)

plotshape(showAccelerationMarkers and accelNeg ? -0.12 : na,
     title="Negative Acceleration -",
     style=shape.labeldown,
     location=location.absolute,
     color=color.new(color.black, 100),
     text="-",
     textcolor=color.yellow,
     size=size.tiny)

plotshape(impulseAccelWindowSignal ? -0.40 : na,
     title="Bright Impulse + Accel Window Signal",
     style=shape.triangleup,
     location=location.absolute,
     color=color.lime,
     size=size.small)

plotshape(energyExhaustionMarker ? composite + 0.45 : na,
     title="Energy Exhaustion Flag",
     style=shape.flag,
     location=location.absolute,
     color=color.rgb(124, 248, 7),
     size=size.small)

//====================================================
// ALERTS
//====================================================
alertcondition(impulseAccelWindowSignal,
     title="Bright Impulse + Accel Window Signal",
     message="LTE V3.7 Lite: bright positive impulse and positive acceleration occurred within the configured window.")
