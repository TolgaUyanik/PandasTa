//@version=6
indicator("SMC-NotYet", "SMC", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ============================================================================
// INPUTS
// ============================================================================

groupGeneral = "General"
zoneLifeInput = input.string("500", "Zone display distance", options = ["100", "300", "500", "700", "1000", "Unlimited"], group = groupGeneral)
invalidateBy = input.string("Close", "Invalidate zones using", options = ["Close", "Wick"], group = groupGeneral)
showZoneText = input.bool(true, "Show zone labels", group = groupGeneral)

int zoneLifeBars = switch zoneLifeInput
    "100" => 100
    "300" => 300
    "500" => 500
    "700" => 700
    "1000" => 1000
    => 0

groupFvg = "FVG / iFVG"
showFvg = input.bool(true, "Show FVG", group = groupFvg)
showIfvg = input.bool(true, "Convert failed FVG to iFVG", group = groupFvg)
removeFilledFvg = input.bool(true, "Remove fully mitigated FVG", group = groupFvg)
fvgAtrLen = input.int(14, "FVG ATR length", minval = 1, group = groupFvg)
fvgMinAtr = input.float(0.05, "Minimum FVG size (ATR)", minval = 0.0, step = 0.01, group = groupFvg)
fvgRequireDisplacement = input.bool(true, "Require middle-candle displacement", group = groupFvg)
fvgDispAtr = input.float(0.50, "Middle-candle body minimum (ATR)", minval = 0.0, step = 0.05, group = groupFvg)
maxFvgTotal = input.int(140, "Maximum total FVG/iFVG zones", minval = 10, maxval = 300, group = groupFvg)
showFvgD = input.bool(true, "Daily", inline = "fvg1", group = groupFvg)
showFvgH4 = input.bool(true, "H4", inline = "fvg1", group = groupFvg)
showFvgH1 = input.bool(true, "H1", inline = "fvg1", group = groupFvg)
showFvgM30 = input.bool(true, "M30", inline = "fvg2", group = groupFvg)
showFvgM15 = input.bool(true, "M15", inline = "fvg2", group = groupFvg)
showFvgM5 = input.bool(true, "M5", inline = "fvg2", group = groupFvg)
showFvgM3 = input.bool(true, "M3", inline = "fvg2", group = groupFvg)
bullFvgColor = input.color(color.new(color.aqua, 82), "Bullish FVG", inline = "fvgcol1", group = groupFvg)
bearFvgColor = input.color(color.new(color.orange, 82), "Bearish FVG", inline = "fvgcol1", group = groupFvg)
bullIfvgColor = input.color(color.new(color.lime, 76), "Bullish iFVG", inline = "fvgcol2", group = groupFvg)
bearIfvgColor = input.color(color.new(color.red, 76), "Bearish iFVG", inline = "fvgcol2", group = groupFvg)
invalidFvgColor = input.color(color.new(color.gray, 90), "Invalidated FVG/iFVG", group = groupFvg)

groupStructure = "Market Structure"
showStructure = input.bool(true, "Show BOS and CHoCH", group = groupStructure)
swingLen = input.int(5, "Swing length", minval = 2, maxval = 50, group = groupStructure)
maxStructureMarks = input.int(80, "Maximum structure marks", minval = 10, maxval = 200, group = groupStructure)
bullStructureColor = input.color(color.lime, "Bullish structure", inline = "mscol", group = groupStructure)
bearStructureColor = input.color(color.red, "Bearish structure", inline = "mscol", group = groupStructure)

groupOb = "Order Blocks / Breaker Blocks"
showOb = input.bool(true, "Show bullish and bearish OB", group = groupOb)
showBreaker = input.bool(true, "Convert failed OB to breaker block", group = groupOb)
obLookback = input.int(12, "Last opposing candle search", minval = 1, maxval = 50, group = groupOb)
obRange = input.string("Full candle", "OB range", options = ["Full candle", "Body"], group = groupOb)
obDispAtr = input.float(0.35, "Minimum break candle body (ATR)", minval = 0.0, step = 0.05, group = groupOb)
maxObTotal = input.int(50, "Maximum OB/breaker zones", minval = 5, maxval = 150, group = groupOb)
bullObColor = input.color(color.new(color.blue, 82), "Bullish OB", inline = "obcol1", group = groupOb)
bearObColor = input.color(color.new(color.red, 82), "Bearish OB", inline = "obcol1", group = groupOb)
bullBreakerColor = input.color(color.new(color.teal, 74), "Bullish breaker", inline = "obcol2", group = groupOb)
bearBreakerColor = input.color(color.new(color.purple, 74), "Bearish breaker", inline = "obcol2", group = groupOb)

groupBpr = "Balanced Price Range (BPR)"
showBpr = input.bool(true, "Show BPR from opposing FVG overlap", group = groupBpr)
bprSameTfOnly = input.bool(false, "Require both FVGs from same timeframe", group = groupBpr)
maxBprTotal = input.int(40, "Maximum BPR zones", minval = 5, maxval = 120, group = groupBpr)
bullBprColor = input.color(color.new(color.lime, 76), "Bullish BPR", inline = "bprcol", group = groupBpr)
bearBprColor = input.color(color.new(color.fuchsia, 76), "Bearish BPR", inline = "bprcol", group = groupBpr)

groupZones = "Buy / Sell Zones"
showBuySellZones = input.bool(true, "Show buy and sell zones", group = groupZones)
zoneDispAtr = input.float(0.60, "Minimum displacement body (ATR)", minval = 0.0, step = 0.05, group = groupZones)
maxBuySellZones = input.int(40, "Maximum buy/sell zones", minval = 5, maxval = 120, group = groupZones)
buyZoneColor = input.color(color.new(color.green, 84), "Buy zone", inline = "zonecol", group = groupZones)
sellZoneColor = input.color(color.new(color.red, 84), "Sell zone", inline = "zonecol", group = groupZones)

groupSessions = "Session Highs / Lows"
showSessions = input.bool(true, "Show session highs and lows", group = groupSessions)
sessionTimeZone = input.string("Etc/UTC", "Session time zone", group = groupSessions)
asiaSession = input.session("0000-0800", "Asia session", group = groupSessions)
londonSession = input.session("0800-1300", "London session", group = groupSessions)
newYorkSession = input.session("1300-2200", "New York session", group = groupSessions)
sessionHistoryDays = input.int(5, "Session history days", minval = 1, maxval = 30, group = groupSessions)
asiaColor = input.color(color.blue, "Asia", inline = "sesscol", group = groupSessions)
londonColor = input.color(color.green, "London", inline = "sesscol", group = groupSessions)
newYorkColor = input.color(color.orange, "New York", inline = "sesscol", group = groupSessions)

groupDash = "Structure Dashboard"
showDashboard = input.bool(true, "Show dashboard", group = groupDash)
dashSwingLen = input.int(5, "Dashboard swing length", minval = 2, maxval = 30, group = groupDash)

// ============================================================================
// COMMON HELPERS
// ============================================================================

f_isExpired(int bornBar) =>
    zoneLifeBars > 0 and bar_index - bornBar > zoneLifeBars

f_textColor() =>
    color.new(color.white, 0)

// Multi-timeframe zones are displayed only on their matching chart timeframe.
// Example: H1 FVG/BPR zones appear only when the chart is set to H1.
f_isChartTimeframe(string tf) =>
    timeframe.in_seconds(timeframe.period) == timeframe.in_seconds(tf)

// ============================================================================
// BALANCED PRICE RANGE ARRAYS AND FUNCTIONS
// A BPR is the overlap between an active bullish FVG and bearish FVG.
// The direction follows the most recently created FVG.
// ============================================================================

var bprBoxes = array.new_box()
var bprTops = array.new_float()
var bprBottoms = array.new_float()
var bprDirs = array.new_int()       // 1 bullish, -1 bearish
var bprBornBars = array.new_int()

f_deleteBpr(int index) =>
    box.delete(array.get(bprBoxes, index))
    array.remove(bprBoxes, index)
    array.remove(bprTops, index)
    array.remove(bprBottoms, index)
    array.remove(bprDirs, index)
    array.remove(bprBornBars, index)

f_trimBpr() =>
    while array.size(bprBoxes) > maxBprTotal
        f_deleteBpr(0)

f_addBpr(int leftTime, int rightTime, float zoneTop, float zoneBottom, int direction, string firstTag, string secondTag) =>
    if showBpr and not na(leftTime) and not na(rightTime) and zoneTop > zoneBottom
        color fillColor = direction == 1 ? bullBprColor : bearBprColor
        string tfText = firstTag == secondTag ? firstTag : firstTag + "/" + secondTag
        string zoneText = showZoneText ? tfText + (direction == 1 ? " Bull BPR" : " Bear BPR") : ""
        box newBox = box.new(left = leftTime, top = zoneTop, right = rightTime, bottom = zoneBottom, xloc = xloc.bar_time, extend = extend.right, bgcolor = fillColor, border_color = color.new(fillColor, 8), border_width = 1, text = zoneText, text_color = f_textColor(), text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_top)
        array.push(bprBoxes, newBox)
        array.push(bprTops, zoneTop)
        array.push(bprBottoms, zoneBottom)
        array.push(bprDirs, direction)
        array.push(bprBornBars, bar_index)
        f_trimBpr()

f_updateBpr() =>
    int i = array.size(bprBoxes) - 1
    while i >= 0
        float zoneTop = array.get(bprTops, i)
        float zoneBottom = array.get(bprBottoms, i)
        int direction = array.get(bprDirs, i)
        int bornBar = array.get(bprBornBars, i)
        bool invalid = direction == 1 ? (invalidateBy == "Close" ? close < zoneBottom : low < zoneBottom) : (invalidateBy == "Close" ? close > zoneTop : high > zoneTop)
        if invalid or f_isExpired(bornBar)
            f_deleteBpr(i)
        i -= 1

// ============================================================================
// FVG / iFVG ARRAYS AND FUNCTIONS
// ============================================================================

var fvgBoxes = array.new_box()
var fvgTops = array.new_float()
var fvgBottoms = array.new_float()
var fvgDirs = array.new_int()       // 1 bullish, -1 bearish
var fvgStates = array.new_int()     // 0 FVG, 1 iFVG, 2 invalidated
var fvgTags = array.new_string()
var fvgBornBars = array.new_int()

f_deleteFvg(int index) =>
    box.delete(array.get(fvgBoxes, index))
    array.remove(fvgBoxes, index)
    array.remove(fvgTops, index)
    array.remove(fvgBottoms, index)
    array.remove(fvgDirs, index)
    array.remove(fvgStates, index)
    array.remove(fvgTags, index)
    array.remove(fvgBornBars, index)

f_trimFvg() =>
    while array.size(fvgBoxes) > maxFvgTotal
        f_deleteFvg(0)

f_addFvg(int leftTime, int rightTime, float zoneTop, float zoneBottom, int direction, string tfTag) =>
    if showFvg and not na(leftTime) and not na(rightTime) and not na(zoneTop) and not na(zoneBottom) and zoneTop > zoneBottom
        color fillColor = direction == 1 ? bullFvgColor : bearFvgColor
        color borderColor = color.new(fillColor, 15)
        string zoneText = showZoneText ? tfTag + " FVG" : ""
        box newBox = box.new(left = leftTime, top = zoneTop, right = rightTime, bottom = zoneBottom, xloc = xloc.bar_time, extend = extend.right, bgcolor = fillColor, border_color = borderColor, border_width = 1, text = zoneText, text_color = f_textColor(), text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_top)
        array.push(fvgBoxes, newBox)
        array.push(fvgTops, zoneTop)
        array.push(fvgBottoms, zoneBottom)
        array.push(fvgDirs, direction)
        array.push(fvgStates, 0)
        array.push(fvgTags, tfTag)
        array.push(fvgBornBars, bar_index)

        // Build a BPR when this new FVG overlaps an older active opposing FVG.
        if showBpr and array.size(fvgBoxes) > 1
            int newIndex = array.size(fvgBoxes) - 1
            for k = 0 to newIndex - 1
                int oldDirection = array.get(fvgDirs, k)
                int oldState = array.get(fvgStates, k)
                string oldTag = array.get(fvgTags, k)
                bool timeframeAllowed = not bprSameTfOnly or oldTag == tfTag
                if oldState == 0 and oldDirection == -direction and timeframeAllowed
                    float overlapTop = math.min(zoneTop, array.get(fvgTops, k))
                    float overlapBottom = math.max(zoneBottom, array.get(fvgBottoms, k))
                    if overlapTop > overlapBottom
                        f_addBpr(leftTime, rightTime, overlapTop, overlapBottom, direction, oldTag, tfTag)

        f_trimFvg()

// A confirmed FVG is formed by three completed candles:
// Bullish FVG: candle 3 low is above candle 1 high.
// Bearish FVG: candle 3 high is below candle 1 low.
// The zone is created as soon as candle 3 closes, not one candle later.
f_scanCurrentFvg(string tfTag, bool enabled, int lastProcessedTime, float sourceAtr) =>
    int updatedTime = lastProcessedTime
    int signalTime = time
    int leftTime = time[2]
    int rightTime = time_close

    bool enoughHistory = not na(high[2]) and not na(low[2]) and not na(open[1]) and not na(close[1])
    bool bullGap = enoughHistory and low > high[2]
    float bullTop = low
    float bullBottom = high[2]
    bool bearGap = enoughHistory and high < low[2]
    float bearTop = low[2]
    float bearBottom = high

    float middleBody = math.abs(close[1] - open[1])
    float middleAtr = sourceAtr[1]
    bool bullDisplacementOk = not fvgRequireDisplacement or (close[1] > open[1] and not na(middleAtr) and middleBody >= middleAtr * fvgDispAtr)
    bool bearDisplacementOk = not fvgRequireDisplacement or (close[1] < open[1] and not na(middleAtr) and middleBody >= middleAtr * fvgDispAtr)
    bool isNewSignalBar = enabled and showFvg and barstate.isconfirmed and not na(signalTime) and signalTime > nz(updatedTime, 0)

    if isNewSignalBar
        float bullSize = bullTop - bullBottom
        float bearSize = bearTop - bearBottom
        bool bullSizeOk = not na(sourceAtr) and bullSize >= sourceAtr * fvgMinAtr
        bool bearSizeOk = not na(sourceAtr) and bearSize >= sourceAtr * fvgMinAtr
        if bullGap and bullSizeOk and bullDisplacementOk
            f_addFvg(leftTime, rightTime, bullTop, bullBottom, 1, tfTag)
        if bearGap and bearSizeOk and bearDisplacementOk
            f_addFvg(leftTime, rightTime, bearTop, bearBottom, -1, tfTag)
        updatedTime := signalTime
    updatedTime

f_updateFvg() =>
    int i = array.size(fvgBoxes) - 1
    while i >= 0
        box currentBox = array.get(fvgBoxes, i)
        float zoneTop = array.get(fvgTops, i)
        float zoneBottom = array.get(fvgBottoms, i)
        int direction = array.get(fvgDirs, i)
        int state = array.get(fvgStates, i)
        string tfTag = array.get(fvgTags, i)
        int bornBar = array.get(fvgBornBars, i)
        bool deleteZone = f_isExpired(bornBar)

        if not deleteZone and state == 0
            bool bullCloseFailure = direction == 1 and close < zoneBottom
            bool bearCloseFailure = direction == -1 and close > zoneTop
            bool bullFullyFilled = direction == 1 and low <= zoneBottom
            bool bearFullyFilled = direction == -1 and high >= zoneTop

            if bullCloseFailure
                if showIfvg
                    array.set(fvgDirs, i, -1)
                    array.set(fvgStates, i, 1)
                    box.set_bgcolor(currentBox, bearIfvgColor)
                    box.set_border_color(currentBox, color.new(bearIfvgColor, 10))
                    box.set_text(currentBox, showZoneText ? tfTag + " bearish iFVG" : "")
                else
                    deleteZone := true
            else if bearCloseFailure
                if showIfvg
                    array.set(fvgDirs, i, 1)
                    array.set(fvgStates, i, 1)
                    box.set_bgcolor(currentBox, bullIfvgColor)
                    box.set_border_color(currentBox, color.new(bullIfvgColor, 10))
                    box.set_text(currentBox, showZoneText ? tfTag + " bullish iFVG" : "")
                else
                    deleteZone := true
            else if removeFilledFvg and (bullFullyFilled or bearFullyFilled)
                deleteZone := true

        else if not deleteZone and state == 1
            // An iFVG is invalidated only by a candle close through its opposite side.
            // Bullish iFVG: close below the bottom. Bearish iFVG: close above the top.
            bool bullishIfvgInvalid = direction == 1 and close < zoneBottom
            bool bearishIfvgInvalid = direction == -1 and close > zoneTop
            if bullishIfvgInvalid or bearishIfvgInvalid
                array.set(fvgStates, i, 2)
                box.set_bgcolor(currentBox, invalidFvgColor)
                box.set_border_color(currentBox, color.new(color.gray, 78))
                box.set_text(currentBox, showZoneText ? tfTag + " invalidated iFVG" : "")
                box.set_extend(currentBox, extend.none)
                box.set_right(currentBox, time_close)

        // State 2 remains visible as a transparent grey historical zone until
        // the selected zone display distance expires or the object limit trims it.
        if deleteZone
            f_deleteFvg(i)
        i -= 1

bool chartIsD = f_isChartTimeframe("1D")
bool chartIsH4 = f_isChartTimeframe("240")
bool chartIsH1 = f_isChartTimeframe("60")
bool chartIsM30 = f_isChartTimeframe("30")
bool chartIsM15 = f_isChartTimeframe("15")
bool chartIsM5 = f_isChartTimeframe("5")
bool chartIsM3 = f_isChartTimeframe("3")

string activeFvgTag = chartIsD ? "D" : chartIsH4 ? "H4" : chartIsH1 ? "H1" : chartIsM30 ? "M30" : chartIsM15 ? "M15" : chartIsM5 ? "M5" : chartIsM3 ? "M3" : ""
bool activeFvgEnabled = chartIsD ? showFvgD : chartIsH4 ? showFvgH4 : chartIsH1 ? showFvgH1 : chartIsM30 ? showFvgM30 : chartIsM15 ? showFvgM15 : chartIsM5 ? showFvgM5 : chartIsM3 ? showFvgM3 : false

// History-dependent ATR is evaluated globally on every calculation.
float fvgAtrValue = ta.atr(fvgAtrLen)
var int lastFvgSignalTime = na
lastFvgSignalTime := f_scanCurrentFvg(activeFvgTag, activeFvgEnabled, lastFvgSignalTime, fvgAtrValue)
f_updateFvg()

// ============================================================================
// STRUCTURE, ORDER BLOCKS, BREAKER BLOCKS
// ============================================================================

var structureLines = array.new_line()
var structureLabels = array.new_label()

f_trimStructure() =>
    while array.size(structureLines) > maxStructureMarks
        line.delete(array.shift(structureLines))
    while array.size(structureLabels) > maxStructureMarks
        label.delete(array.shift(structureLabels))

f_addStructureMark(int startBar, float level, int direction, string markText) =>
    if showStructure
        color markColor = direction == 1 ? bullStructureColor : bearStructureColor
        line newLine = line.new(x1 = startBar, y1 = level, x2 = bar_index, y2 = level, xloc = xloc.bar_index, color = markColor, style = line.style_dashed, width = 1)
        label newLabel = label.new(x = bar_index, y = level, text = markText, xloc = xloc.bar_index, style = direction == 1 ? label.style_label_down : label.style_label_up, color = color.new(markColor, 10), textcolor = color.white, size = size.tiny)
        array.push(structureLines, newLine)
        array.push(structureLabels, newLabel)
        f_trimStructure()

var obBoxes = array.new_box()
var obTops = array.new_float()
var obBottoms = array.new_float()
var obDirs = array.new_int()       // 1 bullish, -1 bearish
var obStates = array.new_int()     // 0 OB, 1 breaker
var obBornBars = array.new_int()

f_deleteOb(int index) =>
    box.delete(array.get(obBoxes, index))
    array.remove(obBoxes, index)
    array.remove(obTops, index)
    array.remove(obBottoms, index)
    array.remove(obDirs, index)
    array.remove(obStates, index)
    array.remove(obBornBars, index)

f_trimOb() =>
    while array.size(obBoxes) > maxObTotal
        f_deleteOb(0)

// Reuse an existing active OB when the new candidate is nested in it,
// overlaps it, or price is currently trading inside it. Distinct OBs that
// form completely outside existing zones are still allowed.
f_hasReusableOb(float zoneTop, float zoneBottom, int direction) =>
    bool reusable = false
    int i = array.size(obBoxes) - 1
    while i >= 0 and not reusable
        float existingTop = array.get(obTops, i)
        float existingBottom = array.get(obBottoms, i)
        int existingDirection = array.get(obDirs, i)
        int existingState = array.get(obStates, i)
        bool sameActiveOb = existingState == 0 and existingDirection == direction
        bool zonesOverlap = zoneBottom <= existingTop and zoneTop >= existingBottom
        bool priceInside = close <= existingTop and close >= existingBottom
        if sameActiveOb and (zonesOverlap or priceInside)
            reusable := true
        i -= 1
    reusable

f_addOb(int leftTime, int rightTime, float zoneTop, float zoneBottom, int direction) =>
    bool reuseExisting = f_hasReusableOb(zoneTop, zoneBottom, direction)
    if showOb and zoneTop > zoneBottom and not reuseExisting
        color fillColor = direction == 1 ? bullObColor : bearObColor
        string zoneText = showZoneText ? (direction == 1 ? "Bull OB" : "Bear OB") : ""
        box newBox = box.new(left = leftTime, top = zoneTop, right = rightTime, bottom = zoneBottom, xloc = xloc.bar_time, extend = extend.right, bgcolor = fillColor, border_color = color.new(fillColor, 12), text = zoneText, text_color = f_textColor(), text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_top)
        array.push(obBoxes, newBox)
        array.push(obTops, zoneTop)
        array.push(obBottoms, zoneBottom)
        array.push(obDirs, direction)
        array.push(obStates, 0)
        array.push(obBornBars, bar_index)
        f_trimOb()

f_updateOb() =>
    int i = array.size(obBoxes) - 1
    while i >= 0
        box currentBox = array.get(obBoxes, i)
        float zoneTop = array.get(obTops, i)
        float zoneBottom = array.get(obBottoms, i)
        int direction = array.get(obDirs, i)
        int state = array.get(obStates, i)
        int bornBar = array.get(obBornBars, i)
        bool deleteZone = f_isExpired(bornBar)

        bool bullInvalid = direction == 1 and (invalidateBy == "Close" ? close < zoneBottom : low < zoneBottom)
        bool bearInvalid = direction == -1 and (invalidateBy == "Close" ? close > zoneTop : high > zoneTop)

        if not deleteZone and state == 0 and (bullInvalid or bearInvalid)
            if showBreaker
                int newDirection = direction == 1 ? -1 : 1
                color breakerColor = newDirection == 1 ? bullBreakerColor : bearBreakerColor
                array.set(obDirs, i, newDirection)
                array.set(obStates, i, 1)
                box.set_bgcolor(currentBox, breakerColor)
                box.set_border_color(currentBox, color.new(breakerColor, 10))
                box.set_text(currentBox, showZoneText ? (newDirection == 1 ? "Bull Breaker" : "Bear Breaker") : "")
            else
                deleteZone := true
        else if not deleteZone and state == 1 and (bullInvalid or bearInvalid)
            deleteZone := true

        if deleteZone
            f_deleteOb(i)
        i -= 1

float pivotHigh = ta.pivothigh(high, swingLen, swingLen)
float pivotLow = ta.pivotlow(low, swingLen, swingLen)

var float lastSwingHigh = na
var float lastSwingLow = na
var int lastSwingHighBar = na
var int lastSwingLowBar = na
var bool swingHighBroken = false
var bool swingLowBroken = false
var int structureBias = 0

if not na(pivotHigh)
    lastSwingHigh := pivotHigh
    lastSwingHighBar := bar_index - swingLen
    swingHighBroken := false

if not na(pivotLow)
    lastSwingLow := pivotLow
    lastSwingLowBar := bar_index - swingLen
    swingLowBroken := false

bool bullishStructureBreak = barstate.isconfirmed and not na(lastSwingHigh) and not swingHighBroken and close > lastSwingHigh
bool bearishStructureBreak = barstate.isconfirmed and not na(lastSwingLow) and not swingLowBroken and close < lastSwingLow
bool bullishChoch = bullishStructureBreak and structureBias == -1
bool bearishChoch = bearishStructureBreak and structureBias == 1
bool bullishBos = bullishStructureBreak and not bullishChoch
bool bearishBos = bearishStructureBreak and not bearishChoch

float currentAtr = ta.atr(14)
float currentBody = math.abs(close - open)
bool strongBreakCandle = not na(currentAtr) and currentBody >= currentAtr * obDispAtr

if bullishStructureBreak
    f_addStructureMark(lastSwingHighBar, lastSwingHigh, 1, bullishChoch ? "CHoCH" : "BOS")
    swingHighBroken := true
    structureBias := 1
    if showOb and strongBreakCandle
        for j = 1 to obLookback
            if close[j] < open[j]
                float obTop = obRange == "Body" ? math.max(open[j], close[j]) : high[j]
                float obBottom = obRange == "Body" ? math.min(open[j], close[j]) : low[j]
                f_addOb(time[j], time_close[j], obTop, obBottom, 1)
                break

if bearishStructureBreak
    f_addStructureMark(lastSwingLowBar, lastSwingLow, -1, bearishChoch ? "CHoCH" : "BOS")
    swingLowBroken := true
    structureBias := -1
    if showOb and strongBreakCandle
        for j = 1 to obLookback
            if close[j] > open[j]
                float obTop = obRange == "Body" ? math.max(open[j], close[j]) : high[j]
                float obBottom = obRange == "Body" ? math.min(open[j], close[j]) : low[j]
                f_addOb(time[j], time_close[j], obTop, obBottom, -1)
                break

f_updateOb()

// ============================================================================
// BALANCED PRICE RANGE UPDATES
// ============================================================================

f_updateBpr()

// ============================================================================
// BUY / SELL ZONES
// ============================================================================

var bsBoxes = array.new_box()
var bsTops = array.new_float()
var bsBottoms = array.new_float()
var bsDirs = array.new_int()
var bsBornBars = array.new_int()

f_deleteBs(int index) =>
    box.delete(array.get(bsBoxes, index))
    array.remove(bsBoxes, index)
    array.remove(bsTops, index)
    array.remove(bsBottoms, index)
    array.remove(bsDirs, index)
    array.remove(bsBornBars, index)

f_trimBs() =>
    while array.size(bsBoxes) > maxBuySellZones
        f_deleteBs(0)

// Reuse an existing active buy/sell zone when a new same-direction candidate
// overlaps it, is nested inside it, or price is currently trading inside it.
// A zone in the opposite direction does not suppress the new candidate.
f_hasReusableBs(float zoneTop, float zoneBottom, int direction) =>
    bool reusable = false
    int i = array.size(bsBoxes) - 1
    while i >= 0 and not reusable
        float existingTop = array.get(bsTops, i)
        float existingBottom = array.get(bsBottoms, i)
        int existingDirection = array.get(bsDirs, i)
        bool sameDirection = existingDirection == direction
        bool zonesOverlap = zoneBottom <= existingTop and zoneTop >= existingBottom
        bool priceInside = close <= existingTop and close >= existingBottom
        if sameDirection and (zonesOverlap or priceInside)
            reusable := true
        i -= 1
    reusable

f_addBs(int direction) =>
    float zoneTop = high[1]
    float zoneBottom = low[1]
    bool reuseExisting = f_hasReusableBs(zoneTop, zoneBottom, direction)
    bool created = false
    if showBuySellZones and zoneTop > zoneBottom and not reuseExisting
        color fillColor = direction == 1 ? buyZoneColor : sellZoneColor
        string zoneText = showZoneText ? (direction == 1 ? "Buy Zone" : "Sell Zone") : ""
        box newBox = box.new(left = time[1], top = zoneTop, right = time_close[1], bottom = zoneBottom, xloc = xloc.bar_time, extend = extend.right, bgcolor = fillColor, border_color = color.new(fillColor, 10), text = zoneText, text_color = f_textColor(), text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_top)
        array.push(bsBoxes, newBox)
        array.push(bsTops, zoneTop)
        array.push(bsBottoms, zoneBottom)
        array.push(bsDirs, direction)
        array.push(bsBornBars, bar_index)
        f_trimBs()
        created := true
    created

f_updateBs() =>
    int i = array.size(bsBoxes) - 1
    while i >= 0
        float zoneTop = array.get(bsTops, i)
        float zoneBottom = array.get(bsBottoms, i)
        int direction = array.get(bsDirs, i)
        int bornBar = array.get(bsBornBars, i)
        bool invalid = direction == 1 ? (invalidateBy == "Close" ? close < zoneBottom : low < zoneBottom) : (invalidateBy == "Close" ? close > zoneTop : high > zoneTop)
        if invalid or f_isExpired(bornBar)
            f_deleteBs(i)
        i -= 1

bool bullishZoneSignal = showBuySellZones and barstate.isconfirmed and close[1] < open[1] and close > open and close > high[1] and currentBody >= currentAtr * zoneDispAtr
bool bearishZoneSignal = showBuySellZones and barstate.isconfirmed and close[1] > open[1] and close < open and close < low[1] and currentBody >= currentAtr * zoneDispAtr

bool newBuyZoneCreated = false
bool newSellZoneCreated = false

if bullishZoneSignal
    newBuyZoneCreated := f_addBs(1)
if bearishZoneSignal
    newSellZoneCreated := f_addBs(-1)

f_updateBs()

// ============================================================================
// SESSION HIGHS AND LOWS
// ============================================================================

var sessionLines = array.new_line()
var sessionLabels = array.new_label()

f_trimSessionObjects() =>
    int maximumObjects = sessionHistoryDays * 6
    while array.size(sessionLines) > maximumObjects
        line.delete(array.shift(sessionLines))
    while array.size(sessionLabels) > maximumObjects
        label.delete(array.shift(sessionLabels))

bool useSessionLogic = showSessions and timeframe.isintraday
bool inAsia = useSessionLogic and not na(time(timeframe.period, asiaSession, sessionTimeZone))
bool inLondon = useSessionLogic and not na(time(timeframe.period, londonSession, sessionTimeZone))
bool inNewYork = useSessionLogic and not na(time(timeframe.period, newYorkSession, sessionTimeZone))

var float asiaHigh = na
var float asiaLow = na
var int asiaStartTime = na
var line asiaHighLine = na
var line asiaLowLine = na
var label asiaHighLabel = na
var label asiaLowLabel = na

bool asiaStart = inAsia and not inAsia[1]
if asiaStart
    asiaHigh := high
    asiaLow := low
    asiaStartTime := time
    asiaHighLine := line.new(x1 = time, y1 = asiaHigh, x2 = time_close, y2 = asiaHigh, xloc = xloc.bar_time, color = asiaColor, style = line.style_dashed)
    asiaLowLine := line.new(x1 = time, y1 = asiaLow, x2 = time_close, y2 = asiaLow, xloc = xloc.bar_time, color = asiaColor, style = line.style_dashed)
    asiaHighLabel := label.new(x = time_close, y = asiaHigh, text = "Asia H", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(asiaColor, 20), textcolor = color.white, size = size.tiny)
    asiaLowLabel := label.new(x = time_close, y = asiaLow, text = "Asia L", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(asiaColor, 20), textcolor = color.white, size = size.tiny)
    array.push(sessionLines, asiaHighLine)
    array.push(sessionLines, asiaLowLine)
    array.push(sessionLabels, asiaHighLabel)
    array.push(sessionLabels, asiaLowLabel)
    f_trimSessionObjects()
if inAsia
    asiaHigh := math.max(nz(asiaHigh, high), high)
    asiaLow := math.min(nz(asiaLow, low), low)
    line.set_xy1(asiaHighLine, asiaStartTime, asiaHigh)
    line.set_xy2(asiaHighLine, time_close, asiaHigh)
    line.set_xy1(asiaLowLine, asiaStartTime, asiaLow)
    line.set_xy2(asiaLowLine, time_close, asiaLow)
    label.set_xy(asiaHighLabel, time_close, asiaHigh)
    label.set_xy(asiaLowLabel, time_close, asiaLow)

var float londonHigh = na
var float londonLow = na
var int londonStartTime = na
var line londonHighLine = na
var line londonLowLine = na
var label londonHighLabel = na
var label londonLowLabel = na

bool londonStart = inLondon and not inLondon[1]
if londonStart
    londonHigh := high
    londonLow := low
    londonStartTime := time
    londonHighLine := line.new(x1 = time, y1 = londonHigh, x2 = time_close, y2 = londonHigh, xloc = xloc.bar_time, color = londonColor, style = line.style_dashed)
    londonLowLine := line.new(x1 = time, y1 = londonLow, x2 = time_close, y2 = londonLow, xloc = xloc.bar_time, color = londonColor, style = line.style_dashed)
    londonHighLabel := label.new(x = time_close, y = londonHigh, text = "London H", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(londonColor, 20), textcolor = color.white, size = size.tiny)
    londonLowLabel := label.new(x = time_close, y = londonLow, text = "London L", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(londonColor, 20), textcolor = color.white, size = size.tiny)
    array.push(sessionLines, londonHighLine)
    array.push(sessionLines, londonLowLine)
    array.push(sessionLabels, londonHighLabel)
    array.push(sessionLabels, londonLowLabel)
    f_trimSessionObjects()
if inLondon
    londonHigh := math.max(nz(londonHigh, high), high)
    londonLow := math.min(nz(londonLow, low), low)
    line.set_xy1(londonHighLine, londonStartTime, londonHigh)
    line.set_xy2(londonHighLine, time_close, londonHigh)
    line.set_xy1(londonLowLine, londonStartTime, londonLow)
