// ============================================================================
// MULTI-TIMEFRAME STRUCTURE DASHBOARD
// ============================================================================

f_structureBias(int length) =>
    float pHigh = ta.pivothigh(high, length, length)
    float pLow = ta.pivotlow(low, length, length)
    float swingHigh = ta.valuewhen(not na(pHigh), pHigh, 0)
    float swingLow = ta.valuewhen(not na(pLow), pLow, 0)
    bool bullEvent = not na(swingHigh) and close > swingHigh and close[1] <= swingHigh
    bool bearEvent = not na(swingLow) and close < swingLow and close[1] >= swingLow
    int lastBullBar = ta.valuewhen(bullEvent, bar_index, 0)
    int lastBearBar = ta.valuewhen(bearEvent, bar_index, 0)
    int result = 0
    if not na(lastBullBar) or not na(lastBearBar)
        result := nz(lastBullBar, -1) > nz(lastBearBar, -1) ? 1 : nz(lastBearBar, -1) > nz(lastBullBar, -1) ? -1 : 0
    result

f_biasText(int biasValue) =>
    biasValue == 1 ? "Bullish" : biasValue == -1 ? "Bearish" : "Neutral"

f_biasColor(int biasValue) =>
    biasValue == 1 ? color.new(color.green, 65) : biasValue == -1 ? color.new(color.red, 65) : color.new(color.gray, 70)

// The dashboard requests are unconditional global calculations. request.security()
// returns the latest available requested-timeframe value and avoids invalid
// request.security_lower_tf() calls when the chart is below a dashboard timeframe.
int biasD = request.security(syminfo.tickerid, "1D", f_structureBias(dashSwingLen), lookahead = barmerge.lookahead_off)
int biasH4 = request.security(syminfo.tickerid, "240", f_structureBias(dashSwingLen), lookahead = barmerge.lookahead_off)
int biasH1 = request.security(syminfo.tickerid, "60", f_structureBias(dashSwingLen), lookahead = barmerge.lookahead_off)
int biasM30 = request.security(syminfo.tickerid, "30", f_structureBias(dashSwingLen), lookahead = barmerge.lookahead_off)
int biasM15 = request.security(syminfo.tickerid, "15", f_structureBias(dashSwingLen), lookahead = barmerge.lookahead_off)

var table dashboard = table.new(position.top_right, 2, 6, bgcolor = color.new(color.black, 15), frame_color = color.gray, frame_width = 1, border_color = color.new(color.gray, 40), border_width = 1)

if barstate.islast
    if showDashboard
        table.cell(dashboard, 0, 0, "Timeframe", text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(dashboard, 1, 0, "Structure Bias", text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(dashboard, 0, 1, "D", text_color = color.white)
        table.cell(dashboard, 1, 1, f_biasText(biasD), text_color = color.white, bgcolor = f_biasColor(biasD))
        table.cell(dashboard, 0, 2, "H4", text_color = color.white)
        table.cell(dashboard, 1, 2, f_biasText(biasH4), text_color = color.white, bgcolor = f_biasColor(biasH4))
        table.cell(dashboard, 0, 3, "H1", text_color = color.white)
        table.cell(dashboard, 1, 3, f_biasText(biasH1), text_color = color.white, bgcolor = f_biasColor(biasH1))
        table.cell(dashboard, 0, 4, "M30", text_color = color.white)
        table.cell(dashboard, 1, 4, f_biasText(biasM30), text_color = color.white, bgcolor = f_biasColor(biasM30))
        table.cell(dashboard, 0, 5, "M15", text_color = color.white)
        table.cell(dashboard, 1, 5, f_biasText(biasM15), text_color = color.white, bgcolor = f_biasColor(biasM15))
    else
        table.clear(dashboard, 0, 0, 1, 5)

