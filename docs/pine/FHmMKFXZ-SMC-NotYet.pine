var float newYorkHigh = na
var float newYorkLow = na
var int newYorkStartTime = na
var line newYorkHighLine = na
var line newYorkLowLine = na
var label newYorkHighLabel = na
var label newYorkLowLabel = na

bool newYorkStart = inNewYork and not inNewYork[1]
if newYorkStart
    newYorkHigh := high
    newYorkLow := low
    newYorkStartTime := time
    newYorkHighLine := line.new(x1 = time, y1 = newYorkHigh, x2 = time_close, y2 = newYorkHigh, xloc = xloc.bar_time, color = newYorkColor, style = line.style_dashed)
    newYorkLowLine := line.new(x1 = time, y1 = newYorkLow, x2 = time_close, y2 = newYorkLow, xloc = xloc.bar_time, color = newYorkColor, style = line.style_dashed)
    newYorkHighLabel := label.new(x = time_close, y = newYorkHigh, text = "New York H", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(newYorkColor, 20), textcolor = color.white, size = size.tiny)
    newYorkLowLabel := label.new(x = time_close, y = newYorkLow, text = "New York L", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(newYorkColor, 20), textcolor = color.white, size = size.tiny)
    array.push(sessionLines, newYorkHighLine)
    array.push(sessionLines, newYorkLowLine)
    array.push(sessionLabels, newYorkHighLabel)
    array.push(sessionLabels, newYorkLowLabel)
