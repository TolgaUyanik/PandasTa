    //                         line_central_new_index := 0
    //         else if (local_second_line_seq.type_ == 2)
    //             if (local_last_line_seq.end_.data_mid.high_ > local_second_line_seq.start_.data_mid.high_)
    //                 local_first_line_seq = line_seq_array.get(-3)
    //                 if (local_first_line_seq.start_.data_mid.low_ < local_second_line_seq.end_.data_mid.low_)
    //                     //检查修改后是否会产生缺口
    //                     tmp_begin_index = global_begin_seq_pen_index
    //                     if (line_seq_array.size() > 3)
    //                         tmp_begin_index := line_seq_array.get(-4).pen_index_ + 1
    //                     tmp_repire_gap_flag = has_line_seq_gap(1, tmp_begin_index, local_last_line_seq.pen_index_)

