//@version=6
indicator("たぬきつねスコア", overlay=false)

// -----------------------------------------------------------------------------
// 関数定義
// -----------------------------------------------------------------------------
safe_div(num, den) =>
    den != 0 ? num / den : 0

// 履歴取得（売上高の変化をトリガーにして正確に過去の四半期データを取得する安全版）
get_fq_hist(src, trig) =>
    // v6の厳密なブール評価に対応するため、naを0に変換してから比較
    is_change = nz(ta.change(trig)) != 0
    v_curr = src
    v_q1   = ta.valuewhen(is_change, src[1], 0) // 前四半期
    v_q4   = ta.valuewhen(is_change, src[1], 3) // 前年同期
    v_q5   = ta.valuewhen(is_change, src[1], 4) // 前年同期の1つ前
    [v_curr, v_q1, v_q4, v_q5]

get_prev_fy(val) =>
    var float prev = na
    if val != val[1] and not na(val)
        prev := val[1]
    prev

get_3_prev_fy(val) =>
    var float p1 = na
    var float p2 = na
    var float p3 = na
    if val != val[1] and not na(val)
        p3 := p2
        p2 := p1
        p1 := val[1]
    [p1, p2, p3]

// -----------------------------------------------------------------------------
// データ取得 (年次データ)
// -----------------------------------------------------------------------------
TSO = request.financial(syminfo.tickerid, "TOTAL_SHARES_OUTSTANDING", "FY")

rev_fy = request.financial(syminfo.tickerid, "TOTAL_REVENUE", "FY")
assets_fy = request.financial(syminfo.tickerid, "TOTAL_ASSETS", "FY")
equity_fy = request.financial(syminfo.tickerid, "TOTAL_EQUITY", "FY")
liab_fy = request.financial(syminfo.tickerid, "TOTAL_LIABILITIES", "FY")
debt_fy = request.financial(syminfo.tickerid, "TOTAL_DEBT", "FY")
sga_fy_raw = request.financial(syminfo.tickerid, "SELL_GEN_ADMIN_EXP_TOTAL", "FY")
gp_fy = request.financial(syminfo.tickerid, "GROSS_PROFIT", "FY")
cogs_fy_raw = request.financial(syminfo.tickerid, "COST_OF_GOODS", "FY")
dep_fy_raw = request.financial(syminfo.tickerid, "DEP_AMORT_EXP_INCOME_S", "FY")
rd_fy_raw = request.financial(syminfo.tickerid, "RESEARCH_AND_DEV", "FY")
minority_fy_raw = request.financial(syminfo.tickerid, "MINORITY_INTEREST_EXP", "FY")
retained_fy = request.financial(syminfo.tickerid, "RETAINED_EARNINGS", "FY")
st_debt_fy = request.financial(syminfo.tickerid, "SHORT_TERM_DEBT_EXCL_CURRENT_PORT", "FY")
ap_fy = request.financial(syminfo.tickerid, "ACCOUNTS_PAYABLE", "FY")
inv_fy = request.financial(syminfo.tickerid, "TOTAL_INVENTORY", "FY")
cash_fy = request.financial(syminfo.tickerid, "CASH_N_SHORT_TERM_INVEST", "FY")
emp_fy = request.financial(syminfo.tickerid, "NUMBER_OF_EMPLOYEES", "FY")
div_fy = request.financial(syminfo.tickerid, "TOTAL_CASH_DIVIDENDS_PAID", "FY")
buyback_fy = request.financial(syminfo.tickerid, "PURCHASE_OF_STOCK", "FY")
def_inc_curr_fy = request.financial(syminfo.tickerid, "DEFERRED_INCOME_CURRENT", "FY")
def_inc_non_curr_fy = request.financial(syminfo.tickerid, "DEFERRED_INCOME_NON_CURRENT", "FY")

// -----------------------------------------------------------------------------
// 年次スコア計算
// -----------------------------------------------------------------------------
sga_fy = math.abs(nz(sga_fy_raw))
cogs_fy = math.abs(nz(cogs_fy_raw))
dep_fy = math.abs(nz(dep_fy_raw))
rd_fy = math.abs(nz(rd_fy_raw))
minority_fy = math.abs(nz(minority_fy_raw))
shareholder_return_fy = math.abs(nz(div_fy)) + math.abs(nz(buyback_fy))
cogs_ex_dep_fy = math.max(0, cogs_fy - dep_fy)
def_rev_fy = nz(def_inc_curr_fy) + nz(def_inc_non_curr_fy)
op_assets_fy = assets_fy - nz(cash_fy)
op_liab_fy = liab_fy - nz(debt_fy)
noa_fy = op_assets_fy - op_liab_fy

s_large_1 = safe_div(rd_fy, assets_fy) > get_prev_fy(safe_div(rd_fy, assets_fy)) ? 1 : 0
s_large_2 = safe_div(st_debt_fy, rev_fy) < get_prev_fy(safe_div(st_debt_fy, rev_fy)) ? 1 : 0
s_large_3 = safe_div(shareholder_return_fy, rev_fy) > get_prev_fy(safe_div(shareholder_return_fy, rev_fy)) ? 1 : 0
s_large_4 = safe_div(shareholder_return_fy, assets_fy) > get_prev_fy(safe_div(shareholder_return_fy, assets_fy)) ? 1 : 0
r_l5 = safe_div(retained_fy, assets_fy)
[pl5_1, pl5_2, pl5_3] = get_3_prev_fy(r_l5)
s_large_5 = (r_l5 > pl5_1) and (pl5_1 > pl5_2) and (pl5_2 > pl5_3) ? 1 : 0
r_l6 = safe_div(retained_fy, rev_fy)
[pl6_1, pl6_2, pl6_3] = get_3_prev_fy(r_l6)
s_large_6 = (r_l6 > pl6_1) and (pl6_1 > pl6_2) and (pl6_2 > pl6_3) ? 1 : 0
s_large_7 = safe_div(minority_fy, rev_fy) > get_prev_fy(safe_div(minority_fy, rev_fy)) ? 1 : 0
s_large_8 = safe_div(cogs_ex_dep_fy, rev_fy) < get_prev_fy(safe_div(cogs_ex_dep_fy, rev_fy)) ? 1 : 0
s_large_9 = safe_div(gp_fy, assets_fy) > get_prev_fy(safe_div(gp_fy, assets_fy)) ? 1 : 0
s_large_10 = safe_div(ap_fy + def_rev_fy, rev_fy) < get_prev_fy(safe_div(ap_fy + def_rev_fy, rev_fy)) ? 1 : 0
score_large_total = s_large_1 + s_large_2 + s_large_3 + s_large_4 + s_large_5 + s_large_6 + s_large_7 + s_large_8 + s_large_9 + s_large_10

s_small_1 = safe_div(sga_fy, assets_fy) > get_prev_fy(safe_div(sga_fy, assets_fy)) ? 1 : 0
s_small_2 = safe_div(rd_fy, assets_fy) > get_prev_fy(safe_div(rd_fy, assets_fy)) ? 1 : 0
val_gp_per_emp = safe_div(gp_fy, emp_fy)
s_small_3 = (emp_fy > get_prev_fy(emp_fy)) and (val_gp_per_emp > get_prev_fy(val_gp_per_emp)) ? 1 : 0
s_small_4 = safe_div(assets_fy, rev_fy) < get_prev_fy(safe_div(assets_fy, rev_fy)) ? 1 : 0
s_small_5 = safe_div(noa_fy, rev_fy) < get_prev_fy(safe_div(noa_fy, rev_fy)) ? 1 : 0
s_small_6 = safe_div(st_debt_fy, rev_fy) < get_prev_fy(safe_div(st_debt_fy, rev_fy)) ? 1 : 0
s_small_7 = safe_div(inv_fy, rev_fy) < get_prev_fy(safe_div(inv_fy, rev_fy)) ? 1 : 0
s_small_8 = safe_div(cogs_ex_dep_fy, equity_fy) < get_prev_fy(safe_div(cogs_ex_dep_fy, equity_fy)) ? 1 : 0
s_small_9 = dep_fy > get_prev_fy(dep_fy) ? 1 : 0
s_small_10 = safe_div(ap_fy, rev_fy) < get_prev_fy(safe_div(ap_fy, rev_fy)) ? 1 : 0
score_small_total = s_small_1 + s_small_2 + s_small_3 + s_small_4 + s_small_5 + s_small_6 + s_small_7 + s_small_8 + s_small_9 + s_small_10


// -----------------------------------------------------------------------------
// 【究極アルファ版】四半期モメンタムスコア計算 (10点満点)
// -----------------------------------------------------------------------------

// --- 四半期データ取得 ---
rev_fq = request.financial(syminfo.tickerid, "TOTAL_REVENUE", "FQ")
gp_fq = request.financial(syminfo.tickerid, "GROSS_PROFIT", "FQ")
sga_fq = request.financial(syminfo.tickerid, "SELL_GEN_ADMIN_EXP_TOTAL", "FQ")
st_debt_fq = request.financial(syminfo.tickerid, "SHORT_TERM_DEBT", "FQ")
fcf_fq = request.financial(syminfo.tickerid, "FREE_CASH_FLOW", "FQ")
rec_fq = request.financial(syminfo.tickerid, "TOTAL_RECEIVABLES_NET", "FQ")
inv_fq_fq = request.financial(syminfo.tickerid, "TOTAL_INVENTORY", "FQ")
sloan_fq = request.financial(syminfo.tickerid, "SLOAN_RATIO", "FQ")

// mROIC用のBS項目 (FQ)
tot_assets_fq = request.financial(syminfo.tickerid, "TOTAL_ASSETS", "FQ")
cash_eq_fq    = request.financial(syminfo.tickerid, "CASH_N_SHORT_TERM_INVEST", "FQ")
tot_liab_fq   = request.financial(syminfo.tickerid, "TOTAL_LIABILITIES", "FQ")
tot_debt_fq   = request.financial(syminfo.tickerid, "TOTAL_DEBT", "FQ")

// --- 派生指標の計算 ---
// mROIC
op_assets_fq_val = nz(tot_assets_fq) - nz(cash_eq_fq)
op_liab_fq_val = nz(tot_liab_fq) - nz(tot_debt_fq)
noa_fq = op_assets_fq_val - op_liab_fq_val
mroic_fq = safe_div(nz(gp_fq), noa_fq)

// 粗利率
gp_margin = safe_div(gp_fq, rev_fq)

// --- 履歴データの取得 (rev_fqをトリガーとして同期) ---
[rev_curr, rev_q1, rev_q4, rev_q5] = get_fq_hist(nz(rev_fq), rev_fq)
[gp_curr, gp_q1, gp_q4, gp_q5]     = get_fq_hist(nz(gp_fq), rev_fq)
[gm_curr, gm_q1, gm_q4, gm_q5]     = get_fq_hist(gp_margin, rev_fq)
[sga_curr, sga_q1, sga_q4, sga_q5] = get_fq_hist(nz(sga_fq), rev_fq)
[std_curr, std_q1, std_q4, std_q5] = get_fq_hist(nz(st_debt_fq), rev_fq)
[rec_curr, rec_q1, rec_q4, rec_q5] = get_fq_hist(nz(rec_fq), rev_fq)
[inv_curr, inv_q1, inv_q4, inv_q5] = get_fq_hist(nz(inv_fq_fq), rev_fq)

// 追加した高度指標
[mroic_curr, mroic_q1, mroic_q4, mroic_q5] = get_fq_hist(mroic_fq, rev_fq)
[sloan_curr, sloan_q1, sloan_q4, sloan_q5] = get_fq_hist(nz(sloan_fq), rev_fq)

// キャッシュフローと時価総額
fcf_net_debt = nz(fcf_fq) - nz(st_debt_fq)
[fcfn_curr, fcfn_q1, fcfn_q4, fcfn_q5] = get_fq_hist(fcf_net_debt, rev_fq)

mcap_series = nz(TSO) * close
[mcap_curr, mcap_q1, mcap_q4, mcap_q5] = get_fq_hist(mcap_series, rev_fq)


// --- 10項目のスコアロジック ---

// ① 粗利益率の前年同期比増加
gm_diff_0 = gm_curr - gm_q4
q_score_1 = gm_diff_0 > 0 ? 1 : 0

// ② 粗利益率の前年同期比の２連続増加 かつ 前回よりも増加幅が大きい (加速)
gm_diff_1 = gm_q1 - gm_q5
q_score_2 = (gm_diff_0 > 0 and gm_diff_1 > 0 and gm_diff_0 > gm_diff_1) ? 1 : 0

// ③ 粗利益/時価総額 が前年同期比増加
gp_yield_curr = safe_div(gp_curr, mcap_curr)
gp_yield_q4   = safe_div(gp_q4, mcap_q4)
gp_yield_diff_0 = gp_yield_curr - gp_yield_q4
q_score_3 = gp_yield_diff_0 > 0 ? 1 : 0

// ④ 粗利益/時価総額 が前年同期比で２連続増加、かつ増加幅が前回よりも大きい (加速)
gp_yield_q1 = safe_div(gp_q1, mcap_q1)
gp_yield_q5 = safe_div(gp_q5, mcap_q5)
gp_yield_diff_1 = gp_yield_q1 - gp_yield_q5
q_score_4 = (gp_yield_diff_0 > 0 and gp_yield_diff_1 > 0 and gp_yield_diff_0 > gp_yield_diff_1) ? 1 : 0

// ⑤ mROICの前年同期比増加 (資本効率の改善)
q_score_5 = mroic_curr > mroic_q4 ? 1 : 0

// ⑥ スローン比率の減少 (利益の質向上、粉飾リスク低下)
// スローン比率は低いほど（マイナスに近いほど）アクルーアルが少なく良質
q_score_6 = sloan_curr < sloan_q4 ? 1 : 0

// ⑦ 販管費の前年同期比増加 かつ 粗利益/販管費が前年同期比増加
gp_sga_curr = safe_div(gp_curr, sga_curr)
gp_sga_q4   = safe_div(gp_q4, sga_q4)
q_score_7 = (sga_curr > sga_q4 and gp_sga_curr > gp_sga_q4) ? 1 : 0

// ⑧ 短期借入金/売上高の前年同期比減少 かつ 短期借入金が前年同期比減少
std_ratio_curr = safe_div(std_curr, rev_curr)
std_ratio_q4   = safe_div(std_q4, rev_q4)
q_score_8 = (std_curr < std_q4 and std_ratio_curr < std_ratio_q4) ? 1 : 0

// ⑨ (売掛金＋在庫)/売上高 が前年同期比で減少 かつ 売上高が前年同期比で増加
wc_curr = rec_curr + inv_curr
wc_q4   = rec_q4 + inv_q4
wc_ratio_curr = safe_div(wc_curr, rev_curr)
wc_ratio_q4   = safe_div(wc_q4, rev_q4)
q_score_9 = (wc_ratio_curr < wc_ratio_q4 and rev_curr > rev_q4) ? 1 : 0

// ⑩ (FCF-短期借入金)/時価総額 が前年同期比よりも増加
fcfn_yield_curr = safe_div(fcfn_curr, mcap_curr)
fcfn_yield_q4   = safe_div(fcfn_q4, mcap_q4)
q_score_10 = fcfn_yield_curr > fcfn_yield_q4 ? 1 : 0

// 合計
score_momentum_total = q_score_1 + q_score_2 + q_score_3 + q_score_4 + q_score_5 + q_score_6 + q_score_7 + q_score_8 + q_score_9 + q_score_10

// -----------------------------------------------------------------------------
// プロット
// -----------------------------------------------------------------------------
plot(score_large_total, title="年次スコア(大型)", color=color.new(color.blue, 50), linewidth=3)
plot(score_small_total, title="年次スコア(小型)", color=color.new(color.gray, 50), linewidth=3)

color_mom = score_momentum_total >= 7 ? #00E676 : score_momentum_total >= 4 ? #FFEB3B : #F44336
plot(score_momentum_total, title="四半期モメンタム", color=color_mom, linewidth=3)

hline(10, "満点", color=color.gray, linestyle=hline.style_dotted)
hline(5, "中間点", color=color.gray, linestyle=hline.style_dotted)

// -----------------------------------------------------------------------------
// テーブル表示
// -----------------------------------------------------------------------------
var table labelTable = table.new(position.bottom_left, 2, 1)
if barstate.islast
    MarketCap = TSO * close
    mcap_yen = MarketCap / 100000000
    
    // 時価総額表示
    table.cell(labelTable, 0, 0, "時価総額: " + str.tostring(math.round(mcap_yen)) + "億円", text_color=color.white)

    // スコア詳細表示
    details = "モメンタムスコア:\n" +
              "粗利率 増 : " + (q_score_1 > 0 ? "〇" : "×") + "  粗利/時 増: " + (q_score_3 > 0 ? "〇" : "×") + "\n" +
              "粗利率 加 : " + (q_score_2 > 0 ? "〇" : "×") + "  粗利/時 加: " + (q_score_4 > 0 ? "〇" : "×") + "\n" +
              "mROIC 善  : " + (q_score_5 > 0 ? "〇" : "×") + "  スローン減: " + (q_score_6 > 0 ? "〇" : "×") + "\n" +
              "販管比 善 : " + (q_score_7 > 0 ? "〇" : "×") + "  借金比 減 : " + (q_score_8 > 0 ? "〇" : "×") + "\n" +
              "売掛在庫減: " + (q_score_9 > 0 ? "〇" : "×") + "  FCF利 増 : " + (q_score_10 > 0 ? "〇" : "×")
    
    // 背景色: 7点以上で青（基準が厳しいので7点で優秀）、3点以下で赤
    bg_col = score_momentum_total >= 7 ? color.new(color.blue, 60) : score_momentum_total <= 3 ? color.new(color.red, 60) : color.new(color.black, 60)
    
    table.cell(labelTable, 1, 0, details, bgcolor=bg_col, text_color=color.white, text_size=size.small)