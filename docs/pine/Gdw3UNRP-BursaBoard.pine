//@version=6
// @description Library untuk menyimpan kategori pasaran Bursa Malaysia (Main Market & ACE Market)
library('BursaBoard', true)

// History:
// 20260610 - Update ACE until IPO Jun 2026

// @function Menentukan sama ada saham adalah ACE Market
// @param ticker Nama simbol tanpa prefix (e.g., "GENETEC")
// @returns string Kategori pasaran ("ACE" atau "MAIN")
// Ref: https://www.isaham.my/ipo

export get_market_type(string ticker) =>
    string result = "MAIN" // Default adalah Main Market
    
    // Buang perkataan selepas "-" untuk waran
    string[] tickerSplit = str.split(ticker, "-")
    string baseTicker = array.get(tickerSplit, 0)
    
    // Gunakan switch untuk kelajuan carian (O(1) average)
    // Masukkan senarai dari Excel anda di sini
    switch baseTicker
        "ALPHA" => result := "ACE"
        "SBS" => result := "ACE"
        "IAB" => result := "ACE"
        "MCLEAN" => result := "ACE"
        "SSB8" => result := "ACE"
        "VANZO" => result := "ACE"
        "HAWK" => result := "ACE"
        "SMRT" => result := "ACE"
        "MNHLDG" => result := "ACE"
        "PWRWELL" => result := "ACE"
        "CBHB" => result := "ACE"
        "KENERGY" => result := "ACE"
        "DFX" => result := "ACE"
