//@version=6
indicator('BARTRADINGPREDV4', overlay = true)

// User input for lookback period
inputLookback = input.int(title = 'Number of Lookback Bars', defval = 50)
predictionLength = input.int(title = 'Prediction Length', defval = 10) // Not used anymore, kept for backward compatibility

// User inputs for enabling/disabling XBS and XSB signals
enableXSB = input.bool(title = 'TURN ON OR OFF XSB Signal', defval = true)
enableXBS = input.bool(title = 'TURN ON OR OFF XBS Signal', defval = true)

// User input for RSI filter
rsiFilter = input.bool(title = 'Enable RSI Filter', defval = true)
rsiPeriod = input.int(title = 'RSI Period', defval = 14)

// User input for table position
tablePosOpt = input.string(title = 'Table Position', defval = 'Top Right', options = ['Top Left', 'Top Center', 'Top Right', 'Middle Left', 'Middle Center', 'Middle Right', 'Bottom Left', 'Bottom Center', 'Bottom Right'])


// Helper to convert string to position constant
f_getTablePos(posStr) =>
    posStr == 'Top Left' ? position.top_left : posStr == 'Top Center' ? position.top_center : posStr == 'Top Right' ? position.top_right : posStr == 'Middle Left' ? position.middle_left : posStr == 'Middle Center' ? position.middle_center : posStr == 'Middle Right' ? position.middle_right : posStr == 'Bottom Left' ? position.bottom_left : posStr == 'Bottom Center' ? position.bottom_center : posStr == 'Bottom Right' ? position.bottom_right : position.top_right


// Calculate HMA and LMA
HMA = ta.sma(high, inputLookback)
LMA = ta.sma(low, inputLookback)

// Calculate HLMA
HLMA = (HMA + LMA) / 2

// Plot HMA, LMA, and HLMA
plot(HMA, color = color.new(color.green, 0), title = 'HMA')
plot(LMA, color = color.new(color.red, 0), title = 'LMA')
plot(HLMA, color = color.new(color.blue, 0), title = 'HLMA')

// Calculate HL2 (average of high, low, close, and open)
HL2 = (open + high + low + close) / 4

// Calculate RSI
rsi = ta.rsi(close, rsiPeriod)

// Calculate up volume and down volume
upVolume = volume * (close > open ? 1 : 0)
downVolume = volume * (close < open ? 1 : 0)

// Calculate BUY and SELL signals
buySignal = ta.crossover(HL2, LMA) and (rsiFilter ? rsi > 50 : true)
sellSignal = ta.crossunder(HL2, HMA) and (rsiFilter ? rsi < 50 : true)

// Enhanced conditions for XSB and XBS signals with volume
xsbSignal = ta.crossover(HL2, HMA) and HL2 > HLMA and upVolume > downVolume and (rsiFilter ? rsi > 50 : true)
xbsSignal = ta.crossunder(HL2, LMA) and HL2 < HLMA and downVolume > upVolume and (rsiFilter ? rsi < 50 : true)

// Plot BUY and SELL signals
plotshape(series = buySignal, title = 'BUY Signal', location = location.belowbar, color = color.new(color.green, 0), style = shape.labelup, text = 'B', textcolor = color.new(color.white, 0))
plotshape(series = sellSignal, title = 'SELL Signal', location = location.abovebar, color = color.new(color.red, 0), style = shape.labeldown, text = 'S', textcolor = color.new(color.white, 0))

// Plot XSB and XBS signals based on user input
plotshape(series = enableXSB and xsbSignal, title = 'XSB Signal', location = location.belowbar, color = color.new(color.blue, 0), style = shape.labelup, text = 'XSB', textcolor = color.new(color.white, 0))
plotshape(series = enableXBS and xbsSignal, title = 'XBS Signal', location = location.abovebar, color = color.new(color.orange, 0), style = shape.labeldown, text = 'XBS', textcolor = color.new(color.white, 0))

// Calculate TP and SL prices
tpPrice = HL2 + HMA - LMA
slPrice = HL2 - (HMA - LMA)

// Plot TP and SL prices
plot(tpPrice, title = 'TP Price', color = color.new(color.purple, 0), style = plot.style_line)
plot(slPrice, title = 'SL Price', color = color.new(color.purple, 0), style = plot.style_line)

// ------------------- REALISTIC PREDICTION CHANNEL -------------------

// Calculate Linear Regression Line
regLine = ta.linreg(close, inputLookback, 0)
atrLen = input.int(14, 'ATR Length for Prediction Channel')
mult = input.float(1.0, 'ATR Multiplier')
atr = ta.atr(atrLen)

// Plot regression line and a realistic prediction channel
plot(regLine, color = color.yellow, linewidth = 2, title = 'Regression Line')
plot(regLine + mult * atr, color = color.new(color.yellow, 70), style = plot.style_linebr, title = 'Regression Upper')
plot(regLine - mult * atr, color = color.new(color.yellow, 70), style = plot.style_linebr, title = 'Regression Lower')

// ------------------- FORWARD-PROJECTED REGRESSION LINE -------------------
barsForward = input.int(5, 'Bars Forward (Projection)', minval = 1, maxval = 15)
slope = regLine - regLine[1]

// Draw the projection as a line from the last bar to N bars forward
var line projLine = na


f_reset_and_create_line(_line, _regLine, _barsForward, _slope) =>
    if not na(_line)
        line.delete(_line)
    line.new(x1 = bar_index, y1 = _regLine, x2 = bar_index + _barsForward, y2 = _regLine + _slope * _barsForward, color = color.fuchsia, width = 2, style = line.style_dashed, extend = extend.none)


if not na(regLine)
    projLine := f_reset_and_create_line(projLine, regLine, barsForward, slope)
    projLine

// ----------- Higher Highs/Lows and Lower Highs/Lows Logic (Corrected) -----------

// Pre-calculate previous highest and lowest values for conditions
prev_highest_high = ta.highest(high, 1)[1]
prev_highest_low = ta.highest(low, 1)[1]
prev_lowest_high = ta.lowest(high, 1)[1]
prev_lowest_low = ta.lowest(low, 1)[1]

// Calculate higher highs and higher lows
higherHighCondition = high > prev_highest_high and low > prev_highest_low
higherHighs = ta.valuewhen(higherHighCondition, high, 0)
higherLows = ta.valuewhen(higherHighCondition, low, 0)

// Calculate lower highs and lower lows
lowerHighCondition = high < prev_lowest_high and low < prev_lowest_low
lowerHighs = ta.valuewhen(lowerHighCondition, high, 0)
lowerLows = ta.valuewhen(lowerHighCondition, low, 0)

// Plot higher highs and higher lows
plotshape(series = high == higherHighs, title = 'Higher High', location = location.abovebar, color = color.new(color.green, 0), style = shape.triangleup, text = 'HH', textcolor = color.new(color.white, 0))
plotshape(series = low == higherLows, title = 'Higher Low', location = location.belowbar, color = color.new(color.green, 0), style = shape.triangleup, text = 'HL', textcolor = color.new(color.white, 0))

// Plot lower highs and lower lows
plotshape(series = high == lowerHighs, title = 'Lower High', location = location.abovebar, color = color.new(color.red, 0), style = shape.triangledown, text = 'LH', textcolor = color.new(color.white, 0))
plotshape(series = low == lowerLows, title = 'Lower Low', location = location.belowbar, color = color.new(color.red, 0), style = shape.triangledown, text = 'LL', textcolor = color.new(color.white, 0))

// -------------------- TABLE LOGIC --------------------

// Calculate differences
diff_HMA = close - HMA
diff_HLMA = close - HLMA
diff_LMA = close - LMA

// Function to get color based on comparison
f_getColor(diff) =>
    diff > 0 ? color.green : diff < 0 ? color.red : color.yellow

// Table only needs to be created once
var table myTable = table.new(f_getTablePos(tablePosOpt), 4, 2, border_width = 1)

// Table headers (static, blue text)
if barstate.isfirst
    table.cell(myTable, 0, 0, 'Price', bgcolor = color.white, text_color = color.blue)
    table.cell(myTable, 1, 0, 'vs HMA', bgcolor = color.white, text_color = color.blue)
    table.cell(myTable, 2, 0, 'vs HLMA', bgcolor = color.white, text_color = color.blue)
    table.cell(myTable, 3, 0, 'vs LMA', bgcolor = color.white, text_color = color.blue)

// Update values every bar
table.cell(myTable, 0, 1, str.tostring(close, format.mintick), bgcolor = color.white, text_color = color.blue)
table.cell(myTable, 1, 1, str.tostring(diff_HMA, format.mintick), bgcolor = color.white, text_color = f_getColor(diff_HMA))
table.cell(myTable, 2, 1, str.tostring(diff_HLMA, format.mintick), bgcolor = color.white, text_color = f_getColor(diff_HLMA))
table.cell(myTable, 3, 1, str.tostring(diff_LMA, format.mintick), bgcolor = color.white, text_color = f_getColor(diff_LMA))
