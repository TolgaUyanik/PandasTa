//@version=5
// @description TODO: add library description here
library("YP")


// Function to check if the low of the first bar of the current day is above the previousHigh
// @function breakUp: Determines if the low of the first bar of the current day
//      is above a given previous high.
// @param previousHigh: The previous high value to compare against.
// @returns: Boolean value indicating whether the condition is met (true) or not (false).
export breakUp(float previousHigh) =>
    isNewDay = ta.change(time("D")) != 0
    var float lowOfFirstBar = na
    if isNewDay
        lowOfFirstBar := open
    lowOfFirstBar > previousHigh

