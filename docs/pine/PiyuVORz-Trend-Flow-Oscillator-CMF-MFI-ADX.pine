// UPDATE: This indicator has been replaced
//I've significantly simplified and improved this concept. The "Pro" version became overly complex with features that didn't add real value.

//Check out the new Flow Control Oscillator (FCO) instead:
//https://www.tradingview.com/script/QHPp4Pdo-Flow-Control-Oscillator-FCO/

//The FCO keeps what worked (MFI + CMF + ADX weighting) and removes the unnecessary complexity. Cleaner, more reliable signals for intraday trading.


//@version=6
indicator(title="Trend Flow Oscillator (CMF + MFI) + ADX", shorttitle="TFO+ADX", overlay=false)

// === TFO INPUTS ===
mfiLen     = input.int(14, title="MFI Length",     minval=1)
cmfLen     = input.int(20, title="CMF Length",     minval=1)
src        = input.source(hlc3, title="Price Source")
smoothLen  = input.int(2,  title="TFO Smoothing", minval=1, maxval=10)

// === ADX INPUTS ===
adxLen     = input.int(14, title="ADX Smoothing")
diLen      = input.int(14, title="DI Length")

// === TFO CALCULATION ===
// 1) MFI scaled to –1…+1
mfi_raw = ta.mfi(src, mfiLen)
mfi     = (mfi_raw - 50.0) / 50.0

// 2) CMF (–1…+1)
ad = if high == low
    0.0
else
    ((2.0 * close - high - low) / (high - low)) * volume
cmf = math.sum(ad, cmfLen) / math.sum(volume, cmfLen)

// 3) Composite & optional smoothing
tfo_raw = cmf + mfi
tfo     = smoothLen > 1 ? ta.sma(tfo_raw, smoothLen) : tfo_raw

// === ADX CALCULATION ===
dirmov(len) =>
    up      = ta.change(high)
    down    = -ta.change(low)
    plusDM  = na(up)   ? na : (up > down and up > 0 ? up : 0)
    minusDM = na(down) ? na : (down > up and down > 0 ? down : 0)
    tr      = ta.rma(ta.tr, len)
    plus    = fixnan(100 * ta.rma(plusDM, len) / tr)
    minus   = fixnan(100 * ta.rma(minusDM, len) / tr)
    [plus, minus]

adx_calc(di, adxS) =>
    [p, m] = dirmov(di)
    sumDM  = p + m
    100 * ta.rma(math.abs(p - m) / (sumDM == 0 ? 1 : sumDM), adxS)

adx_raw  = adx_calc(diLen, adxLen)
// normalize ADX 0–100 → –1…+1
adx_norm = (adx_raw - 25) / 25
// constrain between -1 and 1
adx_clipped = math.max(-1, math.min(1, adx_norm))

// === COLOR LOGIC (your original) ===
tfo_color = tfo >= 0 ? (tfo > tfo[1] ? color.new(#46abe1, 20) : color.new(#1040df, 20)) : (tfo < tfo[1] ? color.new(color.red, 20) : color.new(color.maroon, 20))

// === PLOTTING & STYLES ===
// reference lines
hline( 0.0,  "Zero",  color=color.gray,         linestyle=hline.style_dashed)
hline( 0.7,  "Upper", color=color.new(color.gray,70))
hline(-0.7,  "Lower", color=color.new(color.gray,70))

// TFO line (with correct coloring)
plot(tfo, title="TFO", color=tfo_color, linewidth=2)

// ADX overlay
plot(adx_norm, title="ADX (scaled)", color=color.new(color.yellow, 0), linewidth=1)

// Subtle background for extreme zones 
bgcolor(math.abs(tfo) > 1.0 ? color.new(color.gray, 95) : na, title="Extreme Zones")

// hidden component plots
plot(cmf, title="CMF",        color=color.new(color.blue,   70), linewidth=1, display=display.none)
plot(mfi, title="MFI Scaled", color=color.new(color.orange, 70), linewidth=1, display=display.none)

