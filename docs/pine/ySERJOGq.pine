//@version=6
//@description LiliALHUNTERSystem_v2 – Powerful Pine Library for dynamic target creation, Supertrend/EMA-based projections, and visual dashboard management

library("LiliALHUNTERSystem_v2", overlay=true)

// ╔════════════════════════════════════╗
// ║        TYPE DEFINITIONS           ║
// ╚════════════════════════════════════╝
export type TargetConfig
    bool enableTarget1 = true
    bool enableTarget2 = true
    bool isLong1 = true
    bool isLong2 = false
    string target1Condition = "CrossOver"
    string target2Condition = "CrossUnder"
    color target1Color = #089981
    color target2Color = #f23645
    string target1Style = "- - -"
    string target2Style = "- - -"
    float distTarget1 = 3.0
    float distTarget2 = 3.0
    string distOptions1 = "ATR"
    string distOptions2 = "ATR"
    bool showLabels = true
    bool showDash = true

export type TargetState
    line target1LineV = na
    line target1LineH = na
    line target2LineV = na
    line target2LineH = na
    label target1Lbl = na
    label target2Lbl = na
    bool target1Active = false
    bool target2Active = false
    float target1Value = na
    float target2Value = na
    int countTargets1 = 0
    int countTgReached1 = 0
    int countTargets2 = 0
    int countTgReached2 = 0

// ╔════════════════════════════════════╗
// ║       INDICATOR CALCULATORS       ║
// ╚════════════════════════════════════╝
export ema_calc(int len, float source) => ta.ema(source, len)
export rma_calc(int len, float source) => ta.rma(source, len)

export supertrend_calc(int length, float factor) =>
    atr = ta.atr(length)
    up = hl2 + atr * factor
    dn = hl2 - atr * factor
    var float upper = up
    var float lower = dn
    var int trend = 1
    upper := close[1] < upper ? math.min(up, upper) : up
    lower := close[1] > lower ? math.max(dn, lower) : dn
    trend := close > upper ? 1 : close < lower ? 0 : trend
    trend == 1 ? lower : upper

// ╔════════════════════════════════════╗
// ║        TARGET DRAWING LOGIC       ║
// ╚════════════════════════════════════╝
export createTargets(TargetConfig config, TargetState state, float source1A, float source1B, float source2A, float source2B) =>
    atrVal = ta.atr(50)

    // cross conditions
    cross1 = ta.cross(source1A, source1B)
    crossOver1 = ta.crossover(source1A, source1B)
    crossUnder1 = ta.crossunder(source1A, source1B)

    cross2 = ta.cross(source2A, source2B)
    crossOver2 = ta.crossover(source2A, source2B)
    crossUnder2 = ta.crossunder(source2A, source2B)

    // condition logic
    target1_condition = switch config.target1Condition
        'CrossOver' => crossOver1
        'CrossUnder' => crossUnder1
        'Cross' => cross1
        'Equal' => source1A == source1B
        => false

    target2_condition = switch config.target2Condition
        'CrossOver' => crossOver2
        'CrossUnder' => crossUnder2
        'Cross' => cross2
        'Equal' => source2A == source2B
        => false

    // distance calculation
    dist1 = switch config.distOptions1
        'Currencies' => config.distTarget1
        '%' => close * config.distTarget1 / 100
        'ATR' => atrVal * config.distTarget1
        'Ticks' => syminfo.mintick * config.distTarget1
        => config.distTarget1

    dist2 = switch config.distOptions2
        'Currencies' => config.distTarget2
        '%' => close * config.distTarget2 / 100
        'ATR' => atrVal * config.distTarget2
        'Ticks' => syminfo.mintick * config.distTarget2
        => config.distTarget2

    // update active targets
    if state.target1Active and not na(state.target1LineH)
        line.set_x2(state.target1LineH, bar_index)
        if not na(state.target1Lbl)
            label.set_x(state.target1Lbl, bar_index)
            label.set_y(state.target1Lbl, state.target1Value)

    if state.target2Active and not na(state.target2LineH)
        line.set_x2(state.target2LineH, bar_index)
        if not na(state.target2Lbl)
            label.set_x(state.target2Lbl, bar_index)
            label.set_y(state.target2Lbl, state.target2Value)

    // hit logic
    if state.target1Active and (config.isLong1 ? high > state.target1Value : low < state.target1Value)
        state.target1Active := false
        state.countTgReached1 += 1
        if config.showLabels and not na(state.target1Lbl)
            label.set_color(state.target1Lbl, config.target1Color)

    if state.target2Active and (config.isLong2 ? high > state.target2Value : low < state.target2Value)
        state.target2Active := false
        state.countTgReached2 += 1
        if config.showLabels and not na(state.target2Lbl)
            label.set_color(state.target2Lbl, config.target2Color)

    // create new target 1
    if config.enableTarget1 and target1_condition
        state.target1Value := close + (config.isLong1 ? dist1 : -dist1)
        state.target1Active := true
        state.countTargets1 += 1

        if not na(state.target1LineV)
            line.delete(state.target1LineV)
        if not na(state.target1LineH)
            line.delete(state.target1LineH)
        if not na(state.target1Lbl)
            label.delete(state.target1Lbl)

        style1 = config.target1Style == '──' ? line.style_solid : config.target1Style == '- - -' ? line.style_dashed : line.style_dotted
        state.target1LineV := line.new(bar_index, close, bar_index, state.target1Value, color=config.target1Color, style=style1, xloc=xloc.bar_index)
        state.target1LineH := line.new(bar_index, state.target1Value, bar_index + 10, state.target1Value, color=config.target1Color, style=style1, xloc=xloc.bar_index)
        if config.showLabels
            state.target1Lbl := label.new(bar_index, state.target1Value, "Target 1", color=color.new(config.target1Color, 50), textcolor=color.white, size=size.tiny, xloc=xloc.bar_index, yloc=yloc.price)

    // create new target 2
    if config.enableTarget2 and target2_condition
        state.target2Value := close + (config.isLong2 ? dist2 : -dist2)
        state.target2Active := true
        state.countTargets2 += 1

        if not na(state.target2LineV)
            line.delete(state.target2LineV)
        if not na(state.target2LineH)
            line.delete(state.target2LineH)
        if not na(state.target2Lbl)
            label.delete(state.target2Lbl)

        style2 = config.target2Style == '──' ? line.style_solid : config.target2Style == '- - -' ? line.style_dashed : line.style_dotted
        state.target2LineV := line.new(bar_index, close, bar_index, state.target2Value, color=config.target2Color, style=style2, xloc=xloc.bar_index)
        state.target2LineH := line.new(bar_index, state.target2Value, bar_index + 10, state.target2Value, color=config.target2Color, style=style2, xloc=xloc.bar_index)
        if config.showLabels
            state.target2Lbl := label.new(bar_index, state.target2Value, "Target 2", color=color.new(config.target2Color, 50), textcolor=color.white, size=size.tiny, xloc=xloc.bar_index, yloc=yloc.price)

    state

// ╔════════════════════════════════════╗
// ║         DASHBOARD MODULE          ║
// ╚════════════════════════════════════╝
export showDashboard(TargetState state, string dashLoc = "Top Right", string textSize = "Normal") =>
    if barstate.islast
        table_position = dashLoc == 'Bottom Left' ? position.bottom_left : dashLoc == 'Top Right' ? position.top_right : position.bottom_right
        table_size = textSize == 'Tiny' ? size.tiny : textSize == 'Small' ? size.small : size.normal
        var tb = table.new(table_position, 3, 4, bgcolor=#1e222d, border_color=#373a46, border_width=1)
        table.cell(tb, 0, 0, "🎯 LILI AL HUNTER", text_color=color.white, text_size=table_size)
        table.cell(tb, 1, 0, "Count", text_color=color.white, text_size=table_size)
        table.cell(tb, 2, 0, "Hit", text_color=color.white, text_size=table_size)
        table.cell(tb, 0, 1, "Target 1", text_color=color.white, text_size=table_size)
        table.cell(tb, 1, 1, str.tostring(state.countTargets1), text_color=color.white, text_size=table_size)
        table.cell(tb, 2, 1, str.tostring(state.countTgReached1), text_color=color.lime, text_size=table_size)
        table.cell(tb, 0, 2, "Target 2", text_color=color.white, text_size=table_size)
        table.cell(tb, 1, 2, str.tostring(state.countTargets2), text_color=color.white, text_size=table_size)
        table.cell(tb, 2, 2, str.tostring(state.countTgReached2), text_color=color.red, text_size=table_size)
        table.cell(tb, 0, 3, "Total", text_color=color.white, text_size=table_size)
        table.cell(tb, 1, 3, str.tostring(state.countTargets1 + state.countTargets2), text_color=color.white, text_size=table_size)
        table.cell(tb, 2, 3, str.tostring(state.countTgReached1 + state.countTgReached2), text_color=color.yellow, text_size=table_size)


// updated description compliance

