export method pop(simple matrix<bool> mtx) =>
    mtx.delete(matrix.rows(mtx) - 1)
export method pop(simple matrix<string> mtx) =>
    mtx.delete(matrix.rows(mtx) - 1)
export method pop(simple matrix<color> mtx) =>
    mtx.delete(matrix.rows(mtx) - 1)


// @function rpop removes last row from matrix of lines and reutnrs the array to caller
// @param mtx matrix of lines from which the rpop operation need to be performed
// @returns void
export method rpop(simple matrix<line> mtx) =>
    mtx.remove(matrix.rows(mtx) - 1)
export method rpop(simple matrix<label> mtx) =>
    mtx.remove(matrix.rows(mtx) - 1)
export method rpop(simple matrix<box> mtx) =>
    mtx.remove(matrix.rows(mtx) - 1)
export method rpop(simple matrix<linefill> mtx) =>
    mtx.remove(matrix.rows(mtx) - 1)
export method rpop(simple matrix<table> mtx) =>
    mtx.remove(matrix.rows(mtx) - 1)
export method rpop(simple matrix<int> mtx) =>
    mtx.remove(matrix.rows(mtx) - 1)
export method rpop(simple matrix<float> mtx) =>
    mtx.remove(matrix.rows(mtx) - 1)
export method rpop(simple matrix<bool> mtx) =>
