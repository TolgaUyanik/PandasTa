export method rpop(simple matrix<string> mtx) =>
    mtx.remove(matrix.rows(mtx) - 1)
export method rpop(simple matrix<color> mtx) =>
    mtx.remove(matrix.rows(mtx) - 1)

flush_matrix(mtx) =>
    while matrix.rows(mtx) > 0
        mtx.delete(0)

clear_matrix(mtx) =>
    while matrix.rows(mtx) > 0
        mtx.remove(0)

// @function clear clears the matrix
// @param mtx matrix of lines which needs to be cleared
// @returns void
export method clear(simple matrix<line> mtx) =>
    clear_matrix(mtx)
export method clear(simple matrix<label> mtx) =>
    clear_matrix(mtx)
export method clear(simple matrix<box> mtx) =>
