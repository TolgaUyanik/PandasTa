    push_to_matrix(mtx, row, maxItems)
export method push(simple matrix<bool> mtx, array<bool> row, simple int maxItems) =>
    push_to_matrix(mtx, row, maxItems)
export method push(simple matrix<string> mtx, array<string> row, simple int maxItems) =>
    push_to_matrix(mtx, row, maxItems)
export method push(simple matrix<color> mtx, array<color> row, simple int maxItems) =>
    push_to_matrix(mtx, row, maxItems)

// @function shift removes first row from matrix of lines
// @param mtx matrix of lines from which the shift operation need to be performed
// @returns void
export method shift(simple matrix<line> mtx) => mtx.delete(0)
export method shift(simple matrix<label> mtx) => mtx.delete(0)
export method shift(simple matrix<box> mtx) => mtx.delete(0)
export method shift(simple matrix<linefill> mtx) => mtx.delete(0)
export method shift(simple matrix<table> mtx) => mtx.delete(0)
export method shift(simple matrix<int> mtx) => mtx.delete(0)
export method shift(simple matrix<float> mtx) => mtx.delete(0)
export method shift(simple matrix<bool> mtx) => mtx.delete(0)
export method shift(simple matrix<string> mtx) => mtx.delete(0)
export method shift(simple matrix<color> mtx) => mtx.delete(0)

// @function rshift removes first row from matrix of lines and returns them as array
// @param mtx matrix of lines from which the rshift operation need to be performed
// @returns type[]
export method rshift(simple matrix<line> mtx) =>
    mtx.remove(0)
export method rshift(simple matrix<label> mtx) =>
    mtx.remove(0)
export method rshift(simple matrix<box> mtx) =>
    mtx.remove(0)
export method rshift(simple matrix<linefill> mtx) =>
