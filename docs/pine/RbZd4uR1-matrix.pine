// @function pop removes last row from matrix of lines
// @param mtx matrix of lines from which the pop operation need to be performed
// @returns void
export method pop(simple matrix<line> mtx) =>
    mtx.delete(matrix.rows(mtx) - 1)
export method pop(simple matrix<label> mtx) =>
    mtx.delete(matrix.rows(mtx) - 1)
export method pop(simple matrix<box> mtx) =>
    mtx.delete(matrix.rows(mtx) - 1)
export method pop(simple matrix<linefill> mtx) =>
    mtx.delete(matrix.rows(mtx) - 1)
export method pop(simple matrix<table> mtx) =>
    mtx.delete(matrix.rows(mtx) - 1)
export method pop(simple matrix<int> mtx) =>
    mtx.delete(matrix.rows(mtx) - 1)
export method pop(simple matrix<float> mtx) =>
