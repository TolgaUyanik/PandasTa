//@version=6
indicator("ATK/DEF S/R Channel Rating Engine", overlay=true, 
          max_labels_count=500, max_lines_count=500,
          shorttitle="ATK/DEF S/R Channel Rating Engine")

// ============================================================
// MODULE 1: Input Parameters
// ============================================================
maxSwingPoints = input.int(20, "Max Swing Points", minval=5, maxval=50)
showLabels = input.bool(true, "Show Labels")
showTable = input.bool(true, "Show Table")
showChannel = input.bool(true, "Show Channel Lines")

powerThreshold = input.float(1.0, "⚡ Power Threshold", minval=0.3, maxval=3.0, step=0.1)
lookbackRange = input.int(50, "📏 Lookback Range", minval=10, maxval=200)

tablePosition = input.string("top_right", "Table Position", options=["top_left", "top_center", "top_right", "middle_left", "middle_center", "middle_right", "bottom_left", "bottom_center", "bottom_right"])
tableScale = input.float(1.0, "Table Scale", minval=0.5, maxval=2.0, step=0.1)
tableBgOpacity = input.int(92, "Table Opacity", minval=50, maxval=100, step=1)

autoBars = math.round(ta.atr(14) / ta.sma(ta.tr, 50) * 5)
autoBars := math.max(3, math.min(10, autoBars))

// ============================================================
// MODULE 2: Auto-Detect Timeframe Multiplier
// ============================================================
getTimeFrameMultiplier() =>
    tf = timeframe.period
    if tf == "1"
        0.05
    else if tf == "5"
        0.10
    else if tf == "15"
        0.20
    else if tf == "30"
        0.35
    else if tf == "60" or tf == "1H"
        0.60
    else if tf == "120" or tf == "2H"
        0.70
    else if tf == "180" or tf == "3H"
        0.75
    else if tf == "240" or tf == "4H"
        0.85
    else if tf == "D" or tf == "1D"
        1.00
    else if tf == "W" or tf == "1W"
        1.20
    else if tf == "M" or tf == "1M"
        1.50
    else
        0.50

tfMultiplier = getTimeFrameMultiplier()

// ============================================================
// MODULE 3: Get Readable Timeframe
// ============================================================
getReadableTimeframe() =>
    tf = timeframe.period
    if tf == "1"
        "1m"
    else if tf == "5"
        "5m"
    else if tf == "15"
        "15m"
    else if tf == "30"
        "30m"
    else if tf == "45"
        "45m"
    else if tf == "60" or tf == "1H"
        "1h"
    else if tf == "120" or tf == "2H"
        "2h"
    else if tf == "180" or tf == "3H"
        "3h"
    else if tf == "240" or tf == "4H"
        "4h"
    else if tf == "D" or tf == "1D"
        "1d"
    else if tf == "W" or tf == "1W"
        "1w"
    else if tf == "M" or tf == "1M"
        "1M"
    else
        tf

// ============================================================
// MODULE 4: Core - Calculate Historical Power
// ============================================================
calcHistoricalPower(price, swingIdx) =>
    barsAgo = bar_index - swingIdx
    if barsAgo < 0
        barsAgo := 0
    
    atrAtIdx = ta.atr(14)[barsAgo]
    if na(atrAtIdx) or atrAtIdx <= 0
        atrAtIdx := ta.atr(14)
    
    volAtIdx = volume[barsAgo]
    if na(volAtIdx) or volAtIdx <= 0
        volAtIdx := volume
    
    avgVolAtIdx = ta.sma(volume, 20)[barsAgo]
    if na(avgVolAtIdx) or avgVolAtIdx <= 0
        avgVolAtIdx := ta.sma(volume, 20)
    
    volMultiple = avgVolAtIdx > 0 ? volAtIdx / avgVolAtIdx : 1
    volMultiple := math.min(volMultiple, 5)
    
    priceShock = atrAtIdx > 0 ? (price / atrAtIdx) * tfMultiplier : 1
    priceShock := math.min(priceShock, 10)
    
    distanceFromCurrent = bar_index - swingIdx
    weight = distanceFromCurrent <= lookbackRange ? 1.0 : 0.5
    
    rawPower = priceShock * volMultiple * weight
    rawPower := math.min(rawPower, 20)
    
    rawPower

// ============================================================
// MODULE 4.5: 减弱指数 (Attenuation Index)
// ============================================================
calcAttenuation(price, swingIdx) =>
    barsAgo = bar_index - swingIdx
    if barsAgo < 0
        barsAgo := 0
    
    currentPrice = close
    priceChange = math.abs(currentPrice - price) / price * 100
    
    timeDecay = math.min(barsAgo / 50, 1.0)
    priceDecay = math.min(priceChange / 10, 1.0)
    
    attenuation = (timeDecay * 0.6 + priceDecay * 0.4)
    attenuation := math.min(attenuation, 1.0)
    
    attenuation

// ============================================================
// MODULE 4.6: 漩涡指标 (Swirl Index) - 修复版
// ============================================================
calcSwirl(swingIdx) =>
    barsAgo = bar_index - swingIdx
    if barsAgo < 0
        barsAgo := 0
    
    atrNear = ta.atr(14)[barsAgo]
    if na(atrNear) or atrNear <= 0
        atrNear := ta.atr(14)
    
    atrCurrent = ta.atr(14)
    volatilityChange = atrCurrent / atrNear
    
    swirlSum = 0.0
    for i = 0 to 10
        if not na(high[i]) and not na(low[i])
            barRange = high[i] - low[i]
            avgRange = ta.sma(high - low, 14)[i]
            if not na(avgRange) and avgRange > 0
                swirlSum := swirlSum + (barRange / avgRange)
    
    swirlAvg = swirlSum / 10
    swirlScore = math.min(swirlAvg * volatilityChange, 5.0)
    
    swirlScore

// ============================================================
// MODULE 5: Candle Pressure
// ============================================================
totalRange = high - low + 0.0001
buyPressure = (close - low) / totalRange * 100
sellPressure = (high - close) / totalRange * 100
pressureBalance = buyPressure - sellPressure

pressureStatus = ""
pressureColor = color.white
if pressureBalance > 60
    pressureStatus := "🟢 Strong Buy"
    pressureColor := color.rgb(0,255,0)
else if pressureBalance > 30
    pressureStatus := "📈 Buying"
    pressureColor := color.rgb(100,255,100)
else if pressureBalance > 10
    pressureStatus := "📈 Weak Buy"
    pressureColor := color.rgb(150,255,150)
else if pressureBalance > -10
    pressureStatus := "➡️ Balanced"
    pressureColor := color.rgb(200,200,200)
else if pressureBalance > -30
    pressureStatus := "📉 Weak Sell"
    pressureColor := color.rgb(255,200,150)
else if pressureBalance > -60
    pressureStatus := "📉 Selling"
    pressureColor := color.rgb(255,150,100)
else
    pressureStatus := "🔴 Strong Sell"
    pressureColor := color.rgb(255,0,0)

// ============================================================
// MODULE 6: Swing Detection + Data Storage
// ============================================================
swingHigh = ta.pivothigh(autoBars, autoBars)
swingLow = ta.pivotlow(autoBars, autoBars)

var float[] resistancePrices = array.new_float()
var int[] resistanceIndices = array.new_int()
var float[] resistancePower = array.new_float()
var int[] resistanceCount = array.new_int()
var float[] resistanceWeight = array.new_float()
var float[] resistanceAttenuation = array.new_float()
var float[] resistanceSwirl = array.new_float()

var float[] supportPrices = array.new_float()
var int[] supportIndices = array.new_int()
var float[] supportPower = array.new_float()
var int[] supportCount = array.new_int()
var float[] supportWeight = array.new_float()
var float[] supportAttenuation = array.new_float()
var float[] supportSwirl = array.new_float()

var label[] resistanceLabels = array.new_label()
var label[] supportLabels = array.new_label()

var line[] channelUpperLines = array.new_line()
var line[] channelLowerLines = array.new_line()

var string[] tableLabels = array.new_string()
var string[] tableValues = array.new_string()
var color[] tableLabelColors = array.new_color()
var color[] tableValueColors = array.new_color()

// ============================================================
// MODULE 7: Create Table (2 Column)
// ============================================================
var table infoTable = na
if barstate.isfirst
    if tablePosition == "top_left"
        infoTable := table.new(position.top_left, 2, 10,
                               bgcolor=color.rgb(10,10,30, tableBgOpacity),
                               border_color=color.rgb(80,80,150, 50),
                               frame_color=color.rgb(50,50,120, 70))
    else if tablePosition == "top_center"
        infoTable := table.new(position.top_center, 2, 10,
                               bgcolor=color.rgb(10,10,30, tableBgOpacity),
                               border_color=color.rgb(80,80,150, 50),
                               frame_color=color.rgb(50,50,120, 70))
    else if tablePosition == "top_right"
        infoTable := table.new(position.top_right, 2, 10,
                               bgcolor=color.rgb(10,10,30, tableBgOpacity),
                               border_color=color.rgb(80,80,150, 50),
                               frame_color=color.rgb(50,50,120, 70))
    else if tablePosition == "middle_left"
        infoTable := table.new(position.middle_left, 2, 10,
                               bgcolor=color.rgb(10,10,30, tableBgOpacity),
                               border_color=color.rgb(80,80,150, 50),
                               frame_color=color.rgb(50,50,120, 70))
    else if tablePosition == "middle_center"
        infoTable := table.new(position.middle_center, 2, 10,
                               bgcolor=color.rgb(10,10,30, tableBgOpacity),
                               border_color=color.rgb(80,80,150, 50),
                               frame_color=color.rgb(50,50,120, 70))
    else if tablePosition == "middle_right"
        infoTable := table.new(position.middle_right, 2, 10,
                               bgcolor=color.rgb(10,10,30, tableBgOpacity),
                               border_color=color.rgb(80,80,150, 50),
                               frame_color=color.rgb(50,50,120, 70))
    else if tablePosition == "bottom_left"
        infoTable := table.new(position.bottom_left, 2, 10,
                               bgcolor=color.rgb(10,10,30, tableBgOpacity),
                               border_color=color.rgb(80,80,150, 50),
                               frame_color=color.rgb(50,50,120, 70))
    else if tablePosition == "bottom_center"
        infoTable := table.new(position.bottom_center, 2, 10,
                               bgcolor=color.rgb(10,10,30, tableBgOpacity),
                               border_color=color.rgb(80,80,150, 50),
                               frame_color=color.rgb(50,50,120, 70))
    else if tablePosition == "bottom_right"
        infoTable := table.new(position.bottom_right, 2, 10,
                               bgcolor=color.rgb(10,10,30, tableBgOpacity),
                               border_color=color.rgb(80,80,150, 50),
                               frame_color=color.rgb(50,50,120, 70))

// ============================================================
// MODULE 8: Auto Test Detection (Relaxed)
// ============================================================
calculateResistanceBehavior(price, swingIdx) =>
    cnt = 0
    weightScore = 0.0
    lastTouchBar = 0
    
    for i = 1 to 50
        if not na(high[i]) and not na(low[i])
            upper = price * 1.003
            lower = price * 0.997
            
            isTouched = false
            if (high[i] >= lower and high[i] <= upper) or (low[i] >= lower and low[i] <= upper) or (close[i] >= lower and close[i] <= upper)
                isTouched := true
            
            if isTouched and i - lastTouchBar >= 2
                cnt := cnt + 1
                lastTouchBar := i
                timeWeight = 1.0 - (i / 50) * 0.5
                weightScore := weightScore + timeWeight
    
    if cnt > 5
        cnt := 5
    
    avgWeight = cnt > 0 ? weightScore / cnt : 0
    
    countFactor = 0.3
    if cnt >= 5
        countFactor := 1.5
    else if cnt >= 3
        countFactor := 1.0
    else if cnt >= 2
        countFactor := 0.6
    
    finalScore = cnt * avgWeight * countFactor
    if finalScore > 5.0
        finalScore := 5.0
    
    [cnt, finalScore]

calculateSupportBehavior(price, swingIdx) =>
    cnt = 0
    weightScore = 0.0
    lastTouchBar = 0
    
    for i = 1 to 50
        if not na(high[i]) and not na(low[i])
            upper = price * 1.003
            lower = price * 0.997
            
            isTouched = false
            if (high[i] >= lower and high[i] <= upper) or (low[i] >= lower and low[i] <= upper) or (close[i] >= lower and close[i] <= upper)
                isTouched := true
            
            if isTouched and i - lastTouchBar >= 2
                cnt := cnt + 1
                lastTouchBar := i
                timeWeight = 1.0 - (i / 50) * 0.5
                weightScore := weightScore + timeWeight
    
    if cnt > 5
        cnt := 5
    
    avgWeight = cnt > 0 ? weightScore / cnt : 0
    
    countFactor = 0.3
    if cnt >= 5
        countFactor := 1.5
    else if cnt >= 3
        countFactor := 1.0
    else if cnt >= 2
        countFactor := 0.6
    
    finalScore = cnt * avgWeight * countFactor
    if finalScore > 5.0
        finalScore := 5.0
    
    [cnt, finalScore]

// ----- Process Resistance -----
if not na(swingHigh)
    idx = bar_index[autoBars]
    power = calcHistoricalPower(swingHigh, idx)
    [cnt, weightScore] = calculateResistanceBehavior(swingHigh, idx)
    atten = calcAttenuation(swingHigh, idx)
    swirl = calcSwirl(idx)
    
    array.push(resistancePrices, swingHigh)
    array.push(resistanceIndices, idx)
    array.push(resistancePower, power)
    array.push(resistanceCount, cnt)
    array.push(resistanceWeight, weightScore)
    array.push(resistanceAttenuation, atten)
    array.push(resistanceSwirl, swirl)
    
    if array.size(resistancePrices) > maxSwingPoints
        array.remove(resistancePrices, 0)
        array.remove(resistanceIndices, 0)
        array.remove(resistancePower, 0)
        array.remove(resistanceCount, 0)
        array.remove(resistanceWeight, 0)
        array.remove(resistanceAttenuation, 0)
        array.remove(resistanceSwirl, 0)

// ----- Process Support -----
if not na(swingLow)
    idx = bar_index[autoBars]
    power = calcHistoricalPower(swingLow, idx)
    [cnt, weightScore] = calculateSupportBehavior(swingLow, idx)
    atten = calcAttenuation(swingLow, idx)
    swirl = calcSwirl(idx)
    
    array.push(supportPrices, swingLow)
    array.push(supportIndices, idx)
    array.push(supportPower, power)
    array.push(supportCount, cnt)
    array.push(supportWeight, weightScore)
    array.push(supportAttenuation, atten)
    array.push(supportSwirl, swirl)
    
    if array.size(supportPrices) > maxSwingPoints
        array.remove(supportPrices, 0)
        array.remove(supportIndices, 0)
        array.remove(supportPower, 0)
        array.remove(supportCount, 0)
        array.remove(supportWeight, 0)
        array.remove(supportAttenuation, 0)
        array.remove(supportSwirl, 0)

// ============================================================
// MODULE 9: Clean Up Old Labels & Lines
// ============================================================
if array.size(resistanceLabels) > 0
    for i = 0 to array.size(resistanceLabels) - 1
        lbl = array.get(resistanceLabels, i)
        if not na(lbl)
            label.delete(lbl)
array.clear(resistanceLabels)

if array.size(supportLabels) > 0
    for i = 0 to array.size(supportLabels) - 1
        lbl = array.get(supportLabels, i)
        if not na(lbl)
            label.delete(lbl)
array.clear(supportLabels)

if array.size(channelUpperLines) > 0
    for i = 0 to array.size(channelUpperLines) - 1
        ln = array.get(channelUpperLines, i)
        if not na(ln)
            line.delete(ln)
array.clear(channelUpperLines)

if array.size(channelLowerLines) > 0
    for i = 0 to array.size(channelLowerLines) - 1
        ln = array.get(channelLowerLines, i)
        if not na(ln)
            line.delete(ln)
array.clear(channelLowerLines)

// ============================================================
// 🚀 MODULE 9.5: Draw Channel Lines（修复版 - 无 na 赋值）
// ============================================================
if showChannel
    delayBars = 2
    currentBar = bar_index - delayBars
    
    // ----- 上通道（阻力线）-----
    if array.size(resistancePrices) >= 2
        latestResPower = array.get(resistancePower, array.size(resistancePower) - 1)
        showResChannel = false
        if not na(latestResPower) and latestResPower >= powerThreshold
            showResChannel := true
        
        startIdx = array.get(resistanceIndices, 0)
        startPrice = array.get(resistancePrices, 0)
        
        for i = 1 to array.size(resistancePrices) - 1
            idx = array.get(resistanceIndices, i)
            price = array.get(resistancePrices, i)
            
            if idx <= currentBar
                // 🔥 直接用 if 分支创建线条并存储
                if showResChannel
                    ln = line.new(startIdx, startPrice, idx, price,
                                  color=color.new(color.red, 60),
                                  width=2,
                                  style=line.style_solid)
                    if not na(ln)
                        array.push(channelUpperLines, ln)
                else
                    ln = line.new(startIdx, startPrice, idx, price,
                                  color=color.new(color.gray, 30),
                                  width=1,
                                  style=line.style_dashed)
                    if not na(ln)
                        array.push(channelUpperLines, ln)
            
            startIdx := idx
            startPrice := price
        
        // 延伸到最后（虚线）
        lastIdx = array.get(resistanceIndices, array.size(resistancePrices) - 1)
        lastPrice = array.get(resistancePrices, array.size(resistancePrices) - 1)
        prevIdx = array.get(resistanceIndices, array.size(resistancePrices) - 2)
        prevPrice = array.get(resistancePrices, array.size(resistancePrices) - 2)
        
        if not na(lastIdx) and not na(lastPrice) and not na(prevIdx) and not na(prevPrice)
            slope = (lastPrice - prevPrice) / (lastIdx - prevIdx)
            extendPrice = lastPrice + slope * (currentBar - lastIdx)
            
            if currentBar > lastIdx
                if showResChannel
                    ln = line.new(lastIdx, lastPrice, currentBar, extendPrice,
                                  color=color.new(color.red, 40),
                                  width=1,
                                  style=line.style_dotted)
                    if not na(ln)
                        array.push(channelUpperLines, ln)
                else
                    ln = line.new(lastIdx, lastPrice, currentBar, extendPrice,
                                  color=color.new(color.gray, 20),
                                  width=1,
                                  style=line.style_dotted)
                    if not na(ln)
                        array.push(channelUpperLines, ln)
    
    // ----- 下通道（支撑线）-----
    if array.size(supportPrices) >= 2
        latestSupPower = array.get(supportPower, array.size(supportPower) - 1)
        showSupChannel = false
        if not na(latestSupPower) and latestSupPower >= powerThreshold
            showSupChannel := true
        
        startIdx = array.get(supportIndices, 0)
        startPrice = array.get(supportPrices, 0)
        
        for i = 1 to array.size(supportPrices) - 1
            idx = array.get(supportIndices, i)
            price = array.get(supportPrices, i)
            
            if idx <= currentBar
                if showSupChannel
                    ln = line.new(startIdx, startPrice, idx, price,
                                  color=color.new(color.green, 60),
                                  width=2,
                                  style=line.style_solid)
                    if not na(ln)
                        array.push(channelLowerLines, ln)
                else
                    ln = line.new(startIdx, startPrice, idx, price,
                                  color=color.new(color.gray, 30),
                                  width=1,
                                  style=line.style_dashed)
                    if not na(ln)
                        array.push(channelLowerLines, ln)
            
            startIdx := idx
            startPrice := price
        
        // 延伸到最后（虚线）
        lastIdx = array.get(supportIndices, array.size(supportPrices) - 1)
        lastPrice = array.get(supportPrices, array.size(supportPrices) - 1)
        prevIdx = array.get(supportIndices, array.size(supportPrices) - 2)
        prevPrice = array.get(supportPrices, array.size(supportPrices) - 2)
        
        if not na(lastIdx) and not na(lastPrice) and not na(prevIdx) and not na(prevPrice)
            slope = (lastPrice - prevPrice) / (lastIdx - prevIdx)
            extendPrice = lastPrice + slope * (currentBar - lastIdx)
            
            if currentBar > lastIdx
                if showSupChannel
                    ln = line.new(lastIdx, lastPrice, currentBar, extendPrice,
                                  color=color.new(color.green, 40),
                                  width=1,
                                  style=line.style_dotted)
                    if not na(ln)
                        array.push(channelLowerLines, ln)
                else
                    ln = line.new(lastIdx, lastPrice, currentBar, extendPrice,
                                  color=color.new(color.gray, 20),
                                  width=1,
                                  style=line.style_dotted)
                    if not na(ln)
                        array.push(channelLowerLines, ln)

// ============================================================
// MODULE 10: Draw S/R Labels（综合等级版 - 带过滤）
// ============================================================
if showLabels
    for i = 0 to array.size(resistancePrices) - 1
        idx = array.get(resistanceIndices, i)
        val = array.get(resistancePrices, i)
        power = array.get(resistancePower, i)
        cnt = array.get(resistanceCount, i)
        atten = array.get(resistanceAttenuation, i)
        swirl = array.get(resistanceSwirl, i)
        
        if not na(power) and power >= powerThreshold and not na(idx) and not na(val)
            
            // POWER 值过滤
            powerFiltered = false
            powerLevel = ""
            if power >= 5.0
                powerFiltered := true
                powerLevel := "Extreme"
            else if power >= 3.0
                powerFiltered := true
                powerLevel := "Strong"
            else if power >= 1.5
                powerFiltered := true
                powerLevel := "Moderate"
            else
                powerFiltered := false
                powerLevel := "Weak (Filtered)"
            
            // 减弱指数过滤
            attenFiltered = false
            attenLevel = ""
            if atten < 0.3
                attenFiltered := true
                attenLevel := "Fresh"
            else if atten < 0.5
                attenFiltered := true
                attenLevel := "Active"
            else if atten < 0.7
                attenFiltered := true
                attenLevel := "Weakening"
            else
                attenFiltered := false
                attenLevel := "Decayed (Filtered)"
            
            // 漩涡指标过滤
            swirlFiltered = false
            swirlLevel = ""
            if swirl >= 2.0
                swirlFiltered := true
                swirlLevel := "Turbulent"
            else if swirl >= 1.0
                swirlFiltered := true
                swirlLevel := "Active"
            else if swirl >= 0.5
                swirlFiltered := true
                swirlLevel := "Mild"
            else
                swirlFiltered := false
                swirlLevel := "Calm (Filtered)"
            
            // 综合等级计算
            compositeScore = 0.0
            compositeLabel = ""
            
            if powerFiltered and attenFiltered and swirlFiltered
                powerNorm = math.min(power / 10, 1.0)
                attenNorm = 1 - atten
                swirlNorm = math.min(swirl / 3, 1.0)
                
                compositeScore = powerNorm * attenNorm * (0.5 + swirlNorm * 0.5)
                compositeScore := math.min(compositeScore, 1.0)
                
                if compositeScore >= 0.8
                    compositeLabel := "⭐ S-Tier"
                else if compositeScore >= 0.6
                    compositeLabel := "⭐ A-Tier"
                else if compositeScore >= 0.4
                    compositeLabel := "⭐ B-Tier"
                else if compositeScore >= 0.2
                    compositeLabel := "⭐ C-Tier"
                else
                    compositeLabel := "⭐ D-Tier"
            else
                compositeLabel := "⛔ Filtered Out"
            
            powerDisplay = "P:" + str.tostring(power, "#.##") + " (" + powerLevel + ")"
            attenDisplay = "A:" + str.tostring(atten, "#.##") + " (" + attenLevel + ")"
            swirlDisplay = "S:" + str.tostring(swirl, "#.##") + " (" + swirlLevel + ")"
            
            behaviorDisplay = ""
            if cnt >= 5
                behaviorDisplay := "✅ Strongly Validated"
            else if cnt >= 3
                behaviorDisplay := "✅ Validated"
            else if cnt >= 2
                behaviorDisplay := "⏳ Initial Test"
            else
                behaviorDisplay := "🆕 Untested"
            
            lbl = label.new(
                x=idx, y=val,
                text="🔴 RESISTANCE (" + str.tostring(val, "#.##") + ")\n" + powerDisplay + " | " + attenDisplay + " | " + swirlDisplay + "\n" + compositeLabel + "\n" + behaviorDisplay,
                color=color.new(color.red, 85),
                textcolor=color.white,
                style=label.style_label_down,
                size=size.small,
                textalign=text.align_center
            )
            array.push(resistanceLabels, lbl)
    
    for i = 0 to array.size(supportPrices) - 1
        idx = array.get(supportIndices, i)
        val = array.get(supportPrices, i)
        power = array.get(supportPower, i)
        cnt = array.get(supportCount, i)
        atten = array.get(supportAttenuation, i)
        swirl = array.get(supportSwirl, i)
        
        if not na(power) and power >= powerThreshold and not na(idx) and not na(val)
            
            powerFiltered = false
            powerLevel = ""
            if power >= 5.0
                powerFiltered := true
                powerLevel := "Extreme"
            else if power >= 3.0
                powerFiltered := true
                powerLevel := "Strong"
            else if power >= 1.5
                powerFiltered := true
                powerLevel := "Moderate"
            else
                powerFiltered := false
                powerLevel := "Weak (Filtered)"
            
            attenFiltered = false
            attenLevel = ""
            if atten < 0.3
                attenFiltered := true
                attenLevel := "Fresh"
            else if atten < 0.5
                attenFiltered := true
                attenLevel := "Active"
            else if atten < 0.7
                attenFiltered := true
                attenLevel := "Weakening"
            else
                attenFiltered := false
                attenLevel := "Decayed (Filtered)"
            
            swirlFiltered = false
            swirlLevel = ""
            if swirl >= 2.0
                swirlFiltered := true
                swirlLevel := "Turbulent"
            else if swirl >= 1.0
                swirlFiltered := true
                swirlLevel := "Active"
            else if swirl >= 0.5
                swirlFiltered := true
                swirlLevel := "Mild"
            else
                swirlFiltered := false
                swirlLevel := "Calm (Filtered)"
            
            compositeScore = 0.0
            compositeLabel = ""
            
            if powerFiltered and attenFiltered and swirlFiltered
                powerNorm = math.min(power / 10, 1.0)
                attenNorm = 1 - atten
                swirlNorm = math.min(swirl / 3, 1.0)
                
                compositeScore = powerNorm * attenNorm * (0.5 + swirlNorm * 0.5)
                compositeScore := math.min(compositeScore, 1.0)
                
                if compositeScore >= 0.8
                    compositeLabel := "⭐ S-Tier"
                else if compositeScore >= 0.6
                    compositeLabel := "⭐ A-Tier"
                else if compositeScore >= 0.4
                    compositeLabel := "⭐ B-Tier"
                else if compositeScore >= 0.2
                    compositeLabel := "⭐ C-Tier"
                else
                    compositeLabel := "⭐ D-Tier"
            else
                compositeLabel := "⛔ Filtered Out"
            
            powerDisplay = "P:" + str.tostring(power, "#.##") + " (" + powerLevel + ")"
            attenDisplay = "A:" + str.tostring(atten, "#.##") + " (" + attenLevel + ")"
            swirlDisplay = "S:" + str.tostring(swirl, "#.##") + " (" + swirlLevel + ")"
            
            behaviorDisplay = ""
            if cnt >= 5
                behaviorDisplay := "✅ Strongly Validated"
            else if cnt >= 3
                behaviorDisplay := "✅ Validated"
            else if cnt >= 2
                behaviorDisplay := "⏳ Initial Test"
            else
                behaviorDisplay := "🆕 Untested"
            
            lbl = label.new(
                x=idx, y=val,
                text="🟢 SUPPORT (" + str.tostring(val, "#.##") + ")\n" + powerDisplay + " | " + attenDisplay + " | " + swirlDisplay + "\n" + compositeLabel + "\n" + behaviorDisplay,
                color=color.new(color.green, 85),
                textcolor=color.white,
                style=label.style_label_up,
                size=size.small,
                textalign=text.align_center
            )
            array.push(supportLabels, lbl)

// ============================================================
// MODULE 11: Table Data (Channel Status + Motor + 3 Factors)
// ============================================================
array.clear(tableLabels)
array.clear(tableValues)
array.clear(tableLabelColors)
array.clear(tableValueColors)

resCount = array.size(resistancePrices)
supCount = array.size(supportPrices)

// ============================================================
// 🔥 Get Latest Data
// ============================================================
latestResPrice = resCount > 0 ? array.get(resistancePrices, resCount - 1) : na
latestSupPrice = supCount > 0 ? array.get(supportPrices, supCount - 1) : na
latestResPower = resCount > 0 ? array.get(resistancePower, resCount - 1) : na
latestSupPower = supCount > 0 ? array.get(supportPower, supCount - 1) : na
latestResAtten = resCount > 0 ? array.get(resistanceAttenuation, resCount - 1) : na
latestSupAtten = supCount > 0 ? array.get(supportAttenuation, supCount - 1) : na
latestResSwirl = resCount > 0 ? array.get(resistanceSwirl, resCount - 1) : na
latestSupSwirl = supCount > 0 ? array.get(supportSwirl, supCount - 1) : na

// ============================================================
// 🔥 Channel Status
// ============================================================
channelStatus = ""
channelColor = color.white

resChannelActive = not na(latestResPower) and latestResPower >= powerThreshold
supChannelActive = not na(latestSupPower) and latestSupPower >= powerThreshold

if resChannelActive and supChannelActive
    channelStatus := "✅ Dual Channel Open"
    channelColor := color.rgb(0,255,100)
else if resChannelActive
    channelStatus := "⏳ Upper Channel Only"
    channelColor := color.rgb(255,200,100)
else if supChannelActive
    channelStatus := "⏳ Lower Channel Only"
    channelColor := color.rgb(100,200,255)
else
    channelStatus := "⛔ Channel Closed (Gray)"
    channelColor := color.rgb(200,200,200)

// ============================================================
// 🔥 Motor Status
// ============================================================
motorStatus = ""
motorColor = color.white

if resChannelActive or supChannelActive
    motorStatus := "⚡ Motor Running"
    motorColor := color.rgb(0,255,200)
else
    motorStatus := "⏸️ Motor Stopped"
    motorColor := color.rgb(200,200,200)

// ============================================================
// 🔥 POWER Value Display
// ============================================================
powerDisplay = ""
powerColor = color.white

if not na(latestResPower) and not na(latestSupPower)
    avgPower = (latestResPower + latestSupPower) / 2
    powerDisplay := "R:" + str.tostring(latestResPower, "#.##") + " | S:" + str.tostring(latestSupPower, "#.##") + " | Avg:" + str.tostring(avgPower, "#.##")
    
    if avgPower >= 5.0
        powerColor := color.rgb(255,215,0)
    else if avgPower >= 3.0
        powerColor := color.rgb(0,200,255)
    else if avgPower >= 1.5
        powerColor := color.rgb(0,255,100)
    else
        powerColor := color.rgb(200,200,200)
else if not na(latestResPower)
    powerDisplay := "R:" + str.tostring(latestResPower, "#.##") + " | S:N/A"
    powerColor := color.rgb(255,200,100)
else if not na(latestSupPower)
    powerDisplay := "R:N/A | S:" + str.tostring(latestSupPower, "#.##")
    powerColor := color.rgb(100,200,255)
else
    powerDisplay := "N/A"
    powerColor := color.rgb(200,200,200)

// ============================================================
// 🔥 Attenuation Display
// ============================================================
attenDisplay = ""
attenColor = color.white

if not na(latestResAtten) and not na(latestSupAtten)
    avgAtten = (latestResAtten + latestSupAtten) / 2
    attenDisplay := "R:" + str.tostring(latestResAtten, "#.##") + " | S:" + str.tostring(latestSupAtten, "#.##") + " | Avg:" + str.tostring(avgAtten, "#.##")
    
    if avgAtten < 0.3
        attenColor := color.rgb(0,255,100)
    else if avgAtten < 0.5
        attenColor := color.rgb(255,200,100)
    else if avgAtten < 0.7
        attenColor := color.rgb(255,150,100)
    else
        attenColor := color.rgb(200,200,200)
else if not na(latestResAtten)
    attenDisplay := "R:" + str.tostring(latestResAtten, "#.##") + " | S:N/A"
    attenColor := color.rgb(255,200,100)
else if not na(latestSupAtten)
    attenDisplay := "R:N/A | S:" + str.tostring(latestSupAtten, "#.##")
    attenColor := color.rgb(100,200,255)
else
    attenDisplay := "N/A"
    attenColor := color.rgb(200,200,200)

// ============================================================
// 🔥 Swirl Index Display
// ============================================================
swirlDisplay = ""
swirlColor = color.white

if not na(latestResSwirl) and not na(latestSupSwirl)
    avgSwirl = (latestResSwirl + latestSupSwirl) / 2
    swirlDisplay := "R:" + str.tostring(latestResSwirl, "#.##") + " | S:" + str.tostring(latestSupSwirl, "#.##") + " | Avg:" + str.tostring(avgSwirl, "#.##")
    
    if avgSwirl >= 2.0
        swirlColor := color.rgb(255,215,0)
    else if avgSwirl >= 1.0
        swirlColor := color.rgb(0,200,255)
    else if avgSwirl >= 0.5
        swirlColor := color.rgb(0,255,100)
    else
        swirlColor := color.rgb(200,200,200)
else if not na(latestResSwirl)
    swirlDisplay := "R:" + str.tostring(latestResSwirl, "#.##") + " | S:N/A"
    swirlColor := color.rgb(255,200,100)
else if not na(latestSupSwirl)
    swirlDisplay := "R:N/A | S:" + str.tostring(latestSupSwirl, "#.##")
    swirlColor := color.rgb(100,200,255)
else
    swirlDisplay := "N/A"
    swirlColor := color.rgb(200,200,200)

// ============================================================
// 🔥 Table Data
// ============================================================
textSize = tableScale >= 1.5 ? size.large : tableScale >= 1.0 ? size.normal : size.small

array.push(tableLabels, " ⚡ S/R Channel Pro")
array.push(tableValues, "")
array.push(tableLabelColors, color.rgb(200,220,255))
array.push(tableValueColors, color.rgb(200,220,255))

array.push(tableLabels, "━━━━━━━━━━━━")
array.push(tableValues, "━━━━━━━━━━━━")
array.push(tableLabelColors, color.rgb(80,80,150))
array.push(tableValueColors, color.rgb(80,80,150))

array.push(tableLabels, "📐 Channel Status")
array.push(tableValues, channelStatus)
array.push(tableLabelColors, color.rgb(180,200,255))
array.push(tableValueColors, channelColor)

array.push(tableLabels, "⚡ Motor Status")
array.push(tableValues, motorStatus)
array.push(tableLabelColors, color.rgb(180,200,255))
array.push(tableValueColors, motorColor)

array.push(tableLabels, "💪 POWER Value")
array.push(tableValues, powerDisplay)
array.push(tableLabelColors, color.rgb(180,200,255))
array.push(tableValueColors, powerColor)

array.push(tableLabels, "📉 Attenuation")
array.push(tableValues, attenDisplay)
array.push(tableLabelColors, color.rgb(180,200,255))
array.push(tableValueColors, attenColor)

array.push(tableLabels, "🌀 Swirl Index")
array.push(tableValues, swirlDisplay)
array.push(tableLabelColors, color.rgb(180,200,255))
array.push(tableValueColors, swirlColor)

array.push(tableLabels, "⏱️ Timeframe")
array.push(tableValues, getReadableTimeframe())
array.push(tableLabelColors, color.rgb(180,200,255))
array.push(tableValueColors, color.rgb(200,220,255))

// ============================================================
// MODULE 12: Render Table
// ============================================================
if barstate.islast and not na(infoTable)
    for row = 0 to array.size(tableLabels) - 1
        labelText = array.get(tableLabels, row)
        valueText = array.get(tableValues, row)
        labelColor = array.get(tableLabelColors, row)
        valueColor = array.get(tableValueColors, row)
        
        isHeader = row == 0
        isSeparator = row == 1
        
        if isHeader
            table.cell(infoTable, 0, row, labelText, 
                       text_color=labelColor, 
                       bgcolor=color.rgb(30, 50, 120, tableBgOpacity), 
                       text_size=textSize, 
                       text_halign=text.align_center)
            table.cell(infoTable, 1, row, "", 
                       text_color=labelColor, 
                       bgcolor=color.rgb(30, 50, 120, tableBgOpacity), 
                       text_size=textSize)
        else if isSeparator
            table.cell(infoTable, 0, row, labelText, 
                       text_color=labelColor, 
                       bgcolor=color.rgb(15, 15, 40, tableBgOpacity), 
                       text_size=textSize, 
                       text_halign=text.align_center)
            table.cell(infoTable, 1, row, "", 
                       text_color=labelColor, 
                       bgcolor=color.rgb(15, 15, 40, tableBgOpacity), 
                       text_size=textSize)
        else
            table.cell(infoTable, 0, row, labelText, 
                       text_color=labelColor, 
                       bgcolor=color.rgb(20, 25, 55, tableBgOpacity), 
                       text_size=textSize, 
                       text_halign=text.align_left)
            table.cell(infoTable, 1, row, valueText, 
                       text_color=valueColor, 
                       bgcolor=color.rgb(20, 25, 55, tableBgOpacity), 
                       text_size=textSize, 
                       text_halign=text.align_right)