//@version=5
indicator("RSI SMA 7 Signal Strategy (No 50 Level)", overlay=false)

// Input parameters
rsiSource = close
rsiLength = input.int(14, title="RSI Length")
smaLength = input.int(7, title="SMA Period on RSI")

// Calculate RSI and its SMA
rsi = ta.rsi(rsiSource, rsiLength)
sma_rsi = ta.sma(rsi, smaLength)

// Levels
level60 = 60
level40 = 40

// --- SELL SIGNALS (cross down from above) ---
// 1st sell signal (Profit Taking)
sell_signal_1 = ta.crossunder(sma_rsi, level60) and sma_rsi[1] > level60
// Bearish sell signal
bearish_sell_signal = ta.crossunder(sma_rsi, level40) and sma_rsi[1] > level40

// --- BUY SIGNALS (cross up from below) ---
// 1st buy signal (Reversal Buy)
buy_signal_1 = ta.crossover(sma_rsi, level40) and sma_rsi[1] < level40
// Bullish buy signal
bullish_buy_signal = ta.crossover(sma_rsi, level60) and sma_rsi[1] < level60

// --- Plot RSI and SMA ---
plot(rsi, color=color.gray, title="RSI")
plot(sma_rsi, color=color.orange, title="SMA of RSI")

// Plot horizontal lines
hline(level60, "Level 60", color=color.gray)
hline(level40, "Level 40", color=color.gray)

// --- Plot signal markers ---
plotshape(sell_signal_1, title="Profit Taking", location=location.abovebar, color=color.red, style=shape.triangledown, text="Sell 1")
plotshape(bearish_sell_signal, title="Bearish Sell", location=location.abovebar, color=color.black, style=shape.triangledown, text="Bear")

plotshape(buy_signal_1, title="Reversal Buy", location=location.belowbar, color=color.green, style=shape.triangleup, text="Buy 1")
plotshape(bullish_buy_signal, title="Bullish Buy", location=location.belowbar, color=color.blue, style=shape.triangleup, text="Bull")

