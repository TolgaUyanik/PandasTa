// ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
// ┃                          THE LIBRARY OBJECT                                  ┃ {
// Using this object allows to avoid using other library types, so copy-pasting
// INIT sections from library to script becomes easier.
// @type LO Library object, whose only purpose is to serve as a shorthand for library name in script code. 
// Used in INIT section where object of library types are created. Instead of writing "LIBRARY_ALIAS.function()"
// you can write "LO.function_wrapper()" where `function_wrapper() => LIBRARY_ALIAS.function()`
export type LO
    string dummy                      = "HTFMAs"
    
// @function A wraper for RsParamsMAs.new() 
export method newRsParamsMAs    (LO this) => na(this) ? RsParamsMAs.new() : RsParamsMAs.new() 
// @function A wraper for HTFMAs.new()
export method newHTFMAs         (LO this) => na(this) ? HTFMAs.new() : HTFMAs.new()

var LO loHTFMAs = LO.new()

// ┃                 END OF THE LIBRARY OBJECT                                    ┃ }
// ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛ 

// ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
// ┃                          TYPE SHORTHANDS FOR BANDS INPUT                     ┃ {
// Minor amendment to this section (adding library alias before the types ) allows
// to copy paste code sections below to user's script without modifications.
MaEnable_individualy        = MaEnable.individualy
MaEnable_enableAll          = MaEnable.enableAll
MaEnable_disableAll         = MaEnable.disableAll
MaDraw_individualy          = MaDraw.individualy    
MaDraw_lines_and_labels     = MaDraw.lines_and_labels        
MaDraw_only_labels          = MaDraw.only_labels    
MaDraw_only_lines           = MaDraw.only_lines    
MaSmoothen_individually     = MaSmoothen.individually                
MaSmoothen_all              = MaSmoothen.all        
MaSmoothen_none             = MaSmoothen.none        
MaTypes_SMA                 = MaTypes.SMA
MaTypes_EMA                 = MaTypes.EMA
MaTypes_WMA                 = MaTypes.WMA
MaTypes_VMAA                = MaTypes.VMAA
MaTypes_SWMA                = MaTypes.SWMA
MaTypes_HMA                 = MaTypes.HMA
MaTypes_RMA                 = MaTypes.RMA
MaTypes_TEMA                = MaTypes.TEMA
MaTypes_VWAP                = MaTypes.VWAP
// ┃                 END OF TYPE SHORTHANDS FOR BANDS INPUT                       ┃ }
// ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛ 


// ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
// ┃                          INPUTS AND INIT                                     ┃ {


// ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓ ALL TFs  INPUT AND INIT ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓ {




//======================================================================================
//   INPUTS - HTFMAs ALL TFs                                                             //{

// --- input text constants ---
const string IG_SYM1_HTFMAS         = "▓▓▓▓▓ MA settings (for ALL timeframes)  ▓▓▓▓▓"
const string IG_SYM1_HTFMAS_LBLS    = "━━━━━━  Label settings (for ALL TF's) ━━━━━━━"
const string IG_SYM1_HTFMAS_CLRS    = "━━━━━━━  MA Colors (for ALL TF's) ━━━━━━━━"
const string IG_SYM1_HTFMAS_TYPE    = "━━━━━━━  MA Types (for ALL TF's) ━━━━━━━━━"
const string IG_SYM1_HTFMAS_PRD     = "━━━━━━━━  MA Periods (for ALL TF's) ━━━━━━━━"


const string TT_HTFMAS_TF    = "If timeframe value is set in CSV configuration this timeframe setting will have no effect. Same applies to all other settings, if set in CSV these setting will have no effect."

const string TT_HTFMAS_SMOOTHEN    = "If smoothen is NOT selected then latest HTF value will be plotted as a horizontal line 
                              until a new HTF value comes (MA will look like steps). If smoothen is selected then once 
                              a new HTF value comes it will be connected with the previous with a curved line (across the intrabars within the HTF bar).
                              "

const string TT_HTFMAS_REPAINT_AND_LOOKAHEAD = "Repaint: (only applies to the realtime bars) If set will update as new 
                              realtime data comes, if false will wait until realtime bar closes. 
                              Lookahead: (only applies to the historical bars) If true the script will learn how the 
                              HTF bar closed already on the first chart tf's bar. If false - only on the last chart 
                              tf's bar within the HTF bar."  

// const string TT_HTFMAS_SMOOTHEN_ALL = "(Unless 'Set individually' selected, overrides settings for individual MA's)" +  TT_SMOOTHEN

const color CLR_MA1                     = color.rgb(178, 216, 247, 37)
const color CLR_MA2                     = color.rgb(246, 244, 119, 41)
const color CLR_MA3                     = color.rgb(255, 144, 144, 23)
const color CLR_MA4                     =  color.rgb(21, 121, 203, 50)
const color CLR_MA5                     =  color.rgb(251, 240, 27, 31)
const color CLR_MA6                     =  color.rgb(244, 46, 46, 34)

i_sym1_htfmas_enableAll                       = input.bool    (group = IG_SYM1_HTFMAS, inline= "0", defval = true, title = "All HTF MAs on/off", tooltip = "General switch for all the HTF MAs")                    
i_sym1_htfmas_repaint                         = input.bool    (group = IG_SYM1_HTFMAS, inline= "0", defval = false, title = "Repaint", tooltip = TT_HTFMAS_REPAINT_AND_LOOKAHEAD)                    
i_sym1_htfmas_lookahead                       = input.bool    (group = IG_SYM1_HTFMAS, inline= "0", defval = false, title = "Lookahead", tooltip = TT_HTFMAS_REPAINT_AND_LOOKAHEAD)    
i_sym1_htfmas_smoothen                        = input.enum    (group = IG_SYM1_HTFMAS, inline= "smooth", defval = MaSmoothen_individually, title = "Smoothen", tooltip = TT_HTFMAS_SMOOTHEN)                    

i_sym1_htfmas_showHistory        = input.enum   (group = IG_SYM1_HTFMAS, inline= "1", defval = MaDraw_individualy, title = "Show history (for all TFs and MA's)", tooltip = "Draw MA lines on chart. Overrides all individual settings below (instead, you can choose to show just MA's level as a horisontal line to the right of the current latest bar)")                        
i_sym1_htfmas_showRecentBars     = input.int    (group = IG_SYM1_HTFMAS, inline= "1", defval = 100000, title = "back to, bars", tooltip = "Only plot MAs on recent bars.")                    
i_sym1_htfmas_showSmallerTFs     = input.bool   (group = IG_SYM1_HTFMAS, inline = "smalleTf", defval = true, title = "Plot smaller TF's", tooltip = "If checked MA's and bands of smaller timeframes will be shown on higher timeframes (e.g. 1H EMA on a daily chart)")                    

i_sym1_htfmas_lnOffset          = input.int     (group = IG_SYM1_HTFMAS, inline= "offset", defval = 1, title = "Line offset from, bars", tooltip = "The dashed line before label will start this number of bars off to the right of the last bar")                    
i_sym1_htfmas_lblsOffset        = input.int     (group = IG_SYM1_HTFMAS, inline= "offset", defval = 15, title = "to", tooltip = "")                    

i_sym1_htfmas_rngAtrQ            = input.int     (group = IG_SYM1_HTFMAS, inline= "dispRngQ", defval = 50, title = "Only show MA's within, ATR's", tooltip = "Hide MA's further that this number of ATR(14)'s from the last price.")                    


// --- LABELS --- 
i_sym1_htfmas_lblsShow           = input.bool    (group = IG_SYM1_HTFMAS_LBLS, inline = "lbls1", defval = true, title = "Show labels", tooltip = "")                    

// --- input lblSize --- {
i_sym1_htfmas_lblSize         = input.string  (group = IG_SYM1_HTFMAS_LBLS, inline = "lbls1", defval = "Normal", title="Size", options= ["Auto", "Tiny", "Small", "Normal", "Large", "Huge"])

//Turn the input into a proper label style value
isym1_htfmas_lblSize =        (i_sym1_htfmas_lblSize == "Auto")    ? size.auto  :
                              (i_sym1_htfmas_lblSize == "Tiny")    ? size.tiny  :
                              (i_sym1_htfmas_lblSize == "Small")   ? size.small :
                              (i_sym1_htfmas_lblSize == "Normal")  ? size.normal:
                              (i_sym1_htfmas_lblSize == "Large")   ? size.large :
                              (i_sym1_htfmas_lblSize == "Huge")    ? size.huge  :
                              size.normal

// END OF lblSize input }


i_sym1_htfmas_clrs_ovrd       = input.bool    (group = IG_SYM1_HTFMAS_CLRS, inline= "1", defval = true, title = "Apply to all TF's", tooltip = "If checked this settings will be applied to all timeframes.")                        
i_sym1_htfmas_ma1lnClr        = input.color   (group = IG_SYM1_HTFMAS_CLRS, inline = "clrs", defval = CLR_MA1, title = "MA1", tooltip = "")                                                    
i_sym1_htfmas_ma2lnClr        = input.color   (group = IG_SYM1_HTFMAS_CLRS, inline = "clrs", defval = CLR_MA2, title = "MA1", tooltip = "")                                                    
i_sym1_htfmas_ma3lnClr        = input.color   (group = IG_SYM1_HTFMAS_CLRS, inline = "clrs", defval = CLR_MA3, title = "MA1", tooltip = "")                                                    
i_sym1_htfmas_ma4lnClr        = input.color   (group = IG_SYM1_HTFMAS_CLRS, inline = "clrs", defval = CLR_MA4, title = "MA1", tooltip = "")                                                    
i_sym1_htfmas_ma5lnClr        = input.color   (group = IG_SYM1_HTFMAS_CLRS, inline = "clrs", defval = CLR_MA5, title = "MA1", tooltip = "")                                                    
i_sym1_htfmas_ma6lnClr        = input.color   (group = IG_SYM1_HTFMAS_CLRS, inline = "clrs", defval = CLR_MA6, title = "MA1", tooltip = "")                                                    


i_sym1_htfmas_type_ovrd     = input.bool    (group = IG_SYM1_HTFMAS_TYPE, inline= "1", defval = false, title = "Apply to all TF's", tooltip = "If checked this settings will be applied to all timeframes.")                        
i_sym1_htfmas_ma1MaType     = input.enum    (group = IG_SYM1_HTFMAS_TYPE, inline= "type", defval = MaTypes_EMA, title = "MA1", tooltip = "")                                                        
i_sym1_htfmas_ma2MaType     = input.enum    (group = IG_SYM1_HTFMAS_TYPE, inline= "type", defval = MaTypes_EMA, title = "MA2", tooltip = "")                                                        
i_sym1_htfmas_ma3MaType     = input.enum    (group = IG_SYM1_HTFMAS_TYPE, inline= "type", defval = MaTypes_EMA, title = "MA3", tooltip = "")                                                        
i_sym1_htfmas_ma4MaType     = input.enum    (group = IG_SYM1_HTFMAS_TYPE, inline= "type", defval = MaTypes_SMA, title = "MA4", tooltip = "")                                                        
i_sym1_htfmas_ma5MaType     = input.enum    (group = IG_SYM1_HTFMAS_TYPE, inline= "type", defval = MaTypes_SMA, title = "MA5", tooltip = "")                                                        
i_sym1_htfmas_ma6MaType     = input.enum    (group = IG_SYM1_HTFMAS_TYPE, inline= "type", defval = MaTypes_SMA, title = "MA6", tooltip = "")                                                        



i_sym1_htfmas_prd_ovrd     = input.bool    (group = IG_SYM1_HTFMAS_PRD, inline= "1", defval = false, title = "Apply to all TF's", tooltip = "If checked this settings will be applied to all timeframes.")                        
i_sym1_htfmas_ma1Prd       = input.int     (group = IG_SYM1_HTFMAS_PRD, inline= "prd", defval = 21  , title = "MA1", tooltip = "")                                                
i_sym1_htfmas_ma2Prd       = input.int     (group = IG_SYM1_HTFMAS_PRD, inline= "prd", defval = 50  , title = "MA2", tooltip = "")                                                
i_sym1_htfmas_ma3Prd       = input.int     (group = IG_SYM1_HTFMAS_PRD, inline= "prd", defval = 200 , title = "MA3", tooltip = "")                                                
i_sym1_htfmas_ma4Prd       = input.int     (group = IG_SYM1_HTFMAS_PRD, inline= "prd", defval = 21  , title = "MA4", tooltip = "")                                                
i_sym1_htfmas_ma5Prd       = input.int     (group = IG_SYM1_HTFMAS_PRD, inline= "prd", defval = 50  , title = "MA5", tooltip = "")                                                
i_sym1_htfmas_ma6Prd       = input.int     (group = IG_SYM1_HTFMAS_PRD, inline= "prd", defval = 200 , title = "MA6", tooltip = "")                                                

isym1_htfmas_lblStyle = label.style_label_left  


// END OF INPUTS - HTF MAs ALL TFs                                                   //}
//======================================================================================  

// ▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲ END OF ALL TFs  ▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲ }


// ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓ TF1  INPUT AND INIT ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓ {

// ♦♦♦♦♦♦ INPUTS - htfBasicData TF1 ♦♦♦♦♦♦ //{
// --- input text constants --- {
const string IG_SYM1TF1 = "▓▓▓▓▓▓▓▓▓▓▓▓▓ TF1 ▓▓▓▓▓▓▓▓▓▓▓▓▓"
// END OF input text const }

// -------- Timeframes & symbols inputs --------{

// SYMBOLS
// i_sym1_enabled = input.bool     (group = "SYMBOLS", inline="SYM1", defval = true, title="")
// i_sym1 = input.symbol        (group = "SYMBOLS", inline="SYM1", defval = "BYBIT:BTCUSDT", title = "Symbol 1")
i_sym1tf1_enabled       = input.bool        (display = display.none, group=IG_SYM1TF1, inline="SYM1_TF1", defval = true,  title='TF1:')
i_sym1tf1_tf            = input.timeframe   (display = display.none, group=IG_SYM1TF1, inline="SYM1_TF1", defval = "60",   title='', tooltip = TT_HTFMAS_TF)
isym1tf1_enabled        = i_sym1tf1_enabled and ( (timeframe.in_seconds(i_sym1tf1_tf) >= timeframe.in_seconds(timeframe.period)) or i_sym1_htfmas_showSmallerTFs ) and i_sym1_htfmas_enableAll


// for req.sec(): added 1D-->D and 1W --> W conversion (i_tf1 --> var itf1) (strange that input.timeframe returns "1D" and "1W")
var isym1tf1_tf = switch i_sym1tf1_tf 
    "1D" => "D"
    "1W" => "W" 
    "1M" => "M" 
    "" => timeframe.period
    => i_sym1tf1_tf

// END OF timeframe  inputs }

// ▲▲▲ END OF INPUTS - htfBasicData     ▲▲▲ //}

// ♦♦♦♦♦♦ INPUTS - HTFMAs TF1 ♦♦♦♦♦♦ //{

// --- input text constants ---
const string IG_SYM1TF1_HTFMAS_ALL = "━━━━━━ settings for ALL TF1 MAs ━━━━━━"
const string IG_SYM1TF1_HTFMAS_MAIN = "━━━━━━ TF1 MAs main parameters ━━━━━━"
const string IG_SYM1TF1_HTFMAS_DRAW = "━━━━━━ TF1 MAs vizualization ━━━━━━"


// --- general (for all MAs of the TF) ---  

// disable HTF MAs if the whole TF is disabled, enable LTF MA's if explicitly allowed
i_sym1tf1_htfmas_enabled        = input.enum  (display = display.none, group = IG_SYM1TF1_HTFMAS_ALL, inline= "1", defval = MaEnable_individualy, title = "Enabled:", tooltip = "Enable all MA's of this timeframe. (Overrides individual settings. Enable all/ disable all override CSV settings.).")
isym1tf1_htfmas_enabled        = isym1tf1_enabled == false ? MaEnable_disableAll : i_sym1tf1_htfmas_enabled 

// --- override ShowHistory if set for all TF's --- 
i_sym1tf1_htfmas_showHistory    = input.enum  (display = display.none, group = IG_SYM1TF1_HTFMAS_ALL, inline= "1", defval = MaDraw_individualy, title = "Show history (for all TF's MAs)", tooltip = "Draw MA lines on chart. Overrides all individual settings below.")                        
isym1tf1_htfmas_showHistory =  i_sym1_htfmas_showHistory == MaDraw_lines_and_labels ? MaDraw_lines_and_labels :  i_sym1_htfmas_showHistory  == MaDraw_only_labels ? MaDraw_only_labels  : i_sym1tf1_htfmas_showHistory


i_sym1tf1_htfmas_lnWidth        = input.int     (display = display.none, group = IG_SYM1TF1_HTFMAS_ALL, inline= "line", defval = 1, title = "Line width", tooltip = "")                                                    
i_sym1tf1_htfmas_lnWidth_ovrd   = input.bool    (display = display.none, group = IG_SYM1TF1_HTFMAS_ALL, inline= "line", defval = true, title = "Make all TF's MA's same width", tooltip = "If checked this settings will be applied to all MA's of this timeframe.")                        
i_sym1tf1_htfmas_smoothen       = input.bool     (display = display.none, group = IG_SYM1TF1_HTFMAS_ALL, inline= "line", defval = false, title = "Smoothen", tooltip = TT_HTFMAS_SMOOTHEN)                                                    
isym1tf1_htfmas_smoothen = i_sym1_htfmas_smoothen == MaSmoothen_all ? true 
                          : i_sym1_htfmas_smoothen == MaSmoothen_none ? false : i_sym1tf1_htfmas_smoothen 


// --- individual MA settings ---
i_sym1tf1_htfmas_ma1Enabled         = input.bool    (group = IG_SYM1TF1_HTFMAS_MAIN, inline= "ma1", defval = true, title = "MA1", tooltip = "")                                        
i_sym1tf1_htfmas_ma1ShowHistory     = input.bool    (group = IG_SYM1TF1_HTFMAS_MAIN, inline= "ma1", defval = true, title = "Hist", tooltip = "When 'Show history' is unchecked only a short horisontal line to the right of the last bar is shown.)")                        
i_sym1tf1_htfmas_ma1MaType          = input.enum    (group = IG_SYM1TF1_HTFMAS_MAIN, inline= "ma1", defval = MaTypes_EMA, title = "", tooltip = "")                                                        
i_sym1tf1_htfmas_ma1Prd             = input.int     (group = IG_SYM1TF1_HTFMAS_MAIN, inline= "ma1", defval = 21, title = "", tooltip = "")                                                
//i_sym1tf1_htfmas_ma1Src             = input.string  (group = IG_SYM1TF1_HTFMAS_MAIN, inline= "ma1", defval = "close", title = "", tooltip = "", options = ["close", "hlc3"])                                                                      
i_sym1tf1_htfmas_ma2Enabled         = input.bool    (group = IG_SYM1TF1_HTFMAS_MAIN, inline= "ma2", defval = false, title = "MA2", tooltip = "")                                        
i_sym1tf1_htfmas_ma2ShowHistory     = input.bool    (group = IG_SYM1TF1_HTFMAS_MAIN, inline= "ma2", defval = true, title = "Hist", tooltip = "When 'Show history' is unchecked only a short horisontal line to the right of the last bar is shown.)")                        
i_sym1tf1_htfmas_ma2MaType          = input.enum    (group = IG_SYM1TF1_HTFMAS_MAIN, inline= "ma2", defval = MaTypes_EMA, title = "", tooltip = "")                                                        
i_sym1tf1_htfmas_ma2Prd             = input.int     (group = IG_SYM1TF1_HTFMAS_MAIN, inline= "ma2", defval = 50, title = "", tooltip = "")                                                
//i_sym1tf1_htfmas_ma2Src             = input.string  (group = IG_SYM1TF1_HTFMAS_MAIN, inline= "ma2", defval = "close", title = "", tooltip = "", options = ["close", "hlc3"])                                                                      
i_sym1tf1_htfmas_ma3Enabled         = input.bool    (group = IG_SYM1TF1_HTFMAS_MAIN, inline= "ma3", defval = false, title = "MA3", tooltip = "")                                        
i_sym1tf1_htfmas_ma3ShowHistory     = input.bool    (group = IG_SYM1TF1_HTFMAS_MAIN, inline= "ma3", defval = true, title = "Hist", tooltip = "When 'Show history' is unchecked only a short horisontal line to the right of the last bar is shown.)")                        
i_sym1tf1_htfmas_ma3MaType          = input.enum    (group = IG_SYM1TF1_HTFMAS_MAIN, inline= "ma3", defval = MaTypes_EMA, title = "", tooltip = "")                                                        
i_sym1tf1_htfmas_ma3Prd             = input.int     (group = IG_SYM1TF1_HTFMAS_MAIN, inline= "ma3", defval = 200, title = "", tooltip = "")                                                
//i_sym1tf1_htfmas_ma3Src             = input.string  (group = IG_SYM1TF1_HTFMAS_MAIN, inline= "ma3", defval = "close", title = "", tooltip = "", options = ["close", "hlc3"])                                                                      
i_sym1tf1_htfmas_ma4Enabled         = input.bool    (group = IG_SYM1TF1_HTFMAS_MAIN, inline= "ma4", defval = false, title = "MA4", tooltip = "")                                        
i_sym1tf1_htfmas_ma4ShowHistory     = input.bool    (group = IG_SYM1TF1_HTFMAS_MAIN, inline= "ma4", defval = true, title = "Hist", tooltip = "When 'Show history' is unchecked only a short horisontal line to the right of the last bar is shown.)")                        
i_sym1tf1_htfmas_ma4MaType          = input.enum    (group = IG_SYM1TF1_HTFMAS_MAIN, inline= "ma4", defval = MaTypes_SMA, title = "", tooltip = "")                                                        
i_sym1tf1_htfmas_ma4Prd             = input.int     (group = IG_SYM1TF1_HTFMAS_MAIN, inline= "ma4", defval = 21, title = "", tooltip = "")                                                
//i_sym1tf1_htfmas_ma4Src             = input.string  (group = IG_SYM1TF1_HTFMAS_MAIN, inline= "ma4", defval = "close", title = "", tooltip = "", options = ["close", "hlc3"])                                                                      
i_sym1tf1_htfmas_ma5Enabled         = input.bool    (group = IG_SYM1TF1_HTFMAS_MAIN, inline= "ma5", defval = false, title = "MA5", tooltip = "")                                        
i_sym1tf1_htfmas_ma5ShowHistory     = input.bool    (group = IG_SYM1TF1_HTFMAS_MAIN, inline= "ma5", defval = true, title = "Hist", tooltip = "When 'Show history' is unchecked only a short horisontal line to the right of the last bar is shown.)")                        
i_sym1tf1_htfmas_ma5MaType          = input.enum    (group = IG_SYM1TF1_HTFMAS_MAIN, inline= "ma5", defval = MaTypes_SMA, title = "", tooltip = "")                                                        
i_sym1tf1_htfmas_ma5Prd             = input.int     (group = IG_SYM1TF1_HTFMAS_MAIN, inline= "ma5", defval = 50, title = "", tooltip = "")                                                
//i_sym1tf1_htfmas_ma5Src             = input.string  (group = IG_SYM1TF1_HTFMAS_MAIN, inline= "ma5", defval = "close", title = "", tooltip = "", options = ["close", "hlc3"])                                                                      
i_sym1tf1_htfmas_ma6Enabled         = input.bool    (group = IG_SYM1TF1_HTFMAS_MAIN, inline= "ma6", defval = false, title = "MA6", tooltip = "")                                        
i_sym1tf1_htfmas_ma6ShowHistory     = input.bool    (group = IG_SYM1TF1_HTFMAS_MAIN, inline= "ma6", defval = true, title = "Hist", tooltip = "When 'Show history' is unchecked only a short horisontal line to the right of the last bar is shown.)")                        
i_sym1tf1_htfmas_ma6MaType          = input.enum    (group = IG_SYM1TF1_HTFMAS_MAIN, inline= "ma6", defval = MaTypes_SMA, title = "", tooltip = "")                                                        
i_sym1tf1_htfmas_ma6Prd             = input.int     (group = IG_SYM1TF1_HTFMAS_MAIN, inline= "ma6", defval = 200, title = "", tooltip = "")                                                
//i_sym1tf1_htfmas_ma6Src             = input.string  (group = IG_SYM1TF1_HTFMAS_MAIN, inline= "ma6", defval = "close", title = "", tooltip = "", options = ["close", "hlc3"])                                                                      

i_sym1tf1_htfmas_ma1lnClr           = input.color   (group = IG_SYM1TF1_HTFMAS_DRAW, inline= "ma1-d", defval = CLR_MA1, title = "MA1", tooltip = "")                                                    
i_sym1tf1_htfmas_ma2lnClr           = input.color   (group = IG_SYM1TF1_HTFMAS_DRAW, inline= "ma2-d", defval = CLR_MA2, title = "MA2", tooltip = "")                                                    
