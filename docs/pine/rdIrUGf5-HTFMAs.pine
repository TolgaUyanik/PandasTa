// ━━━━━━  importConfigDrw() ━━━━━━ {




// @function Imports HTF MAs settings from objProps (of any level) into MaDrawing object
// @returns Timeframe period read from config
_importConfigDrw(htfmas, oCfg, maCount) => 
    var arCfgKeysDrw = array.from("color", "width", "style", "showHistory", "showLabel")
    if not na(oCfg)
        // import  properties of individual MaDrawing's
        for key in arCfgKeysDrw
            _importPropAr(oCfg, key, htfmas, maCount)

        // import properties of HTFMA's itself
        htfmas.smoothen :=  oCfg.mpS.get("smoothen") == "1" ? true : false // na results in false 

    htfmas

