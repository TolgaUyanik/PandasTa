[s1tf1HtfBi, s1tf1Ma1, s1tf1Ma2, s1tf1Ma3, s1tf1Ma4, s1tf1Ma5, s1tf1Ma6] = request.security(syminfo.tickerid, i_sym1tf1_tf, sym1tf1_htfmas_rsPrms.htfUpdateTuple(i_sym1_htfmas_repaint))
