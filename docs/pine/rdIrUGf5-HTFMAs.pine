i_sym1tf1_htfmas_ma4lnClr           = input.color   (group = IG_SYM1TF1_HTFMAS_DRAW, inline= "ma4-d", defval =CLR_MA1, title = "MA4", tooltip = "")                                                    
i_sym1tf1_htfmas_ma5lnClr           = input.color   (group = IG_SYM1TF1_HTFMAS_DRAW, inline= "ma5-d", defval = CLR_MA2, title = "MA5", tooltip = "")                                                    
i_sym1tf1_htfmas_ma6lnClr           = input.color   (group = IG_SYM1TF1_HTFMAS_DRAW, inline= "ma6-d", defval = CLR_MA3, title = "MA6", tooltip = "")                                                    
i_sym1tf1_htfmas_ma1lnWidth         = input.int     (group = IG_SYM1TF1_HTFMAS_DRAW, inline= "ma1-d", defval = 1, title = "Width", tooltip = "")                                                    
i_sym1tf1_htfmas_ma2lnWidth         = input.int     (group = IG_SYM1TF1_HTFMAS_DRAW, inline= "ma2-d", defval = 1, title = "Width", tooltip = "")                                                    
i_sym1tf1_htfmas_ma3lnWidth         = input.int     (group = IG_SYM1TF1_HTFMAS_DRAW, inline= "ma3-d", defval = 1, title = "Width", tooltip = "")                                                    
i_sym1tf1_htfmas_ma4lnWidth         = input.int     (group = IG_SYM1TF1_HTFMAS_DRAW, inline= "ma4-d", defval = 1, title = "Width", tooltip = "")                                                    
i_sym1tf1_htfmas_ma5lnWidth         = input.int     (group = IG_SYM1TF1_HTFMAS_DRAW, inline= "ma5-d", defval = 1, title = "Width", tooltip = "")                                                    
i_sym1tf1_htfmas_ma6lnWidth         = input.int     (group = IG_SYM1TF1_HTFMAS_DRAW, inline= "ma6-d", defval = 1, title = "Width", tooltip = "")                                                    
i_sym1tf1_htfmas_ma1ShowLabel       = input.bool    (group = IG_SYM1TF1_HTFMAS_DRAW, inline= "ma1-d", defval = true, title = "Label", tooltip = "")                                                    
i_sym1tf1_htfmas_ma2ShowLabel       = input.bool    (group = IG_SYM1TF1_HTFMAS_DRAW, inline= "ma2-d", defval = true, title = "Label", tooltip = "")                                                    
i_sym1tf1_htfmas_ma3ShowLabel       = input.bool    (group = IG_SYM1TF1_HTFMAS_DRAW, inline= "ma3-d", defval = true, title = "Label", tooltip = "")                                                    
