//----------- +++++++++++++++++++++ ----------- 
// ━━━━━━ MA calc functions ━━━━━━ {

// --- pine_ema() --- {
// @function Works exactly like ta.ema() but accepts `series length`. (ta.ema() requires `simple length`)
pine_ema(src, length) =>
    alpha = 2 / (length + 1)
    sum = 0.0
    sum := na(sum[1]) ? src : alpha * src + (1 - alpha) * nz(sum[1])
// END OF pine_ema() }

// --- pine_hma() --- {
// @function Works exactly like ta.hma() but accepts `series length`. (ta.ema() requires `simple length`)
pine_hma(float src, int length) => 
    wma1=2*ta.wma(close,math.round(length/2))
    wma2=ta.wma(close,length)
    diff=wma1-wma2
    sqn=math.round(math.sqrt(length))
    ta.wma(diff, sqn)
// END OF pine_hma() }

// --- pine_rma() --- {
pine_rma(src, length) =>
    alpha = 1/length
    sum = 0.0
    sum := na(sum[1]) ? ta.sma(src, length) : alpha * src + (1 - alpha) * nz(sum[1])
// END OF pine_rma() }

// --- f_tema(_src, _length) ---{
// borowed from https://www.tradingview.com/script/IzmSs7Ma-Multi-Timeframe-Moving-Average-xdecow/ by @xdecow
// @function Calculates Triple Exponential Moving Average (TEMA)
f_tema(_src, _length) =>
    e1 = ta.ema2(_src, _length)
    e2 = ta.ema2(e1, _length)
    e3 = ta.ema2(e2, _length)
    (3 * e1) - (3 * e2) + e3
//}

// --- f_mvwap(_src, _length, vol) ---{
// borowed from https://www.tradingview.com/script/IzmSs7Ma-Multi-Timeframe-Moving-Average-xdecow/ by @xdecow
// @function Calculates moving volume-weighted average price (MVWAP) 
f_mvwap(src, length, vol) =>
    uvol = vol
    uwgt = vol * src

    if length < 1
        na
    else
        for i = 1 to length - 1
            uvol := uvol + vol[i]
            uwgt := uwgt + vol[i] * src[i]
        uwgt / uvol

//}

// --- f_dema(_src, _length) ---{
// borowed from https://www.tradingview.com/script/IzmSs7Ma-Multi-Timeframe-Moving-Average-xdecow/ by @xdecow
// @function Calculates Double Exponential Moving Average (TEMA)
f_dema(_src, _length) =>
    e1 = ta.ema(_src, _length)
    e2 = ta.ema(e1, _length)
    2 * e1 - e2
//}

// --- f_tef_smmama(_src, _length) ---{
// borowed from https://www.tradingview.com/script/IzmSs7Ma-Multi-Timeframe-Moving-Average-xdecow/ by @xdecow
// @function Calculates Smoothed Moving Average (SMMA) 
f_smma(_src, _length) =>
    sma = ta.sma(_src, _length)
    float smma = 0.0
    smma := na(smma[1]) ? sma : (smma[1] * (_length - 1) + _src) / _length
//}

// --- calcMa(string maType, int prd) --- {
// @function  Calculates MA of given type, period and source.
// @param maType (MaTypes) type of the MA as a value of enum MaTypes corresponding to SMA, EMA, WMA, VMAA, SWMA, HMA, RMA, TEMA, VWAP.
// @param prd (int) MA's period
// @param srcName  (string) Determines source of the ma ("close", "open", "high", "high", "low", "hl2", "hlc3", "ohlc4", "hlcc4").
// @returns value of the moving average
calcMa(MaTypes maType, int prd, string srcName = "close") =>
    src = switch srcName
        "close"     => close
        "open"      => open
        "high"      => high
        "high"      => high
        "low"       => low
        "hl2"       => hl2
        "hlc3"      => hlc3
        "ohlc4"     => ohlc4
        "hlcc4"     => hlcc4
        =>
            runtime.error(str.format("calcMa(): unknown srcName = {0}", srcName))
            1.

    _prd = math.max(1, prd)

    switch maType
        MaTypes.SMA       => ta.sma       (src, _prd) 
        MaTypes.EMA       => pine_ema     (src, _prd) 
        MaTypes.WMA       => ta.wma       (src, _prd)  
        MaTypes.VMAA      => ta.vwma      (src, _prd) 
        MaTypes.SWMA      => ta.swma      (src) 
        MaTypes.HMA       => pine_hma       (src, _prd) 
        MaTypes.RMA       => pine_rma       (src, _prd) 
        MaTypes.TEMA      => f_tema       (src, _prd) 
        MaTypes.VWAP      => ta.vwap(src)
        => 
            runtime.error(str.format("calcMa(): unknown maType = {0}", str.tostring(maType)))
            1.

// END OF calcMa(). }

// ^^^ END OF MA calc func ^^^}
//----------- +++++++++++++++++++++ ----------- 

//----------- +++++++++++++++++++++ ----------- 
// ━━━━━━ rsRet htfUpdateTuple() ━━━━━━ { 
// @function (HTF) Calculates MAs within request.security() context 
// @params rsParams (RsParamsMAs) Calculation parameters of MA's
// @params repaint (bool) Whether to update MA' within this req.sec() context on realtime bars (if true) or wait until bar close.
export method htfUpdateTuple(RsParamsMAs rsParams , bool repaint ) => 
    htfBi = bar_index
    ma1 = float(na)
    ma2 = float(na)
    ma3 = float(na)
    ma4 = float(na)
    ma5 = float(na)
    ma6 = float(na)
    if rsParams .ma1CalcParams.enabled and not na(rsParams .ma1CalcParams.prd)
        if na(rsParams .ma1CalcParams.maType) or not (rsParams .ma1CalcParams.prd > 0) 
            runtime.error(str.format("htfUpdate(): ma1:  maType = {0}, prd = {1}", str.tostring(rsParams .ma1CalcParams.maType), rsParams .ma1CalcParams.prd))
        ma1 := calcMa(rsParams .ma1CalcParams.maType, rsParams .ma1CalcParams.prd, rsParams .ma1CalcParams.src) [ barstate.isrealtime and not(repaint ) ? 1 : 0 ]
    
    if rsParams .ma2CalcParams.enabled and not na(rsParams .ma2CalcParams.prd)
        if na(rsParams .ma2CalcParams.maType) or not (rsParams .ma2CalcParams.prd > 0) 
            runtime.error(str.format("htfUpdate(): ma2:  maType = {0}, prd = {1}", str.tostring(rsParams .ma2CalcParams.maType), rsParams .ma2CalcParams.prd))
        ma2 := calcMa(rsParams .ma2CalcParams.maType, rsParams .ma2CalcParams.prd, rsParams .ma2CalcParams.src) [ barstate.isrealtime and not(repaint ) ? 1 : 0 ]

    if rsParams .ma3CalcParams.enabled and not na(rsParams .ma3CalcParams.prd)
        if na(rsParams .ma3CalcParams.maType) or not (rsParams .ma3CalcParams.prd > 0) 
            runtime.error(str.format("htfUpdate(): ma3:  maType = {0}, prd = {1}", str.tostring(rsParams .ma3CalcParams.maType), rsParams .ma3CalcParams.prd))
        ma3 := calcMa(rsParams .ma3CalcParams.maType, rsParams .ma3CalcParams.prd, rsParams .ma3CalcParams.src) [ barstate.isrealtime and not(repaint ) ? 1 : 0 ]

    if rsParams .ma4CalcParams.enabled and not na(rsParams .ma4CalcParams.prd)
        if na(rsParams .ma4CalcParams.maType) or not (rsParams .ma4CalcParams.prd > 0) 
            runtime.error(str.format("htfUpdate(): ma4:  maType = {0}, prd = {1}", str.tostring(rsParams .ma4CalcParams.maType), rsParams .ma4CalcParams.prd))
        ma4 := calcMa(rsParams .ma4CalcParams.maType, rsParams .ma4CalcParams.prd, rsParams .ma4CalcParams.src) [ barstate.isrealtime and not(repaint ) ? 1 : 0 ]

    if rsParams .ma5CalcParams.enabled and not na(rsParams .ma5CalcParams.prd)
        if na(rsParams .ma5CalcParams.maType) or not (rsParams .ma5CalcParams.prd > 0) 
            runtime.error(str.format("htfUpdate(): ma5:  maType = {0}, prd = {1}", str.tostring(rsParams .ma5CalcParams.maType), rsParams .ma5CalcParams.prd))
        ma5 := calcMa(rsParams .ma5CalcParams.maType, rsParams .ma5CalcParams.prd, rsParams .ma5CalcParams.src) [ barstate.isrealtime and not(repaint ) ? 1 : 0 ]

    if rsParams .ma6CalcParams.enabled and not na(rsParams .ma6CalcParams.prd)
        if na(rsParams .ma6CalcParams.maType) or not (rsParams .ma6CalcParams.prd > 0) 
            runtime.error(str.format("htfUpdate(): ma6:  maType = {0}, prd = {1}", str.tostring(rsParams .ma6CalcParams.maType), rsParams .ma6CalcParams.prd))
        ma6 := calcMa(rsParams .ma6CalcParams.maType, rsParams .ma6CalcParams.prd, rsParams .ma6CalcParams.src) [ barstate.isrealtime and not(repaint ) ? 1 : 0 ]

    [htfBi, ma1, ma2, ma3, ma4, ma5, ma6]    

// END OF rsRet htfUpdateTuple()  }
//------------------------------------------------


//----------- +++++++++++++++++++++ -----------
//----------- MaDrawing  TYPE -----------{

// +++ MaDrawing type +++ {
// @type  MA's plot parameters plus drawing objects for MA's current level (line and label). 
// @field lnClr           (color)       MA plot line color (like in plot())      
// @field lnWidth         (int)         MA plot line width (like in plot())      
// @field lnStyle         (string)      MA plot line style (like in plot())      
// @field showHistory     (bool)        Whether to plot the MA on historical bars or only show current level to the right of the latest bar.
// @field showLabel       (bool)        Whether to show the name of the MA to the right of the MA's level
// @field ln              (line)        line to show MA"s current level 
// @field lbl             (label)       label showing MA's name
export type MaDrawing
    // bool        enabled
    // --- plot params --- 
    color       lnClr
    int         lnWidth
    string      lnStyle
    bool        showHistory
    bool        showLabel = true
    // --- line & label --- 
    line        ln
    label       lbl

// END OF MaDrawing type}


// --- clear(drw) --- {
// @function Deletes drawing objects (line and label) of a MaDrawing object
export method clear(MaDrawing  this) =>
    this.ln := na
    this.lbl  := na
// END OF importRsRet() }


// ^^^ END OF MaDrawing TYPE  ^^^ }  
//----------------------------------------------

//----------- +++++++++++++++++++++ -----------
//----------- HTFMAs TYPE  -----------{

// --- +++ HTFMAs  TYPE +++ --- {
// @type Contains data and drawing parameters for MA's of one timeframe (MA calculation parameters for MA's of one timeframe are in a separate object RsParamsMAs)
// @field rsRet         (RsReturnMAs) Contains data returned from req.sec(). Is set to na in between HTF bar changes if smoothing is enabled. 
// @field rsRetLast     (RsReturnMAs) Contains a copy of data returned from req.sec() in case rsRet is set to na for smoothing.
// @field rsRetNaObj    (RsReturnMAs) An empty object as `na` placeholder
// @field ma1Drawing (MaDrawing) MA drawing properties 
// @field ma2Drawing (MaDrawing) MA drawing properties 
// @field ma3Drawing (MaDrawing) MA drawing properties 
// @field ma4Drawing (MaDrawing) MA drawing properties 
// @field ma5Drawing (MaDrawing) MA drawing properties 
// @field ma6Drawing (MaDrawing) MA drawing properties 
// @field enabled           (bool  )  Enables/disables all of the MAs of one timeframe.          
// @field tf                (string)  Timeframe      
// @field showHistory       (bool  )  Plot MA line on historical bars              
// @field rngAtrQ           (int   )  A multiplier for atr(14). Determines a range within which the MA's will be plotted.  MA's too far away will not be plotted.        
// @field showRecentBars    (int   )  Only plot MA on these recent bars
// @field smoothen          (bool  )  Smoothen MA plot. If false the same HTF value is returned on all chart bars within a HTF bar (intrabars), so the plot looks like steps.            
// @field lblsOffset        (int   )  Show MA name this number of bars to the right off last bar.               
// @field lblsShow          (bool  )  Show MA name              
// @field lnOffset          (int   )  Start line showing current level of the MA this number of bars to the right off the last bar.             
// @field lblSize           (string)  Label size           
// @field lblStyle          (string)  Label style                
// @field lblTxtAlign       (string)  Label text align              
// @field bPopupLabel       (bool  )  Show current MA value as a tooltip to MA's name.              
export type HTFMAs
    RsReturnMAs                    rsRet
    RsReturnMAs                    rsRetLast // last non na, smoothing kills rsRet on HTF intrabars, have to store latest MA values
    RsReturnMAs                    rsRetNaObj


    // --- draw params ---
    MaDrawing              ma1Drawing
    MaDrawing              ma2Drawing
    MaDrawing              ma3Drawing
    MaDrawing              ma4Drawing
    MaDrawing              ma5Drawing
    MaDrawing              ma6Drawing


    // --- general draw params --- 
    bool                        enabled
    string                      tf
    // --- plot params --- 
    bool                        showHistory
    int                         rngAtrQ  
    int                         showRecentBars
    bool                        smoothen
    float                       dispBandWidth

    // --- label and line params --- 
    int                         lblsOffset
    bool                        lblsShow
    int                         lnOffset
    string                      lblSize
    string                      lblStyle
    string                      lblTxtAlign // calculated based on lblStyle, no input
    bool                        bPopupLabel


// END OF HTFMAs type }

// --- +++ BASIC METHODS +++ --- {

// --- init() --- {
// @function Inits HTFMAs object containing data and drawing properties for MA's of one timeframe.
// @param enableAll      (MaEnable) MaEnable.enableAll/disableAll switch all MA's on'off. MaEnable.individually 
// @param tf             (string)   Timeframe      
// @param showHistory    (bool  )   Plot MA line on historical bars              
// @param rngAtrQ        (int   )   A multiplier for atr(14). Determines a range within which the MA's will be plotted.  MA's too far away will not be plotted.        
// @param showRecentBars (int   )   Only plot MA on these recent bars
// @param smoothen       (bool  )   Smoothen MA plot. If false the same HTF value is returned on all chart bars within a HTF bar (intrabars), so the plot looks like steps.            
// @param lblsOffset     (int   )   Show MA name this number of bars to the right off last bar.               
// @param lblsShow       (bool  )   Show MA name              
// @param lnOffset       (int   )   Start line showing current level of the MA this number of bars to the right off the last bar.             
// @param lblSize        (string)   Label size like in label.new()         
// @param lblStyle       (string)   Label style like in label.new()               
// @param ma1lnClr       (color)    MA plot line color (like in plot())      
// @param ma1lnWidth     (int)      MA plot line width (like in plot())      
// @param ma1lnStyle     (string)   MA plot line style (like in plot())      
// @param ma1ShowHistory (bool)     Whether to plot the MA on historical bars or only show current level to the right of the latest bar.
// @param ma1ShowLabel   (bool)     Whether to show the name of the MA to the right of the MA's level
// @param ma2lnClr       (color)    MA plot line color (like in plot())      
// @param ma2lnWidth     (int)      MA plot line width (like in plot())      
// @param ma2lnStyle     (string)   MA plot line style (like in plot())      
// @param ma2ShowHistory (bool)     Whether to plot the MA on historical bars or only show current level to the right of the latest bar.
// @param ma2ShowLabel   (bool)     Whether to show the name of the MA to the right of the MA's level
// @param ma3lnClr       (color)    MA plot line color (like in plot())      
// @param ma3lnWidth     (int)      MA plot line width (like in plot())      
// @param ma3lnStyle     (string)   MA plot line style (like in plot())      
// @param ma3ShowHistory (bool)     Whether to plot the MA on historical bars or only show current level to the right of the latest bar.
// @param ma3ShowLabel   (bool)     Whether to show the name of the MA to the right of the MA's level
// @param ma4lnClr       (color)    MA plot line color (like in plot())      
// @param ma4lnWidth     (int)      MA plot line width (like in plot())      
// @param ma4lnStyle     (string)   MA plot line style (like in plot())      
// @param ma4ShowHistory (bool)     Whether to plot the MA on historical bars or only show current level to the right of the latest bar.
// @param ma4ShowLabel   (bool)     Whether to show the name of the MA to the right of the MA's level
// @param ma5lnClr       (color)    MA plot line color (like in plot())      
// @param ma5lnWidth     (int)      MA plot line width (like in plot())      
// @param ma5lnStyle     (string)   MA plot line style (like in plot())      
// @param ma5ShowHistory (bool)     Whether to plot the MA on historical bars or only show current level to the right of the latest bar.
// @param ma5ShowLabel   (bool)     Whether to show the name of the MA to the right of the MA's level
// @param ma6lnClr       (color)    MA plot line color (like in plot())      
// @param ma6lnWidth     (int)      MA plot line width (like in plot())      
// @param ma6lnStyle     (string)   MA plot line style (like in plot())      
// @param ma6ShowHistory (bool)     Whether to plot the MA on historical bars or only show current level to the right of the latest bar.
// @param ma6ShowLabel   (bool)     Whether to show the name of the MA to the right of the MA's level
export method init(HTFMAs this
                  , MaEnable    enableAll      
                  , string      tf               
                  , int         rngAtrQ          
                  , int         showRecentBars  = 100000     
                  , int         lblsOffset      = 15 
                  , bool        lblsShow        = true 
                  , int         lnOffset        = 1 
                  , string      lblSize         = size.normal
                  , string      lblStyle        = label.style_label_left
                  , bool        smoothen
                  , color       ma1lnClr          = na 
                  , int         ma1lnWidth      = 1
                  , string      ma1lnStyle       = "solid"
                  , color       ma2lnClr          = na
                  , int         ma2lnWidth      = 1
                  , string      ma2lnStyle       = "solid"
                  , color       ma3lnClr          = na
                  , int         ma3lnWidth      = 1
                  , string      ma3lnStyle       = "solid"
                  , color       ma4lnClr          = na
                  , int         ma4lnWidth      = 1
                  , string      ma4lnStyle       = "solid"
                  , color       ma5lnClr          = na
                  , int         ma5lnWidth      = 1
                  , string      ma5lnStyle       = "solid"
                  , color       ma6lnClr          = na
                  , int         ma6lnWidth      = 1
                  , string      ma6lnStyle       = "solid"
                  , bool        ma1ShowHistory  = true
                  , bool        ma2ShowHistory  = true
                  , bool        ma3ShowHistory  = true
                  , bool        ma4ShowHistory  = true
                  , bool        ma5ShowHistory  = true
                  , bool        ma6ShowHistory  = true
                  , bool        ma1ShowLabel    = true
                  , bool        ma2ShowLabel    = true
                  , bool        ma3ShowLabel    = true
                  , bool        ma4ShowLabel    = true
                  , bool        ma5ShowLabel    = true
                  , bool        ma6ShowLabel    = true
                  ) =>    

    
    // --- create and init objects --- 
    this.rsRetNaObj     := RsReturnMAs.new()
    this.rsRet          := this.rsRetNaObj
    this.rsRetLast      := this.rsRetNaObj


    // drw created with na lb/ln, created when needed
    this.ma1Drawing  := MaDrawing.new()
    this.ma2Drawing  := MaDrawing.new()
    this.ma3Drawing  := MaDrawing.new()
    this.ma4Drawing  := MaDrawing.new()
    this.ma5Drawing  := MaDrawing.new()
    this.ma6Drawing  := MaDrawing.new()






    // --- input params ---

    _ma1lnStyle = ma1lnStyle == "solid" ? line.style_solid : ma1lnStyle == "dashed" ? line.style_dashed : line.style_dotted
    _ma2lnStyle = ma2lnStyle == "solid" ? line.style_solid : ma2lnStyle == "dashed" ? line.style_dashed : line.style_dotted
    _ma3lnStyle = ma3lnStyle == "solid" ? line.style_solid : ma3lnStyle == "dashed" ? line.style_dashed : line.style_dotted
    _ma4lnStyle = ma4lnStyle == "solid" ? line.style_solid : ma4lnStyle == "dashed" ? line.style_dashed : line.style_dotted
    _ma5lnStyle = ma5lnStyle == "solid" ? line.style_solid : ma5lnStyle == "dashed" ? line.style_dashed : line.style_dotted
    _ma6lnStyle = ma6lnStyle == "solid" ? line.style_solid : ma6lnStyle == "dashed" ? line.style_dashed : line.style_dotted


    this.tf              := tf       
    
    
  // if tf is disabled or lower than chart's tf (and it is not allowed) then in INPUT section isym1tf1_htfmas_enabled is set to disableAll 
    this.enabled         := enableAll != MaEnable.disableAll  
  
    this.rngAtrQ         := rngAtrQ               
    this.showRecentBars  := showRecentBars < 0 ? na :   showRecentBars                 
    this.smoothen        := smoothen
    this.lblsOffset      := lblsOffset               
    this.lblsShow        := lblsShow                   
    this.lnOffset        := lnOffset               
    this.lblSize         := lblSize               
    this.lblStyle        := lblStyle               


    this.lblTxtAlign                               :=    switch lblStyle 
        label.style_label_center      => text.align_center  
        label.style_label_up          => text.align_center  
        label.style_label_down        => text.align_center  
        label.style_label_right       => text.align_right  
        label.style_label_left        => text.align_left  
        label.style_label_upper_left  => text.align_left    
        label.style_label_upper_right => text.align_right   
        label.style_label_lower_left  => text.align_left    
        label.style_label_lower_right => text.align_right   
        label.style_none              => text.align_center    
        => text.align_left 



    // this.ma1Drawing.enabled                   := (enableAll  == MaEnable.enableAll ? true : enableAll  == MaEnable.disableAll ? false : ma1Enabled ) 
    // this.ma2Drawing.enabled                   := (enableAll  == MaEnable.enableAll ? true : enableAll  == MaEnable.disableAll ? false : ma2Enabled ) 
    // this.ma3Drawing.enabled                   := (enableAll  == MaEnable.enableAll ? true : enableAll  == MaEnable.disableAll ? false : ma3Enabled ) 
    // this.ma4Drawing.enabled                   := (enableAll  == MaEnable.enableAll ? true : enableAll  == MaEnable.disableAll ? false : ma4Enabled ) 
    // this.ma5Drawing.enabled                   := (enableAll  == MaEnable.enableAll ? true : enableAll  == MaEnable.disableAll ? false : ma5Enabled ) 
    // this.ma6Drawing.enabled                   := (enableAll  == MaEnable.enableAll ? true : enableAll  == MaEnable.disableAll ? false : ma6Enabled ) 

    // show history 
    this.ma1Drawing.showHistory             := ma1ShowHistory 
    this.ma2Drawing.showHistory             := ma2ShowHistory 
    this.ma3Drawing.showHistory             := ma3ShowHistory 
    this.ma4Drawing.showHistory             := ma4ShowHistory 
    this.ma5Drawing.showHistory             := ma5ShowHistory 
    this.ma6Drawing.showHistory             := ma6ShowHistory 

    // show label 
    this.ma1Drawing.showLabel             := ma1ShowLabel 
    this.ma2Drawing.showLabel             := ma2ShowLabel 
    this.ma3Drawing.showLabel             := ma3ShowLabel 
    this.ma4Drawing.showLabel             := ma4ShowLabel 
    this.ma5Drawing.showLabel             := ma5ShowLabel 
    this.ma6Drawing.showLabel             := ma6ShowLabel 


    this.ma1Drawing.lnClr                     := ma1lnClr    
    this.ma1Drawing.lnWidth                   := ma1lnWidth
    this.ma1Drawing.lnStyle                   :=_ma1lnStyle 
    this.ma2Drawing.lnClr                     := ma2lnClr    
    this.ma2Drawing.lnWidth                   := ma2lnWidth
    this.ma2Drawing.lnStyle                   :=_ma2lnStyle 
    this.ma3Drawing.lnClr                     := ma3lnClr    
    this.ma3Drawing.lnWidth                   := ma3lnWidth
    this.ma3Drawing.lnStyle                   :=_ma3lnStyle 
    this.ma4Drawing.lnClr                     := ma4lnClr    
    this.ma4Drawing.lnWidth                   := ma4lnWidth
    this.ma4Drawing.lnStyle                   :=_ma4lnStyle 
    this.ma5Drawing.lnClr                     := ma5lnClr    
    this.ma5Drawing.lnWidth                   := ma5lnWidth
    this.ma5Drawing.lnStyle                   :=_ma5lnStyle 
    this.ma6Drawing.lnClr                     := ma6lnClr    
    this.ma6Drawing.lnWidth                   := ma6lnWidth
    this.ma6Drawing.lnStyle                   :=_ma6lnStyle 

    this


// END OF init() }

// --- importRsRetTuple() --- {
// @function Imports data returned from request.security() into HTFSMa object
export method importRsRetTuple(HTFMAs  this, int htfBi, float ma1, float ma2, float ma3, float ma4, float ma5, float ma6) =>
    if na(htfBi) or not this.enabled
        this.rsRet := this.rsRetNaObj 
    else
        this.rsRet := RsReturnMAs.new(htfBi, ma1, ma2,  ma3, ma4,  ma5, ma6)
        this.rsRetLast := this.rsRet.copy()
    this
// END OF importRsRetTuple() }

// --- getDrw(id) ---{
// @function Returns child HTFMAs.maNDrawing field value for given N
export method getDrw(HTFMAs this, int id) => 
    switch id 
        1 => this.ma1Drawing
        2 => this.ma2Drawing
        3 => this.ma3Drawing
        4 => this.ma4Drawing
        5 => this.ma5Drawing
        6 => this.ma6Drawing
        => na
//}

// --- set(maId, prop, string) ---{
// @function Sets properties of drw with prop arg names as follows:
// - lnClr - "color"
// - lnWidth - "width"
// - lnStyle - "style" (values sol, dot, dsh, al, ar, ab)
// - showHistory - "showHistory"
// @param this (HTFMAs) HTFMAs object
// @param id (int) MA's id
// @param prop (string) Property's name. Supported names are "color", "width", "style", "showHistory", "showLabel" 
// @param val (string) Property's value as a string.  For "color" - HEX, for "width" - numerical, for "style" - like style in plot(), for "showHistory" and "showLabel" "1" for true, "0" for false.
// @returns void
export method setDrwProp(HTFMAs this, int id, string prop, string val) => 
    _drw = this.getDrw(id)
    if not na(_drw)
        switch prop
            "color" => 
                _drw.lnClr          := val.toClr() // toClr is case insensitive
                1
            "width" => 
                _drw.lnWidth        := int(str.tonumber(val))
                1
            "style" =>  
                _drw.lnStyle        := val.toLowercase()                
                1
            "showHistory" => 
                _drw.showHistory    := val == "1" ? true : false                
                1
            "showLabel" => 
                _drw.showLabel      := val == "1" ? true : false                
                1


// @function Sets properties of drw with prop arg names as follows:
// - lnClr - "color"
// - lnWidth - "width"
// - lnStyle - "style" (values sol, dot, dsh, al, ar, ab)
// - showHistory - "showHistory"
// @param this (HTFMAs) HTFMAs object
// @param id (int) MA's id
// @param prop (string) Property's name. Supported names are "color", "width", "style", "showHistory", "showLabel" 
// @param val (string) Property's value as a string.  For "color" - HEX, for "width" - numerical, for "style" - like style in plot(), for "showHistory" and "showLabel" "1" for true, "0" for false.
// @returns void
export method set(HTFMAs this, int id, string prop, string val) => this.setDrwProp(id, prop, val)

//}

// END OF  BASIC METHODS }

// --- updateDisplayBandWidth() ---{
// @function Updates display band width, i.e. range withing which the MAs will be drawn (when outside not plotted)
export method updateDisplayBandWidth(HTFMAs this) =>
    atr14 = ta.atr(14)
    this.dispBandWidth := atr14 * this.rngAtrQ

//}


// --- inBands() ---{
// @function Checks whether y is within bandWidth range from src (= close by default) (inclusive)
inBands(float y, float bandWidth, float src = close) => (y >= src - bandWidth) and (y <= src + bandWidth)

method inBands(HTFMAs this, float y) => (y >= close - this.dispBandWidth) and (y <= close + this.dispBandWidth)



//}




// ━━━━━━ plotVal() ━━━━━━ {
// @function Returns MA's value if show history setting is on and within display bands, otherwise returns `na`.
export method plotValMa1(HTFMAs this) => this.ma1Drawing.showHistory and this.inBands(this.rsRet.ma1) ? this.rsRet.ma1 : na
// @function Returns MA's value if show history setting is on and within display bands, otherwise returns `na`.
export method plotValMa2(HTFMAs this) => this.ma2Drawing.showHistory and this.inBands(this.rsRet.ma2) ? this.rsRet.ma2 : na
// @function Returns MA's value if show history setting is on and within display bands, otherwise returns `na`.
export method plotValMa3(HTFMAs this) => this.ma3Drawing.showHistory and this.inBands(this.rsRet.ma3) ? this.rsRet.ma3 : na
// @function Returns MA's value if show history setting is on and within display bands, otherwise returns `na`.
export method plotValMa4(HTFMAs this) => this.ma4Drawing.showHistory and this.inBands(this.rsRet.ma4) ? this.rsRet.ma4 : na
// @function Returns MA's value if show history setting is on and within display bands, otherwise returns `na`.
export method plotValMa5(HTFMAs this) => this.ma5Drawing.showHistory and this.inBands(this.rsRet.ma5) ? this.rsRet.ma5 : na
// @function Returns MA's value if show history setting is on and within display bands, otherwise returns `na`.
export method plotValMa6(HTFMAs this) => this.ma6Drawing.showHistory and this.inBands(this.rsRet.ma6) ? this.rsRet.ma6 : na
// END OF plotVal() }




// --- +++ DRAW METODS +++ --- {

// --- initDrawing() --- {
// @function draws line and label indicating current MA's level
method initDrawing(HTFMAs this, MaDrawing drw, RsMaCalcParams rsCalcPrms, float y)=> // , RsMaCalcParams rsCalcPrms) =>
    if rsCalcPrms.enabled and this.inBands(y) and drw.showLabel
        // lines and labels may be collected by garbage collector because of ln/lbl from other parts of the script exceed max_labels_count  
        if na(drw.ln)
            drw.ln :=  line.new(x1 = na, y1 = na, x2 = na, y2=na)
        drw.ln.set_y1(y)
        drw.ln.set_y2(y)
        drw.ln.set_xloc(bar_index+this.lnOffset, bar_index+this.lblsOffset, xloc.bar_index)
        drw.ln.set_style(line.style_dashed)
        drw.ln.set_color(drw.lnClr)
        drw.ln.set_width(drw.lnWidth)

        if this.lblsShow 
            if na(drw.lbl)
                drw.lbl  := label.new(x = na, y = na)
            drw.lbl.set_y(y)
            drw.lbl.set_text(tfToSmHDWM(this.tf) + " " + str.tostring(rsCalcPrms.maType) + " " + str.tostring(rsCalcPrms.prd))
            drw.lbl.set_xloc(bar_index + this.lblsOffset, xloc.bar_index)    
            drw.lbl.set_yloc(yloc.price)    
            drw.lbl.set_color(CLR_TRANSP)    
            drw.lbl.set_textcolor(drw.lnClr)    
            drw.lbl.set_size(this.lblSize)    
            drw.lbl.set_style(this.lblStyle)    
            drw.lbl.set_textalign(this.lblTxtAlign)    
            drw.lbl.set_tooltip(this.bPopupLabel ? str.tostring(y, "#.##") : "") 
    this
// END OF initDrawing }

// --- initDrawings() --- {
export method initDrawings(HTFMAs this, RsParamsMAs rsPrms) =>
    this.initDrawing(this.ma1Drawing, rsPrms.ma1CalcParams, this.rsRetLast.ma1)
    this.initDrawing(this.ma2Drawing, rsPrms.ma2CalcParams, this.rsRetLast.ma2)
    this.initDrawing(this.ma3Drawing, rsPrms.ma3CalcParams, this.rsRetLast.ma3)
    this.initDrawing(this.ma4Drawing, rsPrms.ma4CalcParams, this.rsRetLast.ma4)
    this.initDrawing(this.ma5Drawing, rsPrms.ma5CalcParams, this.rsRetLast.ma5)
    this.initDrawing(this.ma6Drawing, rsPrms.ma6CalcParams, this.rsRetLast.ma6)
    this
// END OF initDrawings() }


// --- updateDrawing() --- {
// @function Draws line and label for a given ma (params are in rsCalcParams) to the right of the last bar
method updateDrawing(HTFMAs this,  MaDrawing drw, float y, RsMaCalcParams rsCalcPrms) =>
    if rsCalcPrms.enabled and drw.showLabel
        if this.inBands(y)
            if na(drw.ln) or na(drw.lbl) // this may occur as a result of garbage collection if because of ln/lbl from other parts of the script exceed max_labels_count  
                this.initDrawing(drw, rsCalcPrms, y)
            else 
                drw.ln.set_xy1(bar_index+this.lnOffset, y)
                drw.ln.set_xy2(bar_index+this.lblsOffset, y)
                if this.lblsShow
                    // if na(drw.lbl)
                    //     runtime.error(str.format("updateDrawing: {0>>: label is na while line is not na. Likely, some other parts of the script created labels in excess of max_labels_count and the label of this object was automatically removed as the oldest one. ", this.tf))
                    drw.lbl.set_xy(bar_index + this.lblsOffset, y)
                    // drw.lbl.set_tooltip(this.bPopupLabel ? str.tostring(y, "#.##") : "") 
        else if not na(y) // y may be na on HTF intrabars because of smoothing, do not delete labels in this case 
            drw.clear() // delete line and label

    this
// END OF updateDrawing() }

// --- updateDrawings() --- {
// using rsRetLast here because rsRet values may be na on HTF intrabars when smoothing is enabled
// @function Draws line and label indicating current MA's level
// @param this (HTFMAs) Object for which to draw MA's line/labels
// @param this (HTFMAs) Object for which to draw MA's line/labels
// @param rsPrms (RsParamsMAs) RsParamsMAs object 
export method updateDrawings(HTFMAs this, RsParamsMAs rsPrms) =>
    this.updateDrawing(this.ma1Drawing, this.rsRetLast.ma1, rsPrms.ma1CalcParams)
    this.updateDrawing(this.ma2Drawing, this.rsRetLast.ma2, rsPrms.ma2CalcParams)
    this.updateDrawing(this.ma3Drawing, this.rsRetLast.ma3, rsPrms.ma3CalcParams)
    this.updateDrawing(this.ma4Drawing, this.rsRetLast.ma4, rsPrms.ma4CalcParams)
    this.updateDrawing(this.ma5Drawing, this.rsRetLast.ma5, rsPrms.ma5CalcParams)
    this.updateDrawing(this.ma6Drawing, this.rsRetLast.ma6, rsPrms.ma6CalcParams)
    this
// END OF updateDrawings() }

// END OF DRAW METHODS } 




//----------- +++++++++++++++++++++ ----------- 
// ━━━━━━ update() ━━━━━━ { 
// @function Chart tf's post processing of HTF data
export method update(HTFMAs this) => 
    // --- smoothen ma's if required --- 
    // remove values in between HTF changes
    if this.smoothen and ta.change(this.rsRet.htfBi) == 0
        this.rsRet.ma1 := na
        this.rsRet.ma2 := na
        this.rsRet.ma3 := na
        this.rsRet.ma4 := na
        this.rsRet.ma5 := na
        this.rsRet.ma6 := na
    this    

// END OF rsRet htfUpdate()  }
//------------------------------------------------


// ^^^ END OF HTFMAs type  ^^^ }  
