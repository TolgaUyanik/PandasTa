CLR_TRANSP = color.rgb(255, 255, 255, 100) 



// ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
// ┃                          HELPER METHODS                                      ┃ {
// --- tfToSmHDWM() --- {
// @function Shortens higher 'm' timeframes to 'H', e.g. '240m' --> '4H' (leaves all other tf's as is) 
tfToSmHDWM(string tf ) =>
    ln = str.length(tf)
    lastC = str.substring(tf, ln-1, ln)
    s = if not (str.endswith(tf, "S") or str.endswith(tf, "D") or str.endswith(tf, "W") or str.endswith(tf, "M"))
        m = str.tonumber(tf)
        if str.tonumber(tf) >= 60
            h = math.round(m * 10  / 60) / 10
            str.tostring(h)+"H"
        else
            tf + "m"
    else 
        tf
// END OF tfToSmHDWM () }

// ━━━━━ toUppercase() / toLowercase() ━━━━━ {
const string sUppercase = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
const string sLowercase = "abcdefghijklmnopqrstuvwxyz"

_toUc(string char) =>
    n = str.pos(sLowercase, char)
    na(n) ? char : str.substring(sUppercase, n, n+1)

_toLc(string char) =>
    n = str.pos(sUppercase, char)
    na(n) ? char : str.substring(sLowercase, n, n+1)



// @function Converts a string to uppercase 
method toUppercase(string s) =>
    _l = str.length(s) 
    if _l > 0 
        s1 = ""
        for i = 0 to _l-1
            _c = str.substring(s, i, i+1)
            s1+=_toUc(_c)

// @function Converts a string to uppercase 
method toLowercase(string s) =>
    _l = str.length(s) 
    if _l > 0 
        s1 = ""
        for i = 0 to _l-1
            _c = str.substring(s, i, i+1)
            s1+=_toLc(_c)
// END OF toUppercase() / toLowercase() }


// ^^^ END OF HELPER METHODS }
// ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛ 

// ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
