//----------- RsParamsMAs  TYPE -----------{

// +++ RsMaCalcParams type +++ {
// @type  Parameters of one MA (only calculation params needed within req.sec(), visual parameters are within htfMAs type)
// @field enables  Enables collection of the OB data from HTF
// @field maType MA type options: SMA / EMA / WMA / ...
// @field prd MA period
export type RsMaCalcParams
    bool          enabled = true // TO_DO: this param did not work as intended, since it was calculated based on "timeframe.period" to check if TF is lowr, but when using inside req.sec() everything is calculated in req,sec TF cointext, and timeframe.period is not the chart's TF but req.sec TF's.
    MaTypes        maType 
    string        src
    int         prd     
// END OF rsCalcParams type}

// +++ RsParamsMAs type +++ {
// @type  Collection of parameters of 6 MAs. Used to pass params to req.sec()  
export type RsParamsMAs
    RsMaCalcParams ma1CalcParams
    RsMaCalcParams ma2CalcParams
    RsMaCalcParams ma3CalcParams
    RsMaCalcParams ma4CalcParams
    RsMaCalcParams ma5CalcParams
    RsMaCalcParams ma6CalcParams
// END OF RsParamsMAs type}


// --- init() --- {
// @function Initiates rsMaCalcParams for each MA 
// @param enableAll (MaEnable) MaEnable.enableAll/disableAll - sets all rsMaCalcParams.enabled to true/false respectively.  MaEnable.individualy - sets rsMaCalcParams.enabled to ma<id>Enabled parameter for each MA.
// @param ma1Enabled Enable calculation of the MA
// @param ma1MaType  (MaTypes) Determines type of the MA (SMA, EMA etc)
// @param ma1Src  (string) Determines source of the ma (close, open, high, high, low, hl2, hlc3, ohlc4, hlcc4).
// @param ma1Prd  (int) MA's period
// @param ma2Enabled Enable calculation of the MA
// @param ma2MaType  (MaTypes) Determines type of the MA (SMA, EMA etc)
// @param ma2Src  (string) Determines source of the ma (close, open, high, high, low, hl2, hlc3, ohlc4, hlcc4).
// @param ma2Prd  (int) MA's period
// @param ma3Enabled Enable calculation of the MA
// @param ma3MaType  (MaTypes) Determines type of the MA (SMA, EMA etc)
// @param ma3Src  (string) Determines source of the ma (close, open, high, high, low, hl2, hlc3, ohlc4, hlcc4).
// @param ma3Prd  (int) MA's period
// @param ma4Enabled Enable calculation of the MA
// @param ma4MaType  (MaTypes) Determines type of the MA (SMA, EMA etc)
// @param ma4Src  (string) Determines source of the ma (close, open, high, high, low, hl2, hlc3, ohlc4, hlcc4).
// @param ma4Prd  (int) MA's period
// @param ma5Enabled Enable calculation of the MA
// @param ma5MaType  (MaTypes) Determines type of the MA (SMA, EMA etc)
// @param ma5Src  (string) Determines source of the ma (close, open, high, high, low, hl2, hlc3, ohlc4, hlcc4).
// @param ma5Prd  (int) MA's period
// @param ma6Enabled Enable calculation of the MA
// @param ma6MaType  (MaTypes) Determines type of the MA (SMA, EMA etc)
// @param ma6Src  (string) Determines source of the ma (close, open, high, high, low, hl2, hlc3, ohlc4, hlcc4).
// @param ma6Prd  (int) MA's period
// @returns this (RsParamsMAs)
export method init(RsParamsMAs this
                  , simple MaEnable     enableAll           = MaEnable.individualy
                  , bool                ma1Enabled          = false
                  , MaTypes             ma1MaType           = na 
                 , string                ma1Src              = "close"
                  , int                 ma1Prd              = na
                  , bool                ma2Enabled          = false
                  , MaTypes             ma2MaType           = na 
                 , string                ma2Src              = "close"
                  , int                 ma2Prd              = na
                  , bool                ma3Enabled          = false
                  , MaTypes             ma3MaType           = na 
                 , string                ma3Src              = "close"
                  , int                 ma3Prd              = na
                  , bool                ma4Enabled          = false
                  , MaTypes             ma4MaType           = na 
                 , string                ma4Src              = "close"
                  , int                 ma4Prd              = na
                  , bool                ma5Enabled          = false
                  , MaTypes             ma5MaType           = na 
                 , string                ma5Src              = "close"
                  , int                 ma5Prd              = na
                  , bool                ma6Enabled          = false
                  , MaTypes             ma6MaType           = na 
                 , string                ma6Src              = "close"
                  , int                 ma6Prd              = na

                  ) =>    


    this.ma1CalcParams := RsMaCalcParams.new()
    this.ma2CalcParams := RsMaCalcParams.new()
    this.ma3CalcParams := RsMaCalcParams.new()
    this.ma4CalcParams := RsMaCalcParams.new()
    this.ma5CalcParams := RsMaCalcParams.new()
    this.ma6CalcParams := RsMaCalcParams.new()


    this.ma1CalcParams.enabled              := (enableAll  == MaEnable.enableAll ? true : enableAll  == MaEnable.disableAll ? false : ma1Enabled )
    this.ma2CalcParams.enabled              := (enableAll  == MaEnable.enableAll ? true : enableAll  == MaEnable.disableAll ? false : ma2Enabled )
    this.ma3CalcParams.enabled              := (enableAll  == MaEnable.enableAll ? true : enableAll  == MaEnable.disableAll ? false : ma3Enabled )
    this.ma4CalcParams.enabled              := (enableAll  == MaEnable.enableAll ? true : enableAll  == MaEnable.disableAll ? false : ma4Enabled )
    this.ma5CalcParams.enabled              := (enableAll  == MaEnable.enableAll ? true : enableAll  == MaEnable.disableAll ? false : ma5Enabled )
    this.ma6CalcParams.enabled              := (enableAll  == MaEnable.enableAll ? true : enableAll  == MaEnable.disableAll ? false : ma6Enabled )


    this.ma1CalcParams.maType               := ma1MaType      
    this.ma2CalcParams.maType               := ma2MaType      
    this.ma3CalcParams.maType               := ma3MaType      
    this.ma4CalcParams.maType               := ma4MaType      
    this.ma5CalcParams.maType               := ma5MaType      
    this.ma6CalcParams.maType               := ma6MaType      

    this.ma1CalcParams.src                  := ma1Src
    this.ma2CalcParams.src                  := ma2Src
    this.ma3CalcParams.src                  := ma3Src
    this.ma4CalcParams.src                  := ma4Src
    this.ma5CalcParams.src                  := ma5Src
    this.ma6CalcParams.src                  := ma6Src

    this.ma1CalcParams.prd                  := ma1Prd       
    this.ma2CalcParams.prd                  := ma2Prd       
    this.ma3CalcParams.prd                  := ma3Prd       
    this.ma4CalcParams.prd                  := ma4Prd       
    this.ma5CalcParams.prd                  := ma5Prd       
    this.ma6CalcParams.prd                  := ma6Prd       

    
   
    this
// END OF init()}

// --- get(id) ---{
// @function Returns calculation properties (child field of RsMaCalcParams type) for MA with given number. 
// @param this (RsParamsMAs) RsParamsMAs object
// @param id (int) id of the required MA
// @returns child field of `this` (RsParamsMAs) corresponding to MA numbered `id`
export method get(RsParamsMAs this, int id) => 
    switch id 
        1 => this.ma1CalcParams
        2 => this.ma2CalcParams
        3 => this.ma3CalcParams
        4 => this.ma4CalcParams
        5 => this.ma5CalcParams
        6 => this.ma6CalcParams
        => na
//}

// --- set(maId, prop, string) ---{
// @function Sets calculation parameters for an MA with given number ( sets properties of a child field of RsMaCalcParams type for MA with given number, i.e.  Writes  value `val` to rsParams.ma<id>CalcParams child field corresponding to `prop`. )
// Supported `prop` names: "type", "src", "length", "prd", "enabled"
// @param this (RsParamsMAs) Object storing calculation parameters for an MA
// @param id (int) Id of the MA (1 to 6)
// @param prop (string) Name of the property to set (Supported `prop` names: "type", "src", "length", "prd", "enabled")
// @param val (string) Value as a string (is converted to number for numeric properties). 
// @returns void
export method set(RsParamsMAs this, int id, string prop, string val) => 
    _maCalcParams = this.get(id)
    if not na(_maCalcParams)
        switch prop
            "type" => 
                _maCalcParams.maType  := val.getMaType() // getMaType is case insensitive
                1
            "source" => 
                _maCalcParams.src  := val.toLowercase()
                1
            "length" => 
                _maCalcParams.prd  := int(str.tonumber(val))                
                1
            "prd" => // same as length
                _maCalcParams.prd  := int(str.tonumber(val))                
                1
            "enabled" => 
                _maCalcParams.enabled  := val == "1" ? true : false
                1
//}




// ^^^ END OF RsParamsMAs  ^^^ }  
