//@version=6
indicator(
     title           = "Upcoming Earnings — Gradient Window",
     shorttitle      = "Earnings v2",
     overlay         = true,
     max_lines_count = 100,
     scale           = scale.none
)

//=============================================================================
// Input groups
//=============================================================================

string GROUP_WINDOW   = "Earnings Window"
string GROUP_COLOURS  = "Gradient Colours"
string GROUP_DISPLAY  = "Display"
string GROUP_REMOVAL  = "Removal"

//=============================================================================
// Earnings window inputs
//=============================================================================

int daysBefore = input.int(
     defval  = 2,
     title   = "Trading days before earnings",
     minval  = 0,
     maxval  = 20,
     group   = GROUP_WINDOW,
     tooltip = "Default 2 produces E-2 and E-1."
)

int daysAfter = input.int(
     defval  = 2,
     title   = "Trading days after earnings",
     minval  = 0,
     maxval  = 20,
     group   = GROUP_WINDOW,
     tooltip = "Default 2 produces E+1 and E+2."
)

//=============================================================================
// User-selectable gradient colours
//=============================================================================

color outerColour = input.color(
     defval  = color.rgb(255, 205, 210),
     title   = "Outer colour",
     group   = GROUP_COLOURS,
     tooltip = "Used for the furthest selected days from earnings, such as E-2 and E+2 with the default settings."
)

color middleColour = input.color(
     defval  = color.rgb(239, 83, 80),
     title   = "Middle colour",
     group   = GROUP_COLOURS,
     tooltip = "Used around the middle of the gradient, such as E-1 and E+1 with the default settings."
)

color earningsColour = input.color(
     defval  = color.rgb(183, 28, 28),
     title   = "Earnings-date colour",
     group   = GROUP_COLOURS,
     tooltip = "Used for the earnings date itself."
)

//=============================================================================
// Display inputs
//=============================================================================

int markerOpacity = input.int(
     defval  = 10,
     title   = "Opacity (%)",
     minval  = 1,
     maxval  = 100,
     group   = GROUP_DISPLAY,
     tooltip = "10% opacity corresponds to 90% TradingView transparency."
)

int markerWidth = input.int(
     defval = 4,
     title  = "Marker width",
     minval = 1,
     maxval = 4,
     group  = GROUP_DISPLAY
)

//=============================================================================
// Removal inputs
//=============================================================================

int removalDelayDays = input.int(
     defval  = 5,
     title   = "Remove after earnings date — calendar days",
     minval  = 0,
     maxval  = 30,
     group   = GROUP_REMOVAL,
     tooltip = "Removes the complete earnings window after this number of calendar days has elapsed following the earnings date."
)

//=============================================================================
// Constants
//=============================================================================

const int MS_PER_DAY = 24 * 60 * 60 * 1000

//=============================================================================
// Timeframe validation
//=============================================================================

bool validTimeframe =
     timeframe.isdaily and
     timeframe.multiplier == 1

if barstate.isfirst and not validTimeframe
    runtime.error(
         "This indicator is designed exclusively for the 1D chart."
    )

//=============================================================================
// Functions
//=============================================================================

// Moves a timestamp forwards or backwards by a selected number of weekdays.
// Saturdays and Sundays are skipped.
//
// Future exchange holidays cannot be identified reliably because Pine does
// not expose a complete forward exchange-holiday calendar.
shiftWeekdays(int baseTime, int weekdayOffset) =>
    int shiftedTime = baseTime
    int direction   = weekdayOffset >= 0 ? 1 : -1
    int daysLeft    = math.abs(weekdayOffset)

    while daysLeft > 0
        shiftedTime += direction * MS_PER_DAY

        int shiftedDay = dayofweek(shiftedTime)

        bool isWeekday =
             shiftedDay != dayofweek.saturday and
             shiftedDay != dayofweek.sunday

        if isWeekday
            daysLeft -= 1

    shiftedTime

// Calculates the appropriate gradient colour for a particular marker.
//
// Each side of the earnings date is scaled independently:
//
// • Furthest selected day = outer colour
// • Halfway towards E     = middle colour
// • Earnings date         = earnings colour
//
// Default result:
//
// E-2 = outer
// E-1 = middle
// E   = earnings
// E+1 = middle
// E+2 = outer
getMarkerColour(int weekdayOffset) =>
    color calculatedColour = earningsColour

    if weekdayOffset != 0
        int sideLength =
             weekdayOffset < 0 ?
             daysBefore :
             daysAfter

        int distanceFromEarnings = math.abs(weekdayOffset)

        float proximityToEarnings =
             sideLength > 0 ?
             1.0 -
             (
                 float(distanceFromEarnings) /
                 float(sideLength)
             ) :
             1.0

        proximityToEarnings := math.max(
             0.0,
             math.min(1.0, proximityToEarnings)
        )

        if proximityToEarnings <= 0.5
            calculatedColour := color.from_gradient(
                 proximityToEarnings,
                 0.0,
                 0.5,
                 outerColour,
                 middleColour
            )
        else
            calculatedColour := color.from_gradient(
                 proximityToEarnings,
                 0.5,
                 1.0,
                 middleColour,
                 earningsColour
            )

    int tradingViewTransparency = 100 - markerOpacity

    color.new(
         calculatedColour,
         tradingViewTransparency
    )

//=============================================================================
// Upcoming earnings data
//=============================================================================

// TradingView's expected date and time of the next earnings report.
int nextEarningsTime = earnings.future_time

bool earningsDataAvailable = not na(nextEarningsTime)

// Extract the calendar date using the instrument's exchange timezone.
int earningsYear =
     earningsDataAvailable ?
     year(nextEarningsTime) :
     na

int earningsMonth =
     earningsDataAvailable ?
     month(nextEarningsTime) :
     na

int earningsDay =
     earningsDataAvailable ?
     dayofmonth(nextEarningsTime) :
     na

// Start of the earnings calendar date.
int earningsDateStart =
     earningsDataAvailable ?
     timestamp(
         syminfo.timezone,
         earningsYear,
         earningsMonth,
         earningsDay,
         0,
         0
     ) :
     na

// Place each vertical marker around the centre of its daily chart column.
int earningsMarkerTime =
     earningsDataAvailable ?
     timestamp(
         syminfo.timezone,
         earningsYear,
         earningsMonth,
         earningsDay,
         12,
         0
     ) :
     na

// Keep the complete marker window visible for the selected period after E.
int removalTime =
     earningsDataAvailable ?
     earningsDateStart +
     (
         (removalDelayDays + 1) *
         MS_PER_DAY
     ) :
     na

bool markerWindowActive =
     earningsDataAvailable and
     timenow < removalTime

//=============================================================================
// Vertical marker management
//=============================================================================

var array<line> earningsMarkers = array.new_line()

if barstate.islast

    // Delete the previous marker set before rebuilding it.
    int existingMarkerCount = array.size(earningsMarkers)

    if existingMarkerCount > 0
        for markerIndex = 0 to existingMarkerCount - 1
            line.delete(
                 array.get(
                     earningsMarkers,
                     markerIndex
                 )
            )

        array.clear(earningsMarkers)

    // Draw the selected marker range.
    if markerWindowActive
        for weekdayOffset = -daysBefore to daysAfter

            int markerTime = shiftWeekdays(
                 earningsMarkerTime,
                 weekdayOffset
            )

            color markerColour = getMarkerColour(
                 weekdayOffset
            )

            line newMarker = line.new(
                 x1     = markerTime,
                 y1     = low,
                 x2     = markerTime,
                 y2     = high,
                 xloc   = xloc.bar_time,
                 extend = extend.both,
                 color  = markerColour,
                 style  = line.style_solid,
                 width  = markerWidth
            )

            array.push(
                 earningsMarkers,
                 newMarker
            )