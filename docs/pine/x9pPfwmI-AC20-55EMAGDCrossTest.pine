//@version=6
strategy("黃金20/55均線翻轉策略 (v6 繁體中文版)", overlay=true, initial_capital=10000, default_qty_type=strategy.cash, default_qty_value=5000)

// ==========================================
// 1. 後台參數設定
// ==========================================
fastLen = input.int(20, title="【短期快線】長度設定")
slowLen = input.int(55, title="【中期慢線】長度設定")

// ==========================================
// 2. 計算均線
// ==========================================
fastMA = ta.ema(close, fastLen)
slowMA = ta.ema(close, slowLen)

// 繪製均線到圖表上
plot(fastMA, color=color.purple, title="圖表顯示：短期快線", linewidth=2)
plot(slowMA, color=color.yellow, title="圖表顯示：中期慢線", linewidth=2)

// ==========================================
// 3. 判斷黃金交叉與死亡交叉
// ==========================================
goldCross  = ta.crossover(fastMA, slowMA)  
deathCross = ta.crossunder(fastMA, slowMA) 

// ==========================================
// 4. 自動下單邏輯 (符合 v6 標準的 if 區塊控制)
// ==========================================
if (goldCross)
    strategy.entry("中文多單進場", strategy.long)
    alert("【交易機器人提示】黃金剛剛發生金叉！目前空單已全數平倉，並為您自動買入多單，請留意倉位。", alert.freq_once_per_bar_close)

if (deathCross)
    strategy.entry("中文空單進場", strategy.short)
    alert("【交易機器人提示】黃金剛剛發生死叉！目前多單已全數平倉，並為您自動買入空單，請留意倉位。", alert.freq_once_per_bar_close)

// ==========================================
// 5. 圖表中文標記 (必須放在外層 Global Scope)
// ==========================================
plotshape(series=goldCross, title="金叉標記", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, text="金叉買多")
plotshape(series=deathCross, title="死叉標記", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="死叉買空")