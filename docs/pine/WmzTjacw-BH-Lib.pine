// A shared library of core calculations used across BH indicator suite:
//   Gaps, i1R, Overlap, BOPB, Range_ABR_IBS, Slp_ExcessZ_Vol_VIX
//
// HOW TO USE:
//   1. Publish this script as a Library on TradingView (not as an indicator).
//   2. In any indicator that uses these functions, add the import line:
//        import bnhz11/BH_Lib/1 as BH
//   3. Call functions via the alias, e.g.:  BH.ibs()  BH.barDir()  BH.abr(8)

//@version=6
library("BH_Lib", overlay = false)

// ============================================================
//  SECTION 1 — BAR GEOMETRY
//  These are the most-duplicated lines across all indicators.
//  Every indicator computes fullRange and bodyRange independently.
//  Centralizing them guarantees a single definition everywhere.
// ============================================================

// Full high-to-low range of the current bar.
// Used in: ALL indicators (Gaps, i1R, Overlap, BOPB, Range_ABR_IBS, Slp)
export fullRange() =>
    high - low

// Absolute body size (open-to-close distance, always positive).
// Used in: Overlap, Range_ABR_IBS, Slp
export bodyRange() =>
    math.abs(close - open)

// Midpoint of the full range, snapped to the instrument's minimum tick.
// Used in: Overlap, Range_ABR_IBS, Slp
export midRange() =>
    math.round_to_mintick((fullRange() / 2) + low)

// Body midpoint, snapped to min tick.
// Useful for plotting body center lines.
export midBody() =>
    math.round_to_mintick(bodyRange() / 2 + math.min(close, open))

// 1R bull target: range projected upward from high.
// Used in: Overlap
export blTarget() =>
    high + fullRange()

// 1R bear target: range projected downward from low.
// Used in: Overlap, Slp
export brTarget() =>
    low - fullRange()

// ============================================================
//  SECTION 2 — INTERNAL BAR STRENGTH (IBS)
//  Appears in every single indicator. The formula is always
//  identical, but was copy-pasted each time. One definition
//  avoids any future divergence if you ever tweak the formula.
// ============================================================

// IBS: position of the close within the bar's range, 0–100.
// Returns 50 when fullRange is zero (flat bar) to avoid division by zero.
// Used in: Gaps, i1R, Overlap, BOPB, Range_ABR_IBS, Slp
export ibs() =>
    fr = fullRange()
    fr != 0 ? (close - low) / fr * 100 : 50.0

// ============================================================
//  SECTION 3 — BAR DIRECTION (BarDir)
//  The most complex shared block — 10 conditional branches.
//  Copied verbatim into Gaps, i1R, and BOPB.  Any bug fix or
//  logic tweak (e.g., the IBS==50 tie-break rule) must now be
//  made in only one place.
// ============================================================

// BarDir: classifies each bar as bullish (+1) or bearish (-1).
// The algorithm resolves ambiguous bars (doji, bearish body but high IBS)
// using IBS as the tiebreaker rather than body direction alone.
// Returns the previous bar's BarDir when perfectly indeterminate.
// Used in: Gaps, i1R, BOPB
export barDir() =>
    ibsVal = ibs()
    dir = 0
    if close > open and ibsVal >= 50
        dir := 1
    else if close < open and ibsVal <= 50
        dir := -1
    else if close == open and ibsVal > 50
        dir := 1
    else if close == open and ibsVal < 50
        dir := -1
    else if close == open and ibsVal == 50
        dir := dir[1] // carry forward
    else if close < open and ibsVal > 50
        dir := 1                         // bearish body, bullish close position
    else if close > open and ibsVal < 50
        dir := -1                        // bullish body, bearish close position
    else if ibsVal == 50
        dir := dir[1]
    else
        dir := dir[1]
    dir

// ============================================================
//  SECTION 4 — AVERAGE BAR RANGE (ABR)
//  Appears in Gaps, Overlap, Range_ABR_IBS, BOPB, Slp.
//  Each indicator chose the same SMA formula but with its own
//  local variable name (abr, AvgRange, atr-lookalike).
// ============================================================

// ABR: simple moving average of confirmed bar ranges.
// Using barstate.isconfirmed excludes the currently forming bar
// from the lookback so the live bar does not inflate its own ABR.
// Used in: Gaps, Overlap, BOPB, Range_ABR_IBS
export abr(int lookback) =>
    ta.sma(barstate.isconfirmed ? fullRange() : na, lookback)

// Smoothed ABR: EMA of the ABR (used in Gaps for gap-vs-ABR comparison).
export abrEma(int lookback) =>
    ta.ema(abr(lookback), lookback)

// SB:ABR Index — how large the current bar is relative to the ABR, in %.
// A value of 100 means the bar equals ABR; 200 means twice ABR.
// Used in: Range_ABR_IBS, BOPB
export abrIndex(int lookback) =>
    abrVal = abr(lookback)
    abrVal > 0 ? fullRange() / abrVal * 100 : na

// ============================================================
//  SECTION 5 — TAIL / WICK ANALYSIS
//  tailPercent() appears identically in Range_ABR_IBS and Slp.
//  topTail and bottomTail are computed in both with the same math.
// ============================================================

// Total wick/tail percentage of the full range (0–100).
// 0 = pure body bar, 100 = all wick, no body.
// Used in: Range_ABR_IBS, Slp
export tailPercent() =>
    fr = fullRange()
    fr != 0 ? (1 - bodyRange() / fr) * 100 : 0.0

// Upper wick as a % of full range.
export topTailPercent() =>
    fr = fullRange()
    fr != 0 ? (high - math.max(open, close)) / fr * 100 : 0.0

// Lower wick as a % of full range.
export bottomTailPercent() =>
    fr = fullRange()
    fr != 0 ? (math.min(open, close) - low) / fr * 100 : 0.0

// ============================================================
//  SECTION 6 — OUTSIDE BAR / INSIDE BAR DETECTION
//  The iO scale (1–5) appears identically in Range_ABR_IBS
//  and BOPB.  Basic OB/IB flags appear in Overlap and BOPB.
// ============================================================

// Outside bar flag: 1 if this bar's range strictly contains the prior bar's range.
// Includes equal-sided variants depending on strictness.
// Used in: Overlap, BOPB
export isOB() =>
    (high > high[1] and low < low[1]) or
     (high > high[1] and low == low[1]) or
     (high == high[1] and low < low[1])

// Inside bar flag: 1 if this bar's range is contained within the prior bar's range.
// Used in: Overlap, i1R, BOPB
export isIB() =>
    (high < high[1] and low > low[1]) or
     (high < high[1] and low == low[1]) or
     (high == high[1] and low > low[1]) or
     (high == high[1] and low == low[1])

// iO Scale: granular outside/inside classification on a 0–5 scale.
//   5 = pure outside bar
//   4 = outside with one equal side
//   3 = exactly equal high AND low (same bar)
//   2 = inside with one equal side
//   1 = pure inside bar
//   0 = normal (neither OB nor IB)
// Used in: Range_ABR_IBS, BOPB
export iOscale() =>
    if high > high[1] and low < low[1]
        5
    else if (high == high[1] and low < low[1]) or (high > high[1] and low == low[1])
        4
    else if high == high[1] and low == low[1]
        3
    else if (high == high[1] and low > low[1]) or (high < high[1] and low == low[1])
        2
    else if high < high[1] and low > low[1]
        1
    else
        0

// ============================================================
//  SECTION 7 — OVERLAP
//  The overlap formula appears in Overlap.pine and BOPB.
//  It measures what fraction of the current bar's range
//  re-covers ground already traveled by the prior bar.
// ============================================================

// Raw overlap range in price units (how many points overlap with bar[1]).
export overlapRange() =>
    math.max(0, math.min(high[1], high) - math.max(low[1], low))

// Overlap as a % of the current bar's full range (0–100).
// 100 = current bar is fully inside prior bar (pure inside bar).
// 0   = no overlap at all (gap bar).
// Used in: Overlap, BOPB
export overlapPct() =>
    fr = fullRange()
    fr != 0 ? overlapRange() / fr * 100 : 0.0

// ============================================================
//  SECTION 8 — Z-SCORE (SAMPLE STANDARD DEVIATION)
//  The sampleStdev helper and z-score calculation are duplicated
//  in Range_ABR_IBS and Slp with slightly different variable names.
//  A shared version ensures consistent sample (n-1) variance.
// ============================================================

// Sample standard deviation (uses n-1 denominator, matching your originals).
// Private helper — not exported because callers use zScore() directly.
_sampleStdev(series float src, int lookback) =>
    avg      = ta.sma(src, lookback)
    dev      = src - avg
    variance = math.sum(dev * dev, lookback) / (lookback - 1)
    math.sqrt(variance)

// Z-Score: how many standard deviations the current value is above/below its mean.
// Positive = above average, negative = below average.
// Used in: Range_ABR_IBS (full range ZF, body range ZB), Slp (slope Z, excess Z), BOPB
export zScore(series float src, int lookback) =>
    stdev = _sampleStdev(src, lookback)
    stdev != 0 ? (src - ta.sma(src, lookback)) / stdev : 0.0

// Convenience wrappers for the two most common z-scores in your suite
export zScoreFullRange(int lookback) =>
    zScore(fullRange(), lookback)

export zScoreBodyRange(int lookback) =>
    zScore(bodyRange(), lookback)

// ============================================================
//  SECTION 9 — SESSION HELPERS
//  IsInSession / IsSessionStart are defined in BOPB and used
//  implicitly through session.isfirstbar_regular elsewhere.
//  Having them in the library makes session logic reusable.
// ============================================================

// Returns true on every bar that falls within the specified session string.
// sessionStr format: "0930-1600" or "0930-1600:23456" etc.
export isInSession(string sessionStr, string tz = syminfo.timezone) =>
    not na(time(timeframe.period, sessionStr, tz))

// Returns true only on the FIRST bar of each session window.
export isSessionStart(string sessionStr, string tz = syminfo.timezone) =>
    inSess = isInSession(sessionStr, tz)
    inSess and not inSess[1]

// RTH first-bar flag (mirror of session.isfirstbar_regular).
// Used in: Gaps, Overlap
export isFirstRTHbar() =>
    session.isfirstbar_regular

// True starting from bar[2] onward after RTH open.
// Prevents erroneous gap boxes spanning the prior session close.
// Used in: Gaps, Overlap
export skipFirst2Bars() =>
    not session.isfirstbar_regular and not session.isfirstbar_regular[1]

// ============================================================
//  SECTION 10 — SCALP TARGETS
//  These round-to-tick scalp level helpers appear in Overlap
//  and BOPB with identical formulas each time.
// ============================================================

// 50% of the bar's full range (half-range scalp target).
export scalp50() =>
    math.round_to_mintick(fullRange() * 0.5)

// 75% of the bar's full range.
export scalp75() =>
    math.round_to_mintick(fullRange() * 0.75)

// Bar level as a price: given a fraction f (0.0–1.0), returns the
// price level that fraction of the way up the bar from low.
// e.g. barLevel(0.33) = 33% level,  barLevel(0.67) = 67% level
export barLevel(float fraction) =>
    math.round_to_mintick(low + fullRange() * fraction)
