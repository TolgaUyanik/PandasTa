//@version=6
indicator('Smart Renko Engine', overlay = true, max_labels_count = 50)

// DISCLAIMER: This script is for educational and informational purposes only. 
// It does not constitute financial, investment, or trading advice. 
// Past performance and backtested/visual results are not indicative of future results. 
// Trading involves substantial risk of loss and is not suitable for every investor. 
// Use this indicator at your own risk and always do your own due diligence before making any trading decision. 
// The author assumes no liability for any losses incurred from the use of this script.

// ==============================================================================
// 1. INPUTS & SETTINGS
// ==============================================================================
grp_main = 'Inputs'
grp_MA = 'Moving Averages'

assetSelection = input.string('Auto-Detect', title = 'Asset Selection Mode', options = ['Auto-Detect', 'Manual'], group = grp_main, tooltip = 'Decides how the baseline Renko brick size is chosen for the chart you are viewing.\n\n• Auto-Detect → The script reads the chart\'s symbol type (Index, Option, Future, Stock, Crypto, Commodity) and ticker name, then automatically applies an optimized default % for that asset class.\n\n• Manual → Bypasses auto-detection and uses the asset you pick from the \'Manual Asset Pick\' dropdown below.\n\n💡 Tip: Keep this on \'Auto-Detect\' for most charts. Switch to \'Manual\' only if the script misidentifies your symbol.')

manualPick = input.string('Crude Oil', title = 'Manual Asset Pick', options = ['NIFTY 50', 'BANKNIFTY', 'SENSEX', 'NIFTY OPTIONS', 'BANKNIFTY OPTIONS', 'SENSEX OPTIONS', 'STOCKS', 'Stock Options', 'Crude Oil', 'US Oil', 'Natural Gas', 'XAUUSD/GOLD', 'XAGUSD/SILVER', 'BTCUSD', 'CRYPTO', 'Custom'], group = grp_main, tooltip = 'Active ONLY when \'Asset Selection Mode\' is set to \'Manual\'.\n\nPick the asset class that best matches your chart. The script will apply the following preset brick % values:\n\nIndices:\n• NIFTY 50 / BANKNIFTY / SENSEX → 0.66%\n\nOptions:\n• NIFTY/BANKNIFTY/SENSEX OPTIONS → 33%\n• Stock Options → 1%\n\nEquities:\n• STOCKS → 2%\n\nCommodities:\n• Crude Oil → 3%\n• US Oil (WTI) → 5%\n• Natural Gas → 3%\n• XAUUSD / Gold → 3%\n• XAGUSD / Silver → 3%\n\nCrypto:\n• BTCUSD / CRYPTO → 3%\n\n• Custom → Uses the value you enter in \'Custom %\' (next field), or \'Fixed Box Size\' if that mode is selected.\n\n⚠ Note: Choosing \'Custom\' is the only way to apply your own percentage in Manual mode.')

brickCalcMode = input.string('Percentage', title = 'Brick Size Calculation', options = ['Percentage', 'Fixed Box Size'], group = grp_main, tooltip = 'Decides the unit used to measure each Renko brick.\n\n• Percentage → Brick size = Current Close × (Active % ÷ 100).\n   Example: If close = 20,000 and active % = 0.66, brick size = 132 points.\n   This auto-scales with price, so it works across different price levels of the same asset.\n\n• Fixed Box Size → Brick size = the exact point value entered in \'Fixed Box Size (Points)\' below.\n   Use this when you want the brick size to stay constant regardless of price movement (e.g., 50 points for BankNifty).\n\n💡 Tip: \'Percentage\' is recommended for beginners because it adapts automatically. \'Fixed Box Size\' is preferred by pros who know the exact tick value they want.')

customPct = input.float(1.0, title = 'Custom %', group = grp_main, tooltip = 'The custom percentage value used to calculate the Renko brick size.\n\nFormula: Brick Size = Current Close × (Custom % ÷ 100).\n\nThis value is applied ONLY in these cases:\n• Asset Selection Mode = \'Manual\'  AND  Manual Asset Pick = \'Custom\'  AND  Brick Size Calculation = \'Percentage\'.\n• OR Auto-Detect fails to recognize the chart symbol (fallback).\n\n⚠ Note: This field is ignored if \'Brick Size Calculation\' is set to \'Fixed Box Size\', or if any preset asset is selected in Manual mode.\n\n💡 Common starting points:\n   • Indices: 0.5–1%\n   • Stocks: 1–3%\n   • Crypto: 2–5%\n   • Commodities: 2–5%')

fixedBoxSize = input.float(50.0, title = 'Fixed Box Size (Points)', group = grp_main, tooltip = 'The absolute point value used as the Renko brick size.\n\nActive ONLY when \'Brick Size Calculation\' = \'Fixed Box Size\'.\n\nUnlike the % mode, this value never changes regardless of where price goes. A new brick is plotted every time price moves exactly this many points from the last brick\'s close.\n\n💡 Examples:\n   • BankNifty → 300–500 points\n   • Nifty → 100–200 points\n   • MCX Crude Oil → 50–100 points\n   • BTCUSD → 1000-2000 points\n\n⚠ Note: Make sure this value matches the minimum tick size of your instrument to avoid irregular bricks.')

maType1 = input.string(defval = 'EMA', title = 'MA 1 Length', options = ['SMA', 'EMA', 'SMMA (RMA)', 'WMA', 'VWMA'], group = grp_MA, inline = 'MA1', display = display.all - display.status_line)

maLen1 = input.int(10, title = '', group = grp_MA, inline = 'MA1', tooltip = 'Lookback period for the fast Exponential Moving Average (EMA 1).\n\n• EMA 1 is the faster of the two EMAs that form the trend cloud.\n• When EMA 1 is ABOVE EMA 2 → cloud turns Green (bullish momentum).\n• When EMA 1 is BELOW EMA 2 → cloud turns Red (bearish momentum).\n\n💡 Lower values = faster reaction but more false signals.\n   Higher values = smoother but slower reaction.\n   Common pairing: 10 (fast) / 30 (slow).')

src1 = input(close, title = '', group = grp_MA, inline = 'MA1')

maType2 = input.string(defval = 'EMA', title = 'MA 2 Length', options = ['SMA', 'EMA', 'SMMA (RMA)', 'WMA', 'VWMA'], group = grp_MA, inline = 'MA2', display = display.all - display.status_line)

maLen2 = input.int(30, title = '', group = grp_MA, inline = 'MA2', tooltip = 'Lookback period for the slow Exponential Moving Average (EMA 2).\n\n• EMA 2 is the slower of the two EMAs that form the trend cloud.\n• Acts as the baseline that EMA 1 crosses above/below to flip the cloud color.\n\n💡 Should always be LARGER than EMA 1 Length, otherwise the cloud logic reverses.\n   Common pairing: 10 (fast) / 30 (slow).')

src2 = input(close, title = '', group = grp_MA, inline = 'MA2')

maType3 = input.string(defval = 'SMA', title = 'MA 3 Length', options = ['SMA', 'EMA', 'SMMA (RMA)', 'WMA', 'VWMA'], group = grp_MA, inline = 'MA3', display = display.all - display.status_line)

maLen3 = input.int(150, title = '', group = grp_MA, inline = 'MA3', tooltip = 'Lookback period for the baseline Simple Moving Average (SMA).\n\nThe SMA acts as a macro-trend filter — it shows the long-term direction of price and helps you avoid taking trades against the dominant trend.\n\n💡 Higher values (e.g., 150, 200) = stronger, slower macro trend reference.\n   Lower values (e.g., 50, 100) = more responsive but noisier.\n\n⚠ Note: This SMA is for visual reference only. It does NOT change Renko brick behavior.')

src3 = input(close, title = '', group = grp_MA, inline = 'MA3')

grp_style = 'Style'
col1 = input.color(color.red, title = 'Ranko color (Downtrend)', group = grp_style, tooltip = 'Color of the Smart Renko step-line when the current close is BELOW the Renko level (price is trending down).\n\nThe step-line flips to this color to visually signal bearish pressure.')

col2 = input.color(color.green, title = 'Ranko color (Uptrend)', group = grp_style, tooltip = 'Color of the Smart Renko step-line when the current close is ABOVE the Renko level (price is trending up).\n\nThe step-line flips to this color to visually signal bullish pressure.')

col3 = input.color(color.gray, title = 'Ranko color (Neutral)', group = grp_style, tooltip = 'Fallback color for the Smart Renko step-line.\n\nUsed only when the current close EXACTLY equals the Renko level (a rare edge case).\n\n💡 Tip: Pick a neutral tone (gray, white) so it visually stands apart from the up/down colors.')

colMa1 = input.color(color.black, title = 'MA 1', group = grp_style, tooltip = 'Line color for the fast EMA (EMA 1).\n\nThis is the faster-moving line inside the trend cloud. It reacts quicker to price changes than EMA 2.')

colMa2 = input.color(color.green, title = 'MA 2', group = grp_style, tooltip = 'Line color for the slow EMA (EMA 2).\n\nThis is the slower-moving line inside the trend cloud. It acts as the baseline that EMA 1 crosses above/below.')

colMa3 = input.color(color.red, title = 'MA 3', group = grp_style, tooltip = 'Line color for the long-term Simple Moving Average (SMA).\n\nThe SMA is the thickest baseline line on the chart and represents the macro trend direction.')

cloudUpCol = input.color(color.new(color.green, 85), title = 'EMA Cloud Cloud Up color', group = grp_style, tooltip = 'Fill color of the area BETWEEN EMA 1 and EMA 2 when EMA 1 is ABOVE EMA 2.\n\nThis visually highlights bullish momentum — when the fast EMA is leading the slow EMA upward.\n\n💡 Tip: Use a translucent green (high transparency) so candles remain visible behind the cloud.')

cloudDnCol = input.color(color.new(color.red, 85), title = 'EMA Cloud Cloud Down color', group = grp_style, tooltip = 'Fill color of the area BETWEEN EMA 1 and EMA 2 when EMA 1 is BELOW EMA 2.\n\nThis visually highlights bearish momentum — when the fast EMA is leading the slow EMA downward.\n\n💡 Tip: Use a translucent red (high transparency) so candles remain visible behind the cloud.')

grp_dash = 'Dashboard Settings'
dashPosInput = input.string('Bottom Right', title = 'Dashboard Position', options = ['Top Left', 'Top Center', 'Top Right', 'Middle Left', 'Middle Center', 'Middle Right', 'Bottom Left', 'Bottom Center', 'Bottom Right'], group = grp_dash, tooltip = 'Screen position of the Smart Renko info dashboard.\n\nThe dashboard displays:\n   • ASSET — the detected/selected asset class name.\n   • BRICK SIZE — the live brick size currently in use (in points).\n   • TREND — current Renko trend state (Uptrend / Downtrend) with color coding.\n\n💡 Tip: Choose a corner that doesn\'t overlap with your candles, orders, or other indicators. \'Bottom Right\' is usually the cleanest spot.')



// ==============================================================================
// 2. PERCENTAGE AUTO-DETECT MATRIX
// ==============================================================================

symT = syminfo.type
tkr = syminfo.ticker
des = syminfo.description

get_asset_info() =>
    float p = customPct
    string n = 'Custom'

    if assetSelection == 'Auto-Detect'
        // 1. OPTIONS (Must be evaluated first so "NIFTY...CE" isn't caught as an Index)
        if str.contains(symT, 'option')
            if str.contains(tkr, 'NIFTY') or str.contains(tkr, 'BKX') or str.contains(tkr, 'BSX')
                p := 33.0
                n := 'INDEX OPTIONS'
                n
            else
                p := 33.0
                n := 'STOCK OPTIONS'
                n

        // 2. INDICES & ETFs (Pulled outside symT == "index" to safely catch NIFTYBEES/BANKBEES)
        else if str.contains(symT, 'index')
            // 2.A: SPECIALTY INDICES (Like INDIA VIX)
            if str.contains(tkr, 'VIX')
                p := 1.0
                n := 'INDIA VIX'
                n
            // 2.B: INDICES & ETFs
            else
                p := 0.66
                n := 'INDEX'
                n

        // 3. FUTURES
        else if str.contains(symT, 'futures')
            if str.contains(tkr, 'NIFTY') or str.contains(tkr, 'BKX') or str.contains(tkr, 'BSX')
                p := 0.66
                n := 'INDEX futures'
                n

        // 4. COMMODITIES (Protected against Equities containing GOLD/SILVER)
        else if symT != 'stock' and (str.contains(tkr, 'GOLD') or str.contains(tkr, 'XAU'))
            p := 3.0
            n := 'XAUUSD/GOLD'
            n
        else if symT != 'stock' and (str.contains(tkr, 'SILVER') or str.contains(tkr, 'XAG'))
            p := 3.0
            n := 'XAGUSD/SILVER'
            n
        else if symT != 'stock' and (str.contains(tkr, 'NATURAL') or str.contains(tkr, 'GAS'))
            p := 3.0
            n := 'NATURAL GAS'
            n
        else if symT != 'stock' and (str.contains(tkr, 'USOIL') or str.contains(tkr, 'WTI'))
            p := 5.0
            n := 'US OIL'
            n
        else if symT != 'stock' and (str.contains(des, 'CRUDE') or str.contains(tkr, 'CRUDE') or str.contains(des, 'Crude'))
            p := 3.0
            n := 'CRUDE OIL'
            n

        // 5. CRYPTO
        else if symT == 'crypto'
            p := 3.0
            n := 'CRYPTO'
            n

        // 6. EQUITIES (Catch-all for remaining standard stocks)
        else if symT == 'stock'
            p := 2.0
            n := 'STOCKS'
            n

    else // Manual Overrides
        if manualPick == 'NIFTY 50' or manualPick == 'BANKNIFTY' or manualPick == 'SENSEX'
            p := 0.66
            n := manualPick
            n
        else if manualPick == 'NIFTY OPTIONS' or manualPick == 'BANKNIFTY OPTIONS' or manualPick == 'SENSEX OPTIONS'
            p := 33.0
            n := manualPick
            n
        else if manualPick == 'STOCKS'
            p := 2.0
            n := manualPick
            n
        else if manualPick == 'Stock Options'
            p := 1.0
            n := manualPick
            n
        else if manualPick == 'US Oil'
            p := 5.0
            n := manualPick
            n
        else if manualPick == 'Natural Gas' or manualPick == 'XAUUSD/GOLD' or manualPick == 'XAGUSD/SILVER' or manualPick == 'BTCUSD' or manualPick == 'CRYPTO' or manualPick == 'Crude Oil'
            p := 3.0
            n := manualPick
            n

    [p, n]

[activePct, assetName] = get_asset_info()

// ==============================================================================
// 3. THE TRUE ENGINE 
// ==============================================================================
var float rClose = na
var int trend = 1

if na(rClose)
    rClose := close
    trend := 1
    trend

float bSize = brickCalcMode == 'Percentage' ? close * (activePct / 100) : fixedBoxSize

int max_iterations = 100
int iter = 0

while true and iter < max_iterations
    iter := iter + 1
    if trend == 1
        if close >= rClose + bSize
            rClose := rClose + bSize
            rClose
        else if close <= rClose - bSize
            trend := -1
            rClose := rClose - bSize
            rClose
        else
            break
    else
        if close <= rClose - bSize
            rClose := rClose - bSize
            rClose
        else if close >= rClose + bSize
            trend := 1
            rClose := rClose + bSize
            rClose
        else
            break

float liveBrickSize = bSize
float deltaLevel = rClose

color deltaColor = close > rClose ? col2 : close < rClose ? col1 : col3

// ==============================================================================
// 4. MOVING AVERAGE RIBBONS
// ==============================================================================

ma(source, length, _type) =>
    switch _type
        'SMA' => ta.sma(source, length)
        'EMA' => ta.ema(source, length)
        'SMMA (RMA)' => ta.rma(source, length)
        'WMA' => ta.wma(source, length)
        'VWMA' => ta.vwma(source, length)


ma1 = ma(src1, maLen1, maType1)
ma2 = ma(src2, maLen2, maType2)
ma3 = ma(src3, maLen3, maType3)

// Render 
plot(deltaLevel, title = 'Renko Line', color = deltaColor, style = plot.style_stepline, linewidth = 2)
pMa1 = plot(ma1, title = 'MA 1', color = colMa1, linewidth = 1)
pMa2 = plot(ma2, title = 'MA 2', color = colMa2, linewidth = 1)
plot(ma3, title = 'MA 3', color = colMa3, linewidth = 2)

fillColor = ma1 > ma2 ? cloudUpCol : cloudDnCol
fill(pMa1, pMa2, color = fillColor, title = 'MA Cloud')

// ==============================================================================
// 5. DASHBOARD UI
// ==============================================================================

// Map string selections to system position constants
table_pos = switch dashPosInput
    'Top Left' => position.top_left
    'Top Center' => position.top_center
    'Top Right' => position.top_right
    'Middle Left' => position.middle_left
    'Middle Center' => position.middle_center
    'Middle Right' => position.middle_right
    'Bottom Left' => position.bottom_left
    'Bottom Center' => position.bottom_center
    => position.bottom_right // "Bottom Right" fallback

var table dash = table.new(table_pos, 2, 5, border_width = 1, border_color = color.gray, bgcolor = color.white)

if barstate.islast
    table.cell(dash, 0, 0, 'ASSET', text_color = color.white, bgcolor = #2b2b36, text_halign = text.align_left)
    table.cell(dash, 1, 0, assetName, text_color = color.black, text_halign = text.align_center)

    table.cell(dash, 0, 1, 'BRICK SIZE', text_color = color.white, bgcolor = #2b2b36, text_halign = text.align_left)
    table.cell(dash, 1, 1, str.tostring(liveBrickSize, '#.##'), text_color = color.black, text_halign = text.align_center)

    table.cell(dash, 0, 2, 'TREND', text_color = color.white, bgcolor = #2b2b36, text_halign = text.align_left)
    table.cell(dash, 1, 2, deltaColor == col2 ? 'Uptrend' : 'Downtrend', text_color = deltaColor, text_halign = text.align_center)
