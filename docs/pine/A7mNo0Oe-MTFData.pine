//@version=6

// @description Functions to store multi timeframe candle data and swing points.
library("MTFData")

// @function Stores current or higher timeframe candle data in arrays.
// @param timeframe The timeframe, for example "240" for 4h
// @param openArray An array to store the candle open price
// @param highArray An array to store the candle high price
// @param lowArray An array to store the candle low price
// @param closeArray An array to store the candle close price
// @param timeArray An array to store the candle time
// @param alltfs_olcLookback An array holding the candle time of olcLookback candles ago, which can be used for limiting lookbacks
// @param olcLookback The history reference of the lookback limiting candle
// @param tfIndex The timeframe's index in the alltfs_olcLookback array
// @returns true if the timeframe changed
export getCandleData(string timeframe, array<float> openArray, array<float> highArray, array<float> lowArray, array<float> closeArray, array<int> timeArray, int olcLookback, array<int> alltfs_olcLookback, int tfIndex) =>
    var currenttf_seconds = timeframe.in_seconds(timeframe.period)
	tfChanged = false
    if timeframe.in_seconds(timeframe) != currenttf_seconds
        [prev_o, prev_h, prev_l, prev_c, prev_t] = request.security(syminfo.tickerid, timeframe, [open[1], high[1], low[1], close[1], time[1]], lookahead=barmerge.lookahead_on)
        tfChange = array.size(timeArray) == 0 or (not na(prev_t) and prev_t > array.get(timeArray, 0))
        if tfChange and not na(prev_t)
            array.unshift(openArray, prev_o)
            array.unshift(highArray, prev_h)
            array.unshift(lowArray, prev_l)
            array.unshift(closeArray, prev_c)
            array.unshift(timeArray, prev_t)
            array.set(alltfs_olcLookback, tfIndex, prev_t - (timeframe.in_seconds(timeframe) * olcLookback * 1000))
            tfChanged := true
            if array.size(openArray) > 10
                array.pop(openArray)
                array.pop(highArray)
                array.pop(lowArray)
                array.pop(closeArray)
                array.pop(timeArray)
    if timeframe.in_seconds(timeframe) == currenttf_seconds
        array.unshift(openArray, open[1])
        array.unshift(highArray, high[1])
        array.unshift(lowArray, low[1])
        array.unshift(closeArray, close[1])
        array.unshift(timeArray, time[1])
        array.set(alltfs_olcLookback, tfIndex, time[1] - (timeframe.in_seconds(timeframe) * olcLookback * 1000))
        tfChanged := true
        if array.size(openArray) > 10
            array.pop(openArray)
            array.pop(highArray)
            array.pop(lowArray)
            array.pop(closeArray)
            array.pop(timeArray)
    tfChanged

// @function Stores current or higher timeframe swingpoint data into arrays.
// @param tfchange Must be true when the timeframe has changed (a new candle has opened)
// @param timeframe The timeframe, for example "240" for 4h
// @param openArray An array that stores the timeframe's candle open price
// @param highArray An array that stores the timeframe's candle high price
// @param lowArray An array that stores the timeframe's candle low price
// @param closeArray An array that stores the timeframe's candle close price
// @param timeArray An array that stores the timeframe's candle time
// @param highWickArray An array to store the swing high price
// @param highBodyArray An array to store the swing high's highest body price
// @param highTimeArray An array to store the swing high candle's time
// @param lowWickArray An array to store the swing low price
// @param lowBodyArray An array to store the swing low's lowest body price
// @param lowTimeArray An array to store the swing high candle's time
// @param alltfs_olcLookback An array holding the time of the max allowed swing point age
// @param tfIndex The timeframe's index in the alltfs_olcLookback array
// @returns Nothing. The array handling happens inside the function.
export trackHiLo(bool tfchange,string timeframe, array<float> openArray, array<float> highArray, array<float> lowArray, array<float> closeArray, array<int> timeArray, array<float> highWickArray, array<float> highBodyArray, array<int> highTimeArray, array<float> lowWickArray, array<float> lowBodyArray, array<int> lowTimeArray, array<int> alltfs_olcLookback, int tfIndex) =>
    var currenttf_seconds = timeframe.in_seconds(timeframe.period)
	if timeframe.in_seconds(timeframe) >= currenttf_seconds and array.size(openArray) == 10 and tfchange
        open0 = array.get(openArray,0)
        high0 = array.get(highArray,0)
        low0 = array.get(lowArray,0)
        close0 = array.get(closeArray,0)
        time0 = array.get(timeArray,0)
        open1 = array.get(openArray,1)
        high1 = array.get(highArray,1)
        low1 = array.get(lowArray,1)
        close1 = array.get(closeArray,1)
        if low0 > low1
            lowestBody = math.min(close0,close1,open0,open1)
            lowestWick = low1
            for i = 2 to 9
                if math.min(array.get(openArray,i),array.get(closeArray,i)) < lowestBody
                    lowestBody := math.min(array.get(openArray,i),array.get(closeArray,i))
                if array.get(lowArray,i) < lowestWick
                    lowestWick := array.get(lowArray,i)
                if array.get(lowArray,i) > array.get(lowArray,i - 1)
                    array.push(lowWickArray,lowestWick)
                    array.push(lowBodyArray,lowestBody)
                    array.push(lowTimeArray,array.get(timeArray,i - 1))
                    break
        if high0 < high1
            highestBody = math.max(close0,close1,open0,open1)
            highestWick = high1
            for i = 2 to 9
                if math.max(array.get(openArray,i),array.get(closeArray,i)) > highestBody
                    highestBody := math.max(array.get(openArray,i),array.get(closeArray,i))
                if array.get(highArray,i) > highestWick
                    highestWick := array.get(highArray,i)
                if array.get(highArray,i) < array.get(highArray,i - 1)
                    array.push(highWickArray,highestWick)
                    array.push(highBodyArray,highestBody)
                    array.push(highTimeArray,array.get(timeArray,i - 1))
                    break
        // Remove HiLos that are too old or closed through or swept
        olcMaxAge = array.get(alltfs_olcLookback,tfIndex)
        if array.size(highTimeArray) > 0
            for i = array.size(highTimeArray) - 1 to 0 
                if math.max(open1,close1) > array.get(highBodyArray,i) and high0 < array.get(highBodyArray,i)
                    array.set(highBodyArray,i,na)
                if array.get(highTimeArray,i) < olcMaxAge or array.get(closeArray,2) >= array.get(highWickArray,i) or array.get(highArray,2) > array.get(highWickArray,i) and array.get(highArray,0) < array.get(highArray,2)
                    array.remove(highWickArray,i)
                    array.remove(highBodyArray,i)
                    array.remove(highTimeArray,i)
        if array.size(lowTimeArray) > 0
            for i = array.size(lowTimeArray) - 1 to 0 
                if math.min(open1,close1) < array.get(lowBodyArray,i) and low0 > array.get(lowBodyArray,i)
                    array.set(lowBodyArray,i,na)
                if array.get(lowTimeArray,i) < olcMaxAge or array.get(closeArray,2) <= array.get(lowWickArray,i) or array.get(lowArray,2) < array.get(lowWickArray,i) and array.get(lowArray,0) > array.get(lowArray,2)
                    array.remove(lowWickArray,i)
                    array.remove(lowBodyArray,i)
                    array.remove(lowTimeArray,i)

// @function Converts a timeframe string ("240") into a more readable string ("4h").
// @param tfInSec The timeframe that should be converted, as timeframe.in_seconds()
// @returns A more readable timeframe string
export tfReadable(int tfInSec) =>
    if tfInSec == 604800
        "W"
    else if tfInSec % timeframe.in_seconds("1M") == 0
        tfInSec == timeframe.in_seconds("1M") ? "M" : str.tostring(tfInSec / timeframe.in_seconds("1M")) + "M"
    else if tfInSec % 86400 == 0
        tfInSec == 86400 ? "D" : str.tostring(tfInSec / 86400) + "D"
    else if tfInSec % 3600 == 0
        str.tostring(tfInSec / 3600) + "h"
    else if tfInSec >= 60
        str.tostring(tfInSec / 60) + "m"
    else
        str.tostring(tfInSec) + "s"