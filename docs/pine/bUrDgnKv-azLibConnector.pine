// === VERSION ===

//@version=5

// @description Provides functions to communicate and chain the signal values stream between Azullian strategy builder blocks through connectors.
library("azLibConnector", false)

// === CONSTANTS ===

// ————— Constants: Connector Signal Stream
var float NEUTRAL = 500500.500501

// === FUNCTIONS ===

// ————— Function: Get a part of a string value  
substr(str, from, till) =>
    chars = str.split(str, '')
    len = array.size(chars)
    beg = math.min(len - 1, math.max(0, from))
    end = math.min(len, math.max(0, till + 1))
    substr = array.new_string(0)
    if beg <= end
        substr := array.slice(chars, beg, end)
    string r = array.join(substr, '')

// ————— Function: Round to floor when negative value, Round to ceil when positive
round(v) =>
    int r = v < 0 ? math.floor(v) : v > 0 ? math.ceil(v) : 0

// === EXPORTS ===

// @function            Extract signals (EL, XL, ES, XS) from incoming connector signal stream
// @param srcConnector  (series float) Source Connector. The connector stream series to extract the signals from.
// @returns             A tuple containing the extracted EL, XL, ES, XS signal values.
//                      [
//                      (series float) Entry Long signal value.
//                      (series float) Exit Long signal value.
//                      (series float) Entry Short signal value.
//                      (series float) Exit Short signal value.
//                      ]
export extract(series float srcConnector) =>
    string stream = str.tostring(nz(srcConnector, NEUTRAL), '#.000000')
    float signalEL = str.tonumber(substr(stream, 0, 2)) - 500
    float signalXL = str.tonumber(substr(stream, 3, 5)) - 500
    float signalES = str.tonumber(substr(stream, 7, 9)) - 500
    float signalXS = str.tonumber(substr(stream, 10, 12)) - 501
    [signalEL, signalXL, signalES, signalXS]

// @function        Compose a connector output signal stream from given EL, XL, ES and XS signals to be used by other Azullian Strategy Builder blocks.
// @param signalEL  (series float) Entry Long signal value.
// @param signalXL  (series float) Exit Long signal value.
// @param signalES  (series float) Entry Short signal value.
// @param signalXS  (series float) Exit Short signal value.
// @returns         (series float) A composed connector output signal stream.
export compose(series float signalEL, series float signalXL, series float signalES, series float signalXS) =>
    float r = NEUTRAL + (round(signalEL) * 1000) + round(signalXL) + (round(signalES) / 1000) + (round(signalXS) / 1000000)

// === EXAMPLE ===

// ————— Inputs
var float i_connector = 512509.506504 //i_connector = input.source(title='→', defval=close, group=connectorGroupName, tooltip="→: Connector. Important! Connect here with the latest Connector from your Indicator Connector Chain to start receiving Signals.")

// ————— Calculations
[signalEL, signalXL, signalES, signalXS] = extract(i_connector)
connectorOut = compose(signalEL, signalXL, signalES, signalXS)

// ————— Visuals

// ————— Visuals: Plot Extracted Signals
plot(signalEL, style=plot.style_line, linewidth=2, color=color.rgb(38, 166, 154), title='EL')
plot(signalXL, style=plot.style_line, linewidth=2, color=color.rgb(0, 73, 75), title='XL')
plot(signalES, style=plot.style_line, linewidth=2, color=color.rgb(233, 30, 99), title='ES')
plot(signalXS, style=plot.style_line, linewidth=2, color=color.rgb(125, 0, 67), title='XS')

// ————— Visuals: Plot Connector
plot(connectorOut, title='Connector', display=display.none, transp=100)