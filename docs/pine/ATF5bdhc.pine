//@version=6
strategy("Advanced Multi-MA Slope, ADX & Cross System v9.4", overlay=true, margin_long=100, margin_short=100, max_bars_back=5000)

// ==========================================
// 1. INPUTS - MA SELECTOR & SETTINGS
// ==========================================
grp_ma      = "Core Moving Average Settings"
ma_type     = input.string("ALMA", title="Base MA Type", options=["ALMA", "EMA", "VWMA", "Hull MA", "TSI"], group=grp_ma)
ma_len      = input.int(9, title="MA Period / Length", group=grp_ma)
slope_len   = input.int(1, title="Slope Lookback Bars", group=grp_ma)

// Specific MA Custom Inputs
alma_offset = input.float(0.85, title="[ALMA Only] Offset (Lag Balance)", group=grp_ma)
alma_sigma  = input.float(6.0, title="[ALMA Only] Sigma (Smoothing)", group=grp_ma)
tsi_long    = input.int(25, title="[TSI Only] Long Smooth Length", group=grp_ma)
tsi_short   = input.int(13, title="[TSI Only] Short Smooth Length", group=grp_ma)

grp_filter  = "Re-entry / Slope Acceleration Filter"
use_slope_accel = input.bool(true, title="Enable Slope Acceleration Filter", group=grp_filter)
accel_bars      = input.int(2, title="Required Strengthening Bars", minval=1, group=grp_filter)

grp_adx       = "ADX Trend Strength Filter"
use_adx       = input.bool(true, title="Enable ADX Filter", group=grp_adx)
adx_len       = input.int(14, title="ADX Period", minval=1, group=grp_adx)
adx_thold     = input.float(20.0, title="ADX Threshold", minval=0.0, step=0.5, group=grp_adx)
adx_must_rise = input.bool(true, title="ADX Must Be Rising?", group=grp_adx)

grp_reentry      = "Dynamic Re-entry Settings"
allow_mid_trend  = input.bool(true, title="Allow Mid-Trend Re-entry", group=grp_reentry)
reentry_cooldown = input.int(3, title="Minimum Cooldown Bars for Re-entry", minval=1, group=grp_reentry)

grp_slope_exit   = "Slope Deceleration Early Exit"
use_slope_exit   = input.bool(false, title="Exit on Slope Deceleration", group=grp_slope_exit)
slope_exit_bars  = input.int(3, title="Consecutive Deceleration Bars", minval=1, group=grp_slope_exit)
// [DÜZELTME] Slope sıfır kesişiminde kapatma seçeneği eklendi
exit_on_cross    = input.bool(true, title="Exit on Slope Crossing Zero", group=grp_slope_exit)

grp_vwma    = "VWMA Exit Settings"
vwma_len    = input.int(20, title="VWMA Exit Period", group=grp_vwma)

grp_modes   = "System Modes (Toggle)"
use_slope_entry = input.bool(true, title="Entry Based on Slope", group=grp_modes)
use_cross_entry = input.bool(false, title="Entry Based on Price Cross", group=grp_modes)
use_cross_exit  = input.bool(false, title="Exit on Reverse MA Cross", group=grp_modes)
use_vwma_exit   = input.bool(false, title="Exit on Reverse VWMA Cross", group=grp_modes)

grp_fixed_exit = "Instant Reflexive Exits (SL / TP)"
use_sl         = input.bool(true, title="Enable Fixed Stop Loss (SL)", group=grp_fixed_exit)
sl_perc        = input.float(1.0, title="Stop Loss Percent (%)", minval=0.001, step=0.05, group=grp_fixed_exit) / 100
use_tp         = input.bool(false, title="Enable Fixed Take Profit (TP)", group=grp_fixed_exit)
tp_perc        = input.float(2.0, title="Take Profit Percent (%)", minval=0.001, step=0.05, group=grp_fixed_exit) / 100
grp_trail   = "Trailing Stop Settings"
use_trail   = input.bool(false, title="Enable Trailing Stop", group=grp_trail)
trail_start = input.float(1.5, title="Trailing Start Distance (%)", minval=0.001, step=0.05, group=grp_trail) / 100
trail_dist  = input.float(1.0, title="Trailing Follow Distance (%)", minval=0.001, step=0.05, group=grp_trail) / 100

grp_smart_trail = "Smart (Dynamic) Flexibility Settings"
use_smart_trail = input.bool(false, title="Adapt Percent TS with ATR", group=grp_smart_trail)
smart_atr_len   = input.int(14, title="Current Volatility (ATR) Period", minval=1, group=grp_smart_trail)
smart_ma_len    = input.int(50, title="Historical Volatility Avg (ATR SMA)", minval=1, group=grp_smart_trail)

grp_auto_calc   = "Automatic ATR Calculator Engine"
use_auto_calc   = input.bool(true, title="Use Live ATR Calculated Dashboard Values", group=grp_auto_calc)
auto_atr_len    = input.int(14, title="Calculator ATR Period", minval=1, group=grp_auto_calc)
auto_sl_mult    = input.float(1.5, title="Calculator SL ATR Multiplier", minval=0.01, step=0.1, group=grp_auto_calc)
auto_ts_start   = input.float(2.0, title="Calculator TS Start Multiplier", minval=0.01, step=0.1, group=grp_auto_calc)
auto_ts_follow  = input.float(1.2, title="Calculator TS Follow Multiplier", minval=0.01, step=0.1, group=grp_auto_calc)

// ==========================================
// 2. MULTI-MA CORE CALCULATION ENGINE
// ==========================================
tsi_val = ta.tsi(close, tsi_short, tsi_long)
tsi_price_mapped = ta.ema(close, ma_len) * (1 + tsi_val) 

get_ma(type, len) =>
    switch type
        "ALMA"    => ta.alma(close, len, alma_offset, alma_sigma)
        "EMA"     => ta.ema(close, len)
        "VWMA"    => ta.vwma(close, len)
        "Hull MA" => ta.hma(close, len)
        "TSI"     => tsi_price_mapped
        => ta.alma(close, len, alma_offset, alma_sigma)

main_ma_val = get_ma(ma_type, ma_len)
vwma_val    = ta.vwma(close, vwma_len)
ma_slope    = main_ma_val - main_ma_val[slope_len]

// ==========================================
// 3. INDICATOR CALCULATIONS & FILTERS
// ==========================================
[plusDI, minusDI, adx_val] = ta.dmi(adx_len, adx_len)
adx_condition = adx_must_rise ? (adx_val >= adx_thold and adx_val > adx_val[1]) : (adx_val >= adx_thold)
adx_filter = use_adx ? adx_condition : true

slope_rising  = ma_slope > ma_slope[1]
slope_falling = ma_slope < ma_slope[1]
accel_long_filter  = use_slope_accel ? (ta.barssince(not slope_rising) >= accel_bars) : true
accel_short_filter = use_slope_accel ? (ta.barssince(not slope_falling) >= accel_bars) : true

slope_fading_long  = ma_slope < ma_slope[1] and ma_slope > 0
slope_fading_short = ma_slope > ma_slope[1] and ma_slope < 0
slope_exit_long_check  = ta.barssince(not slope_fading_long) >= slope_exit_bars
slope_exit_short_check = ta.barssince(not slope_fading_short) >= slope_exit_bars

current_atr    = ta.atr(smart_atr_len)
historic_atr   = ta.sma(current_atr, smart_ma_len)
volatility_mult = (historic_atr > 0 and current_atr > 0) ? (current_atr / historic_atr) : 1.0

final_trail_start = use_smart_trail ? (trail_start * volatility_mult) : trail_start
final_trail_dist  = use_smart_trail ? (trail_dist * volatility_mult) : trail_dist

// AUTOMATIC ENGINE MATHEMATICS
calc_atr = ta.atr(auto_atr_len)
auto_sl_perc    = (calc_atr * auto_sl_mult) / close
auto_start_perc = (calc_atr * auto_ts_start) / close
auto_dist_perc  = (calc_atr * auto_ts_follow) / close

// SEÇİM KÖPRÜSÜ
actual_sl_perc     = use_auto_calc ? auto_sl_perc : sl_perc
actual_trail_start = use_auto_calc ? auto_start_perc : final_trail_start
actual_trail_dist  = use_auto_calc ? auto_dist_perc : final_trail_dist

plot(main_ma_val, title="Selected Base MA", color=ma_slope > 0 ? color.green : color.red, linewidth=2)
plot(use_vwma_exit ? vwma_val : na, title="VWMA Exit", color=color.orange, linewidth=1, style=plot.style_linebr)

// ==========================================
// 4. BAR-CONFIRMED RE-ENTRY ENGINE
// ==========================================
var int last_exit_bar_idx = 0
var float slope_at_last_exit = 0.0

// ==========================================
// 5. SIGNAL CONDITIONS
// ==========================================
slope_crossed_up   = ta.crossover(ma_slope, 0)
slope_crossed_down = ta.crossunder(ma_slope, 0)

base_cross_long  = ta.crossover(close, main_ma_val)
base_cross_short = ta.crossunder(close, main_ma_val)

cooldown_passed = (bar_index - last_exit_bar_idx) >= reentry_cooldown

dynamic_reentry_long  = allow_mid_trend and cooldown_passed and (ma_slope > 0) and (ma_slope > slope_at_last_exit) and slope_rising and accel_long_filter
dynamic_reentry_short = allow_mid_trend and cooldown_passed and (ma_slope < 0) and (ma_slope < slope_at_last_exit) and slope_falling and accel_short_filter

slope_long  = adx_filter and (slope_crossed_up or dynamic_reentry_long) and cooldown_passed
slope_short = adx_filter and (slope_crossed_down or dynamic_reentry_short) and cooldown_passed

cross_long  = adx_filter and (base_cross_long or dynamic_reentry_long) and cooldown_passed
cross_short = adx_filter and (base_cross_short or dynamic_reentry_short) and cooldown_passed

long_condition  = (use_slope_entry and slope_long) or (use_cross_entry and cross_long)
short_condition = (use_slope_entry and slope_short) or (use_cross_entry and cross_short)

// [DÜZELTME] Slope sıfır kesişimini de çıkış koşullarına ekledim
exit_long_condition  = (use_cross_exit and ta.crossunder(close, main_ma_val)) 
                     or (use_vwma_exit and ta.crossunder(close, vwma_val)) 
                     or (use_slope_exit and slope_exit_long_check)
                     or (exit_on_cross and ta.crossunder(ma_slope, 0))

exit_short_condition = (use_cross_exit and ta.crossover(close, main_ma_val)) 
                     or (use_vwma_exit and ta.crossover(close, vwma_val)) 
                     or (use_slope_exit and slope_exit_short_check)
                     or (exit_on_cross and ta.crossover(ma_slope, 0))

// ==========================================
// 6. DYNAMIC ACCELERATING SL & TS ENGINE (YENİ HİBRİT MOTOR)
// ==========================================
var float dynamic_long_sl  = na
var float dynamic_short_sl = na

long_entered  = strategy.position_size > 0 and strategy.position_size[1] <= 0
short_entered = strategy.position_size < 0 and strategy.position_size[1] >= 0

int bars_in_long  = ta.barssince(strategy.position_size <= 0)
int bars_in_short = ta.barssince(strategy.position_size >= 0)

highest_since_entry = ta.highest(high, math.max(1, bars_in_long + 1))
lowest_since_entry  = ta.lowest(low, math.max(1, bars_in_short + 1))

// --- LONG İÇİN BAŞLANGIÇTAN İTİBAREN İZ SÜREN DİNAMİK STOP ---
if strategy.position_size > 0
    if long_entered
        dynamic_long_sl := strategy.position_avg_price * (1 - actual_sl_perc)
    else
        calculated_sl_move = highest_since_entry * (1 - actual_sl_perc)
        if calculated_sl_move > dynamic_long_sl
            dynamic_long_sl := calculated_sl_move
else
    dynamic_long_sl := na

// --- SHORT İÇİN BAŞLANGIÇTAN İTİBAREN İZ SÜREN DİNAMİK STOP ---
if strategy.position_size < 0
    if short_entered
        dynamic_short_sl := strategy.position_avg_price * (1 + actual_sl_perc)
    else
        calculated_short_sl_move = lowest_since_entry * (1 + actual_sl_perc)
        if calculated_short_sl_move < dynamic_short_sl
            dynamic_short_sl := calculated_short_sl_move
else
    dynamic_short_sl := na

// Sabit TP Seviyeleri
long_tp_price   = use_tp ? strategy.position_avg_price * (1 + tp_perc) : na
short_tp_price  = use_tp ? strategy.position_avg_price * (1 - tp_perc) : na

// Trailing Stop Tetik ve Takip Seviyeleri (Görev Devralacak Sistem)
long_t_trigger  = use_trail ? strategy.position_avg_price * (1 + actual_trail_start) : na
long_t_offset   = use_trail ? math.max(1, math.round((strategy.position_avg_price * actual_trail_dist) / syminfo.mintick)) : na

short_t_trigger = use_trail ? strategy.position_avg_price * (1 - actual_trail_start) : na
short_t_offset  = use_trail ? math.max(1, math.round((strategy.position_avg_price * actual_trail_dist) / syminfo.mintick)) : na

// ==========================================
// 7. STRATEGY ORDER MANAGEMENT
// ==========================================
if barstate.isconfirmed
    // --- Exit kontrolleri ---
    bool exit_occurred = false

    if (strategy.position_size > 0 and exit_long_condition)
        strategy.close("Base MA Long", comment="Condition Exit")
        exit_occurred := true

    if (strategy.position_size < 0 and exit_short_condition)
        strategy.close("Base MA Short", comment="Condition Exit")
        exit_occurred := true

    // --- Kapanan işlem bilgilerini güncelle ---
    bool trade_closed = strategy.closedtrades != strategy.closedtrades[1]
    if trade_closed
        last_exit_bar_idx := bar_index
        slope_at_last_exit := ma_slope[1]

    // --- Entry kontrolleri (sadece exit olmadıysa ve mevcut pozisyonun tersi değilse) ---
    if not exit_occurred
        if long_condition and (strategy.position_size >= 0)
            strategy.entry("Base MA Long", strategy.long, comment="Long Entry")
        if short_condition and (strategy.position_size <= 0)
            strategy.entry("Base MA Short", strategy.short, comment="Short Entry")

// ==========================================
// 8. INTRABAR REFLEXIVE EXIT ENGINE
// ==========================================
strategy.exit("Exit_L", from_entry="Base MA Long", stop=use_sl ? dynamic_long_sl : na, limit=long_tp_price, trail_price=long_t_trigger, trail_offset=long_t_offset, comment_loss="Dynamic SL", comment_profit="Reflexive TP", comment_trailing="TS Active")
strategy.exit("Exit_S", from_entry="Base MA Short", stop=use_sl ? dynamic_short_sl : na, limit=short_tp_price, trail_price=short_t_trigger, trail_offset=short_t_offset, comment_loss="Dynamic SL", comment_profit="Reflexive TP", comment_trailing="TS Active")

// ==========================================
// 9. LIVE VISUALIZATION MOTOR
// ==========================================
bool plot_long  = strategy.position_size > 0
bool plot_short = strategy.position_size < 0
var float live_ts_level = na
var int bars_since_entry = 0

if plot_long
    bars_since_entry := math.max(1, ta.barssince(strategy.position_size[1] <= 0) + 1)
    highest_high_since_entry = ta.highest(high, bars_since_entry)
    if highest_high_since_entry >= (strategy.position_avg_price * (1 + actual_trail_start))
        live_ts_level := highest_high_since_entry * (1 - actual_trail_dist)
else if plot_short
    bars_since_entry := math.max(1, ta.barssince(strategy.position_size[1] >= 0) + 1)
    lowest_low_since_entry = ta.lowest(low, bars_since_entry)
    if lowest_low_since_entry <= (strategy.position_avg_price * (1 - actual_trail_start))
        live_ts_level := lowest_low_since_entry * (1 + actual_trail_dist)
else
    live_ts_level := na

plot(plot_long or plot_short ? strategy.position_avg_price : na, title="Entry Price", color=color.blue, style=plot.style_linebr, linewidth=1)
plot(use_sl and (plot_long or plot_short) ? (plot_long ? dynamic_long_sl : dynamic_short_sl) : na, title="Live Dynamic Stop Loss", color=color.red, style=plot.style_linebr, linewidth=2)
plot(use_tp and (plot_long or plot_short) ? (plot_long ? long_tp_price : short_tp_price) : na, title="Live Take Profit", color=color.lime, style=plot.style_linebr, linewidth=1)
plot(use_trail and (plot_long or plot_short) ? (plot_long ? strategy.position_avg_price * (1 + actual_trail_start) : strategy.position_avg_price * (1 - actual_trail_start)) : na, title="TS Trigger Target", color=color.purple, style=plot.style_circles, linewidth=1)
plot(use_trail and not na(live_ts_level) ? live_ts_level : na, title="Live Trailing Stop Line", color=color.fuchsia, style=plot.style_linebr, linewidth=2)

// ==========================================
// 10. PERFORMANCE TABLE
// ==========================================
var table perfTable = table.new(position.top_right, 2, 11, border_width=1, border_color=color.gray)

if barstate.islast
    totalTrades = strategy.closedtrades
    winRate     = totalTrades > 0 ? (strategy.wintrades / totalTrades) * 100 : 0
    netProfit   = strategy.netprofit
    
    table.cell(perfTable, 0, 0, "SYSTEM METRIC", bgcolor=color.rgb(17, 17, 17), text_color=color.white, text_size=size.small)
    table.cell(perfTable, 1, 0, "LIVE VALUE", bgcolor=color.rgb(17, 17, 17), text_color=color.white, text_size=size.small)
    table.cell(perfTable, 0, 1, "Selected MA", bgcolor=color.gray, text_color=color.white, text_size=size.small)
    table.cell(perfTable, 1, 1, ma_type, bgcolor=color.blue, text_color=color.white, text_size=size.small)
    table.cell(perfTable, 0, 2, "Net Profit", bgcolor=color.gray, text_color=color.white, text_size=size.small)
    table.cell(perfTable, 1, 2, str.tostring(netProfit, "#.##"), bgcolor=netProfit >= 0 ? color.lime : color.red, text_color=color.white, text_size=size.small)
    table.cell(perfTable, 0, 3, "Win Rate", bgcolor=color.gray, text_color=color.white, text_size=size.small)
    table.cell(perfTable, 1, 3, "%" + str.tostring(winRate, "#.#"), bgcolor=color.aqua, text_color=color.white, text_size=size.small)
    table.cell(perfTable, 0, 4, "Total Trades", bgcolor=color.gray, text_color=color.white, text_size=size.small)
    table.cell(perfTable, 1, 4, str.tostring(totalTrades), bgcolor=color.white, text_color=color.black, text_size=size.small)
    pos_text = plot_long ? "LONG" : (plot_short ? "SHORT" : "FLAT")
    pos_color = plot_long ? color.lime : (plot_short ? color.red : color.gray)
    table.cell(perfTable, 0, 5, "Current Position", bgcolor=color.gray, text_color=color.white, text_size=size.small)
    table.cell(perfTable, 1, 5, pos_text, bgcolor=pos_color, text_color=color.white, text_size=size.small)
    flex_text = use_smart_trail ? "x" + str.tostring(volatility_mult, "#.##") + " (Dinamik)" : "x1.00 (Sabit)"
    flex_color = use_smart_trail ? color.purple : color.gray
    table.cell(perfTable, 0, 6, "Smart TS Multiplier", bgcolor=color.gray, text_color=color.white, text_size=size.small)
    table.cell(perfTable, 1, 6, flex_text, bgcolor=flex_color, text_color=color.white, text_size=size.small)

    table.cell(perfTable, 0, 7, "Auto Engine Mode", bgcolor=color.rgb(30, 30, 30), text_color=color.white, text_size=size.small)
    table.cell(perfTable, 1, 7, use_auto_calc ? "ACTIVE (AUTO)" : "OFF (MANUAL)", bgcolor=use_auto_calc ? color.green : color.orange, text_color=color.white, text_size=size.small)
    table.cell(perfTable, 0, 8, "Calculated Auto SL", bgcolor=color.gray, text_color=color.white, text_size=size.small)
    table.cell(perfTable, 1, 8, "%" + str.tostring(auto_sl_perc * 100, "#.##"), bgcolor=color.rgb(50, 10, 10), text_color=color.white, text_size=size.small)
    table.cell(perfTable, 0, 9, "Calculated Auto TS Start", bgcolor=color.gray, text_color=color.white, text_size=size.small)
    table.cell(perfTable, 1, 9, "%" + str.tostring(auto_start_perc * 100, "#.##"), bgcolor=color.rgb(40, 10, 40), text_color=color.white, text_size=size.small)
    table.cell(perfTable, 0, 10, "Calculated Auto TS Dist", bgcolor=color.gray, text_color=color.white, text_size=size.small)
    table.cell(perfTable, 1, 10, "%" + str.tostring(auto_dist_perc * 100, "#.##"), bgcolor=color.rgb(50, 10, 50), text_color=color.white, text_size=size.small)