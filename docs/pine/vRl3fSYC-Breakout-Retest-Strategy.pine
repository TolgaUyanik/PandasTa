//@version=5
indicator("Breakout + Retest Strategy", overlay=true)

// === USER INPUTS ===
breakoutLength = input.int(20, title="Breakout Lookback", minval=1)
rsiSource = input.source(close, title="RSI Source")
rsiPeriod = input.int(14, title="RSI Period")
rsiOverbought = input.int(70, title="RSI Overbought")
rsiOversold = input.int(30, title="RSI Oversold")

// === CALCULATIONS ===
highestHigh = ta.highest(high, breakoutLength)
lowestLow = ta.lowest(low, breakoutLength)
rsi = ta.rsi(rsiSource, rsiPeriod)

// === LOGIC ===
// Breakout logic
longBreakout = close > highestHigh[1]
shortBreakout = close < lowestLow[1]

// Retest logic
longRetest = low <= highestHigh[1] and close > highestHigh[1]
shortRetest = high >= lowestLow[1] and close < lowestLow[1]

// Entry conditions (with RSI confirmation)
longEntry = longBreakout and longRetest and rsi > rsiOversold
shortEntry = shortBreakout and shortRetest and rsi < rsiOverbought

// === PLOTTING ===
plotshape(longEntry, title="Long Entry", location=location.belowbar, color=color.green, style=shape.labelup, text="Long")
plotshape(shortEntry, title="Short Entry", location=location.abovebar, color=color.red, style=shape.labeldown, text="Short")

plot(highestHigh[1], title="Breakout High", color=color.green, linewidth=1, style=plot.style_linebr)
plot(lowestLow[1], title="Breakout Low", color=color.red, linewidth=1, style=plot.style_linebr)

// === ALERT CONDITIONS ===
alertcondition(longEntry, title="Long Entry Alert", message='Breakout + Retest Long Entry Triggered')
alertcondition(shortEntry, title="Short Entry Alert", message='Breakout + Retest Short Entry Triggered')
