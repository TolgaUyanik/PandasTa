//@version=6
library("tgpFibonacciLib_v2", overlay=false)

// ──────────────────────────────
// CONSTANTS
// ──────────────────────────────
export const float FIB_236 = 0.236
export const float FIB_382 = 0.382
export const float FIB_50  = 0.500
export const float FIB_618 = 0.618
export const float FIB_786 = 0.786
export const float FIB_127 = 1.272
export const float FIB_161 = 1.618
export const float FIB_200 = 2.000
export const float FIB_261 = 2.618

// ──────────────────────────────
// UNIVERSAL FIB FUNCTION
// (exported: params must have declared types)
// ──────────────────────────────
export getFib(string tf, float ratio) =>
    // request.security kann dynamische (series) tf-Strings in v6 verarbeiten
    [tfHigh, tfLow] = request.security(syminfo.tickerid, tf, [high[1], low[1]])
    tfLow + (tfHigh - tfLow) * ratio

// ──────────────────────────────
// GOLDEN POCKET FUNCTION
// ──────────────────────────────
export getGoldenPocket(string tf) =>
    [tfHigh, tfLow] = request.security(syminfo.tickerid, tf, [high[1], low[1]])
    array.from(        tfLow + (tfHigh - tfLow) * 0.618,        tfLow + (tfHigh - tfLow) * 0.650    )

// ──────────────────────────────
// OPTIONAL WRAPPERS (convenience)
// ──────────────────────────────

// Monthly (previous month)
export getMonthlyFib(float ratio) =>
    getFib("M", ratio)

// Weekly (previous week)
export getWeeklyFib(float ratio) =>
    getFib("W", ratio)

// Daily / yesterday
export getYestFib(float ratio) =>
    getFib("D", ratio)
