//@version=6
indicator("Acura", overlay=true, max_labels_count=500)

// ==================== CHOP FILTER ====================
enableChopFilter = input.bool(true, "Enable Chop Filter", group="Chop Filter")
atrLength = input.int(14, "ATR Length", minval=1, group="Chop Filter")
minTrendStrength = input.float(0.5, "Min Trend Strength", step=0.1, minval=0.1, maxval=2.0, group="Chop Filter")

// ==================== V1 INPUTS ====================
emaFastLen   = input.int(8,  "V1: Fast EMA", minval=1, group="V1 System")
emaMidLen    = input.int(21, "V1: Mid EMA",  minval=1, group="V1 System")
emaSlowLen   = input.int(48, "V1: Slow EMA", minval=1, group="V1 System")
microFastLen = input.int(5,  "V1: Micro Fast", minval=1, group="V1 System")
microSlowLen = input.int(13, "V1: Micro Slow", minval=1, group="V1 System")
rsiLen       = input.int(14, "RSI Length", minval=2, group="V1 System")
rsiMinLong   = input.float(42.0, "V1: Min RSI Long",  step=0.1, group="V1 System")
rsiMaxShort  = input.float(58.0, "V1: Max RSI Short", step=0.1, group="V1 System")
minBarsBetween = input.int(1, "V1: Min Bars Between", minval=0, group="V1 System")
minMovePct     = input.float(0.10, "V1: Min Move %", step=0.01, group="V1 System")
enableV1 = input.bool(true, "Enable V1", group="V1 System")

// ==================== V2 INPUTS ====================
emaV2FastLen = input.int(3,  "V2: Fast EMA", minval=1, group="V2 System")
emaV2MidLen  = input.int(8,  "V2: Mid EMA",  minval=1, group="V2 System")
emaV2SlowLen = input.int(13, "V2: Slow EMA", minval=1, group="V2 System")
rsiMomentum  = input.float(4.0, "V2: RSI Surge", step=0.5, group="V2 System")
volLookback  = input.int(4, "V2: Vol Lookback", minval=2, group="V2 System")
volMultiplier = input.float(2.0, "V2: Vol Multiplier", step=0.1, group="V2 System")
enableV2 = input.bool(true, "Enable V2", group="V2 System")

// ==================== EXIT INPUTS ====================
exitVolMult         = input.float(0.7, "Exit Vol Threshold", step=0.1, group="Exit")
exitRsiThresh       = input.float(0.5, "Exit RSI Threshold", step=0.1, group="Exit")
requireMultiBarExit = input.bool(true, "Require 2-Bar Exit Confirmation", group="Exit")
useStopLoss         = input.bool(false, "Use Stop Loss", group="Exit")
stopLossPct         = input.float(2.5, "Stop Loss %", step=0.1, group="Exit")

// ==================== FILTERING ====================
requireConfirmation = input.bool(false, "Require Confirmation", group="Filtering")
minBarsReversal     = input.int(2, "Min Bars Between Reversal", minval=0, group="Filtering")

// ==================== QUALITY BOX ====================
showQuality  = input.bool(true, "Show Quality Box", group="Quality Box")
fwdBars      = input.int(6, "Forward Bars to Check", minval=1, maxval=20, group="Quality Box")
minReachPct  = input.float(0.05, "Min Move % to Count as Hit", step=0.01, group="Quality Box")
tablePos     = input.string("Bottom Right", "Box Position", options=["Top Right","Top Left","Bottom Right","Bottom Left"], group="Quality Box")

// ==================== V1 INDICATORS ====================
fastEma  = ta.ema(close, emaFastLen)
midEma   = ta.ema(close, emaMidLen)
slowEma  = ta.ema(close, emaSlowLen)
microFast = ta.ema(close, microFastLen)
microSlow = ta.ema(close, microSlowLen)
rsiVal   = ta.rsi(close, rsiLen)

bullStack      = fastEma > midEma and midEma > slowEma
bearStack      = fastEma < midEma and midEma < slowEma
microTrendUp   = microFast > microSlow
microTrendDown = microFast < microSlow

rsiLongOk    = rsiVal > rsiMinLong
rsiShortOk   = rsiVal < rsiMaxShort
trendLongOk  = bullStack or microTrendUp
trendShortOk = bearStack or microTrendDown

longLookRaw  = rsiLongOk  and trendLongOk
shortLookRaw = rsiShortOk and trendShortOk

// ==================== V1 BIAS ====================
var int bias = 0
if longLookRaw and not shortLookRaw
    bias := 1
else if shortLookRaw and not longLookRaw
    bias := -1
else if longLookRaw and shortLookRaw
    bias := rsiVal < 50 ? -1 : 1
else
    bias := bias[1]

longBiasNow  = bias == 1
shortBiasNow = bias == -1

// ==================== V1 SPACING ====================
var int   barsFromLastEntryV1 = 100000
var float lastEntryPriceV1    = na
barsFromLastEntryV1 += 1

canFireByBarsV1 = barsFromLastEntryV1 >= minBarsBetween
priceMovePctV1  = na(lastEntryPriceV1) ? 1000.0 : math.abs(close - lastEntryPriceV1) / lastEntryPriceV1 * 100.0
canFireByMoveV1 = priceMovePctV1 >= minMovePct
canFireV1       = canFireByBarsV1 and canFireByMoveV1

longTrigV1Raw  = longBiasNow  and bias[1] != 1
shortTrigV1Raw = shortBiasNow and bias[1] != -1

// ==================== V2 INDICATORS ====================
fastEmaV2 = ta.ema(close, emaV2FastLen)
midEmaV2  = ta.ema(close, emaV2MidLen)
slowEmaV2 = ta.ema(close, emaV2SlowLen)
rsiChange2Bar = rsiVal - rsiVal[2]

volAvg    = ta.sma(volume, volLookback)
volStrong = volume > volAvg * volMultiplier
volWeak   = volume < volAvg * exitVolMult
volGreen  = close > open
volRed    = close < open

fastEmaRising  = fastEmaV2 > fastEmaV2[1]
fastEmaFalling = fastEmaV2 < fastEmaV2[1]

longMomentum   = rsiChange2Bar > rsiMomentum
longVolume     = volStrong and volGreen
longBias       = fastEmaRising
longEntryV2Raw = longMomentum and longVolume and longBias

shortMomentum   = rsiChange2Bar < -rsiMomentum
shortVolume     = volStrong and volRed
shortBias       = fastEmaFalling
shortEntryV2Raw = shortMomentum and shortVolume and shortBias

// ==================== CHOP FILTER ====================
atr           = ta.atr(atrLength)
emaSeparation = math.abs(fastEma - slowEma)
trendStrength = atr > 0 ? emaSeparation / atr : 0
inTrend       = enableChopFilter ? trendStrength >= minTrendStrength : true

// ==================== APPLY FILTERS ====================
longTrigV1   = enableV1 and longTrigV1Raw  and canFireV1 and inTrend
shortTrigV1  = enableV1 and shortTrigV1Raw and canFireV1 and inTrend
longEntryV2  = enableV2 and longEntryV2Raw  and inTrend
shortEntryV2 = enableV2 and shortEntryV2Raw and inTrend

// ==================== CONFIRMATION ====================
var string pendingSignal = na
var string pendingType   = na

if requireConfirmation
    if (longTrigV1 or longEntryV2) and na(pendingSignal)
        pendingSignal := "LONG"
        pendingType   := longTrigV1 ? "V1" : "V2"
    else if (shortTrigV1 or shortEntryV2) and na(pendingSignal)
        pendingSignal := "SHORT"
        pendingType   := shortTrigV1 ? "V1" : "V2"
    if not na(pendingSignal)
        stillTrue = (pendingSignal == "LONG" and (longTrigV1 or longEntryV2)) or (pendingSignal == "SHORT" and (shortTrigV1 or shortEntryV2))
        if not stillTrue
            pendingSignal := na
            pendingType   := na

confirmedLongV1  = longTrigV1
confirmedLongV2  = longEntryV2
confirmedShortV1 = shortTrigV1
confirmedShortV2 = shortEntryV2

if requireConfirmation
    longPending  = not na(pendingSignal[1]) and pendingSignal[1] == "LONG"
    shortPending = not na(pendingSignal[1]) and pendingSignal[1] == "SHORT"
    confirmedLongV1  := longPending  and pendingType[1] == "V1" and longTrigV1
    confirmedLongV2  := longPending  and pendingType[1] == "V2" and longEntryV2
    confirmedShortV1 := shortPending and pendingType[1] == "V1" and shortTrigV1
    confirmedShortV2 := shortPending and pendingType[1] == "V2" and shortEntryV2

anyConfirmed = confirmedLongV1 or confirmedLongV2 or confirmedShortV1 or confirmedShortV2
if requireConfirmation and anyConfirmed
    pendingSignal := na
    pendingType   := na

// ==================== REVERSAL COOLDOWN ====================
var int    lastSignalBar       = 0
var string lastSignalDirection = na
canFireOpposite = true

if minBarsReversal > 0 and not na(lastSignalDirection)
    barsSinceLast = bar_index - lastSignalBar
    isOpposite = (lastSignalDirection == "LONG" and (confirmedShortV1 or confirmedShortV2)) or (lastSignalDirection == "SHORT" and (confirmedLongV1 or confirmedLongV2))
    if isOpposite
        canFireOpposite := barsSinceLast >= minBarsReversal

finalLongV1  = confirmedLongV1  and canFireOpposite
finalLongV2  = confirmedLongV2  and canFireOpposite
finalShortV1 = confirmedShortV1 and canFireOpposite
finalShortV2 = confirmedShortV2 and canFireOpposite

if finalLongV1 or finalLongV2
    lastSignalBar       := bar_index
    lastSignalDirection := "LONG"
    barsFromLastEntryV1 := 0
    lastEntryPriceV1    := close
else if finalShortV1 or finalShortV2
    lastSignalBar       := bar_index
    lastSignalDirection := "SHORT"
    barsFromLastEntryV1 := 0
    lastEntryPriceV1    := close

// ==================== SIGNAL QUALITY TRACKING ====================
// Measures: did price reach minReachPct in signal direction within fwdBars?
// Uses confirmed historical bars only — no current bar ambiguity

var int   totalSignals  = 0
var int   totalHits     = 0
var float totalReach    = 0.0

// We evaluate signals from fwdBars ago — those bars are fully closed
evalBar     = bar_index - fwdBars
wasLong     = (finalLongV1[fwdBars]  or finalLongV2[fwdBars])
wasShort    = (finalShortV1[fwdBars] or finalShortV2[fwdBars])
signalPrice = close[fwdBars]

if barstate.isconfirmed and (wasLong or wasShort)
    // Find best price reached in the fwdBars window
    bestHigh = high[fwdBars-1]
    bestLow  = low[fwdBars-1]
    for i = fwdBars-1 to 1
        bestHigh := math.max(bestHigh, high[i])
        bestLow  := math.min(bestLow,  low[i])

    if wasLong
        reach = (bestHigh - signalPrice) / signalPrice * 100
        totalSignals += 1
        totalReach   += reach
        if reach >= minReachPct
            totalHits += 1

    if wasShort
        reach = (signalPrice - bestLow) / signalPrice * 100
        totalSignals += 1
        totalReach   += reach
        if reach >= minReachPct
            totalHits += 1

// ==================== QUALITY TABLE ====================
var table qualTable = na

tPos = tablePos == "Top Right"    ? position.top_right    :
       tablePos == "Top Left"     ? position.top_left     :
       tablePos == "Bottom Right" ? position.bottom_right :
       position.bottom_left

if barstate.islast and showQuality
    qualTable := table.new(tPos, 2, 4, bgcolor=color.new(color.black, 60), border_color=color.gray, border_width=1, frame_color=color.gray, frame_width=1)
    qualPct   = totalSignals > 0 ? (totalHits / totalSignals * 100) : 0.0
    avgReach  = totalSignals > 0 ? (totalReach / totalSignals) : 0.0
    qualColor = qualPct >= 70 ? color.lime : qualPct >= 50 ? color.yellow : color.red

    table.cell(qualTable, 0, 0, "Signals",   text_color=color.silver, text_size=size.small)
    table.cell(qualTable, 1, 0, str.tostring(totalSignals), text_color=color.white, text_size=size.small)
    table.cell(qualTable, 0, 1, "TF Quality", text_color=color.silver, text_size=size.small)
    table.cell(qualTable, 1, 1, str.tostring(math.round(qualPct, 1)) + "%", text_color=qualColor, text_size=size.small)
    table.cell(qualTable, 0, 2, "Avg Reach",  text_color=color.silver, text_size=size.small)
    table.cell(qualTable, 1, 2, str.tostring(math.round(avgReach, 3)) + "%", text_color=color.white, text_size=size.small)
    table.cell(qualTable, 0, 3, "Hits/Total", text_color=color.silver, text_size=size.small)
    table.cell(qualTable, 1, 3, str.tostring(totalHits) + "/" + str.tostring(totalSignals), text_color=color.white, text_size=size.small)

// ==================== PLOTS ====================
plot(fastEma,   "V1 Fast", color=color.new(color.orange, 30), linewidth=1)
plot(midEma,    "V1 Mid",  color=color.new(color.teal,   30), linewidth=1)
plot(slowEma,   "V1 Slow", color=color.new(color.purple, 30), linewidth=1)
plot(fastEmaV2, "V2 Fast", color=color.new(color.yellow,  0), linewidth=2)
plot(midEmaV2,  "V2 Mid",  color=color.new(color.aqua,    0), linewidth=1)
plot(slowEmaV2, "V2 Slow", color=color.new(color.fuchsia, 0), linewidth=1)

plotshape(finalLongV1,  "LONG V1",  shape.labelup,   location.belowbar, color.new(color.green,  0), text="LONG\nV1",  textcolor=color.white, size=size.small)
plotshape(finalLongV2,  "LONG V2",  shape.labelup,   location.belowbar, color.new(color.lime,   0), text="LONG\nV2",  textcolor=color.black, size=size.small)
plotshape(finalShortV1, "SHORT V1", shape.labeldown, location.abovebar, color.new(color.red,    0), text="SHORT\nV1", textcolor=color.white, size=size.small)
plotshape(finalShortV2, "SHORT V2", shape.labeldown, location.abovebar, color.new(color.orange, 0), text="SHORT\nV2", textcolor=color.black, size=size.small)

bgcolor(lastSignalDirection == "LONG"  and (bar_index - lastSignalBar) < fwdBars ? color.new(color.green, 95) : lastSignalDirection == "SHORT" and (bar_index - lastSignalBar) < fwdBars ? color.new(color.red, 95) : na)
bgcolor(not inTrend and enableChopFilter ? color.new(color.gray, 90) : na)

// ==================== ALERTS ====================
alertcondition(finalLongV1,  "LONG_V1",  "LONG_V1")
alertcondition(finalLongV2,  "LONG_V2",  "LONG_V2")
alertcondition(finalShortV1, "SHORT_V1", "SHORT_V1")
alertcondition(finalShortV2, "SHORT_V2", "SHORT_V2")