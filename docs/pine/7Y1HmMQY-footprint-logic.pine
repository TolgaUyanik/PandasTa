//@version=5
// @description: Internal logic for filling footprint object
library("footprint_logic")
import dboichenko/footprint_type/2 as footprint_type
//method fill_va{
//@function fill value area
//@param val_area instance of Value_area type
//@param foot_bar instance of Footprint_bar type
//@param sup instance of Support_objects type
//@returns Void
export method fill_va(footprint_type.Value_area val_area,footprint_type.Footprint_bar foot_bar,footprint_type.Support_objects sup)=>
    va = foot_bar.total_vol * sup.inp.procent_volume_area /100
    poc_price = foot_bar.foot_max_price_vol.keys().get(0)
    val_area.poc_price := poc_price
    va -= foot_bar.foot_max_price_vol.values().get(0)
    right_flag = false
    left_flag = false
    for [index,row] in foot_bar.foot_rows
        price = row.price
        if price == poc_price
            right_count_row = (foot_bar.foot_rows.size()-1) - index
            left_count_row = index
            side_max_count = right_count_row > left_count_row ? right_count_row : left_count_row
            for inner_index = 1 to side_max_count
                index_right = index+inner_index
                index_left = index-inner_index
                if index_right <=  foot_bar.foot_rows.size() - 1
                    volume_right = foot_bar.foot_rows.get(index_right).buy_vol + foot_bar.foot_rows.get(index_right).sell_vol
                    if va - volume_right >= 0 and not right_flag
                        va -= volume_right
                        val_area.vah_price :=  foot_bar.foot_rows.get(index_right).price
                    else 
                        right_flag := true
                if index_left >= 0
                    volume_left = foot_bar.foot_rows.get(index_left).buy_vol + foot_bar.foot_rows.get(index_left).sell_vol
                    if va - volume_left >= 0 and not left_flag
                        va -= volume_left
                        val_area.val_price := foot_bar.foot_rows.get(index_left).price
                    else
                        left_flag := true
            break
    if na(val_area.vah_price)
        val_area.vah_price := val_area.poc_price + foot_bar.row_size
    else
        val_area.vah_price += foot_bar.row_size
    if na(val_area.val_price)
        val_area.val_price := val_area.poc_price
    val_area.poc_price := val_area.poc_price+foot_bar.row_size/2
//}

//method fill_imba_line{
//@function fill imbalance line
//@param imba_line instance of Imbalance_line type
//@param foot_bar instance of Footprint_bar type
//@param sup instance of Support_objects type
//@returns Void
export method fill_imba_line(footprint_type.Imbalance_line imba_line,footprint_type.Footprint_bar foot_bar,footprint_type.Support_objects sup)=>
    count_imbalance_buy = 0
    count_imbalance_sell = 0
    for [index,row] in foot_bar.foot_rows
        if row.imbalance_buy
            count_imbalance_buy +=1
        else 
            count_imbalance_buy :=0
        if row.imbalance_sell
            count_imbalance_sell += 1
        else
            count_imbalance_sell := 0 

        if count_imbalance_buy >= sup.inp.stacked_input
            for i = 0 to count_imbalance_buy - 1
                value = foot_bar.foot_rows.get(index - i).price + foot_bar.row_size / 2
                if not imba_line.buy_price_line.includes(value)
                    imba_line.buy_price_line.push(value)
                    
        if count_imbalance_sell >= sup.inp.stacked_input
            for i = 0 to count_imbalance_sell - 1
                value = foot_bar.foot_rows.get(index - i).price + foot_bar.row_size / 2
                if not imba_line.sell_price_line.includes(value)
                    imba_line.sell_price_line.push(value)
//}

//innerlogic fill_footprint_type.Footprint_row{

method fil_price_rows(footprint_type.Footprint_bar foot_bar)=>
    row_size = foot_bar.row_size
    start = math.floor(low/row_size)
    for i = start * row_size to high by row_size
        if foot_bar.foot_rows.size() <250
            foot_bar.foot_rows.push(footprint_type.Footprint_row.new(price = i))
        else
            runtime.error("Level group size more than max value = 250. Pleace increase row size")

method update_cum_info_var(footprint_type.Footprint_info info,footprint_type.Footprint_bar foot_bar)=>
    info.var_info.cum_buy_vol += foot_bar.foot_buy_vol
    info.var_info.cum_sell_vol += foot_bar.foot_sell_vol
    info.var_info.cum_delta += foot_bar.foot_buy_vol - foot_bar.foot_sell_vol
    info.var_info.cum_total += foot_bar.total_vol

method update_sum_foot_bar_var(footprint_type.Footprint_bar foot_bar,footprint_type.Footprint_row current_row)=>
    foot_bar.foot_buy_vol += current_row.buy_vol
    foot_bar.foot_sell_vol += current_row.sell_vol
    foot_bar.total_vol := foot_bar.foot_buy_vol + foot_bar.foot_sell_vol
    if current_row.buy_vol != 0. or current_row.sell_vol != 0
        current_row.empty := false
    if foot_bar.foot_max_price_vol.values().size() > 0
        if foot_bar.foot_max_price_vol.values().last() <= current_row.buy_vol + current_row.sell_vol
            foot_bar.foot_max_price_vol.clear()
            foot_bar.foot_max_price_vol.put(current_row.price,current_row.buy_vol + current_row.sell_vol)
    else 
        foot_bar.foot_max_price_vol.put(current_row.price,current_row.buy_vol + current_row.sell_vol)

method fill_inbalance_buy_sell(footprint_type.Footprint_row current_row,footprint_type.Footprint_bar foot_bar,footprint_type.Support_objects sup,not_empty_row_index)=>
    coeff = sup.inp.inbalance_percent / 100
    current_buy_vol = current_row.buy_vol
    current_sell_vol = current_row.sell_vol

    past_buy_vol = foot_bar.foot_rows.get(not_empty_row_index).buy_vol
    past_sell_vol = foot_bar.foot_rows.get(not_empty_row_index).sell_vol
    if current_buy_vol / coeff >= past_sell_vol
        current_row.imbalance_buy := true
    if current_sell_vol / coeff >= past_buy_vol
        current_row.imbalance_sell :=true

method fill_buy_sell_vol(footprint_type.Footprint_row current_row,footprint_type.Footprint_bar foot_bar,float clean_volume,float local_open,float local_close,float local_close_prev)=>
    switch
        local_close > local_open => foot_bar.calc_data.isBuyVolume := true
        local_close < local_open => foot_bar.calc_data.isBuyVolume := false
        local_close > local_close_prev => foot_bar.calc_data.isBuyVolume := true
        local_close < local_close_prev => foot_bar.calc_data.isBuyVolume := false
    if foot_bar.calc_data.isBuyVolume
        current_row.buy_vol += clean_volume
    else
        current_row.sell_vol += clean_volume

method get_clean_volume(float local_volume,float local_high,float local_low,float price,float next_price)=>
    bar_length = (local_high - local_low)
    top_level = ((next_price > local_high) and (price > local_low)) ? local_high : next_price
    bot_level = price < local_low and next_price <= local_high ? local_low : price 
    level_space =  top_level - bot_level
    bar_length := local_high == local_low ? 1 : bar_length
    level_space := (top_level == bot_level == price) or (top_level == bot_level ==next_price) ? 0 : level_space
    _proc = level_space > bar_length or bar_length == 1 and level_space != 0 ? 1 :  (level_space / bar_length)
    volume_procent = local_volume * _proc
    math.abs(volume_procent)

method distribution_volume(footprint_type.Footprint_row current_row,footprint_type.Footprint_bar foot_bar)=>
    price = current_row.price
    next_price = price + foot_bar.row_size 
    for [index,local_close] in foot_bar.calc_data.detail_close
        local_open = foot_bar.calc_data.detail_open.get(index)
        local_high = foot_bar.calc_data.detail_high.get(index)
        local_low = foot_bar.calc_data.detail_low.get(index)
        local_volume = foot_bar.calc_data.detail_vol.get(index)
        local_close_prev = not na(foot_bar.calc_data.previos_detail_close) ? foot_bar.calc_data.previos_detail_close.last() : na 
        condition = (price >= local_low and price <= local_high) or (next_price >= local_low and next_price <= local_high) or (next_price >= local_high and price <= local_low)
        if condition
            clean_volume = local_volume.get_clean_volume(local_high,local_low,price,next_price)
            current_row.fill_buy_sell_vol(foot_bar,clean_volume,local_open,local_close,local_close_prev)
    foot_bar.update_sum_foot_bar_var(current_row)

//}

//method fill_footprint_type.Footprint_row{
//@function fill footprint bar
//@param foot_bar instance of Footprint_bar type
//@param sup instance of Support_objects type
//@returns Void
export method fill_footprint_type(footprint_type.Footprint_bar foot_bar,footprint_type.Support_objects sup)=>
    count_rows = foot_bar.foot_rows.size()
    not_empty_row_index = array.new<int>()
    if count_rows >20
        one = math.floor(count_rows/4)
        two  = math.floor(count_rows/4)*2
        three = math.floor(count_rows/4)*3
        four = count_rows-1
        for index_row = 0 to one
            current_row = foot_bar.foot_rows.get(index_row)
            current_row.distribution_volume(foot_bar)
            if not current_row.empty
                not_empty_row_index.push(index_row)
                if not_empty_row_index.size() > 1
                    current_row.fill_inbalance_buy_sell(foot_bar,sup,not_empty_row_index.get(not_empty_row_index.size()-2))
        for index_row = one + 1 to two      
            current_row = foot_bar.foot_rows.get(index_row)
            current_row.distribution_volume(foot_bar)
            if not current_row.empty
                not_empty_row_index.push(index_row)
                if not_empty_row_index.size() > 1
                    current_row.fill_inbalance_buy_sell(foot_bar,sup,not_empty_row_index.get(not_empty_row_index.size()-2))
        for index_row = two + 1 to three
            current_row = foot_bar.foot_rows.get(index_row)
            current_row.distribution_volume(foot_bar)
            if not current_row.empty
                not_empty_row_index.push(index_row)
                if not_empty_row_index.size() > 1
                    current_row.fill_inbalance_buy_sell(foot_bar,sup,not_empty_row_index.get(not_empty_row_index.size()-2))
        for index_row = three + 1 to four
            current_row = foot_bar.foot_rows.get(index_row)
            current_row.distribution_volume(foot_bar)
            if not current_row.empty
                not_empty_row_index.push(index_row)
                if not_empty_row_index.size() > 1
                    current_row.fill_inbalance_buy_sell(foot_bar,sup,not_empty_row_index.get(not_empty_row_index.size()-2))
    else
        for [index_row,current_row] in foot_bar.foot_rows
            current_row.distribution_volume(foot_bar)
            if not current_row.empty
                not_empty_row_index.push(index_row)
                if not_empty_row_index.size() > 1
                    current_row.fill_inbalance_buy_sell(foot_bar,sup,not_empty_row_index.get(not_empty_row_index.size()-2))
    foot_bar.info.update_cum_info_var(foot_bar)
//}
//@function fill all footprint objects
//@param foot_bar instance of Footprint_bar type
//@param sup instance of Support_objects type
//@returns Void
export method fill_footprint_object(footprint_type.Footprint_bar foot_bar,footprint_type.Support_objects sup)=>
    foot_bar.fil_price_rows()
    foot_bar.fill_footprint_type(sup)
    foot_bar.imba_line.fill_imba_line(foot_bar,sup)
    foot_bar.val_area.fill_va(foot_bar,sup)