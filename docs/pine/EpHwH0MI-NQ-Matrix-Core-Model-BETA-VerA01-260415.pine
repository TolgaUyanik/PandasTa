//@version=6
library("MatrixCore")

//========================
// SESSION HIGH
//========================
export sessionHigh() =>
    request.security(syminfo.tickerid, "D", high)


//========================
// LEVELS (MODEL)
//========================
export levels() =>
    array.from(
        0,
        100,125,150,175,200,225,250,275,300,
        325,350,375,400,
        550,575,600,625,
        700,725,750,775,800,825,
        975,1075,1100,1225,1250,1325,1375,1450
    )


//========================
// LABEL TEXTS
//========================
txts = array.from(
