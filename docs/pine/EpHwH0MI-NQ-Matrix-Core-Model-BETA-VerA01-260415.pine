//========================
// COLOR ENGINE (REUSABLE)
//========================
f_col(txt) =>
    if txt == "Day High"
        color.yellow

    else if txt == "100 100%"
        color.green
    else if txt == "125 99%"
        color.green
    else if txt == "150 95%"
        color.green
    else if txt == "175 91%"
        color.green
    else if txt == "200 84%"
        color.green

    else if txt == "225 78% TP"
        color.green
    else if txt == "250 70%"
        color.green
    else if txt == "275 62% TP"
        color.green
    else if txt == "300 56%"
        color.green
    else if txt == "325 50% TP"
        color.green

    else if txt == "350 45%"
        color.red
    else if txt == "375 39%"
        color.red
    else if txt == "400 35% TP"
        color.green

    else if txt == "550 15% Entry"
        color.yellow
    else if txt == "575 13%"
        color.green
    else if txt == "600 12% TP"
        color.green
    else if txt == "625 11% TP"
        color.red

    else if txt == "700 7% Entry"
        color.yellow
    else if txt == "725 6%"
        color.green
    else if txt == "750 5%"
        color.green
    else if txt == "775 5%"
        color.green
    else if txt == "800 4% TP"
        color.red

    else if txt == "825 3% Entry"
        color.yellow

    else if txt == "975 2% TP"
        color.green

    else if txt == "1075 1%"
        color.red

    else if txt == "1100 1% Entry"
        color.yellow

    else if txt == "1225 1% TP"
        color.green
    else if txt == "1250 1% Entry"
        color.yellow
    else if txt == "1325 1% TP"
        color.green
    else if txt == "1375 1% TP"
        color.green
    else if txt == "1450 1% TP"
        color.green

    else
        color.gray
