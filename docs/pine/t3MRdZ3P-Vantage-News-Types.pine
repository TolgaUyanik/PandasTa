// @function Converts an HHMM integer time to milliseconds from midnight.
// @param hhmm Time in HHMM format (e.g., 530 = 5:30 AM, 1345 = 1:45 PM)
// @returns Milliseconds from midnight (e.g., 530 → 19800000)
export HhmmToMs(int hhmm) =>
    int hh = int(hhmm / 100)
    int mm = hhmm - hh * 100
    int ms = (hh * 60 + mm) * 60000
    ms

// @function Appends a news event to three parallel arrays using HHMM time format.
// @param dateStr Date string in YYYY-MM-DD format
// @param hhmm Event time in HHMM integer format (e.g., 530 = 5:30 AM PT)
// @param typeId TYPE_ constant identifying the event (e.g., TYPE_CPI_m_m)
// @param datesArr Dates array to append to
// @param timesArr Times array to append to (receives converted milliseconds)
// @param typeIdsArr Type ID array to append to
// @returns 0 (always)
export AddNews(string dateStr, int hhmm, int typeId, string[] datesArr, int[] timesArr, int[] typeIdsArr) =>
    int ms = HhmmToMs(hhmm)
    array.push(datesArr, dateStr)
    array.push(timesArr, ms)
    array.push(typeIdsArr, typeId)
    0

// @function Appends a news event to three parallel arrays using pre-computed millisecond time.
// @param dateStr Date string in YYYY-MM-DD format
// @param timeMs Event time as milliseconds from midnight
// @param typeId TYPE_ constant identifying the event (e.g., TYPE_CPI_m_m)
// @param datesArr Dates array to append to
// @param timesArr Times array to append to
// @param typeIdsArr Type ID array to append to
// @returns 0 (always)
export AddNewsMs(string dateStr, int timeMs, int typeId, string[] datesArr, int[] timesArr, int[] typeIdsArr) =>
    array.push(datesArr, dateStr)
    array.push(timesArr, timeMs)
    array.push(typeIdsArr, typeId)
    0

// @function Returns an array mapping each TYPE_ integer ID to its default severity level.
// Index into the array using a TYPE_ constant to get the severity: 1=low impact,
// 2=medium impact (delayed start), 3=high impact (full-day block).
// @returns int[] — severity array indexed by TYPE_ ID
export LoadTypeSevByTypeId() =>
    int[] typeSevByTypeId = array.new_int()
    array.push(typeSevByTypeId, 1)  // 0 TYPE_CPI_m_m
    array.push(typeSevByTypeId, 2)  // 1 TYPE_CPI_y_y
    array.push(typeSevByTypeId, 1)  // 2 TYPE_Core_CPI_m_m
    array.push(typeSevByTypeId, 2)  // 3 TYPE_Core_PPI_m_m
    array.push(typeSevByTypeId, 1)  // 4 TYPE_FOMC_Economic_Projections
    array.push(typeSevByTypeId, 3)  // 5 TYPE_FOMC_Meeting_Minutes
    array.push(typeSevByTypeId, 1)  // 6 TYPE_Federal_Funds_Rate
    array.push(typeSevByTypeId, 3)  // 7 TYPE_ISM_Manufacturing_PMI
    array.push(typeSevByTypeId, 1)  // 8 TYPE_ISM_Services_PMI
    array.push(typeSevByTypeId, 2)  // 9 TYPE_Non_Farm_Employment_Change
    array.push(typeSevByTypeId, 2)  // 10 TYPE_PPI_m_m
    array.push(typeSevByTypeId, 3)  // 11 TYPE_President_Trump_Speaks
    array.push(typeSevByTypeId, 2)  // 12 TYPE_Unemployment_Rate
    array.push(typeSevByTypeId, 1)  // 13 TYPE_Core_PCE_Price_Index_m_m
    array.push(typeSevByTypeId, 2)  // 14 TYPE_Core_Retail_Sales_m_m
    array.push(typeSevByTypeId, 1)  // 15 TYPE_FOMC_Press_Conference
    array.push(typeSevByTypeId, 3)  // 16 TYPE_FOMC_Statement
    array.push(typeSevByTypeId, 1)  // 17 TYPE_Fed_Chair_Powell_Speaks
