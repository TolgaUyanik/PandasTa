
//@version=6
// @description Registry of economic news event TYPE_ constants and severity mappings for
// Pine Script news-filtering strategies. Exports 125+ integer constants (one per tracked
// USD economic event type) used as a shared vocabulary across news calendar libraries.
// Also exports HHMM-to-milliseconds conversion helpers and a function that returns the
// default severity level (1=low, 2=medium, 3=high/block) for each event type.
// Designed as a shared dependency — import this library anywhere you need to reference
// economic event types by name rather than raw integers.
library("Vantage_News_Types", overlay=false)

// ─────────────────────────────────────────────────────────────────────────
// USAGE — reference event types by name, look up default severity, or
// append rows to a packed news table. Copy the snippets you need.
// ─────────────────────────────────────────────────────────────────────────
//
//   import Vantage-Stack/Vantage_News_Types/1 as nt
//
//   // Reference an event type by name, not by raw integer:
//   int t = nt.TYPE_Non_Farm_Employment_Change
//
//   // Look up the default severity for a type ID (3=block, 2=delay, 1=watch):
//   array<int> sevByType = nt.LoadTypeSevByTypeId()
//   int sev = array.get(sevByType, t)
//
//   // Build a packed news table with parallel arrays:
//   var array<string> dates = array.new<string>()
//   var array<int>    times = array.new<int>()
//   var array<int>    tids  = array.new<int>()
//   nt.AddNews("2026-03-24", 0530, nt.TYPE_Non_Farm_Employment_Change, dates, times, tids)
//
// ─────────────────────────────────────────────────────────────────────────

