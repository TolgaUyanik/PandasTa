//@version=6

plot(close)
//@version=5
indicator("Stock In Play Dashboard - Standard V17", overlay=true)

// ==========================================
// 1. INPUT PARAMETERS (DEFAULTS)
// ==========================================
min_gap      = input.float(2.0, title="Minimum Gap %", step=0.1)
min_pm_vol   = input.int(100000, title="Min Pre-Market Volume (Shares)") // Aziz standard is 100k
min_avg_vol  = input.int(500000, title="Min 3-Month Avg Daily Vol")
min_atr_val  = input.float(0.50, title="Minimum Daily ATR ($)")

// Dashboard Layout Corner Control Selection Dropdown
table_pos    = input.string("Top Right", title="Dashboard Position Layout", 
               options=["Top Right", "Bottom Right", "Top Left", "Bottom Left"])

// ==========================================
// 2. TIMING & EXTENDED SESSION TRACKING
// ==========================================
// Translate structural timeline to New York Exchange time
ny_hour   = hour(time, "America/New_York")
ny_minute = minute(time, "America/New_York")
current_ny_minutes = (ny_hour * 60) + ny_minute

// Pre-Market window definition (04:00 AM to 09:30 AM EST)
in_pm_window  = (current_ny_minutes >= 240) and (current_ny_minutes < 570) and timeframe.isintraday
is_market_open = (current_ny_minutes >= 570) and timeframe.isintraday

// Persistent tracking variables
var int pm_vol_accum = 0
var float official_gap_percentage = 0.0
var bool gap_locked = false

// Reset tracking tools at the transition to a brand new trading day
if timeframe.change("D")
    pm_vol_accum := 0
    gap_locked := false

// Request explicit extended ticker history to locate the baseline 4:00 PM close
ext_ticker = ticker.new(syminfo.prefix, syminfo.ticker, session.extended)
daily_close_prev = request.security(ext_ticker, "D", close[1], barmerge.gaps_off, barmerge.lookahead_on)

// PHASE 1: Dynamic Calculation (04:00 AM - 09:30 AM)
if in_pm_window
    pm_vol_accum := pm_vol_accum + (volume > 0 ? int(volume) : 0)
    if daily_close_prev > 0
        // Compares the moving pre-market price directly against yesterday's 4:00 PM close
        official_gap_percentage := ((close - daily_close_prev) / daily_close_prev) * 100

// PHASE 2: The 09:30 AM Lock (Captures the official opening print gap and freezes it)
if is_market_open and not gap_locked
    if daily_close_prev > 0
        official_gap_percentage := ((open - daily_close_prev) / daily_close_prev) * 100
    gap_locked := true

// Fetch daily liquidity averages and structural market ranges
daily_vol_avg = request.security(ext_ticker, "D", ta.sma(volume, 65), barmerge.gaps_off, barmerge.lookahead_on)
daily_atr     = request.security(ext_ticker, "D", ta.atr(14), barmerge.gaps_off, barmerge.lookahead_on)

// Evaluate multi-variable validation filters
pass_gap     = math.abs(official_gap_percentage) >= min_gap
pass_pm_vol  = pm_vol_accum >= min_pm_vol
pass_avg_vol = daily_vol_avg >= min_avg_vol
pass_atr     = daily_atr >= min_atr_val

is_stock_in_play = pass_gap and pass_pm_vol and pass_avg_vol and pass_atr

// ==========================================
// 3. GRAPHICAL DASHBOARD DISPLAY
// ==========================================
chosen_position = position.top_right
if table_pos == "Bottom Right"
    chosen_position := position.bottom_right
if table_pos == "Top Left"
    chosen_position := position.top_left
if table_pos == "Bottom Left"
    chosen_position := position.bottom_left

var table info_table = table.new(chosen_position, 2, 6, bgcolor=color.new(color.black, 20), border_color=color.black, border_width=1)

if barstate.islast
    // Header
    table.cell(info_table, 0, 0, "Metric Filter", bgcolor=color.gray, text_color=color.white, text_size=size.small)
    table.cell(info_table, 1, 0, "Value (Official Sync)", bgcolor=color.gray, text_color=color.white, text_size=size.small)
    
    // Row 1: Pre-Market Gap
    table.cell(info_table, 0, 1, "Pre-Market Gap (Min ±" + str.tostring(min_gap) + "%)", text_color=color.white, text_size=size.small)
    table.cell(info_table, 1, 1, str.tostring(official_gap_percentage, "#.##") + "%", bgcolor=pass_gap ? color.green : color.red, text_color=color.white, text_size=size.small)
    
    // Row 2: Volume Display
    table.cell(info_table, 0, 2, "PM Vol (Min " + str.tostring(min_pm_vol, "###,###") + ")", text_color=color.white, text_size=size.small)
    table.cell(info_table, 1, 2, str.tostring(pm_vol_accum, "###,###"), bgcolor=pass_pm_vol ? color.green : color.red, text_color=color.white, text_size=size.small)
    
    // Row 3: 3-Month Daily Avg Volume
    table.cell(info_table, 0, 3, "3M Avg Daily Vol (Min 500k)", text_color=color.white, text_size=size.small)
    table.cell(info_table, 1, 3, str.tostring(daily_vol_avg, "###,###"), bgcolor=pass_avg_vol ? color.green : color.red, text_color=color.white, text_size=size.small)
    
    // Row 4: Volatility (ATR)
    table.cell(info_table, 0, 4, "Daily ATR (Min $" + str.tostring(min_atr_val) + ")", text_color=color.white, text_size=size.small)
    table.cell(info_table, 1, 4, "$" + str.tostring(daily_atr, "#.##"), bgcolor=pass_atr ? color.green : color.red, text_color=color.white, text_size=size.small)
    
    // Row 5: FINAL VERDICT
    table.cell(info_table, 0, 5, "VERDICT: STOCK IN PLAY?", bgcolor=color.red, text_color=color.white, text_size=size.small)
    table.cell(info_table, 1, 5, is_stock_in_play ? "🔥 YES! TRADABLE" : "❌ NO - SKIP", bgcolor=is_stock_in_play ? color.green : color.red, text_color=color.white, text_size=size.small)
