//@version=6


longCondition = ta.crossover(ta.sma(close, 14), ta.sma(close, 28))
if (longCondition)
    strategy.entry("My Long Entry Id", strategy.long)

shortCondition = ta.crossunder(ta.sma(close, 14), ta.sma(close, 28))
if (shortCondition)
    strategy.entry("My Short Entry Id", strategy.short)

strategy("Simple Breakout Strategy", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

// === INPUTS ===
length = input.int(20, "Lookback")
volMult = input.float(1.5, "Volume Multiplier")

// === MOVING AVERAGES ===
ema50 = ta.ema(close, 50)

// === RANGE (SIMPLIFIED COMPRESSION) ===
highestHigh = ta.highest(high, length)
lowestLow = ta.lowest(low, length)

// === BREAKOUT ===
breakout = close > highestHigh[1]

// === VOLUME FILTER ===
volOk = volume > ta.sma(volume, 20) * volMult

// === TREND FILTER ===
trendOk = close > ema50

// === ENTRY ===


if (longCondition)
    strategy.entry("Long", strategy.long)

// === EXIT RULES (SIMPLE) ===
stopLoss = close * 0.97
takeProfit = close * 1.06

strategy.exit("Exit", "Long", stop=stopLoss, limit=takeProfit)

// === PLOTS ===
plot(ema50, color=color.orange)
plot(highestHigh, color=color.green)
plot(lowestLow, color=color.red)