// This Pine Script™ library implements machine learning algorithms using Pine matrices
// @version=6
// @description Machine Learning Matrix Library - A comprehensive collection of ML algorithms
//              implemented using Pine Script's native matrix operations.
//              Includes: Regression, Classification, Clustering, Time Series, Anomaly Detection,
//              Neural Networks, Ensemble Methods, and Trading-Specific Algorithms.

library("MLMatrixLib", overlay = false)

// ==============================================================================
// SECTION 1: UTILITY FUNCTIONS & MATRIX OPERATIONS
// ==============================================================================

// @function Creates an identity matrix of size n x n
// @param n The dimension of the identity matrix
// @returns A square identity matrix
export identity(int n) =>
    matrix<float> result = matrix.new<float>(n, n, 0.0)
    for i = 0 to n - 1
        result.set(i, i, 1.0)
    result

// @function Creates a diagonal matrix from an array of values
// @param values Array of diagonal elements
// @returns A square diagonal matrix
export diagonal(array<float> values) =>
    int n = array.size(values)
    matrix<float> result = matrix.new<float>(n, n, 0.0)
    for i = 0 to n - 1
        result.set(i, i, array.get(values, i))
    result

// @function Creates a matrix filled with ones
// @param rows Number of rows
// @param cols Number of columns
// @returns Matrix of ones
export ones(int rows, int cols) =>
    matrix.new<float>(rows, cols, 1.0)

// @function Creates a matrix filled with zeros
// @param rows Number of rows
// @param cols Number of columns
// @returns Matrix of zeros
export zeros(int rows, int cols) =>
    matrix.new<float>(rows, cols, 0.0)

// @function Calculates the Frobenius norm of a matrix
// @param m The input matrix
// @returns The Frobenius norm (sqrt of sum of squared elements)
export frobeniusNorm(matrix<float> m) =>
    float sumSq = 0.0
    int rows = matrix.rows(m)
    int cols = matrix.columns(m)
    for row = 0 to rows - 1
        for col = 0 to cols - 1
            float val = matrix.get(m, row, col)
            sumSq += val * val
    math.sqrt(sumSq)

// @function Calculates L1 norm (sum of absolute values) of a matrix
// @param m The input matrix
// @returns L1 norm
export l1Norm(matrix<float> m) =>
    float sumAbs = 0.0
    int rows = matrix.rows(m)
    int cols = matrix.columns(m)
    for row = 0 to rows - 1
        for col = 0 to cols - 1
            sumAbs += math.abs(matrix.get(m, row, col))
    sumAbs

// @function Normalizes a matrix by its Frobenius norm
// @param m The input matrix
// @returns Normalized matrix
export normalize(matrix<float> m) =>
    float norm = frobeniusNorm(m)
    if norm < 1e-10
        m.copy()
    else
        matrix.mult(m, 1.0 / norm)

// @function Clips matrix values to a range
// @param m The input matrix
// @param minVal Minimum value
// @param maxVal Maximum value
// @returns Clipped matrix
export clipMatrix(matrix<float> m, float minVal, float maxVal) =>
    int rows = matrix.rows(m)
    int cols = matrix.columns(m)
    matrix<float> result = matrix.new<float>(rows, cols)
    for row = 0 to rows - 1
        for col = 0 to cols - 1
            float val = matrix.get(m, row, col)
            result.set(row, col, math.max(minVal, math.min(maxVal, val)))
    result

// @function Element-wise multiplication (Hadamard product)
// @param m1 First matrix
// @param m2 Second matrix
// @returns Element-wise product
export hadamard(matrix<float> m1, matrix<float> m2) =>
    int rows = matrix.rows(m1)
    int cols = matrix.columns(m1)
    matrix<float> result = matrix.new<float>(rows, cols)
    for row = 0 to rows - 1
        for col = 0 to cols - 1
            result.set(row, col, matrix.get(m1, row, col) * matrix.get(m2, row, col))
    result

// @function Element-wise division
// @param m1 First matrix (numerator)
// @param m2 Second matrix (denominator)
// @returns Element-wise quotient
export elementDiv(matrix<float> m1, matrix<float> m2) =>
    int rows = matrix.rows(m1)
    int cols = matrix.columns(m1)
    matrix<float> result = matrix.new<float>(rows, cols)
    for row = 0 to rows - 1
        for col = 0 to cols - 1
            float denom = matrix.get(m2, row, col)
            float val = math.abs(denom) > 1e-10 ? matrix.get(m1, row, col) / denom : 0.0
            result.set(row, col, val)
    result

// @function Calculates the mean of each column in a matrix
// @param m The input matrix (samples x features)
// @returns Array of column means
export columnMeans(matrix<float> m) =>
    int rows = matrix.rows(m)
    int cols = matrix.columns(m)
    array<float> means = array.new<float>(cols, 0.0)
    if rows == 0
        means
    else
        for col = 0 to cols - 1
            float sum = 0.0
            for row = 0 to rows - 1
                sum += matrix.get(m, row, col)
            array.set(means, col, sum / rows)
        means

// @function Calculates the mean of each row in a matrix
// @param m The input matrix
// @returns Array of row means
export rowMeans(matrix<float> m) =>
    int rows = matrix.rows(m)
    int cols = matrix.columns(m)
    array<float> means = array.new<float>(rows, 0.0)
    if cols == 0
        means
    else
        for row = 0 to rows - 1
            float sum = 0.0
            for col = 0 to cols - 1
                sum += matrix.get(m, row, col)
            array.set(means, row, sum / cols)
        means

// @function Calculates the standard deviation of each column
// @param m The input matrix (samples x features)
// @returns Array of column standard deviations
export columnStdDev(matrix<float> m) =>
    int rows = matrix.rows(m)
    int cols = matrix.columns(m)
    array<float> means = columnMeans(m)
    array<float> stds = array.new<float>(cols, 0.0)
    if rows <= 1
        stds
    else
        for col = 0 to cols - 1
            float mean = array.get(means, col)
            float sumSq = 0.0
            for row = 0 to rows - 1
                float diff = matrix.get(m, row, col) - mean
                sumSq += diff * diff
            array.set(stds, col, math.sqrt(sumSq / rows))
        stds

// @function Centers and scales a matrix (z-score normalization)
// @param m The input matrix
// @returns Standardized matrix with zero mean and unit variance per column
export standardize(matrix<float> m) =>
    int rows = matrix.rows(m)
    int cols = matrix.columns(m)
    array<float> means = columnMeans(m)
    array<float> stds = columnStdDev(m)
    matrix<float> result = matrix.new<float>(rows, cols)
    for row = 0 to rows - 1
        for col = 0 to cols - 1
            float mean = array.get(means, col)
            float std = array.get(stds, col)
            float val = matrix.get(m, row, col)
            float normalized = std > 1e-10 ? (val - mean) / std : 0.0
            result.set(row, col, normalized)
    result

// @type Scaler parameters for reproducible transformations
export type ScalerParams
    array<float> means
    array<float> stds
    array<float> mins
    array<float> maxs
    string scalerType

// @function Fits and returns standardization parameters
// @param m The input matrix
// @returns ScalerParams for later use
export fitStandardScaler(matrix<float> m) =>
    array<float> means = columnMeans(m)
    array<float> stds = columnStdDev(m)
    ScalerParams.new(means, stds, array.new<float>(), array.new<float>(), "standard")

// @function Transforms data using fitted scaler params
// @param m Matrix to transform
// @param params Fitted ScalerParams
// @returns Transformed matrix
export transformScaler(matrix<float> m, ScalerParams params) =>
    int rows = matrix.rows(m)
    int cols = matrix.columns(m)
    matrix<float> result = matrix.new<float>(rows, cols)

    if params.scalerType == "standard"
        for row = 0 to rows - 1
            for col = 0 to cols - 1
                float mean = array.get(params.means, col)
                float std = array.get(params.stds, col)
                float val = matrix.get(m, row, col)
                result.set(row, col, std > 1e-10 ? (val - mean) / std : 0.0)
    else if params.scalerType == "minmax"
        for row = 0 to rows - 1
            for col = 0 to cols - 1
                float minV = array.get(params.mins, col)
                float maxV = array.get(params.maxs, col)
                float val = matrix.get(m, row, col)
                float range1 = maxV - minV
                result.set(row, col, range1 > 1e-10 ? (val - minV) / range1 : 0.0)
    result

// @function Inverse transforms data using fitted scaler params
// @param m Matrix to inverse transform
// @param params Fitted ScalerParams
// @returns Original scale matrix
export inverseTransformScaler(matrix<float> m, ScalerParams params) =>
    int rows = matrix.rows(m)
    int cols = matrix.columns(m)
    matrix<float> result = matrix.new<float>(rows, cols)

    if params.scalerType == "standard"
        for row = 0 to rows - 1
            for col = 0 to cols - 1
                float mean = array.get(params.means, col)
                float std = array.get(params.stds, col)
                float val = matrix.get(m, row, col)
                result.set(row, col, val * std + mean)
    else if params.scalerType == "minmax"
        for row = 0 to rows - 1
            for col = 0 to cols - 1
                float minV = array.get(params.mins, col)
                float maxV = array.get(params.maxs, col)
                float val = matrix.get(m, row, col)
                float range2 = maxV - minV
                result.set(row, col, val * range2 + minV)
    result

// @function Min-max normalization to [0, 1] range
// @param m The input matrix
// @returns Normalized matrix with values in [0, 1]
export minMaxNormalize(matrix<float> m) =>
    int rows = matrix.rows(m)
    int cols = matrix.columns(m)
    matrix<float> result = matrix.new<float>(rows, cols)
    for col = 0 to cols - 1
        float minVal = matrix.get(m, 0, col)
        float maxVal = minVal
        for row = 1 to rows - 1
            float val = matrix.get(m, row, col)
            minVal := math.min(minVal, val)
            maxVal := math.max(maxVal, val)
        float range3 = maxVal - minVal
        for row = 0 to rows - 1
            float val = matrix.get(m, row, col)
            float normalized = range3 > 1e-10 ? (val - minVal) / range3 : 0.0
            result.set(row, col, normalized)
    result

// @function Fits min-max scaler parameters
// @param m The input matrix
// @returns ScalerParams for later use
export fitMinMaxScaler(matrix<float> m) =>
    int rows = matrix.rows(m)
    int cols = matrix.columns(m)
    array<float> mins = array.new<float>(cols)
    array<float> maxs = array.new<float>(cols)

    for col = 0 to cols - 1
        float minVal = matrix.get(m, 0, col)
        float maxVal = minVal
        for row = 1 to rows - 1
            float val = matrix.get(m, row, col)
            minVal := math.min(minVal, val)
            maxVal := math.max(maxVal, val)
        array.set(mins, col, minVal)
        array.set(maxs, col, maxVal)

    ScalerParams.new(array.new<float>(), array.new<float>(), mins, maxs, "minmax")

// @function Adds a column of ones to the beginning of a matrix (for bias term)
// @param m The input matrix
// @returns Matrix with prepended column of ones
export addBiasColumn(matrix<float> m) =>
    int rows = matrix.rows(m)
    int cols = matrix.columns(m)
    matrix<float> result = matrix.new<float>(rows, cols + 1)
    for row = 0 to rows - 1
        result.set(row, 0, 1.0)
        for col = 0 to cols - 1
            result.set(row, col + 1, matrix.get(m, row, col))
    result

// @function Computes dot product of two arrays
// @param a First array
// @param b Second array
// @returns Dot product scalar
export dotProduct(array<float> a, array<float> b) =>
    int n = math.min(array.size(a), array.size(b))
    float result = 0.0
    for i = 0 to n - 1
        result += array.get(a, i) * array.get(b, i)
    result

// @function Computes sum of array elements
// @param arr Input array
// @returns Sum
export arraySum(array<float> arr) =>
    float result = 0.0
    int n = array.size(arr)
    for i = 0 to n - 1
        result += array.get(arr, i)
    result

// @function Computes median of array
// @param arr Input array
// @returns Median value
export arrayMedian(array<float> arr) =>
    array<float> sorted = array.copy(arr)
    array.sort(sorted)
    int n = array.size(sorted)
    if n == 0
        0.0
    else if n % 2 == 0
        (array.get(sorted, n / 2 - 1) + array.get(sorted, n / 2)) / 2.0
    else
        array.get(sorted, n / 2)

// @function Computes percentile of array
// @param arr Input array
// @param p Percentile (0-100)
// @returns Percentile value
export arrayPercentile(array<float> arr, float p) =>
    array<float> sorted = array.copy(arr)
    array.sort(sorted)
    int n = array.size(sorted)
    if n == 0
        0.0
    else
        float idx = (p / 100.0) * (n - 1)
        int lower = int(math.floor(idx))
        int upper = int(math.ceil(idx))
        float frac = idx - lower
        if lower == upper
            array.get(sorted, lower)
        else
            array.get(sorted, lower) * (1 - frac) + array.get(sorted, upper) * frac

// ==============================================================================
// SECTION 2: ACTIVATION FUNCTIONS (Numerically Stable)
// ==============================================================================

// @function Sigmoid activation function (numerically stable)
// @param x Input value
// @returns Sigmoid output in (0, 1)
export sigmoid(float x) =>
    if x >= 0
        float z = math.exp(-math.min(x, 700.0))
        1.0 / (1.0 + z)
    else
        float z = math.exp(math.max(x, -700.0))
        z / (1.0 + z)

// @function Sigmoid derivative
// @param x Input value (output of sigmoid)
// @returns Derivative
export sigmoidDerivative(float x) =>
    x * (1.0 - x)

// @function Applies sigmoid to all elements of a matrix
// @param m Input matrix
// @returns Matrix with sigmoid applied element-wise
export sigmoidMatrix(matrix<float> m) =>
    int rows = matrix.rows(m)
    int cols = matrix.columns(m)
    matrix<float> result = matrix.new<float>(rows, cols)
    for row = 0 to rows - 1
        for col = 0 to cols - 1
            result.set(row, col, sigmoid(matrix.get(m, row, col)))
    result

// @function Hyperbolic tangent activation (numerically stable)
// @param x Input value
// @returns Tanh output in (-1, 1)
export tanhActivation(float x) =>
    if math.abs(x) > 20.0
        x > 0.0 ? 1.0 : -1.0
    else
        float ep = math.exp(x)
        float en = math.exp(-x)
        (ep - en) / (ep + en)

// @function Tanh derivative
// @param x Input value (output of tanh)
// @returns Derivative
export tanhDerivative(float x) =>
    1.0 - x * x

// @function Applies tanh to all elements of a matrix
// @param m Input matrix
// @returns Matrix with tanh applied element-wise
export tanhMatrix(matrix<float> m) =>
    int rows = matrix.rows(m)
    int cols = matrix.columns(m)
    matrix<float> result = matrix.new<float>(rows, cols)
    for row = 0 to rows - 1
        for col = 0 to cols - 1
            result.set(row, col, tanhActivation(matrix.get(m, row, col)))
    result

// @function ReLU activation function
// @param x Input value
// @returns max(0, x)
export relu(float x) =>
    math.max(0.0, x)

// @function ReLU derivative
// @param x Input value
// @returns 1 if x > 0, else 0
export reluDerivative(float x) =>
    x > 0.0 ? 1.0 : 0.0

// @function Applies ReLU to all elements of a matrix
// @param m Input matrix
// @returns Matrix with ReLU applied element-wise
export reluMatrix(matrix<float> m) =>
    int rows = matrix.rows(m)
    int cols = matrix.columns(m)
    matrix<float> result = matrix.new<float>(rows, cols)
    for row = 0 to rows - 1
        for col = 0 to cols - 1
            result.set(row, col, relu(matrix.get(m, row, col)))
    result

// @function Leaky ReLU activation function
// @param x Input value
// @param alpha Slope for negative values (default 0.01)
// @returns Leaky ReLU output
export leakyRelu(float x, float alpha = 0.01) =>
    x >= 0.0 ? x : alpha * x

// @function Applies Leaky ReLU to all elements of a matrix
// @param m Input matrix
// @param alpha Slope for negative values
// @returns Matrix with Leaky ReLU applied element-wise
export leakyReluMatrix(matrix<float> m, float alpha = 0.01) =>
    int rows = matrix.rows(m)
    int cols = matrix.columns(m)
    matrix<float> result = matrix.new<float>(rows, cols)
    for row = 0 to rows - 1
        for col = 0 to cols - 1
            result.set(row, col, leakyRelu(matrix.get(m, row, col), alpha))
    result

// @function ELU (Exponential Linear Unit) activation
// @param x Input value
// @param alpha Scale for negative values (default 1.0)
// @returns ELU output
export elu(float x, float alpha = 1.0) =>
    x >= 0.0 ? x : alpha * (math.exp(math.max(-700.0, x)) - 1.0)

// @function Applies ELU to all elements of a matrix
// @param m Input matrix
// @param alpha Scale for negative values
// @returns Matrix with ELU applied element-wise
export eluMatrix(matrix<float> m, float alpha = 1.0) =>
    int rows = matrix.rows(m)
    int cols = matrix.columns(m)
    matrix<float> result = matrix.new<float>(rows, cols)
    for row = 0 to rows - 1
        for col = 0 to cols - 1
            result.set(row, col, elu(matrix.get(m, row, col), alpha))
    result

// @function Swish activation (x * sigmoid(x))
// @param x Input value
// @returns Swish output
export swish(float x) =>
    x * sigmoid(x)

// @function Applies Swish to all elements of a matrix
// @param m Input matrix
// @returns Matrix with Swish applied element-wise
export swishMatrix(matrix<float> m) =>
    int rows = matrix.rows(m)
    int cols = matrix.columns(m)
    matrix<float> result = matrix.new<float>(rows, cols)
    for row = 0 to rows - 1
        for col = 0 to cols - 1
            result.set(row, col, swish(matrix.get(m, row, col)))
    result

// @function GELU (Gaussian Error Linear Unit) approximation
// @param x Input value
// @returns GELU output
export gelu(float x) =>
    0.5 * x * (1.0 + tanhActivation(0.7978845608 * (x + 0.044715 * x * x * x)))

// @function Applies GELU to all elements of a matrix
// @param m Input matrix
// @returns Matrix with GELU applied element-wise
export geluMatrix(matrix<float> m) =>
    int rows = matrix.rows(m)
    int cols = matrix.columns(m)
    matrix<float> result = matrix.new<float>(rows, cols)
    for row = 0 to rows - 1
        for col = 0 to cols - 1
            result.set(row, col, gelu(matrix.get(m, row, col)))
    result

// @function Softmax activation for a row vector (numerically stable)
// @param arr Input array
// @returns Array of probabilities summing to 1
export softmax(array<float> arr) =>
    int n = array.size(arr)
    if n == 0
        array.new<float>()
    else
        float maxVal = array.max(arr)
        array<float> expVals = array.new<float>(n)
        float sumExp = 0.0
        for i = 0 to n - 1
            float expVal = math.exp(math.min(700.0, array.get(arr, i) - maxVal))
            array.set(expVals, i, expVal)
            sumExp += expVal
        for i = 0 to n - 1
            array.set(expVals, i, sumExp > 1e-10 ? array.get(expVals, i) / sumExp : 1.0 / n)
        expVals

// @function Applies softmax row-wise to a matrix
// @param m Input matrix
// @returns Matrix with softmax applied to each row
export softmaxMatrix(matrix<float> m) =>
    int rows = matrix.rows(m)
    int cols = matrix.columns(m)
    matrix<float> result = matrix.new<float>(rows, cols)
    for row = 0 to rows - 1
        array<float> rowArr = matrix.row(m, row)
        array<float> softmaxRow = softmax(rowArr)
        for col = 0 to cols - 1
            result.set(row, col, array.get(softmaxRow, col))
    result

// ==============================================================================
// SECTION 3: LINEAR REGRESSION (OLS)
// ==============================================================================

// @type Linear regression model container
export type LinearRegressionModel
    array<float> coefficients
    float intercept
    float rSquared
    float mse
    float adjustedRSquared
    float standardError

// @function Fits a simple linear regression model (single feature)
// @param x Array of independent variable values
// @param y Array of dependent variable values
// @returns LinearRegressionModel with coefficients and metrics
export fitSimpleLinearRegression(array<float> x, array<float> y) =>
    int n = array.size(x)
    float sumX = 0.0
    float sumY = 0.0
    float sumXY = 0.0
    float sumX2 = 0.0

    for i = 0 to n - 1
        float xi = array.get(x, i)
        float yi = array.get(y, i)
        sumX += xi
        sumY += yi
        sumXY += xi * yi
        sumX2 += xi * xi

    float meanX = sumX / math.max(1, n)
    float meanY = sumY / math.max(1, n)
    float denom = n * sumX2 - sumX * sumX
    float slope = math.abs(denom) > 1e-10 ? (n * sumXY - sumX * sumY) / denom : 0.0
    float intercept = meanY - slope * meanX

    float ssRes = 0.0
    float ssTot = 0.0
    for i = 0 to n - 1
        float yi = array.get(y, i)
        float yPred = slope * array.get(x, i) + intercept
        ssRes += math.pow(yi - yPred, 2)
        ssTot += math.pow(yi - meanY, 2)

    float rSquared = ssTot > 1e-10 ? 1.0 - ssRes / ssTot : 0.0
    float mse = ssRes / math.max(1, n)
    float adjustedRSquared = 1.0 - (1.0 - rSquared) * (n - 1) / math.max(1, n - 2)
    float standardError = math.sqrt(ssRes / math.max(1, n - 2))

    LinearRegressionModel.new(array.from(slope), intercept, rSquared, mse, adjustedRSquared, standardError)

// @function Fits multiple linear regression using normal equation
// @param X Feature matrix (samples x features)
// @param y Target vector
// @returns LinearRegressionModel with coefficients and metrics
export fitLinearRegression(matrix<float> X, array<float> y) =>
    matrix<float> Xb = addBiasColumn(X)
    int n = matrix.rows(Xb)
    int p = matrix.columns(Xb)

    matrix<float> Y = matrix.new<float>(n, 1)
    for i = 0 to n - 1
        Y.set(i, 0, array.get(y, i))

    matrix<float> Xt = matrix.transpose(Xb)
    matrix<float> XtX = matrix.mult(Xt, Xb)
    matrix<float> XtX_inv = matrix.pinv(XtX)
    matrix<float> XtY = matrix.mult(Xt, Y)
    matrix<float> beta = matrix.mult(XtX_inv, XtY)

    float intercept = matrix.get(beta, 0, 0)
    array<float> coefficients = array.new<float>(p - 1)
    for i = 1 to p - 1
        array.set(coefficients, i - 1, matrix.get(beta, i, 0))

    matrix<float> yPred = matrix.mult(Xb, beta)
    float meanY = array.avg(y)
    float ssRes = 0.0
    float ssTot = 0.0
    for i = 0 to n - 1
        float yi = array.get(y, i)
        float pred = matrix.get(yPred, i, 0)
        ssRes += math.pow(yi - pred, 2)
        ssTot += math.pow(yi - meanY, 2)

    float rSquared = ssTot > 1e-10 ? 1.0 - ssRes / ssTot : 0.0
    float mse = ssRes / math.max(1, n)
    float adjustedRSquared = 1.0 - (1.0 - rSquared) * (n - 1) / math.max(1, n - p)
    float standardError = math.sqrt(ssRes / math.max(1, n - p))

    LinearRegressionModel.new(coefficients, intercept, rSquared, mse, adjustedRSquared, standardError)

// @function Predicts using a linear regression model
// @param model The fitted LinearRegressionModel
// @param X Feature matrix for prediction
// @returns Array of predictions
export predictLinearRegression(LinearRegressionModel model, matrix<float> X) =>
    int n = matrix.rows(X)
    int p = matrix.columns(X)
    array<float> predictions = array.new<float>(n)

    for row = 0 to n - 1
        float pred = model.intercept
        for col = 0 to p - 1
            pred += array.get(model.coefficients, col) * matrix.get(X, row, col)
        array.set(predictions, row, pred)
    predictions

// @function Single value prediction for linear regression
// @param model The fitted LinearRegressionModel
// @param features Feature array for single prediction
// @returns Predicted value
export predictLinearRegressionSingle(LinearRegressionModel model, array<float> features) =>
    float pred = model.intercept
    int n = math.min(array.size(features), array.size(model.coefficients))
    for i = 0 to n - 1
        pred += array.get(model.coefficients, i) * array.get(features, i)
    pred

// @function Computes prediction interval for linear regression
// @param model The fitted LinearRegressionModel
// @param X Original training feature matrix
// @param xNew New feature array for prediction
// @param confidence Confidence level (default 0.95)
// @returns [prediction, lower_bound, upper_bound]
export predictionInterval(LinearRegressionModel model, matrix<float> X, array<float> xNew, float confidence = 0.95) =>
    int n = matrix.rows(X)
    int p = array.size(model.coefficients)

    float pred = predictLinearRegressionSingle(model, xNew)

    // t-value approximation for common confidence levels
    float tValue = confidence >= 0.99 ? 2.576 : confidence >= 0.95 ? 1.96 : 1.645

    // Calculate leverage for new point (simplified)
    array<float> means = columnMeans(X)
    float sumSqDev = 0.0
    for j = 0 to p - 1
        float dev = array.get(xNew, j) - array.get(means, j)
        sumSqDev += dev * dev

    float sxx = 0.0
    for i = 0 to n - 1
        for j = 0 to p - 1
            float dev = matrix.get(X, i, j) - array.get(means, j)
            sxx += dev * dev

    float leverage = 1.0 / n + (sxx > 1e-10 ? sumSqDev / sxx : 0.0)
    float se = model.standardError * math.sqrt(1.0 + leverage)
    float margin = tValue * se

    [pred, pred - margin, pred + margin]

// ==============================================================================
// SECTION 4: WEIGHTED LINEAR REGRESSION
// ==============================================================================

// @function Fits weighted linear regression
// @param X Feature matrix (samples x features)
// @param y Target vector
// @param weights Sample weights
// @returns LinearRegressionModel with coefficients and metrics
export fitWeightedLinearRegression(matrix<float> X, array<float> y, array<float> weights) =>
    matrix<float> Xb = addBiasColumn(X)
    int n = matrix.rows(Xb)
    int p = matrix.columns(Xb)

    // Create weight matrix
    matrix<float> W = matrix.new<float>(n, n, 0.0)
    float sumWeights = 0.0
    for i = 0 to n - 1
        float w = array.get(weights, i)
        W.set(i, i, w)
        sumWeights += w

    matrix<float> Y = matrix.new<float>(n, 1)
    for i = 0 to n - 1
        Y.set(i, 0, array.get(y, i))

    // Weighted normal equation: (X'WX)^-1 X'Wy
    matrix<float> Xt = matrix.transpose(Xb)
    matrix<float> XtW = matrix.mult(Xt, W)
    matrix<float> XtWX = matrix.mult(XtW, Xb)
    matrix<float> XtWX_inv = matrix.pinv(XtWX)
    matrix<float> XtWY = matrix.mult(XtW, Y)
    matrix<float> beta = matrix.mult(XtWX_inv, XtWY)

    float intercept = matrix.get(beta, 0, 0)
    array<float> coefficients = array.new<float>(p - 1)
    for i = 1 to p - 1
        array.set(coefficients, i - 1, matrix.get(beta, i, 0))

    // Weighted metrics
    float meanY = 0.0
    for i = 0 to n - 1
        meanY += array.get(weights, i) * array.get(y, i)
    meanY /= math.max(1e-10, sumWeights)

    float ssRes = 0.0
    float ssTot = 0.0
    for i = 0 to n - 1
        float yi = array.get(y, i)
        float pred = intercept
        for j = 0 to p - 2
            pred += array.get(coefficients, j) * matrix.get(X, i, j)
        float w = array.get(weights, i)
        ssRes += w * math.pow(yi - pred, 2)
        ssTot += w * math.pow(yi - meanY, 2)

    float rSquared = ssTot > 1e-10 ? 1.0 - ssRes / ssTot : 0.0
    float mse = ssRes / math.max(1e-10, sumWeights)
    float adjustedRSquared = 1.0 - (1.0 - rSquared) * (n - 1) / math.max(1, n - p)
    float standardError = math.sqrt(ssRes / math.max(1, n - p))

    LinearRegressionModel.new(coefficients, intercept, rSquared, mse, adjustedRSquared, standardError)

// ==============================================================================
// SECTION 5: POLYNOMIAL REGRESSION
// ==============================================================================

// @function Creates a Vandermonde matrix for polynomial features
// @param x Array of values
// @param degree Polynomial degree
// @returns Vandermonde matrix (n x degree+1)
export vandermonde(array<float> x, int degree) =>
    int n = array.size(x)
    matrix<float> V = matrix.new<float>(n, degree + 1)
    for row = 0 to n - 1
        float xi = array.get(x, row)
        for col = 0 to degree
            V.set(row, col, math.pow(xi, col))
    V

// @type Polynomial regression model container
export type PolynomialRegressionModel
    array<float> coefficients
    int degree
    float rSquared
    float mse

// @function Fits polynomial regression
// @param x Array of independent variable values
// @param y Array of dependent variable values
// @param degree Polynomial degree
// @returns PolynomialRegressionModel with coefficients
export fitPolynomialRegression(array<float> x, array<float> y, int degree) =>
    int n = array.size(x)

    matrix<float> V = vandermonde(x, degree)
    matrix<float> Y = matrix.new<float>(n, 1)
    for i = 0 to n - 1
        Y.set(i, 0, array.get(y, i))

    matrix<float> Vt = matrix.transpose(V)
    matrix<float> VtV = matrix.mult(Vt, V)
    matrix<float> VtV_inv = matrix.pinv(VtV)
    matrix<float> VtY = matrix.mult(Vt, Y)
    matrix<float> coeffs = matrix.mult(VtV_inv, VtY)

    array<float> coefficients = array.new<float>(degree + 1)
    for i = 0 to degree
        array.set(coefficients, i, matrix.get(coeffs, i, 0))

    matrix<float> yPred = matrix.mult(V, coeffs)
    float meanY = array.avg(y)
    float ssRes = 0.0
    float ssTot = 0.0
    for i = 0 to n - 1
        float yi = array.get(y, i)
        float pred = matrix.get(yPred, i, 0)
        ssRes += math.pow(yi - pred, 2)
        ssTot += math.pow(yi - meanY, 2)

    float rSquared = ssTot > 1e-10 ? 1.0 - ssRes / ssTot : 0.0
    float mse = ssRes / math.max(1, n)

    PolynomialRegressionModel.new(coefficients, degree, rSquared, mse)

// @function Predicts using a polynomial regression model
// @param model The fitted PolynomialRegressionModel
// @param x Array of values to predict
// @returns Array of predictions
export predictPolynomialRegression(PolynomialRegressionModel model, array<float> x) =>
    int n = array.size(x)
    array<float> predictions = array.new<float>(n)

    for i = 0 to n - 1
        float xi = array.get(x, i)
        float pred = 0.0
        for d = 0 to model.degree
            pred += array.get(model.coefficients, d) * math.pow(xi, d)
        array.set(predictions, i, pred)
    predictions

// @function Evaluates polynomial at a single point
// @param model The PolynomialRegressionModel
// @param x The point to evaluate
// @returns Predicted value
export evaluatePolynomial(PolynomialRegressionModel model, float x) =>
    float result = 0.0
    for d = 0 to model.degree
        result += array.get(model.coefficients, d) * math.pow(x, d)
    result

// ==============================================================================
// SECTION 6: RIDGE REGRESSION (L2 REGULARIZATION)
// ==============================================================================

// @type Ridge regression model container
export type RidgeRegressionModel
    array<float> coefficients
    float intercept
    float lambda
    float rSquared
    float mse

// @function Fits ridge regression: beta = (X'X + lambda*I)^(-1) X'y
// @param X Feature matrix (samples x features)
// @param y Target vector
// @param lambda Regularization parameter
// @returns RidgeRegressionModel with coefficients
export fitRidgeRegression(matrix<float> X, array<float> y, float lambda) =>
    matrix<float> Xb = addBiasColumn(X)
    int n = matrix.rows(Xb)
    int p = matrix.columns(Xb)

    matrix<float> Y = matrix.new<float>(n, 1)
    for i = 0 to n - 1
        Y.set(i, 0, array.get(y, i))

    matrix<float> Xt = matrix.transpose(Xb)
    matrix<float> XtX = matrix.mult(Xt, Xb)

    matrix<float> lambdaI = matrix.new<float>(p, p, 0.0)
    for i = 1 to p - 1
        lambdaI.set(i, i, lambda)

    matrix<float> XtX_reg = matrix.sum(XtX, lambdaI)
    matrix<float> XtX_inv = matrix.pinv(XtX_reg)
    matrix<float> XtY = matrix.mult(Xt, Y)
    matrix<float> beta = matrix.mult(XtX_inv, XtY)

    float intercept = matrix.get(beta, 0, 0)
    array<float> coefficients = array.new<float>(p - 1)
    for i = 1 to p - 1
        array.set(coefficients, i - 1, matrix.get(beta, i, 0))

    matrix<float> yPred = matrix.mult(Xb, beta)
    float meanY = array.avg(y)
    float ssRes = 0.0
    float ssTot = 0.0
    for i = 0 to n - 1
        float yi = array.get(y, i)
        float pred = matrix.get(yPred, i, 0)
        ssRes += math.pow(yi - pred, 2)
        ssTot += math.pow(yi - meanY, 2)

    float rSquared = ssTot > 1e-10 ? 1.0 - ssRes / ssTot : 0.0
    float mse = ssRes / math.max(1, n)

    RidgeRegressionModel.new(coefficients, intercept, lambda, rSquared, mse)

// @function Predicts using a ridge regression model
// @param model The fitted RidgeRegressionModel
// @param X Feature matrix for prediction
// @returns Array of predictions
export predictRidgeRegression(RidgeRegressionModel model, matrix<float> X) =>
    int n = matrix.rows(X)
    int p = matrix.columns(X)
    array<float> predictions = array.new<float>(n)

    for row = 0 to n - 1
        float pred = model.intercept
        for col = 0 to p - 1
            pred += array.get(model.coefficients, col) * matrix.get(X, row, col)
        array.set(predictions, row, pred)
    predictions

// ==============================================================================
// SECTION 7: LASSO REGRESSION (L1 REGULARIZATION) - Coordinate Descent
// ==============================================================================

// @type LASSO regression model container
export type LassoRegressionModel
    array<float> coefficients
    float intercept
    float lambda
    float rSquared
    float mse
    int iterations

// @function Soft thresholding operator for LASSO
// @param x Input value
// @param lambda Threshold
// @returns Soft thresholded value
export softThreshold(float x, float lambda) =>
    if x > lambda
        x - lambda
    else if x < -lambda
        x + lambda
    else
        0.0

// @function Fits LASSO regression using coordinate descent
// @param X Feature matrix (samples x features)
// @param y Target vector
// @param lambda Regularization parameter
// @param maxIter Maximum iterations (default 100)
// @param tol Convergence tolerance (default 1e-4)
// @returns LassoRegressionModel with coefficients
export fitLassoRegression(matrix<float> X, array<float> y, float lambda, int maxIter = 100, float tol = 0.0001) =>
    int n = matrix.rows(X)
    int p = matrix.columns(X)

    // Center y
    float meanY = array.avg(y)
    array<float> yc = array.new<float>(n)
    for i = 0 to n - 1
        array.set(yc, i, array.get(y, i) - meanY)

    // Initialize coefficients
    array<float> beta = array.new<float>(p, 0.0)
    array<float> residuals = array.copy(yc)

    int iter = 0
    bool converged = false

    while iter < maxIter and not converged
        float maxChange = 0.0

        for j = 0 to p - 1
            float oldBeta = array.get(beta, j)

            // Add back contribution of current feature
            for i = 0 to n - 1
                float xi = matrix.get(X, i, j)
                array.set(residuals, i, array.get(residuals, i) + oldBeta * xi)

            // Compute correlation
            float rho = 0.0
            float norm = 0.0
            for i = 0 to n - 1
                float xi = matrix.get(X, i, j)
                rho += xi * array.get(residuals, i)
                norm += xi * xi

            // Update coefficient with soft thresholding
            float newBeta = norm > 1e-10 ? softThreshold(rho, lambda * n) / norm : 0.0
            array.set(beta, j, newBeta)

            // Update residuals
            for i = 0 to n - 1
                float xi = matrix.get(X, i, j)
                array.set(residuals, i, array.get(residuals, i) - newBeta * xi)

            maxChange := math.max(maxChange, math.abs(newBeta - oldBeta))

        iter += 1
        converged := maxChange < tol

    // Calculate intercept
    float intercept = meanY
    for j = 0 to p - 1
        float colMean = 0.0
        for i = 0 to n - 1
            colMean += matrix.get(X, i, j)
        colMean /= n
        intercept -= array.get(beta, j) * colMean

    // Calculate metrics
    float ssRes = 0.0
    float ssTot = 0.0
    for i = 0 to n - 1
        float pred = intercept
        for j = 0 to p - 1
            pred += array.get(beta, j) * matrix.get(X, i, j)
        float yi = array.get(y, i)
        ssRes += math.pow(yi - pred, 2)
        ssTot += math.pow(yi - meanY, 2)

    float rSquared = ssTot > 1e-10 ? 1.0 - ssRes / ssTot : 0.0
    float mse = ssRes / math.max(1, n)

    LassoRegressionModel.new(beta, intercept, lambda, rSquared, mse, iter)

// @function Predicts using a LASSO regression model
// @param model The fitted LassoRegressionModel
// @param X Feature matrix for prediction
// @returns Array of predictions
export predictLassoRegression(LassoRegressionModel model, matrix<float> X) =>
    int n = matrix.rows(X)
    int p = matrix.columns(X)
    array<float> predictions = array.new<float>(n)

    for row = 0 to n - 1
        float pred = model.intercept
        for col = 0 to p - 1
            pred += array.get(model.coefficients, col) * matrix.get(X, row, col)
        array.set(predictions, row, pred)
    predictions

// ==============================================================================
// SECTION 8: ELASTIC NET (L1 + L2 REGULARIZATION)
// ==============================================================================

// @type Elastic Net model container
export type ElasticNetModel
    array<float> coefficients
    float intercept
    float alpha
    float lambda
    float rSquared
    float mse

// @function Fits Elastic Net regression
// @param X Feature matrix (samples x features)
// @param y Target vector
// @param lambda Overall regularization strength
// @param alpha L1 ratio (0 = Ridge, 1 = LASSO)
// @param maxIter Maximum iterations
// @param tol Convergence tolerance
// @returns ElasticNetModel with coefficients
export fitElasticNet(matrix<float> X, array<float> y, float lambda, float alpha = 0.5, int maxIter = 100, float tol = 0.0001) =>
    int n = matrix.rows(X)
    int p = matrix.columns(X)

    float l1Penalty = lambda * alpha
    float l2Penalty = lambda * (1.0 - alpha)

    float meanY = array.avg(y)
    array<float> yc = array.new<float>(n)
    for i = 0 to n - 1
        array.set(yc, i, array.get(y, i) - meanY)

    array<float> beta = array.new<float>(p, 0.0)
    array<float> residuals = array.copy(yc)

    int iter = 0
    bool converged = false

    while iter < maxIter and not converged
        float maxChange = 0.0

        for j = 0 to p - 1
            float oldBeta = array.get(beta, j)

            for i = 0 to n - 1
                float xi = matrix.get(X, i, j)
                array.set(residuals, i, array.get(residuals, i) + oldBeta * xi)

            float rho = 0.0
            float norm = 0.0
            for i = 0 to n - 1
                float xi = matrix.get(X, i, j)
                rho += xi * array.get(residuals, i)
                norm += xi * xi

            // Elastic Net update
            float denom = norm + l2Penalty * n
            float newBeta = denom > 1e-10 ? softThreshold(rho, l1Penalty * n) / denom : 0.0
            array.set(beta, j, newBeta)

            for i = 0 to n - 1
                float xi = matrix.get(X, i, j)
                array.set(residuals, i, array.get(residuals, i) - newBeta * xi)

            maxChange := math.max(maxChange, math.abs(newBeta - oldBeta))

        iter += 1
        converged := maxChange < tol

    float intercept = meanY
    for j = 0 to p - 1
        float colMean = 0.0
        for i = 0 to n - 1
            colMean += matrix.get(X, i, j)
        colMean /= n
        intercept -= array.get(beta, j) * colMean

    float ssRes = 0.0
    float ssTot = 0.0
    for i = 0 to n - 1
        float pred = intercept
        for j = 0 to p - 1
            pred += array.get(beta, j) * matrix.get(X, i, j)
        float yi = array.get(y, i)
        ssRes += math.pow(yi - pred, 2)
        ssTot += math.pow(yi - meanY, 2)

    float rSquared = ssTot > 1e-10 ? 1.0 - ssRes / ssTot : 0.0
    float mse = ssRes / math.max(1, n)

    ElasticNetModel.new(beta, intercept, alpha, lambda, rSquared, mse)

// ==============================================================================
// SECTION 9: HUBER ROBUST REGRESSION
// ==============================================================================

// @type Huber regression model container
export type HuberRegressionModel
    array<float> coefficients
    float intercept
    float delta
    float rSquared
    int iterations

// @function Huber loss function
// @param residual Residual value
// @param delta Threshold for switching from L2 to L1
// @returns Huber loss
export huberLoss(float residual, float delta) =>
    float absR = math.abs(residual)
    absR <= delta ? 0.5 * residual * residual : delta * (absR - 0.5 * delta)

// @function Huber loss weight for IRLS
// @param residual Residual value
// @param delta Threshold
// @returns Weight
huberWeight(float residual, float delta) =>
    float absR = math.abs(residual)
    absR <= delta ? 1.0 : delta / math.max(1e-10, absR)

// @function Fits Huber robust regression using IRLS
// @param X Feature matrix (samples x features)
// @param y Target vector
// @param delta Huber threshold (default 1.35 for 95% efficiency)
// @param maxIter Maximum iterations
// @param tol Convergence tolerance
// @returns HuberRegressionModel with coefficients
export fitHuberRegression(matrix<float> X, array<float> y, float delta = 1.35, int maxIter = 50, float tol = 0.0001) =>
    int n = matrix.rows(X)
    int p = matrix.columns(X)

    // Start with OLS
    matrix<float> Xb = addBiasColumn(X)
    matrix<float> Y = matrix.new<float>(n, 1)
    for i = 0 to n - 1
        Y.set(i, 0, array.get(y, i))

    matrix<float> Xt = matrix.transpose(Xb)
    matrix<float> XtX = matrix.mult(Xt, Xb)
    matrix<float> XtX_inv = matrix.pinv(XtX)
    matrix<float> XtY = matrix.mult(Xt, Y)
    matrix<float> beta = matrix.mult(XtX_inv, XtY)

    int iter = 0
    bool converged = false

    while iter < maxIter and not converged
        // Compute residuals
        matrix<float> yPred = matrix.mult(Xb, beta)
        array<float> residuals = array.new<float>(n)
        for i = 0 to n - 1
            array.set(residuals, i, array.get(y, i) - matrix.get(yPred, i, 0))

        // Compute scale estimate (MAD)
        array<float> absRes = array.new<float>(n)
        for i = 0 to n - 1
            array.set(absRes, i, math.abs(array.get(residuals, i)))
        float medianAbsRes = arrayMedian(absRes)
        float scale = medianAbsRes / 0.6745  // MAD scale

        // Compute weights
        array<float> weights = array.new<float>(n)
        for i = 0 to n - 1
            float r = scale > 1e-10 ? array.get(residuals, i) / scale : array.get(residuals, i)
            array.set(weights, i, huberWeight(r, delta))

        // Weighted least squares
        matrix<float> W = matrix.new<float>(n, n, 0.0)
        for i = 0 to n - 1
            W.set(i, i, array.get(weights, i))

        matrix<float> XtW = matrix.mult(Xt, W)
        matrix<float> XtWX = matrix.mult(XtW, Xb)
        matrix<float> XtWX_inv = matrix.pinv(XtWX)
        matrix<float> XtWY = matrix.mult(XtW, Y)
        matrix<float> betaNew = matrix.mult(XtWX_inv, XtWY)

        // Check convergence
        float maxChange = 0.0
        for i = 0 to p
            maxChange := math.max(maxChange, math.abs(matrix.get(betaNew, i, 0) - matrix.get(beta, i, 0)))

        beta := betaNew
        iter += 1
        converged := maxChange < tol

    float intercept = matrix.get(beta, 0, 0)
    array<float> coefficients = array.new<float>(p)
    for i = 1 to p
        array.set(coefficients, i - 1, matrix.get(beta, i, 0))

    // Calculate R-squared
    float meanY = array.avg(y)
    float ssRes = 0.0
    float ssTot = 0.0
    for i = 0 to n - 1
        float pred = intercept
        for j = 0 to p - 1
            pred += array.get(coefficients, j) * matrix.get(X, i, j)
        float yi = array.get(y, i)
        ssRes += math.pow(yi - pred, 2)
        ssTot += math.pow(yi - meanY, 2)

    float rSquared = ssTot > 1e-10 ? 1.0 - ssRes / ssTot : 0.0

    HuberRegressionModel.new(coefficients, intercept, delta, rSquared, iter)

// ==============================================================================
// SECTION 10: QUANTILE REGRESSION
// ==============================================================================

// @type Quantile regression model container
export type QuantileRegressionModel
    array<float> coefficients
    float intercept
    float quantile
    int iterations

// @function Fits quantile regression using IRLS
// @param X Feature matrix (samples x features)
// @param y Target vector
// @param quantile Target quantile (0-1, default 0.5 = median)
// @param maxIter Maximum iterations
// @param tol Convergence tolerance
// @returns QuantileRegressionModel with coefficients
export fitQuantileRegression(matrix<float> X, array<float> y, float quantile = 0.5, int maxIter = 50, float tol = 0.0001) =>
    int n = matrix.rows(X)
    int p = matrix.columns(X)

    matrix<float> Xb = addBiasColumn(X)
    matrix<float> Y = matrix.new<float>(n, 1)
    for i = 0 to n - 1
        Y.set(i, 0, array.get(y, i))

    // Initialize with OLS
    matrix<float> Xt = matrix.transpose(Xb)
    matrix<float> XtX = matrix.mult(Xt, Xb)
    matrix<float> XtX_inv = matrix.pinv(XtX)
    matrix<float> XtY = matrix.mult(Xt, Y)
    matrix<float> beta = matrix.mult(XtX_inv, XtY)

    int iter = 0
    bool converged = false

    while iter < maxIter and not converged
        // Compute residuals
        matrix<float> yPred = matrix.mult(Xb, beta)

        // Compute weights for IRLS
        array<float> weights = array.new<float>(n)
        for i = 0 to n - 1
            float residual = array.get(y, i) - matrix.get(yPred, i, 0)
            float absR = math.abs(residual)
            // Asymmetric weight for quantile loss
            float w = absR > 1e-10 ? (residual > 0 ? quantile : 1.0 - quantile) / absR : 1.0
            array.set(weights, i, w)

        // Weighted least squares
        matrix<float> W = matrix.new<float>(n, n, 0.0)
        for i = 0 to n - 1
            W.set(i, i, array.get(weights, i))

        matrix<float> XtW = matrix.mult(Xt, W)
        matrix<float> XtWX = matrix.mult(XtW, Xb)
        matrix<float> XtWX_inv = matrix.pinv(XtWX)
        matrix<float> XtWY = matrix.mult(XtW, Y)
        matrix<float> betaNew = matrix.mult(XtWX_inv, XtWY)

        // Check convergence
        float maxChange = 0.0
        for i = 0 to p
            maxChange := math.max(maxChange, math.abs(matrix.get(betaNew, i, 0) - matrix.get(beta, i, 0)))

        beta := betaNew
        iter += 1
        converged := maxChange < tol

    float intercept = matrix.get(beta, 0, 0)
    array<float> coefficients = array.new<float>(p)
    for i = 1 to p
        array.set(coefficients, i - 1, matrix.get(beta, i, 0))

    QuantileRegressionModel.new(coefficients, intercept, quantile, iter)

// @function Predicts using quantile regression model
// @param model The fitted QuantileRegressionModel
// @param X Feature matrix
// @returns Array of predictions
export predictQuantileRegression(QuantileRegressionModel model, matrix<float> X) =>
    int n = matrix.rows(X)
    int p = matrix.columns(X)
    array<float> predictions = array.new<float>(n)

    for row = 0 to n - 1
        float pred = model.intercept
        for col = 0 to p - 1
            pred += array.get(model.coefficients, col) * matrix.get(X, row, col)
        array.set(predictions, row, pred)
    predictions

// ==============================================================================
// SECTION 11: LOGISTIC REGRESSION (Binary Classification)
// ==============================================================================

// @type Logistic regression model container
export type LogisticRegressionModel
    array<float> coefficients
    float intercept
    float accuracy
    int iterations

// @function Fits logistic regression using gradient descent
// @param X Feature matrix (samples x features)
// @param y Binary labels (0 or 1)
// @param learningRate Learning rate
// @param maxIter Maximum iterations
// @param tol Convergence tolerance
// @param l2Lambda L2 regularization (default 0)
// @returns LogisticRegressionModel with coefficients
export fitLogisticRegression(matrix<float> X, array<int> y, float learningRate = 0.1, int maxIter = 100, float tol = 0.0001, float l2Lambda = 0.0) =>
    int n = matrix.rows(X)
    int p = matrix.columns(X)

    // Initialize weights
    array<float> weights = array.new<float>(p, 0.0)
    float bias = 0.0

    int iter = 0
    bool converged = false

    while iter < maxIter and not converged
        float maxChange = 0.0

        // Compute predictions
        array<float> predictions = array.new<float>(n)
        for i = 0 to n - 1
            float z = bias
            for j = 0 to p - 1
                z += array.get(weights, j) * matrix.get(X, i, j)
            array.set(predictions, i, sigmoid(z))

        // Compute gradients
        array<float> dw = array.new<float>(p, 0.0)
        float db = 0.0

        for i = 0 to n - 1
            float error = array.get(predictions, i) - float(array.get(y, i))
            db += error
            for j = 0 to p - 1
                array.set(dw, j, array.get(dw, j) + error * matrix.get(X, i, j))

        // Update weights with optional L2 regularization
        float oldBias = bias
        bias -= learningRate * db / n
        maxChange := math.abs(bias - oldBias)

        for j = 0 to p - 1
            float oldW = array.get(weights, j)
            float grad = array.get(dw, j) / n + l2Lambda * oldW
            array.set(weights, j, oldW - learningRate * grad)
            maxChange := math.max(maxChange, math.abs(array.get(weights, j) - oldW))

        iter += 1
        converged := maxChange < tol

    // Calculate accuracy
    int correct = 0
    for i = 0 to n - 1
        float z = bias
        for j = 0 to p - 1
            z += array.get(weights, j) * matrix.get(X, i, j)
        int pred = sigmoid(z) >= 0.5 ? 1 : 0
        if pred == array.get(y, i)
            correct += 1

    float accuracy = float(correct) / math.max(1, n)

    LogisticRegressionModel.new(weights, bias, accuracy, iter)

// @function Predicts probabilities using logistic regression
// @param model The fitted LogisticRegressionModel
// @param X Feature matrix
// @returns Array of probabilities
export predictProbaLogistic(LogisticRegressionModel model, matrix<float> X) =>
    int n = matrix.rows(X)
    int p = matrix.columns(X)
    array<float> probs = array.new<float>(n)

    for i = 0 to n - 1
        float z = model.intercept
        for j = 0 to p - 1
            z += array.get(model.coefficients, j) * matrix.get(X, i, j)
        array.set(probs, i, sigmoid(z))
    probs

// @function Predicts classes using logistic regression
// @param model The fitted LogisticRegressionModel
// @param X Feature matrix
// @param threshold Classification threshold (default 0.5)
// @returns Array of predicted classes
export predictLogistic(LogisticRegressionModel model, matrix<float> X, float threshold = 0.5) =>
    array<float> probs = predictProbaLogistic(model, X)
    int n = array.size(probs)
    array<int> predictions = array.new<int>(n)
    for i = 0 to n - 1
        array.set(predictions, i, array.get(probs, i) >= threshold ? 1 : 0)
    predictions

// ==============================================================================
// SECTION 12: LINEAR SVM (Support Vector Machine)
// ==============================================================================

// @type Linear SVM model container
export type LinearSVMModel
    array<float> weights
    float bias
    float C
    int iterations

// @function Fits Linear SVM using SGD with hinge loss
// @param X Feature matrix (samples x features)
// @param y Binary labels (-1 or 1)
// @param C Regularization parameter (inverse of lambda)
// @param learningRate Learning rate
// @param maxIter Maximum iterations
// @returns LinearSVMModel with weights
export fitLinearSVM(matrix<float> X, array<int> y, float C = 1.0, float learningRate = 0.01, int maxIter = 1000) =>
    int n = matrix.rows(X)
    int p = matrix.columns(X)

    // Initialize weights
    array<float> w = array.new<float>(p, 0.0)
    float b = 0.0

    float lambda = 1.0 / C

    for iter = 0 to maxIter - 1
        // Use decaying learning rate
        float lr = learningRate / (1.0 + lambda * iter)

        for i = 0 to n - 1
            float yi = float(array.get(y, i))

            // Compute decision value
            float decision = b
            for j = 0 to p - 1
                decision += array.get(w, j) * matrix.get(X, i, j)

            // Hinge loss gradient
            if yi * decision < 1.0
                // Misclassified or within margin
                for j = 0 to p - 1
                    float wj = array.get(w, j)
                    array.set(w, j, wj - lr * (lambda * wj - yi * matrix.get(X, i, j)))
                b += lr * yi
            else
                // Correctly classified outside margin
                for j = 0 to p - 1
                    float wj = array.get(w, j)
                    array.set(w, j, wj - lr * lambda * wj)

    LinearSVMModel.new(w, b, C, maxIter)

// @function Predicts classes using Linear SVM
// @param model The fitted LinearSVMModel
// @param X Feature matrix
// @returns Array of predicted classes (-1 or 1)
export predictSVM(LinearSVMModel model, matrix<float> X) =>
    int n = matrix.rows(X)
    int p = matrix.columns(X)
    array<int> predictions = array.new<int>(n)

    for i = 0 to n - 1
        float decision = model.bias
        for j = 0 to p - 1
            decision += array.get(model.weights, j) * matrix.get(X, i, j)
        array.set(predictions, i, decision >= 0 ? 1 : -1)
    predictions

// @function Gets decision values (distance from hyperplane)
// @param model The fitted LinearSVMModel
// @param X Feature matrix
// @returns Array of decision values
export decisionFunctionSVM(LinearSVMModel model, matrix<float> X) =>
    int n = matrix.rows(X)
    int p = matrix.columns(X)
    array<float> decisions = array.new<float>(n)

    for i = 0 to n - 1
        float decision = model.bias
        for j = 0 to p - 1
            decision += array.get(model.weights, j) * matrix.get(X, i, j)
        array.set(decisions, i, decision)
    decisions

// ==============================================================================
// SECTION 13: RECURSIVE LEAST SQUARES (RLS) - Online Learning
// ==============================================================================

// @type RLS state container
export type RLSState
    array<float> weights
    matrix<float> P
    float lambda
    int nFeatures

// @function Initializes RLS state
// @param nFeatures Number of features
// @param lambda Forgetting factor (0.9 to 1.0)
// @param delta Initial P matrix scale
// @returns RLSState initialized for online learning
export initRLS(int nFeatures, float lambda = 0.99, float delta = 100.0) =>
    array<float> weights = array.new<float>(nFeatures, 0.0)
    matrix<float> P = matrix.new<float>(nFeatures, nFeatures, 0.0)
    for i = 0 to nFeatures - 1
        P.set(i, i, delta)
    RLSState.new(weights, P, lambda, nFeatures)

// @function Updates RLS with a new observation
// @param state Current RLSState
// @param x Feature array
// @param y Target value
// @returns Updated RLSState and prediction error
export updateRLS(RLSState state, array<float> x, float y) =>
    int n = state.nFeatures

    // Compute a priori prediction
    float yPred = 0.0
    for i = 0 to n - 1
        yPred += array.get(state.weights, i) * array.get(x, i)

    float error = y - yPred

    // Compute gain vector: k = P * x / (lambda + x' * P * x)
    array<float> Px = array.new<float>(n, 0.0)
    for i = 0 to n - 1
        for j = 0 to n - 1
            array.set(Px, i, array.get(Px, i) + matrix.get(state.P, i, j) * array.get(x, j))

    float xPx = 0.0
    for i = 0 to n - 1
        xPx += array.get(x, i) * array.get(Px, i)

    float denom = state.lambda + xPx
    array<float> k = array.new<float>(n)
    for i = 0 to n - 1
        array.set(k, i, denom > 1e-10 ? array.get(Px, i) / denom : 0.0)

    // Update weights
    for i = 0 to n - 1
        array.set(state.weights, i, array.get(state.weights, i) + array.get(k, i) * error)

    // Update P matrix: P = (P - k * x' * P) / lambda
    matrix<float> newP = matrix.new<float>(n, n)
    for i = 0 to n - 1
        for j = 0 to n - 1
            float kxP = array.get(k, i) * array.get(Px, j)
            float newVal = (matrix.get(state.P, i, j) - kxP) / state.lambda
            newP.set(i, j, newVal)

    RLSState newState = RLSState.new(state.weights, newP, state.lambda, n)
    [newState, error]

// @function Predicts using RLS model
// @param state RLSState
// @param x Feature array
// @returns Predicted value
export predictRLS(RLSState state, array<float> x) =>
    float pred = 0.0
    for i = 0 to state.nFeatures - 1
        pred += array.get(state.weights, i) * array.get(x, i)
    pred

// ==============================================================================
// SECTION 14: COVARIANCE AND CORRELATION
// ==============================================================================

// @function Computes the covariance matrix of a feature matrix
// @param X Feature matrix (samples x features)
// @param ddof Delta degrees of freedom (0 for population, 1 for sample)
// @returns Covariance matrix (features x features)
export covarianceMatrix(matrix<float> X, int ddof = 1) =>
    int n = matrix.rows(X)
    int p = matrix.columns(X)
    array<float> means = columnMeans(X)

    matrix<float> centered = matrix.new<float>(n, p)
    for row = 0 to n - 1
        for col = 0 to p - 1
            centered.set(row, col, matrix.get(X, row, col) - array.get(means, col))

    matrix<float> Xt = matrix.transpose(centered)
    matrix<float> cov = matrix.mult(Xt, centered)
    int divisor = math.max(1, n - ddof)
    matrix.mult(cov, 1.0 / divisor)

// @function Computes the correlation matrix of a feature matrix
// @param X Feature matrix (samples x features)
// @returns Correlation matrix (features x features)
export correlationMatrix(matrix<float> X) =>
    int p = matrix.columns(X)
    matrix<float> cov = covarianceMatrix(X, 1)
    matrix<float> corr = matrix.new<float>(p, p)

    array<float> stds = array.new<float>(p)
    for i = 0 to p - 1
        array.set(stds, i, math.sqrt(math.max(0.0, matrix.get(cov, i, i))))

    for i = 0 to p - 1
        for j = 0 to p - 1
            float std_i = array.get(stds, i)
            float std_j = array.get(stds, j)
            float correlation = 0.0
            if std_i > 1e-10 and std_j > 1e-10
                correlation := matrix.get(cov, i, j) / (std_i * std_j)
            corr.set(i, j, math.max(-1.0, math.min(1.0, correlation)))
    corr

// @function Computes pairwise correlation between two arrays
// @param x First array
// @param y Second array
// @returns Pearson correlation coefficient
export pearsonCorrelation(array<float> x, array<float> y) =>
    int n = math.min(array.size(x), array.size(y))
    if n == 0
        0.0
    else
        float meanX = array.avg(x)
        float meanY = array.avg(y)

        float sumXY = 0.0
        float sumX2 = 0.0
        float sumY2 = 0.0

        for i = 0 to n - 1
            float dx = array.get(x, i) - meanX
            float dy = array.get(y, i) - meanY
            sumXY += dx * dy
            sumX2 += dx * dx
            sumY2 += dy * dy

        float denom = math.sqrt(sumX2 * sumY2)
        denom > 1e-10 ? math.max(-1.0, math.min(1.0, sumXY / denom)) : 0.0

// @function Computes Spearman rank correlation
// @param x First array
// @param y Second array
// @returns Spearman correlation coefficient
export spearmanCorrelation(array<float> x, array<float> y) =>
    int n = math.min(array.size(x), array.size(y))
    if n == 0
        0.0
    else
        // Compute ranks for x
        array<float> rankX = array.new<float>(n)
        for i = 0 to n - 1
            int rank = 1
            for j = 0 to n - 1
                if array.get(x, j) < array.get(x, i)
                    rank += 1
            array.set(rankX, i, float(rank))

        // Compute ranks for y
        array<float> rankY = array.new<float>(n)
        for i = 0 to n - 1
            int rank = 1
            for j = 0 to n - 1
                if array.get(y, j) < array.get(y, i)
                    rank += 1
            array.set(rankY, i, float(rank))

        pearsonCorrelation(rankX, rankY)

// @function Computes rolling correlation
// @param x First array
// @param y Second array
// @param window Window size
// @returns Array of rolling correlations
export rollingCorrelation(array<float> x, array<float> y, int window) =>
    int n = math.min(array.size(x), array.size(y))
    array<float> result = array.new<float>(n, 0.0)

    for i = window - 1 to n - 1
        array<float> xWindow = array.new<float>(window)
        array<float> yWindow = array.new<float>(window)
        for j = 0 to window - 1
            array.set(xWindow, j, array.get(x, i - window + 1 + j))
            array.set(yWindow, j, array.get(y, i - window + 1 + j))
        array.set(result, i, pearsonCorrelation(xWindow, yWindow))
    result

// ==============================================================================
// SECTION 15: PRINCIPAL COMPONENT ANALYSIS (PCA)
// ==============================================================================

// @type PCA model container
export type PCAModel
    matrix<float> components
    array<float> explainedVariance
    array<float> explainedVarianceRatio
    array<float> mean
    array<float> std
    int nComponents

// @function Fits a PCA model using eigendecomposition of covariance matrix
// @param X Feature matrix (samples x features)
// @param nComponents Number of components to keep (0 = all)
// @returns PCAModel with components and explained variance
export fitPCA(matrix<float> X, int nComponents = 0) =>
    int n = matrix.rows(X)
    int p = matrix.columns(X)
    int numComponents = nComponents > 0 ? math.min(nComponents, p) : p

    array<float> means = columnMeans(X)
    array<float> stds = columnStdDev(X)

    matrix<float> centered = matrix.new<float>(n, p)
    for row = 0 to n - 1
        for col = 0 to p - 1
            float std = array.get(stds, col)
            float val = matrix.get(X, row, col) - array.get(means, col)
            centered.set(row, col, std > 1e-10 ? val / std : val)

    matrix<float> cov = covarianceMatrix(centered, 0)

    array<float> eigenvalues = matrix.eigenvalues(cov)
    matrix<float> eigenvectors = matrix.eigenvectors(cov)

    matrix<float> components = matrix.new<float>(p, numComponents)
    array<float> explainedVariance = array.new<float>(numComponents)

    float totalVariance = 0.0
    for i = 0 to p - 1
        totalVariance += math.max(0.0, array.get(eigenvalues, i))

    for i = 0 to numComponents - 1
        float eigenval = math.max(0.0, array.get(eigenvalues, i))
        array.set(explainedVariance, i, eigenval)
        for j = 0 to p - 1
            components.set(j, i, matrix.get(eigenvectors, j, i))

    array<float> explainedVarianceRatio = array.new<float>(numComponents)
    for i = 0 to numComponents - 1
        float ratio = totalVariance > 1e-10 ? array.get(explainedVariance, i) / totalVariance : 0.0
        array.set(explainedVarianceRatio, i, ratio)

    PCAModel.new(components, explainedVariance, explainedVarianceRatio, means, stds, numComponents)

// @function Transforms data using a fitted PCA model
// @param model The fitted PCAModel
// @param X Feature matrix to transform
// @returns Transformed matrix (samples x nComponents)
export transformPCA(PCAModel model, matrix<float> X) =>
    int n = matrix.rows(X)
    int p = matrix.columns(X)

    matrix<float> centered = matrix.new<float>(n, p)
    for row = 0 to n - 1
        for col = 0 to p - 1
            float std = array.get(model.std, col)
            float val = matrix.get(X, row, col) - array.get(model.mean, col)
            centered.set(row, col, std > 1e-10 ? val / std : val)

    matrix.mult(centered, model.components)

// @function Inverse transforms PCA-reduced data back to original space
// @param model The fitted PCAModel
// @param X_transformed Transformed matrix (samples x nComponents)
// @returns Reconstructed matrix in original feature space
export inversePCA(PCAModel model, matrix<float> X_transformed) =>
    int n = matrix.rows(X_transformed)
    int p = matrix.rows(model.components)

    matrix<float> componentsT = matrix.transpose(model.components)
    matrix<float> reconstructed = matrix.mult(X_transformed, componentsT)

    for row = 0 to n - 1
        for col = 0 to p - 1
            float std = array.get(model.std, col)
            float val = matrix.get(reconstructed, row, col) * std + array.get(model.mean, col)
            reconstructed.set(row, col, val)
    reconstructed

// ==============================================================================
// SECTION 16: K-MEANS CLUSTERING
// ==============================================================================

// @type K-Means model container
export type KMeansModel
    matrix<float> centroids
    array<int> labels
    float inertia
    int iterations
    int k

// @function Fits K-Means clustering
// @param X Feature matrix (samples x features)
// @param k Number of clusters
// @param maxIter Maximum iterations
// @param tol Convergence tolerance
// @returns KMeansModel with centroids and labels
export fitKMeans(matrix<float> X, int k, int maxIter = 100, float tol = 0.0001) =>
    int n = matrix.rows(X)
    int p = matrix.columns(X)

    // Initialize centroids using K-Means++ style (spread out)
    matrix<float> centroids = matrix.new<float>(k, p)

    // First centroid: random point
    for j = 0 to p - 1
        centroids.set(0, j, matrix.get(X, 0, j))

    // Subsequent centroids: furthest from existing
    for c = 1 to k - 1
        float maxMinDist = -1.0
        int bestIdx = c
        for i = 0 to n - 1
            float minDist = 1e10
            for prevC = 0 to c - 1
                float dist = 0.0
                for j = 0 to p - 1
                    float diff = matrix.get(X, i, j) - matrix.get(centroids, prevC, j)
                    dist += diff * diff
                minDist := math.min(minDist, dist)
            if minDist > maxMinDist
                maxMinDist := minDist
                bestIdx := i
        for j = 0 to p - 1
            centroids.set(c, j, matrix.get(X, bestIdx, j))

    array<int> labels = array.new<int>(n, 0)
    int iter = 0
    bool converged = false

    while iter < maxIter and not converged
        // Assign points to nearest centroid
        for i = 0 to n - 1
            float minDist = 1e10
            int minCluster = 0
            for c = 0 to k - 1
                float dist = 0.0
                for j = 0 to p - 1
                    float diff = matrix.get(X, i, j) - matrix.get(centroids, c, j)
                    dist += diff * diff
                if dist < minDist
                    minDist := dist
                    minCluster := c
            array.set(labels, i, minCluster)

        // Update centroids
        matrix<float> newCentroids = matrix.new<float>(k, p, 0.0)
        array<int> counts = array.new<int>(k, 0)

        for i = 0 to n - 1
            int c = array.get(labels, i)
            array.set(counts, c, array.get(counts, c) + 1)
            for j = 0 to p - 1
                newCentroids.set(c, j, matrix.get(newCentroids, c, j) + matrix.get(X, i, j))

        for c = 0 to k - 1
            int count = array.get(counts, c)
            if count > 0
                for j = 0 to p - 1
                    newCentroids.set(c, j, matrix.get(newCentroids, c, j) / count)
            else
                // Keep old centroid if no points assigned
                for j = 0 to p - 1
                    newCentroids.set(c, j, matrix.get(centroids, c, j))

        // Check convergence
        float maxChange = 0.0
        for c = 0 to k - 1
            for j = 0 to p - 1
                maxChange := math.max(maxChange, math.abs(matrix.get(newCentroids, c, j) - matrix.get(centroids, c, j)))

        centroids := newCentroids
        iter += 1
        converged := maxChange < tol

    // Calculate inertia (sum of squared distances to centroids)
    float inertia = 0.0
    for i = 0 to n - 1
        int c = array.get(labels, i)
        for j = 0 to p - 1
            float diff = matrix.get(X, i, j) - matrix.get(centroids, c, j)
            inertia += diff * diff

    KMeansModel.new(centroids, labels, inertia, iter, k)

// @function Predicts cluster labels for new data
// @param model The fitted KMeansModel
// @param X Feature matrix
// @returns Array of cluster labels
export predictKMeans(KMeansModel model, matrix<float> X) =>
    int n = matrix.rows(X)
    int p = matrix.columns(X)
    array<int> labels = array.new<int>(n)

    for i = 0 to n - 1
        float minDist = 1e10
        int minCluster = 0
        for c = 0 to model.k - 1
            float dist = 0.0
            for j = 0 to p - 1
                float diff = matrix.get(X, i, j) - matrix.get(model.centroids, c, j)
                dist += diff * diff
            if dist < minDist
                minDist := dist
                minCluster := c
        array.set(labels, i, minCluster)
    labels

// @function Computes silhouette score for clustering quality
// @param X Feature matrix
// @param labels Cluster labels
// @returns Average silhouette score (-1 to 1, higher is better)
export silhouetteScore(matrix<float> X, array<int> labels) =>
    int n = matrix.rows(X)
    int p = matrix.columns(X)

    if n < 2
        0.0
    else
        float totalScore = 0.0

        for i = 0 to n - 1
            int ci = array.get(labels, i)

            // Compute a(i): mean distance to same cluster
            float sumSame = 0.0
            int countSame = 0
            for j = 0 to n - 1
                if i != j and array.get(labels, j) == ci
                    float dist = 0.0
                    for k = 0 to p - 1
                        float diff = matrix.get(X, i, k) - matrix.get(X, j, k)
                        dist += diff * diff
                    sumSame += math.sqrt(dist)
                    countSame += 1
            float a = countSame > 0 ? sumSame / countSame : 0.0

            // Compute b(i): min mean distance to other clusters
            float b = 1e10
            int maxCluster = 0
            for j = 0 to n - 1
                maxCluster := math.max(maxCluster, array.get(labels, j))

            for c = 0 to maxCluster
                if c != ci
                    float sumOther = 0.0
                    int countOther = 0
                    for j = 0 to n - 1
                        if array.get(labels, j) == c
                            float dist = 0.0
                            for k = 0 to p - 1
                                float diff = matrix.get(X, i, k) - matrix.get(X, j, k)
                                dist += diff * diff
                            sumOther += math.sqrt(dist)
                            countOther += 1
                    if countOther > 0
                        b := math.min(b, sumOther / countOther)

            // Silhouette for point i
            float maxAB = math.max(a, b)
            float si = maxAB > 1e-10 ? (b - a) / maxAB : 0.0
            totalScore += si

        totalScore / n

// ==============================================================================
// SECTION 17: GAUSSIAN MIXTURE MODEL (GMM)
// ==============================================================================

// @type GMM model container
export type GMMModel
    matrix<float> means
    array<float> variances  // Diagonal variances stored as flat array [k * p], indexed as c * p + j
    array<float> weights
    int k
    int iterations
    int features  // Number of features (p) needed to index variances

// @function Fits Gaussian Mixture Model using EM algorithm (simplified diagonal covariance)
// @param X Feature matrix (samples x features)
// @param k Number of components
// @param maxIter Maximum iterations
// @param tol Convergence tolerance
// @returns GMMModel with means and diagonal variances
export fitGMM(matrix<float> X, int k, int maxIter = 100, float tol = 0.0001) =>
    int n = matrix.rows(X)
    int p = matrix.columns(X)

    // Initialize with K-Means
    KMeansModel km = fitKMeans(X, k, 10)
    matrix<float> means = km.centroids.copy()

    // Initialize weights uniformly
    array<float> weights = array.new<float>(k, 1.0 / k)

    // Initialize diagonal variances
    array<float> variances = array.new<float>(k * p, 1.0)
    for c = 0 to k - 1
        for j = 0 to p - 1
            float sumSq = 0.0
            int count = 0
            for i = 0 to n - 1
                if array.get(km.labels, i) == c
                    float diff = matrix.get(X, i, j) - matrix.get(means, c, j)
                    sumSq += diff * diff
                    count += 1
            float variance = count > 1 ? sumSq / count : 1.0
            array.set(variances, c * p + j, math.max(1e-6, variance))

    // Responsibility matrix
    matrix<float> resp = matrix.new<float>(n, k)

    int iter = 0
    float prevLogLik = -1e10
    bool converged = false

    while iter < maxIter and not converged
        // E-step: compute responsibilities
        for i = 0 to n - 1
            float sumProb = 0.0
            for c = 0 to k - 1
                float logProb = math.log(math.max(1e-10, array.get(weights, c)))
                for j = 0 to p - 1
                    float variance = array.get(variances, c * p + j)
                    float diff = matrix.get(X, i, j) - matrix.get(means, c, j)
                    logProb -= 0.5 * math.log(2 * math.pi * variance)
                    logProb -= 0.5 * diff * diff / variance
                float prob = math.exp(math.max(-700, logProb))
                resp.set(i, c, prob)
                sumProb += prob

            // Normalize
            for c = 0 to k - 1
                resp.set(i, c, sumProb > 1e-10 ? matrix.get(resp, i, c) / sumProb : 1.0 / k)

        // M-step: update parameters
        for c = 0 to k - 1
            float Nc = 0.0
            for i = 0 to n - 1
                Nc += matrix.get(resp, i, c)

            array.set(weights, c, Nc / n)

            // Update means
            for j = 0 to p - 1
                float sumWeighted = 0.0
                for i = 0 to n - 1
                    sumWeighted += matrix.get(resp, i, c) * matrix.get(X, i, j)
                means.set(c, j, Nc > 1e-10 ? sumWeighted / Nc : matrix.get(means, c, j))

            // Update variances
            for j = 0 to p - 1
                float sumSq = 0.0
                for i = 0 to n - 1
                    float diff = matrix.get(X, i, j) - matrix.get(means, c, j)
                    sumSq += matrix.get(resp, i, c) * diff * diff
                array.set(variances, c * p + j, math.max(1e-6, Nc > 1e-10 ? sumSq / Nc : 1.0))

        // Compute log likelihood
        float logLik = 0.0
        for i = 0 to n - 1
            float sumProb = 0.0
            for c = 0 to k - 1
                float logProb = math.log(math.max(1e-10, array.get(weights, c)))
                for j = 0 to p - 1
                    float variance = array.get(variances, c * p + j)
                    float diff = matrix.get(X, i, j) - matrix.get(means, c, j)
                    logProb -= 0.5 * math.log(2 * math.pi * variance)
                    logProb -= 0.5 * diff * diff / variance
                sumProb += math.exp(math.max(-700, logProb))
            logLik += math.log(math.max(1e-10, sumProb))

        converged := math.abs(logLik - prevLogLik) < tol
        prevLogLik := logLik
        iter += 1

    GMMModel.new(means, variances, weights, k, iter, p)

// @function Predicts cluster probabilities using GMM
// @param model The fitted GMMModel
// @param X Feature matrix
// @returns Matrix of cluster probabilities (samples x k)
export predictProbaGMM(GMMModel model, matrix<float> X) =>
    int n = matrix.rows(X)
    int p = model.features
    matrix<float> probs = matrix.new<float>(n, model.k)

    for i = 0 to n - 1
        float sumProb = 0.0
        for c = 0 to model.k - 1
            float logProb = math.log(math.max(1e-10, array.get(model.weights, c)))
            for j = 0 to p - 1
                float variance = array.get(model.variances, c * p + j)
                float diff = matrix.get(X, i, j) - matrix.get(model.means, c, j)
                logProb -= 0.5 * math.log(2 * math.pi * variance)
                logProb -= 0.5 * diff * diff / variance
            float prob = math.exp(math.max(-700, logProb))
            probs.set(i, c, prob)
            sumProb += prob

        for c = 0 to model.k - 1
            probs.set(i, c, sumProb > 1e-10 ? matrix.get(probs, i, c) / sumProb : 1.0 / model.k)

    probs

// @function Predicts cluster labels using GMM
// @param model The fitted GMMModel
// @param X Feature matrix
// @returns Array of cluster labels
export predictGMM(GMMModel model, matrix<float> X) =>
    matrix<float> probs = predictProbaGMM(model, X)
    int n = matrix.rows(X)
    array<int> labels = array.new<int>(n)

    for i = 0 to n - 1
        int bestC = 0
        float bestProb = matrix.get(probs, i, 0)
        for c = 1 to model.k - 1
            if matrix.get(probs, i, c) > bestProb
                bestProb := matrix.get(probs, i, c)
                bestC := c
        array.set(labels, i, bestC)

    labels

// ==============================================================================
// SECTION 18: KALMAN FILTER
// ==============================================================================

// @type Kalman filter state container
export type KalmanState
    matrix<float> x
    matrix<float> P
    matrix<float> F
    matrix<float> H
    matrix<float> Q
    matrix<float> R

// @function Creates a simple 1D Kalman filter for price smoothing
// @param processNoise Process noise variance (Q)
// @param measurementNoise Measurement noise variance (R)
// @param initialEstimate Initial state estimate
// @param initialError Initial error covariance
// @returns KalmanState initialized for 1D filtering
export createKalman1D(float processNoise, float measurementNoise, float initialEstimate, float initialError) =>
    matrix<float> x = matrix.new<float>(1, 1, initialEstimate)
    matrix<float> P = matrix.new<float>(1, 1, initialError)
    matrix<float> F = matrix.new<float>(1, 1, 1.0)
    matrix<float> H = matrix.new<float>(1, 1, 1.0)
    matrix<float> Q = matrix.new<float>(1, 1, processNoise)
    matrix<float> R = matrix.new<float>(1, 1, measurementNoise)
    KalmanState.new(x, P, F, H, Q, R)

// @function Creates a 2D Kalman filter (position + velocity)
// @param processNoise Process noise variance
// @param measurementNoise Measurement noise variance
// @param dt Time step
// @returns KalmanState for 2D tracking
export createKalman2D(float processNoise, float measurementNoise, float dt = 1.0) =>
    matrix<float> x = matrix.new<float>(2, 1, 0.0)
    matrix<float> P = matrix.new<float>(2, 2)
    P.set(0, 0, 1.0)
    P.set(1, 1, 1.0)

    matrix<float> F = matrix.new<float>(2, 2)
    F.set(0, 0, 1.0)
    F.set(0, 1, dt)
    F.set(1, 0, 0.0)
    F.set(1, 1, 1.0)

    matrix<float> H = matrix.new<float>(1, 2)
    H.set(0, 0, 1.0)
    H.set(0, 1, 0.0)

    matrix<float> Q = matrix.new<float>(2, 2)
    Q.set(0, 0, processNoise * dt * dt * dt * dt / 4.0)
    Q.set(0, 1, processNoise * dt * dt * dt / 2.0)
    Q.set(1, 0, processNoise * dt * dt * dt / 2.0)
    Q.set(1, 1, processNoise * dt * dt)

    matrix<float> R = matrix.new<float>(1, 1, measurementNoise)

    KalmanState.new(x, P, F, H, Q, R)

// @function Performs Kalman filter prediction step
// @param state The current KalmanState
// @returns Updated KalmanState after prediction
export kalmanPredict(KalmanState state) =>
    matrix<float> x_pred = matrix.mult(state.F, state.x)
    matrix<float> FP = matrix.mult(state.F, state.P)
    matrix<float> Ft = matrix.transpose(state.F)
    matrix<float> FPFt = matrix.mult(FP, Ft)
    matrix<float> P_pred = matrix.sum(FPFt, state.Q)
    KalmanState.new(x_pred, P_pred, state.F, state.H, state.Q, state.R)

// @function Performs Kalman filter update step with measurement
// @param state The current KalmanState (after prediction)
// @param measurement The observed measurement
// @returns Updated KalmanState after incorporating measurement
export kalmanUpdate(KalmanState state, float measurement) =>
    int stateDim = matrix.rows(state.x)

    matrix<float> z = matrix.new<float>(1, 1, measurement)
    matrix<float> Hx = matrix.mult(state.H, state.x)
    matrix<float> y = matrix.diff(z, Hx)

    matrix<float> HP = matrix.mult(state.H, state.P)
    matrix<float> Ht = matrix.transpose(state.H)
    matrix<float> HPHt = matrix.mult(HP, Ht)
    matrix<float> S = matrix.sum(HPHt, state.R)

    matrix<float> PHt = matrix.mult(state.P, Ht)
    matrix<float> S_inv = matrix.pinv(S)
    matrix<float> K = matrix.mult(PHt, S_inv)

    matrix<float> Ky = matrix.mult(K, y)
    matrix<float> x_new = matrix.sum(state.x, Ky)

    matrix<float> KH = matrix.mult(K, state.H)
    matrix<float> I = identity(stateDim)
    matrix<float> IKH = matrix.diff(I, KH)
    matrix<float> P_new = matrix.mult(IKH, state.P)

    KalmanState.new(x_new, P_new, state.F, state.H, state.Q, state.R)

// @function Performs complete Kalman filter step (predict + update)
// @param state The current KalmanState
// @param measurement The observed measurement
// @returns Updated KalmanState
export kalmanStep(KalmanState state, float measurement) =>
    KalmanState predicted = kalmanPredict(state)
    kalmanUpdate(predicted, measurement)

// @function Gets the current state estimate from Kalman filter
// @param state The KalmanState
// @returns Array of state values
export kalmanGetState(KalmanState state) =>
    int n = matrix.rows(state.x)
    array<float> result = array.new<float>(n)
    for i = 0 to n - 1
        array.set(result, i, matrix.get(state.x, i, 0))
    result

// ==============================================================================
// SECTION 19: K-NEAREST NEIGHBORS (KNN)
// ==============================================================================

// @function Calculates Euclidean distance between two points
// @param p1 First point (array)
// @param p2 Second point (array)
// @returns Euclidean distance
export euclideanDistance(array<float> p1, array<float> p2) =>
    int n = math.min(array.size(p1), array.size(p2))
    float sumSq = 0.0
    for i = 0 to n - 1
        float diff = array.get(p1, i) - array.get(p2, i)
        sumSq += diff * diff
    math.sqrt(sumSq)

// @function Calculates Manhattan distance between two points
// @param p1 First point (array)
// @param p2 Second point (array)
// @returns Manhattan distance
export manhattanDistance(array<float> p1, array<float> p2) =>
    int n = math.min(array.size(p1), array.size(p2))
    float sumAbs = 0.0
    for i = 0 to n - 1
        sumAbs += math.abs(array.get(p1, i) - array.get(p2, i))
    sumAbs

// @function Calculates cosine distance between two points
// @param p1 First point (array)
// @param p2 Second point (array)
// @returns Cosine distance (1 - cosine similarity)
export cosineDistance(array<float> p1, array<float> p2) =>
    int n = math.min(array.size(p1), array.size(p2))
    float dot = 0.0
    float norm1 = 0.0
    float norm2 = 0.0
    for i = 0 to n - 1
        float v1 = array.get(p1, i)
        float v2 = array.get(p2, i)
        dot += v1 * v2
        norm1 += v1 * v1
        norm2 += v2 * v2
    float denom = math.sqrt(norm1) * math.sqrt(norm2)
    denom > 1e-10 ? 1.0 - dot / denom : 1.0

// @function Computes distance matrix between all points in two datasets
// @param X1 First dataset (samples1 x features)
// @param X2 Second dataset (samples2 x features)
// @returns Distance matrix (samples1 x samples2)
export distanceMatrix(matrix<float> X1, matrix<float> X2) =>
    int n1 = matrix.rows(X1)
    int n2 = matrix.rows(X2)
    matrix<float> distances = matrix.new<float>(n1, n2)

    for i = 0 to n1 - 1
        array<float> p1 = matrix.row(X1, i)
        for j = 0 to n2 - 1
            array<float> p2 = matrix.row(X2, j)
            distances.set(i, j, euclideanDistance(p1, p2))
    distances

// @type KNN model container
export type KNNModel
    matrix<float> X_train
    array<int> y_train
    int k
    int nClasses

// @function Creates a KNN classifier model
// @param X_train Training feature matrix
// @param y_train Training labels (integer class labels)
// @param k Number of neighbors
// @returns KNNModel ready for prediction
export createKNN(matrix<float> X_train, array<int> y_train, int k) =>
    int maxClass = 0
    for i = 0 to array.size(y_train) - 1
        maxClass := math.max(maxClass, array.get(y_train, i))
    KNNModel.new(X_train, y_train, k, maxClass + 1)

// @function Predicts class for a single sample using KNN
// @param model The KNNModel
// @param sample Feature array for the sample to classify
// @returns Predicted class label
export predictKNNSingle(KNNModel model, array<float> sample) =>
    int n = matrix.rows(model.X_train)

    array<float> distances = array.new<float>(n)
    array<int> indices = array.new<int>(n)

    for i = 0 to n - 1
        array<float> trainPoint = matrix.row(model.X_train, i)
        array.set(distances, i, euclideanDistance(sample, trainPoint))
        array.set(indices, i, i)

    // Partial sort to find k smallest
    for i = 0 to math.min(model.k - 1, n - 1)
        for j = i + 1 to n - 1
            if array.get(distances, j) < array.get(distances, i)
                float tempDist = array.get(distances, i)
                int tempIdx = array.get(indices, i)
                array.set(distances, i, array.get(distances, j))
                array.set(indices, i, array.get(indices, j))
                array.set(distances, j, tempDist)
                array.set(indices, j, tempIdx)

    array<int> votes = array.new<int>(model.nClasses, 0)
    for i = 0 to math.min(model.k - 1, n - 1)
        int idx = array.get(indices, i)
        int label = array.get(model.y_train, idx)
        if label >= 0 and label < model.nClasses
            array.set(votes, label, array.get(votes, label) + 1)

    int maxVotes = 0
    int predictedClass = 0
    for c = 0 to model.nClasses - 1
        if array.get(votes, c) > maxVotes
            maxVotes := array.get(votes, c)
            predictedClass := c

    predictedClass

// @function Predicts classes for multiple samples using KNN
// @param model The KNNModel
// @param X Feature matrix for samples to classify
// @returns Array of predicted class labels
export predictKNN(KNNModel model, matrix<float> X) =>
    int n = matrix.rows(X)
    array<int> predictions = array.new<int>(n)

    for i = 0 to n - 1
        array<float> sample = matrix.row(X, i)
        array.set(predictions, i, predictKNNSingle(model, sample))
    predictions

// @function KNN regression - predicts continuous value using weighted average
// @param model The KNNModel
// @param sample Feature array for the sample
// @param y_values Array of actual float values
// @returns Predicted value
export predictKNNRegression(KNNModel model, array<float> sample, array<float> y_values) =>
    int n = matrix.rows(model.X_train)

    array<float> distances = array.new<float>(n)
    array<int> indices = array.new<int>(n)

    for i = 0 to n - 1
        array<float> trainPoint = matrix.row(model.X_train, i)
        array.set(distances, i, euclideanDistance(sample, trainPoint))
        array.set(indices, i, i)

    for i = 0 to math.min(model.k - 1, n - 1)
        for j = i + 1 to n - 1
            if array.get(distances, j) < array.get(distances, i)
                float tempDist = array.get(distances, i)
                int tempIdx = array.get(indices, i)
                array.set(distances, i, array.get(distances, j))
                array.set(indices, i, array.get(indices, j))
                array.set(distances, j, tempDist)
                array.set(indices, j, tempIdx)

    float weightSum = 0.0
    float valueSum = 0.0
    for i = 0 to math.min(model.k - 1, n - 1)
        int idx = array.get(indices, i)
        float dist = array.get(distances, i)
        float weight = dist > 1e-10 ? 1.0 / dist : 1000.0
        weightSum += weight
        valueSum += weight * array.get(y_values, idx)

    weightSum > 0 ? valueSum / weightSum : 0.0

// ==============================================================================
// SECTION 20: NEURAL NETWORK (FEEDFORWARD)
// ==============================================================================

// @type Neural network layer
export type NNLayer
    matrix<float> weights
    array<float> biases
    string activation

// @type Simple feedforward neural network
export type NeuralNetwork
    array<NNLayer> layers

// @function Creates a neural network layer with Xavier initialization
// @param inputSize Number of inputs
// @param outputSize Number of outputs (neurons)
// @param activation Activation function name
// @param seed Random seed for reproducibility
// @returns NNLayer initialized with Xavier weights
export createLayer(int inputSize, int outputSize, string activation = "relu", int seed = 0) =>
    matrix<float> weights = matrix.new<float>(inputSize, outputSize)
    array<float> biases = array.new<float>(outputSize, 0.0)

    float scale = math.sqrt(2.0 / (inputSize + outputSize))

    for i = 0 to inputSize - 1
        for j = 0 to outputSize - 1
            float val = math.sin(float(i * outputSize + j + seed) * 12.9898) * 43758.5453
            val := val - math.floor(val)
            weights.set(i, j, (val - 0.5) * 2.0 * scale)

    NNLayer.new(weights, biases, activation)

// @function Creates a layer with custom weights (for loading pre-trained)
// @param weights Weight matrix
// @param biases Bias array
// @param activation Activation function name
// @returns NNLayer with specified weights
export createLayerWithWeights(matrix<float> weights, array<float> biases, string activation) =>
    NNLayer.new(weights.copy(), array.copy(biases), activation)

// @function Forward pass through a single layer
// @param layer The NNLayer
// @param inputMat Input matrix (samples x inputSize)
// @returns Output matrix (samples x outputSize)
export forwardLayer(NNLayer layer, matrix<float> inputMat) =>
    int n = matrix.rows(inputMat)
    int outputSize = matrix.columns(layer.weights)

    matrix<float> linear = matrix.mult(inputMat, layer.weights)

    for row = 0 to n - 1
        for col = 0 to outputSize - 1
            float val = matrix.get(linear, row, col) + array.get(layer.biases, col)
            linear.set(row, col, val)

    matrix<float> output = switch layer.activation
        "relu" => reluMatrix(linear)
        "sigmoid" => sigmoidMatrix(linear)
        "tanh" => tanhMatrix(linear)
        "softmax" => softmaxMatrix(linear)
        "elu" => eluMatrix(linear)
        "swish" => swishMatrix(linear)
        "gelu" => geluMatrix(linear)
        "leaky_relu" => leakyReluMatrix(linear)
        => linear

    output

// @function Creates a simple neural network from layer specifications
// @param layerSizes Array of layer sizes [input, hidden1, hidden2, ..., output]
// @param activations Array of activation functions for each layer transition
// @returns NeuralNetwork ready for forward pass
export createNeuralNetwork(array<int> layerSizes, array<string> activations) =>
    int numLayers = array.size(layerSizes) - 1
    array<NNLayer> layers = array.new<NNLayer>()

    for i = 0 to numLayers - 1
        int inputSize = array.get(layerSizes, i)
        int outputSize = array.get(layerSizes, i + 1)
        string activation = array.get(activations, i)
        NNLayer layer = createLayer(inputSize, outputSize, activation, i * 1000)
        array.push(layers, layer)

    NeuralNetwork.new(layers)

// @function Forward pass through entire network
// @param nn The NeuralNetwork
// @param inputMat Input matrix (samples x inputFeatures)
// @returns Output matrix (samples x outputSize)
export forwardNetwork(NeuralNetwork nn, matrix<float> inputMat) =>
    matrix<float> current = inputMat.copy()

    for i = 0 to array.size(nn.layers) - 1
        NNLayer layer = array.get(nn.layers, i)
        current := forwardLayer(layer, current)

    current

// @function Gets network prediction for single sample
// @param nn The NeuralNetwork
// @param sample Input feature array
// @returns Output array
export predictNN(NeuralNetwork nn, array<float> sample) =>
    matrix<float> inputMat = matrix.new<float>(1, array.size(sample))
    for i = 0 to array.size(sample) - 1
        inputMat.set(0, i, array.get(sample, i))

    matrix<float> output = forwardNetwork(nn, inputMat)
    matrix.row(output, 0)

// @function Gets class prediction (argmax) for classification
// @param nn The NeuralNetwork
// @param sample Input feature array
// @returns Predicted class index
export predictNNClass(NeuralNetwork nn, array<float> sample) =>
    array<float> output = predictNN(nn, sample)
    int maxIdx = 0
    float maxVal = array.get(output, 0)
    for i = 1 to array.size(output) - 1
        if array.get(output, i) > maxVal
            maxVal := array.get(output, i)
            maxIdx := i
    maxIdx

// ==============================================================================
// SECTION 21: NAIVE BAYES CLASSIFIER
// ==============================================================================

// @type Gaussian Naive Bayes model
export type GaussianNBModel
    array<float> classPriors
    matrix<float> means
    matrix<float> variances
    int nClasses
    int nFeatures

// @function Fits a Gaussian Naive Bayes classifier
// @param X Training feature matrix (samples x features)
// @param y Training labels (integer class labels 0 to nClasses-1)
// @returns GaussianNBModel fitted to the data
export fitGaussianNB(matrix<float> X, array<int> y) =>
    int n = matrix.rows(X)
    int p = matrix.columns(X)

    int nClasses = 0
    for i = 0 to n - 1
        nClasses := math.max(nClasses, array.get(y, i) + 1)

    array<int> classCounts = array.new<int>(nClasses, 0)
    for i = 0 to n - 1
        int c = array.get(y, i)
        if c >= 0 and c < nClasses
            array.set(classCounts, c, array.get(classCounts, c) + 1)

    array<float> priors = array.new<float>(nClasses)
    for c = 0 to nClasses - 1
        array.set(priors, c, float(array.get(classCounts, c)) / math.max(1, n))

    matrix<float> means = matrix.new<float>(nClasses, p, 0.0)
    for i = 0 to n - 1
        int c = array.get(y, i)
        if c >= 0 and c < nClasses
            for j = 0 to p - 1
                float current = matrix.get(means, c, j)
                matrix.set(means, c, j, current + matrix.get(X, i, j))

    for c = 0 to nClasses - 1
        int count = array.get(classCounts, c)
        if count > 0
            for j = 0 to p - 1
                matrix.set(means, c, j, matrix.get(means, c, j) / count)

    matrix<float> variances = matrix.new<float>(nClasses, p, 0.0)
    for i = 0 to n - 1
        int c = array.get(y, i)
        if c >= 0 and c < nClasses
            for j = 0 to p - 1
                float diff = matrix.get(X, i, j) - matrix.get(means, c, j)
                float current = matrix.get(variances, c, j)
                matrix.set(variances, c, j, current + diff * diff)

    for c = 0 to nClasses - 1
        int count = array.get(classCounts, c)
        if count > 0
            for j = 0 to p - 1
                float variance = matrix.get(variances, c, j) / count + 1e-9
                matrix.set(variances, c, j, variance)

    GaussianNBModel.new(priors, means, variances, nClasses, p)

// @function Calculates log probability density of Gaussian
// @param x Input value
// @param mean Distribution mean
// @param variance Distribution variance
// @returns Log probability density
export gaussianLogPdf(float x, float mean, float variance) =>
    float diff = x - mean
    -0.5 * math.log(2 * math.pi * variance) - (diff * diff) / (2 * variance)

// @function Predicts class probabilities for a single sample
// @param model The GaussianNBModel
// @param sample Feature array
// @returns Array of class probabilities
export predictProbaNB(GaussianNBModel model, array<float> sample) =>
    array<float> logProbs = array.new<float>(model.nClasses)

    for c = 0 to model.nClasses - 1
        float logProb = math.log(math.max(1e-10, array.get(model.classPriors, c)))
        for j = 0 to model.nFeatures - 1
            float x = array.get(sample, j)
            float mean = matrix.get(model.means, c, j)
            float variance = matrix.get(model.variances, c, j)
            logProb += gaussianLogPdf(x, mean, variance)
        array.set(logProbs, c, logProb)

    softmax(logProbs)

// @function Predicts class for a single sample
// @param model The GaussianNBModel
// @param sample Feature array
// @returns Predicted class label
export predictNB(GaussianNBModel model, array<float> sample) =>
    array<float> probs = predictProbaNB(model, sample)
    int maxIdx = 0
    float maxProb = array.get(probs, 0)
    for i = 1 to model.nClasses - 1
        if array.get(probs, i) > maxProb
            maxProb := array.get(probs, i)
            maxIdx := i
    maxIdx

// @function Predicts classes for multiple samples
// @param model The GaussianNBModel
// @param X Feature matrix
// @returns Array of predicted class labels
export predictNBBatch(GaussianNBModel model, matrix<float> X) =>
    int n = matrix.rows(X)
    array<int> predictions = array.new<int>(n)

    for i = 0 to n - 1
        array<float> sample = matrix.row(X, i)
        array.set(predictions, i, predictNB(model, sample))
    predictions

// ==============================================================================
// SECTION 22: ANOMALY DETECTION
// ==============================================================================

// @type Anomaly detection model using Z-score
export type ZScoreAnomalyModel
    array<float> means
    array<float> stds
    float threshold

// @function Fits Z-score anomaly detector
// @param X Training data matrix
// @param threshold Number of standard deviations for anomaly (default 3.0)
// @returns ZScoreAnomalyModel
export fitZScoreAnomaly(matrix<float> X, float threshold = 3.0) =>
    array<float> means = columnMeans(X)
    array<float> stds = columnStdDev(X)
    ZScoreAnomalyModel.new(means, stds, threshold)

// @function Detects anomalies using Z-score
// @param model The ZScoreAnomalyModel
// @param X Data to check
// @returns Array of booleans (true = anomaly)
export detectZScoreAnomalies(ZScoreAnomalyModel model, matrix<float> X) =>
    int n = matrix.rows(X)
    int p = matrix.columns(X)
    array<bool> anomalies = array.new<bool>(n, false)

    for i = 0 to n - 1
        for j = 0 to p - 1
            float val = matrix.get(X, i, j)
            float mean = array.get(model.means, j)
            float std = array.get(model.stds, j)
            float zScore = std > 1e-10 ? math.abs((val - mean) / std) : 0.0
            if zScore > model.threshold
                array.set(anomalies, i, true)
                break
    anomalies

// @function Computes anomaly score for a single sample
// @param model The ZScoreAnomalyModel
// @param sample Feature array
// @returns Maximum Z-score across all features
export anomalyScore(ZScoreAnomalyModel model, array<float> sample) =>
    int p = array.size(sample)
    float maxZScore = 0.0
    for j = 0 to p - 1
        float val = array.get(sample, j)
        float mean = array.get(model.means, j)
        float std = array.get(model.stds, j)
        float zScore = std > 1e-10 ? math.abs((val - mean) / std) : 0.0
        maxZScore := math.max(maxZScore, zScore)
    maxZScore

// @type IQR-based anomaly detector
export type IQRAnomalyModel
    array<float> q1
    array<float> q3
    array<float> iqr
    float multiplier

// @function Fits IQR anomaly detector
// @param X Training data matrix
// @param multiplier IQR multiplier (default 1.5)
// @returns IQRAnomalyModel
export fitIQRAnomaly(matrix<float> X, float multiplier = 1.5) =>
    int n = matrix.rows(X)
    int p = matrix.columns(X)

    array<float> q1 = array.new<float>(p)
    array<float> q3 = array.new<float>(p)
    array<float> iqr = array.new<float>(p)

    for j = 0 to p - 1
        array<float> col = matrix.col(X, j)
        array.sort(col)
        int q1Idx = int(n * 0.25)
        int q3Idx = int(n * 0.75)
        float q1Val = array.get(col, q1Idx)
        float q3Val = array.get(col, q3Idx)
        array.set(q1, j, q1Val)
        array.set(q3, j, q3Val)
        array.set(iqr, j, q3Val - q1Val)

    IQRAnomalyModel.new(q1, q3, iqr, multiplier)

// @function Detects anomalies using IQR method
// @param model The IQRAnomalyModel
// @param X Data to check
// @returns Array of booleans (true = anomaly)
export detectIQRAnomalies(IQRAnomalyModel model, matrix<float> X) =>
    int n = matrix.rows(X)
    int p = matrix.columns(X)
    array<bool> anomalies = array.new<bool>(n, false)

    for i = 0 to n - 1
        for j = 0 to p - 1
            float val = matrix.get(X, i, j)
            float q1Val = array.get(model.q1, j)
            float q3Val = array.get(model.q3, j)
            float iqrVal = array.get(model.iqr, j)
            float lower = q1Val - model.multiplier * iqrVal
            float upper = q3Val + model.multiplier * iqrVal
            if val < lower or val > upper
                array.set(anomalies, i, true)
                break
    anomalies

// ==============================================================================
// SECTION 23: TIME SERIES - DYNAMIC TIME WARPING (DTW)
// ==============================================================================

// @function Computes Dynamic Time Warping distance between two series
// @param s1 First time series
// @param s2 Second time series
// @returns DTW distance
export dtwDistance(array<float> s1, array<float> s2) =>
    int n = array.size(s1)
    int m = array.size(s2)

    matrix<float> dtw = matrix.new<float>(n + 1, m + 1, 1e10)
    dtw.set(0, 0, 0.0)

    for i = 1 to n
        for j = 1 to m
            float cost = math.abs(array.get(s1, i - 1) - array.get(s2, j - 1))
            float minPrev = math.min(matrix.get(dtw, i - 1, j),
                           math.min(matrix.get(dtw, i, j - 1),
                                   matrix.get(dtw, i - 1, j - 1)))
            dtw.set(i, j, cost + minPrev)

    matrix.get(dtw, n, m)

// @function Finds the most similar pattern in history using DTW
// @param current Current pattern (array)
// @param history Matrix of historical patterns (patterns x length)
// @returns Index of most similar pattern
export findSimilarPatternDTW(array<float> current, matrix<float> history) =>
    int nPatterns = matrix.rows(history)
    float minDist = 1e10
    int bestIdx = 0

    for i = 0 to nPatterns - 1
        array<float> pattern = matrix.row(history, i)
        float dist = dtwDistance(current, pattern)
        if dist < minDist
            minDist := dist
            bestIdx := i

    bestIdx

// ==============================================================================
// SECTION 24: MARKOV CHAIN / REGIME DETECTION
// ==============================================================================

// @type Markov Chain model
export type MarkovChainModel
    matrix<float> transitionMatrix
    array<float> stationaryDist
    int nStates

// @function Fits a Markov Chain from state sequence
// @param states Array of state observations (integers 0 to nStates-1)
// @param nStates Number of possible states
// @returns MarkovChainModel with transition probabilities
export fitMarkovChain(array<int> states, int nStates) =>
    int n = array.size(states)

    // Count transitions
    matrix<float> counts = matrix.new<float>(nStates, nStates, 0.0)
    for i = 0 to n - 2
        int from = array.get(states, i)
        int to1 = array.get(states, i + 1)
        if from >= 0 and from < nStates and to1 >= 0 and to1 < nStates
            counts.set(from, to1, matrix.get(counts, from, to1) + 1.0)

    // Convert to probabilities
    matrix<float> transitionMatrix = matrix.new<float>(nStates, nStates, 0.0)
    for i = 0 to nStates - 1
        float rowSum = 0.0
        for j = 0 to nStates - 1
            rowSum += matrix.get(counts, i, j)
        for j = 0 to nStates - 1
            if rowSum > 0
                transitionMatrix.set(i, j, matrix.get(counts, i, j) / rowSum)
            else
                transitionMatrix.set(i, j, 1.0 / nStates)

    // Compute stationary distribution (power iteration)
    array<float> dist = array.new<float>(nStates, 1.0 / nStates)
    for iter = 0 to 99
        array<float> newDist = array.new<float>(nStates, 0.0)
        for j = 0 to nStates - 1
            for i = 0 to nStates - 1
                array.set(newDist, j, array.get(newDist, j) + array.get(dist, i) * matrix.get(transitionMatrix, i, j))
        dist := newDist

    MarkovChainModel.new(transitionMatrix, dist, nStates)

// @function Predicts next state probabilities
// @param model The MarkovChainModel
// @param currentState Current state
// @returns Array of probabilities for each next state
export predictNextState(MarkovChainModel model, int currentState) =>
    array<float> probs = array.new<float>(model.nStates)
    if currentState >= 0 and currentState < model.nStates
        for j = 0 to model.nStates - 1
            array.set(probs, j, matrix.get(model.transitionMatrix, currentState, j))
    else
        for j = 0 to model.nStates - 1
            array.set(probs, j, 1.0 / model.nStates)
    probs

// @function Classifies market regime based on returns
// @param returns Array of returns
// @param nRegimes Number of regimes (default 3: bear, neutral, bull)
// @returns Array of regime labels
export classifyRegimes(array<float> returns, int nRegimes = 3) =>
    int n = array.size(returns)
    array<int> regimes = array.new<int>(n)

    // Sort returns to find percentile thresholds
    array<float> sorted = array.copy(returns)
    array.sort(sorted)

    array<float> thresholds = array.new<float>(nRegimes - 1)
    for i = 0 to nRegimes - 2
        int idx = int((i + 1) * n / nRegimes)
        array.set(thresholds, i, array.get(sorted, math.min(idx, n - 1)))

    // Classify each return
    for i = 0 to n - 1
        float ret = array.get(returns, i)
        int regime = nRegimes - 1
        for t = 0 to nRegimes - 2
            if ret <= array.get(thresholds, t)
                regime := t
                break
        array.set(regimes, i, regime)

    regimes

// ==============================================================================
// SECTION 25: HIDDEN MARKOV MODEL (Simple)
// ==============================================================================

// @type Simple HMM model
export type HMMModel
    matrix<float> transitionMatrix
    matrix<float> emissionMeans
    matrix<float> emissionVariances
    array<float> initialProbs
    int nStates

// @function Fits a simple HMM using EM (Baum-Welch simplified)
// @param observations Array of observations
// @param nStates Number of hidden states
// @param maxIter Maximum iterations
// @returns HMMModel with parameters
export fitHMM(array<float> observations, int nStates, int maxIter = 50) =>
    int n = array.size(observations)

    // Initialize parameters
    matrix<float> trans = matrix.new<float>(nStates, nStates)
    for i = 0 to nStates - 1
        for j = 0 to nStates - 1
            trans.set(i, j, 1.0 / nStates)

    // Initialize emission means using k-means style
    array<float> sortedObs = array.copy(observations)
    array.sort(sortedObs)
    matrix<float> means = matrix.new<float>(nStates, 1)
    matrix<float> vars = matrix.new<float>(nStates, 1, 1.0)
    for s = 0 to nStates - 1
        int idx = int((s + 0.5) * n / nStates)
        means.set(s, 0, array.get(sortedObs, math.min(idx, n - 1)))

    array<float> initProbs = array.new<float>(nStates, 1.0 / nStates)

    // Simplified Baum-Welch iterations
    for iter = 0 to maxIter - 1
        // Forward-backward would go here for full implementation
        // Simplified: assign states based on closest mean
        array<int> stateAssign = array.new<int>(n)
        for i = 0 to n - 1
            float obs = array.get(observations, i)
            int bestState = 0
            float bestDist = 1e10
            for s = 0 to nStates - 1
                float dist = math.abs(obs - matrix.get(means, s, 0))
                if dist < bestDist
                    bestDist := dist
                    bestState := s
            array.set(stateAssign, i, bestState)

        // Update means and variances
        for s = 0 to nStates - 1
            float sumObs = 0.0
            int count = 0
            for i = 0 to n - 1
                if array.get(stateAssign, i) == s
                    sumObs += array.get(observations, i)
                    count += 1
            if count > 0
                float newMean = sumObs / count
                means.set(s, 0, newMean)

                float sumSq = 0.0
                for i = 0 to n - 1
                    if array.get(stateAssign, i) == s
                        float diff = array.get(observations, i) - newMean
                        sumSq += diff * diff
                vars.set(s, 0, math.max(1e-6, sumSq / count))

        // Update transitions
        for i = 0 to nStates - 1
            for j = 0 to nStates - 1
                int transCount = 0
                int fromCount = 0
                for t = 0 to n - 2
                    if array.get(stateAssign, t) == i
                        fromCount += 1
                        if array.get(stateAssign, t + 1) == j
                            transCount += 1
                trans.set(i, j, fromCount > 0 ? float(transCount) / fromCount : 1.0 / nStates)

    HMMModel.new(trans, means, vars, initProbs, nStates)

// @function Predicts most likely state for observation
// @param model The HMMModel
// @param observation Current observation
// @returns Most likely state
export predictHMMState(HMMModel model, float observation) =>
    int bestState = 0
    float bestProb = -1e10

    for s = 0 to model.nStates - 1
        float mean = matrix.get(model.emissionMeans, s, 0)
        float variance = matrix.get(model.emissionVariances, s, 0)
        float logProb = gaussianLogPdf(observation, mean, variance) + math.log(array.get(model.initialProbs, s))
        if logProb > bestProb
            bestProb := logProb
            bestState := s

    bestState

// ==============================================================================
// SECTION 26: EXPONENTIAL SMOOTHING & HOLT-WINTERS
// ==============================================================================

// @type Exponential Smoothing State
export type ExpSmoothingState
    float level
    float trend
    float alpha
    float beta

// @function Creates and updates single exponential smoothing
// @param value Current value
// @param alpha Smoothing factor (0-1)
// @param prevSmooth Previous smoothed value
// @returns New smoothed value
export exponentialSmooth(float value, float alpha, float prevSmooth) =>
    alpha * value + (1.0 - alpha) * prevSmooth

// @function Creates and updates double exponential smoothing (Holt's method)
// @param value Current value
// @param state Previous ExpSmoothingState
// @returns Updated ExpSmoothingState
export holtSmooth(float value, ExpSmoothingState state) =>
    float newLevel = state.alpha * value + (1.0 - state.alpha) * (state.level + state.trend)
    float newTrend = state.beta * (newLevel - state.level) + (1.0 - state.beta) * state.trend
    ExpSmoothingState.new(newLevel, newTrend, state.alpha, state.beta)

// @function Forecasts using Holt's method
// @param state Current ExpSmoothingState
// @param steps Number of steps ahead
// @returns Forecast value
export holtForecast(ExpSmoothingState state, int steps) =>
    state.level + steps * state.trend

// @function Initializes Holt's smoothing state
// @param initialLevel Initial level
// @param initialTrend Initial trend
// @param alpha Level smoothing factor
// @param beta Trend smoothing factor
// @returns ExpSmoothingState
export initHolt(float initialLevel, float initialTrend, float alpha, float beta) =>
    ExpSmoothingState.new(initialLevel, initialTrend, alpha, beta)

// ==============================================================================
// SECTION 27: ENTROPY AND INFORMATION THEORY
// ==============================================================================

// @function Computes Shannon entropy of a probability distribution
// @param probs Array of probabilities (should sum to 1)
// @returns Entropy in bits
export shannonEntropy(array<float> probs) =>
    float entropy = 0.0
    int n = array.size(probs)
    for i = 0 to n - 1
        float p = array.get(probs, i)
        if p > 1e-10
            entropy -= p * math.log(p) / math.log(2)
    entropy

// @function Computes entropy of a data series (binned)
// @param data Array of values
// @param nBins Number of bins for discretization
// @returns Entropy in bits
export dataEntropy(array<float> data, int nBins = 10) =>
    int n = array.size(data)
    if n == 0
        0.0
    else
        float minVal = array.min(data)
        float maxVal = array.max(data)
        float range4 = maxVal - minVal

        array<int> counts = array.new<int>(nBins, 0)
        for i = 0 to n - 1
            float val = array.get(data, i)
            int bin = range4 > 1e-10 ? int((val - minVal) / range4 * (nBins - 1)) : 0
            bin := math.max(0, math.min(nBins - 1, bin))
            array.set(counts, bin, array.get(counts, bin) + 1)

        array<float> probs = array.new<float>(nBins)
        for i = 0 to nBins - 1
            array.set(probs, i, float(array.get(counts, i)) / n)

        shannonEntropy(probs)

// @function Computes permutation entropy for complexity analysis
// @param data Array of values
// @param order Embedding dimension (default 3)
// @param delay Embedding delay (default 1)
// @returns Normalized permutation entropy (0-1)
export permutationEntropy(array<float> data, int order = 3, int delay = 1) =>
    int n = array.size(data)
    int nFactorial = 1
    for i = 2 to order
        nFactorial *= i

    array<int> counts = array.new<int>(nFactorial, 0)
    int nPatterns = n - (order - 1) * delay

    if nPatterns <= 0
        0.0
    else
        for i = 0 to nPatterns - 1
            // Extract pattern and get permutation rank
            array<float> pattern = array.new<float>(order)
            for j = 0 to order - 1
                array.set(pattern, j, array.get(data, i + j * delay))

            // Simple ranking: count inversions
            int rank = 0
            int mult = 1
            for j = order - 1 to 1
                int smaller = 0
                for k = j - 1 to 0
                    if array.get(pattern, k) < array.get(pattern, j)
                        smaller += 1
                rank += smaller * mult
                mult *= (order - j + 1)

            rank := math.max(0, math.min(nFactorial - 1, rank))
            array.set(counts, rank, array.get(counts, rank) + 1)

        // Convert to probabilities and compute entropy
        array<float> probs = array.new<float>(nFactorial)
        for i = 0 to nFactorial - 1
            array.set(probs, i, float(array.get(counts, i)) / nPatterns)

        float entropy = shannonEntropy(probs)
        float maxEntropy = math.log(nFactorial) / math.log(2)
        maxEntropy > 0 ? entropy / maxEntropy : 0.0

// ==============================================================================
// SECTION 28: HURST EXPONENT
// ==============================================================================

// @function Estimates Hurst exponent using R/S analysis
// @param data Array of values
// @param minWindow Minimum window size (default 10)
// @returns Hurst exponent (0.5 = random walk, >0.5 = trending, <0.5 = mean reverting)
export hurstExponent(array<float> data, int minWindow = 10) =>
    int n = array.size(data)
    if n < minWindow * 2
        0.5
    else
        // Calculate log(R/S) vs log(n) for different window sizes
        array<float> logN = array.new<float>()
        array<float> logRS = array.new<float>()

        int windowSize = minWindow
        while windowSize <= n / 2
            float sumRS = 0.0
            int count = 0

            int i = 0
            while i + windowSize <= n
                // Calculate mean for this window
                float mean = 0.0
                for j = i to i + windowSize - 1
                    mean += array.get(data, j)
                mean /= windowSize

                // Calculate cumulative deviations
                float maxCumDev = -1e10
                float minCumDev = 1e10
                float cumDev = 0.0
                float sumSq = 0.0

                for j = i to i + windowSize - 1
                    float dev = array.get(data, j) - mean
                    cumDev += dev
                    sumSq += dev * dev
                    maxCumDev := math.max(maxCumDev, cumDev)
                    minCumDev := math.min(minCumDev, cumDev)

                float R = maxCumDev - minCumDev
                float S = math.sqrt(sumSq / windowSize)

                if S > 1e-10
                    sumRS += R / S
                    count += 1

                i += windowSize

            if count > 0
                array.push(logN, math.log(windowSize))
                array.push(logRS, math.log(sumRS / count))

            windowSize *= 2

        // Linear regression to get Hurst exponent
        int nPoints = array.size(logN)
        if nPoints < 2
            0.5
        else
            LinearRegressionModel model = fitSimpleLinearRegression(logN, logRS)
            math.max(0.0, math.min(1.0, array.get(model.coefficients, 0)))

// ==============================================================================
// SECTION 29: CHANGE DETECTION (CUSUM)
// ==============================================================================

// @type CUSUM state
export type CUSUMState
    float cumSum
    float posSum
    float negSum
    float threshold
    float drift
    float mean
    bool changeDetected

// @function Initializes CUSUM change detector
// @param threshold Detection threshold
// @param drift Allowable drift (target change to detect)
// @param initialMean Initial expected mean
// @returns CUSUMState
export initCUSUM(float threshold = 5.0, float drift = 0.5, float initialMean = 0.0) =>
    CUSUMState.new(0.0, 0.0, 0.0, threshold, drift, initialMean, false)

// @function Updates CUSUM with new observation
// @param state Current CUSUMState
// @param value New observation
// @returns Updated CUSUMState
export updateCUSUM(CUSUMState state, float value) =>
    float deviation = value - state.mean

    // Two-sided CUSUM
    float newPosSum = math.max(0.0, state.posSum + deviation - state.drift)
    float newNegSum = math.max(0.0, state.negSum - deviation - state.drift)

    bool detected = newPosSum > state.threshold or newNegSum > state.threshold

    // Reset if change detected
    if detected
        CUSUMState.new(0.0, 0.0, 0.0, state.threshold, state.drift, value, true)
    else
        CUSUMState.new(state.cumSum + deviation, newPosSum, newNegSum, state.threshold, state.drift, state.mean, false)

// @function Detects change points in a series
// @param data Array of values
// @param threshold Detection threshold
// @param drift Allowable drift
// @returns Array of change point indices
export detectChangePoints(array<float> data, float threshold = 5.0, float drift = 0.5) =>
    int n = array.size(data)
    array<int> changePoints = array.new<int>()

    if n > 0
        float mean = array.get(data, 0)
        CUSUMState state = initCUSUM(threshold, drift, mean)

        for i = 0 to n - 1
            state := updateCUSUM(state, array.get(data, i))
            if state.changeDetected
                array.push(changePoints, i)

    changePoints

// ==============================================================================
// SECTION 30: AUTOCORRELATION
// ==============================================================================

// @function Computes autocorrelation at a specific lag
// @param data Array of values
// @param lag Lag to compute autocorrelation for
// @returns Autocorrelation coefficient
export autocorrelation(array<float> data, int lag) =>
    int n = array.size(data)
    if n <= lag or lag < 0
        0.0
    else
        float mean = array.avg(data)
        float c0 = 0.0
        for i = 0 to n - 1
            c0 += math.pow(array.get(data, i) - mean, 2)

        if c0 < 1e-10
            0.0
        else
            float cLag = 0.0
            for i = 0 to n - lag - 1
                cLag += (array.get(data, i) - mean) * (array.get(data, i + lag) - mean)
            cLag / c0

// @function Computes autocorrelation function up to maxLag
// @param data Array of values
// @param maxLag Maximum lag to compute
// @returns Array of autocorrelation values for lags 0 to maxLag
export acf(array<float> data, int maxLag) =>
    array<float> result = array.new<float>(maxLag + 1)
    for lag = 0 to maxLag
        array.set(result, lag, autocorrelation(data, lag))
    result

// @function Computes partial autocorrelation using Durbin-Levinson
// @param data Array of values
// @param maxLag Maximum lag to compute
// @returns Array of partial autocorrelation values
export pacf(array<float> data, int maxLag) =>
    array<float> acfVals = acf(data, maxLag)
    array<float> result = array.new<float>(maxLag + 1, 0.0)

    if array.get(acfVals, 0) > 1e-10
        array.set(result, 0, 1.0)
        array.set(result, 1, array.get(acfVals, 1))

        array<float> phi = array.new<float>(maxLag + 1, 0.0)
        array<float> phiNew = array.new<float>(maxLag + 1, 0.0)
        array.set(phi, 1, array.get(acfVals, 1))

        for k = 2 to maxLag
            // Compute phi_kk
            float num = array.get(acfVals, k)
            float den = 1.0
            for j = 1 to k - 1
                num -= array.get(phi, j) * array.get(acfVals, k - j)
                den -= array.get(phi, j) * array.get(acfVals, j)

            float phiKK = math.abs(den) > 1e-10 ? num / den : 0.0
            array.set(result, k, phiKK)

            // Update phi values
            for j = 1 to k - 1
                array.set(phiNew, j, array.get(phi, j) - phiKK * array.get(phi, k - j))
            array.set(phiNew, k, phiKK)

            for j = 1 to k
                array.set(phi, j, array.get(phiNew, j))

    result

// ==============================================================================
// SECTION 31: ENSEMBLE METHODS
// ==============================================================================

// @function Combines predictions from multiple models using voting
// @param predictions Matrix of predictions (models x samples)
// @param nClasses Number of classes
// @returns Array of final predictions
export majorityVote(matrix<int> predictions, int nClasses) =>
    int nModels = matrix.rows(predictions)
    int nSamples = matrix.columns(predictions)
    array<int> finalPreds = array.new<int>(nSamples)

    for j = 0 to nSamples - 1
        array<int> votes = array.new<int>(nClasses, 0)
        for i = 0 to nModels - 1
            int pred = matrix.get(predictions, i, j)
            if pred >= 0 and pred < nClasses
                array.set(votes, pred, array.get(votes, pred) + 1)

        int maxVotes = 0
        int winner = 0
        for c = 0 to nClasses - 1
            if array.get(votes, c) > maxVotes
                maxVotes := array.get(votes, c)
                winner := c
        array.set(finalPreds, j, winner)

    finalPreds

// @function Combines regression predictions using averaging
// @param predictions Matrix of predictions (models x samples)
// @param weights Optional model weights (default equal weights)
// @returns Array of averaged predictions
export weightedAverage(matrix<float> predictions, array<float> weights) =>
    int nModels = matrix.rows(predictions)
    int nSamples = matrix.columns(predictions)
    array<float> finalPreds = array.new<float>(nSamples, 0.0)

    // Use equal weights if not provided
    array<float> w = array.size(weights) == nModels ? weights : array.new<float>(nModels, 1.0 / nModels)

    for j = 0 to nSamples - 1
        float sum = 0.0
        for i = 0 to nModels - 1
            sum += matrix.get(predictions, i, j) * array.get(w, i)
        array.set(finalPreds, j, sum)

    finalPreds

// @function Simple ensemble averaging without weights
// @param predictions Matrix of predictions (models x samples)
// @returns Array of averaged predictions
export ensembleAverage(matrix<float> predictions) =>
    int nModels = matrix.rows(predictions)
    int nSamples = matrix.columns(predictions)
    array<float> finalPreds = array.new<float>(nSamples, 0.0)

    for j = 0 to nSamples - 1
        float sum = 0.0
        for i = 0 to nModels - 1
            sum += matrix.get(predictions, i, j)
        array.set(finalPreds, j, sum / math.max(1, nModels))

    finalPreds

// ==============================================================================
// SECTION 32: MODEL EVALUATION METRICS
// ==============================================================================

// @function Calculates accuracy score
// @param y_true True labels
// @param y_pred Predicted labels
// @returns Accuracy (0 to 1)
export accuracy(array<int> y_true, array<int> y_pred) =>
    int n = math.min(array.size(y_true), array.size(y_pred))
    int correct = 0
    for i = 0 to n - 1
        if array.get(y_true, i) == array.get(y_pred, i)
            correct += 1
    float(correct) / math.max(1, n)

// @function Calculates Mean Squared Error
// @param y_true True values
// @param y_pred Predicted values
// @returns MSE
export mse(array<float> y_true, array<float> y_pred) =>
    int n = math.min(array.size(y_true), array.size(y_pred))
    float sumSq = 0.0
    for i = 0 to n - 1
        float diff = array.get(y_true, i) - array.get(y_pred, i)
        sumSq += diff * diff
    sumSq / math.max(1, n)

// @function Calculates Root Mean Squared Error
// @param y_true True values
// @param y_pred Predicted values
// @returns RMSE
export rmse(array<float> y_true, array<float> y_pred) =>
    math.sqrt(mse(y_true, y_pred))

// @function Calculates Mean Absolute Error
// @param y_true True values
// @param y_pred Predicted values
// @returns MAE
export mae(array<float> y_true, array<float> y_pred) =>
    int n = math.min(array.size(y_true), array.size(y_pred))
    float sumAbs = 0.0
    for i = 0 to n - 1
        sumAbs += math.abs(array.get(y_true, i) - array.get(y_pred, i))
    sumAbs / math.max(1, n)

// @function Calculates Mean Absolute Percentage Error
// @param y_true True values
// @param y_pred Predicted values
// @returns MAPE as percentage
export mape(array<float> y_true, array<float> y_pred) =>
    int n = math.min(array.size(y_true), array.size(y_pred))
    float sumPct = 0.0
    int validCount = 0
    for i = 0 to n - 1
        float actual = array.get(y_true, i)
        if math.abs(actual) > 1e-10
            sumPct += math.abs((actual - array.get(y_pred, i)) / actual)
            validCount += 1
    validCount > 0 ? sumPct / validCount * 100 : 0.0

// @function Calculates R-squared score
// @param y_true True values
// @param y_pred Predicted values
// @returns R-squared score
export rSquared(array<float> y_true, array<float> y_pred) =>
    int n = math.min(array.size(y_true), array.size(y_pred))
    float meanY = array.avg(y_true)
    float ssRes = 0.0
    float ssTot = 0.0
    for i = 0 to n - 1
        float yi = array.get(y_true, i)
        float pred = array.get(y_pred, i)
        ssRes += math.pow(yi - pred, 2)
        ssTot += math.pow(yi - meanY, 2)
    ssTot > 1e-10 ? 1.0 - ssRes / ssTot : 0.0

// @function Creates a confusion matrix
// @param y_true True labels
// @param y_pred Predicted labels
// @param nClasses Number of classes
// @returns Confusion matrix (true x predicted)
export confusionMatrix(array<int> y_true, array<int> y_pred, int nClasses) =>
    matrix<int> cm = matrix.new<int>(nClasses, nClasses, 0)
    int n = math.min(array.size(y_true), array.size(y_pred))
    for i = 0 to n - 1
        int trueLabel = array.get(y_true, i)
        int predLabel = array.get(y_pred, i)
        if trueLabel >= 0 and trueLabel < nClasses and predLabel >= 0 and predLabel < nClasses
            int current = matrix.get(cm, trueLabel, predLabel)
            matrix.set(cm, trueLabel, predLabel, current + 1)
    cm

// @function Calculates precision for binary classification
// @param y_true True labels (0 or 1)
// @param y_pred Predicted labels (0 or 1)
// @returns Precision score
export precision(array<int> y_true, array<int> y_pred) =>
    int tp = 0
    int fp = 0
    int n = math.min(array.size(y_true), array.size(y_pred))
    for i = 0 to n - 1
        if array.get(y_pred, i) == 1
            if array.get(y_true, i) == 1
                tp += 1
            else
                fp += 1
    tp + fp > 0 ? float(tp) / (tp + fp) : 0.0

// @function Calculates recall for binary classification
// @param y_true True labels (0 or 1)
// @param y_pred Predicted labels (0 or 1)
// @returns Recall score
export recall(array<int> y_true, array<int> y_pred) =>
    int tp = 0
    int fn = 0
    int n = math.min(array.size(y_true), array.size(y_pred))
    for i = 0 to n - 1
        if array.get(y_true, i) == 1
            if array.get(y_pred, i) == 1
                tp += 1
            else
                fn += 1
    tp + fn > 0 ? float(tp) / (tp + fn) : 0.0

// @function Calculates F1 score for binary classification
// @param y_true True labels (0 or 1)
// @param y_pred Predicted labels (0 or 1)
// @returns F1 score
export f1Score(array<int> y_true, array<int> y_pred) =>
    float prec = precision(y_true, y_pred)
    float rec = recall(y_true, y_pred)
    prec + rec > 0 ? 2.0 * prec * rec / (prec + rec) : 0.0

// @function Calculates log loss (cross-entropy)
// @param y_true True labels (0 or 1)
// @param y_pred_proba Predicted probabilities
// @returns Log loss
export logLoss(array<int> y_true, array<float> y_pred_proba) =>
    int n = math.min(array.size(y_true), array.size(y_pred_proba))
    float loss = 0.0
    for i = 0 to n - 1
        float p = math.max(1e-15, math.min(1.0 - 1e-15, array.get(y_pred_proba, i)))
        int y = array.get(y_true, i)
        loss -= y * math.log(p) + (1 - y) * math.log(1 - p)
    loss / math.max(1, n)

// ==============================================================================
// SECTION 33 CROSS-VALIDATION
// ==============================================================================

// @function Generates k-fold cross-validation indices
// @param n Number of samples
// @param k Number of folds
// @returns Array of fold assignments (0 to k-1)
export kFoldSplit(int n, int k) =>
    array<int> folds = array.new<int>(n)
    for i = 0 to n - 1
        array.set(folds, i, i % k)
    folds

// @function Time series cross-validation - expanding window
// @param n Number of samples
// @param minTrain Minimum training size
// @param step Step size for expanding
// @returns Matrix of [train_end, test_end] pairs
export timeSeriesSplit(int n, int minTrain, int step = 1) =>
    int nSplits = math.max(1, (n - minTrain) / step)
    matrix<int> splits = matrix.new<int>(nSplits, 2)
    for i = 0 to nSplits - 1
        int trainEnd = minTrain + i * step
        int testEnd = math.min(trainEnd + step, n)
        splits.set(i, 0, trainEnd)
        splits.set(i, 1, testEnd)
    splits

// ==============================================================================
// SECTION 34: TRADING CONVENIENCE FUNCTIONS
// ==============================================================================

// @function Creates feature matrix from price data for lookback period
// @param length Lookback period
// @returns Matrix with rows [open, high, low, close] for each bar
export priceMatrix(int length) =>
    matrix<float> m = matrix.new<float>(4, length)
    for i = 0 to length - 1
        m.set(0, i, open[length - 1 - i])
        m.set(1, i, high[length - 1 - i])
        m.set(2, i, low[length - 1 - i])
        m.set(3, i, close[length - 1 - i])
    m

// @function Creates returns matrix from price data
// @param length Lookback period
// @returns Array of log returns
export logReturns(int length) =>
    array<float> returns = array.new<float>(length)
    for i = 0 to length - 1
        float ret = close[length - i] > 0 ? math.log(close[length - 1 - i] / close[length - i]) : 0.0
        array.set(returns, i, ret)
    returns

// @function Rolling linear regression slope
// @param src Source series
// @param length Lookback period
// @returns Regression slope
export rollingSlope(float src, int length) =>
    array<float> x = array.new<float>(length)
    array<float> y = array.new<float>(length)
    for i = 0 to length - 1
        array.set(x, i, float(i))
        array.set(y, i, src[length - 1 - i])
    LinearRegressionModel model = fitSimpleLinearRegression(x, y)
    array.get(model.coefficients, 0)

// @function Kalman-filtered price
// @param src Source series
// @param processNoise Process noise (higher = more responsive)
// @param measurementNoise Measurement noise (higher = more smoothing)
// @returns Kalman-filtered value
export kalmanFilter(float src, float processNoise = 0.01, float measurementNoise = 1.0) =>
    var KalmanState state = createKalman1D(processNoise, measurementNoise, src, 1.0)
    state := kalmanStep(state, src)
    matrix.get(state.x, 0, 0)

// @function Kalman-filtered price with velocity estimate
// @param src Source series
// @param processNoise Process noise
// @param measurementNoise Measurement noise
// @returns [filtered_price, velocity]
export kalmanFilter2D(float src, float processNoise = 0.01, float measurementNoise = 1.0) =>
    var KalmanState state = createKalman2D(processNoise, measurementNoise)
    state := kalmanStep(state, src)
    [matrix.get(state.x, 0, 0), matrix.get(state.x, 1, 0)]

// @function Adaptive moving average using Kalman filter
// @param src Source series
// @param sensitivity Sensitivity to changes (0.001 to 0.1)
// @returns Adaptive smoothed value
export adaptiveMA(float src, float sensitivity = 0.01) =>
    var float prevValue = src
    var float prevError = 1.0

    float prediction = prevValue
    float error = prevError + sensitivity
    float gain = error / (error + 1.0)
    float newValue = prediction + gain * (src - prediction)
    float newError = (1.0 - gain) * error

    prevValue := newValue
    prevError := newError
    newValue

// @function Calculates volatility-adjusted momentum
// @param src Source series
// @param length Lookback period
// @returns Volatility-adjusted momentum score
export volAdjMomentum(float src, int length) =>
    float mom = src - src[length]
    float vol = ta.stdev(src, length)
    vol > 0 ? mom / vol : 0.0

// @function Detects support/resistance levels using clustering
// @param length Lookback period
// @param nLevels Number of levels to detect
// @returns Array of support/resistance levels
export detectSRLevels(int length, int nLevels = 3) =>
    matrix<float> pivots = matrix.new<float>(length * 2, 1)
    for i = 0 to length - 1
        pivots.set(i, 0, high[i])
        pivots.set(length + i, 0, low[i])

    KMeansModel km = fitKMeans(pivots, nLevels)

    array<float> levels = array.new<float>(nLevels)
    for i = 0 to nLevels - 1
        array.set(levels, i, matrix.get(km.centroids, i, 0))

    array.sort(levels)
    levels

// @function Multi-timeframe feature builder
// @param src Source value
// @param lengths Array of lookback periods
// @returns Array of features [sma1, sma2, ..., std1, std2, ..., roc1, roc2, ...]
export buildFeatures(float src, array<int> lengths) =>
    int n = array.size(lengths)
    array<float> features = array.new<float>(n * 3)

    for i = 0 to n - 1
        int len = array.get(lengths, i)
        float sma = ta.sma(src, len)
        float std = ta.stdev(src, len)
        float roc = src[len] != 0 ? (src - src[len]) / src[len] * 100 : 0.0

        array.set(features, i, sma)
        array.set(features, n + i, std)
        array.set(features, 2 * n + i, roc)

    features

// @function Generates technical indicator features
// @param length Base period for indicators
// @returns Array of indicator values
export technicalFeatures(int length) =>
    array<float> features = array.new<float>(10)

    // RSI
    array.set(features, 0, ta.rsi(close, length))

    // MACD components
    [macdLine, signalLine, histLine] = ta.macd(close, 12, 26, 9)
    array.set(features, 1, macdLine)
    array.set(features, 2, signalLine)
    array.set(features, 3, histLine)

    // Bollinger Band %B
    float basis = ta.sma(close, length)
    float dev = ta.stdev(close, length)
    float upper = basis + 2 * dev
    float lower = basis - 2 * dev
    float bbPct = upper != lower ? (close - lower) / (upper - lower) : 0.5
    array.set(features, 4, bbPct)

    // ATR percentage
    array.set(features, 5, ta.atr(length) / close * 100)

    // Volume ratio
    array.set(features, 6, volume / ta.sma(volume, length))

    // Price position in range
    float highest = ta.highest(high, length)
    float lowest = ta.lowest(low, length)
    array.set(features, 7, highest != lowest ? (close - lowest) / (highest - lowest) : 0.5)

    // Momentum
    array.set(features, 8, close - close[length])

    // Rate of change
    array.set(features, 9, close[length] != 0 ? (close - close[length]) / close[length] * 100 : 0.0)

    features

// @function Creates lag features for time series
// @param src Source series
// @param lags Array of lag periods
// @returns Array of lagged values
export lagFeatures(float src, array<int> lags) =>
    int n = array.size(lags)
    array<float> features = array.new<float>(n)
    for i = 0 to n - 1
        int lag = array.get(lags, i)
        array.set(features, i, src[lag])
    features

// @function Computes rolling Sharpe ratio
// @param returns Array of returns
// @param riskFreeRate Annualized risk-free rate (default 0)
// @returns Sharpe ratio
export sharpeRatio(array<float> returns, float riskFreeRate = 0.0) =>
    int n = array.size(returns)
    if n == 0
        0.0
    else
        float meanRet = array.avg(returns)
        float stdRet = array.stdev(returns)
        float periodsPerYear = 252.0
        float excessRet = meanRet - riskFreeRate / periodsPerYear
        stdRet > 0 ? excessRet / stdRet * math.sqrt(periodsPerYear) : 0.0

// @function Computes Sortino ratio (downside deviation)
// @param returns Array of returns
// @param riskFreeRate Annualized risk-free rate (default 0)
// @returns Sortino ratio
export sortinoRatio(array<float> returns, float riskFreeRate = 0.0) =>
    int n = array.size(returns)
    if n == 0
        0.0
    else
        float meanRet = array.avg(returns)
        float periodsPerYear = 252.0
        float excessRet = meanRet - riskFreeRate / periodsPerYear

        // Calculate downside deviation
        float sumSqNeg = 0.0
        int negCount = 0
        for i = 0 to n - 1
            float ret = array.get(returns, i)
            if ret < 0
                sumSqNeg += ret * ret
                negCount += 1

        float downDev = negCount > 0 ? math.sqrt(sumSqNeg / negCount) : 0.0
        downDev > 0 ? excessRet / downDev * math.sqrt(periodsPerYear) : 0.0

// @function Computes maximum drawdown from equity curve
// @param equity Array of equity values
// @returns Maximum drawdown as positive percentage
export maxDrawdown(array<float> equity) =>
    int n = array.size(equity)
    if n == 0
        0.0
    else
        float maxDD = 0.0
        float peak = array.get(equity, 0)

        for i = 0 to n - 1
            float val = array.get(equity, i)
            peak := math.max(peak, val)
            float dd = peak > 0 ? (peak - val) / peak : 0.0
            maxDD := math.max(maxDD, dd)

        maxDD * 100

// @function Computes Calmar ratio
// @param returns Array of returns
// @param equity Array of equity values
// @returns Calmar ratio (return / max drawdown)
export calmarRatio(array<float> returns, array<float> equity) =>
    int n = array.size(returns)
    if n == 0
        0.0
    else
        float totalReturn = array.avg(returns) * 252  // Annualized
        float maxDD = maxDrawdown(equity)
        maxDD > 0 ? totalReturn / (maxDD / 100) : 0.0

// @function Kelly Criterion for position sizing
// @param winRate Win probability (0-1)
// @param avgWin Average winning trade
// @param avgLoss Average losing trade (positive value)
// @returns Optimal fraction of capital to risk
export kellyCriterion(float winRate, float avgWin, float avgLoss) =>
    if avgLoss <= 0
        0.0
    else
        float b = avgWin / avgLoss
        float kelly = (winRate * b - (1 - winRate)) / b
        math.max(0.0, kelly)

// @function Fractional Kelly for more conservative sizing
// @param winRate Win probability (0-1)
// @param avgWin Average winning trade
// @param avgLoss Average losing trade (positive value)
// @param fraction Fraction of Kelly to use (default 0.5)
// @returns Position size fraction
export fractionalKelly(float winRate, float avgWin, float avgLoss, float fraction = 0.5) =>
    kellyCriterion(winRate, avgWin, avgLoss) * fraction

// @function Computes rolling beta against benchmark
// @param assetReturns Asset returns array
// @param benchmarkReturns Benchmark returns array
// @returns Beta coefficient
export rollingBeta(array<float> assetReturns, array<float> benchmarkReturns) =>
    int n = math.min(array.size(assetReturns), array.size(benchmarkReturns))
    if n < 2
        1.0
    else
        float meanAsset = array.avg(assetReturns)
        float meanBench = array.avg(benchmarkReturns)

        float cov = 0.0
        float varBench = 0.0
        for i = 0 to n - 1
            float dA = array.get(assetReturns, i) - meanAsset
            float dB = array.get(benchmarkReturns, i) - meanBench
            cov += dA * dB
            varBench += dB * dB

        varBench > 1e-10 ? cov / varBench : 1.0

// @function Estimates fractal dimension using box counting
// @param data Array of price data
// @param nScales Number of scales to use
// @returns Estimated fractal dimension
export fractalDimension(array<float> data, int nScales = 5) =>
    int n = array.size(data)
    if n < 10
        1.5
    else
        float minVal = array.min(data)
        float maxVal = array.max(data)
        float range5 = maxVal - minVal

        if range5 < 1e-10
            1.0
        else
            array<float> logScales = array.new<float>(nScales)
            array<float> logCounts = array.new<float>(nScales)

            for s = 0 to nScales - 1
                int boxSize = int(math.pow(2, s + 1))
                float epsilon = range5 / boxSize

                int count = 0
                int i = 0
                while i < n
                    float localMin = array.get(data, i)
                    float localMax = localMin
                    int j = i
                    while j < math.min(i + boxSize, n)
                        float val = array.get(data, j)
                        localMin := math.min(localMin, val)
                        localMax := math.max(localMax, val)
                        j += 1
                    count += int(math.ceil((localMax - localMin) / epsilon)) + 1
                    i += boxSize

                array.set(logScales, s, math.log(1.0 / epsilon))
                array.set(logCounts, s, math.log(float(count)))

            LinearRegressionModel model = fitSimpleLinearRegression(logScales, logCounts)
            math.max(1.0, math.min(2.0, array.get(model.coefficients, 0)))

// End of MLMatrixLib
