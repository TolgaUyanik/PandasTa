//@version=6
indicator("Trigonometric Sine Cosine Waves", shorttitle="TrigoWaves", overlay=true)

// === INPUT PARAMETERS ===
cycleLength = input.int(20, "Cycle Length", minval=5, maxval=200, tooltip = "5 - 200")
amplitudeMultiplier = input.float(1.0, "Amplitude Multiplier", minval=0.1, maxval=5.0, tooltip = "0.1 - 5")
showSineWave = input.bool(true, "Show Sine Wave")
showCosineWave = input.bool(true, "Show Cosine Wave")
showCorrelation = input.bool(false, "Show Price Correlation Angle")

// === SINE WAVE CALCULATION ===
// Hitung phase berdasarkan bar index dengan kontinuitas yang lebih smooth
phase = 2 * math.pi * bar_index / cycleLength

// Hitung rata-rata harga untuk base line
avgPrice = ta.ema(close, cycleLength)

// Hitung volatility untuk amplitude
volatility = ta.atr(14) * amplitudeMultiplier

// Generate sine and cosine waves
sineWave = avgPrice + volatility * math.sin(phase)
cosineWave = avgPrice + volatility * math.cos(phase)

// === PRICE CORRELATION ANGLE ===
// Hitung sudut antara price movement dan cycle
priceChange = open - open[1]
cycleChange = math.sin(phase) - math.sin(phase[1])

// Hitung correlation angle dalam degrees menggunakan math.atan
// Karena Pine Script tidak memiliki atan2, kita gunakan pendekatan alternatif
correlationAngle = cycleChange != 0 ? math.atan(priceChange / cycleChange) * 180 / math.pi : 0

// === CYCLE ANALYSIS ===
// Deteksi turning points menggunakan sine wave
sineSlope = sineWave - sineWave[1]
isSineBottom = sineSlope > 0 and sineSlope[1] <= 0
isSineTop = sineSlope < 0 and sineSlope[1] >= 0

// === PLOTTING ===
// Plot sine and cosine waves
plot(showSineWave ? sineWave : na, "Sine Wave", color=chart.fg_color, linewidth=2, display = display.pane)
plot(showCosineWave ? cosineWave : na, "Cosine Wave", color=chart.fg_color, linewidth=2, display = display.pane)

// === SIGNALS ===
// Buy/Sell signals berdasarkan sine wave (ANTI-REPAINT VERSION)
// Menggunakan confirmed values dari bar sebelumnya
longCondition = isSineBottom[1]
shortCondition = isSineTop[1]

// Show BUY/SELL signals
plotshape(longCondition, "Buy Signal", shape.labelup, location.belowbar, chart.fg_color, textcolor=chart.bg_color, text="B", size=size.tiny, display = display.pane)
plotshape(shortCondition, "Sell Signal", shape.labeldown, location.abovebar, chart.fg_color, textcolor=chart.bg_color, text="S", size=size.tiny, display = display.pane)

// === TABLE INFO ===
var table infoTable = na
if barstate.islast and showCorrelation
    if na(infoTable)
        infoTable := table.new(position.top_right, 2, 5, bgcolor=chart.bg_color, frame_color = chart.fg_color, frame_width = 2, border_color = chart.fg_color, border_width=1)
        table.cell(infoTable, 0, 0, "Metric", bgcolor=chart.fg_color, text_color=chart.bg_color)
        table.cell(infoTable, 1, 0, "Value", bgcolor=chart.fg_color, text_color=chart.bg_color)
        table.cell(infoTable, 0, 1, "Sine Value", text_color=chart.fg_color)
        table.cell(infoTable, 0, 2, "Cosine Value", text_color=chart.fg_color)
        table.cell(infoTable, 0, 3, "Phase (°)", text_color=chart.fg_color)
        table.cell(infoTable, 0, 4, "Correlation Angle", text_color=chart.fg_color)
    
    // Update table values
    table.cell(infoTable, 1, 1, str.tostring(math.round(math.sin(phase), 3)), text_color=chart.fg_color)
    table.cell(infoTable, 1, 2, str.tostring(math.round(math.cos(phase), 3)), text_color=chart.fg_color)
    table.cell(infoTable, 1, 3, str.tostring(math.round(phase * 180 / math.pi, 1)), text_color=chart.fg_color)
    table.cell(infoTable, 1, 4, str.tostring(math.round(correlationAngle, 1)) + "°", text_color=chart.fg_color)

// === ALERTS ===
alertcondition(longCondition, title="Sine Wave Buy Signal", message="Sine wave bottom detected")
alertcondition(shortCondition, title="Sine Wave Sell Signal", message="Sine wave top detected")

// === BACKGROUND COLOR ===
// Change background based on sine wave position
bgcolor_sine = showSineWave ? (math.sin(phase) > 0 ? color.new(chart.bg_color, 95) : color.new(chart.fg_color, 95)) : na
bgcolor(bgcolor_sine)