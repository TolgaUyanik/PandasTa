//@version=6
strategy(title="HA Trend Change [Modu]", overlay=true, format=format.price,
     initial_capital=5000,
     default_qty_type=strategy.fixed,
     default_qty_value=1,
     calc_on_every_tick=true)

// ============================================================
//  HA Trend Change — Heikin Ashi trend-reversal signal
//
//  Detects a confirmed change in trend direction using Heikin
//  Ashi bars.
//
//  Uptrend confirmation (only when seeking up):
//    - Current bar is an up bar (HA close >= HA open)
//    - At least one prior up bar exists
//    - Current HA close > prior up bar's HA close
//    -> Switches to seeking downtrend
//
//  Downtrend confirmation (only when seeking down):
//    - Current bar is a down bar (HA close < HA open)
//    - At least one prior down bar exists
//    - Current HA close < prior down bar's HA close
//    -> Switches to seeking uptrend
// ============================================================

// --- Heikin Ashi data ---
haTicker                              = ticker.heikinashi(syminfo.tickerid)
[haOpen, haHigh, haLow, haClose]      = request.security(haTicker, timeframe.period, [open, high, low, close])

// --- Bar direction ---
bool isUpBar   = haClose >= haOpen
bool isDownBar = haClose <  haOpen

// --- Persistent state ---
var bool  seekingUp   = false  // currently watching for an upturn
var bool  seekingDown = true   // currently watching for a downturn
var float refUpClose  = na     // HA close of the most recent up bar
var float refDnClose  = na     // HA close of the most recent down bar

// --- Signal flags (store bar_index so only the trigger bar carries the signal) ---
var int  sigUp   = na
var int  sigDown = na

// ============================================================
//  U P T R E N D   D E T E C T I O N
// ============================================================
if seekingUp and isUpBar
    // We already have a reference up bar — compare closes
    if not na(refUpClose) and haClose > refUpClose
        sigUp := bar_index     // uptrend confirmed
    // Update reference to this bar's close for next comparison
    refUpClose := haClose

// ============================================================
//  D O W N T R E N D   D E T E C T I O N
// ============================================================
if seekingDown and isDownBar
    // We already have a reference down bar — compare closes
    if not na(refDnClose) and haClose < refDnClose
        sigDown := bar_index   // downtrend confirmed
    // Update reference
    refDnClose := haClose

// ============================================================
//  S T A T E   T R A N S I T I O N
// ============================================================
// After a confirmed signal, flip direction and reset the
// opposite reference so the first bar in the new regime
// becomes the "first bar" of the sequence.
if sigUp == bar_index
    seekingUp   := false
    seekingDown := true
    refDnClose  := na          // clear so next down bar starts fresh

if sigDown == bar_index
    seekingDown := false
    seekingUp   := true
    refUpClose  := na          // clear so next up bar starts fresh

// ============================================================
//  S T R A T E G Y   E N T R I E S
// ============================================================
if sigUp == bar_index
    strategy.close("Short", comment="Cover")
    strategy.entry("Long", strategy.long, comment="Long")

if sigDown == bar_index
    strategy.close("Long", comment="Exit")
    strategy.entry("Short", strategy.short, comment="Short")

// ============================================================
//  V I S U A L S   &   A L E R T S
// ============================================================
plotshape(sigUp == bar_index,
     style   = shape.triangleup,
     location = location.belowbar,
     color   = color.green,
     size    = size.small,
     text    = "Uptrend")

plotshape(sigDown == bar_index,
     style   = shape.triangledown,
     location = location.abovebar,
     color   = color.red,
     size    = size.small,
     text    = "Downtrend")

alertcondition(sigUp == bar_index,
     title  = "HA Uptrend Confirmed",
     message = "Up")

alertcondition(sigDown == bar_index,
     title  = "HA Downtrend Confirmed",
     message = "Down")
