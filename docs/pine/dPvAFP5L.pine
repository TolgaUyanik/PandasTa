//@version=6
library("GBB_lib_webhook", overlay=false)

//=====================================================================
// GBB-lib-webhook (Pine Script v6)
//=====================================================================

// Internal helper — escapes backslashes and double quotes for JSON safety.
// Must process backslashes first to avoid double-escaping.
escapeStr(string s) =>
    str.replace(str.replace(s, "\\", "\\\\", 0), "\"", "\\\"", 0)

// @function buildPayload
// @description Builds a JSON string containing standard OHLCV market data
//              and a custom action label, ready to be passed to alert().
//              Special characters in `action` and `comment` are automatically
//              escaped so the resulting JSON is always valid.
// @param action  (string) Signal label sent in the payload. Typical values:
//                "BUY", "SELL", "CLOSE". Any string is accepted.
// @param comment (string) Optional free-text field (signal name, setup
//                description, etc.). Defaults to an empty string.
// @returns (string) A JSON object string with the fields: action, ticker,
//          exchange, interval, price, open, high, low, volume, time, comment.
export buildPayload(string action, string comment = "") =>
    '{ "action"   :"' + escapeStr(action) + '", "ticker"   :"{{ticker}}", "exchange" :"{{exchange}}", "interval" :"{{interval}}", "price"    :"{{close}}", "open"     :"{{open}}", "high"     :"{{high}}", "low"      :"{{low}}", "volume"   :"{{volume}}", "time"     :"{{timenow}}", "comment"  :"' + escapeStr(comment) + '" }'

// @function buildPayloadFull
// @description Builds an extended JSON string that includes all standard
//              OHLCV fields plus position-sizing and strategy metadata.
//              Numeric fields (qty, sl, tp) are serialised as JSON numbers
//              when provided, or as JSON null when omitted (na).
//              String fields are escaped to ensure valid JSON output.
// @param action   (string) Signal label. Typical values: "BUY", "SELL", "CLOSE".
// @param comment  (string) Optional free-text description. Defaults to "".
// @param qty      (float)  Position size or quantity. Pass na to omit (serialised as null).
// @param sl       (float)  Stop-loss price level. Pass na to omit (serialised as null).
// @param tp       (float)  Take-profit price level. Pass na to omit (serialised as null).
// @param strategy (string) Strategy identifier (e.g. "EMA_Cross"). Defaults to "".
// @returns (string) A JSON object string with the fields: action, ticker,
//          exchange, interval, price, open, high, low, volume, time, comment,
//          qty, sl, tp, strategy.
export buildPayloadFull(
     string action,
     string comment  = "",
     float  qty      = na,
     float  sl       = na,
     float  tp       = na,
     string strategy = "") =>
    '{ "action"   :"' + escapeStr(action) + '", "ticker"   :"{{ticker}}", "exchange" :"{{exchange}}", "interval" :"{{interval}}", "price"    :"{{close}}", "open"     :"{{open}}", "high"     :"{{high}}", "low"      :"{{low}}", "volume"   :"{{volume}}", "time"     :"{{timenow}}", "comment"  :"' + escapeStr(comment) + '", "qty"      :' + (na(qty) ? "null" : str.tostring(qty)) + ', "sl"       :' + (na(sl)  ? "null" : str.tostring(sl)) + ', "tp"       :' + (na(tp)  ? "null" : str.tostring(tp)) + ', "strategy" :"' + escapeStr(strategy) + '" }'

// @function sendSignal
// @description Fires a TradingView alert containing a basic JSON payload
//              whenever `condition` is true. Alert frequency is set to
//              once_per_bar_close.
// @param condition (bool)   Trigger condition.
// @param action    (string) Signal label.
// @param comment   (string) Optional description. Defaults to "".
// @returns void
export sendSignal(
     bool   condition,
     string action,
     string comment = "") =>
    if condition
        alert(buildPayload(action, comment), alert.freq_once_per_bar_close)

// @function sendSignalFull
// @description Fires a TradingView alert containing an extended JSON payload
//              whenever `condition` is true. Alert frequency is set to
//              once_per_bar_close.
// @param condition (bool)   Trigger condition.
// @param action    (string) Signal label.
// @param comment   (string) Optional description. Defaults to "".
// @param qty       (float)  Position size. Pass na to omit. Defaults to na.
// @param sl        (float)  Stop-loss price. Pass na to omit. Defaults to na.
// @param tp        (float)  Take-profit price. Pass na to omit. Defaults to na.
// @param strategy  (string) Strategy name. Defaults to "".
// @returns void
export sendSignalFull(
     bool   condition,
     string action,
     string comment  = "",
     float  qty      = na,
     float  sl       = na,
     float  tp       = na,
     string strategy = "") =>
    if condition
        alert(buildPayloadFull(action, comment, qty, sl, tp, strategy), alert.freq_once_per_bar_close)
        