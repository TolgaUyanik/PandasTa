// @description Supporting Utility Library for the Live Economic Calendar by toodegrees Indicator; database with the second 500 Forex Factory News Event types.
library("forex_factory_events_id_B")

// @function Converts a number to Forex Factory News title (second 500).
// @param ID Identifier of the Forex Factory News Event. Please see the library for more information.
// @returns Returns the title of the Forex Factory News Event.
export ff_titleB(string ID) =>
