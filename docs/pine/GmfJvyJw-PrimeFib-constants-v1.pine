//@version=6
//@description PrimeFib / GoldenWhirl constants (Pine Library). Versioning is handled via TradingView publish versions.
library("PrimeFib_constants_v1", overlay=false)

// ============================================================
// Main constants for GoldenWhirl / PrimeFib
// ============================================================

// --- Classic golden ratio φ ---
const float _GOLDEN_RATIO     = (1.0 + math.sqrt(5.0)) / 2.0
const float _GOLDEN_RATIO_INV = 1.0 / _GOLDEN_RATIO

// --- Circle number π ---
const float _PI     = math.pi
const float _INV_PI = 1.0 / _PI

// --- Base-φ for Spiral ---
const float _PHI_SPIRAL = _GOLDEN_RATIO

// --- PrimeFib - Gold Number ---
const float _PHI7     = 1.82287565555322954
const float _PHI7_INV = 1.0 / _PHI7

// --- PrimeFib-Goldconstant Ψ_PF ---
// Ψ_PF = (phi7 + sqrt(phi7^2 + 20)) / 2
const float _PSI_PF     = (_PHI7 + math.sqrt(_PHI7 * _PHI7 + 20.0)) / 2.0
const float _PSI_PF_INV = 1.0 / _PSI_PF

// --- Lambda-Constant ---
const float _LAMBDA_PF = 6.854101966249685

// --- Noise constants (Rho) – theoretical vs. empirical ---
const float _RHO_PF_THEO = 0.000103980
const float _RHO_BTC_EMP = 2.35983e-4
const float _RHO_CME_EMP = 1.03980e-4

// Common Prime-Fib Noiseconstant (geometric mean)
const float _RHO_PF_EMP = math.sqrt(_RHO_BTC_EMP * _RHO_CME_EMP)

// Shortname in Prime-Fib World: Noise constant = RHOT
const float _RHOT = _RHO_PF_EMP

// ============================================================
// Exports (library public API)
// ============================================================

export GOLDEN_RATIO()      => _GOLDEN_RATIO
export GOLDEN_RATIO_INV()  => _GOLDEN_RATIO_INV

export PI()                => _PI
export INV_PI()            => _INV_PI

export PHI_SPIRAL()        => _PHI_SPIRAL

export PHI7()              => _PHI7
export PHI7_INV()          => _PHI7_INV

export PSI_PF()            => _PSI_PF
export PSI_PF_INV()        => _PSI_PF_INV

export LAMBDA_PF()         => _LAMBDA_PF

export RHO_PF_THEO()       => _RHO_PF_THEO
export RHO_BTC_EMP()       => _RHO_BTC_EMP
export RHO_CME_EMP()       => _RHO_CME_EMP
export RHO_PF_EMP()        => _RHO_PF_EMP
export RHOT()              => _RHOT