//@version=6

plot(close)
//@version=5
indicator("Pre-Market High and Low", overlay=true)

// === INPUTS ===
premarketStart = input.time(timestamp("2025-01-01 04:00:00"), "Pre-Market Start (EST)", confirm=true)
premarketEnd = input.time(timestamp("2025-01-01 09:30:00"), "Pre-Market End (EST)", confirm=true)
lineColorHigh = input.color(color.green, "Pre-Market High Color")
lineColorLow = input.color(color.red, "Pre-Market Low Color")
lineStyle = input.string("Dashed", "Line Style", options=["Solid", "Dashed", "Dotted"])
labelEnabled = input.bool(true, "Show Labels")
panelSize = input.int(50, "Panel Size (Bars to Extend)", minval=10, maxval=500)

// Convert line style string to line.style
lineStyleValue = lineStyle == "Solid" ? line.style_solid : lineStyle == "Dashed" ? line.style_dashed : line.style_dotted

// === TIME DETECTION ===
isNewDay = ta.change(time("D")) != 0
premarketSession = time >= premarketStart and time < premarketEnd
regularOpenTime = hour == 9 and minute == 30

// === VARIABLES ===
var float premktHigh = na
var float premktLow = na
var bool linesPlotted = false

// === RECORD HIGH/LOW DURING PREMARKET ===
if premarketSession
    premktHigh := na(premktHigh) ? high : math.max(premktHigh, high)
    premktLow := na(premktLow) ? low : math.min(premktLow, low)
    linesPlotted := false

// === PLOT LINES AT MARKET OPEN ===
if regularOpenTime and not linesPlotted and not na(premktHigh) and not na(premktLow)
    line.new(bar_index, premktHigh, bar_index + panelSize, premktHigh, color=lineColorHigh, style=lineStyleValue, width=1, extend=extend.right)
    line.new(bar_index, premktLow, bar_index + panelSize, premktLow, color=lineColorLow, style=lineStyleValue, width=1, extend=extend.right)
    if labelEnabled
        label.new(bar_index, premktHigh, "Pre-Market High", style=label.style_label_up, color=lineColorHigh, textcolor=color.white)
        label.new(bar_index, premktLow, "Pre-Market Low", style=label.style_label_down, color=lineColorLow, textcolor=color.white)
    linesPlotted := true

// === RESET AT START OF NEW DAY ===
if isNewDay
    premktHigh := na
    premktLow := na
    linesPlotted := false