// © JohnsonForexTrader

//@version=6
indicator("Quantum Vision Pro v6 [JFT]", overlay=true, max_labels_count=500, max_lines_count=500)

//====================================================
// INPUTS
//====================================================

groupTrend = "Vision Trend Engine"

factor = input.float(3.0, "Trend Sensitivity", group=groupTrend)
atrLen = input.int(10, "ATR Length", group=groupTrend)

fastEMA = input.int(50, "Fast EMA", group=groupTrend)
slowEMA = input.int(200, "Slow EMA", group=groupTrend)


groupVisual = "Visual Settings"

showRibbon = input.bool(true, "Show Trend Ribbon")
showDashboard = input.bool(true, "Show Premium Dashboard")
colorCandles = input.bool(true, "Trend Candle Color")


//====================================================
// CORE ENGINE
//====================================================

ema1 = ta.ema(close, fastEMA)
ema2 = ta.ema(close, slowEMA)

[trendLine, trendDir] = ta.supertrend(factor, atrLen)

bull = trendDir < 0
bear = trendDir > 0


// Momentum

rsiValue = ta.rsi(close,14)


//====================================================
// TREND RIBBON
//====================================================

plot(
     ema1,
     title="Fast Vision Line",
     color=bull ? color.lime : color.red,
     linewidth=2)

plot(
     ema2,
     title="Slow Vision Line",
     color=color.orange,
     linewidth=2)


// Trend Area

p1 = plot(showRibbon ? ema1 : na, display=display.none)
p2 = plot(showRibbon ? ema2 : na, display=display.none)

fill(
     p1,
     p2,
     color = bull ? color.new(color.green,80) :
              color.new(color.red,80),
     title="Vision Trend Zone")


//====================================================
// CANDLE COLOR
//====================================================

barcolor(
     colorCandles ?
     (bull ? color.new(color.lime,0) :
      bear ? color.new(color.red,0) :
      na)
     : na)


//====================================================
// SIGNAL ENGINE
//====================================================

buy = ta.change(trendDir) < 0 and ema1 > ema2
sell = ta.change(trendDir) > 0 and ema1 < ema2


plotshape(
     buy,
     title="Vision BUY",
     style=shape.labelup,
     location=location.belowbar,
     color=color.lime,
     text="BUY",
     textcolor=color.black,
     size=size.normal)


plotshape(
     sell,
     title="Vision SELL",
     style=shape.labeldown,
     location=location.abovebar,
     color=color.red,
     text="SELL",
     textcolor=color.white,
     size=size.normal)


//====================================================
// PREMIUM DASHBOARD
//====================================================

var table panel = table.new(
     position.top_right,
     2,
     7,
     bgcolor=color.new(color.black,15),
     border_width=1)


if showDashboard and barstate.islast

    table.cell(panel,0,0,
         "QUANTUM VISION PRO",
         bgcolor=color.rgb(30,30,30),
         text_color=color.white)

    table.cell(panel,1,0,
         "JFT v6",
         bgcolor=color.rgb(30,30,30),
         text_color=color.aqua)


    table.cell(panel,0,1,
         "MARKET",
         text_color=color.white)

    table.cell(panel,1,1,
         bull ? "BULLISH 🚀" : "BEARISH 🔻",
         text_color=bull ? color.lime : color.red)


    table.cell(panel,0,2,
         "RSI POWER",
         text_color=color.white)

    table.cell(panel,1,2,
         str.tostring(rsiValue,"#.0"),
         text_color=color.yellow)


    table.cell(panel,0,3,
         "PRICE",
         text_color=color.white)

    table.cell(panel,1,3,
         str.tostring(close),
         text_color=color.aqua)


//====================================================
// ALERTS
//====================================================

alertcondition(
     buy,
     title="Quantum Vision BUY",
     message="Quantum Vision Pro BUY Signal")

alertcondition(
     sell,
     title="Quantum Vision SELL",
     message="Quantum Vision Pro SELL Signal")
     //====================================================
// PART 2
// Quantum Vision Pro v6 [JFT]
// Target Engine + Confidence System
//====================================================


//==============================
// VOLATILITY ENGINE
//==============================

atrValue = ta.atr(14)


//==============================
// CONFIDENCE SCORE
//==============================

trendScore = 0

trendScore += bull ? 35 : 0
trendScore += bear ? 35 : 0

trendScore += ema1 > ema2 ? 25 : 0

trendScore += rsiValue > 50 ? 20 : 0

trendScore += atrValue > ta.sma(atrValue,20) ? 20 : 0


confidence =
     trendScore > 100 ? 100 : trendScore


confidenceText =
     confidence >= 80 ? "HIGH" :
     confidence >= 60 ? "MEDIUM" :
     "LOW"


confidenceColor =
     confidence >= 80 ? color.lime :
     confidence >= 60 ? color.orange :
     color.red



//==============================
// AUTO TRADE LEVELS
//==============================

buySL  = close - atrValue * 1.5
buyTP1 = close + atrValue * 1.5
buyTP2 = close + atrValue * 3
buyTP3 = close + atrValue * 4.5


sellSL  = close + atrValue * 1.5
sellTP1 = close - atrValue * 1.5
sellTP2 = close - atrValue * 3
sellTP3 = close - atrValue * 4.5



//==============================
// ENTRY ZONE VISUAL
//==============================

var line slLine = na
var line tpLine1 = na
var line tpLine2 = na
var line tpLine3 = na


if buy
    line.delete(slLine)
    line.delete(tpLine1)
    line.delete(tpLine2)
    line.delete(tpLine3)

    slLine := line.new(
         bar_index,
         buySL,
         bar_index + 20,
         buySL,
         color=color.red,
         width=2)

    tpLine1 := line.new(
         bar_index,
         buyTP1,
         bar_index + 20,
         buyTP1,
         color=color.lime,
         width=1)

    tpLine2 := line.new(
         bar_index,
         buyTP2,
         bar_index + 20,
         buyTP2,
         color=color.green,
         width=1)

    tpLine3 := line.new(
         bar_index,
         buyTP3,
         bar_index + 20,
         buyTP3,
         color=color.aqua,
         width=2)



if sell
    line.delete(slLine)
    line.delete(tpLine1)
    line.delete(tpLine2)
    line.delete(tpLine3)

    slLine := line.new(
         bar_index,
         sellSL,
         bar_index + 20,
         sellSL,
         color=color.red,
         width=2)

    tpLine1 := line.new(
         bar_index,
         sellTP1,
         bar_index + 20,
         sellTP1,
         color=color.lime,
         width=1)

    tpLine2 := line.new(
         bar_index,
         sellTP2,
         bar_index + 20,
         sellTP2,
         color=color.green,
         width=1)

    tpLine3 := line.new(
         bar_index,
         sellTP3,
         bar_index + 20,
         sellTP3,
         color=color.aqua,
         width=2)



//==============================
// DASHBOARD UPGRADE
//==============================

if showDashboard and barstate.islast

    table.cell(
         panel,
         0,
         4,
         "CONFIDENCE",
         text_color=color.white)

    table.cell(
         panel,
         1,
         4,
         str.tostring(confidence)+"% "+confidenceText,
         text_color=confidenceColor)


    table.cell(
         panel,
         0,
         5,
         "ATR POWER",
         text_color=color.white)

    table.cell(
         panel,
         1,
         5,
         str.tostring(atrValue, "#.##"),
         text_color=color.yellow)


    table.cell(
         panel,
         0,
         6,
         "SIGNAL",
         text_color=color.white)

    table.cell(
         panel,
         1,
         6,
         buy ? "BUY MODE" :
         sell ? "SELL MODE" :
         "WAIT",
         text_color =
         buy ? color.lime :
         sell ? color.red :
         color.gray)



//==============================
// ALERTS
//==============================

alertcondition(
     buy,
     title="Quantum Vision Pro BUY",
     message="Quantum Vision Pro New BUY Setup")

alertcondition(
     sell,
     title="Quantum Vision Pro SELL",
     message="Quantum Vision Pro New SELL Setup")
     //====================================================
// PART 3 FIXED
// Quantum Vision Pro v6 [JFT]
// Market Structure + Liquidity Engine
//====================================================


// INPUT
structureLength = input.int(5, "Structure Lookback")


// PIVOTS
highPivot = ta.pivothigh(high, structureLength, structureLength)
lowPivot  = ta.pivotlow(low, structureLength, structureLength)


// STORE LEVELS
var float resistanceLevel = na
var float supportLevel = na

if not na(highPivot)
    resistanceLevel := highPivot

if not na(lowPivot)
    supportLevel := lowPivot


// STRUCTURE BREAK

breakUp = not na(resistanceLevel) and close > resistanceLevel
breakDown = not na(supportLevel) and close < supportLevel


// LIQUIDITY SWEEP

liquidityBuy =
     not na(supportLevel) and
     low < supportLevel and
     close > supportLevel


liquiditySell =
     not na(resistanceLevel) and
     high > resistanceLevel and
     close < resistanceLevel



// VISUALS

plot(
     resistanceLevel,
     title="Resistance Zone",
     color=color.red,
     style=plot.style_linebr,
     linewidth=2)


plot(
     supportLevel,
     title="Support Zone",
     color=color.green,
     style=plot.style_linebr,
     linewidth=2)



plotshape(
     liquidityBuy,
     title="Liquidity Buy",
     style=shape.circle,
     location=location.belowbar,
     color=color.aqua,
     size=size.small,
     text="SWEEP")


plotshape(
     liquiditySell,
     title="Liquidity Sell",
     style=shape.circle,
     location=location.abovebar,
     color=color.purple,
     size=size.small,
     text="SWEEP")



// MARKET STRUCTURE LABELS
if breakUp
    label.new(
         bar_index,
         high,
         "BOS",
         style=label.style_label_down,
         color=color.green,
         textcolor=color.white,
         size=size.tiny)


if breakDown
    label.new(
         bar_index,
         low,
         "BOS",
         style=label.style_label_up,
         color=color.red,
         textcolor=color.white,
         size=size.tiny)