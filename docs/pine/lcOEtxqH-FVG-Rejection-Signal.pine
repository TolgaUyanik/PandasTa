//@version=6
indicator("FVG Wick Arrows With Body Confirmation", overlay = true)

// Maximum number of active bullish and bearish FVGs to track
maxTrackedFVGs = input.int(
     100,
     title = "Maximum FVGs to Track",
     minval = 1,
     maxval = 500
)

//──────────────────────────────────────────────────────────────────────
// Candle measurements
//──────────────────────────────────────────────────────────────────────

bodySize = math.abs(close - open)

lowerWick = math.min(open, close) - low
upperWick = high - math.max(open, close)

bullishCandle = close > open
bearishCandle = close < open

bullishWickCondition = lowerWick > bodySize
bearishWickCondition = upperWick > bodySize

//──────────────────────────────────────────────────────────────────────
// Standard three-candle Fair Value Gap detection
//──────────────────────────────────────────────────────────────────────

// Bullish FVG:
// Current candle's low is above the high from two candles earlier.
newBullishFVG = bar_index >= 2 and low > high[2]

// Bearish FVG:
// Current candle's high is below the low from two candles earlier.
newBearishFVG = bar_index >= 2 and high < low[2]

//──────────────────────────────────────────────────────────────────────
// Arrays containing active FVG boundaries
//──────────────────────────────────────────────────────────────────────

var bullishFVGTop = array.new_float()
var bullishFVGBottom = array.new_float()

var bearishFVGTop = array.new_float()
var bearishFVGBottom = array.new_float()

//──────────────────────────────────────────────────────────────────────
// Store newly formed bullish FVGs
//──────────────────────────────────────────────────────────────────────

if newBullishFVG
    float newTop = low
    float newBottom = high[2]

    array.push(bullishFVGTop, newTop)
    array.push(bullishFVGBottom, newBottom)

    if array.size(bullishFVGTop) > maxTrackedFVGs
        array.shift(bullishFVGTop)
        array.shift(bullishFVGBottom)

//──────────────────────────────────────────────────────────────────────
// Store newly formed bearish FVGs
//──────────────────────────────────────────────────────────────────────

if newBearishFVG
    float newTop = low[2]
    float newBottom = high

    array.push(bearishFVGTop, newTop)
    array.push(bearishFVGBottom, newBottom)

    if array.size(bearishFVGTop) > maxTrackedFVGs
        array.shift(bearishFVGTop)
        array.shift(bearishFVGBottom)

//──────────────────────────────────────────────────────────────────────
// Check whether current close is inside an active bullish FVG
//──────────────────────────────────────────────────────────────────────

bool insideBullishFVG = false
int bullishCheckIndex = 0

while bullishCheckIndex < array.size(bullishFVGTop)
    float gapTop = array.get(bullishFVGTop, bullishCheckIndex)
    float gapBottom = array.get(bullishFVGBottom, bullishCheckIndex)

    if close >= gapBottom and close <= gapTop
        insideBullishFVG := true

    bullishCheckIndex += 1

//──────────────────────────────────────────────────────────────────────
// Check whether current close is inside an active bearish FVG
//──────────────────────────────────────────────────────────────────────

bool insideBearishFVG = false
int bearishCheckIndex = 0

while bearishCheckIndex < array.size(bearishFVGTop)
    float gapTop = array.get(bearishFVGTop, bearishCheckIndex)
    float gapBottom = array.get(bearishFVGBottom, bearishCheckIndex)

    if close >= gapBottom and close <= gapTop
        insideBearishFVG := true

    bearishCheckIndex += 1

//──────────────────────────────────────────────────────────────────────
// Original FVG wick-arrow conditions
//──────────────────────────────────────────────────────────────────────

bullishArrowSignal =
     barstate.isconfirmed and
     bullishCandle and
     bullishWickCondition and
     insideBullishFVG

bearishArrowSignal =
     barstate.isconfirmed and
     bearishCandle and
     bearishWickCondition and
     insideBearishFVG

//──────────────────────────────────────────────────────────────────────
// Next-candle body confirmation
//
// Buy:
// Previous candle printed an up arrow.
// Current candle is bullish.
// Current body is larger than the previous candle's body.
//
// Sell:
// Previous candle printed a down arrow.
// Current candle is bearish.
// Current body is larger than the previous candle's body.
//──────────────────────────────────────────────────────────────────────

buySignal =
     barstate.isconfirmed and
     bullishArrowSignal[1] and
     bullishCandle and
     bodySize > bodySize[1]

sellSignal =
     barstate.isconfirmed and
     bearishArrowSignal[1] and
     bearishCandle and
     bodySize > bodySize[1]

//──────────────────────────────────────────────────────────────────────
// Draw original arrows
//──────────────────────────────────────────────────────────────────────

plotshape(
     bullishArrowSignal,
     title = "Bullish FVG Wick Arrow",
     style = shape.arrowup,
     location = location.belowbar,
     color = color.lime,
     size = size.small
)

plotshape(
     bearishArrowSignal,
     title = "Bearish FVG Wick Arrow",
     style = shape.arrowdown,
     location = location.abovebar,
     color = color.red,
     size = size.small
)

//──────────────────────────────────────────────────────────────────────
// Draw confirmed buy and sell signals
//──────────────────────────────────────────────────────────────────────

plotshape(
     buySignal,
     title = "Buy Signal",
     text = "BUY",
     style = shape.labelup,
     location = location.belowbar,
     color = color.green,
     textcolor = color.white,
     size = size.small
)

plotshape(
     sellSignal,
     title = "Sell Signal",
     text = "SELL",
     style = shape.labeldown,
     location = location.abovebar,
     color = color.maroon,
     textcolor = color.white,
     size = size.small
)

//──────────────────────────────────────────────────────────────────────
// Alert conditions
//──────────────────────────────────────────────────────────────────────

alertcondition(
     buySignal,
     title = "Buy Signal Alert",
     message = "Bullish body confirmation after a bullish FVG wick signal."
)

alertcondition(
     sellSignal,
     title = "Sell Signal Alert",
     message = "Bearish body confirmation after a bearish FVG wick signal."
)

//──────────────────────────────────────────────────────────────────────
// Remove fully filled bullish FVGs
//──────────────────────────────────────────────────────────────────────

int bullishRemoveIndex = array.size(bullishFVGTop) - 1

while bullishRemoveIndex >= 0
    float gapBottom = array.get(
         bullishFVGBottom,
         bullishRemoveIndex
    )

    if low <= gapBottom
        array.remove(
             bullishFVGTop,
             bullishRemoveIndex
        )

        array.remove(
             bullishFVGBottom,
             bullishRemoveIndex
        )

    bullishRemoveIndex -= 1

//──────────────────────────────────────────────────────────────────────
// Remove fully filled bearish FVGs
//──────────────────────────────────────────────────────────────────────

int bearishRemoveIndex = array.size(bearishFVGTop) - 1

while bearishRemoveIndex >= 0
    float gapTop = array.get(
         bearishFVGTop,
         bearishRemoveIndex
    )

    if high >= gapTop
        array.remove(
             bearishFVGTop,
             bearishRemoveIndex
        )

        array.remove(
             bearishFVGBottom,
             bearishRemoveIndex
        )

    bearishRemoveIndex -= 1