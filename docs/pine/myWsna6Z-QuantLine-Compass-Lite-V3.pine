// ============================================================================
//  QuantLine · Compass Lite  (PUBLIC / EDUCATIONAL VERSION)
// ----------------------------------------------------------------------------
//  Simplified public flow compass. Combines four PUBLIC components available
//  natively on TradingView: volume-weighted RSI (RSIVol), WaveTrend, Twiggs
//  Money Flow, and optional 1h USDT.D change. No proprietary thresholds,
//  liquidations, OI composite, or private scoring. Context / education only —
//  NOT a trade signal. Open-source. Not financial advice.
//
//  House Rules: English UI. Publish with a CLEAN chart (this script only).
// ============================================================================
//@version=6
indicator("QuantLine Compass Lite", shorttitle="QL Compass", overlay=true)

// ---- Inputs (round defaults — not proprietary calibration) -----------------
len     = input.int(14,  "Base length",            minval=2)
wtN1    = input.int(10,  "WaveTrend channel",      minval=2)
wtN2    = input.int(21,  "WaveTrend average",      minval=2)
useUSDTD= input.bool(true,"Include USDT.D (crypto risk tilt)")
showBG  = input.bool(true,"Background tint by flow")
tblPos  = input.string("top_right","Table position", options=["top_right","top_left","bottom_right","bottom_left"])

// ---- 1) RSIVol: RSI of volume-weighted price -------------------------------
vp        = ta.ema(close * volume, len) / math.max(ta.ema(volume, len), 1e-9)
rsivol    = ta.rsi(vp, len)

// ---- 2) WaveTrend (LazyBear) -----------------------------------------------
esa  = ta.ema(hlc3, wtN1)
de   = ta.ema(math.abs(hlc3 - esa), wtN1)
ci   = (hlc3 - esa) / math.max(0.015 * de, 1e-9)
wt1  = ta.ema(ci, wtN2)
wt2  = ta.sma(wt1, 4)

// ---- 3) Twiggs Money Flow --------------------------------------------------
trh   = math.max(high, close[1])
trl   = math.min(low,  close[1])
rng   = math.max(trh - trl, 1e-9)
adv   = volume * ((close - trl) - (trh - close)) / rng
tmf   = ta.rma(adv, len) / math.max(ta.rma(volume, len), 1e-9)

// ---- 4) USDT.D 1h change (rising = risk-off for crypto) --------------------
ud_usdtd = request.security("CRYPTOCAP:USDT.D", "60", close)
usdtdChg = useUSDTD ? (ud_usdtd - ud_usdtd[1]) / math.max(ud_usdtd[1], 1e-9) * 100.0 : 0.0

// ---- Normalize components to -1..+1 ----------------------------------------
clamp(x) => math.max(-1.0, math.min(1.0, x))
n_rsivol = clamp((rsivol - 50.0) / 50.0)
n_wt     = clamp(wt1 / 60.0)
n_tmf    = clamp(tmf * 4.0)
n_usdtd  = useUSDTD ? clamp(-usdtdChg / 0.5) : 0.0

// ---- Composite needle: -100..+100 ------------------------------------------
parts    = useUSDTD ? 4.0 : 3.0
needle   = (n_rsivol + n_wt + n_tmf + n_usdtd) / parts * 100.0
needle   := math.max(-100.0, math.min(100.0, needle))

arrow = needle >= 60 ? "▲▲" : needle >= 20 ? "▲" : needle <= -60 ? "▼▼" : needle <= -20 ? "▼" : "►"
state = needle >= 60 ? "STRONG LONG FLOW" : needle >= 20 ? "long flow" : needle <= -60 ? "STRONG SHORT FLOW" : needle <= -20 ? "short flow" : "neutral / PASS"
col   = needle >= 20 ? color.new(color.lime, 0) : needle <= -20 ? color.new(color.red, 0) : color.new(color.gray, 0)
warn  = rsivol >= 83 ? "⚠ overheat" : rsivol <= 17 ? "⚠ oversold" : ""
bgcolor(showBG and needle >= 20 ? color.new(color.lime, 92) : showBG and needle <= -20 ? color.new(color.red, 92) : na)

f_pos(p) => p=="top_left" ? position.top_left : p=="bottom_right" ? position.bottom_right : p=="bottom_left" ? position.bottom_left : position.top_right

var table tbl = table.new(f_pos(tblPos), 2, 5, border_width=1)
if barstate.islast
    table.cell(tbl, 0, 0, "🧭 QuantLine", text_color=color.white, bgcolor=color.new(color.black,0), text_size=size.small)
    table.cell(tbl, 1, 0, arrow, text_color=col, bgcolor=color.new(color.black,0), text_size=size.large)
    table.cell(tbl, 0, 1, "Flow", text_color=color.silver, text_size=size.small)
    table.cell(tbl, 1, 1, state,  text_color=col,           text_size=size.small)
    table.cell(tbl, 0, 2, "Strength", text_color=color.silver, text_size=size.small)
    table.cell(tbl, 1, 2, str.tostring(needle, "#") + " / 100", text_color=col, text_size=size.small)
    table.cell(tbl, 0, 3, "RSIVol", text_color=color.silver, text_size=size.small)
    table.cell(tbl, 1, 3, str.tostring(rsivol, "#") + (warn=="" ? "" : "  " + warn), text_color=(warn=="" ? color.white : color.orange), text_size=size.small)
    table.cell(tbl, 0, 4, "Lite · not a signal", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 4, "not financial advice", text_color=color.gray, text_size=size.tiny)

flipUp   = ta.crossover(needle,  20)
flipDown = ta.crossunder(needle, -20)
plotshape(flipUp,   title="flip up", style=shape.triangleup,   location=location.belowbar, color=color.lime, size=size.tiny)
plotshape(flipDown, title="flip down", style=shape.triangledown, location=location.abovebar, color=color.red,  size=size.tiny)

alertcondition(flipUp,   "Compass: flow long",  "QL Compass Lite: flow flipped up — context only, not an entry")
alertcondition(flipDown, "Compass: flow short", "QL Compass Lite: flow flipped down — context only, not an entry")