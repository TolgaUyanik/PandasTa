//@version=6
indicator('Elliott Wave Auto Detector (Simplified)', overlay = true)

// === Inputs ===
pivotLen = input.int(5, title = 'Pivot Length (for swings)', minval = 1)

// === Detect Pivot Highs and Lows ===
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

var array<label> waveLabels = array.new_label()
var int waveCount = 0
var float wave1 = na
var float wave2 = na
var float wave3 = na
var float wave4 = na
var float wave5 = na

if not na(pl)
    wave1 := low[pivotLen]
    array.clear(waveLabels)
    waveCount := 1
    array.push(waveLabels, label.new(x = bar_index - pivotLen, y = wave1, text = '1', style = label.style_label_up, color = color.blue))

if waveCount == 1 and not na(ph) and high[pivotLen] > wave1
    wave2 := high[pivotLen]
    waveCount := 2
    array.push(waveLabels, label.new(bar_index - pivotLen, wave2, '2', style = label.style_label_down, color = color.red))

if waveCount == 2 and not na(pl) and low[pivotLen] > wave1
    wave3 := low[pivotLen]
    waveCount := 3
    array.push(waveLabels, label.new(bar_index - pivotLen, wave3, '3', style = label.style_label_up, color = color.blue))

if waveCount == 3 and not na(ph) and high[pivotLen] > wave2
    wave4 := high[pivotLen]
    waveCount := 4
    array.push(waveLabels, label.new(bar_index - pivotLen, wave4, '4', style = label.style_label_down, color = color.red))

if waveCount == 4 and not na(pl) and low[pivotLen] > wave3
    wave5 := low[pivotLen]
    waveCount := 5
    array.push(waveLabels, label.new(bar_index - pivotLen, wave5, '5', style = label.style_label_up, color = color.green))

// Reset after wave 5
if waveCount == 5
    waveCount := 0
    waveCount
