//@version=5

// @description Misc of math, position size and consolidation detection functions that can be used accross various scripts.
library("VPQuantLib")

// @function Checks if the current value is bigger (or equal) with the provided percent value to the reference
// @param current - what to check against the reference 
// @param percent - what is the percent to check for difference
// @param reference - what to compare against
// @param or_equal - enables checking for bigger or equal
// @returns true if the current is percent bigger (or equal) to the reference
export isPercentAboveReference(float current, float percent, float reference, bool or_equal=false) =>
	(na(current) or na(reference)) ? false : or_equal ? current >= reference * (1 + percent/100) : current > reference * (1 + percent/100) 

// @function Checks if the current value is smaller (or equal) with the provided percent value to the reference
// @param current - what to check against the reference 
// @param percent - what is the percent to check for difference
// @param reference - what to compare against
// @param or_equal - enables checking for smaller or equal
// @returns true if the current is percent smaller (or equal) to the reference
export isPercentBelowReference(float current, float percent, float reference, bool or_equal=false) =>
	(na(current) or na(reference)) ? false : or_equal ? current <= reference * (1 + percent/100) : current < reference * (1 + percent/100) 

// @function Checks if the current value is greater/smaller than the reference value within the provided percent range
// @param current - what to check for being in range against the refenence
// @param reference - what to compare against
// @param min_percent - the min percent range border
// @param max_percent - the max percent range border
// @param below - check if below or above the reference
// @return true if the current is bigger/smaller than the reference withing the [min, max] percent range provided
export isInRange(float current, float reference, float min_percent, float max_percent, bool below) =>
	min_threshold = (below == true) ? reference * (1 - min_percent / 100) : reference * (1 + min_percent / 100)
    max_threshold = (below == true) ? reference * (1 - max_percent / 100) : reference * (1 + max_percent / 100)
	(below == true) ? current >= max_threshold and current <= min_threshold : current <= max_threshold and current >= min_threshold

// @function Calculates and returns the positins size based on risk of the equity
// @param account_balance - total account balance 
// @param equity_risk_perc - percent of equity to risk in the trade
// @param max_loss_per_share - maximum loss per share (in currency, not in %) that we're willing to loose (calc based on the entry_price-stop_loss_price)
// @return number of shares to buy 
export GetRiskBasedPositionSize(float account_balance, int equity_risk_perc, float max_loss_per_share) =>
    float _equity_risk_amount   = account_balance * equity_risk_perc / 100
    float _position_size        = math.floor(_equity_risk_amount / max_loss_per_share)
    _position_size

// @function Checks if the current bar is in a consolidation range
// @param consolidation_period - the number of bars to consider for consolidation range calculation
// @param allowed_consolidation_range - the percentage range allowed for the current consolidation range to be considered valid
// @param ref_high - the reference high value to use for consolidation range calculation
// @param ref_low - the reference low value to use for consolidation range calculation
// @param prev_bar_consolidation - a boolean indicating if the previous bar was also in consolidation range
// @param draw_consolidation_lines - a boolean indicating if consolidation range lines should be drawn on the chart
// @return a tuple of three values:
//          1. _curr_consolidation - a boolean indicating if the current bar is in consolidation range
//          2. _curr_consolidation_low - the current consolidation low value
//          3. _curr_consolidation_high - the current consolidation high value
export CheckInRangeConsolidation(int consolidation_period, int allowed_consolidation_range, float ref_high, float ref_low, bool prev_bar_consolidaton, bool draw_consolidation_lines = false) =>
    var line _up_line = na
	var line _down_line = na

    _curr_consolidation_high    = ta.highest(ref_high, consolidation_period)[1]
    _curr_consolidation_low     = ta.lowest(ref_low, consolidation_period) [1]
    _curr_consolidation_range   = ((_curr_consolidation_high/_curr_consolidation_low) - 1)*100
    _curr_consolidation         = (_curr_consolidation_range <= allowed_consolidation_range)

    if(draw_consolidation_lines and (prev_bar_consolidaton == true and _curr_consolidation == false))
        _up_line   := line.new(bar_index, _curr_consolidation_high, bar_index - allowed_consolidation_range, _curr_consolidation_high, color = color.red, style = line.style_dashed)
		_down_line := line.new(bar_index, _curr_consolidation_low , bar_index - allowed_consolidation_range, _curr_consolidation_low,  color = color.lime, style = line.style_dashed)

    [_curr_consolidation, _curr_consolidation_low, _curr_consolidation_high]

// @function Finds a basic consolidation areas, looking back 1000 bars to find the pivot of the trend and checks if the current bar is in consolidation area counting the 
// number of bars that have not broken the consolidation high/low levels
// @param loopback_period - the number of bars to look back to determine the high/low watermark
// @param consolidation_length - minimum number of bars required to establish a consolidation period
// @param ref_high - user input for high (can be based on the bar or wicks)
// @param ref_low - user input for high (can be based on the bar or wicks)
// @param draw_consolidation_lines - enable/disable drawing of the consolidation lines
// @returns _curr_consolidation_high - the high of the current consolidation
// @returns _curr_consolidation_low - the low point of the current consolication
// @returns _consolidation_counter - number of bars in the current consolidation
// @returns _pivot_point - pivot point
export FindBasicConsolidation(int loopback_period, int consolidation_length, float ref_high, float ref_low, bool draw_consolidation_lines = false) =>
	float _high_watermark = ta.highestbars(loopback_period) == 0  ? ref_high  : na
	float _low_watermark  = ta.lowestbars(loopback_period)  == 0  ? ref_low   : na
	var int _dir = 0                     // 0 - none, 1 - uptrend, -1 - downtrend
	float _highest_lowest_price = na     // based on the trend and the high/low watermarks
	float _pivot_point = na

	_dir := (_high_watermark and na(_low_watermark)) ? 1 : ((_low_watermark and na(_high_watermark)) ? -1 : _dir)
	if _high_watermark and _low_watermark
		if _dir == 1
			_highest_lowest_price := _high_watermark
		else
			_highest_lowest_price := _low_watermark
	else
		_highest_lowest_price := _high_watermark ? _high_watermark : (_low_watermark ? _low_watermark : na)

	for x = 0 to 1000
		if na(close) or _dir != _dir[x]
			break
		if _highest_lowest_price[x]
			if na(_pivot_point)
				_pivot_point := _highest_lowest_price[x]
			else
				if _dir[x] == 1 and _highest_lowest_price[x] > _pivot_point
					_pivot_point := _highest_lowest_price[x]
				if _dir[x] == -1 and _highest_lowest_price[x] < _pivot_point
					_pivot_point := _highest_lowest_price[x]

	var int _consolidation_counter = 0
	var float _curr_consolidation_high = na
	var float _curr_consolidation_low = na
	float _consolidation_length_highest = ta.highest(consolidation_length)
	float _consolidation_length_lowest = ta.lowest(consolidation_length)
	var line _up_line = na
	var line _down_line = na
	bool _breakout_up = false
	bool _breakout_down = false

	if ta.change(_pivot_point)
		if _consolidation_counter > consolidation_length
			if _pivot_point > _curr_consolidation_high
				_breakout_up := true
			if _pivot_point < _curr_consolidation_low
				_breakout_down := true
		if _consolidation_counter > 0 and _pivot_point <= _curr_consolidation_high and _pivot_point >= _curr_consolidation_low
			_consolidation_counter := _consolidation_counter + 1
		else
			_consolidation_counter := 0
	else
		_consolidation_counter := _consolidation_counter + 1

	if _consolidation_counter >= consolidation_length
		if _consolidation_counter == consolidation_length
			_curr_consolidation_high := _consolidation_length_highest
			_curr_consolidation_low  := _consolidation_length_lowest
		else
			if(draw_consolidation_lines)
				line.delete(_up_line)
				line.delete(_down_line)
			_curr_consolidation_high := math.max(_curr_consolidation_high, ref_high)
			_curr_consolidation_low := math.min(_curr_consolidation_low, ref_low)
		
		if(draw_consolidation_lines)
			_up_line := line.new(bar_index, _curr_consolidation_high, bar_index - _consolidation_counter, _curr_consolidation_high, color = color.red, style = line.style_dashed)
			_down_line := line.new(bar_index, _curr_consolidation_low , bar_index - _consolidation_counter, _curr_consolidation_low, color = color.lime, style = line.style_dashed)

	[_curr_consolidation_high, _curr_consolidation_low, _consolidation_counter, _pivot_point]