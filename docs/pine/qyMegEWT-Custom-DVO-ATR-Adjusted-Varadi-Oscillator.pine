//@version=6
indicator("Custom DVO (ATR-Adjusted Varadi Oscillator)", shorttitle="CDVO", overlay=false)

// ── Inputs ──────────────────────────────────────────────
n              = input.int(10,  title="ATR Period (n)",     minval=1)
s              = input.int(2,   title="Smoothing (s)",      minval=1)
m              = input.int(126, title="Rank Period (m)",    minval=2)
oversoldLevel  = input.int(10,  title="Oversold Level")
overboughtLevel= input.int(90,  title="Overbought Level")

// ── Step 1: Median (daily anchor) ──────────────────────
medianPrice = (high + low) / 2

// ── Step 2: Volatility Stretch ─────────────────────────
atrVal  = ta.atr(n)
stretch = atrVal != 0 ? (close - medianPrice) / atrVal : 0.0

// ── Step 3: Smoothing Filter ───────────────────────────
// s = 1 passes the raw stretch through unchanged (SMA of length 1)
smoothedStretch = ta.sma(stretch, s)

// ── Step 4: Adaptive Percent Rank (0–100) ──────────────
cdvo = ta.percentrank(smoothedStretch, m)

// ── Plot ────────────────────────────────────────────────
plot(cdvo, title="CDVO", color=#1E90FF, linewidth=2)
hline(oversoldLevel,   title="Oversold",   color=color.gray, linestyle=hline.style_dashed)
hline(overboughtLevel, title="Overbought", color=color.gray, linestyle=hline.style_dashed)
hline(50, title="Midline", color=color.new(color.gray, 70))

