//@version=5
library("nineLivesUtilLib")
//-----------------------------------------------------------------------------
// ENUMS & CONSTANTS
//-----------------------------------------------------------------------------
export enum TradeDirection
    LONGS_ONLY = "longs_only"
    SHORTS_ONLY = "shorts_only"
    BOTH = "both"
export enum SmoothingType
    LREG = "lreg" // Note: These smoothing types are no longer used after removing core grid logic, but kept as they are part of the original enum definition.
    SMA = "sma"
    EMA = "ema"
    VWMA = "vwma"
    TEMA = "tema"
export enum RegimeIndicator
    ADX = "ADX"
    VOLATILITY = "Volatility"
export enum RegimeMode
    TREND_ONLY = "trend_only"
    RANGE_ONLY = "range_only"
    ADAPTIVE = "adaptive"
export enum TimeframeAlignment
    SAME = "same"
    OPPOSITE = "opposite"
    ANY = "any"
//-----------------------------------------------------------------------------
// FILTERING FUNCTIONS
//-----------------------------------------------------------------------------
//@function Checks if the current time is within the specified date range.
//@param currentTime The current bar's time (time).
//@param useTimeFilter Bool 📅: Enable the date range filter.
//@param startDate Timestamp 📅: The start date for the filter.
//@param endDate Timestamp 📅: The end date for the filter.
//@returns True if the current time is within the range or filtering is disabled, false otherwise.
//@example
// inDateRange = nineLivesUtilLib.isDateInRange(time, useTimeFilter, startDate, endDate)
// if inDateRange
//     // Execute trading logic
export isDateInRange(int currentTime, bool useTimeFilter, int startDate, int endDate) =>
    not useTimeFilter or (currentTime >= startDate and currentTime <= endDate)
//@function Checks if the current volume meets the threshold condition.
//@param currentVolume The current bar's volume (volume).
//@param useVolumeFilter Bool 📊: Enable the volume filter.
//@param volumeThresholdMultiplier Float 📊: Volume threshold relative to average (e.g., 1.5 for 1.5x average).
//@param volumeLength Int 📊: Lookback length for the volume average.
//@returns True if the volume condition is met or filtering is disabled, false otherwise.
//@example
// volumeOk = nineLivesUtilLib.checkVolumeCondition(volume, useVolumeFilter, volumeThreshold, volumeLength)
// if volumeOk
//     // Proceed with trading logic
export checkVolumeCondition(float currentVolume, bool useVolumeFilter, float volumeThresholdMultiplier, int volumeLength) =>
    float volumeAvg = ta.sma(currentVolume, volumeLength)
    not useVolumeFilter or currentVolume > volumeAvg * volumeThresholdMultiplier
//@function Checks alignment with higher timeframe direction.
//@param currentClose Float: The current bar's closing price (close).
//@param currentOpen Float: The current bar's opening price (open).
//@param htfClose Float: The closing price from the higher timeframe (must be fetched by the calling script using request.security).
//@param htfOpen Float: The opening price from the higher timeframe (must be fetched by the calling script using request.security).
//@param useMultiTimeframe Bool ⏱️: Enable multi-timeframe analysis.
//@param alignment String ⏱️: Desired alignment ("same", "opposite", "any").
//@returns True if the timeframe alignment condition is met or analysis is disabled, false otherwise.
//@example
// // In the calling script:
// [htfClose, htfOpen] = request.security(syminfo.tickerid, higherTimeframe, [close, open])
// tfOk = nineLivesUtilLib.checkMultiTimeframeCondition(close, open, htfClose, htfOpen, useMultiTimeframe, tfAlignment)
// if tfOk
//     // Proceed with trading logic
export checkMultiTimeframeCondition(float currentClose, float currentOpen, float htfClose, float htfOpen, bool useMultiTimeframe, string alignment) =>
    // request.security call has been removed from here.
    // The calling script must fetch htfClose and htfOpen and pass them as arguments.

    if not useMultiTimeframe
        true
    else
        // Perform the alignment check using the HTF data passed as parameters
        int htfDirection = htfClose > htfOpen ? 1 : htfClose < htfOpen ? -1 : 0
        int currentDirection = currentClose > currentOpen ? 1 : currentClose < currentOpen ? -1 : 0

        // Corrected enum comparison using string literals
        if alignment == "any"
            true
        else if alignment == "same"
            (htfDirection > 0 and currentDirection > 0) or (htfDirection < 0 and currentDirection < 0) or htfDirection == 0
        else if alignment == "opposite"
            (htfDirection > 0 and currentDirection < 0) or (htfDirection < 0 and currentDirection > 0) or htfDirection == 0
        else
            false // Should not happen with enum/options, but good practice
//@function Detects the market regime (trending or ranging) and checks if trading is allowed.
//@param useMarketRegime Bool 🔍: Enable market regime detection.
//@param regimeIndicator String 🔍: Indicator to use ("ADX" or "Volatility").
//@param regimeThreshold Int 🔍: Threshold for trend strength/volatility.
//@param regimeLength Int 🔍: Lookback length for the indicator.
//@param regimeMode String 🔍: Trading mode based on regime ("trend_only", "range_only", "adaptive").
//@returns A tuple containing:
//         [0]: conditionMet (bool) - True if trading is allowed based on the regime mode and detection, false otherwise.
//         [1]: inTrendingRegime (bool) - True if the current regime is trending based on the indicator and threshold.
//@example
// [regimeOk, isTrending] = nineLivesUtilLib.checkMarketRegime(useMarketRegime, regimeIndicator, regimeThreshold, regimeLength, regimeMode)
// if regimeOk
//     // Proceed with trading logic
export checkMarketRegime(bool useMarketRegime, string regimeIndicator, int regimeThreshold, int regimeLength, string regimeMode) =>
    if not useMarketRegime
        [true, true] // Assume trending and condition met if disabled
    else
        // Calculate regime indicator value
        float regimeValue = na
        bool inTrendingRegime = false

        // Corrected enum comparison using string literals
        if regimeIndicator == "ADX"
            // Added int() cast for simple int requirement of ta.dmi
            [diPlus, diMinus, adxValue] = ta.dmi(int(regimeLength), int(regimeLength)) // Use same length for DI and ADX smoothing as per original
            regimeValue := adxValue
            inTrendingRegime := adxValue > regimeThreshold
        // Corrected enum comparison for Volatility branch using string literals
        else if regimeIndicator == "Volatility"
            float volatility = ta.stdev(close, regimeLength) / ta.sma(close, regimeLength) * 100
            regimeValue := volatility
            inTrendingRegime := volatility > regimeThreshold // Higher volatility = trending? Or ranging?
            // Original code: inTrendingRegime := volatility > regimeThreshold
            // This implies high volatility = trending for the purpose of *this* regime detection. Let's follow that.

        // Check condition based on mode using string literals
        bool conditionMet = false
        if regimeMode == "adaptive"
            conditionMet := true // Adaptive mode always allows trading based on regime? Or it implies the strategy *adapts*?
            // The original uses `(regimeMode == "adaptive")` as a filter condition check, implying it's always OK to trade in adaptive mode.
            // This seems counter-intuitive for a *filter*. Let's assume "adaptive" means the filter *doesn't block* but perhaps parameters (like grid size) adapt.
            // Based purely on the boolean condition check in the original script's filtering block:
            conditionMet := true // If mode is adaptive, this filter passes.
        else if regimeMode == "trend_only"
            conditionMet := inTrendingRegime
        else if regimeMode == "range_only"
            conditionMet := not inTrendingRegime

        [conditionMet, inTrendingRegime]
//@function Applies a cooldown period after a signal.
//@param buySignal Bool: Buy signal (potentially after primary entry logic).
//@param sellSignal Bool: Sell signal (potentially after primary entry logic).
//@param cooldownBars Int ⏳: The number of bars to wait after a signal before allowing another.
//@returns A tuple containing:
//         [0]: cooldownFilteredBuy (bool) - Buy signal after cooldown filter.
//         [1]: cooldownFilteredSell (bool) - Sell signal after cooldown filter.
//@example
// [cooldownBuy, cooldownSell] = nineLivesUtilLib.applyCooldown(rawBuySignal, rawSellSignal, iCool)
export applyCooldown(bool buySignal, bool sellSignal, int cooldownBars) =>
    // Track the number of bars since the last signal
    var int barsSinceLastSignal = 9999 // Initialize high

    if buySignal or sellSignal
        barsSinceLastSignal := 0 // Reset count on a new signal
    else
        barsSinceLastSignal := barsSinceLastSignal + 1

    // Apply cooldown: signals are blocked if not enough bars have passed
    bool cooldownFilteredBuy = buySignal and barsSinceLastSignal >= cooldownBars
    bool cooldownFilteredSell = sellSignal and barsSinceLastSignal >= cooldownBars

    [cooldownFilteredBuy, cooldownFilteredSell]
//@function Applies all filtering conditions to the buy and sell signals.
//@param rawBuy Bool: The initial buy signal candidate (from primary entry logic, e.g., after cooldown).
//@param rawSell Bool: The initial sell signal candidate (from primary entry logic, e.g., after cooldown).
//@param inDateRange Bool 📅: Result from isDateInRange.
//@param tradeDirection String 🔄: Overall trade direction preference ("longs_only", "shorts_only", "both").
//@param volumeOk Bool 📊: Result from checkVolumeCondition.
//@param tfOk Bool ⏱️: Result from checkMultiTimeframeCondition.
//@param regimeOk Bool 🔍: Result from checkMarketRegime.
//@param drawdownOk Bool 📉: Result from checkDrawdownExceeded (or equivalent).
//@param cooldownOkBuy Bool ⏳: Result from applyCooldown for buy.
//@param cooldownOkSell Bool ⏳: Result from applyCooldown for sell.
//@returns A tuple containing:
//         [0]: finalBuySignal (bool) - The final buy signal after all filters.
//         [1]: finalSellSignal (bool) - The final sell signal after all filters.
//@example
// [finalBuy, finalSell] = nineLivesUtilLib.applyAllFilters(cooldownBuy, cooldownSell, inDateRange, tradeDirection, volumeOk, tfOk, regimeOk, !drawdownExceeded, cooldownBuy, cooldownSell)
// NOTE: This function filters signals generated by your primary entry logic (e.g., EMA crossover).
export applyAllFilters(bool rawBuy, bool rawSell, bool inDateRange, string tradeDirection, bool volumeOk, bool tfOk, bool regimeOk, bool drawdownOk, bool cooldownOkBuy, bool cooldownOkSell) =>
    bool finalBuy = rawBuy
    bool finalSell = rawSell

    // Apply filters sequentially
    finalBuy := finalBuy and inDateRange
    finalSell := finalSell and inDateRange

    // Corrected enum comparison using string literals
    finalBuy := finalBuy and (tradeDirection == "longs_only" or tradeDirection == "both")
    finalSell := finalSell and (tradeDirection == "shorts_only" or tradeDirection == "both")


    // Apply combined enhanced filters (volume, TF, regime)
    bool enhancedFiltersOk = volumeOk and tfOk and regimeOk
    finalBuy := finalBuy and enhancedFiltersOk
    finalSell := finalSell and enhancedFiltersOk

    // Apply drawdown protection filter
    finalBuy := finalBuy and drawdownOk
    // Note: Original script allowed closing shorts even if drawdown exceeded.
    // The library function just returns the *signal* validity. The strategy script handles the exit logic.
    // So, we only filter *entries* based on drawdown. The calling strategy script handles exits.
    // But the original filter applied to *both* Buy and Sell signals used for entry/exit.
    // Let's replicate the original filter logic: block signals if drawdown exceeded, UNLESS strategy position is <= 0 for Sell signals (allowing exit attempts).
    // This is tricky for a signal function. Let's just return if the *filter* is met based on general conditions, and let the strategy handle position checks.
    // So, drawdownOk means entries are potentially allowed.
    finalSell := finalSell and drawdownOk // This line is simplified. The strategy must check strategy.position_size for Sell when drawdownExceeded.

    // Apply cooldown filter (pass the already filtered signals through cooldown check)
    finalBuy := finalBuy and cooldownOkBuy // Cooldown results are already passed in
    finalSell := finalSell and cooldownOkSell // Cooldown results are already passed in


    // Re-check for conflicting signals after all filters, although it should be rare if done earlier.
    if finalBuy and finalSell
        finalBuy := false
        finalSell := false

    [finalBuy, finalSell]
//-----------------------------------------------------------------------------
// RISK MANAGEMENT FUNCTIONS
//-----------------------------------------------------------------------------
//@function Tracks maximum equity and checks if current drawdown exceeds a threshold.
//@param currentEquity Float: The strategy's current equity (strategy.equity).
//@param useMaxDrawdown Bool 📉: Enable max drawdown protection.
//@param maxDrawdownPercent Float 📉: The maximum allowed drawdown as a percentage.
//@returns True if drawdown protection is enabled and the current drawdown exceeds the threshold, false otherwise.
//@example
// drawdownExceeded = nineLivesUtilLib.checkDrawdownExceeded(strategy.equity, useMaxDrawdown, maxDrawdownPercent)
// if drawdownExceeded
//     // Consider stopping entries or exiting positions in the strategy script
export checkDrawdownExceeded(float currentEquity, bool useMaxDrawdown, float maxDrawdownPercent) =>
    var float maxEquity = -9e99 // Initialize with a very low number

    // Update max equity
    maxEquity := math.max(nz(maxEquity[1], currentEquity), currentEquity) // Use nz for first bar

    // Calculate current drawdown
    float currentDrawdown = (maxEquity - currentEquity) / maxEquity * 100

    // Check if threshold is exceeded
    useMaxDrawdown and currentDrawdown > maxDrawdownPercent
//@function Calculates a stop loss or take profit price based on a percentage from the average entry price.
//@param positionAvgPrice Float: The average price of the current position (strategy.position_avg_price).
//@param percentage Float: The stop loss or take profit percentage (e.g., 2.0 for 2%).
//@param isStop Bool: True if calculating a stop loss price, false if calculating a take profit price.
//@param isLong Bool: True if the position is long, false if short.
//@returns The calculated stop price or take profit price, or na if no position or percentage is invalid.
//@example
// longSL = nineLivesUtilLib.calculateExitPrice(strategy.position_avg_price, stopLossPercent, true, true)
// shortTP = nineLivesUtilLib.calculateExitPrice(strategy.position_avg_price, takeProfitPercent, false, false)
export calculateExitPrice(float positionAvgPrice, float percentage, bool isStop, bool isLong) =>
    if na(positionAvgPrice) or percentage <= 0
        na
    else
        float exitPrice = na
        if isLong
            if isStop
                exitPrice := positionAvgPrice * (1 - percentage / 100.0)
            else // Take Profit for Long
                exitPrice := positionAvgPrice * (1 + percentage / 100.0)
        else // Short Position
            if isStop
                exitPrice := positionAvgPrice * (1 + percentage / 100.0)
            else // Take Profit for Short
                exitPrice := positionAvgPrice * (1 - percentage / 100.0)
        exitPrice
//@function Calculates the current trailing stop level for a position.
//@param positionAvgPrice Float: The average price of the current position (strategy.position_avg_price).
//@param trailOffsetPercent Float 🔄: The percentage price movement to activate the trailing stop.
//@param trailPercent Float 🔄: The percentage distance the stop trails behind the price.
//@param currentHigh Float: The current bar's high (high).
//@param currentLow Float: The current bar's low (low).
//@param isLong Bool: True if the position is long, false if short.
//@returns The calculated trailing stop price if active, otherwise na.
//@example
// longTrailStop = nineLivesUtilLib.calculateTrailingStopLevel(strategy.position_avg_price, trailOffset, trailPercent, high, low, true)
// shortTrailStop = nineLivesUtilLib.calculateTrailingStopLevel(strategy.position_avg_price, trailOffset, trailPercent, high, low, false)
// if not na(longTrailStop)
//     strategy.exit("Long Trail", from_entry="Long", stop=longTrailStop)
export calculateTrailingStopLevel(float positionAvgPrice, float trailOffsetPercent, float trailPercent, float currentHigh, float currentLow, bool isLong) =>
    if na(positionAvgPrice) or trailOffsetPercent <= 0 or trailPercent <= 0
        na
    else
        var float trailingStopPrice = na
        var bool trailingActivated = false // Track if trailing has been activated

        if isLong
            // Activation price for long
            float activationPrice = positionAvgPrice * (1 + trailOffsetPercent / 100.0)

            // Check activation
            if not trailingActivated and currentHigh >= activationPrice
                trailingActivated := true

            // If activated, update the trailing stop price
            if trailingActivated
                // The stop trails 'trailPercent' below the highest price reached *since activation*
                // Need to track the highest high since activation
                var float highestHighSinceActivation = -9e99 // Initialize very low
                if trailingActivated
                    highestHighSinceActivation := math.max(nz(highestHighSinceActivation[1], currentHigh), currentHigh)
                else // Reset if not activated
                    highestHighSinceActivation := na

                // Calculate potential new trailing stop price
                float potentialTrailingStop = highestHighSinceActivation * (1 - trailPercent / 100.0)

                // Update trailing stop price - it can only move up
                trailingStopPrice := math.max(nz(trailingStopPrice[1], potentialTrailingStop), potentialTrailingStop)
                // Ensure the stop is not above the current low (avoids issues on sharp drops)
                trailingStopPrice := math.min(trailingStopPrice, currentLow) // Added this check for robustness

        else // Short Position
            // Activation price for short
            float activationPrice = positionAvgPrice * (1 - trailOffsetPercent / 100.0)

            // Check activation
            if not trailingActivated and currentLow <= activationPrice
                trailingActivated := true

            // If activated, update the trailing stop price
            if trailingActivated
                 // The stop trails 'trailPercent' above the lowest price reached *since activation*
                // Need to track the lowest low since activation
                var float lowestLowSinceActivation = 9e99 // Initialize very high
                if trailingActivated
                    lowestLowSinceActivation := math.min(nz(lowestLowSinceActivation[1], currentLow), currentLow)
                else // Reset if not activated
                    lowestLowSinceActivation := na

                // Calculate potential new trailing stop price
                float potentialTrailingStop = lowestLowSinceActivation * (1 + trailPercent / 100.0)

                 // Update trailing stop price - it can only move down
                trailingStopPrice := math.min(nz(trailingStopPrice[1], potentialTrailingStop), potentialTrailingStop)
                 // Ensure the stop is not below the current high (avoids issues on sharp rallies)
                trailingStopPrice := math.max(trailingStopPrice, currentHigh) // Corrected from min to max

        trailingStopPrice