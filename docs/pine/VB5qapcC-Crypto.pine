//@version=5

// https://www.tradingview.com/script/VB5qapcC-Crypto/
// import gliderfund/Crypto/1

// @description This Library includes functions related to crytocurrencies and their blockchain
library(title = "Crypto", overlay = true)






// #############################################
// #############################################
//             BTC BLOCK REWARD
// #############################################
// #############################################

// @function          Delivers the BTC block reward for a specific date/time
// @param t           Time of the current candle
// @returns           blockRewardBtc
export btcBlockReward(int t = time) =>

    // After the 5th halving, this function needs to be updated to include the halving date and time.
    var float initialReward = 50
    var float reward1       = initialReward / 2
    var float reward2       = initialReward / 4
    var float reward3       = initialReward / 8
    var float reward4       = initialReward / 16

    var timeHalving1  = timestamp(timezone = "UTC", year = 2012, month = 11, day = 28, hour = 15, minute = 24, second = 38)
    var timeHalving2  = timestamp(timezone = "UTC", year = 2016, month = 7, day = 9, hour = 16, minute = 46, second = 13)
    var timeHalving3  = timestamp(timezone = "UTC", year = 2020, month = 5, day = 11, hour = 19, minute = 23, second = 43)
    var timeHalving4  = timestamp(timezone = "UTC", year = 2024, month = 4, day = 20, hour = 0, minute = 9, second = 27)

    blockRewardBtc =
      timeHalving1 >= t ? initialReward :
      timeHalving2 >= t ? reward1 :
      timeHalving3 >= t ? reward2 :
      timeHalving4 >= t ? reward3 : reward4


    // Result
    blockRewardBtc

// End of Function
