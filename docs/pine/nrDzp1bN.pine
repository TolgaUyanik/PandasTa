//@version=5
// @description RSI 배경색 라이브러리
library("RSIBackgroundLib",dynamic_requests = true)
 
// @function RSI 계산 및 배경색 반환
// @param _symbol string 심볼
// @param _timeframe string 타임프레임
// @returns [float, float, float, color] RSI, RSI MA, RSI MA10, 배경색
export rsi_background(simple string _symbol, simple string _timeframe) =>
    rsi = request.security(_symbol, _timeframe, ta.rsi(close, 14))
    rsiMA = ta.sma(rsi, 14)
    rsiMA10 = ta.sma(rsi, 10)
    jung = rsi >= rsiMA10 and rsiMA10 >= rsiMA ? 1 : rsi < rsiMA10 and rsiMA10 < rsiMA ? -1 : 0
    rsi_back = rsi <= 30 ? color.new(color.black, 30) : 
               jung == 1 and rsi >= 40 and rsiMA10 >= 40 ? color.new(color.lime, 75) : 
               jung == -1 ? color.new(color.red, 75) : na
    [rsi, rsiMA, rsiMA10, rsi_back]   