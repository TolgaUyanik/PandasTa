//@version=5
indicator("Smart Order Blocks [Pro Version]", shorttitle="Smart OB Pro", overlay=true, max_bars_back=500, max_boxes_count=250)

// === INPUTS ===
group_pivots = "Pivot Settings"
group_display = "Display Settings"
group_alerts = "Alert Settings"

source = input.string("Wicks", options=['Wicks','Bodys'], title="Source", group=group_pivots)
leftLenH = input.int(10, title="Pivot High L", minval=1, group=group_pivots)
rightLenH = input.int(10, title="Pivot High R", minval=1, group=group_pivots)
leftLenL = input.int(10, title="Pivot Low L", minval=1, group=group_pivots)
rightLenL = input.int(10, title="Pivot Low R", minval=1, group=group_pivots)

extendOBs = input.bool(true, title="Extend OB until tapped", group=group_display)
boxSize = input.int(20, title="Box Width (if not extended)", group=group_display)
showLabels = input.bool(true, title="Show OB Labels", group=group_display)
showStrength = input.bool(true, title="Show OB Strength", group=group_display)
filterFresh = input.bool(true, title="Show Only Fresh OBs", group=group_display)

alertOnTap = input.bool(true, title="Alert when OB is tapped", group=group_alerts)

// === COLORS ===
bullColor = input.color(color.new(color.green, 60), title="Bullish OB", group=group_display)
bearColor = input.color(color.new(color.red, 60), title="Bearish OB", group=group_display)
closedColor = input.color(color.new(color.gray, 80), title="Invalid OB", group=group_display)

// === CALCULATIONS ===
hi = source == "Wicks" ? high : close
lo = source == "Wicks" ? low : close
ph = ta.pivothigh(hi, leftLenH, rightLenH)
pl = ta.pivotlow(lo, leftLenL, rightLenL)

// OB Storage
var box[] bullBoxes = array.new_box()
var box[] bearBoxes = array.new_box()
var label[] labels = array.new_label()

// === Strength Calculation ===
get_strength(size, vol) =>
    if size > 2 * ta.atr(14) and vol > ta.sma(volume, 20)
        "High"
    else if size > 1.2 * ta.atr(14)
        "Medium"
    else
        "Low"

// === CREATE OBs ===
if pl
    bullTop = hi[leftLenL]
    bullBottom = lo[leftLenL]
    moveSize = high - low
    strength = get_strength(moveSize, volume[leftLenL])
    bullLeft = bar_index - leftLenL
    bullRight = extendOBs ? bar_index + 1 : bar_index + boxSize
    b = box.new(bullLeft, bullTop, bullRight, bullBottom, bgcolor=bullColor, border_color=bullColor)
    array.push(bullBoxes, b)
    if showLabels
        labelText = "Bullish OB" + (showStrength ? "\n" + strength : "")
        array.push(labels, label.new(bullLeft, bullTop, text=labelText, color=color.new(color.green, 0), textcolor=color.white))

if ph
    bearTop = hi[leftLenH]
    bearBottom = lo[leftLenH]
    moveSize = high - low
    strength = get_strength(moveSize, volume[leftLenH])
    bearLeft = bar_index - leftLenH
    bearRight = extendOBs ? bar_index + 1 : bar_index + boxSize
    b = box.new(bearLeft, bearTop, bearRight, bearBottom, bgcolor=bearColor, border_color=bearColor)
    array.push(bearBoxes, b)
    if showLabels
        labelText = "Bearish OB" + (showStrength ? "\n" + strength : "")
        array.push(labels, label.new(bearLeft, bearTop, text=labelText, color=color.new(color.red, 0), textcolor=color.white))

// === Extend & Invalidate Logic ===
extend_and_check(boxArray, isBull) =>
    if array.size(boxArray) > 0
        for i = 0 to array.size(boxArray) - 1
            b = array.get(boxArray, i)
            r = box.get_right(b)
            t = box.get_top(b)
            btm = box.get_bottom(b)
            if r == bar_index
                touched = isBull ? low <= t : high >= btm
                if touched
                    if filterFresh
                        box.set_bgcolor(b, closedColor)
                        box.set_border_color(b, closedColor)
                    if alertOnTap
                        alert("Price tapped " + (isBull ? "Bullish" : "Bearish") + " OB", alert.freq_once_per_bar)
                    box.set_right(b, bar_index)
                else
                    box.set_right(b, bar_index + 1)

if extendOBs
    extend_and_check(bullBoxes, true)
    extend_and_check(bearBoxes, false)













