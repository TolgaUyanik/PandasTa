//@version=6
indicator("Bonifide PM PD ORB EMA Clouds + Structure", shorttitle="PMORB+MS", overlay=true, max_lines_count=500, max_bars_back=4900, max_boxes_count=500, max_labels_count=500)

// SETTINGS
groupMain = "Main Settings"
showPremarket    = input.bool(true, "Show Premarket Levels", group=groupMain)
premarketSession = input.session("0400-0930", "Premarket Session", group=groupMain)

showPrevDay      = input.bool(true, "Show Previous Day Levels", group=groupMain)

showORB          = input.bool(true, "Show ORB", group=groupMain)
orbSession       = input.session("0930-0945", "ORB Session", group=groupMain)

showEMACloud     = input.bool(true, "Show 9/21 Cloud", group=groupMain)
showTrendCloud   = input.bool(true, "Show 180/200 Cloud", group=groupMain)

emaFastLen       = input.int(9, "Fast EMA", group=groupMain)
emaSlowLen       = input.int(21, "Slow EMA", group=groupMain)
ema180Len        = input.int(180, "180 EMA", group=groupMain)
ema200Len        = input.int(200, "200 EMA", group=groupMain)

showCrossLine    = input.bool(true, "Show 9/21 Cross Return Line", group=groupMain)
crossExtendBars  = input.int(10, "Cross Line Extend Bars", minval=1, group=groupMain)
crossLineWidth   = input.int(2, "Cross Line Width", minval=1, maxval=5, group=groupMain)

// STRUCTURE SETTINGS
groupStructure = "Market Structure"
zigzag_len   = input.int(40, "ZigZag Length", group=groupStructure)
show_zigzag  = input.bool(true, "Show Zigzag", group=groupStructure)
zigzag_color = input.color(color.blue, "ZigZag Line Color", group=groupStructure)
zigzag_width = input.int(2, "ZigZag Line Width", minval=1, maxval=5, group=groupStructure)
show_labels  = input.bool(true, "Show HH, HL, LL, LH Labels", group=groupStructure)
text_size    = input.string(size.tiny, "Text Size", options=[size.tiny, size.small, size.normal, size.large, size.huge], group=groupStructure)

// COLORS
goldColor   = color.rgb(255, 215, 0)
pmHighColor = color.green
pmLowColor  = color.red
pdHighColor = color.green
pdLowColor  = color.red
orbColor    = input.color(color.gray, "ORB Color", group=groupMain)
crossColor  = color.white

cloudBull   = color.new(goldColor, 80)
cloudBear   = color.new(color.white, 80)
trendBull   = color.new(color.green, 85)
trendBear   = color.new(color.red, 85)

// DAY RESET
newDay = ta.change(time("1D")) != 0

// PREMARKET
inPremarket = not na(time(timeframe.period, premarketSession))

var float pmHigh = na
var float pmLow  = na
var line pmHighLine = na
var line pmLowLine  = na

if newDay
    pmHigh := na
    pmLow := na
    if not na(pmHighLine)
        line.delete(pmHighLine)
        pmHighLine := na
    if not na(pmLowLine)
        line.delete(pmLowLine)
        pmLowLine := na

if inPremarket
    pmHigh := na(pmHigh) ? high : math.max(pmHigh, high)
    pmLow := na(pmLow) ? low : math.min(pmLow, low)

pmEnd = (not inPremarket) and inPremarket[1]

if pmEnd and showPremarket and not na(pmHigh) and not na(pmLow)
    if not na(pmHighLine)
        line.delete(pmHighLine)
    if not na(pmLowLine)
        line.delete(pmLowLine)

    pmHighLine := line.new(
         x1=bar_index, y1=pmHigh,
         x2=bar_index + 1, y2=pmHigh,
         xloc=xloc.bar_index, extend=extend.right,
         color=pmHighColor, width=2, style=line.style_dashed)

    pmLowLine := line.new(
         x1=bar_index, y1=pmLow,
         x2=bar_index + 1, y2=pmLow,
         xloc=xloc.bar_index, extend=extend.right,
         color=pmLowColor, width=2, style=line.style_dashed)

// PREVIOUS DAY
pdHigh = request.security(syminfo.tickerid, "D", high, barmerge.gaps_off, barmerge.lookahead_on)
pdLow  = request.security(syminfo.tickerid, "D", low,  barmerge.gaps_off, barmerge.lookahead_on)

prevHighValue = pdHigh[1]
prevLowValue  = pdLow[1]

var line pdHighLine = na
var line pdLowLine  = na

if newDay and showPrevDay and not na(prevHighValue) and not na(prevLowValue)
    if not na(pdHighLine)
        line.delete(pdHighLine)
    if not na(pdLowLine)
        line.delete(pdLowLine)

    pdHighLine := line.new(
         x1=bar_index, y1=prevHighValue,
         x2=bar_index + 1, y2=prevHighValue,
         xloc=xloc.bar_index, extend=extend.right,
         color=pdHighColor, width=1, style=line.style_solid)

    pdLowLine := line.new(
         x1=bar_index, y1=prevLowValue,
         x2=bar_index + 1, y2=prevLowValue,
         xloc=xloc.bar_index, extend=extend.right,
         color=pdLowColor, width=1, style=line.style_solid)

if showPrevDay and na(pdHighLine) and na(pdLowLine) and not na(prevHighValue) and not na(prevLowValue)
    pdHighLine := line.new(
         x1=bar_index, y1=prevHighValue,
         x2=bar_index + 1, y2=prevHighValue,
         xloc=xloc.bar_index, extend=extend.right,
         color=pdHighColor, width=1, style=line.style_solid)

    pdLowLine := line.new(
         x1=bar_index, y1=prevLowValue,
         x2=bar_index + 1, y2=prevLowValue,
         xloc=xloc.bar_index, extend=extend.right,
         color=pdLowColor, width=1, style=line.style_solid)

// ORB
orbTime = time(timeframe.period, orbSession + ":1234567")
inORB = not na(orbTime)
firstORB = inORB and not inORB[1]

var float orbHigh = na
var float orbLow  = na
var line orbHighLine = na
var line orbLowLine  = na

if newDay
    orbHigh := na
    orbLow := na
    if not na(orbHighLine)
        line.delete(orbHighLine)
        orbHighLine := na
    if not na(orbLowLine)
        line.delete(orbLowLine)
        orbLowLine := na

if showORB
    if firstORB
        orbHigh := high
        orbLow := low
    else
        orbHigh := orbHigh[1]
        orbLow := orbLow[1]

    if inORB and high > orbHigh
        orbHigh := high
    if inORB and low < orbLow
        orbLow := low

orbEnd = (not inORB) and inORB[1]

if orbEnd and showORB and not na(orbHigh) and not na(orbLow)
    if not na(orbHighLine)
        line.delete(orbHighLine)
    if not na(orbLowLine)
        line.delete(orbLowLine)

    orbHighLine := line.new(
         x1=bar_index, y1=orbHigh,
         x2=bar_index + 1, y2=orbHigh,
         xloc=xloc.bar_index, extend=extend.right,
         color=orbColor, width=2, style=line.style_solid)

    orbLowLine := line.new(
         x1=bar_index, y1=orbLow,
         x2=bar_index + 1, y2=orbLow,
         xloc=xloc.bar_index, extend=extend.right,
         color=orbColor, width=2, style=line.style_solid)

// EMA CLOUDS
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
ema180  = ta.ema(close, ema180Len)
ema200  = ta.ema(close, ema200Len)

pFast = plot(showEMACloud ? emaFast : na, title="", color=color.new(color.white, 100), linewidth=1, display=display.none)
pSlow = plot(showEMACloud ? emaSlow : na, title="", color=color.new(color.white, 100), linewidth=1, display=display.none)

p180 = plot(showTrendCloud ? ema180 : na, title="", color=color.new(color.white, 100), linewidth=1, display=display.none)
p200 = plot(showTrendCloud ? ema200 : na, title="", color=color.new(color.white, 100), linewidth=1, display=display.none)

fill(pFast, pSlow, color=showEMACloud ? (emaFast >= emaSlow ? cloudBull : cloudBear) : na, title="9/21 Cloud")
fill(p180, p200, color=showTrendCloud ? (ema180 >= ema200 ? trendBull : trendBear) : na, title="180/200 Cloud")

// 9/21 CROSS RETURN LINE
bullCross = ta.crossover(emaFast, emaSlow)
bearCross = ta.crossunder(emaFast, emaSlow)

diffPrev = emaFast[1] - emaSlow[1]
diffCurr = emaFast - emaSlow
denom    = diffPrev - diffCurr
tRaw     = denom != 0 ? diffPrev / denom : 0.5
t        = math.max(0.0, math.min(1.0, tRaw))

fastAtCross = emaFast[1] + (emaFast - emaFast[1]) * t
slowAtCross = emaSlow[1] + (emaSlow - emaSlow[1]) * t
crossPrice  = (fastAtCross + slowAtCross) / 2.0

if showCrossLine and bullCross
    line.new(
         x1=bar_index,
         y1=crossPrice,
         x2=bar_index + crossExtendBars,
         y2=crossPrice,
         xloc=xloc.bar_index,
         extend=extend.none,
         color=crossColor,
         width=crossLineWidth,
         style=line.style_solid)

if showCrossLine and bearCross
    line.new(
         x1=bar_index,
         y1=crossPrice,
         x2=bar_index + crossExtendBars,
         y2=crossPrice,
         xloc=xloc.bar_index,
         extend=extend.none,
         color=crossColor,
         width=crossLineWidth,
         style=line.style_solid)

// MARKET STRUCTURE
var float[] high_points_arr = array.new_float()
var int[] high_index_arr = array.new_int()
var float[] low_points_arr = array.new_float()
var int[] low_index_arr = array.new_int()

to_up = high >= ta.highest(high, zigzag_len)
to_down = low <= ta.lowest(low, zigzag_len)

var int trend = 1
trend := nz(trend[1], 1)
trend := trend == 1 and to_down ? -1 : trend == -1 and to_up ? 1 : trend

last_trend_up_since = ta.barssince(to_up[1])
low_len = nz(last_trend_up_since > 0 ? last_trend_up_since : 1)
low_val = ta.lowest(low, low_len)
low_index = bar_index - ta.barssince(low == low_val)

last_trend_down_since = ta.barssince(to_down[1])
high_len = nz(last_trend_down_since > 0 ? last_trend_down_since : 1)
high_val = ta.highest(high, high_len)
high_index = bar_index - ta.barssince(high == high_val)

if ta.change(trend) != 0
    if trend == 1
        array.push(low_points_arr, low_val)
        array.push(low_index_arr, low_index)
    if trend == -1
        array.push(high_points_arr, high_val)
        array.push(high_index_arr, high_index)

h0  = array.size(high_points_arr) > 0 ? array.get(high_points_arr, array.size(high_points_arr) - 1) : na
h0i = array.size(high_index_arr) > 0 ? array.get(high_index_arr, array.size(high_index_arr) - 1) : na
h1  = array.size(high_points_arr) > 1 ? array.get(high_points_arr, array.size(high_points_arr) - 2) : na
h1i = array.size(high_index_arr) > 1 ? array.get(high_index_arr, array.size(high_index_arr) - 2) : na

l0  = array.size(low_points_arr) > 0 ? array.get(low_points_arr, array.size(low_points_arr) - 1) : na
l0i = array.size(low_index_arr) > 0 ? array.get(low_index_arr, array.size(low_index_arr) - 1) : na
l1  = array.size(low_points_arr) > 1 ? array.get(low_points_arr, array.size(low_points_arr) - 2) : na
l1i = array.size(low_index_arr) > 1 ? array.get(low_index_arr, array.size(low_index_arr) - 2) : na

if ta.change(trend) != 0
    if show_zigzag
        if trend == 1 and not na(h0i) and not na(l0i)
            line.new(h0i, h0, l0i, l0, color=zigzag_color, width=zigzag_width, style=line.style_solid, extend=extend.none)
        if trend == -1 and not na(l0i) and not na(h0i)
            line.new(l0i, l0, h0i, h0, color=zigzag_color, width=zigzag_width, style=line.style_solid, extend=extend.none)

    if show_labels
        if not na(h0) and not na(h1) and not na(h0i)
            label.new(h0i, h0, h0 > h1 ? "HH" : "LH", color=h0 > h1 ? color.green : color.red, textcolor=color.white, size=text_size, style=label.style_label_down)
        if not na(l0) and not na(l1) and not na(l0i)
            label.new(l0i, l0, l0 < l1 ? "LL" : "HL", color=l0 < l1 ? color.red : color.green, textcolor=color.white, size=text_size, style=label.style_label_up)

// RSI + SMA
// ─────────────────────────────
rsi = ta.rsi(close, 14)
sma = ta.sma(rsi, 14)
bullish = rsi > sma

// ─────────────────────────────
// 200 EMA
// ─────────────────────────────
bullTrend = close > ema200

// ─────────────────────────────
// TOP TABLE (RSI + EMA SIDE BY SIDE)
// ─────────────────────────────
var table topTable = table.new(position.top_center, 2, 1)

if barstate.islast
    // RSI
    table.cell(topTable, 0, 0, bullish ? "BULLISH RSI" : "BEARISH RSI",
     text_color=color.white,
     bgcolor=bullish ? color.green : color.red)

    // EMA 200
    table.cell(topTable, 1, 0, bullTrend ? "ABOVE 200 EMA" : "BELOW 200 EMA",
     text_color=color.white,
     bgcolor=bullTrend ? color.green : color.red)


// ─────────────────────────────
// BOTTOM TABLE (REMINDERS)
// ─────────────────────────────
var table reminderTable = table.new(position.bottom_center, 5, 1)

if barstate.islast
    table.cell(reminderTable, 0, 0, "4 HR TREND", text_color=color.white, bgcolor=color.new(color.blue, 40))
    table.cell(reminderTable, 1, 0, "1 HR BOS",   text_color=color.white, bgcolor=color.new(color.green, 40))
    table.cell(reminderTable, 2, 0, "30 min zone",   text_color=color.white, bgcolor=color.new(color.purple, 40))
    table.cell(reminderTable, 3, 0, "15 min zone",  text_color=color.white, bgcolor=color.new(color.orange, 40))
    table.cell(reminderTable, 4, 0, "FIB",   text_color=color.white, bgcolor=color.new(color.red, 40))