//@version=6
//@description Advanced Pine Script v6 calculation library for statistical, normalization, trend, and risk metrics.
library("HighClassCalculations", overlay = false)

_lookback(int len) =>
    math.max(1, len)

_hasHistory(int len) =>
    bar_index + 1 >= len

_clamp(float value, float minValue, float maxValue) =>
    math.max(minValue, math.min(maxValue, value))

_safeDiv(float numerator, float denominator, float fallback = na) =>
    not na(numerator) and not na(denominator) and denominator != 0 ? numerator / denominator : fallback

_medianFromSorted(float[] sortedValues) =>
    int size = array.size(sortedValues)
    if size == 0
        na
    else
        int mid = math.floor(size / 2)
        size % 2 == 0 ? (array.get(sortedValues, mid - 1) + array.get(sortedValues, mid)) / 2.0 : array.get(sortedValues, mid)

//@function Safe division helper that prevents division-by-zero errors.
//@param numerator Value on the top of the fraction.
//@param denominator Value on the bottom of the fraction.
//@param fallback Value returned when denominator is zero.
//@returns Result of the division or fallback.
export safeDiv(float numerator, float denominator, float fallback = na) =>
    _safeDiv(numerator, denominator, fallback)

//@function Clamps a value into a fixed range.
//@param value Source value.
//@param minValue Minimum allowed value.
//@param maxValue Maximum allowed value.
//@returns Clamped value.
export clamp(float value, float minValue, float maxValue) =>
    _clamp(value, minValue, maxValue)

//@function Rescales a value from one range into another range.
//@param value Source value.
//@param oldMin Source range minimum.
//@param oldMax Source range maximum.
//@param newMin Target range minimum.
//@param newMax Target range maximum.
//@returns Rescaled value.
export rescale(float value, float oldMin, float oldMax, float newMin = 0.0, float newMax = 1.0) =>
    float ratio = _safeDiv(value - oldMin, oldMax - oldMin, 0.0)
    newMin + ratio * (newMax - newMin)

//@function Returns the min-max normalized position of a series within a rolling window.
//@param src Source series.
//@param len Rolling lookback window.
//@returns Value between 0 and 1 when the range is valid.
export normalize(float src, int len) =>
    int lookback = _lookback(len)
    if not _hasHistory(lookback)
        na
    else
        float lowestValue = ta.lowest(src, lookback)
        float highestValue = ta.highest(src, lookback)
        _safeDiv(src - lowestValue, highestValue - lowestValue, 0.0)

//@function Returns the source position inside its rolling range as a percentage.
//@param src Source series.
//@param len Rolling lookback window.
//@returns Value between 0 and 100 when the range is valid.
export rangePercent(float src, int len) =>
    normalize(src, len) * 100.0

//@function Calculates the z-score of a series.
//@param src Source series.
//@param len Rolling lookback window.
//@returns Standardized z-score.
export zScore(float src, int len) =>
    int lookback = _lookback(len)
    if not _hasHistory(lookback)
        na
    else
        float mean = ta.sma(src, lookback)
        float deviation = ta.stdev(src, lookback)
        _safeDiv(src - mean, deviation, 0.0)

//@function Calculates a robust z-score using median absolute deviation.
//@param src Source series.
//@param len Rolling lookback window.
//@returns Robust z-score less sensitive to outliers.
export robustZScore(float src, int len) =>
    int lookback = _lookback(len)
    if not _hasHistory(lookback)
        na
    else
        float[] values = array.new_float(0)
        for i = 0 to lookback - 1
            array.push(values, src[i])
        array.sort(values)
        float median = _medianFromSorted(values)
        float[] deviations = array.new_float(0)
        for i = 0 to lookback - 1
            array.push(deviations, math.abs(array.get(values, i) - median))
        array.sort(deviations)
        float mad = _medianFromSorted(deviations)
        _safeDiv(0.6745 * (src - median), mad, 0.0)

//@function Calculates percentile rank for the latest value inside a rolling window.
//@param src Source series.
//@param len Rolling lookback window.
//@returns Percentile rank from 0 to 100.
export percentileRank(float src, int len) =>
    int lookback = _lookback(len)
    if not _hasHistory(lookback)
        na
    else
        float current = src
        float count = 0.0
        for i = 0 to lookback - 1
            if src[i] <= current
                count := count + 1
        100.0 * _safeDiv(count, lookback, 0.0)

//@function Calculates the value at a requested percentile inside a rolling window.
//@param src Source series.
//@param len Rolling lookback window.
//@param percentile Requested percentile from 0 to 100.
//@returns Percentile value.
export percentileValue(float src, int len, float percentile) =>
    int lookback = _lookback(len)
    if not _hasHistory(lookback)
        na
    else
        float boundedPercentile = _clamp(percentile, 0.0, 100.0)
        float[] values = array.new_float(0)
        for i = 0 to lookback - 1
            array.push(values, src[i])
        array.sort(values)
        int idx = int(math.round((lookback - 1) * boundedPercentile / 100.0))
        array.get(values, idx)

//@function Calculates simple arithmetic return versus the previous bar.
//@param src Price or equity series.
//@returns One-bar simple return.
export simpleReturn(float src) =>
    not na(src[1]) and src[1] != 0 ? src / src[1] - 1.0 : na

//@function Calculates log return versus the previous bar.
//@param src Price or equity series.
//@returns One-bar log return.
export logReturn(float src) =>
    src > 0 and src[1] > 0 ? math.log(src / src[1]) : na

//@function Calculates cumulative return over a fixed lookback.
//@param src Price or equity series.
//@param len Lookback window.
//@returns Return from src[len] to current src.
export compoundedReturn(float src, int len) =>
    int lookback = _lookback(len)
    not na(src[lookback]) and src[lookback] != 0 ? src / src[lookback] - 1.0 : na

//@function Calculates realized volatility from log returns and annualizes it.
//@param src Price or equity series.
//@param len Rolling lookback window.
//@param annualization Number of bars used for annualization.
//@returns Annualized volatility.
export realizedVolatility(float src, int len, float annualization = 252.0) =>
    int lookback = _lookback(len)
    _hasHistory(lookback + 1) ? ta.stdev(logReturn(src), lookback) * math.sqrt(annualization) : na

//@function Calculates downside deviation from a return series.
//@param returnSeries Series of returns, not raw price.
//@param len Rolling lookback window.
//@param mar Minimum acceptable return.
//@param annualization Number of bars used for annualization.
//@returns Annualized downside deviation.
export downsideDeviation(float returnSeries, int len, float mar = 0.0, float annualization = 252.0) =>
    int lookback = _lookback(len)
    if not _hasHistory(lookback)
        na
    else
        float squaredDownside = 0.0
        for i = 0 to lookback - 1
            float diff = math.min(returnSeries[i] - mar, 0.0)
            squaredDownside := squaredDownside + diff * diff
        math.sqrt(_safeDiv(squaredDownside, lookback, 0.0)) * math.sqrt(annualization)

//@function Calculates a rolling Sharpe ratio from a return series.
//@param returnSeries Series of returns, not raw price.
//@param len Rolling lookback window.
//@param riskFreeRate Per-bar risk free rate.
//@param annualization Number of bars used for annualization.
//@returns Annualized Sharpe ratio.
export rollingSharpe(float returnSeries, int len, float riskFreeRate = 0.0, float annualization = 252.0) =>
    int lookback = _lookback(len)
    if not _hasHistory(lookback)
        na
    else
        float excessMean = ta.sma(returnSeries - riskFreeRate, lookback)
        float deviation = ta.stdev(returnSeries, lookback)
        _safeDiv(excessMean, deviation, 0.0) * math.sqrt(annualization)

//@function Calculates a rolling Sortino ratio from a return series.
//@param returnSeries Series of returns, not raw price.
//@param len Rolling lookback window.
//@param mar Minimum acceptable return.
//@param annualization Number of bars used for annualization.
//@returns Annualized Sortino ratio.
export rollingSortino(float returnSeries, int len, float mar = 0.0, float annualization = 252.0) =>
    int lookback = _lookback(len)
    if not _hasHistory(lookback)
        na
    else
        float excessMean = ta.sma(returnSeries - mar, lookback)
        float downside = downsideDeviation(returnSeries, lookback, mar, annualization)
        _safeDiv(excessMean * math.sqrt(annualization), downside, 0.0)

//@function Calculates Kaufman's efficiency ratio.
//@param src Source series.
//@param len Rolling lookback window.
//@returns Efficiency ratio from 0 to 1.
export efficiencyRatio(float src, int len) =>
    int lookback = _lookback(len)
    if not _hasHistory(lookback + 1)
        na
    else
        float direction = math.abs(src - src[lookback])
        float volatility = math.sum(math.abs(src - src[1]), lookback)
        _safeDiv(direction, volatility, 0.0)

//@function Calculates rolling linear regression slope.
//@param src Source series.
//@param len Rolling lookback window.
//@returns Slope per bar.
export regressionSlope(float src, int len) =>
    int lookback = _lookback(len)
    ta.linreg(src, lookback, 0) - ta.linreg(src, lookback, 1)

//@function Converts rolling regression slope into an angle.
//@param src Source series.
//@param len Rolling lookback window.
//@returns Slope angle in degrees.
export regressionAngle(float src, int len) =>
    math.atan(regressionSlope(src, len)) * 180.0 / math.pi

//@function Calculates rolling beta versus a benchmark series.
//@param asset Asset series.
//@param benchmark Benchmark series.
//@param len Rolling lookback window.
//@returns Beta coefficient.
export beta(float asset, float benchmark, int len) =>
    int lookback = _lookback(len)
    float corr = ta.correlation(asset, benchmark, lookback)
    float assetDeviation = ta.stdev(asset, lookback)
    float benchmarkDeviation = ta.stdev(benchmark, lookback)
    corr * _safeDiv(assetDeviation, benchmarkDeviation, 0.0)

//@function Calculates Jensen-style alpha versus a benchmark series.
//@param asset Asset return series.
//@param benchmark Benchmark return series.
//@param len Rolling lookback window.
//@param riskFreeRate Per-bar risk free rate.
//@returns Alpha over the rolling window.
export alpha(float asset, float benchmark, int len, float riskFreeRate = 0.0) =>
    int lookback = _lookback(len)
    float assetMean = ta.sma(asset, lookback)
    float benchmarkMean = ta.sma(benchmark, lookback)
    assetMean - (riskFreeRate + beta(asset, benchmark, lookback) * (benchmarkMean - riskFreeRate))

//@function Calculates the Ulcer Index for a series.
//@param src Price or equity series.
//@param len Rolling lookback window.
//@returns Ulcer Index value.
export ulcerIndex(float src, int len) =>
    int lookback = _lookback(len)
    if not _hasHistory(lookback)
        na
    else
        float drawdownSquared = 0.0
        for i = 0 to lookback - 1
            float peak = ta.highest(src, lookback)[i]
            float drawdown = not na(peak) and peak != 0 ? (src[i] - peak) / peak * 100.0 : 0.0
            drawdownSquared := drawdownSquared + drawdown * drawdown
        math.sqrt(_safeDiv(drawdownSquared, lookback, 0.0))

//@function Calculates the maximum drawdown over a rolling window.
//@param src Price or equity series.
//@param len Rolling lookback window.
//@returns Maximum drawdown as a negative decimal.
export maxDrawdown(float src, int len) =>
    int lookback = _lookback(len)
    if not _hasHistory(lookback)
        na
    else
        float worstDrawdown = 0.0
        for i = 0 to lookback - 1
            float peak = ta.highest(src, lookback)[i]
            float drawdown = not na(peak) and peak != 0 ? (src[i] - peak) / peak : 0.0
            worstDrawdown := math.min(worstDrawdown, drawdown)
        worstDrawdown

//@function Calculates ATR as a percentage of price.
//@param len ATR lookback window.
//@param src Reference price used for the percentage denominator.
//@returns ATR percent.
export atrPercent(simple int len, float src = close) =>
    100.0 * _safeDiv(ta.atr(len), src, 0.0)

//@function Calculates relative volume versus its rolling average.
//@param len Rolling lookback window.
//@returns Volume divided by average volume.
export relativeVolume(simple int len) =>
    _safeDiv(volume, ta.sma(volume, len), 0.0)

//@function Returns a comma-separated list of all exported calculation helpers.
//@returns Function catalog for quick reference.
export getAllFunctions() =>
    "safeDiv,clamp,rescale,normalize,rangePercent,zScore,robustZScore,percentileRank,percentileValue,simpleReturn,logReturn,compoundedReturn,realizedVolatility,downsideDeviation,rollingSharpe,rollingSortino,efficiencyRatio,regressionSlope,regressionAngle,beta,alpha,ulcerIndex,maxDrawdown,atrPercent,relativeVolume"
