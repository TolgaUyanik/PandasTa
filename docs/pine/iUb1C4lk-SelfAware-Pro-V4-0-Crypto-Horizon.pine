//@version=6
indicator("SelfAware Pro V4.0 [Crypto Horizon]", overlay=true, max_labels_count=500)

// ======================================================
// ⚙️ SYSTEM SETTINGS
// ======================================================
swingLength = input.int(20, "Swing Lookback", group="Logic")
emaLength   = input.int(50, "Environment EMA", group="Logic")
tqiWindow   = input.int(20, "Trend Quality Window", group="Logic")

// 🎨 Pro Palette
c_bull   = #00E676
c_bear   = #FF5252
c_blue   = #2962FF
c_orange = #FF9800
c_dark   = #131722
c_white  = #FFFFFF
c_neut   = #808080

// ======================================================
// 🧠 ADAPTIVE ENGINE
// ======================================================
float change = math.abs(close - close[tqiWindow])
float vol    = math.sum(math.abs(close - close[1]), tqiWindow)
float er     = vol != 0 ? change / vol : 0
float tqi    = math.min(100, er * 100)

// Environment Awareness
ema1h = request.security(syminfo.tickerid, "60", ta.ema(close, emaLength))
isBull = close > ema1h
isBear = close < ema1h

// Swing Data
sHigh  = ta.highest(high, swingLength)
sLow   = ta.lowest(low, swingLength)
sRange = sHigh - sLow
fib50  = sHigh - (sRange * 0.5)

// ======================================================
// ⏳ CRYPTO HORIZON ENGINE (Time Awareness)
// ======================================================
// Analyzing ATR vs Swing Range to predict hold time
atr = ta.atr(14)
ratio = sRange / atr

string waitTime  = "Calculating..."
string horizon   = "SCALP"
color horizonCol = c_orange

if ratio < 1.5
    waitTime   := "30m - 45m"
    horizon    := "SCALP"
    horizonCol := c_orange
else if ratio >= 1.5 and ratio < 3.0
    waitTime   := "1h - 2h"
    horizon    := "INTRADAY"
    horizonCol := c_blue
else if ratio >= 3.0 and ratio < 6.0
    waitTime   := "4h - 6h"
    horizon    := "SWING"
    horizonCol := #9C27B0 // Purple for Swing
else if ratio >= 6.0 and ratio < 12.0
    waitTime   := "1 Day"
    horizon    := "POSITION"
    horizonCol := #E91E63 // Pink for Long Swing
else
    waitTime   := "3 Days+"
    horizon    := "MACRO"
    horizonCol := #F44336 // Red for Macro

// ======================================================
// 📈 WIN-RATE CALCULATION
// ======================================================
var int totalTrades = 0
var int wins = 0
var int lastDir = 0 

longSignal  = isBull and ta.crossover(close, fib50) and tqi > 20
shortSignal = isBear and ta.crossunder(close, fib50) and tqi > 20

if longSignal
    totalTrades += 1
    lastDir := 1
if shortSignal
    totalTrades += 1
    lastDir := -1

if lastDir == 1 and high >= sHigh
    wins += 1
    lastDir := 0
if lastDir == -1 and low <= sLow
    wins += 1
    lastDir := 0

float winRate = totalTrades > 0 ? (wins / float(totalTrades)) * 100 : 0

// ======================================================
// 📊 THE PRO HUD V4.0 (Crypto Focused)
// ======================================================
var table hud = table.new(position.top_right, 2, 15, border_width=1, border_color=color.new(c_white, 80))

// Candle Power Logic
volPower = volume > ta.sma(volume, 20) ? "STRONG" : "WEAK"
powerCol = volPower == "STRONG" ? c_bull : c_neut

if barstate.islast
    table.cell(hud, 0, 0, "SelfAware AI",  bgcolor=c_blue,   text_color=c_white)
    table.cell(hud, 1, 0, "V4.0 CRYPTO",     bgcolor=c_blue,   text_color=c_white)
    
    // --- TIME AWARENESS SECTION ---
    table.cell(hud, 0, 1, "Trade Horizon", bgcolor=c_dark,   text_color=color.gray)
    table.cell(hud, 1, 1, horizon,         bgcolor=horizonCol, text_color=c_white)
    
    table.cell(hud, 0, 2, "Wait Time",     bgcolor=c_dark,   text_color=color.gray)
    table.cell(hud, 1, 2, waitTime,        bgcolor=c_dark,   text_color=c_white)

    // --- MARKET STATE ---
    table.cell(hud, 0, 3, "Trend Regime",  bgcolor=c_dark,   text_color=color.gray)
    table.cell(hud, 1, 3, isBull ? "BULLISH" : "BEARISH", bgcolor=isBull ? c_bull : c_bear, text_color=color.black)
    
    table.cell(hud, 0, 4, "Win Rate",      bgcolor=c_dark,   text_color=color.gray)
    table.cell(hud, 1, 4, str.tostring(winRate, "#.0") + "%", bgcolor=winRate > 50 ? c_bull : c_orange, text_color=color.black)

    table.cell(hud, 0, 5, "Candle Power",  bgcolor=c_dark,   text_color=color.gray)
    table.cell(hud, 1, 5, volPower,        bgcolor=powerCol,  text_color=color.black)

    table.cell(hud, 0, 6, "TQI Score",     bgcolor=c_dark,   text_color=color.gray)
    table.cell(hud, 1, 6, str.tostring(tqi, "#.0") + "%", bgcolor=tqi > 40 ? c_bull : c_orange, text_color=color.black)

    table.cell(hud, 0, 7, "Swing Range",   bgcolor=c_dark,   text_color=color.gray)
    table.cell(hud, 1, 7, str.tostring(sRange, "#.####"), bgcolor=c_dark, text_color=c_white)

    table.cell(hud, 0, 8, "Bot Status",    bgcolor=c_dark,   text_color=color.gray)
    table.cell(hud, 1, 8, "SCANNING",      bgcolor=c_orange, text_color=c_dark)

// ======================================================
// 🔔 SIGNALS
// ======================================================
plot(fib50, "Decision Level", color=color.new(c_white, 40), linewidth=1, style=plot.style_stepline)
bgcolor(isBull ? color.new(c_bull, 94) : color.new(c_bear, 94))

if longSignal
    label.new(bar_index, low, "BUY\nHorizon: " + waitTime, color=c_bull, textcolor=color.black, style=label.style_label_up, size=size.small)

if shortSignal
    label.new(bar_index, high, "SELL\nHorizon: " + waitTime, color=c_bear, textcolor=color.white, style=label.style_label_down, size=size.small)