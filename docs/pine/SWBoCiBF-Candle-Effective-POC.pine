//@version=6
indicator("Candle POC", overlay=true, max_boxes_count=1500)

grp = "POC Rectangle"

subTF = input.timeframe("1", "Sub-bar Timeframe (must be < chart TF)", group=grp)

bullHighColor = input.color(color.new(color.green, 0), "Bull High Volume Color", group=grp)
bullAvgColor = input.color(color.new(color.lime, 20), "Bull Average Volume Color", group=grp)
bullLowColor = input.color(color.new(color.lime, 70), "Bull Low Volume Color", group=grp)

bearHighColor = input.color(color.new(color.purple, 0), "Bear High Volume Color", group=grp)
bearAvgColor = input.color(color.new(color.red, 20), "Bear Average Volume Color", group=grp)
bearLowColor = input.color(color.new(color.red, 70), "Bear Low Volume Color", group=grp)

neutralColor = input.color(color.new(color.gray, 60), "Neutral Color", group=grp)

thickPct = input.float(10.0, "Height (% of candle range)", minval=1.0, maxval=50.0, step=1.0, group=grp)

avgVolLength = input.int(20, "Average Volume Length", minval=1, group=grp)
highVolMultiplier = input.float(1.2, "High Volume Multiplier", minval=1.0, step=0.1, group=grp)
lowVolMultiplier = input.float(0.8, "Low Volume Multiplier", minval=0.1, maxval=1.0, step=0.1, group=grp)

// Sub-bar data
subOpen = request.security_lower_tf(syminfo.tickerid, subTF, open)
subHigh = request.security_lower_tf(syminfo.tickerid, subTF, high)
subLow = request.security_lower_tf(syminfo.tickerid, subTF, low)
subClose = request.security_lower_tf(syminfo.tickerid, subTF, close)
subVol = request.security_lower_tf(syminfo.tickerid, subTF, volume)

// Find sub-bar with maximum volume
pocPrice = float(na)
pocSide = 0
pocVol = float(na)

if array.size(subVol) > 0
    idx = array.indexof(subVol, array.max(subVol))

    pocPrice := (array.get(subHigh, idx) + array.get(subLow, idx)) / 2.0
    pocVol := array.get(subVol, idx)

    pocOpen = array.get(subOpen, idx)
    pocClose = array.get(subClose, idx)

    pocSide := pocClose > pocOpen ? 1 : pocClose < pocOpen ? -1 : 0

// Average POC volume
avgPocVol = ta.sma(pocVol, avgVolLength)

isHighVol = not na(avgPocVol) and pocVol > avgPocVol * highVolMultiplier
isLowVol = not na(avgPocVol) and pocVol < avgPocVol * lowVolMultiplier

// Color by side + POC volume strength
pocColor = neutralColor

if pocSide == 1
    pocColor := isHighVol ? bullHighColor : isLowVol ? bullLowColor : bullAvgColor
else if pocSide == -1
    pocColor := isHighVol ? bearHighColor : isLowVol ? bearLowColor : bearAvgColor

// Draw POC rectangle
candleRange = high - low
halfH = candleRange * (thickPct / 100.0) / 2.0

if not na(pocPrice) and candleRange > 0
    box.new(left=bar_index - 1, top=pocPrice + halfH, right=bar_index + 1, bottom=pocPrice - halfH, xloc=xloc.bar_index, bgcolor=pocColor, border_color=color.new(pocColor, 50), border_width=1)