//@version=5
strategy("XAUUSD RSI Long + Short Backtest", overlay=true, pyramiding=0, default_qty_type=strategy.fixed, default_qty_value=2, initial_capital=10000, currency=currency.USD)

// Inputs
rsiTimeframe = input.timeframe("5", "RSI Timeframe")
rsiLength = input.int(14, "RSI Length", minval=1)

longRsiLevel = input.float(29.0, "Buy When RSI Below", step=0.1)
shortRsiLevel = input.float(71.0, "Short When RSI Above", step=0.1)

enableLong = input.bool(true, "Enable Buy Trades")
enableShort = input.bool(true, "Enable Short Trades")

lotSize = input.float(0.02, "Lot Size", step=0.01)
ouncesPerLot = input.float(100.0, "Ounces Per 1 Lot", step=1)

takeProfitUsd = input.float(20.0, "Take Profit USD", step=1)
stopLossUsd = input.float(20.0, "Stop Loss USD", step=1)

showTpSlLines = input.bool(true, "Show TP / SL Lines")
showSignals = input.bool(true, "Show Buy / Short Signals")
showTable = input.bool(true, "Show PnL Table")

// Position size
tradeQty = lotSize * ouncesPerLot

// RSI from selected timeframe
rsiValue = request.security(syminfo.tickerid, rsiTimeframe, ta.rsi(close, rsiLength), barmerge.gaps_off, barmerge.lookahead_off)

// Convert USD TP/SL into XAUUSD price movement
tpMove = takeProfitUsd / tradeQty
slMove = stopLossUsd / tradeQty

// Entry conditions
longCondition = enableLong and rsiValue < longRsiLevel and strategy.position_size == 0
shortCondition = enableShort and rsiValue > shortRsiLevel and strategy.position_size == 0

if longCondition
    strategy.entry("Buy", strategy.long, qty=tradeQty)

if shortCondition
    strategy.entry("Short", strategy.short, qty=tradeQty)

// Exit prices
longTakeProfit = strategy.position_avg_price + tpMove
longStopLoss = strategy.position_avg_price - slMove

shortTakeProfit = strategy.position_avg_price - tpMove
shortStopLoss = strategy.position_avg_price + slMove

if strategy.position_size > 0
    strategy.exit("Buy TP / SL", from_entry="Buy", limit=longTakeProfit, stop=longStopLoss)

if strategy.position_size < 0
    strategy.exit("Short TP / SL", from_entry="Short", limit=shortTakeProfit, stop=shortStopLoss)

// Visual signals
plotshape(showSignals and longCondition, title="Buy Signal", style=shape.labelup, location=location.belowbar, color=color.green, text="BUY", textcolor=color.white)
plotshape(showSignals and shortCondition, title="Short Signal", style=shape.labeldown, location=location.abovebar, color=color.red, text="SHORT", textcolor=color.white)

// TP / SL / Entry lines
activeTakeProfit = strategy.position_size > 0 ? longTakeProfit : strategy.position_size < 0 ? shortTakeProfit : na
activeStopLoss = strategy.position_size > 0 ? longStopLoss : strategy.position_size < 0 ? shortStopLoss : na
activeEntry = strategy.position_size != 0 ? strategy.position_avg_price : na

plot(showTpSlLines ? activeTakeProfit : na, title="Take Profit", color=color.green, linewidth=2, style=plot.style_linebr)
plot(showTpSlLines ? activeStopLoss : na, title="Stop Loss", color=color.red, linewidth=2, style=plot.style_linebr)
plot(showTpSlLines ? activeEntry : na, title="Entry Price", color=color.blue, linewidth=2, style=plot.style_linebr)

// Background colors
bgcolor(rsiValue < longRsiLevel ? color.new(color.green, 88) : na)
bgcolor(rsiValue > shortRsiLevel ? color.new(color.red, 88) : na)

// PnL table
var table pnlTable = table.new(position.top_right, 2, 8, border_width=1)

if barstate.islast and showTable
    winRate = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100 : 0.0
    totalPnl = strategy.netprofit + strategy.openprofit
    pnlColor = totalPnl >= 0 ? color.green : color.red
    netColor = strategy.netprofit >= 0 ? color.green : color.red
    openColor = strategy.openprofit >= 0 ? color.green : color.red
    positionText = strategy.position_size > 0 ? "BUY OPEN" : strategy.position_size < 0 ? "SHORT OPEN" : "NO TRADE"

    table.cell(pnlTable, 0, 0, "Total PnL", bgcolor=color.black, text_color=color.white)
    table.cell(pnlTable, 1, 0, "$" + str.tostring(totalPnl, "#.##"), bgcolor=pnlColor, text_color=color.white)

    table.cell(pnlTable, 0, 1, "Net Profit", bgcolor=color.black, text_color=color.white)
    table.cell(pnlTable, 1, 1, "$" + str.tostring(strategy.netprofit, "#.##"), bgcolor=netColor, text_color=color.white)

    table.cell(pnlTable, 0, 2, "Open PnL", bgcolor=color.black, text_color=color.white)
    table.cell(pnlTable, 1, 2, "$" + str.tostring(strategy.openprofit, "#.##"), bgcolor=openColor, text_color=color.white)

    table.cell(pnlTable, 0, 3, "Closed Trades", bgcolor=color.black, text_color=color.white)
    table.cell(pnlTable, 1, 3, str.tostring(strategy.closedtrades), bgcolor=color.black, text_color=color.white)

    table.cell(pnlTable, 0, 4, "Win Rate", bgcolor=color.black, text_color=color.white)
    table.cell(pnlTable, 1, 4, str.tostring(winRate, "#.##") + "%", bgcolor=color.black, text_color=color.white)

    table.cell(pnlTable, 0, 5, "Current RSI", bgcolor=color.black, text_color=color.white)
    table.cell(pnlTable, 1, 5, str.tostring(rsiValue, "#.##"), bgcolor=color.black, text_color=color.white)

    table.cell(pnlTable, 0, 6, "Position", bgcolor=color.black, text_color=color.white)
    table.cell(pnlTable, 1, 6, positionText, bgcolor=color.black, text_color=color.white)

    table.cell(pnlTable, 0, 7, "Lot Size", bgcolor=color.black, text_color=color.white)
    table.cell(pnlTable, 1, 7, str.tostring(lotSize), bgcolor=color.black, text_color=color.white)