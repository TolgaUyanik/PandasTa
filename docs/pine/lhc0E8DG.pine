//@version=6

// @description TODO: add library description here
library("TickerLibrary", overlay = true)

isTicker() =>
	math.abs(open - close[1]) > (1 * syminfo.mintick)

export update(string session) =>
	isSessionValid = not na(time('', session))
	if (isSessionValid)
		isTicker()
	else
		false

