//@version=6
indicator("Previous Session Volume Profile Levels (NY 5pm-5pm)", overlay=true, max_lines_count=500, max_labels_count=500)

// --- Settings ---
rows = input.int(100, "Profile Resolution (internal bins)", minval=10, maxval=500, tooltip="Higher = more accurate POC/Value Area. Bars are NOT displayed, this only affects calculation precision.")
vaPercent = input.float(70, "Value Area %", minval=50, maxval=95, step=1)
pocColor = input.color(color.yellow, "POC Color")
vahColor = input.color(color.red, "VAH Color")
valColor = input.color(color.new(color.green, 0), "VAL Color")
lineWidth = input.int(2, "Line Width", minval=1, maxval=5)
showLabels = input.bool(true, "Show Text Labels")
labelSize = input.string("normal", "Label Font Size", options=["tiny", "small", "normal", "large", "huge"])

// --- Session: 5pm - 5pm New York time, every day ---
sessionString = "1700-1700:1234567"
sessionStart = time("D", sessionString, "America/New_York")
newSession = ta.change(sessionStart) != 0

// --- Persistent storage for current session's intrabar samples ---
var array<float> priceSamples = array.new<float>()
var array<float> volSamples = array.new<float>()

// --- Persistent line/label refs ---
var line pocLine = na
var line vahLine = na
var line valLine = na
var label pocLbl = na
var label vahLbl = na
var label valLbl = na

// --- Pull 1-minute price/volume data for accurate intrasession distribution ---
[lowPrices, lowVolumes] = request.security_lower_tf(syminfo.tickerid, "1", [close, volume])

// --- Helper to map string size input to a label size constant ---
f_size(s) =>
    s == "tiny" ? size.tiny :
     s == "small" ? size.small :
     s == "large" ? size.large :
     s == "huge" ? size.huge : size.normal

lblSize = f_size(labelSize)

// --- On a new session, finalize the JUST-COMPLETED session's profile ---
if newSession and array.size(priceSamples) > 0
    sessHigh = array.max(priceSamples)
    sessLow = array.min(priceSamples)
    rowHeight = (sessHigh - sessLow) / rows

    if rowHeight > 0
        binVol = array.new_float(rows, 0.0)
        for i = 0 to array.size(priceSamples) - 1
            p = array.get(priceSamples, i)
            v = array.get(volSamples, i)
            idx = int(math.min(math.max(math.floor((p - sessLow) / rowHeight), 0), rows - 1))
            array.set(binVol, idx, array.get(binVol, idx) + v)

        pocIdx = array.indexof(binVol, array.max(binVol))
        totalVol = array.sum(binVol)
        targetVol = totalVol * vaPercent / 100
        cumVol = array.get(binVol, pocIdx)
        upperIdx = pocIdx
        lowerIdx = pocIdx

        while cumVol < targetVol and (upperIdx < rows - 1 or lowerIdx > 0)
            upVol = upperIdx < rows - 1 ? array.get(binVol, upperIdx + 1) : -1.0
            downVol = lowerIdx > 0 ? array.get(binVol, lowerIdx - 1) : -1.0
            if upVol >= downVol
                upperIdx += 1
                cumVol += upVol
            else
                lowerIdx -= 1
                cumVol += downVol

        tick = syminfo.mintick
        pocPrice = math.round((sessLow + (pocIdx + 0.5) * rowHeight) / tick) * tick
        vahPrice = math.round((sessLow + (upperIdx + 1) * rowHeight) / tick) * tick
        valPrice = math.round((sessLow + lowerIdx * rowHeight) / tick) * tick

        // --- Delete previous session's lines/labels ---
        if not na(pocLine)
            line.delete(pocLine)
        if not na(vahLine)
            line.delete(vahLine)
        if not na(valLine)
            line.delete(valLine)
        if not na(pocLbl)
            label.delete(pocLbl)
        if not na(vahLbl)
            label.delete(vahLbl)
        if not na(valLbl)
            label.delete(valLbl)

        // --- Fixed time coordinates: from now (start of today's session) to 5pm EST today (end of session) ---
        startTime = time
        endTime = sessionStart + 24 * 60 * 60 * 1000

        pocLine := line.new(startTime, pocPrice, endTime, pocPrice, xloc=xloc.bar_time, color=pocColor, width=lineWidth)
        vahLine := line.new(startTime, vahPrice, endTime, vahPrice, xloc=xloc.bar_time, color=vahColor, width=lineWidth)
        valLine := line.new(startTime, valPrice, endTime, valPrice, xloc=xloc.bar_time, color=valColor, width=lineWidth)

        // --- Labels now anchored at endTime (right side, 5pm EST) instead of startTime ---
        if showLabels
            pocLbl := label.new(endTime, pocPrice, "POC " + str.tostring(pocPrice), xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.white, 100), textcolor=pocColor, size=lblSize)
            vahLbl := label.new(endTime, vahPrice, "VAH " + str.tostring(vahPrice), xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.white, 100), textcolor=vahColor, size=lblSize)
            valLbl := label.new(endTime, valPrice, "VAL " + str.tostring(valPrice), xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.white, 100), textcolor=valColor, size=lblSize)

// --- Reset sample storage for the new (now current, still forming) session ---
if newSession
    array.clear(priceSamples)
    array.clear(volSamples)

// --- Accumulate this bar's intrabar samples into the current session ---
if not na(lowPrices) and array.size(lowPrices) > 0
    for i = 0 to array.size(lowPrices) - 1
        array.push(priceSamples, array.get(lowPrices, i))
        array.push(volSamples, array.get(lowVolumes, i))