//@version=5
strategy("BTC Long Only by Soran FINAL", overlay=true, default_qty_type=strategy.fixed, default_qty_value=300, process_orders_on_close=false, calc_on_every_tick=false, pyramiding=0, commission_type=strategy.commission.percent, commission_value=0.064, slippage=1)

// ============================================================
// PARAMETRELER
// ============================================================
bbLen    = input.int  (20,   "Bollinger Periyodu",  group="Bollinger", minval=5)
bbMult   = input.float(2.0,  "Bollinger Carpani",   group="Bollinger", step=0.1, minval=0.5)
rsiLen   = input.int  (14,   "RSI Periyodu",        group="RSI", minval=2)
rsiOS    = input.int  (35,   "RSI Asiri Satim (<)", group="RSI", minval=10, maxval=49)
volLen   = input.int  (20,   "Hacim MA",            group="Hacim", minval=5)
volMult  = input.float(1.3,  "Hacim Carpani",       group="Hacim", step=0.1, minval=0.5)
slPerc   = input.float(1.9,  "Stop Loss (%)",       group="Risk", step=0.1, minval=0.1)

// ============================================================
// GOSTERGELER
// ============================================================
rsi     = ta.rsi(close, rsiLen)
volMA   = ta.sma(volume, volLen)
bbBasis = ta.sma(close, bbLen)
bbDev   = bbMult * ta.stdev(close, bbLen)
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev

// ============================================================
// BB CIZGILERI
// ============================================================
plot(bbBasis, "BB Orta", color=color.new(color.yellow,20), linewidth=1)
plot(bbUpper, "BB Ust",  color=color.new(color.red,   20), linewidth=1)
plot(bbLower, "BB Alt",  color=color.new(color.green, 20), linewidth=1)

// ============================================================
// SINYAL KOSULLARI - onceki bar [1]
// ============================================================
prevClose = close[1]
prevOpen  = open[1]
prevLow   = low[1]
prevRsi   = rsi[1]
prevVol   = volume[1]
prevVolMA = volMA[1]
prevBBL   = bbLower[1]
prevBBU   = bbUpper[1]

bullCandle = prevClose > prevOpen
volOK      = prevVol > prevVolMA * volMult
belowBBL   = prevLow < prevBBL and prevRsi < rsiOS

isFlat = strategy.position_size == 0
inLong = strategy.position_size > 0

canLong = belowBBL and bullCandle and volOK and isFlat

// ============================================================
// GIRIS + CIKIS
// ============================================================
if canLong
    tp = prevBBU
    sl = close * (1 - slPerc / 100)
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Cikis", from_entry="Long", limit=tp, stop=sl)

// ============================================================
// POZISYON TAKIBI
// ============================================================
longJustOpened = strategy.position_size > 0 and strategy.position_size[1] == 0
justClosed     = strategy.position_size == 0 and strategy.position_size[1] != 0
lastPnL        = strategy.closedtrades > 0 ? strategy.closedtrades.profit(strategy.closedtrades - 1) : 0.0
closedWin      = justClosed and lastPnL > 0
closedLoss     = justClosed and lastPnL < 0

// ============================================================
// ALERTLER
// ─────────────────────────────────────────────────────────────
// LONG GIRIS  → Cornix "Create Trade Webhook" mesaji
// POZ KAPANDI → Cornix "Close Trade Webhook" mesaji
// ============================================================
alertcondition(longJustOpened,
     title="LONG GIRIS",
     message="BTC LONG ACILDI")

alertcondition(justClosed,
     title="POZ KAPANDI",
     message="BTC POZ KAPANDI")

alertcondition(closedWin,
     title="KAZANC",
     message="BTC KAZANC")

alertcondition(closedLoss,
     title="ZARAR",
     message="BTC ZARAR")

alertcondition(belowBBL and isFlat,
     title="BB ALT DOKUNUŞ",
     message="BTC BB Alt banda dokunuş! Long sinyali yaklaşıyor.")

// ============================================================
// GORSELLER
// ============================================================
plotshape(longJustOpened, "LONG", style=shape.labelup, location=location.belowbar,
     color=color.new(color.green,0), textcolor=color.white, text="L", size=size.normal)

plotshape(belowBBL and isFlat, "BB Alt", shape.triangleup,
     location.belowbar, color=color.new(color.aqua,20), size=size.tiny)

ep_open = inLong ? strategy.opentrades.entry_price(0) : na
sl_line = inLong ? ep_open*(1-slPerc/100) : na

plot(ep_open, "Giris", color=color.new(color.yellow,0), linewidth=2, style=plot.style_linebr)
plot(sl_line, "SL",    color=color.new(color.red,   0), linewidth=2, style=plot.style_linebr)

// ============================================================
// ISTATISTIK TABLOSU
// ============================================================
var table t = table.new(position.top_right, 2, 7, bgcolor=color.new(color.black,50), border_width=1)

var float wins     = 0.0
var float losses   = 0.0
var float totalPnL = 0.0
var int   cnt      = 0

if strategy.closedtrades != strategy.closedtrades[1]
    idx      = strategy.closedtrades - 1
    pnl      = strategy.closedtrades.profit(idx)
    totalPnL += pnl
    cnt      += 1
    if pnl > 0
        wins += 1
    else
        losses += 1

wr      = cnt > 0 ? wins / cnt * 100 : 0.0
posText = inLong ? "LONG >" : "Bekliyor"
posClr  = inLong ? color.green : color.gray
bbWidth = (bbUpper - bbLower) / bbBasis * 100

table.cell(t, 0, 0, "BTC LONG FINAL", bgcolor=color.new(color.blue,30), text_color=color.white, text_size=size.small)
table.cell(t, 1, 0, "BB Long Only",   bgcolor=color.new(color.blue,30), text_color=color.lime,  text_size=size.small)
table.cell(t, 0, 1, "Win Rate",       text_color=color.silver, text_size=size.small)
table.cell(t, 1, 1, cnt>0 ? str.tostring(wr,"#.#")+"%" : "-",
     text_color=wr>=50?color.green:color.red, text_size=size.small)
table.cell(t, 0, 2, "PnL",            text_color=color.silver, text_size=size.small)
table.cell(t, 1, 2, cnt>0 ? str.tostring(totalPnL,"#.##") : "-",
     text_color=totalPnL>=0?color.green:color.red, text_size=size.small)
table.cell(t, 0, 3, "Islem",          text_color=color.silver, text_size=size.small)
table.cell(t, 1, 3, str.tostring(cnt), text_color=color.white, text_size=size.small)
table.cell(t, 0, 4, "W / L",          text_color=color.silver, text_size=size.small)
table.cell(t, 1, 4, str.tostring(int(wins))+" / "+str.tostring(int(losses)),
     text_color=color.white, text_size=size.small)
table.cell(t, 0, 5, "BB Genislik",    text_color=color.silver, text_size=size.small)
table.cell(t, 1, 5, str.tostring(bbWidth,"#.##")+"%",
     text_color=bbWidth>0.5?color.green:color.gray, text_size=size.small)
table.cell(t, 0, 6, "Pozisyon",       text_color=color.silver, text_size=size.small)
table.cell(t, 1, 6, posText, text_color=posClr, text_size=size.small)
