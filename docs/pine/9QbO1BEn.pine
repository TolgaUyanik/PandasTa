//    "Mathematics reveals the elegant patterns hidden within chaos." 🧮✨//

//@version=6
indicator("Keltner Channels MTF", overlay=true, timeframe="", timeframe_gaps=true)

length = input.int(40, "Period", minval=1)
multiplier = input.float(3.0, "Multiplier", minval=0.001, maxval=50, step=0.1)
source = input.source(close, "Source")
useExpMA = input.bool(true, "Use Exponential MA")
bandsStyle = input.string("Average True Range", options=["Average True Range", "True Range", "Range"], title="Bands Style")
atrLength = input.int(10, "ATR Length")
glowEffect = input.bool(true, "Glow Effect", group="Style")
useCustomColors = input.bool(false, "Use Custom Colors", group="Style")
customUpperColor = input.color(color.blue, "Custom Upper Color", group="Style")
customLowerColor = input.color(color.red, "Custom Lower Color", group="Style")
colorTheme = input.string("Neon", "Color Theme", options=["Green-Red", "Cyan-Magenta", "Yellow-Purple", "Forest Green", "Blue Ocean", "Orange-Red", "Neon", "Grayscale"], group="Style")
opacityLevel = input.int(30, "Opacity Level", minval=0, maxval=100, group="Style")

transp = (100 - opacityLevel) / 100
transp2 = math.max(transp - 0.2, 0)

var bullColor = color.new(#00ff9f, math.round(30 * transp))
var bearColor = color.new(#ff0062, math.round(30 * transp))
var bullFill = color.new(#00ff9f, math.round(80 * transp))
var bearFill = color.new(#ff0062, math.round(80 * transp))
var neutralColor = color.new(#FF6D00, math.round(50 * transp))

if colorTheme == "Green-Red"
    bullColor := color.new(#00ffbb, math.round(30 * transp))
    bearColor := color.new(#ff1100, math.round(30 * transp))
    bullFill := color.new(#00ffbb, math.round(80 * transp))
    bearFill := color.new(#ff1100, math.round(80 * transp))
    neutralColor := color.new(#b4b4b4, math.round(50 * transp))
else if colorTheme == "Cyan-Magenta"
    bullColor := color.new(#00ffff, math.round(30 * transp))
    bearColor := color.new(#ff00ff, math.round(30 * transp))
    bullFill := color.new(#00ffff, math.round(80 * transp))
    bearFill := color.new(#ff00ff, math.round(80 * transp))
    neutralColor := color.new(#e6e678, math.round(50 * transp))
else if colorTheme == "Yellow-Purple"
    bullColor := color.new(#fff000, math.round(30 * transp))
    bearColor := color.new(#8c00ff, math.round(30 * transp))
    bullFill := color.new(#fff000, math.round(80 * transp))
    bearFill := color.new(#8c00ff, math.round(80 * transp))
    neutralColor := color.new(#00ffff, math.round(50 * transp))
else if colorTheme == "Forest Green"
    bullColor := color.new(#359635, math.round(30 * transp))
    bearColor := color.new(#916335, math.round(30 * transp))
    bullFill := color.new(#359635, math.round(80 * transp))
    bearFill := color.new(#916335, math.round(80 * transp))
    neutralColor := color.new(#b4b478, math.round(50 * transp))
else if colorTheme == "Blue Ocean"
    bullColor := color.new(#0087bd, math.round(30 * transp))
    bearColor := color.new(#004370, math.round(30 * transp))
    bullFill := color.new(#0087bd, math.round(80 * transp))
    bearFill := color.new(#004370, math.round(80 * transp))
    neutralColor := color.new(#78b4b4, math.round(50 * transp))
else if colorTheme == "Orange-Red"
    bullColor := color.new(#ffa500, math.round(30 * transp))
    bearColor := color.new(#cc0000, math.round(30 * transp))
    bullFill := color.new(#ffa500, math.round(80 * transp))
    bearFill := color.new(#cc0000, math.round(80 * transp))
    neutralColor := color.new(#ffff78, math.round(50 * transp))
else if colorTheme == "Neon"
    bullColor := color.new(#00ff00, math.round(30 * transp))
    bearColor := color.new(#ff0000, math.round(30 * transp))
    bullFill := color.new(#00ff00, math.round(80 * transp))
    bearFill := color.new(#ff0000, math.round(80 * transp))
    neutralColor := color.new(#ffffff, math.round(50 * transp))
else if colorTheme == "Grayscale"
    bullColor := color.new(#dee2e6, math.round(30 * transp))
    bearColor := color.new(#495057, math.round(30 * transp))
    bullFill := color.new(#dee2e6, math.round(80 * transp))
    bearFill := color.new(#495057, math.round(80 * transp))
    neutralColor := color.new(#969696, math.round(50 * transp))

esma(source, length) =>
    s = ta.sma(source, length)
    e = ta.ema(source, length)
    useExpMA ? e : s

ma = esma(source, length)
rangema = bandsStyle == "True Range" ? ta.tr(true) : bandsStyle == "Average True Range" ? ta.atr(atrLength) : ta.rma(high - low, length)
upper = ma + rangema * multiplier
lower = ma - rangema * multiplier

var bool trendState = false
trendState := close > upper and ma > ma[1] ? true :
              close < lower and ma < ma[1] ? false :
              close > ma and ma > ma[1] ? true :
              close < ma and ma < ma[1] ? false : trendState

upperBandColor = useCustomColors ? customUpperColor : bullColor
lowerBandColor = useCustomColors ? customLowerColor : bearColor
maColor = trendState ? upperBandColor : lowerBandColor
upperGlow = color.new(upperBandColor, 70)
lowerGlow = color.new(lowerBandColor, 70)

maPlot = plot(ma, "MA", color=maColor, linewidth=2)
plot(trendState != trendState[1] ? ma : na, "Signal", color=trendState ? upperBandColor : lowerBandColor, style=plot.style_circles, linewidth=3)
upperPlot = plot(upper, "Upper Band", color=na)
lowerPlot = plot(lower, "Lower Band", color=na)

upperFill = glowEffect ? upperGlow : na
lowerFill = glowEffect ? lowerGlow : na
bgColor = color.new(chart.bg_color, 100)

fill(upperPlot, maPlot, upper, ma, upperFill, bgColor)
fill(maPlot, lowerPlot, ma, lower, bgColor, lowerFill)

plot(upper, "Upper Line", color=color.new(upperBandColor, 30), linewidth=1)
plot(lower, "Lower Line", color=color.new(lowerBandColor, 30), linewidth=1)

width = (upper - lower) / ma * 100
squeeze = width < ta.lowest(width, length/2)
expand = width > ta.highest(width, length/2)

alertcondition(ta.crossover(close, upper), "Price Above Upper Band", "Price crossed above upper Keltner Channel")
alertcondition(ta.crossunder(close, lower), "Price Below Lower Band", "Price crossed below lower Keltner Channel")
alertcondition(trendState != trendState[1], "Trend Change", "Trend direction changed")