//@version=6

// @description Provides a parsing library that indicator authors can use in order to parse dmarc Levels.
library("dmarcLevelParser", true)

int SECTION_SUPPLY_LINE = 0
int SECTION_SUPPLY_ZONE = 1
int SECTION_MAJOR_LINE = 2
int SECTION_ON_ZONE = 3
int SECTION_ON_LINE = 4
int SECTION_HIGH_LINE = 5
int SECTION_LOW_LINE = 6
int SECTION_HTF_ZONE = 7
int SECTION_MSUP = 8
int SECTION_MMSUP = 9
int SECTION_MSUPZ = 10
int SECTION_MMSUPZ = 11
int SECTION_MRES = 12
int SECTION_MMRES = 13
int SECTION_MRESZ = 14
int SECTION_MMRESZ = 15

export type zoneRange
    float high
    float low

export type dmarcLevels
    array<float> supplyLines
    array<zoneRange> supplyZones
    array<float> majorLines
    array<zoneRange> onZones
    array<float> onLines
    array<float> highLines
    array<float> lowLines
    array<zoneRange> htfZones
    array<float> mansupLines
    array<float> mansupmajLines
    array<zoneRange> mansupZones
    array<zoneRange> mansupmajZones
    array<float> manresLines
    array<float> manresmajLines
    array<zoneRange> manresZones
    array<zoneRange> manresmajZones


// @function Parses the string content and returns the `dmarcLevels` found within.
// @param s The string to parse.
// @returns The parsed WTD levels.
export parseLevels(string s) =>
    array<float> supplyLines = array.new<float>()
    array<zoneRange> supplyZones = array.new<zoneRange>()
    array<float> majorLines = array.new<float>()
    array<zoneRange> onZones = array.new<zoneRange>()
    array<float> onLines = array.new<float>()
    array<float> highLines = array.new<float>()
    array<float> lowLines = array.new<float>()
    array<zoneRange> htfZones = array.new<zoneRange>()
    array<float> mansupLines = array.new<float>()
    array<float> mansupmajLines = array.new<float>()
    array<zoneRange> mansupZones = array.new<zoneRange>()
    array<zoneRange> mansupmajZones = array.new<zoneRange>()
    array<float> manresLines = array.new<float>()
    array<float> manresmajLines = array.new<float>()
    array<zoneRange> manresZones = array.new<zoneRange>()
    array<zoneRange> manresmajZones = array.new<zoneRange>()

    // used for parsing ranges
    float previousHigh = 0

    currentSection = -1
    lines = str.split(s, "\n")
    numLines = array.size(lines)
    for n = 0 to (numLines > 0 ? numLines - 1 : na)
        string l = str.trim(array.get(lines, n))

        if str.length(l) == 0
            continue
        
        if l == "[SUPPLY ZONES]"
            currentSection := SECTION_SUPPLY_ZONE
        else if l == "[SUPPLY LINES]"
            currentSection := SECTION_SUPPLY_LINE
        else if l == "[MAJOR LINES]"
            currentSection := SECTION_MAJOR_LINE
        else if l == "[ON ZONES]"
            currentSection := SECTION_ON_ZONE
        else if l == "[ON LINES]"
            currentSection := SECTION_ON_LINE
        else if l == "[HIGHER LINE]"
            currentSection := SECTION_HIGH_LINE
        else if l == "[LOWER LINE]"
            currentSection := SECTION_LOW_LINE
        else if l == "[HTF ZONES]"
            currentSection := SECTION_HTF_ZONE
        else if l == "[MSUP]"
            currentSection := SECTION_MSUP
        else if l == "[MMSUP]"
            currentSection := SECTION_MMSUP
        else if l == "[MSUPZ]"
            currentSection := SECTION_MSUPZ
        else if l == "[MMSUPZ]"
            currentSection := SECTION_MMSUPZ
        else if l == "[MRES]"
            currentSection := SECTION_MRES
        else if l == "[MMRES]"
            currentSection := SECTION_MMRES
        else if l == "[MRESZ]"
            currentSection := SECTION_MRESZ
        else if l == "[MMRESZ]"
            currentSection := SECTION_MMRESZ 
        else
            float value = str.tonumber(l)

            if value <= 0
                continue

            if currentSection == SECTION_SUPPLY_LINE
                array.push(supplyLines, value)
            else if currentSection == SECTION_SUPPLY_ZONE
                if previousHigh == 0
                    previousHigh := value
                else
                    array.push(supplyZones, zoneRange.new(previousHigh, value))
                    previousHigh := 0
            else if currentSection == SECTION_MAJOR_LINE
                array.push(majorLines, value)
            else if currentSection == SECTION_ON_ZONE
                if previousHigh == 0
                    previousHigh := value
                else
                    array.push(onZones, zoneRange.new(previousHigh, value))
                    previousHigh := 0
            else if currentSection == SECTION_ON_LINE
                array.push(onLines, value)
            else if currentSection == SECTION_HIGH_LINE
                array.push(highLines, value)
            else if currentSection == SECTION_LOW_LINE
                array.push(lowLines, value)
            else if currentSection == SECTION_HTF_ZONE
                if previousHigh == 0
                    previousHigh := value
                else
                    array.push(htfZones, zoneRange.new(previousHigh, value))
                    previousHigh := 0
            else if currentSection == SECTION_MSUP
                array.push(mansupLines, value)
            else if currentSection == SECTION_MMSUP
                array.push(mansupmajLines, value)   
            else if currentSection == SECTION_MRES
                array.push(manresLines, value)
            else if currentSection == SECTION_MMRES
                array.push(manresmajLines, value) 
            else if currentSection == SECTION_MSUPZ
                if previousHigh == 0
                    previousHigh := value
                else
                    array.push(mansupZones, zoneRange.new(previousHigh, value))
                    previousHigh := 0
            else if currentSection == SECTION_MMSUPZ
                if previousHigh == 0
                    previousHigh := value
                else
                    array.push(mansupmajZones, zoneRange.new(previousHigh, value))
                    previousHigh := 0
            else if currentSection == SECTION_MRESZ
                if previousHigh == 0
                    previousHigh := value
                else
                    array.push(manresZones, zoneRange.new(previousHigh, value))
                    previousHigh := 0
            else if currentSection == SECTION_MMRESZ
                if previousHigh == 0
                    previousHigh := value
                else
                    array.push(manresmajZones, zoneRange.new(previousHigh, value))
                    previousHigh := 0
            else
                log.error("invalid section: {}", currentSection)

    dmarcLevels.new(supplyLines, supplyZones, majorLines, onZones, onLines, highLines, lowLines, htfZones, mansupLines, mansupmajLines, mansupZones, mansupmajZones, manresLines, manresmajLines, manresZones, manresmajZones)
