//@version=5
indicator("Apex Edge - RSI Trend Lines", overlay=false)

rsiLength     = input.int(14, title="RSI Length")
lookback      = input.int(10, title="Pivot Lookback")
extensionMode = input.string(title="Line Extension Mode", defval="Full Extend", options=["Full Extend", "Pivot Only"])
upperLevel    = input.float(70.0, title="Upper RSI Level")
lowerLevel    = input.float(30.0, title="Lower RSI Level")

rsi = ta.rsi(close, rsiLength)
plot(rsi, color=color.purple, title="RSI")
hline(upperLevel, title="Upper Level", color=color.gray, linestyle=hline.style_dotted)
hline(lowerLevel, title="Lower Level", color=color.gray, linestyle=hline.style_dotted)

pivotHigh = ta.pivothigh(rsi, lookback, lookback)
pivotLow  = ta.pivotlow(rsi, lookback, lookback)

var float lastHigh = na
var int   lastHighBar = na
var line  highLine = na
var bool  rsiHighBreak = false

var float lastLow = na
var int   lastLowBar = na
var line  lowLine = na
var bool  rsiLowBreak = false

slopeColor(y1, y2) => y2 > y1 ? color.green : y2 < y1 ? color.red : color.yellow

isBroken(y1, y2, x1, x2, rsiNow, barNow) =>
    slope = (y2 - y1) / (x2 - x1)
    projectedY = y1 + slope * (barNow - x1)
    (slope > 0 and rsiNow < projectedY) or (slope < 0 and rsiNow > projectedY)

// === HIGH LINE ===
if not na(pivotHigh)
    if not na(lastHigh)
        line.delete(highLine)
        highLine := line.new(x1=lastHighBar, y1=lastHigh, x2=bar_index - lookback, y2=pivotHigh, extend=extensionMode == "Full Extend" ? extend.right : extend.none, color=slopeColor(lastHigh, pivotHigh), width=2)
    lastHigh := pivotHigh
    lastHighBar := bar_index - lookback

rsiHighBreak := false
if not na(highLine)
    if isBroken(lastHigh, pivotHigh, lastHighBar, bar_index - lookback, rsi, bar_index)
        line.delete(highLine)
        highLine := na
        rsiHighBreak := true
        lastHigh := na
        lastHighBar := na

// === LOW LINE ===
if not na(pivotLow)
    if not na(lastLow)
        line.delete(lowLine)
        lowLine := line.new(x1=lastLowBar, y1=lastLow, x2=bar_index - lookback, y2=pivotLow, extend=extensionMode == "Full Extend" ? extend.right : extend.none, color=slopeColor(lastLow, pivotLow), width=2)
    lastLow := pivotLow
    lastLowBar := bar_index - lookback

rsiLowBreak := false
if not na(lowLine)
    if isBroken(lastLow, pivotLow, lastLowBar, bar_index - lookback, rsi, bar_index)
        line.delete(lowLine)
        lowLine := na
        rsiLowBreak := true
        lastLow := na
        lastLowBar := na

alertcondition(rsiHighBreak, title="RSI Breaks Resistance", message="RSI has broken a bearish RSI trendline (resistance).")
alertcondition(rsiLowBreak, title="RSI Breaks Support", message="RSI has broken a bullish RSI trendline (support).")
