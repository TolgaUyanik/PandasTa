//@version=6
indicator(title="IFVG/FVG Extended", shorttitle="IFVG/FVG Ext", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=0)


// [1] Tipus i variables IFVG
type fvg
    int left
    float top
    int right
    float bot
    float mid
    int dir
    int state
    int x_val


var bull_fvg_ary = array.new<fvg>(0)
var bear_fvg_ary = array.new<fvg>(0)
var bull_inv_ary = array.new<fvg>(0)
var bear_inv_ary = array.new<fvg>(0)


// [2] Paràmetres generals
signal_pref = input.string("Wick", title="Signal Preference", options=["Close","Wick"])
bool wt     = (signal_pref == "Wick")
atr_multi   = input.float(0.25, step=0.25, minval=0, title="ATR Multiplier")


// [2.1] Visibilitat de IFVG
show_ifvg_boxes = input.bool(true, title="Show IFVG Boxes", group="Visibility - IFVG", tooltip="Mostra les caixes IFVG abans i després de la invalidació")
disp_num = input.int(5, maxval=100, minval=1, title="Show Last IFVGs", group="Visibility - IFVG")


// [2.2] Visibilitat de FVG originals
show_fvg = input.bool(true, title="Show Original FVG Boxes", group="Visibility - FVG")
disp_fvg_num = input.int(5, maxval=100, minval=1, title="Show Last FVGs", group="Visibility - FVG")


// [2.3] Visibilitat de interseccions IFVG & FVG
only_fvg_overlap = input.bool(false, title="Show ONLY FVG boxes when they overlap with IFVG", group="Visibility - IFVG&FVG Intersections", tooltip="Quan està activat, només es mostren les zones d'intersecció entre FVG i IFVG")


// [2.4] Visibilitat de línies (control global + granular per IFVG alcista/baixista)
show_lines_global = input.bool(true, title="Show Lines (enable/disable all lines)", group="VISIBILITY - LINES ON IFVGs")


// IFVG Alcistes (dir == -1 després d'inversió)
show_bull_lines_top = input.bool(true,  title="Bull IFVG - Show Top Line", group="VISIBILITY - LINES ON IFVGs / Bear IFVG")
show_bull_lines_mid = input.bool(true,  title="Bull IFVG - Show Mid Line", group="VISIBILITY - LINES ON IFVGs / Bear IFVG")
show_bull_lines_bot = input.bool(true,  title="Bull IFVG - Show Bottom Line", group="VISIBILITY - LINES ON IFVGs / Bear IFVG")


// IFVG Baixistes (dir == 1 després d'inversió)
show_bear_lines_top = input.bool(true,  title="Bear IFVG - Show Top Line", group="VISIBILITY - LINES ON IFVGs / Bull IFVG")
show_bear_lines_mid = input.bool(true,  title="Bear IFVG - Show Mid Line", group="VISIBILITY - LINES ON IFVGs / Bull IFVG")
show_bear_lines_bot = input.bool(true,  title="Bear IFVG - Show Bottom Line", group="VISIBILITY - LINES ON IFVGs / Bull IFVG")


// Colors
green = input.color(color.new(#089981, 80), title="Bull IFVG Color", group="Colors")
red   = input.color(color.new(#f23645, 80), title="Bear IFVG Color", group="Colors")
blue  = input.color(color.new(#2962FF, 80), title="Bull FVG Color", group="Colors")
yellow = input.color(color.new(#FFD700, 80), title="Bear FVG Color", group="Colors")
overlap_bull_color = input.color(color.new(#ffffff, 80), title="Bullish Overlap Color (Bull FVG + Bull IFVG)", group="Colors")
overlap_bear_color = input.color(color.new(#ad343e, 80), title="Bearish Overlap Color (Bear FVG + Bear IFVG)", group="Colors")
invis = color.rgb(0, 0, 0, 100)


// [2.5] Controls d'extensió separats per FVG, IFVG i Overlaps
grpExtension = "Extension Settings"
extend_fvg_bars = input.int(100, minval=0, maxval=10000, title="FVG Extension (bars)", group=grpExtension, tooltip="Extensió futura dels boxes FVG originals")
extend_ifvg_bars = input.int(100, minval=1, maxval=10000, title="IFVG Extension (bars)", group=grpExtension, tooltip="Extensió futura dels boxes i línies IFVG després de la invalidació")
extend_overlap_bars = input.int(100, minval=0, maxval=10000, title="Overlap Extension (bars)", group=grpExtension, tooltip="Extensió futura dels boxes d'intersecció FVG+IFVG")


// [2.6] Controls de visibilitat de línies (gruix i estil)
grpLines = "Lines Appearance"
lw_top   = input.int(2, minval=1, maxval=5, title="Top Line Width",   group=grpLines)
lw_mid   = input.int(1, minval=1, maxval=5, title="Mid Line Width",   group=grpLines)
lw_bot   = input.int(2, minval=1, maxval=5, title="Bottom Line Width",group=grpLines)


styleTopStr = input.string("Solid",  options=["Solid","Dashed","Dotted"], title="Top Line Style",    group=grpLines)
styleMidStr = input.string("Dashed", options=["Solid","Dashed","Dotted"], title="Mid Line Style",    group=grpLines)
styleBotStr = input.string("Solid",  options=["Solid","Dashed","Dotted"], title="Bottom Line Style", group=grpLines)


// Converteix cadenes a constants de Pine
toStyle(s) =>
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid


styleTop = toStyle(styleTopStr)
styleMid = toStyle(styleMidStr)
styleBot = toStyle(styleBotStr)


// [2.7] Opció per allargar només les línies Top/Bottom una mica més enllà del box
line_overhang_bars = input.int(0, minval=0, maxval=1000, title="Extra Overhang for Top/Bottom Lines (bars)", group=grpLines)


// [3] Dades del gràfic principal
scOpen  = open
scHigh  = high
scLow   = low
scClose = close
scAtr   = ta.atr(200)


// [4] Funcions IFVG
fvg_manage(_ary, _inv_ary) =>
    var int buffer = 100
    if _ary.size() >= buffer
        _ary.shift()
    if _ary.size() > 0
        scCTop = math.max(scOpen, scClose)
        scCBot = math.min(scOpen, scClose)
        for i = (_ary.size() - 1) to 0
            value = _ary.get(i)
            _dir = value.dir
            if _dir == 1 and scCBot < value.bot
                value.x_val := time
                _inv_ary.push(_ary.remove(i))
            if _dir == -1 and scCTop > value.top
                value.x_val := time
                _inv_ary.push(_ary.remove(i))


// Helpers "Outside" basats en metxes (bar anterior)
prev_above_top(_top) =>
    low[1] > _top


prev_below_bot(_bot) =>
    high[1] < _bot


inv_manage(_ary) =>
    var int buffer = 100
    scCTop = math.max(scOpen, scClose)
    scCBot = math.min(scOpen, scClose)
    if _ary.size() >= buffer
        _ary.shift()
    if _ary.size() > 0
        for i = (_ary.size() - 1) to 0
            value = _ary.get(i)
            bx_top = value.top
            bx_bot = value.bot
            _dir = value.dir
            st = value.state
            if st == 0 and _dir == 1
                value.state := 1
                value.dir := -1
            if _dir == -1 and st == 0
                value.state := 1
                value.dir := 1
            if st >= 1
                value.right := time


            // Tocs amb filtre Outside→Inside per costat
            if _dir == -1 and st == 1 and scClose < bx_bot and (wt ? scHigh : scClose[1]) >= bx_bot and (wt ? scHigh : scClose[1]) < bx_top
                if prev_below_bot(bx_bot)
                    true


            if _dir == 1 and st == 1 and scClose > bx_top and (wt ? scLow : scClose[1]) <= bx_top and (wt ? scLow : scClose[1]) > bx_bot
                if prev_above_top(bx_top)
                    true


            if st >= 1 and ((_dir == -1 and scCTop > bx_top) or (_dir == 1 and scCBot < bx_bot))
                _ary.remove(i)


// [4.0] Funció per dibuixar interseccions FVG+IFVG
draw_fvg_ifvg_overlaps(fvg_top, fvg_bot, fvg_left, fvg_right, fvg_dir) =>
    bar_ms = math.max(1, time - time[1])
    future_time = time + bar_ms * extend_overlap_bars
   
    // Comprova superposició amb IFVGs alcistes (bull_inv_ary)
    if bull_inv_ary.size() > 0
        int start_b = math.max(bull_inv_ary.size() - disp_num, 0)
        for i = start_b to bull_inv_ary.size() - 1
            ifvg_item = bull_inv_ary.get(i)
            ifvg_top = ifvg_item.top
            ifvg_bot = ifvg_item.bot
            ifvg_left = ifvg_item.left
            ifvg_right = ifvg_item.right
           
            // Comprova si hi ha superposició vertical
            if not (fvg_bot > ifvg_top or fvg_top < ifvg_bot)
                // Calcula la intersecció vertical
                overlap_top = math.min(fvg_top, ifvg_top)
                overlap_bot = math.max(fvg_bot, ifvg_bot)
               
                // Calcula la intersecció horitzontal
                overlap_left = math.max(fvg_left, ifvg_left)
                overlap_right = math.max(future_time, ifvg_right)
               
                // Determina el color
                color_to_use = (fvg_dir == 1) ? overlap_bull_color : overlap_bear_color
               
                // Dibuixa el box d'intersecció
                box.new(overlap_left, overlap_top, overlap_right, overlap_bot, bgcolor=color_to_use, border_color=invis, xloc=xloc.bar_time)
   
    // Comprova superposició amb IFVGs baixistes (bear_inv_ary)
    if bear_inv_ary.size() > 0
        int start_s = math.max(bear_inv_ary.size() - disp_num, 0)
        for i = start_s to bear_inv_ary.size() - 1
            ifvg_item = bear_inv_ary.get(i)
            ifvg_top = ifvg_item.top
            ifvg_bot = ifvg_item.bot
            ifvg_left = ifvg_item.left
            ifvg_right = ifvg_item.right
           
            // Comprova si hi ha superposició vertical
            if not (fvg_bot > ifvg_top or fvg_top < ifvg_bot)
                // Calcula la intersecció vertical
                overlap_top = math.min(fvg_top, ifvg_top)
                overlap_bot = math.max(fvg_bot, ifvg_bot)
               
                // Calcula la intersecció horitzontal
                overlap_left = math.max(fvg_left, ifvg_left)
                overlap_right = math.max(future_time, ifvg_right)
               
                // Determina el color
                color_to_use = (fvg_dir == -1) ? overlap_bear_color : overlap_bull_color
               
                // Dibuixa el box d'intersecció
                box.new(overlap_left, overlap_top, overlap_right, overlap_bot, bgcolor=color_to_use, border_color=invis, xloc=xloc.bar_time)


// [4.1] Funció per mostrar FVG originals
send_fvg(_ary) =>
    last_index = _ary.size() - 1
    bar_ms = math.max(1, time - time[1])
    future_time = time + bar_ms * extend_fvg_bars
   
    for [idx, value] in _ary
        if idx > (last_index - disp_fvg_num)
            bx_top  = value.top
            bx_bot  = value.bot
            bx_left = value.left
            bx_right = extend_fvg_bars > 0 ? future_time : value.right
           
            // dir == 1 és FVG alcista (blau), dir == -1 és FVG baixista (groc)
            col_fvg = (value.dir == 1) ? blue : yellow
           
            if show_fvg
                if only_fvg_overlap
                    // Dibuixa només les zones d'intersecció
                    draw_fvg_ifvg_overlaps(bx_top, bx_bot, bx_left, bx_right, value.dir)
                else
                    // Dibuixa el FVG complet
                    box.new(bx_left, bx_top, bx_right, bx_bot, bgcolor=col_fvg, border_color=invis, xloc=xloc.bar_time)


// [4.2] Funció per mostrar IFVGs
send_it(_ary) =>
    last_index = _ary.size() - 1
    bar_ms = math.max(1, time - time[1])
    future_time_short = time + bar_ms * extend_ifvg_bars
    overhang_time = time + bar_ms * (extend_ifvg_bars + line_overhang_bars)
   
    for [idx, value] in _ary
        if idx > (last_index - disp_num)
            bx_top  = value.top
            bx_bot  = value.bot
            bx_left = value.left
            xval    = value.x_val
            mid     = value.mid


            isBullIFVG = (value.dir == -1)


            col_box  = isBullIFVG ? green : red
            oppo_box = isBullIFVG ? red   : green
            col_line = isBullIFVG ? red : green


            // Caixes IFVG
            if show_ifvg_boxes and not only_fvg_overlap
                box.new(bx_left, bx_top, xval,              bx_bot, bgcolor=col_box,  border_color=invis, xloc=xloc.bar_time)
                box.new(xval,    bx_top, future_time_short, bx_bot, bgcolor=oppo_box, border_color=invis, xloc=xloc.bar_time)


            // Línies
            if show_lines_global
                line_end_main = future_time_short
                line_end_over = overhang_time


                if isBullIFVG
                    if show_bull_lines_top
                        line.new(bx_left, bx_top, xval,           bx_top, color=col_line, style=styleTop, width=lw_top, xloc=xloc.bar_time)
                        line.new(xval,    bx_top, line_overhang_bars > 0 ? line_end_over : line_end_main, bx_top, color=col_line, style=styleTop, width=lw_top, xloc=xloc.bar_time)
                    if show_bull_lines_bot
                        line.new(bx_left, bx_bot, xval,           bx_bot, color=col_line, style=styleBot, width=lw_bot, xloc=xloc.bar_time)
                        line.new(xval,    bx_bot, line_overhang_bars > 0 ? line_end_over : line_end_main, bx_bot, color=col_line, style=styleBot, width=lw_bot, xloc=xloc.bar_time)
                    if show_bull_lines_mid
                        line.new(bx_left, mid,    xval,           mid,    color=col_line, style=styleMid, width=lw_mid, xloc=xloc.bar_time)
                        line.new(xval,    mid,    line_end_main,  mid,    color=col_line, style=styleMid, width=lw_mid, xloc=xloc.bar_time)
                else
                    if show_bear_lines_top
                        line.new(bx_left, bx_top, xval,           bx_top, color=col_line, style=styleTop, width=lw_top, xloc=xloc.bar_time)
                        line.new(xval,    bx_top, line_overhang_bars > 0 ? line_end_over : line_end_main, bx_top, color=col_line, style=styleTop, width=lw_top, xloc=xloc.bar_time)
                    if show_bear_lines_bot
                        line.new(bx_left, bx_bot, xval,           bx_bot, color=col_line, style=styleBot, width=lw_bot, xloc=xloc.bar_time)
                        line.new(xval,    bx_bot, line_overhang_bars > 0 ? line_end_over : line_end_main, bx_bot, color=col_line, style=styleBot, width=lw_bot, xloc=xloc.bar_time)
                    if show_bear_lines_mid
                        line.new(bx_left, mid,    xval,           mid,    color=col_line, style=styleMid, width=lw_mid, xloc=xloc.bar_time)
                        line.new(xval,    mid,    line_end_main,  mid,    color=col_line, style=styleMid, width=lw_mid, xloc=xloc.bar_time)


// [5] Detecció i representació
if bar_index >= 2
    scAtrVal  = nz(scAtr, 0) * atr_multi
    scFvgUp   = (scLow > scHigh[2]) and (scClose[1] > scHigh[2])
    scFvgDown = (scHigh < scLow[2]) and (scClose[1] < scLow[2])
    if scFvgUp and math.abs(scLow - scHigh[2]) > scAtrVal
        array.push(bull_fvg_ary, fvg.new(time[1], scLow, time, scHigh[2], math.avg(scLow, scHigh[2]), 1, 0, na))
    if scFvgDown and math.abs(scLow[2] - scHigh) > scAtrVal
        array.push(bear_fvg_ary, fvg.new(time[1], scLow[2], time, scHigh, math.avg(scHigh, scLow[2]), -1, 0, na))


    fvg_manage(bull_fvg_ary, bull_inv_ary)
    fvg_manage(bear_fvg_ary, bear_inv_ary)
    inv_manage(bull_inv_ary)
    inv_manage(bear_inv_ary)


    if barstate.islast
        for bx in box.all
            box.delete(bx)
        for ln in line.all
            line.delete(ln)
        send_fvg(bull_fvg_ary)
        send_fvg(bear_fvg_ary)
        send_it(bull_inv_ary)
        send_it(bear_inv_ary)


// [6] Alertes per IFVGs
touch_mode_all = input.string("Wick", options=["Wick","Close"], title="Alert Touch Mode (All IFVGs)", group="Alerts")


check_touch_level_dir(_top, _bot, _mode) =>
    bool tTop = high >= _top and low <= _top
    bool tBot = low <= _bot and high >= _bot
    bool cTop = close[1] < _top and close >= _top
    bool cBot = close[1] > _bot and close <= _bot


    bool pass_top = low[1] > _top
    bool pass_bot = high[1] < _bot


    bool topTouch = (_mode == "Wick" ? tTop : cTop) and pass_top
    bool botTouch = (_mode == "Wick" ? tBot : cBot) and pass_bot
    [topTouch, botTouch]


bool anyTouchTop = false
bool anyTouchBot = false


if bull_inv_ary.size() > 0
    int start_b = math.max(bull_inv_ary.size() - disp_num, 0)
    for i = start_b to bull_inv_ary.size() - 1
        v = bull_inv_ary.get(i)
        [tt, tb] = check_touch_level_dir(v.top, v.bot, touch_mode_all)
        anyTouchTop := anyTouchTop or tt
        anyTouchBot := anyTouchBot or tb


if bear_inv_ary.size() > 0
    int start_s = math.max(bear_inv_ary.size() - disp_num, 0)
    for i = start_s to bear_inv_ary.size() - 1
        v = bear_inv_ary.get(i)
        [tt, tb] = check_touch_level_dir(v.top, v.bot, touch_mode_all)
        anyTouchTop := anyTouchTop or tt
        anyTouchBot := anyTouchBot or tb


alertcondition(anyTouchTop, "Any IFVG Top touched", "Price touched/crossed any IFVG Top (outside→inside)")
alertcondition(anyTouchBot, "Any IFVG Bottom touched", "Price touched/crossed any IFVG Bottom (outside→inside)")


// [7] Alertes per Interseccions IFVG&FVG
touch_mode_overlap = input.string("Wick", options=["Wick","Close"], title="Alert Touch Mode (IFVG&FVG Overlaps)", group="Alerts")


check_overlap_touch(fvg_top, fvg_bot, fvg_left, _mode) =>
    bool touchedTop = false
    bool touchedBot = false
   
    // Comprova amb IFVGs alcistes
    if bull_inv_ary.size() > 0
        int start_b = math.max(bull_inv_ary.size() - disp_num, 0)
        for i = start_b to bull_inv_ary.size() - 1
            ifvg_item = bull_inv_ary.get(i)
            ifvg_top = ifvg_item.top
            ifvg_bot = ifvg_item.bot
            ifvg_left = ifvg_item.left
           
            if not (fvg_bot > ifvg_top or fvg_top < ifvg_bot) and time >= math.max(fvg_left, ifvg_left)
                overlap_top = math.min(fvg_top, ifvg_top)
                overlap_bot = math.max(fvg_bot, ifvg_bot)
               
                [tt, tb] = check_touch_level_dir(overlap_top, overlap_bot, _mode)
                touchedTop := touchedTop or tt
                touchedBot := touchedBot or tb
   
    // Comprova amb IFVGs baixistes
    if bear_inv_ary.size() > 0
        int start_s = math.max(bear_inv_ary.size() - disp_num, 0)
        for i = start_s to bear_inv_ary.size() - 1
            ifvg_item = bear_inv_ary.get(i)
            ifvg_top = ifvg_item.top
            ifvg_bot = ifvg_item.bot
            ifvg_left = ifvg_item.left
           
            if not (fvg_bot > ifvg_top or fvg_top < ifvg_bot) and time >= math.max(fvg_left, ifvg_left)
                overlap_top = math.min(fvg_top, ifvg_top)
                overlap_bot = math.max(fvg_bot, ifvg_bot)
               
                [tt, tb] = check_touch_level_dir(overlap_top, overlap_bot, _mode)
                touchedTop := touchedTop or tt
                touchedBot := touchedBot or tb
   
    [touchedTop, touchedBot]


bool anyOverlapTouchTop = false
bool anyOverlapTouchBot = false


if bull_fvg_ary.size() > 0
    int start_bf = math.max(bull_fvg_ary.size() - disp_fvg_num, 0)
    for i = start_bf to bull_fvg_ary.size() - 1
        v = bull_fvg_ary.get(i)
        [tt, tb] = check_overlap_touch(v.top, v.bot, v.left, touch_mode_overlap)
        anyOverlapTouchTop := anyOverlapTouchTop or tt
        anyOverlapTouchBot := anyOverlapTouchBot or tb


if bear_fvg_ary.size() > 0
    int start_sf = math.max(bear_fvg_ary.size() - disp_fvg_num, 0)
    for i = start_sf to bear_fvg_ary.size() - 1
        v = bear_fvg_ary.get(i)
        [tt, tb] = check_overlap_touch(v.top, v.bot, v.left, touch_mode_overlap)
        anyOverlapTouchTop := anyOverlapTouchTop or tt
        anyOverlapTouchBot := anyOverlapTouchBot or tb


alertcondition(anyOverlapTouchTop, "Any IFVG&FVG Overlap Top touched", "Price touched/crossed any IFVG&FVG Overlap Top (outside→inside)")
alertcondition(anyOverlapTouchBot, "Any IFVG&FVG Overlap Bottom touched", "Price touched/crossed any IFVG&FVG Overlap Bottom (outside→inside)")
