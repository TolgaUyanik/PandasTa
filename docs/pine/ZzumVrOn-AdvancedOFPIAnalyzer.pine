//@version=6
// @description Advanced Order Flow Pressure Index Analyzer Library
// Implements sophisticated volume distribution analysis with candle microstructure
// Provides comprehensive order flow assessment for institutional activity detection
library("AdvancedOFPIAnalyzer")

// ============================================================================
// COMPREHENSIVE CONFIGURATION PARAMETERS
// Advanced Order Flow Analysis Configuration with Statistical Constants
// ============================================================================

// Volume Distribution and Microstructure Analysis Parameters
// Controls the granularity of volume profile analysis and candle microstructure detection
VOLUME_PROFILE_BINS = 20                    // Number of price levels for volume distribution analysis
MICROSTRUCTURE_WINDOW = 10                  // Window size for detailed candle microstructure analysis
INSTITUTIONAL_THRESHOLD = 2.0               // Multiplier threshold for detecting institutional volume activity
PRESSURE_SMOOTHING_PERIOD = 5               // Smoothing period for order flow pressure index calculations
VOLUME_WEIGHTED_ANALYSIS_WINDOW = 50        // Maximum window size for volume-weighted statistical analysis
LARGE_VOLUME_MULTIPLIER = 2.5               // Volume multiplier for identifying unusually large transactions

// Advanced Institutional Detection and Market Microstructure Parameters
// Sophisticated thresholds for identifying smart money activity and market manipulation patterns
BID_ASK_IMBALANCE_THRESHOLD = 0.6           // Threshold for detecting significant bid-ask pressure imbalances
LARGE_ORDER_SIZE_MULTIPLIER = 3.0           // Multiplier for identifying institutional-sized order flow
ACCUMULATION_DETECTION_SENSITIVITY = 0.7    // Sensitivity level for accumulation pattern recognition
DISTRIBUTION_DETECTION_SENSITIVITY = 0.7    // Sensitivity level for distribution pattern recognition
VOLUME_ANOMALY_THRESHOLD = 2.5              // Standard deviation threshold for volume anomaly detection
SMART_MONEY_DETECTION_THRESHOLD = 1.8       // Threshold for smart money activity classification

// Mathematical Constants for Advanced Statistical Calculations
// Specialized constants for sophisticated order flow and volume analysis algorithms
GOLDEN_RATIO_VOLUME = 1.618                 // Golden ratio for natural volume level identification
VOLUME_ENTROPY_NORMALIZATION = 2.3026       // Natural logarithm of 10 for entropy calculations
PRESSURE_DYNAMICS_COEFFICIENT = 0.693       // Natural logarithm of 2 for pressure dynamics modeling
VWAP_STATISTICAL_SIGNIFICANCE = 1.96        // Statistical significance threshold for VWAP analysis (95% confidence)

// Order Flow Configuration Parameters for Precision Analysis
// Fine-tuned parameters for high-precision institutional activity detection
TICK_ANALYSIS_PRECISION = 4                 // Decimal precision for tick-level order flow analysis
IMBALANCE_DETECTION_WINDOW = 15             // Window size for detecting order flow imbalances
INSTITUTIONAL_FOOTPRINT_THRESHOLD = 0.75    // Threshold for institutional footprint classification
VOLUME_CLUSTER_SIGNIFICANCE = 0.8           // Significance level for volume clustering analysis
PRICE_VOLUME_CORRELATION_PERIOD = 30        // Period for price-volume correlation analysis
MARKET_IMPACT_CALCULATION_WINDOW = 8        // Window size for market impact measurement

// Market Phase Classification Constants
// Comprehensive classification system for different market structure phases
ACCUMULATION_PHASE = "Accumulation"         // Smart money accumulation phase
DISTRIBUTION_PHASE = "Distribution"         // Smart money distribution phase
MARKUP_PHASE = "Markup"                     // Price markup/trending up phase
MARKDOWN_PHASE = "Markdown"                 // Price markdown/trending down phase
EQUILIBRIUM_PHASE = "Equilibrium"           // Market equilibrium/balance phase
ABSORPTION_PHASE = "Absorption"             // Volume absorption without price movement
BREAKOUT_PHASE = "Breakout"                 // Breakout from consolidation phase

// Fibonacci Volume Level Configuration
// Initialize Fibonacci-based volume analysis levels using proper PineScript syntax
var fibonacciVolumeLevels = array.new<float>()
if array.size(fibonacciVolumeLevels) == 0
    array.push(fibonacciVolumeLevels, 0.236)
    array.push(fibonacciVolumeLevels, 0.382)
    array.push(fibonacciVolumeLevels, 0.618)
    array.push(fibonacciVolumeLevels, 0.786)
    array.push(fibonacciVolumeLevels, 1.000)
    array.push(fibonacciVolumeLevels, 1.272)
    array.push(fibonacciVolumeLevels, 1.618)

// ============================================================================
// GLOBAL TECHNICAL ANALYSIS CALCULATIONS
// Extract ta.atr() call to global scope for consistency and performance
// ============================================================================

// Global ATR calculation for consistency across all functions
var float globalATR = ta.atr(14)

// ============================================================================
// CORE VOLUME DISTRIBUTION ANALYSIS ENGINE
// Advanced Volume Profiling with Institutional Footprint Detection
// ============================================================================

// @function Implements sophisticated volume distribution analysis using advanced price-volume profiling techniques
// @param priceHigh High price values for range analysis
// @param priceLow Low price values for support/resistance detection  
// @param priceClose Close price values for momentum assessment
// @param volumeData Volume data for distribution analysis
// @param analysisWindow Analysis window period for volume distribution calculation
// @returns [array<float>, array<float>, array<float>, array<float>, array<float>] Volume profile, price profile, pressure profile, cluster sizes, institutional footprints
calculateVolumeDistributionProfile(priceHigh, priceLow, priceClose, volumeData, analysisWindow) =>
    // Initialize sophisticated volume distribution arrays for comprehensive analysis
    var volumeProfile = array.new<float>()
    var priceProfile = array.new<float>()
    var pressureProfile = array.new<float>()
    var volumeClusterSizes = array.new<float>()
    var institutionalFootprints = array.new<float>()
    var float atrReference = 0.0
    
    // Clear previous analysis for fresh calculation with optimized memory management
    array.clear(volumeProfile)
    array.clear(priceProfile)
    array.clear(pressureProfile)
    array.clear(volumeClusterSizes)
    array.clear(institutionalFootprints)
    
    // Validate and optimize analysis window for processing efficiency
    validWindow = math.max(MICROSTRUCTURE_WINDOW, math.min(analysisWindow, VOLUME_WEIGHTED_ANALYSIS_WINDOW))
    
    if bar_index >= validWindow
        // Calculate comprehensive price range for sophisticated volume distribution analysis
        windowHigh = ta.highest(priceHigh, validWindow)
        windowLow = ta.lowest(priceLow, validWindow)
        priceRange = windowHigh - windowLow
        
        if priceRange > 0
            // Create sophisticated price bins for granular volume distribution mapping
            binSize = priceRange / VOLUME_PROFILE_BINS
            
            // Initialize volume profile bins with advanced institutional detection metrics
            for i = 0 to VOLUME_PROFILE_BINS - 1
                array.push(volumeProfile, 0.0)
                binPrice = windowLow + (i + 0.5) * binSize
                array.push(priceProfile, binPrice)
                array.push(pressureProfile, 0.0)
                array.push(volumeClusterSizes, 0.0)
                array.push(institutionalFootprints, 0.0)
            
            // Advanced volume distribution with comprehensive microstructure analysis
            var totalVolumeAnalyzed = 0.0
            
            // Process historical data within analysis window for volume distribution mapping
            for j = 0 to validWindow - 1
                if bar_index >= j
                    historicalHigh = nz(priceHigh[j])
                    historicalLow = nz(priceLow[j])
                    historicalClose = nz(priceClose[j])
                    historicalVolume = nz(volumeData[j])
                    
                    if historicalVolume > 0
                        totalVolumeAnalyzed += historicalVolume
                        
                        // Calculate volume-weighted typical price for accurate distribution mapping
                        typicalPrice = (historicalHigh + historicalLow + historicalClose) / 3.0
                        
                        // Find appropriate bin for this price level with boundary protection
                        binIndex = math.floor((typicalPrice - windowLow) / binSize)
                        binIndex := math.max(0, math.min(VOLUME_PROFILE_BINS - 1, binIndex))
                        
                        // Add volume to appropriate bin with sophisticated weighting algorithms
                        currentVolume = array.get(volumeProfile, binIndex)
                        array.set(volumeProfile, binIndex, currentVolume + historicalVolume)
                        
                        // Calculate sophisticated buying/selling pressure using advanced candle microstructure analysis
                        candleRange = historicalHigh - historicalLow
                        if candleRange > 0
                            // Advanced pressure calculation using comprehensive wick analysis methodology
                            bodySize = math.abs(historicalClose - nz(open[j]))
                            upperWick = historicalHigh - math.max(historicalClose, nz(open[j]))
                            lowerWick = math.min(historicalClose, nz(open[j])) - historicalLow
                            
                            // Sophisticated pressure metrics using candle structure analysis
                            var buyingPressure = 0.0
                            var sellingPressure = 0.0
                            
                            if historicalClose > nz(open[j])  // Bullish candle structure analysis
                                buyingPressure := (bodySize + lowerWick * 0.7 + upperWick * 0.3) / candleRange
                                sellingPressure := (upperWick * 0.7 + lowerWick * 0.3) / candleRange
                            else  // Bearish candle structure analysis
                                buyingPressure := (lowerWick * 0.7 + upperWick * 0.3 + bodySize * 0.2) / candleRange
                                sellingPressure := (bodySize * 0.8 + upperWick * 0.7 + lowerWick * 0.3) / candleRange
                            
                            // Calculate net pressure with volume weighting for distribution mapping
                            netPressure = buyingPressure - sellingPressure
                            pressureContribution = netPressure * historicalVolume
                            currentPressure = array.get(pressureProfile, binIndex)
                            array.set(pressureProfile, binIndex, currentPressure + pressureContribution)
                            
                            // Detect institutional footprints using advanced volume clustering algorithms
                            avgVolume = totalVolumeAnalyzed / (j + 1)
                            if historicalVolume > avgVolume * LARGE_ORDER_SIZE_MULTIPLIER
                                currentFootprint = array.get(institutionalFootprints, binIndex)
                                institutionalSignature = math.log(historicalVolume / avgVolume)
                                array.set(institutionalFootprints, binIndex, currentFootprint + institutionalSignature)
                            
                            // Calculate volume cluster sizes for comprehensive market structure analysis
                            // Use global ATR reference for optimal performance and consistency
                            atrReference := globalATR
                            clusterWeight = historicalVolume / math.max(candleRange, atrReference)
                            currentClusterSize = array.get(volumeClusterSizes, binIndex)
                            array.set(volumeClusterSizes, binIndex, currentClusterSize + clusterWeight)
            
            // Normalize institutional footprints for accurate comparative analysis
            if totalVolumeAnalyzed > 0
                for i = 0 to VOLUME_PROFILE_BINS - 1
                    footprint = array.get(institutionalFootprints, i)
                    normalizedFootprint = footprint / math.log(totalVolumeAnalyzed + 1.0)
                    array.set(institutionalFootprints, i, normalizedFootprint)
    
    [volumeProfile, priceProfile, pressureProfile, volumeClusterSizes, institutionalFootprints]

// @function Calculates sophisticated order flow pressure index using advanced microstructure analysis
// @param priceOpen Opening price for candle structure analysis
// @param priceHigh High price for range calculation
// @param priceLow Low price for support analysis
// @param priceClose Closing price for momentum assessment
// @param volumeData Volume data for pressure calculation
// @param microWindow Microstructure analysis window size
// @returns [float, float, float, float, float, float] Buying pressure, selling pressure, net order flow, pressure index, institutional pressure, pressure velocity
calculateOrderFlowPressureIndex(priceOpen, priceHigh, priceLow, priceClose, volumeData, microWindow) =>
    // Initialize comprehensive pressure analysis variables
    var float buyingPressure = 0.0
    var float sellingPressure = 0.0
    var float netOrderFlow = 0.0
    var float pressureIndex = 0.0
    var float institutionalPressure = 0.0
    var float pressureVelocity = 0.0
    var float atrNormalization = 0.0
    
    // Validate volume availability and establish processing parameters
    volumeAvailable = not na(volumeData) and volumeData > 0
    validMicroWindow = math.max(3, math.min(microWindow, MICROSTRUCTURE_WINDOW))
    
    if volumeAvailable and bar_index >= validMicroWindow
        var float totalBuyingVolume = 0.0
        var float totalSellingVolume = 0.0
        var float totalVolume = 0.0
        var array<float> pressureHistory = array.new<float>()
        
        array.clear(pressureHistory)
        
        // Analyze advanced microstructure over the specified temporal window
        for i = 0 to validMicroWindow - 1
            if bar_index >= i
                iOpen = nz(priceOpen[i])
                iHigh = nz(priceHigh[i])
                iLow = nz(priceLow[i])
                iClose = nz(priceClose[i])
                iVolume = nz(volumeData[i])
                
                if iVolume > 0
                    // Advanced intra-candle pressure distribution analysis using sophisticated algorithms
                    candleRange = iHigh - iLow
                    
                    if candleRange > 0
                        // Sophisticated pressure calculation using tick-level approximation methodology
                        bodySize = math.abs(iClose - iOpen)
                        upperWick = iHigh - math.max(iOpen, iClose)
                        lowerWick = math.min(iOpen, iClose) - iLow
                        
                        // Calculate wick ratios for precise pressure distribution analysis
                        upperWickRatio = upperWick / candleRange
                        lowerWickRatio = lowerWick / candleRange
                        bodyRatio = bodySize / candleRange
                        
                        // Advanced buying/selling pressure calculation using candle structure methodology
                        var float buyingVolumeRatio = 0.0
                        var float sellingVolumeRatio = 0.0
                        
                        if iClose > iOpen  // Bullish candle pressure analysis
                            // Buying pressure: body + partial lower wick - upper wick penalty
                            buyingVolumeRatio := bodyRatio + lowerWickRatio * 0.6 - upperWickRatio * 0.2
                            sellingVolumeRatio := upperWickRatio * 0.8 + lowerWickRatio * 0.4 + bodyRatio * 0.1
                        else if iClose < iOpen  // Bearish candle pressure analysis
                            // Selling pressure: body + partial upper wick - lower wick penalty
                            sellingVolumeRatio := bodyRatio + upperWickRatio * 0.6 - lowerWickRatio * 0.2
                            buyingVolumeRatio := lowerWickRatio * 0.8 + upperWickRatio * 0.4 + bodyRatio * 0.1
                        else  // Doji candle neutral pressure distribution
                            // Neutral pressure distribution based on wick analysis
                            buyingVolumeRatio := lowerWickRatio * 0.7 + 0.5
                            sellingVolumeRatio := upperWickRatio * 0.7 + 0.5
                        
                        // Ensure ratios are properly bounded for accurate calculations
                        buyingVolumeRatio := math.max(0.0, math.min(1.0, buyingVolumeRatio))
                        sellingVolumeRatio := math.max(0.0, math.min(1.0, sellingVolumeRatio))
                        
                        // Volume-weighted pressure accumulation for comprehensive analysis
                        totalBuyingVolume += buyingVolumeRatio * iVolume
                        totalSellingVolume += sellingVolumeRatio * iVolume
                        totalVolume += iVolume
                        
                        // Calculate instantaneous pressure for velocity analysis
                        instantaneousPressure = buyingVolumeRatio - sellingVolumeRatio
                        array.push(pressureHistory, instantaneousPressure)
        
        // Calculate normalized pressure metrics using comprehensive statistical analysis
        if totalVolume > 0
            buyingPressure := totalBuyingVolume / totalVolume
            sellingPressure := totalSellingVolume / totalVolume
            netOrderFlow := buyingPressure - sellingPressure
            
            // Calculate momentum-adjusted pressure index using advanced market dynamics
            priceChange = priceClose - priceClose[validMicroWindow-1]
            volumeChange = volumeData - ta.sma(volumeData, validMicroWindow)
            
            // Advanced momentum factor calculation using ATR normalization for statistical significance
            // Use global ATR reference for optimal performance and consistency
            atrNormalization := globalATR
            momentumFactor = atrNormalization > 0 ? priceChange / atrNormalization : 0.0
            volumeFactor = totalVolume > 0 ? volumeChange / totalVolume : 0.0
            
            // Institutional pressure detection using sophisticated volume anomaly analysis
            avgVolume = ta.sma(volumeData, 20)
            if avgVolume > 0 and volumeData > avgVolume * INSTITUTIONAL_THRESHOLD
                institutionalMultiplier = math.log(volumeData / avgVolume)
                institutionalPressure := netOrderFlow * institutionalMultiplier
            
            // Calculate pressure velocity using rate of change analysis
            if array.size(pressureHistory) >= 3
                recentPressure = (array.get(pressureHistory, 0) + array.get(pressureHistory, 1)) / 2.0
                olderPressure = (array.get(pressureHistory, array.size(pressureHistory)-2) + array.get(pressureHistory, array.size(pressureHistory)-1)) / 2.0
                pressureVelocity := recentPressure - olderPressure
            
            // Final pressure index with advanced multi-factor weighting
            pressureIndex := netOrderFlow * (1.0 + momentumFactor * 0.3 + volumeFactor * 0.2)
            
            // Apply institutional pressure enhancement for complete analysis
            if math.abs(institutionalPressure) > math.abs(pressureIndex) * 0.5
                pressureIndex := pressureIndex + institutionalPressure * 0.3
    else
        // Fallback calculation when volume data is unavailable
        if bar_index >= validMicroWindow
            priceBasedPressure = (priceClose - priceOpen) / globalATR
            pressureIndex := priceBasedPressure * 0.4  // Reduced confidence without volume data
    
    [buyingPressure, sellingPressure, netOrderFlow, pressureIndex, institutionalPressure, pressureVelocity]

// ============================================================================
// MARKET IMPACT ANALYSIS ENGINE
// Advanced Price-Volume Relationship Modeling
// ============================================================================

// @function Calculates market impact using advanced price-volume relationship analysis
// @param priceClose Close price for impact calculation
// @param volumeData Volume data for impact measurement
// @param impactWindow Window size for impact analysis
// @returns float Market impact measurement
calculateMarketImpact(priceClose, volumeData, impactWindow) =>
    var float marketImpact = 0.0
    var float atrValue = 0.0
    
    if bar_index >= impactWindow and not na(volumeData)
        // Calculate price change and volume relationship over the impact window
        priceChange = priceClose - priceClose[impactWindow]
        avgVolume = ta.sma(volumeData, impactWindow)
        
        if avgVolume > 0
            volumeIntensity = volumeData / avgVolume
            
            // Use global ATR reference for consistency and performance optimization
            atrValue := globalATR
            normalizedPriceChange = atrValue > 0 ? priceChange / atrValue : 0.0
            
            // Market impact as price change per unit of excess volume
            if volumeIntensity > 1.0
                marketImpact := normalizedPriceChange / (volumeIntensity - 1.0)
    
    marketImpact

// ============================================================================
// INSTITUTIONAL ACTIVITY DETECTION SYSTEM
// Advanced Smart Money Recognition with Statistical Analysis
// ============================================================================

// @function Detects institutional accumulation patterns using sophisticated volume and price analysis
// @param priceClose Close price for trend analysis
// @param volumeData Volume data for institutional detection
// @param analysisWindow Analysis window period
// @param sensitivityLevel Detection sensitivity threshold
// @returns [bool, float, string, array<float>, array<string>, float] Detection status, strength, phase, signatures, methods, confidence
detectInstitutionalAccumulation(priceClose, volumeData, analysisWindow, sensitivityLevel) =>
    // Initialize comprehensive institutional detection variables
    var bool accumulationDetected = false
    var float accumulationStrength = 0.0
    var string accumulationPhase = EQUILIBRIUM_PHASE
    var array<float> institutionalSignatures = array.new<float>()
    var array<string> detectionMethods = array.new<string>()
    var float confidenceScore = 0.0
    var float atrValue = 0.0
    
    // Clear previous analysis for fresh institutional detection
    array.clear(institutionalSignatures)
    array.clear(detectionMethods)
    
    // Validate and optimize analysis parameters
    validWindow = math.max(MICROSTRUCTURE_WINDOW, math.min(analysisWindow, VOLUME_WEIGHTED_ANALYSIS_WINDOW))
    validSensitivity = math.max(0.1, math.min(sensitivityLevel, 1.0))
    
    if bar_index >= validWindow and not na(volumeData)
        // Calculate comprehensive volume and price statistics for institutional analysis
        averageVolume = ta.sma(volumeData, validWindow)
        volumeStdDev = ta.stdev(volumeData, validWindow)
        currentVolumeZ = volumeStdDev > 0 ? (volumeData - averageVolume) / volumeStdDev : 0.0
        
        averagePrice = ta.sma(priceClose, validWindow)
        priceStdDev = ta.stdev(priceClose, validWindow)
        currentPriceZ = priceStdDev > 0 ? (priceClose - averagePrice) / priceStdDev : 0.0
        
        // Advanced institutional signature detection with sophisticated algorithms
        
        // Volume Anomaly Detection with Temporal Clustering Analysis
        volumeAnomaly = math.abs(currentVolumeZ) > VOLUME_ANOMALY_THRESHOLD
        volumeSignature = volumeAnomaly ? math.min(1.0, math.abs(currentVolumeZ) / VOLUME_ANOMALY_THRESHOLD) : 0.0
        
        // Check for volume clustering (multiple high-volume bars in sequence)
        var int highVolumeCluster = 0
        for i = 0 to math.min(5, validWindow) - 1
            if bar_index >= i and nz(volumeData[i]) > averageVolume * 1.5
                highVolumeCluster += 1
        
        if highVolumeCluster >= 3
            volumeSignature := math.min(1.0, volumeSignature * 1.3)  // Boost for clustering detection
            array.push(detectionMethods, "Volume Clustering")
        
        array.push(institutionalSignatures, volumeSignature)
        
        // Price-Volume Divergence Analysis with Smart Money Detection
        priceDirection = priceClose > priceClose[1] ? 1.0 : -1.0
        volumeDirection = volumeData > averageVolume ? 1.0 : -1.0
        
        // Accumulation: price stable/down with high volume (smart money buying)
        // Distribution: price stable/up with high volume (smart money selling)
        var divergenceSignature = 0.0
        
        // Sophisticated divergence detection using advanced market microstructure analysis
        if volumeData > averageVolume * SMART_MONEY_DETECTION_THRESHOLD
            if priceDirection <= 0 and volumeDirection > 0  // Accumulation pattern detection
                divergenceSignature := 0.9
                array.push(detectionMethods, "Smart Money Accumulation")
            else if priceDirection >= 0 and volumeDirection > 0  // Distribution pattern detection
                divergenceSignature := -0.9
                array.push(detectionMethods, "Smart Money Distribution")
            else
                priceVolumeAlignment = priceDirection * volumeDirection
                divergenceSignature := priceVolumeAlignment > 0 ? 0.6 : 0.3
        else
            divergenceSignature := 0.2
        
        array.push(institutionalSignatures, math.abs(divergenceSignature))
        
        // Advanced Volume Profile Analysis with Institutional Footprint Detection
        [volumeProfile, priceProfile, pressureProfile, clusterSizes, footprints] = calculateVolumeDistributionProfile(high, low, priceClose, volumeData, validWindow)
        
        // Find maximum institutional footprint and volume concentration
        var float maxFootprint = 0.0
        var float maxVolume = 0.0
        var float totalVolumeInProfile = 0.0
        var int institutionalLevels = 0
        
        for i = 0 to array.size(volumeProfile) - 1
            profileVolume = array.get(volumeProfile, i)
            institutionalFootprint = array.get(footprints, i)
            
            totalVolumeInProfile += profileVolume
            
            if profileVolume > maxVolume
                maxVolume := profileVolume
            
            if institutionalFootprint > INSTITUTIONAL_FOOTPRINT_THRESHOLD
                institutionalLevels += 1
                if institutionalFootprint > maxFootprint
                    maxFootprint := institutionalFootprint
        
        // Volume concentration and institutional presence signature calculation
        volumeConcentration = totalVolumeInProfile > 0 ? maxVolume / totalVolumeInProfile : 0.0
        institutionalPresence = institutionalLevels / array.size(volumeProfile)
        
        concentrationSignature = volumeConcentration > 0.3 ? volumeConcentration : 0.0
        footprintSignature = math.min(1.0, maxFootprint + institutionalPresence)
        
        array.push(institutionalSignatures, concentrationSignature)
        array.push(institutionalSignatures, footprintSignature)
        
        if institutionalLevels > 0
            array.push(detectionMethods, "Institutional Footprints")
        
        // Temporal Analysis with Absorption Detection using Advanced Algorithms
        var int recentHighVolumeBars = 0
        var float priceAbsorption = 0.0
        
        // Use global ATR reference for consistency and performance optimization
        atrValue := globalATR
        
        for i = 0 to math.min(8, validWindow) - 1
            if bar_index >= i
                volumeRatio = averageVolume > 0 ? nz(volumeData[i]) / averageVolume : 1.0
                if volumeRatio > 1.4
                    recentHighVolumeBars += 1
                    
                    // Check for price absorption (high volume with minimal price movement)
                    priceMovement = math.abs(nz(priceClose[i]) - nz(priceClose[i+1]))
                    normalizedMovement = atrValue > 0 ? priceMovement / atrValue : 0.0
                    if normalizedMovement < 0.3 and volumeRatio > 2.0
                        priceAbsorption += 1.0
        
        timeSignature = recentHighVolumeBars / 8.0
        absorptionSignature = priceAbsorption / 3.0  // Maximum 3 absorption events
        
        array.push(institutionalSignatures, timeSignature)
        array.push(institutionalSignatures, absorptionSignature)
        
        if priceAbsorption > 0
            array.push(detectionMethods, "Price Absorption")
        
        // Market Impact Analysis with Advanced Statistical Modeling
        priceImpact = calculateMarketImpact(priceClose, volumeData, MARKET_IMPACT_CALCULATION_WINDOW)
        impactSignature = math.min(1.0, math.abs(priceImpact) * 2.0)
        array.push(institutionalSignatures, impactSignature)
        
        // Synthesize institutional signatures with weighted confidence analysis
        var float totalSignatureStrength = 0.0
        var float weightedConfidence = 0.0
        
        // Define signature weights for comprehensive analysis
        var array<float> signatureWeights = array.new<float>()
        array.push(signatureWeights, 0.25)  // Volume signature
        array.push(signatureWeights, 0.20)  // Divergence signature
        array.push(signatureWeights, 0.15)  // Concentration signature
        array.push(signatureWeights, 0.15)  // Footprint signature
        array.push(signatureWeights, 0.10)  // Time signature
        array.push(signatureWeights, 0.10)  // Absorption signature
        array.push(signatureWeights, 0.05)  // Impact signature
        
        for i = 0 to math.min(array.size(institutionalSignatures), array.size(signatureWeights)) - 1
            signature = array.get(institutionalSignatures, i)
            weight = array.get(signatureWeights, i)
            totalSignatureStrength += signature * weight
            weightedConfidence += weight * (signature > 0.5 ? 1.0 : 0.5)
        
        accumulationStrength := totalSignatureStrength
        confidenceScore := weightedConfidence
        
        // Determine accumulation phase with sophisticated classification system
        if accumulationStrength >= validSensitivity
            accumulationDetected := true
            
            // Classify accumulation phase based on price action and signature analysis
            recentPriceChange = (priceClose - priceClose[validWindow-1]) / priceClose[validWindow-1]
            
            // Advanced phase classification using multiple criteria
            if recentPriceChange > 0.03 and accumulationStrength > 0.85 and divergenceSignature > 0
                accumulationPhase := MARKUP_PHASE
            else if recentPriceChange < -0.03 and accumulationStrength > 0.85 and divergenceSignature < 0
                accumulationPhase := MARKDOWN_PHASE
            else if recentPriceChange > 0.005 and accumulationStrength > 0.7 and priceAbsorption > 0
                accumulationPhase := ACCUMULATION_PHASE
            else if recentPriceChange < -0.005 and accumulationStrength > 0.7 and priceAbsorption > 0
                accumulationPhase := DISTRIBUTION_PHASE
            else if priceAbsorption > 1 and volumeConcentration > 0.4
                accumulationPhase := ABSORPTION_PHASE
            else
                accumulationPhase := EQUILIBRIUM_PHASE
    
    [accumulationDetected, accumulationStrength, accumulationPhase, institutionalSignatures, detectionMethods, confidenceScore]



// ============================================================================
// ADVANCED OFPI CALCULATION AND SMOOTHING ENGINE
// Sophisticated Signal Processing with Adaptive Filtering
// ============================================================================

// @function Calculates comprehensive OFPI using multiple smoothing techniques and adaptive filtering
// @param priceOpen Opening price for pressure calculation
// @param priceHigh High price for range analysis
// @param priceLow Low price for support detection
// @param priceClose Closing price for trend assessment
// @param volumeData Volume data for pressure analysis
// @param smoothingPeriod Smoothing period for noise reduction
// @param adaptiveFilter Enable adaptive filtering
// @returns [float, float, float, float, float, string] Raw OFPI, smoothed OFPI, adaptive OFPI, momentum, volatility, trend
calculateAdvancedOFPI(priceOpen, priceHigh, priceLow, priceClose, volumeData, smoothingPeriod, adaptiveFilter) =>
    // Initialize comprehensive OFPI calculation variables
    var rawOFPI = 0.0
    var smoothedOFPI = 0.0
    var adaptiveOFPI = 0.0
    var ofpiMomentum = 0.0
    var ofpiVolatility = 0.0
    var ofpiTrend = "Neutral"
    var float marketVolatility = 0.0
    
    validSmoothingPeriod = math.max(3, math.min(smoothingPeriod, PRESSURE_SMOOTHING_PERIOD * 2))
    
    // Calculate raw OFPI using enhanced microstructure analysis
    [buyingPressure, sellingPressure, netOrderFlow, pressureIndex, institutionalPressure, pressureVelocity] = calculateOrderFlowPressureIndex(priceOpen, priceHigh, priceLow, priceClose, volumeData, MICROSTRUCTURE_WINDOW)
    
    rawOFPI := pressureIndex
    
    // Apply sophisticated T3 smoothing for noise reduction with enhanced parameters
    if bar_index >= validSmoothingPeriod
        // T3 smoothing implementation with adaptive alpha calculation
        // Use global ATR reference for optimal performance and consistency
        atrValue = globalATR
        marketVolatility := atrValue / priceClose
        adaptiveAlpha = 2.0 / (validSmoothingPeriod + 1.0 + marketVolatility * 10.0)
        
        // Progressive EMA calculation for T3 smoothing algorithm
        ema1 = ta.ema(rawOFPI, validSmoothingPeriod)
        ema2 = ta.ema(ema1, validSmoothingPeriod)
        ema3 = ta.ema(ema2, validSmoothingPeriod)
        
        // Enhanced T3 calculation with market condition adaptation
        c1 = -adaptiveAlpha * adaptiveAlpha * adaptiveAlpha
        c2 = 3.0 * adaptiveAlpha * adaptiveAlpha + 3.0 * adaptiveAlpha * adaptiveAlpha * adaptiveAlpha
        c3 = -6.0 * adaptiveAlpha * adaptiveAlpha - 3.0 * adaptiveAlpha - 3.0 * adaptiveAlpha * adaptiveAlpha * adaptiveAlpha
        c4 = 1.0 + 3.0 * adaptiveAlpha + adaptiveAlpha * adaptiveAlpha * adaptiveAlpha + 3.0 * adaptiveAlpha * adaptiveAlpha
        
        smoothedOFPI := c1 * ema3 + c2 * ema2 + c3 * ema1 + c4 * rawOFPI
    else
        smoothedOFPI := rawOFPI
    
    // Apply advanced adaptive filtering based on market conditions
    if adaptiveFilter
        marketVolatility := globalATR / priceClose
        trendStrength = math.abs(ta.ema(priceClose, 20) - ta.ema(priceClose, 50)) / priceClose
        
        // Calculate adaptive factor based on multiple market conditions
        volatilityFactor = math.max(0.2, math.min(1.0, 1.0 - marketVolatility * 100.0))
        trendFactor = math.max(0.3, math.min(1.0, 1.0 - trendStrength * 20.0))
        
        // Combine factors for final adaptive weight calculation
        adaptiveFactor = (volatilityFactor + trendFactor) / 2.0
        
        // Apply Kalman filter approximation for enhanced smoothing
        kalmanGain = adaptiveFactor
        adaptiveOFPI := smoothedOFPI * kalmanGain + rawOFPI * (1.0 - kalmanGain)
    else
        adaptiveOFPI := smoothedOFPI
    
    // Calculate OFPI momentum and volatility for comprehensive trend analysis
    if bar_index >= 8
        ofpiMomentum := adaptiveOFPI - adaptiveOFPI[7]
        
        // Calculate OFPI volatility using recent standard deviation
        var array<float> recentOFPI = array.new<float>()
        for i = 0 to 7
            if bar_index >= i
                array.push(recentOFPI, nz(adaptiveOFPI[i]))
        
        if array.size(recentOFPI) >= 5
            var float ofpiMean = 0.0
            for i = 0 to array.size(recentOFPI) - 1
                ofpiMean += array.get(recentOFPI, i)
            ofpiMean := ofpiMean / array.size(recentOFPI)
            
            var float ofpiVariance = 0.0
            for i = 0 to array.size(recentOFPI) - 1
                deviation = array.get(recentOFPI, i) - ofpiMean
                ofpiVariance += deviation * deviation
            
            ofpiVolatility := math.sqrt(ofpiVariance / array.size(recentOFPI))
    
    // Determine OFPI trend classification using comprehensive analysis
    if ofpiMomentum > 0.02 and adaptiveOFPI > 0.1
        ofpiTrend := "Strong Bullish"
    else if ofpiMomentum > 0.01 and adaptiveOFPI > 0.05
        ofpiTrend := "Bullish"
    else if ofpiMomentum < -0.02 and adaptiveOFPI < -0.1
        ofpiTrend := "Strong Bearish"
    else if ofpiMomentum < -0.01 and adaptiveOFPI < -0.05
        ofpiTrend := "Bearish"
    else if math.abs(ofpiMomentum) < 0.005
        ofpiTrend := "Neutral"
    else
        ofpiTrend := "Transitional"
    
    [rawOFPI, smoothedOFPI, adaptiveOFPI, ofpiMomentum, ofpiVolatility, ofpiTrend]

// ============================================================================
// VOLUME-WEIGHTED ANALYSIS FUNCTIONS
// Comprehensive VWAP Analysis with Statistical Bands
// ============================================================================

// @function Implements sophisticated volume-weighted average price analysis for institutional benchmark pricing
// @param priceHigh High price for range calculation
// @param priceLow Low price for support analysis
// @param priceClose Close price for calculation
// @param volumeData Volume data for weighting
// @param analysisWindow Analysis window period
// @returns [float, float, array<float>, float, float, float] VWAP, standard deviation, bands, divergence, slope, efficiency
calculateVolumeWeightedAnalysis(priceHigh, priceLow, priceClose, volumeData, analysisWindow) =>
    // Initialize comprehensive VWAP analysis variables
    var float vwap = 0.0
    var float volumeWeightedStdDev = 0.0
    var array<float> vwapBands = array.new<float>()
    var float ofpiVwapDivergence = 0.0
    var float vwapSlope = 0.0
    var float vwapEfficiency = 0.0
    
    array.clear(vwapBands)
    
    validWindow = math.max(MICROSTRUCTURE_WINDOW, math.min(analysisWindow, VOLUME_WEIGHTED_ANALYSIS_WINDOW))
    
    if bar_index >= validWindow and not na(volumeData)
        var float cumulativeVolumePrice = 0.0
        var float cumulativeVolume = 0.0
        var array<float> volumeWeightedPrices = array.new<float>()
        var array<float> volumeWeights = array.new<float>()
        
        array.clear(volumeWeightedPrices)
        array.clear(volumeWeights)
        
        // Calculate sophisticated VWAP over analysis window
        for i = 0 to validWindow - 1
            if bar_index >= i
                iHigh = nz(priceHigh[i])
                iLow = nz(priceLow[i])
                iClose = nz(priceClose[i])
                iVolume = nz(volumeData[i])
                
                if iVolume > 0
                    // Use HLCC/4 for more accurate volume weighting
                    typicalPrice = (iHigh + iLow + iClose + iClose) / 4.0
                    volumeWeightedPrice = typicalPrice * iVolume
                    
                    cumulativeVolumePrice += volumeWeightedPrice
                    cumulativeVolume += iVolume
                    array.push(volumeWeightedPrices, typicalPrice)
                    array.push(volumeWeights, iVolume)
        
        // Calculate final VWAP with enhanced precision
        if cumulativeVolume > 0
            vwap := cumulativeVolumePrice / cumulativeVolume
            
            // Calculate volume-weighted standard deviation using proper weighting
            var float weightedVarianceSum = 0.0
            var float weightSum = 0.0
            
            for i = 0 to array.size(volumeWeightedPrices) - 1
                price = array.get(volumeWeightedPrices, i)
                weight = array.get(volumeWeights, i)
                
                weightedVarianceSum += weight * math.pow(price - vwap, 2)
                weightSum += weight
            
            if weightSum > 0
                volumeWeightedStdDev := math.sqrt(weightedVarianceSum / weightSum)
                
                // Calculate multiple VWAP bands with statistical significance
                var array<float> bandMultipliers = array.new<float>()
                array.push(bandMultipliers, 0.5)
                array.push(bandMultipliers, 1.0)
                array.push(bandMultipliers, 1.5)
                array.push(bandMultipliers, 2.0)
                array.push(bandMultipliers, 2.5)
                array.push(bandMultipliers, 3.0)
                
                for i = 0 to array.size(bandMultipliers) - 1
                    multiplier = array.get(bandMultipliers, i)
                    upperBand = vwap + multiplier * volumeWeightedStdDev
                    lowerBand = vwap - multiplier * volumeWeightedStdDev
                    array.push(vwapBands, upperBand)
                    array.push(vwapBands, lowerBand)
            
            // Calculate VWAP slope for trend analysis
            if bar_index >= validWindow + 5
                oldVwap = vwap  // This would be calculated from previous periods in full implementation
                vwapSlope := (vwap - oldVwap) / 5.0  // Simplified slope calculation
            
            // Calculate VWAP efficiency (how much price stays near VWAP)
            var float vwapDeviationSum = 0.0
            for i = 0 to math.min(validWindow, 20) - 1
                if bar_index >= i
                    priceDeviation = math.abs(nz(priceClose[i]) - vwap) / vwap
                    vwapDeviationSum += priceDeviation
            
            vwapEfficiency := 1.0 / (1.0 + vwapDeviationSum / 20.0)
        
        // Calculate sophisticated OFPI-VWAP divergence analysis
        [rawOFPI, smoothedOFPI, adaptiveOFPI, ofpiMomentum, ofpiVolatility, ofpiTrend] = calculateAdvancedOFPI(open, priceHigh, priceLow, priceClose, volumeData, PRESSURE_SMOOTHING_PERIOD, true)
        
        priceVwapDivergence = vwap > 0 ? (priceClose - vwap) / vwap : 0.0
        ofpiDirection = adaptiveOFPI > 0 ? 1.0 : -1.0
        priceDirection = priceVwapDivergence > 0 ? 1.0 : -1.0
        
        // Enhanced divergence calculation with momentum consideration
        basicDivergence = ofpiDirection != priceDirection ? math.abs(priceVwapDivergence) : 0.0
        momentumDivergence = math.abs(ofpiMomentum) > 0.01 ? math.abs(ofpiMomentum - priceVwapDivergence) : 0.0
        
        ofpiVwapDivergence := (basicDivergence + momentumDivergence) / 2.0
    
    [vwap, volumeWeightedStdDev, vwapBands, ofpiVwapDivergence, vwapSlope, vwapEfficiency]

// ============================================================================
// EXPORT FUNCTIONS FOR EXTERNAL ACCESS
// Comprehensive Order Flow Analysis Interface
// ============================================================================

// @function Performs comprehensive order flow analysis with advanced institutional detection
// @param priceOpen float Opening price for analysis
// @param priceHigh float High price for range calculation
// @param priceLow float Low price for support detection
// @param priceClose float Closing price for trend assessment
// @param volumeData float Volume data for flow analysis
// @param analysisWindow int Analysis window period
// @param institutionalSensitivity float Institutional detection sensitivity
// @returns [float, float, bool, float, string, float, string, bool, string, float, float] OFPI, momentum, institutional detected, strength, phase, overall strength, class, volume available, trend, efficiency, market structure
export analyzeAdvancedOrderFlow(float priceOpen, float priceHigh, float priceLow, float priceClose, float volumeData, int analysisWindow, float institutionalSensitivity) =>
    // Validate inputs and set defaults with enhanced parameter checking
    validWindow = math.max(MICROSTRUCTURE_WINDOW, math.min(analysisWindow, VOLUME_WEIGHTED_ANALYSIS_WINDOW))
    validSensitivity = math.max(0.1, math.min(institutionalSensitivity, 1.0))
    
    // Calculate comprehensive advanced OFPI with all enhancements
    [rawOFPI, smoothedOFPI, adaptiveOFPI, ofpiMomentum, ofpiVolatility, ofpiTrend] = calculateAdvancedOFPI(priceOpen, priceHigh, priceLow, priceClose, volumeData, PRESSURE_SMOOTHING_PERIOD, true)
    
    // Detect sophisticated institutional activity
    [institutionalDetected, institutionalStrength, institutionalPhase, institutionalSignatures, detectionMethods, confidenceScore] = detectInstitutionalAccumulation(priceClose, volumeData, validWindow, validSensitivity)
    
    // Calculate comprehensive volume distribution with institutional footprints
    [volumeProfile, priceProfile, pressureProfile, clusterSizes, footprints] = calculateVolumeDistributionProfile(priceHigh, priceLow, priceClose, volumeData, validWindow)
    
    // Calculate advanced volume-weighted analysis
    [vwap, vwapStdDev, vwapBands, ofpiVwapDivergence, vwapSlope, vwapEfficiency] = calculateVolumeWeightedAnalysis(priceHigh, priceLow, priceClose, volumeData, validWindow)
    
    // Calculate overall order flow strength with multi-factor analysis
    volumeAvailable = not na(volumeData)
    ofpiStrength = math.abs(adaptiveOFPI)
    institutionalComponent = institutionalDetected ? institutionalStrength * 0.4 : 0.0
    vwapComponent = math.abs(ofpiVwapDivergence) * 0.25
    momentumComponent = math.abs(ofpiMomentum) * 0.2
    volatilityComponent = ofpiVolatility * 0.15
    
    overallOrderFlowStrength = ofpiStrength + institutionalComponent + vwapComponent + momentumComponent + volatilityComponent
    
    // Determine comprehensive order flow classification
    var orderFlowClass = ""
    if overallOrderFlowStrength >= 0.85
        orderFlowClass := "Very Strong Flow"
    else if overallOrderFlowStrength >= 0.7
        orderFlowClass := "Strong Flow"
    else if overallOrderFlowStrength >= 0.5
        orderFlowClass := "Moderate Flow"
    else if overallOrderFlowStrength >= 0.3
        orderFlowClass := "Weak Flow"
    else if overallOrderFlowStrength >= 0.15
        orderFlowClass := "Minimal Flow"
    else
        orderFlowClass := "No Significant Flow"
    
    // Calculate order flow efficiency and market structure metrics
    orderFlowEfficiency = vwapEfficiency * (1.0 - ofpiVolatility)
    marketStructureStrength = institutionalStrength * confidenceScore
    
    [adaptiveOFPI, ofpiMomentum, institutionalDetected, institutionalStrength, institutionalPhase, overallOrderFlowStrength, orderFlowClass, volumeAvailable, ofpiTrend, orderFlowEfficiency, marketStructureStrength]

// @function Calculates sophisticated order flow pressure with comprehensive candle microstructure analysis
// @param priceOpen float Opening price for pressure calculation
// @param priceHigh float High price for range analysis
// @param priceLow float Low price for support detection
// @param priceClose float Closing price for trend assessment
// @param volumeData float Volume data for pressure analysis
// @param microWindow int Microstructure analysis window
// @returns [float, float, float, float, float, float, float, float, float, float, float] Pressure index, buying pressure, selling pressure, body ratio, upper wick ratio, lower wick ratio, microstructure confidence, volume confirmation, institutional pressure, pressure velocity, microstructure quality
export calculateMicrostructurePressure(float priceOpen, float priceHigh, float priceLow, float priceClose, float volumeData, int microWindow) =>
    // Calculate comprehensive detailed pressure components
    [buyingPressure, sellingPressure, netOrderFlow, pressureIndex, institutionalPressure, pressureVelocity] = calculateOrderFlowPressureIndex(priceOpen, priceHigh, priceLow, priceClose, volumeData, microWindow)
    
    // Calculate advanced candle microstructure metrics
    candleRange = priceHigh - priceLow
    bodySize = math.abs(priceClose - priceOpen)
    upperWick = priceHigh - math.max(priceOpen, priceClose)
    lowerWick = math.min(priceOpen, priceClose) - priceLow
    
    // Advanced microstructure ratios with statistical significance
    bodyRatio = candleRange > 0 ? bodySize / candleRange : 0.0
    upperWickRatio = candleRange > 0 ? upperWick / candleRange : 0.0
    lowerWickRatio = candleRange > 0 ? lowerWick / candleRange : 0.0
    
    // Sophisticated pressure interpretation based on candle structure
    bullishMicrostructure = priceClose > priceOpen and bodyRatio > 0.6 and lowerWickRatio < 0.25
    bearishMicrostructure = priceClose < priceOpen and bodyRatio > 0.6 and upperWickRatio < 0.25
    indecisionMicrostructure = bodyRatio < 0.25 or (upperWickRatio > 0.4 and lowerWickRatio > 0.4)
    absorptionMicrostructure = bodyRatio < 0.15 and (upperWickRatio > 0.3 or lowerWickRatio > 0.3)
    
    // Calculate microstructure confidence with multiple factors
    var float microstructureConfidence = 0.0
    if bullishMicrostructure or bearishMicrostructure
        microstructureConfidence := bodyRatio * (1.0 + math.abs(netOrderFlow))
    else if absorptionMicrostructure
        microstructureConfidence := (1.0 - bodyRatio) * math.abs(institutionalPressure)
    else if indecisionMicrostructure
        microstructureConfidence := 0.5 - bodyRatio
    else
        microstructureConfidence := 0.4
    
    // Enhanced volume confirmation with institutional detection algorithms
    // Use consistent volume analysis with global scope
    var float smaVolume20 = 0.0
    smaVolume20 := ta.sma(volumeData, 20)
    
    var float volumeConfirmation = 0.0
    if na(volumeData)
        volumeConfirmation := 0.5
    else
        // Advanced volume classification using statistical thresholds
        if volumeData > smaVolume20 * 2.0
            volumeConfirmation := 0.9  // Very high volume classification
        else if volumeData > smaVolume20 * 1.5
            volumeConfirmation := 0.8  // High volume classification
        else if volumeData > smaVolume20
            volumeConfirmation := 0.7  // Above average volume classification
        else
            volumeConfirmation := 0.4  // Below average volume classification
    
    // Calculate pressure persistence (how long pressure has been in same direction)
    var int pressurePersistence = 0
    if bar_index >= 5
        currentDirection = pressureIndex > 0 ? 1 : -1
        for i = 1 to 5
            if bar_index >= i
                historicalDirection = nz(pressureIndex[i]) > 0 ? 1 : -1
                if historicalDirection == currentDirection
                    pressurePersistence += 1
                else
                    break
    
    persistenceScore = pressurePersistence / 5.0
    
    // Calculate microstructure quality score
    microstructureQuality = (microstructureConfidence + volumeConfirmation + persistenceScore) / 3.0
    
    [pressureIndex, buyingPressure, sellingPressure, bodyRatio, upperWickRatio, lowerWickRatio, microstructureConfidence, volumeConfirmation, institutionalPressure, pressureVelocity, microstructureQuality]

// @function Generates sophisticated volume-weighted institutional activity alerts
// @param priceClose float Close price for analysis
// @param volumeData float Volume data for detection
// @param alertSensitivity float Alert sensitivity threshold
// @param lookbackPeriod int Analysis lookback period
// @returns [bool, string, string, float, float, float, float, float, float, float, int, int] Institutional detected, alert level, phase, strength, volume signature, pressure signature, time signature, absorption signature, impact signature, reliability, active methods, priority
export generateInstitutionalAlerts(float priceClose, float volumeData, float alertSensitivity, int lookbackPeriod) =>
    // Calculate comprehensive institutional metrics
    validSensitivity = math.max(0.1, math.min(alertSensitivity, 1.0))
    validLookback = math.max(10, math.min(lookbackPeriod, 100))
    
    [institutionalDetected, institutionalStrength, institutionalPhase, institutionalSignatures, detectionMethods, confidenceScore] = detectInstitutionalAccumulation(priceClose, volumeData, validLookback, validSensitivity)
    
    // Calculate sophisticated alert conditions with multiple criteria
    var accumulationAlert = false
    var distributionAlert = false
    var markupAlert = false
    var markdownAlert = false
    var absorptionAlert = false
    var breakoutAlert = false
    
    if institutionalDetected and confidenceScore > 0.6
        accumulationAlert := institutionalPhase == ACCUMULATION_PHASE and institutionalStrength > 0.75
        distributionAlert := institutionalPhase == DISTRIBUTION_PHASE and institutionalStrength > 0.75
        markupAlert := institutionalPhase == MARKUP_PHASE and institutionalStrength > 0.85
        markdownAlert := institutionalPhase == MARKDOWN_PHASE and institutionalStrength > 0.85
        absorptionAlert := institutionalPhase == ABSORPTION_PHASE and institutionalStrength > 0.7
        breakoutAlert := institutionalPhase == BREAKOUT_PHASE and institutionalStrength > 0.8
    
    // Calculate detailed signature strength distribution
    var volumeSignatureStrength = 0.0
    var pressureSignatureStrength = 0.0
    var timeSignatureStrength = 0.0
    var absorptionSignatureStrength = 0.0
    var impactSignatureStrength = 0.0
    
    if array.size(institutionalSignatures) >= 5
        volumeSignatureStrength := array.get(institutionalSignatures, 0)
        pressureSignatureStrength := array.get(institutionalSignatures, 1)
        timeSignatureStrength := array.get(institutionalSignatures, 4)
        absorptionSignatureStrength := array.get(institutionalSignatures, 5)
        if array.size(institutionalSignatures) > 6
            impactSignatureStrength := array.get(institutionalSignatures, 6)
    
    // Calculate alert priority and overall alert level
    var alertPriority = 0
    if markupAlert or markdownAlert
        alertPriority := 4
    else if absorptionAlert or breakoutAlert
        alertPriority := 3
    else if accumulationAlert or distributionAlert
        alertPriority := 2
    else if institutionalDetected
        alertPriority := 1
    
    // Overall alert level classification
    var alertLevel = ""
    if alertPriority >= 4
        alertLevel := "Critical"
    else if alertPriority >= 3
        alertLevel := "High"
    else if alertPriority >= 2
        alertLevel := "Medium"
    else if alertPriority >= 1
        alertLevel := "Low"
    else
        alertLevel := "None"
    
    // Calculate alert reliability score
    alertReliability = (confidenceScore + institutionalStrength + volumeSignatureStrength) / 3.0
    
    // Determine number of active detection methods
    activeDetectionMethods = array.size(detectionMethods)
    
    [institutionalDetected, alertLevel, institutionalPhase, institutionalStrength, volumeSignatureStrength, pressureSignatureStrength, timeSignatureStrength, absorptionSignatureStrength, impactSignatureStrength, alertReliability, activeDetectionMethods, alertPriority]