// -------------------------------------------------------
// Description
// -------------------------------------------------------
// Fire-themed color palette for scripting with light and dark theme variants

// -------------------------------------------------------
// Script
// -------------------------------------------------------
//@version=5
library("AFL0001")

// =======================================================
//
// ENUM (COPY TO SCRIPT)
//
// =======================================================

enum AF_COLOR
    // Primary Colors
    PRIMARY1       = "AlgoFyre Primary 1"
    PRIMARY2       = "AlgoFyre Primary 2"
    PRIMARY3       = "AlgoFyre Primary 3"
    PRIMARY4       = "AlgoFyre Primary 4"
    PRIMARY5       = "AlgoFyre Primary 5"
    PRIMARY6       = "AlgoFyre Primary 6"
    PRIMARY7       = "AlgoFyre Primary 7"
    PRIMARY8       = "AlgoFyre Primary 8"
    PRIMARY9       = "AlgoFyre Primary 9"
    PRIMARY10      = "AlgoFyre Primary 10"
    // Backgrounds
    BG_LIGHT       = "AlgoFyre Light"
    BG_NORMAL      = "AlgoFyre Normal"
    BG_DARK        = "AlgoFyre Dark"
    // Signals
    GREEN_LIGHT    = "AlgoFyre Green Light"
    GREEN_NORMAL   = "AlgoFyre Green Normal"
    GREEN_DARK     = "AlgoFyre Green Dark"
    YELLOW_LIGHT   = "AlgoFyre Yellow Light"
    YELLOW_NORMAL  = "AlgoFyre Yellow Normal"
    YELLOW_DARK    = "AlgoFyre Yellow Dark"
    ORANGE_LIGHT   = "AlgoFyre Orange Light"
    ORANGE_NORMAL  = "AlgoFyre Orange Normal"
    ORANGE_DARK    = "AlgoFyre Orange Dark"
    RED_LIGHT      = "AlgoFyre Red Light"
    RED_NORMAL     = "AlgoFyre Red Normal"
    RED_DARK       = "AlgoFyre Red Dark"
    MAGENTA_LIGHT  = "AlgoFyre Magenta Light"
    MAGENTA_NORMAL = "AlgoFyre Magenta Normal"
    MAGENTA_DARK   = "AlgoFyre Magenta Dark"
    CYAN_LIGHT     = "AlgoFyre Cyan Light"
    CYAN_NORMAL    = "AlgoFyre Cyan Normal"
    CYAN_DARK      = "AlgoFyre Cyan Dark"
    BLUE_LIGHT     = "AlgoFyre Blue Light"
    BLUE_NORMAL    = "AlgoFyre Blue Normal"
    BLUE_DARK      = "AlgoFyre Blue Dark"

// Convert function
getEnumString(AF_COLOR color_enum) =>
    switch color_enum
        AF_COLOR.PRIMARY1       => "AlgoFyre Primary 1"
        AF_COLOR.PRIMARY2       => "AlgoFyre Primary 2"
        AF_COLOR.PRIMARY3       => "AlgoFyre Primary 3"
        AF_COLOR.PRIMARY4       => "AlgoFyre Primary 4"
        AF_COLOR.PRIMARY5       => "AlgoFyre Primary 5"
        AF_COLOR.PRIMARY6       => "AlgoFyre Primary 6"
        AF_COLOR.PRIMARY7       => "AlgoFyre Primary 7"
        AF_COLOR.PRIMARY8       => "AlgoFyre Primary 8"
        AF_COLOR.PRIMARY9       => "AlgoFyre Primary 9"
        AF_COLOR.PRIMARY10      => "AlgoFyre Primary 10"
        AF_COLOR.BG_LIGHT       => "AlgoFyre Light"
        AF_COLOR.BG_NORMAL      => "AlgoFyre Normal"
        AF_COLOR.BG_DARK        => "AlgoFyre Dark"
        AF_COLOR.GREEN_LIGHT    => "AlgoFyre Green Light"
        AF_COLOR.GREEN_NORMAL   => "AlgoFyre Green Normal"
        AF_COLOR.GREEN_DARK     => "AlgoFyre Green Dark"
        AF_COLOR.YELLOW_LIGHT   => "AlgoFyre Yellow Light"
        AF_COLOR.YELLOW_NORMAL  => "AlgoFyre Yellow Normal"
        AF_COLOR.YELLOW_DARK    => "AlgoFyre Yellow Dark"
        AF_COLOR.ORANGE_LIGHT   => "AlgoFyre Orange Light"
        AF_COLOR.ORANGE_NORMAL  => "AlgoFyre Orange Normal"
        AF_COLOR.ORANGE_DARK    => "AlgoFyre Orange Dark"
        AF_COLOR.RED_LIGHT      => "AlgoFyre Red Light"
        AF_COLOR.RED_NORMAL     => "AlgoFyre Red Normal"
        AF_COLOR.RED_DARK       => "AlgoFyre Red Dark"
        AF_COLOR.MAGENTA_LIGHT  => "AlgoFyre Magenta Light"
        AF_COLOR.MAGENTA_NORMAL => "AlgoFyre Magenta Normal"
        AF_COLOR.MAGENTA_DARK   => "AlgoFyre Magenta Dark"
        AF_COLOR.CYAN_LIGHT     => "AlgoFyre Cyan Light"
        AF_COLOR.CYAN_NORMAL    => "AlgoFyre Cyan Normal"
        AF_COLOR.CYAN_DARK      => "AlgoFyre Cyan Dark"
        AF_COLOR.BLUE_LIGHT     => "AlgoFyre Blue Light"
        AF_COLOR.BLUE_NORMAL    => "AlgoFyre Blue Normal"
        AF_COLOR.BLUE_DARK      => "AlgoFyre Blue Dark"
        => "Unknown Color"

// =======================================================
//
// ALGOFYRE THEME
//
// =======================================================

// -------------------------------------------------------
// Primary Colors
// -------------------------------------------------------

const color PRIMARY1        = #ffc400
const color PRIMARY2        = #ffa900
const color PRIMARY3        = #ff9500
const color PRIMARY4        = #ff8a00
const color PRIMARY5        = #ff8000
const color PRIMARY6        = #e66400
const color PRIMARY7        = #cc4800
const color PRIMARY8        = #b32c00
const color PRIMARY9        = #991000
const color PRIMARY10       = #be0000

// -------------------------------------------------------
// Backgrounds
// -------------------------------------------------------

const color BG_LIGHT        = #eee6df
const color BG_NORMAL       = #c9b9ad
const color BG_DARK         = #242220

// -------------------------------------------------------
// Signals
// -------------------------------------------------------

// Green
const color GREEN_LIGHT     = #b6f83a
const color GREEN_NORMAL    = #75b400
const color GREEN_DARK      = #456903

// Yellow
const color YELLOW_LIGHT    = #ffd753
const color YELLOW_NORMAL   = #ffc400
const color YELLOW_DARK     = #cc9e00

// Orange
const color ORANGE_LIGHT    = #ff8000
const color ORANGE_NORMAL   = #d46b00
const color ORANGE_DARK     = #8f4700

// Red
const color RED_LIGHT       = #ff5233
const color RED_NORMAL      = #da2303
const color RED_DARK        = #8d1601

// Magenta
const color MAGENTA_LIGHT   = #ff5efa
const color MAGENTA_NORMAL  = #ce00c7
const color MAGENTA_DARK    = #470045

// Cyan
const color CYAN_LIGHT      = #6adcff
const color CYAN_NORMAL     = #00a7da
const color CYAN_DARK       = #00769a

// Blue
const color BLUE_LIGHT      = #7192ff
const color BLUE_NORMAL     = #0033db
const color BLUE_DARK       = #001868
// =======================================================
//
// EXPORT FUNCTIONS
//
// =======================================================

// @param color_name returns the respective color
// @param return type
export getColorByID(string color_id, int transparency) =>
    switch color_id
        // Primary Colors
        "PRIMARY1"         => color.new(PRIMARY1, transparency)
        "PRIMARY2"         => color.new(PRIMARY2, transparency)
        "PRIMARY3"         => color.new(PRIMARY3, transparency)
        "PRIMARY4"         => color.new(PRIMARY4, transparency)
        "PRIMARY5"         => color.new(PRIMARY5, transparency)
        "PRIMARY6"         => color.new(PRIMARY6, transparency)
        "PRIMARY7"         => color.new(PRIMARY7, transparency)
        "PRIMARY8"         => color.new(PRIMARY8, transparency)
        "PRIMARY9"         => color.new(PRIMARY9, transparency)
        "PRIMARY10"        => color.new(PRIMARY10, transparency)
        // Backgrounds
        "BG_LIGHT"         => color.new(BG_LIGHT, transparency)
        "BG_NORMAL"        => color.new(BG_NORMAL, transparency)
        "BG_DARK"          => color.new(BG_DARK, transparency)
        // Signals
        "GREEN_LIGHT"      => color.new(GREEN_LIGHT, transparency)
        "GREEN_NORMAL"     => color.new(GREEN_NORMAL, transparency)
        "GREEN_DARK"       => color.new(GREEN_DARK, transparency)
        "YELLOW_LIGHT"     => color.new(YELLOW_LIGHT, transparency)
        "YELLOW_NORMAL"    => color.new(YELLOW_NORMAL, transparency)
        "YELLOW_DARK"      => color.new(YELLOW_DARK, transparency)
        "ORANGE_LIGHT"     => color.new(ORANGE_LIGHT, transparency)
        "ORANGE_NORMAL"    => color.new(ORANGE_NORMAL, transparency)
        "ORANGE_DARK"      => color.new(ORANGE_DARK, transparency)
        "RED_LIGHT"        => color.new(RED_LIGHT, transparency)
        "RED_NORMAL"       => color.new(RED_NORMAL, transparency)
        "RED_DARK"         => color.new(RED_DARK, transparency)
        "MAGENTA_LIGHT"    => color.new(MAGENTA_LIGHT, transparency)
        "MAGENTA_NORMAL"   => color.new(MAGENTA_NORMAL, transparency)
        "MAGENTA_DARK"     => color.new(MAGENTA_DARK, transparency)
        "CYAN_LIGHT"       => color.new(CYAN_LIGHT, transparency)
        "CYAN_NORMAL"      => color.new(CYAN_NORMAL, transparency)
        "CYAN_DARK"        => color.new(CYAN_DARK, transparency)
        "BLUE_LIGHT"       => color.new(BLUE_LIGHT, transparency)
        "BLUE_NORMAL"      => color.new(BLUE_NORMAL, transparency)
        "BLUE_DARK"        => color.new(BLUE_DARK, transparency)
        => na

export getColorByName(string color_name) =>
    switch color_name
        // Primary Colors
        "AlgoFyre Primary 1"      => PRIMARY1
        "AlgoFyre Primary 2"      => PRIMARY2
        "AlgoFyre Primary 3"      => PRIMARY3
        "AlgoFyre Primary 4"      => PRIMARY4
        "AlgoFyre Primary 5"      => PRIMARY5
        "AlgoFyre Primary 6"      => PRIMARY6
        "AlgoFyre Primary 7"      => PRIMARY7
        "AlgoFyre Primary 8"      => PRIMARY8
        "AlgoFyre Primary 9"      => PRIMARY9
        "AlgoFyre Primary 10"     => PRIMARY10
        // Backgrounds
        "AlgoFyre Light"          => BG_LIGHT
        "AlgoFyre Normal"         => BG_NORMAL
        "AlgoFyre Dark"           => BG_DARK
        // Signals
        "AlgoFyre Green Light"    => GREEN_LIGHT
        "AlgoFyre Green Normal"   => GREEN_NORMAL
        "AlgoFyre Green Dark"     => GREEN_DARK
        "AlgoFyre Yellow Light"   => YELLOW_LIGHT
        "AlgoFyre Yellow Normal"  => YELLOW_NORMAL
        "AlgoFyre Yellow Dark"    => YELLOW_DARK
        "AlgoFyre Orange Light"   => ORANGE_LIGHT
        "AlgoFyre Orange Normal"  => ORANGE_NORMAL
        "AlgoFyre Orange Dark"    => ORANGE_DARK
        "AlgoFyre Red Light"      => RED_LIGHT
        "AlgoFyre Red Normal"     => RED_NORMAL
        "AlgoFyre Red Dark"       => RED_DARK
        "AlgoFyre Magenta Light"  => MAGENTA_LIGHT
        "AlgoFyre Magenta Normal" => MAGENTA_NORMAL
        "AlgoFyre Magenta Dark"   => MAGENTA_DARK
        "AlgoFyre Cyan Light"     => CYAN_LIGHT
        "AlgoFyre Cyan Normal"    => CYAN_NORMAL
        "AlgoFyre Cyan Dark"      => CYAN_DARK
        "AlgoFyre Blue Light"     => BLUE_LIGHT
        "AlgoFyre Blue Normal"    => BLUE_NORMAL
        "AlgoFyre Blue Dark"      => BLUE_DARK
        => na