//@version=5

// @description: Contains multiple useful utilities.
library("utilities", true)

// @function: 						Converts a decimal number into a string formatted as percentage.
// @param x (simple float): 		Float number to be converted
// @param decimals (simple int):	Number of decimals to apply
// @returns: 						Returns a string with x as percentage.
export toPercentageString(float x, int decimals) =>
    str.tostring(math.round(x * 100, decimals)) + '%'

// @function: 						Converts a decimal number into a string formatted as Factor.
// @param x (simple float): 		Float number to be converted
// @param decimals (simple int):	Number of decimals to apply
// @returns: 						Returns a string with x as a Factor.
export toFactorString(float x, int decimals) =>
    str.tostring(math.round(x,decimals)) + 'x'

// @function: 						Converts a decimal number into a string formatted as currency.
// @param x (simple float): 		Float number to be converted
// @param decimals (simple int):	Number of decimals to apply
// @returns: 						Returns a string with x as currency.
export toCurrencyString(float x, int decimals) =>
    '$' + str.tostring(math.round(x,decimals),"#,###.##")

// @function: 						Converts a decimal number into a string formatted as decimal.
// @param x (simple float): 		Float number to be converted
// @param decimals (simple int):	Number of decimals to apply
// @returns: 						Returns a string with x as a decimal.
export toNumberString(float x, int decimals) =>
    str.tostring(math.round(x,decimals),"#,###.#####")