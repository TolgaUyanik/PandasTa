//@version=6
indicator("Previous Close Label", overlay=true)

// 1. Grab the prior bar’s close
prevClose = close[1]

// 2. Plot it as a thin, dotted line and show its label on the price scale
plot(prevClose,title = "Prev Close",trackprice = true)