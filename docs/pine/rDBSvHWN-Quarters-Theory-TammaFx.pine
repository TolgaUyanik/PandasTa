//@version=6
// ══════════════════════════════════════════════════════════════════
//  QUARTERS THEORY (Ilian Yotov) — MLQP / MHP / Quarter / Half Point
//  Rejilla absoluta desde 0. Base = 125 pips.
//    índice % 8 == 0  -> MLQP    (1000 pips)
//    índice % 4 == 0  -> MHP     ( 500 pips)
//    índice % 2 == 0  -> QUARTER ( 250 pips)
//    resto            -> HP      ( 125 pips)
// ══════════════════════════════════════════════════════════════════
indicator("Quarters Theory — MLQP / MHP / Quarter / HP", "QT", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ─────────────── PIP ───────────────
gP        = "Pip"
pipMode   = input.string("Auto", "Cálculo del pip", options = ["Auto", "Manual"], group = gP)
pipManual = input.float(0.0001, "Pip manual", step = 0.00001, group = gP, tooltip = "EURUSD/AUDUSD/GBPUSD = 0.0001 | pares JPY = 0.01 | XAUUSD según tu criterio (p.ej. 0.10 -> quarter de 25 USD)")

// ─────────────── RANGO ───────────────
gR    = "Rango y extensión"
qUp   = input.int(3,   "Cuartos arriba (250 pips c/u)",   minval = 1, maxval = 30,   group = gR)
qDn   = input.int(3,   "Cuartos abajo (250 pips c/u)",    minval = 1, maxval = 30,   group = gR)
nUp   = qUp * 2
nDn   = qDn * 2
nBack = input.int(300, "Barras hacia atrás",              minval = 0, maxval = 5000, group = gR)
nFwd  = input.int(30,  "Barras hacia delante",            minval = 0, maxval = 400,  group = gR)

// ─────────────── QUÉ MOSTRAR ───────────────
gS       = "Mostrar"
showMLQP = input.bool(true, "MLQP · 1000 pips",      group = gS)
showMHP  = input.bool(true, "MHP · 500 pips",        group = gS)
showQ    = input.bool(true, "Quarter · 250 pips",    group = gS)
showHP   = input.bool(true, "Half Point · 125 pips", group = gS)
showLbl  = input.bool(true, "Etiquetas",             group = gS)
showTbl  = input.bool(true, "Panel de distancia",    group = gS)

// ─────────────── ESTILO ───────────────
gC    = "Estilo"
cMLQP = input.color(color.new(#e53935, 0),  "MLQP",       inline = "a", group = gC)
wMLQP = input.int(3, "", inline = "a", group = gC, minval = 1, maxval = 4)
cMHP  = input.color(color.new(#fb8c00, 10), "MHP",        inline = "b", group = gC)
wMHP  = input.int(2, "", inline = "b", group = gC, minval = 1, maxval = 4)
cQ    = input.color(color.new(#1e88e5, 20), "Quarter",    inline = "c", group = gC)
wQ    = input.int(1, "", inline = "c", group = gC, minval = 1, maxval = 4)
cHP   = input.color(color.new(#9e9e9e, 45), "Half Point", inline = "d", group = gC)
wHP   = input.int(1, "", inline = "d", group = gC, minval = 1, maxval = 4)

// ─────────────── CÁLCULO DEL PIP ───────────────
pipAuto = syminfo.currency == "JPY" ? 0.01 : (syminfo.mintick < 0.0001 ? syminfo.mintick * 10 : syminfo.mintick)
pip     = pipMode == "Manual" ? pipManual : pipAuto
paso    = 125 * pip

// ─────────────── ALMACENAMIENTO ───────────────
var line[]  lns = array.new_line()
var label[] lbs = array.new_label()
var table   tbl = table.new(position.top_right, 3, 4, border_width = 1, frame_width = 1, frame_color = color.new(color.gray, 60))

// Clasificación jerárquica del índice de la rejilla
tipoDe(idx) =>
    idx % 8 == 0 ? "MLQP" : idx % 4 == 0 ? "MHP" : idx % 2 == 0 ? "QUARTER" : "HP"

// ─────────────── DIBUJO ───────────────
if barstate.islast
    // limpiar dibujos previos
    for l in lns
        line.delete(l)
    array.clear(lns)
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)

    int base = int(math.floor(close / paso))
    int x1   = bar_index - nBack
    int x2   = bar_index + nFwd

    for i = base - nDn to base + nUp
        string t  = tipoDe(i)
        bool   ok = t == "MLQP" ? showMLQP : t == "MHP" ? showMHP : t == "QUARTER" ? showQ : showHP
        if ok
            float p  = i * paso
            color c  = t == "MLQP" ? cMLQP : t == "MHP" ? cMHP : t == "QUARTER" ? cQ : cHP
            int   w  = t == "MLQP" ? wMLQP : t == "MHP" ? wMHP : t == "QUARTER" ? wQ : wHP
            string s = t == "HP" ? line.style_dotted : line.style_solid
            array.push(lns, line.new(x1, p, x2, p, xloc = xloc.bar_index, color = c, width = w, style = s))
            if showLbl
                array.push(lbs, label.new(x2, p, t + "  " + str.tostring(p, format.mintick), xloc = xloc.bar_index, style = label.style_label_left, color = color.new(c, 88), textcolor = c, size = size.small))

// ─────────────── PANEL DE DISTANCIA ───────────────
if barstate.islast and showTbl
    int   base  = int(math.floor(close / paso))
    float lvlDn = base * paso
    float lvlUp = (base + 1) * paso
    float dDn   = (close - lvlDn) / pip
    float dUp   = (lvlUp - close) / pip

    table.cell(tbl, 0, 0, "QT",     text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 0, "Nivel",  text_color = color.gray, text_size = size.small)
    table.cell(tbl, 2, 0, "Pips",   text_color = color.gray, text_size = size.small)

    table.cell(tbl, 0, 1, tipoDe(base + 1), text_color = color.white, text_size = size.small)
    table.cell(tbl, 1, 1, str.tostring(lvlUp, format.mintick), text_color = color.white, text_size = size.small)
    table.cell(tbl, 2, 1, "+" + str.tostring(dUp, "#.#"), text_color = color.white, text_size = size.small)

    table.cell(tbl, 0, 2, tipoDe(base), text_color = color.white, text_size = size.small)
    table.cell(tbl, 1, 2, str.tostring(lvlDn, format.mintick), text_color = color.white, text_size = size.small)
    table.cell(tbl, 2, 2, "-" + str.tostring(dDn, "#.#"), text_color = color.white, text_size = size.small)

    table.cell(tbl, 0, 3, "pip", text_color = color.gray, text_size = size.tiny)
    table.cell(tbl, 1, 3, str.tostring(pip), text_color = color.gray, text_size = size.tiny)
    table.cell(tbl, 2, 3, "", text_color = color.gray, text_size = size.tiny)
