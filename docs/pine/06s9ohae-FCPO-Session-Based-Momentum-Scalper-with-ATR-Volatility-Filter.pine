//@version=5
strategy("FCPO God Mode v5 🛡️ (ATR Volatility Floor & Friday PM Shield)", overlay = true, initial_capital = 12000, default_qty_type = strategy.fixed, default_qty_value = 1, commission_type = strategy.commission.percent, commission_value = 0.0, process_orders_on_close = true, calc_on_every_tick = true)

//---------------------------------------------------------------------------------------------------------------------}
// CONSTANTS & STRINGS & INPUTS
//---------------------------------------------------------------------------------------------------------------------{
GREEN                           = #089981
RED                             = #F23645
BLUE                            = #2157f3
GOLD                            = #ffca28
GRAY                            = #878b94

SCALPER_GROUP                   = '══════ Momentum Scalper Settings ══════'
setupMode                       = input.string( 'Setup C (Max Profit) - M5 Optimized', 'God Mode Preset', group = SCALPER_GROUP, options = ['Custom (Use Manual Inputs)', 'Setup A (SL 35) - M15 Baseline', 'Setup B (SL 30) - M15 Baseline', 'Setup C (Max Profit) - M5 Optimized', 'Setup D (Peak Efficiency) - M5 Optimized'], tooltip = 'Pilih preset yang telah dioptimumkan atau pilih Custom untuk input manual.')
tpTicksInput                    = input.int(    12,         'Manual Take Profit (Ticks)',group = SCALPER_GROUP, tooltip = 'Hanya digunakan jika preset ditetapkan kepada Custom')
slTicksInput                    = input.int(    30,         'Manual Stop Loss (Ticks)',  group = SCALPER_GROUP, tooltip = 'Hanya digunakan jika preset ditetapkan kepada Custom')
atrLengthInput                  = input.int(    14,         'ATR Period',               group = SCALPER_GROUP)
atrLimitInput                   = input.float(  12.0,       'ATR Limit (Ticks)',        group = SCALPER_GROUP, tooltip = "Mengelakkan fakeout ATR tinggi.")
atrFloorInput                   = input.float(  5.0,        'ATR Floor (Ticks)',        group = SCALPER_GROUP, tooltip = "Telah dioptimumkan kepada 5.0 ticks berdasarkan penemuan kuantitatif v5 untuk mengelakkan pasaran stagnant/mati.")
bodyTicksInput                  = input.int(    12,         'Minimum Body Size (Ticks)',group = SCALPER_GROUP)
bodyRatioInput                  = input.float(  0.75,       'Min Body-to-Range Ratio',  group = SCALPER_GROUP)
enableTimeExit                  = input.bool(true,  "Enable Time Exit Limit",     group = SCALPER_GROUP, tooltip = "Mengeluarkan trade jika ia tidak mencecah TP atau SL dalam tempoh bar yang ditetapkan.")
timeExitBars                    = input.int(15,     "Time Exit Bars",             group = SCALPER_GROUP, tooltip = "Had bar sebelum trade ditutup secara paksa (Contoh: 15 Bar = 75 Minit pada M5).")
enableDailyTradeLimit           = input.bool(true,  "Enable Daily Trade Limit",   group = SCALPER_GROUP, tooltip = "Menghentikan trading selepas mencapai had maksimum transaksi sehari.")
maxTradesPerDay                 = input.int(1,      "Max Trades Per Day",         group = SCALPER_GROUP, tooltip = "Had maksimum transaksi sehari.")
sessionExitMode                 = input.string("Carry Through Lunch", "Session Exit Handling", group = SCALPER_GROUP, options = ["TradingView Buggy Baseline", "Exit at 12:30 Sharp", "Carry Through Lunch"], tooltip = "Pilih bagaimana trade yang masih aktif dikendalikan ketika sesi pasaran tamat. 'Carry Through Lunch' memberikan profit tertinggi (RM 56.7k)!")

SESSION_GROUP                   = '══════ Session & Timing Settings ══════'
sessionTimezoneInput            = input.string( "Asia/Kuala_Lumpur", "Timezone",             group = SESSION_GROUP)
sessionMorningInput             = input.session("1030-1230", "Morning Session",             group = SESSION_GROUP)
sessionNoonInput                = input.session("1430-1800", "Noon Session",                group = SESSION_GROUP)
sessionNightInput               = input.session("2100-2330", "Night Session (Visual Only)", group = SESSION_GROUP)
enableEodExit                   = input.bool(true, "Enable Force EOD Exit (17:55)", group = SESSION_GROUP, tooltip = "Jika untick, position TIDAK akan ditutup secara automatik pada jam 17:55 (EOD).")

// DAY FILTER — individual checkboxes per weekday
DAY_GROUP                       = '══════ Day Filter Settings ══════'
enableMonday                    = input.bool(true,  "✅ Trade on Monday   (RM +10,300 | WR 64.6%)",  group = DAY_GROUP, tooltip = "TradingView verified: Monday sahaja = RM 10,300 (113 trades, WR 64.6%, Avg RM +91/trade). Nyahtick untuk melumpuhkan semua trade pada hari Isnin.")
enableTuesday                   = input.bool(false, "⚠️ Trade on Tuesday  (Not tested alone)",       group = DAY_GROUP, tooltip = "Tiada data TradingView individu untuk Selasa. Data asas: WR ~63%, Avg RM +60/trade. Default OFF — aktifkan jika mahu uji.")
enableWednesday                 = input.bool(true,  "🏆 Trade on Wednesday (RM +16,200 | WR 67.9%)",  group = DAY_GROUP, tooltip = "TradingView verified: Wednesday sahaja = RM 16,200 (131 trades, WR 67.9%, Avg RM +124/trade). Hari TERBAIK berdasarkan ujian sebenar. Sentiasa ON.")
enableThursday                  = input.bool(false, "❌ Trade on Thursday (Weak — Disyorkan: OFF)", group = DAY_GROUP, tooltip = "Hari paling lemah. Disyorkan: DISABLE. Data analisis penuh: WR ~61%, Avg RM +69/trade. Jika hanya Mon+Wed: kekalkan OFF untuk keputusan terbaik.")
enableFriday                    = input.bool(false, "⚠️ Trade on Friday   (Volatile — optional)",    group = DAY_GROUP, tooltip = "Jumaat PM sering volatile (Friday PM Whipsaw zone diblock 17:00-18:00). Data: WR ~58%, Avg RM +29/trade — paling lemah dalam ujian penuh. Default OFF.")

// DIRECTION FILTER 
DIRECTION_GROUP                 = '══════ Direction Filter Settings ══════'
tradeDirection                  = input.string('Both', 'Allow Trade Direction', group = DIRECTION_GROUP, options = ['Both', 'Short Only', 'Long Only'])

// TRENDLINE FILTER
TRENDLINE_GROUP                 = '══════ Auto Trendline Breakout Filter ══════'
enableTrendline                 = input.bool(false, "Enable Auto Trendline Filter", group=TRENDLINE_GROUP, tooltip="Apabila diaktifkan, sistem akan AUTO-LUKIS trendline (menggunakan harga Pivot) dan trade HANYA masuk jika break line ini.")
pivotLen                        = input.int(5, "Pivot Lookback Length", group=TRENDLINE_GROUP, minval=2, tooltip="Bilangan candle untuk membentuk Puncak (High) & Lembah (Low). Nilai 5 lebih laju dan sensitif untuk mengesan bentuk Triangle/Wedge M5.")

// PRECISION TIME EXCLUSION ZONES
EXCLUSION_GROUP                 = '══════ Precision Time Exclusions ══════'
excludeWhipsawZone              = input.bool(true,  "Exclude Whipsaw Zone (15:30-16:00)", group = EXCLUSION_GROUP)
excludeEodZone                  = input.bool(true,  "Exclude EOD Danger Zone (17:30-18:00)", group = EXCLUSION_GROUP)
excludeFridayPM                 = input.bool(true,  "Exclude Friday PM Whipsaw (17:00-18:00)", group = EXCLUSION_GROUP, tooltip = "Mengelakkan whipsaw akhir minggu kerana profit-taking traders squaring off positions.")

// ═══ MONTHLY CIRCUIT BREAKER ═══
MONTHLY_CB_GROUP                = '══════ Monthly Profit Lock Settings ══════'
enableMonthlyLimit              = input.bool(true,  "Enable Monthly Profit Limit",   group = MONTHLY_CB_GROUP, tooltip = "Menghentikan semua trade baru untuk bulan kalendar semasa apabila sasaran ticks tercapai.")
monthlyMaxTicks                 = input.int(100,    "Monthly Profit Target (Ticks)", group = MONTHLY_CB_GROUP, tooltip = "Sasaran keuntungan bersih bulanan dalam unit ticks (Contoh: 100 Ticks = RM 2,500 kasar untuk 1 lot).")
enableMonthlyLossLimit          = input.bool(false, "Enable Monthly Loss Limit",     group = MONTHLY_CB_GROUP, tooltip = "[v1 TP22/SL60: DISABLE] Analisis CSV v1 buktikan hanya 1 bulan dalam 3.5 tahun melebihi -RM3,000. Aktifkan hanya jika guna v2 TP25/SL65.")
monthlyMinTicks                 = input.int(-120,   "Monthly Loss Limit (Ticks)",    group = MONTHLY_CB_GROUP, tooltip = "-120 Ticks = -RM 3,000 had kerugian bulanan. Jika ticks bulanan jatuh ke paras ini, tiada trade baru sehingga bulan berikutnya.")

VISUALS_GROUP                   = '══════ Chart Visual Settings ══════'
showVerticalLines               = input.bool(true,  "Show Session Vertical Lines",   group = VISUALS_GROUP)
showBackgrounds                 = input.bool(true,  "Highlight Session Backgrounds", group = VISUALS_GROUP)
showExclusionZones              = input.bool(true,  "Highlight Excluded Danger Zones", group = VISUALS_GROUP)
showCircuitBreakerAlert         = input.bool(true,  "Show Circuit Breaker Labels",   group = VISUALS_GROUP)
showMA                          = input.bool(true,  "Show 200 SMA Context Line",     group = VISUALS_GROUP)
showAtrBand                     = input.bool(true,  "Show ATR Volatility Bands",     group = VISUALS_GROUP)
showDashboard                   = input.bool(true,  "Show Real-Time Dashboard Info", group = VISUALS_GROUP)

//---------------------------------------------------------------------------------------------------------------------}
// DATA CALCULATIONS
//---------------------------------------------------------------------------------------------------------------------{

// Auto Trendline Calculations
var float ph1_val = na, var int ph1_time = na
var float ph2_val = na, var int ph2_time = na
var float pl1_val = na, var int pl1_time = na
var float pl2_val = na, var int pl2_time = na

ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

if not na(ph)
    ph2_val := ph1_val
    ph2_time := ph1_time
    ph1_val := ph
    ph1_time := time[pivotLen]

if not na(pl)
    pl2_val := pl1_val
    pl2_time := pl1_time
    pl1_val := pl
    pl1_time := time[pivotLen]

get_line_val(t1, p1, t2, p2, t) =>
    if t1 == t2 or na(t1) or na(t2)
        na
    else
        m = (p2 - p1) / (t2 - t1)
        p1 + m * (t - t1)

validUpperLine = not na(ph1_time) and not na(ph2_time) and ph1_time != ph2_time
validLowerLine = not na(pl1_time) and not na(pl2_time) and pl1_time != pl2_time

upperLineVal = get_line_val(ph2_time, ph2_val, ph1_time, ph1_val, time)
lowerLineVal = get_line_val(pl2_time, pl2_val, pl1_time, pl1_val, time)

trendlineLongOk = not enableTrendline or not validUpperLine or (not na(upperLineVal) and close > upperLineVal)
trendlineShortOk = not enableTrendline or not validLowerLine or (not na(lowerLineVal) and close < lowerLineVal)

// Day Filter
isMonday    = dayofweek == dayofweek.monday
isTuesday   = dayofweek == dayofweek.tuesday
isWednesday = dayofweek == dayofweek.wednesday
isThursday  = dayofweek == dayofweek.thursday
isFriday    = dayofweek == dayofweek.friday

// isActiveDay now respects individual day checkboxes
isActiveDay = (isMonday    and enableMonday)    or
              (isTuesday   and enableTuesday)   or
              (isWednesday and enableWednesday) or
              (isThursday  and enableThursday)  or
              (isFriday    and enableFriday)

// Session Detection
inMorning       = not na(time(timeframe.period, sessionMorningInput, sessionTimezoneInput))
inNoon          = not na(time(timeframe.period, sessionNoonInput,    sessionTimezoneInput))
inNight         = not na(time(timeframe.period, sessionNightInput,   sessionTimezoneInput))
inTradingSession = inMorning or inNoon

isMorningStart = inMorning and not inMorning[1]
isNoonStart    = inNoon and not inNoon[1]
isNightStart   = inNight and not inNight[1]

// Precision Exclusion Zones Detection
isWhipsawZone = not na(time(timeframe.period, "1530-1600", sessionTimezoneInput))
isEodDangerZone = not na(time(timeframe.period, "1730-1800", sessionTimezoneInput))
isFridayPmWhipsaw = isFriday and not na(time(timeframe.period, "1700-1800", sessionTimezoneInput))
isInExcludedZone = (excludeWhipsawZone and isWhipsawZone) or (excludeEodZone and isEodDangerZone) or (excludeFridayPM and isFridayPmWhipsaw)

// Technical Calculations
body = math.abs(close - open)
rng = high - low

trVal = math.max(high - low, math.max(math.abs(high - close[1]), math.abs(low - close[1])))
atrVal = ta.sma(trVal, atrLengthInput)

bodyTicks = body / syminfo.mintick
atrTicks = atrVal / syminfo.mintick
bodyRatio = rng > 0 ? body / rng : 0

sma200 = ta.sma(close, 200)

currentTpTicks = switch setupMode
    'Setup A (SL 35) - M15 Baseline'         => 12
    'Setup B (SL 30) - M15 Baseline'         => 12
    'Setup C (Max Profit) - M5 Optimized'    => 22
    'Setup D (Peak Efficiency) - M5 Optimized'=> 19
    => tpTicksInput

currentSlTicks = switch setupMode
    'Setup A (SL 35) - M15 Baseline'         => 35
    'Setup B (SL 30) - M15 Baseline'         => 30
    'Setup C (Max Profit) - M5 Optimized'    => 60
    'Setup D (Peak Efficiency) - M5 Optimized'=> 44
    => slTicksInput

currentBodyTicks = switch setupMode
    'Setup A (SL 35) - M15 Baseline'         => 12
    'Setup B (SL 30) - M15 Baseline'         => 12
    'Setup C (Max Profit) - M5 Optimized'    => 11
    'Setup D (Peak Efficiency) - M5 Optimized'=> 11
    => bodyTicksInput

currentBodyRatio = switch setupMode
    'Setup A (SL 35) - M15 Baseline'         => 0.75
    'Setup B (SL 30) - M15 Baseline'         => 0.75
    'Setup C (Max Profit) - M5 Optimized'    => 0.75
    'Setup D (Peak Efficiency) - M5 Optimized'=> 0.75
    => bodyRatioInput

// ═══ STATE & TRACKING FOR POSITION & CIRCUIT BREAKERS ═══
var float monthlyProfitTicks = 0.0
var int currentMonth = na
var int consecLosses = 0
var int pausedUntilTime = 0

// Daily trade limit tracking
var int tradesToday = 0
var int lastTradeCount = 0

if barstate.isfirst
    lastTradeCount := strategy.closedtrades + strategy.opentrades

isNewDay = ta.change(time("D")) != 0
if isNewDay
    tradesToday := 0

currentTradeCount = strategy.closedtrades + strategy.opentrades
if currentTradeCount > lastTradeCount
    tradesToday := tradesToday + 1
    lastTradeCount := currentTradeCount

var float myEntryPrice = na
var int myDirection = 0

// Mengesan bila trade baru dibuka untuk menyimpan harga masuk dan arah
if (strategy.position_size[1] == 0 and strategy.position_size != 0)
    myEntryPrice := strategy.position_avg_price
    myDirection := strategy.position_size > 0 ? 1 : -1

// Mengesan perubahan bulan kalendar
isNewMonth = month != month[1] or na(currentMonth)
if isNewMonth
    monthlyProfitTicks := 0.0
    currentMonth := month

// Mengesan trade ditutup menggunakan status position_size
tradeClosed = (strategy.position_size[1] != 0 and strategy.position_size == 0)
float lastTicks = 0.0

if tradeClosed
    int lastIdx = strategy.closedtrades - 1
    if lastIdx >= 0
        float entryP = strategy.closedtrades.entry_price(lastIdx)
        float exitP = strategy.closedtrades.exit_price(lastIdx)
        if myDirection == 1 // LONG
            lastTicks := (exitP - entryP) / syminfo.mintick
        else // SHORT
            lastTicks := (entryP - exitP) / syminfo.mintick
    else
        if myDirection == 1 // LONG
            lastTicks := (close - myEntryPrice) / syminfo.mintick
        else // SHORT
            lastTicks := (myEntryPrice - close) / syminfo.mintick
            
    monthlyProfitTicks := monthlyProfitTicks + lastTicks
    
    // Diagnostic label placement on exit (Placed below bar to prevent overlap with TV arrows)
    label.new(bar_index, low, "📊 Trade Exit\nTicks: " + str.tostring(lastTicks, "#") + "\nMonthly Ticks: " + str.tostring(monthlyProfitTicks, "#"), yloc=yloc.belowbar, color=color.blue, textcolor=color.white, style=label.style_label_up, size=size.normal)
    
    // Circuit Breaker Harian (Pause 24 Hours on 2 Consecutive Losses)
    if lastTicks < 0
        consecLosses := consecLosses + 1
    else
        consecLosses := 0
        
    if consecLosses >= 2
        pausedUntilTime := time + 24 * 60 * 60 * 1000
        consecLosses := 0

monthlyCapReached      = enableMonthlyLimit     and (monthlyProfitTicks >= monthlyMaxTicks)
monthlyLossLimitHit    = enableMonthlyLossLimit and (monthlyProfitTicks <= monthlyMinTicks)
isPaused = time < pausedUntilTime

//---------------------------------------------------------------------------------------------------------------------}
// STRATEGY EXECUTION
//---------------------------------------------------------------------------------------------------------------------{

// Direction Verification
dirLongOk  = (tradeDirection == 'Both') or (tradeDirection == 'Long Only')
dirShortOk = (tradeDirection == 'Both') or (tradeDirection == 'Short Only')

// Core Entry Setup (Termasuk sekatan Monthly Cap, Daily Trade Limit, Volatility Floor & Friday PM)
dailyLimitOk = not enableDailyTradeLimit or tradesToday < maxTradesPerDay
setupOk = inTradingSession and isActiveDay and (not isPaused) and (not isInExcludedZone) and (not monthlyCapReached) and (not monthlyLossLimitHit) and dailyLimitOk
volatilityOk = (atrTicks <= atrLimitInput) and (atrTicks >= atrFloorInput)
momentumOk = (bodyRatio >= currentBodyRatio) and (bodyTicks >= currentBodyTicks)

longSignal  = setupOk and volatilityOk and momentumOk and (close > open) and dirLongOk and trendlineLongOk
shortSignal = setupOk and volatilityOk and momentumOk and (close < open) and dirShortOk and trendlineShortOk

// ═══ EARLY WARNING PRE-ALERTS ═══
earlyMomentumOk = (bodyRatio >= (currentBodyRatio * 0.8)) and (bodyTicks >= (math.max(currentBodyTicks - 3, 1)))
earlyLong  = setupOk and volatilityOk and earlyMomentumOk and not momentumOk and (close > open) and dirLongOk and trendlineLongOk
earlyShort = setupOk and volatilityOk and earlyMomentumOk and not momentumOk and (close < open) and dirShortOk and trendlineShortOk

alertcondition(earlyLong, title="⚠️ EARLY WARNING: LONG", message="FCPO Long Setup Forming! Open your broker app now!")
alertcondition(earlyShort, title="⚠️ EARLY WARNING: SHORT", message="FCPO Short Setup Forming! Open your broker app now!")
alertcondition(longSignal, title="🚀 CONFIRMED: LONG", message="EXECUTE LONG NOW!")
alertcondition(shortSignal, title="🚀 CONFIRMED: SHORT", message="EXECUTE SHORT NOW!")

if longSignal
    strategy.entry("Long", strategy.long)

if shortSignal
    strategy.entry("Short", strategy.short)

var float entryTpPrice = na
var float entrySlPrice = na
var int entryBarIndex = na

if (strategy.position_size == 0)
    entryTpPrice := na
    entrySlPrice := na
    entryBarIndex := na

if (strategy.position_size[1] == 0 and strategy.position_size != 0)
    entryBarIndex := bar_index
    if strategy.position_size > 0
        entryTpPrice := strategy.position_avg_price + (currentTpTicks * syminfo.mintick)
        entrySlPrice := strategy.position_avg_price - (currentSlTicks * syminfo.mintick)
    else
        entryTpPrice := strategy.position_avg_price - (currentTpTicks * syminfo.mintick)
        entrySlPrice := strategy.position_avg_price + (currentSlTicks * syminfo.mintick)

if strategy.position_size > 0
    strategy.exit("Exit Long", "Long", limit=entryTpPrice, stop=entrySlPrice)

if strategy.position_size < 0
    strategy.exit("Exit Short", "Short", limit=entryTpPrice, stop=entrySlPrice)

// 15-Bar Time Exit Execution (Time Stop Circuit Breaker)
isTimeExit = enableTimeExit and (strategy.position_size != 0) and not na(entryBarIndex) and (bar_index - entryBarIndex >= timeExitBars)
if isTimeExit
    strategy.close_all(comment = "Time Exit Stop")

isSessionEnd = false
if sessionExitMode == "TradingView Buggy Baseline"
    isSessionEnd := (inMorning[1] and not inMorning) or (inNoon[1] and not inNoon)
else if sessionExitMode == "Exit at 12:30 Sharp"
    isSessionEnd := (hour == 12 and minute == 25) or (hour == 17 and minute == 55)
else if sessionExitMode == "Carry Through Lunch"
    isSessionEnd := (hour == 17 and minute == 55)

if enableEodExit and isSessionEnd and (strategy.position_size != 0)
    strategy.close_all(comment = "Session End EOD")

//---------------------------------------------------------------------------------------------------------------------}
// VISUALIZATION
//---------------------------------------------------------------------------------------------------------------------{

bgcolor(showBackgrounds and inMorning and isActiveDay ? color.new(color.gray, 92) : na, title="Morning Session Bg")
bgcolor(showBackgrounds and inNoon and isActiveDay ? color.new(color.orange, 94) : na, title="Afternoon Session Bg")
bgcolor(showBackgrounds and inNight and isActiveDay ? color.new(color.purple, 94) : na, title="Night Session Bg")

bgcolor(showExclusionZones and isWhipsawZone ? color.new(RED, 80) : na, title="Whipsaw Zone Bg (15:30-16:00)")
bgcolor(showExclusionZones and isEodDangerZone ? color.new(RED, 80) : na, title="EOD Danger Zone Bg (17:30-18:00)")
bgcolor(showExclusionZones and isFriday and isFridayPmWhipsaw ? color.new(RED, 70) : na, title="Friday PM Whipsaw Zone Bg (17:00-18:00)")

// Paparan label bila Monthly Lock diaktifkan
var label monthlyLockLabel = na
if monthlyCapReached and not monthlyCapReached[1]
    monthlyLockLabel := label.new(bar_index, high, "🔒 MONTHLY PROFIT LOCKED\nTrading Paused Until Next Month", yloc=yloc.abovebar, color=color.new(GREEN, 10), textcolor=color.white, style=label.style_label_down, size=size.large)

if isActiveDay and showVerticalLines
    if isMorningStart
        line.new(x1=bar_index, y1=high, x2=bar_index, y2=low, color=color.new(color.white, 50), width=1, style=line.style_dashed, extend=extend.both)
        label.new(bar_index, high, "MORNING", yloc=yloc.abovebar, color=color.new(color.gray, 70), textcolor=color.white, style=label.style_label_down, size=size.normal)
    if isNoonStart
        line.new(x1=bar_index, y1=high, x2=bar_index, y2=low, color=color.new(color.orange, 50), width=1, style=line.style_dashed, extend=extend.both)
        label.new(bar_index, high, "AFTERNOON", yloc=yloc.abovebar, color=color.new(color.gray, 70), textcolor=color.white, style=label.style_label_down, size=size.normal)
    if isNightStart
        line.new(x1=bar_index, y1=high, x2=bar_index, y2=low, color=color.new(color.purple, 50), width=1, style=line.style_dashed, extend=extend.both)
        label.new(bar_index, high, "NIGHT", yloc=yloc.abovebar, color=color.new(color.gray, 70), textcolor=color.white, style=label.style_label_down, size=size.normal)

if showCircuitBreakerAlert and ta.change(pausedUntilTime) > 0
    label.new(bar_index, high, "🔌 CIRCUIT BREAKER\nPAUSE 24H", yloc=yloc.abovebar, color=color.new(RED, 20), textcolor=color.white, style=label.style_label_down, size=size.large)

plot(showMA ? sma200 : na, "200 SMA Trend Context", color=color.new(GOLD, 30), linewidth=2)

atrBandUpper = close + atrVal
atrBandLower = close - atrVal
p1 = plot(showAtrBand ? atrBandUpper : na, "ATR Upper Band", color=color.new(BLUE, 70))
p2 = plot(showAtrBand ? atrBandLower : na, "ATR Lower Band", color=color.new(BLUE, 70))
fill(p1, p2, color=color.new(BLUE, 96), title="ATR Volatility Envelope")

plotshape(longSignal, title="Buy Signal Indicator", style=shape.triangleup, location=location.belowbar, color=color.new(GREEN, 10), size=size.small)
plotshape(shortSignal, title="Sell Signal Indicator", style=shape.triangledown, location=location.abovebar, color=color.new(RED, 10), size=size.small)

plotshape(earlyLong, title="Early Buy Warning", style=shape.circle, location=location.belowbar, color=color.new(GOLD, 30), size=size.tiny)
plotshape(earlyShort, title="Early Sell Warning", style=shape.circle, location=location.abovebar, color=color.new(GOLD, 30), size=size.tiny)

// Draw Auto Trendlines
var line upperTrendline = na
var line lowerTrendline = na

if barstate.islast and enableTrendline
    if validUpperLine
        if na(upperTrendline)
            upperTrendline := line.new(x1=ph2_time, y1=ph2_val, x2=ph1_time, y2=ph1_val, xloc=xloc.bar_time, extend=extend.right, color=color.new(GREEN, 0), width=2)
        else
            line.set_xy1(upperTrendline, ph2_time, ph2_val)
            line.set_xy2(upperTrendline, ph1_time, ph1_val)
            
    if validLowerLine
        if na(lowerTrendline)
            lowerTrendline := line.new(x1=pl2_time, y1=pl2_val, x2=pl1_time, y2=pl1_val, xloc=xloc.bar_time, extend=extend.right, color=color.new(RED, 0), width=2)
        else
            line.set_xy1(lowerTrendline, pl2_time, pl2_val)
            line.set_xy2(lowerTrendline, pl1_time, pl1_val)

// Dynamic Info Dashboard Table
var table infoTable = table.new(position.top_right, 2, 11, bgcolor=color.new(color.black, 40), border_color=color.new(GRAY, 60), border_width=1)

if showDashboard and barstate.islast
    table.cell(infoTable, 0, 0, "METRIC",     text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.normal)
    table.cell(infoTable, 1, 0, "VALUE",      text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.normal)
    
    table.cell(infoTable, 0, 1, "Current ATR (Ticks)", text_color=color.white, text_size=size.normal)
    atrColor = (atrTicks <= atrLimitInput and atrTicks >= atrFloorInput) ? color.new(GREEN, 20) : color.new(RED, 20)
    table.cell(infoTable, 1, 1, str.tostring(atrTicks, "#.#") + " (Floor:" + str.tostring(atrFloorInput, "#") + " / Limit:" + str.tostring(atrLimitInput, "#") + ")", text_color=color.white, bgcolor=atrColor, text_size=size.normal)
    
    table.cell(infoTable, 0, 2, "Last Body (Ticks)", text_color=color.white, text_size=size.normal)
    bodyColor = bodyTicks[1] >= bodyTicksInput ? color.new(GREEN, 20) : color.new(color.gray, 50)
    table.cell(infoTable, 1, 2, str.tostring(bodyTicks[1], "#") + " / " + str.tostring(bodyTicksInput, "#"), text_color=color.white, bgcolor=bodyColor, text_size=size.normal)
    
    table.cell(infoTable, 0, 3, "Last Body Ratio", text_color=color.white, text_size=size.normal)
    ratioColor = bodyRatio[1] >= bodyRatioInput ? color.new(GREEN, 20) : color.new(color.gray, 50)
    table.cell(infoTable, 1, 3, str.tostring(bodyRatio[1] * 100, "#") + "% / " + str.tostring(bodyRatioInput * 100, "#") + "%", text_color=color.white, bgcolor=ratioColor, text_size=size.normal)
    
    table.cell(infoTable, 0, 4, "Direction", text_color=color.white, text_size=size.normal)
    table.cell(infoTable, 1, 4, tradeDirection, text_color=color.white, bgcolor=color.new(BLUE, 30), text_size=size.normal)
    
    // Monthly Profit Lock Row
    table.cell(infoTable, 0, 5, "Monthly Ticks", text_color=color.white, text_size=size.normal)
    lockBgColor = monthlyCapReached ? color.new(GREEN, 20) : color.new(color.gray, 50)
    table.cell(infoTable, 1, 5, str.tostring(monthlyProfitTicks, "#") + " / " + str.tostring(monthlyMaxTicks, "#"), text_color=color.white, bgcolor=lockBgColor, text_size=size.normal)
    
    table.cell(infoTable, 0, 6, "Precision Zone", text_color=color.white, text_size=size.normal)
    zoneStatus = isInExcludedZone ? "⛔ BLOCKED" : "✅ CLEAR"
    zoneColor  = isInExcludedZone ? color.new(RED, 20) : color.new(GREEN, 20)
    table.cell(infoTable, 1, 6, zoneStatus, text_color=color.white, bgcolor=zoneColor, text_size=size.normal)
    
    table.cell(infoTable, 0, 7, "Circuit Breaker", text_color=color.white, text_size=size.normal)
    cbStatus = isPaused ? "PAUSED" : "ACTIVE"
    cbColor = isPaused ? color.new(RED, 20) : color.new(GREEN, 20)
    table.cell(infoTable, 1, 7, cbStatus, text_color=color.white, bgcolor=cbColor, text_size=size.normal)
    
    // Daily Trade Limit Row
    table.cell(infoTable, 0, 8, "Trades Today", text_color=color.white, text_size=size.normal)
    dailyColor = (not enableDailyTradeLimit or tradesToday < maxTradesPerDay) ? color.new(GREEN, 20) : color.new(RED, 20)
    table.cell(infoTable, 1, 8, str.tostring(tradesToday) + " / " + (enableDailyTradeLimit ? str.tostring(maxTradesPerDay) : "∞"), text_color=color.white, bgcolor=dailyColor, text_size=size.normal)

    // Day Filter Status Row
    table.cell(infoTable, 0, 9, "Day Filter", text_color=color.white, text_size=size.normal)
    dayName = isMonday ? "Mon" : isTuesday ? "Tue" : isWednesday ? "Wed" : isThursday ? "Thu" : isFriday ? "Fri" : "—"
    dayAllowed = isActiveDay
    dayBgColor = dayAllowed ? color.new(GREEN, 20) : color.new(RED, 20)
    dayLabel   = dayAllowed ? ("✅ " + dayName + " — Trading ON") : ("⛔ " + dayName + " — Disabled")
    table.cell(infoTable, 1, 9, dayLabel, text_color=color.white, bgcolor=dayBgColor, text_size=size.normal)

    // Trendline Filter Status Row
    table.cell(infoTable, 0, 10, "Trendline Filter", text_color=color.white, text_size=size.normal)
    tlStatus = enableTrendline ? "ACTIVE" : "DISABLED"
    tlColor = enableTrendline ? color.new(GREEN, 20) : color.new(color.gray, 50)
    table.cell(infoTable, 1, 10, tlStatus, text_color=color.white, bgcolor=tlColor, text_size=size.normal)
