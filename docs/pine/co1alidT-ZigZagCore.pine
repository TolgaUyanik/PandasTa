//@version=6
library("ZigZagCore")

export type ZzState
    int   dir

    // Confirmed pivots
    float lastHighLevel
    float lastLowLevel
    int   lastHighIndex
    int   lastLowIndex

    // Active candidate pivots
    float candidateHigh
    float candidateLow
    int   candidateHighIndex
    int   candidateLowIndex

    // Opposite-side extremes since the active candidate pivot
    float pullbackLow
    float reboundHigh
    int   pullbackLowIndex
    int   reboundHighIndex

    // Legacy aliases used by callers
    float highSinceLow
    float lowSinceHigh
    int   highSinceLowIndex
    int   lowSinceHighIndex

    // Events / state flags
    bool  isNewHigh
    bool  isNewLow
    bool  highBroken
    bool  lowBroken

export zz_new() =>
    ZzState.new(
        na,

        na,
        na,
        na,
        na,

        na,
        na,
        na,
        na,

        na,
        na,
        na,
        na,

        na,
        na,
        na,
        na,

        false,
        false,
        true,
        true
    )

scan_low_from(int startIndex) =>
    int barsBack = math.max(bar_index - startIndex, 0)
    float bestVal = na
    int   bestIdx = na

    for off = 0 to barsBack
        float v = low[off]
        int   i = bar_index - off
        if na(bestVal) or v < bestVal
            bestVal := v
            bestIdx := i

    [bestVal, bestIdx]

scan_high_from(int startIndex) =>
    int barsBack = math.max(bar_index - startIndex, 0)
    float bestVal = na
    int   bestIdx = na

    for off = 0 to barsBack
        float v = high[off]
        int   i = bar_index - off
        if na(bestVal) or v > bestVal
            bestVal := v
            bestIdx := i

    [bestVal, bestIdx]

sync_aliases(ZzState state) =>
    state.highSinceLow      := state.candidateHigh
    state.highSinceLowIndex := state.candidateHighIndex
    state.lowSinceHigh      := state.candidateLow
    state.lowSinceHighIndex := state.candidateLowIndex

export zz_update(
    ZzState state,
    float thr,
    int staleBars = 50,
    bool switchOnPriorLevelBreak = true) =>

    int staleBarsClamped = math.max(staleBars, 1)

    state.isNewHigh := false
    state.isNewLow  := false

    if bar_index == 0
        state.dir           := na

        state.lastHighLevel := na
        state.lastLowLevel  := na
        state.lastHighIndex := na
        state.lastLowIndex  := na

        state.candidateHigh      := high
        state.candidateLow       := low
        state.candidateHighIndex := bar_index
        state.candidateLowIndex  := bar_index

        state.pullbackLow      := low
        state.pullbackLowIndex := bar_index
        state.reboundHigh      := high
        state.reboundHighIndex := bar_index

        state.highBroken := true
        state.lowBroken  := true

        sync_aliases(state)
        state

    else
        if na(state.dir)
            if na(state.candidateHigh) or high > state.candidateHigh
                state.candidateHigh      := high
                state.candidateHighIndex := bar_index

            if na(state.candidateLow) or low < state.candidateLow
                state.candidateLow      := low
                state.candidateLowIndex := bar_index

            float upMove = state.candidateHigh - open
            float dnMove = open - state.candidateLow

            if upMove > thr or dnMove > thr
                if upMove >= dnMove
                    state.dir := 1

                    [initPullbackLow, initPullbackLowIdx] = scan_low_from(state.candidateHighIndex)
                    state.pullbackLow      := initPullbackLow
                    state.pullbackLowIndex := initPullbackLowIdx
                else
                    state.dir := -1

                    [initReboundHigh, initReboundHighIdx] = scan_high_from(state.candidateLowIndex)
                    state.reboundHigh      := initReboundHigh
                    state.reboundHighIndex := initReboundHighIdx

        else if state.dir == 1
            if high > state.candidateHigh
                state.candidateHigh      := high
                state.candidateHighIndex := bar_index
                state.pullbackLow        := low
                state.pullbackLowIndex   := bar_index
            else if low < state.pullbackLow
                state.pullbackLow      := low
                state.pullbackLowIndex := bar_index

            bool thrFlip   = (state.candidateHigh - state.pullbackLow) > thr
            bool levelFlip = switchOnPriorLevelBreak and not na(state.lastLowLevel) and low <= state.lastLowLevel
            bool staleFlip = not na(state.candidateHighIndex) and (bar_index - state.candidateHighIndex) >= staleBarsClamped

            if thrFlip or levelFlip or staleFlip
                state.lastHighLevel := state.candidateHigh
                state.lastHighIndex := state.candidateHighIndex
                state.isNewHigh     := true
                state.dir           := -1

                state.candidateLow      := state.pullbackLow
                state.candidateLowIndex := state.pullbackLowIndex

                [seedReboundHigh, seedReboundHighIdx] = scan_high_from(state.candidateLowIndex)
                state.reboundHigh      := seedReboundHigh
                state.reboundHighIndex := seedReboundHighIdx

        else
            if low < state.candidateLow
                state.candidateLow      := low
                state.candidateLowIndex := bar_index
                state.reboundHigh       := high
                state.reboundHighIndex  := bar_index
            else if high > state.reboundHigh
                state.reboundHigh      := high
                state.reboundHighIndex := bar_index

            bool thrFlip   = (state.reboundHigh - state.candidateLow) > thr
            bool levelFlip = switchOnPriorLevelBreak and not na(state.lastHighLevel) and high >= state.lastHighLevel
            bool staleFlip = not na(state.candidateLowIndex) and (bar_index - state.candidateLowIndex) >= staleBarsClamped

            if thrFlip or levelFlip or staleFlip
                state.lastLowLevel := state.candidateLow
                state.lastLowIndex := state.candidateLowIndex
                state.isNewLow     := true
                state.dir          := 1

                state.candidateHigh      := state.reboundHigh
                state.candidateHighIndex := state.reboundHighIndex

                [seedPullbackLow, seedPullbackLowIdx] = scan_low_from(state.candidateHighIndex)
                state.pullbackLow      := seedPullbackLow
                state.pullbackLowIndex := seedPullbackLowIdx

        if state.isNewHigh
            state.highBroken := false
        if state.isNewLow
            state.lowBroken := false

        if not na(state.lastHighLevel) and high >= state.lastHighLevel
            state.highBroken := true
        if not na(state.lastLowLevel) and low <= state.lastLowLevel
            state.lowBroken := true

        sync_aliases(state)
        state