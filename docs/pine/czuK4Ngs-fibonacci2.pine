//@version=6

// @description Useful methods to calculate and display fibonacci retracement
library("fibonacci2")

import Hamster-Coder/drawing/1 as draw
// Example of usage
// 1. Define your fibonacci parameters. To do so you required to pass "point 0", "point 1", and array of expected levels (including "0" and "1" if needed))
// fibonacci_paramers = fibonacciParams.new(open, close, array.from(0, 1, 0.5, 0.618, 1.618))
// 2. Create model (init and calculate level values)
// fibonacci_model = fibonacci_paramers.createModel()
// 3. Create view (draw lines and values)
// fibonacci_view := fibonacci_model.createView()

export type levelModelParams
    float level

export type levelViewParams
    float            level
    color            color        = color.black
    int              line_width   = 1
    draw.lineStyleEnum line_style = draw.lineStyleEnum.solid

//@type Represents a Fibonacci retracement level
//@field level The Fibonacci level ratio (e.g., 0.382, 0.5, 0.618)
//@field value The Y-coordinate on the chart corresponding to this level
export type levelModel
    float level
    float value

// @type Represents the full parameter set for the Fibonacci retracement model
// @description Contains anchor points and level configuration
// @field point_1 Coordinates of the anchor Point (1) of the model
// @field point_0 Coordinates of the anchor Point (0) of the model
// @field levels List of levels to display for this model
export type modelParams
    chart.point point_1
    chart.point point_0
    levelModelParams[] levels

export modelParamsNew(chart.point point_0 = na, chart.point point_1 = na) =>
    result = modelParams.new()
    result.levels := array.new<levelModelParams>()
    result.point_0 := point_0
    result.point_1 := point_1
    result

export type model
    // point (1)
    chart.point point_1
    // point (0)
    chart.point point_0    
    // levels
    levelModel[] levels

export type viewParams
    levelViewParams[] levels
    int    x1
    int    x2
    string xloc               = xloc.bar_index
    bool   show_level_value   = true
    string value_format       = format.mintick
    bool   force_overlay      = false

export modelParamsNew(viewParams this, chart.point point_0 = na, chart.point point_1 = na) =>
    result = modelParamsNew(point_0, point_1)
    for [index, value] in this.levels
        level_params = levelModelParams.new(value.level)
        result.levels.push(level_params)
    result

export method toModelParams(viewParams this, chart.point point_0 = na, chart.point point_1 = na) =>
    modelParamsNew(this, point_0, point_1)

export type view
    model   model    
    line[]  lines
    label[] labels

export method createModel(modelParams params) =>
    model result = model.new()
    result.levels := array.new<levelModel>()
    result.point_0 := params.point_0.copy()
    result.point_1 := params.point_1.copy()
    for [index, level] in params.levels
        result.levels.push(levelModel.new(level.level, (params.point_1.price - params.point_0.price) * level.level + params.point_0.price))        
    result

method findLevelParams(viewParams this, float level) =>
    result = levelViewParams.new(level)
    for [index, value] in this.levels
        if (value.level == level)
            result := value
    result := result.copy()

export method createView(model this, viewParams params) =>
	view result = na
	if (not na(this))	
		// value_format = na(in_value_format) ? format.mintick : in_value_format	
		// init view structure
		result := view.new()
        result.model := this
		result.lines := array.new<line>()
		result.labels := array.new<label>()
		// get right X coordinate of the fibonassi grid
		// x2 = time + bar_count * timeframe.in_seconds(timeframe.period) * 1000    
		// draw lines with price labels
		for [index, level_model] in this.levels
            level_view_param = params.findLevelParams(level_model.level)

			// line_color = level. na(in_line_colors) ? color.black : in_line_colors.get(index)
			// level = this.levels.get(index)
			// line_width = na(in_line_widths) ? 1 : in_line_widths.get(index)
			// line_style = na(in_line_styles) ? line.style_dashed : in_line_styles.get(index)            			
			label_text = params.show_level_value ? str.format("{0} ({1})", level_model.level, str.tostring(level_model.value, params.value_format)) : str.format("{0}", level_model.level)                        
            if (params.force_overlay)
                result.lines.insert(0, line.new(params.x1, level_model.value, params.x2, level_model.value, params.xloc, color = level_view_param.color, style = level_view_param.line_style.toStyle(), width = level_view_param.line_width, force_overlay = true))
			    result.labels.insert(0, label.new(params.x2, level_model.value, label_text, params.xloc, yloc.price, style=label.style_none, textcolor=level_view_param.color, size=size.small, force_overlay = true))
            else
                result.lines.insert(0, line.new(params.x1, level_model.value, params.x2, level_model.value, params.xloc, color = level_view_param.color, style = level_view_param.line_style.toStyle(), width = level_view_param.line_width, force_overlay = false))
                result.labels.insert(0, label.new(params.x2, level_model.value, label_text, params.xloc, yloc.price, style=label.style_none, textcolor=level_view_param.color, size=size.small, force_overlay = false))
    result

export method delete(view view) =>
	if (not na(view))
		for [index, item] in view.lines
			item.delete()
		for [index, item] in view.labels
			item.delete()
