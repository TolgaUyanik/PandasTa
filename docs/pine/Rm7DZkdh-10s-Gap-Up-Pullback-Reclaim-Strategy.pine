//@version=6
strategy("10s Gap-Up Pullback Reclaim Strategy", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=20, commission_type=strategy.commission.percent, commission_value=0.05, pyramiding=100, calc_on_every_tick=true)

// This strategy is designed for a 10-second chart in TradingView.
// Buy Criteria:
// - stock gaps up at least 20% from prior daily close
// - price pulls back at least 10% from the intraday high
// - buy when price reclaims the intraday high
// Sell Criteria:
// - exit with a 10% trailing stop

gapPct = 0.20
pullbackPct = 0.10
regainTolerance = 0.995
trailPct = 10.0

prevDailyClose = request.security(syminfo.tickerid, "D", close[1], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)

isNewDay = ta.change(time("D")) != 0
var float dayHigh = na
var bool inPullback = false
var bool buyReady = false
var bool gapUpDay = false

if isNewDay
    gapUpDay := open >= prevDailyClose * (1 + gapPct)
    dayHigh := high
    inPullback := false
    buyReady := false
else
    if gapUpDay
        dayHigh := math.max(dayHigh, high)
        if not inPullback and low <= dayHigh * (1 - pullbackPct)
            inPullback := true
        if inPullback and close >= dayHigh * regainTolerance
            buyReady := true

longCondition = gapUpDay and buyReady

if longCondition
    strategy.entry("Long", strategy.long)
    inPullback := false
    buyReady := false

trailOffset = close * trailPct / 100.0
strategy.exit("Trail Exit", from_entry="Long", trail_price=close, trail_offset=trailOffset)

plotshape(longCondition, title="Buy Signal", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, text="BUY")
plot(dayHigh, title="Intraday High", color=color.orange)

var label infoLabel = na
if barstate.islast
    label.delete(infoLabel)
    infoLabel := label.new(x=bar_index, y=high, text=str.tostring(gapUpDay ? "Gap-Up Day" : "No Gap"), style=label.style_label_left, color=gapUpDay ? color.new(color.green, 60) : color.new(color.red, 60), textcolor=color.white)
