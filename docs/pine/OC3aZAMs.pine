library("TA_Eyaad9")

//-----------------------------------------
// XABCD Detection
//-----------------------------------------

export pat_xabcd(bool x_is_low=true, int pivot_length=5) =>
    bool found = false
    
    float x = na
    float a = na
    float b = na
    float c = na
    float d = na
    
    int x_i = na
    int a_i = na
    int b_i = na
    int c_i = na
    int d_i = na

    // استخدام x_is_low لتحديد الاتجاه
    ph = x_is_low ? ta.pivothigh(high, pivot_length, pivot_length) : na
    pl = x_is_low ? ta.pivotlow(low, pivot_length, pivot_length) : na

    ph_bear = not x_is_low ? ta.pivothigh(high, pivot_length, pivot_length) : na
    pl_bear = not x_is_low ? ta.pivotlow(low, pivot_length, pivot_length) : na

    var float[] prices = array.new_float()
    var int[] indexs = array.new_int()

    if not na(ph)
        array.push(prices, ph)
        array.push(indexs, bar_index - pivot_length)

    if not na(pl)
        array.push(prices, pl)
        array.push(indexs, bar_index - pivot_length)

    if not na(ph_bear)
        array.push(prices, ph_bear)
        array.push(indexs, bar_index - pivot_length)

    if not na(pl_bear)
        array.push(prices, pl_bear)
        array.push(indexs, bar_index - pivot_length)

    if array.size(prices) >= 5
        int n = array.size(prices)

        x := array.get(prices, n-5)
        a := array.get(prices, n-4)
        b := array.get(prices, n-3)
        c := array.get(prices, n-2)
        d := array.get(prices, n-1)

        x_i := array.get(indexs, n-5)
        a_i := array.get(indexs, n-4)
        b_i := array.get(indexs, n-3)
        c_i := array.get(indexs, n-2)
        d_i := array.get(indexs, n-1)

        found := true

    [found, x_i, x, a_i, a, b_i, b, c_i, c, d_i, d]

//-----------------------------------------
// Harmonic Validation
//-----------------------------------------

ratio(a, b) =>
    math.abs(a / b)

export harmonic_xabcd_validate(float x, float a, float b, float c, float d) =>
    xa = a - x
    ab = b - a
    bc = c - b
    cd = d - c

    r_ab = ratio(ab, xa)
    r_bc = ratio(bc, ab)
    r_cd = ratio(cd, bc)

    // Gartley
    gartley =
         r_ab > 0.6 and r_ab < 0.7 and
         r_cd > 1.2 and r_cd < 1.8

    // Bat
    bat =
         r_ab > 0.3 and r_ab < 0.6 and
         r_cd > 1.6 and r_cd < 2.6

    // Crab
    crab =
         r_ab > 0.3 and r_ab < 0.7 and
         r_bc > 0.3 and r_bc < 0.9 and
         r_cd > 1.5 and r_cd < 3.5

    valid = gartley or bat or crab

    [valid, gartley, bat, crab]
	