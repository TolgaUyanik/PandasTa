//@version=6
indicator(
     title="EMAx6 Regime",
     shorttitle="EMAx6 Regime",
     overlay=true,
     explicit_plot_zorder=true
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// GROUPS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
group_ema1 = "EMA 1"
group_ema2 = "EMA 2"
group_ema3 = "EMA 3"
group_ema4 = "EMA 4"
group_ema5 = "EMA 5"
group_ema6 = "EMA 6"

group_fixed_fill = "FIXED PAIR FILLS"
group_cross_fill = "DYNAMIC CROSS FILL"

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// EMA 1 INPUTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
show_ema1 = input.bool(
     true,
     "Show EMA1",
     group=group_ema1,
     display=display.none
)

src1 = input.source(
     close,
     "Source",
     group=group_ema1,
     display=display.none
)

len1 = input.int(
     14,
     "Length",
     minval=3,
     group=group_ema1,
     display=display.none
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// EMA 2 INPUTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
show_ema2 = input.bool(
     true,
     "Show EMA2",
     group=group_ema2,
     display=display.none
)

src2 = input.source(
     close,
     "Source",
     group=group_ema2,
     display=display.none
)

len2 = input.int(
     50,
     "Length",
     minval=1,
     group=group_ema2,
     display=display.none
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// EMA 3 INPUTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
show_ema3 = input.bool(
     true,
     "Show EMA3",
     group=group_ema3,
     display=display.none
)

src3 = input.source(
     close,
     "Source",
     group=group_ema3,
     display=display.none
)

len3 = input.int(
     200,
     "Length",
     minval=4,
     group=group_ema3,
     display=display.none
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// EMA 4 INPUTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
show_ema4 = input.bool(
     true,
     "Show EMA4",
     group=group_ema4,
     display=display.none
)

src4 = input.source(
     high,
     "Source",
     group=group_ema4,
     display=display.none
)

len4 = input.int(
     50,
     "Length",
     minval=1,
     group=group_ema4,
     display=display.none
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// EMA 5 INPUTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
show_ema5 = input.bool(
     true,
     "Show EMA5",
     group=group_ema5,
     display=display.none
)

src5 = input.source(
     low,
     "Source",
     group=group_ema5,
     display=display.none
)

len5 = input.int(
     50,
     "Length",
     minval=1,
     group=group_ema5,
     display=display.none
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// EMA 6 INPUTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
show_ema6 = input.bool(
     false,
     "Show EMA6",
     group=group_ema6,
     display=display.none
)

src6 = input.source(
     close,
     "Source",
     group=group_ema6,
     display=display.none
)

len6 = input.int(
     800,
     "Length",
     minval=1,
     group=group_ema6,
     display=display.none
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CALCULATE EMA
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
ema1 = ta.ema(src1, len1)
ema2 = ta.ema(src2, len2)
ema3 = ta.ema(src3, len3)
ema4 = ta.ema(src4, len4)
ema5 = ta.ema(src5, len5)
ema6 = ta.ema(src6, len6)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// FIXED PAIR FILL INPUTS
// Chỉ chứa logic bật/tắt.
// Màu nằm hoàn toàn trong Style.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
show_fill_12 = input.bool(
     false,
     "Fill EMA1 ↔ EMA2",
     group=group_fixed_fill,
     display=display.none
)

show_fill_23 = input.bool(
     false,
     "Fill EMA2 ↔ EMA3",
     group=group_fixed_fill,
     display=display.none
)

show_fill_34 = input.bool(
     false,
     "Fill EMA3 ↔ EMA4",
     group=group_fixed_fill,
     display=display.none
)

show_fill_45 = input.bool(
     true,
     "Fill EMA4 ↔ EMA5",
     group=group_fixed_fill,
     display=display.none
)

show_fill_56 = input.bool(
     false,
     "Fill EMA5 ↔ EMA6",
     group=group_fixed_fill,
     display=display.none
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// LAYER 1 — FIXED PAIR FILLS
//
// Dùng plot ẩn riêng để màu fill là màu constant.
// Nhờ vậy từng fill có color picker riêng trong Style.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// EMA1 ↔ EMA2
fixed12_a = plot(
     show_fill_12 and show_ema1 and show_ema2 ? ema1 : na,
     title="",
     display=display.none,
     editable=false
)

fixed12_b = plot(
     show_fill_12 and show_ema1 and show_ema2 ? ema2 : na,
     title="",
     display=display.none,
     editable=false
)

fill(
     fixed12_a,
     fixed12_b,
     color=color.new(color.orange, 85),
     title="Fill EMA1-EMA2",
     editable=true
)

// EMA2 ↔ EMA3
fixed23_a = plot(
     show_fill_23 and show_ema2 and show_ema3 ? ema2 : na,
     title="",
     display=display.none,
     editable=false
)

fixed23_b = plot(
     show_fill_23 and show_ema2 and show_ema3 ? ema3 : na,
     title="",
     display=display.none,
     editable=false
)

fill(
     fixed23_a,
     fixed23_b,
     color=color.new(color.red, 85),
     title="Fill EMA2-EMA3",
     editable=true
)

// EMA3 ↔ EMA4
fixed34_a = plot(
     show_fill_34 and show_ema3 and show_ema4 ? ema3 : na,
     title="",
     display=display.none,
     editable=false
)

fixed34_b = plot(
     show_fill_34 and show_ema3 and show_ema4 ? ema4 : na,
     title="",
     display=display.none,
     editable=false
)

fill(
     fixed34_a,
     fixed34_b,
     color=color.new(color.green, 88),
     title="Fill EMA3-EMA4",
     editable=true
)

// EMA4 ↔ EMA5
fixed45_a = plot(
     show_fill_45 and show_ema4 and show_ema5 ? ema4 : na,
     title="",
     display=display.none,
     editable=false
)

fixed45_b = plot(
     show_fill_45 and show_ema4 and show_ema5 ? ema5 : na,
     title="",
     display=display.none,
     editable=false
)

fill(
     fixed45_a,
     fixed45_b,
     color=color.new(#818a98, 80),
     title="Fill EMA4-EMA5",
     editable=true
)

// EMA5 ↔ EMA6
fixed56_a = plot(
     show_fill_56 and show_ema5 and show_ema6 ? ema5 : na,
     title="",
     display=display.none,
     editable=false
)

fixed56_b = plot(
     show_fill_56 and show_ema5 and show_ema6 ? ema6 : na,
     title="",
     display=display.none,
     editable=false
)

fill(
     fixed56_a,
     fixed56_b,
     color=color.new(color.purple, 90),
     title="Fill EMA5-EMA6",
     editable=true
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// DYNAMIC CROSS INPUTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
show_dynamic_fill = input.bool(
     true,
     "Show Dynamic Cross Fill",
     group=group_cross_fill,
     display=display.none
)

fast_choice = input.string(
     "EMA2",
     "Fast EMA",
     options=[
         "EMA1",
         "EMA2",
         "EMA3",
         "EMA4",
         "EMA5",
         "EMA6"
     ],
     group=group_cross_fill,
     display=display.none
)

slow_choice = input.string(
     "EMA3",
     "Slow EMA",
     options=[
         "EMA1",
         "EMA2",
         "EMA3",
         "EMA4",
         "EMA5",
         "EMA6"
     ],
     group=group_cross_fill,
     display=display.none
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// DYNAMIC EMA SELECTOR
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
fast_ema =
     fast_choice == "EMA1" ? ema1 :
     fast_choice == "EMA2" ? ema2 :
     fast_choice == "EMA3" ? ema3 :
     fast_choice == "EMA4" ? ema4 :
     fast_choice == "EMA5" ? ema5 :
     ema6

slow_ema =
     slow_choice == "EMA1" ? ema1 :
     slow_choice == "EMA2" ? ema2 :
     slow_choice == "EMA3" ? ema3 :
     slow_choice == "EMA4" ? ema4 :
     slow_choice == "EMA5" ? ema5 :
     ema6

golden_regime = fast_ema >= slow_ema
dead_regime   = fast_ema < slow_ema

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// LAYER 2 — DYNAMIC CROSS FILLS
//
// Tách Golden và Dead thành hai fill riêng.
// Vì vậy Style có hai dòng màu độc lập:
// - Golden Cross Fill
// - Dead Cross Fill
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// Golden regime
golden_fast_plot = plot(
     show_dynamic_fill and golden_regime ? fast_ema : na,
     title="",
     display=display.none,
     editable=false
)

golden_slow_plot = plot(
     show_dynamic_fill and golden_regime ? slow_ema : na,
     title="",
     display=display.none,
     editable=false
)

fill(
     golden_fast_plot,
     golden_slow_plot,
     color=color.new(#4caf50, 70),
     title="Golden Cross Fill",
     editable=true
)

// Dead regime
dead_fast_plot = plot(
     show_dynamic_fill and dead_regime ? fast_ema : na,
     title="",
     display=display.none,
     editable=false
)

dead_slow_plot = plot(
     show_dynamic_fill and dead_regime ? slow_ema : na,
     title="",
     display=display.none,
     editable=false
)

fill(
     dead_fast_plot,
     dead_slow_plot,
     color=color.new(#8e3d58, 55),
     title="Dead Cross Fill",
     editable=true
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// LAYER 3 — VISIBLE EMA LINES
//
// Viết sau các fill nên đường EMA nằm trên toàn bộ fill.
//
// Có title rõ ràng trong Style:
// EMA1, EMA2, EMA3...
//
// Input tắt → đường và giá trị biến mất.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
plot(
     ema1,
     title="EMA1",
     color=color.new(#c99a1a, 0),
     linewidth=3,
     display=show_ema1 ? display.all : display.none,
     editable=true
)

plot(
     ema2,
     title="EMA2",
     color=color.new(#dfa45f, 15),
     linewidth=1,
     display=show_ema2 ? display.all : display.none,
     editable=true
)

plot(
     ema3,
     title="EMA3",
     color=color.new(#388e3c, 0),
     linewidth=4,
     display=show_ema3 ? display.all : display.none,
     editable=true
)

plot(
     ema4,
     title="EMA4",
     color=color.new(#bfc8d6, 65),
     linewidth=2,
     display=show_ema4 ? display.all : display.none,
     editable=true
)

plot(
     ema5,
     title="EMA5",
     color=color.new(#bfc8d6, 65),
     linewidth=2,
     display=show_ema5 ? display.all : display.none,
     editable=true
)

plot(
     ema6,
     title="EMA6",
     color=color.new(#dfa45f, 15),
     linewidth=2,
     display=show_ema6 ? display.all : display.none,
     editable=true
)