//@version=6
library("EnixLib")

// ==========================================
// 1. Nachylenie Nominalne (Punkty / Wartości stałe)
// ==========================================
export calc_slope_nominal(float series_value, int length) =>
    len = math.max(length, 1)
    slope_result = (series_value - nz(series_value[len])) / len
    slope_result

// ==========================================
// 2. Nachylenie Procentowe (% na świecę)
// ==========================================
export calc_slope_percent(float series_value, int length) =>
    len = math.max(length, 1)
    old_val = nz(series_value[len])
    // Zabezpieczenie przed dzieleniem przez zero dla płaskich wskaźników
    slope_result = old_val == 0 ? 0.0 : (((series_value - old_val) / math.abs(old_val)) * 100.0) / len
    slope_result

// ==========================================
// 3. Choppiness Index (CHOP)
// ==========================================
export calc_chop(float high_src, float low_src, int length, int offset) =>
    atrSum = math.sum(ta.atr(1), length)
    highestHigh = ta.highest(high_src, length)
    lowestLow = ta.lowest(low_src, length)
    rangeCalc = math.max(highestHigh - lowestLow, 0.0001)
    chopValueRaw = 100 * (math.log10(atrSum / rangeCalc) / math.log10(length))
    chopValueRaw[offset]

// ==========================================
// 4. Maszyna Stanu: Chandelier Exit (CE)
// ==========================================
export calc_ce_state(float src, float high_src, float low_src, int length, float mult) =>
    atrCE = ta.atr(length)
    longStop = ta.highest(high_src, length) - atrCE * mult
    shortStop = ta.lowest(low_src, length) + atrCE * mult
    int ceTrend = 1
    ceTrend := src > nz(shortStop[1]) ? 1 : src < nz(longStop[1]) ? -1 : nz(ceTrend[1], 1)
    isBullish = (ceTrend == 1)
    isBearish = (ceTrend == -1)
    crossLong = isBullish and not isBullish[1]
    crossShort = isBearish and not isBearish[1]
    [isBullish, isBearish, crossLong, crossShort]

// ==========================================
// 5. Kalendarz: Weryfikacja daty Blackout
// ==========================================
export is_blackout_active(bool useBlackout, int blackoutDateTime, int currentTime) =>
    bYear = year(blackoutDateTime, "Europe/Warsaw")
    bMonth = month(blackoutDateTime, "Europe/Warsaw")
    bDay = dayofmonth(blackoutDateTime, "Europe/Warsaw")
    useBlackout and (year(currentTime, "Europe/Warsaw") == bYear) and (month(currentTime, "Europe/Warsaw") == bMonth) and (dayofmonth(currentTime, "Europe/Warsaw") == bDay)

// ==========================================
// 6. Fabryka Stringów: Webhook PineConnector
// ==========================================
export build_pc_msg(string licenseID, string action, string symbol, float risk, float sl, float tp, string comment) =>
    slStr = sl > 0 ? ",sl=" + str.tostring(sl * 10) : ""
    tpStr = tp > 0 ? ",tp=" + str.tostring(tp * 10) : ""
    riskStr = risk > 0 ? ",risk=" + str.tostring(risk) : ""
    commentStr = comment != "" ? ",comment=" + comment : ""
    licenseID + "," + action + "," + symbol + riskStr + slStr + tpStr + commentStr