//=============================================================================
// Indicator Name:
// Institutional Moving Averages
//
// Pine Script Version:
// 6
//
// Author:
// Michael_Fx_Trader
//
// Category:
// Institutional Trend Following
//
// Description:
// Institutional Moving Averages is an original Pine Script Version 6 indicator
// developed for professional institutional trend analysis using adaptive
// moving averages, intelligent trend confirmation, dynamic support and
// resistance, momentum analysis, volatility filtering, adaptive ribbon
// visualization, multi-layer market structure analysis, and professional
// trade signal generation.
//
// This indicator has been independently engineered with original analytical
// logic and implementation specifically for TradingView.
//
//=============================================================================

//@version=6
indicator("Institutional Moving Averages", "IMA", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, max_bars_back = 1000)

//=============================================================================
// SECTION 1 : INPUTS
//=============================================================================
gEng = "◆ ADAPTIVE ENGINE"
srcIn    = input.source(close,  "Price Source",                                  group = gEng)
sens     = input.float(1.0,     "Adaptive Sensitivity",  minval = 0.1, maxval = 3.0, step = 0.1, group = gEng, tooltip = "Higher = faster reaction in trends, lower = smoother behaviour.")
atrLen   = input.int(14,        "ATR Length",            minval = 2,  maxval = 200, group = gEng)
momLen   = input.int(14,        "Momentum Length",       minval = 2,  maxval = 200, group = gEng)
normLen  = input.int(50,        "Normalisation Window",  minval = 10, maxval = 300, group = gEng, tooltip = "Window used to standardise momentum, slope and volatility readings.")
useVol   = input.bool(true,     "Use Volume Confirmation (when available)",      group = gEng)

gMA = "◆ MOVING AVERAGE FRAMEWORK"
lenFast  = input.int(9,   "Fast Institutional MA",      minval = 2, group = gMA)
lenMed   = input.int(21,  "Medium Institutional MA",    minval = 2, group = gMA)
lenSlow  = input.int(50,  "Slow Institutional MA",      minval = 2, group = gMA)
lenPri   = input.int(21,  "Primary Trend MA",           minval = 2, group = gMA)
lenSec   = input.int(55,  "Secondary Trend MA",         minval = 2, group = gMA)
showCore = input.bool(false, "Show Fast / Medium / Slow MAs", group = gMA)
showSR   = input.bool(true,  "Show Dynamic Support & Resistance MAs", group = gMA)
srMult   = input.float(1.0, "Dynamic S/R Band Width (ATR)", minval = 0.1, maxval = 5.0, step = 0.1, group = gMA)

gRib = "◆ ADAPTIVE RIBBON"
showRib  = input.bool(true, "Show Adaptive Ribbon",             group = gRib)
ribLayers= input.int(4,     "Ribbon Layers",   minval = 1, maxval = 6, group = gRib)
ribTrans = input.int(78,    "Ribbon Transparency (base)", minval = 40, maxval = 95, group = gRib)
ribAdapt = input.bool(true, "Adapt Brightness To Trend Strength", group = gRib)

gTrd = "◆ TREND ENGINE"
thrTrend = input.int(45,  "Trend Strength Threshold",   minval = 5, maxval = 95, group = gTrd)
thrInst  = input.int(80,  "Institutional Trend Level",  minval = 50, maxval = 99, group = gTrd)
persLen  = input.int(20,  "Persistence Window",         minval = 5, maxval = 100, group = gTrd)
showBG   = input.bool(true,  "Background Trend Zones",  group = gTrd)
bgMaxOp  = input.int(92,  "Background Transparency (min strength)", minval = 70, maxval = 99, group = gTrd)

gSig = "◆ SIGNAL ENGINE"
showPrim = input.bool(true,  "Primary Signals",       group = gSig)
showAggr = input.bool(true,  "Aggressive Signals",    group = gSig)
showCons = input.bool(true,  "Conservative Signals",  group = gSig)
showExit = input.bool(true,  "Exit / Warning Signals",group = gSig)
sigLabels= input.bool(true,  "Show Signal Text Labels", group = gSig)
sigSize  = input.string("Small", "Signal Size", options = ["Tiny", "Small", "Normal", "Large"], group = gSig)
coolDown = input.int(5,   "Signal Cooldown (bars)", minval = 0, maxval = 100, group = gSig)
atrExp   = input.float(0.95, "Min Volatility Expansion Ratio", minval = 0.3, maxval = 3.0, step = 0.05, group = gSig, tooltip = "Current ATR vs its average. Blocks signals in dead markets.")
confClose= input.bool(true,  "Confirm Signals On Bar Close (non-repainting)", group = gSig)

gLvl = "◆ STRUCTURE LEVELS"
showLvl  = input.bool(true, "Show Reaction Levels",      group = gLvl)
lvlLook  = input.int(10,    "Swing Lookback",   minval = 2, maxval = 100, group = gLvl)
lvlMax   = input.int(6,     "Max Active Levels",minval = 1, maxval = 20,  group = gLvl)

gCol = "◆ COLORS"
cBull    = input.color(#00c853, "Bullish",        group = gCol)
cBear    = input.color(#ff1744, "Bearish",        group = gCol)
cNeut    = input.color(#9e9e9e, "Neutral",        group = gCol)
cWeak    = input.color(#ff9800, "Weak Trend",     group = gCol)
cStrong  = input.color(#2962ff, "Institutional Trend", group = gCol)
cPri     = input.color(#7e57c2, "Primary MA Line",group = gCol)
cSec     = input.color(#ffb74d, "Secondary MA Line", group = gCol)

gDash = "◆ DASHBOARD"
showDash = input.bool(true, "Show Dashboard", group = gDash)
dashPos  = input.string("Top Right", "Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group = gDash)
dashSize = input.string("Normal", "Text Size", options = ["Tiny", "Small", "Normal"], group = gDash)

//=============================================================================
// SECTION 2 : CORE ORIGINAL FUNCTIONS
//=============================================================================

// --- bounded squash : maps any real number into (-1 , 1) without clipping ----
f_squash(float x) =>
    x / (1.0 + math.abs(x))

// --- price efficiency : directional travel vs total travel ------------------
f_efficiency(float s, int len) =>
    float dir = math.abs(s - s[len])
    float pth = math.sum(math.abs(s - s[1]), len)
    pth > 0 ? math.min(dir / pth, 1.0) : 0.0

// --- z-score normalisation --------------------------------------------------
f_z(float x, int len) =>
    float m = ta.sma(x, len)
    float d = ta.stdev(x, len)
    d > 0 ? (x - m) / d : 0.0

// --- INSTITUTIONAL ADAPTIVE MA ----------------------------------------------
// Original engine. The smoothing constant is rebuilt every bar from three
// independent market readings :
//   1. price efficiency   -> how clean the directional travel is
//   2. volatility regime  -> current ATR against its own average
//   3. structural slope   -> persistence of directional pressure
// In clean expansion the average accelerates, in contraction it decays into a
// slow institutional baseline instead of chopping around price.
f_ima(float s, int len, float k, float volRatio) =>
    float eff   = f_efficiency(s, len)
    float slope = math.abs(s - s[int(math.max(1, math.round(len / 3.0)))]) / math.max(ta.atr(atrLen), syminfo.mintick)
    float drive = math.min(1.0, 0.65 * eff + 0.35 * f_squash(slope))
    float vAdj  = math.min(1.5, math.max(0.6, volRatio))
    float fastA = 2.0 / (math.max(2.0, len / (2.0 + k)) + 1.0)
    float slowA = 2.0 / (len * (1.0 + k * 0.5) + 1.0)
    float alpha = math.pow(slowA + drive * (fastA - slowA), 2.0) * vAdj
    alpha := math.min(1.0, math.max(0.001, alpha))
    float out = na
    out := na(out[1]) ? s : out[1] + alpha * (s - out[1])
    out

//=============================================================================
// SECTION 3 : VOLATILITY & MOMENTUM CONTEXT
//=============================================================================
float atr      = ta.atr(atrLen)
float atrAvg   = ta.sma(atr, normLen)
float volRatio = atrAvg > 0 ? atr / atrAvg : 1.0
bool  volOK    = volRatio >= atrExp

// Original composite momentum : rate of change + acceleration + closing
// pressure inside the bar, each standardised then blended and bounded.
float roc      = srcIn - srcIn[momLen]
float accel    = roc - roc[int(math.max(1, math.round(momLen / 2.0)))]
float rng      = math.max(high - low, syminfo.mintick)
float press    = (close - (high + low) / 2) / rng * 2.0
float volW     = useVol and not na(volume) and ta.sma(volume, normLen) > 0 ? math.min(2.0, volume / ta.sma(volume, normLen)) : 1.0
float momRaw   = 0.45 * f_z(roc, normLen) + 0.30 * f_z(accel, normLen) + 0.25 * f_z(press * volW, normLen)
float momentum = f_squash(momRaw)

//=============================================================================
// SECTION 4 : MOVING AVERAGE FRAMEWORK
//=============================================================================
float maFast = f_ima(srcIn, lenFast, sens,       volRatio)
float maMed  = f_ima(srcIn, lenMed,  sens * 0.8, volRatio)
float maSlow = f_ima(srcIn, lenSlow, sens * 0.5, volRatio)

// Primary trend MA : adaptive composite of the responsive band
float priBase = maFast * 0.55 + maMed * 0.45
float maPri   = f_ima(priBase, lenPri, sens, volRatio)

// Secondary trend MA : institutional baseline, deliberately slower
float maSec   = f_ima(maSlow, lenSec, sens * 0.35, math.max(0.8, volRatio))

// Dynamic support / resistance envelopes around the primary trend
float band   = atr * srMult * math.max(0.7, math.min(1.6, volRatio))
float dynSup = math.min(maPri, maSec) - band
float dynRes = math.max(maPri, maSec) + band

//=============================================================================
// SECTION 5 : TREND STRENGTH ENGINE (0 - 100)
//=============================================================================
float slopeN   = (maPri - maPri[3]) / math.max(atr, syminfo.mintick)
float cSlope   = f_squash(slopeN * 1.8)

float alignSum = (maFast > maMed ? 1.0 : -1.0) + (maMed > maSlow ? 1.0 : -1.0) + (maPri > maSec ? 1.0 : -1.0)
float cAlign   = alignSum / 3.0

float cMom     = momentum
float cDist    = f_squash((close - maSec) / math.max(atr, syminfo.mintick) * 0.6)

int   upBars   = 0
for i = 0 to persLen - 1
    upBars += close[i] > maPri[i] ? 1 : 0
float cPers    = (upBars / persLen) * 2.0 - 1.0

float eff      = f_efficiency(srcIn, lenMed)
float cEff     = eff * math.sign(nz(srcIn - srcIn[lenMed], 0))

var int regBars = 0
var int regime  = 0
float cDur      = math.min(regBars / 30.0, 1.0) * regime

float rawScore = (cSlope * 0.20 + cAlign * 0.20 + cMom * 0.18 + cDist * 0.14 + cPers * 0.12 + cEff * 0.10 + cDur * 0.06) / 1.0
rawScore := math.max(-1.0, math.min(1.0, rawScore * math.max(0.75, math.min(1.35, volRatio))))

float trendScore = math.round(math.abs(rawScore) * 100)
int   trendDir   = rawScore > 0.05 ? 1 : rawScore < -0.05 ? -1 : 0

// --- regime state machine ---------------------------------------------------
bool bullRegime = trendDir == 1 and close > maSec and trendScore >= thrTrend
bool bearRegime = trendDir == -1 and close < maSec and trendScore >= thrTrend
int  newRegime  = bullRegime ? 1 : bearRegime ? -1 : regime
regBars := newRegime == regime ? regBars + 1 : 0
bool flipUp   = newRegime == 1  and regime != 1
bool flipDn   = newRegime == -1 and regime != -1
regime := newRegime

// --- market bias label ------------------------------------------------------
string biasTxt = trendDir == 1  and trendScore >= thrInst  ? "STRONG BULLISH" : trendDir == 1  and trendScore >= thrTrend ? "BULLISH" : trendDir == -1 and trendScore >= thrInst  ? "STRONG BEARISH" : trendDir == -1 and trendScore >= thrTrend ? "BEARISH" : "NEUTRAL"

string qualTxt = trendScore < 20 ? "VERY WEAK" : trendScore < 40 ? "WEAK" : trendScore < 60 ? "MODERATE" : trendScore < 80 ? "STRONG" : "INSTITUTIONAL"

//=============================================================================
// SECTION 6 : ADAPTIVE COLOR SYSTEM (smooth transitions)
//=============================================================================
color baseCol  = trendDir == 0 ? cNeut : trendScore >= thrInst ? cStrong : trendScore < thrTrend ? cWeak : (trendDir == 1 ? cBull : cBear)
color dirCol   = trendDir == 1 ? cBull : trendDir == -1 ? cBear : cNeut
color blendCol = color.from_gradient(trendScore, 0, 100, cNeut, baseCol)

// smoothed transition weight so colours never snap abruptly
float colW = ta.ema(trendScore, 3)
color maCol  = color.from_gradient(colW, 0, 100, cNeut, dirCol)

//=============================================================================
// SECTION 7 : PLOTS - MAs, RIBBON, S/R
//=============================================================================
p1 = plot(showCore ? maFast : na, "Fast Institutional MA",   color = color.new(maCol, 35), linewidth = 1)
p2 = plot(showCore ? maMed  : na, "Medium Institutional MA", color = color.new(maCol, 45), linewidth = 1)
p3 = plot(showCore ? maSlow : na, "Slow Institutional MA",   color = color.new(maCol, 55), linewidth = 1)

pPri = plot(maPri, "Primary Trend MA",   color = color.new(cPri, 0), linewidth = 2)
pSec = plot(maSec, "Secondary Trend MA", color = color.new(cSec, 0), linewidth = 2)

plot(showSR ? dynSup : na, "Dynamic Support",    color = color.new(cBull, 60), linewidth = 1, style = plot.style_linebr)
plot(showSR ? dynRes : na, "Dynamic Resistance", color = color.new(cBear, 60), linewidth = 1, style = plot.style_linebr)

// --- adaptive ribbon --------------------------------------------------------
int ribT = ribAdapt ? int(math.max(45, math.min(95, ribTrans - trendScore * 0.30))) : ribTrans
color ribCol = maPri > maSec ? color.new(cBull, ribT) : maPri < maSec ? color.new(cBear, ribT) : color.new(cNeut, ribT)
fill(pPri, pSec, color = showRib ? ribCol : na, title = "Adaptive Ribbon")

// layered gradient effect : intermediate steps between the two trend MAs
l1 = plot(showRib and ribLayers > 1 ? maPri + (maSec - maPri) * 0.25 : na, "L1", color = color.new(color.black, 100), display = display.none)
l2 = plot(showRib and ribLayers > 2 ? maPri + (maSec - maPri) * 0.50 : na, "L2", color = color.new(color.black, 100), display = display.none)
l3 = plot(showRib and ribLayers > 3 ? maPri + (maSec - maPri) * 0.75 : na, "L3", color = color.new(color.black, 100), display = display.none)
fill(pPri, l1, color = showRib and ribLayers > 1 ? color.new(ribCol, math.max(40, ribT - 12)) : na, title = "Ribbon Core")
fill(l1,   l2, color = showRib and ribLayers > 2 ? color.new(ribCol, math.max(45, ribT -  6)) : na, title = "Ribbon Mid")
fill(l2,   l3, color = showRib and ribLayers > 3 ? color.new(ribCol, ribT) : na, title = "Ribbon Outer")

// --- background trend zones -------------------------------------------------
int bgT = int(math.max(80, bgMaxOp - trendScore * 0.12))
bgcolor(showBG and regime == 1 ? color.new(cBull, bgT) : showBG and regime == -1 ? color.new(cBear, bgT) : na, title = "Trend Zone")

//=============================================================================
// SECTION 8 : SIGNAL ENGINE
//=============================================================================
bool alignUp = maFast > maMed and maMed > maSlow and maPri > maSec
bool alignDn = maFast < maMed and maMed < maSlow and maPri < maSec

bool ribExpand  = math.abs(maPri - maSec) > math.abs(maPri[1] - maSec[1]) and math.abs(maPri - maSec) > atr * 0.25
bool ribCompress= math.abs(maPri - maSec) < atr * 0.18

var int lastBuy  = -1000
var int lastSell = -1000
bool cdBuy  = bar_index - lastBuy  > coolDown
bool cdSell = bar_index - lastSell > coolDown
bool okBar  = confClose ? (barstate.isconfirmed or barstate.ishistory) : true

// --- BUY tiers --------------------------------------------------------------
bool buyPrimary = flipUp and alignUp and momentum > 0 and volOK and cdBuy
bool buyAggr    = not flipUp and ta.crossover(close, maPri) and momentum > 0.05 and trendScore >= thrTrend * 0.6 and maPri > maPri[1] and volOK and cdBuy
bool buyCons    = not flipUp and regime == 1 and alignUp and trendScore >= thrInst and low <= maPri and close > maPri and momentum > 0 and ribExpand and cdBuy

// --- SELL tiers -------------------------------------------------------------
bool sellPrimary= flipDn and alignDn and momentum < 0 and volOK and cdSell
bool sellAggr   = not flipDn and ta.crossunder(close, maPri) and momentum < -0.05 and trendScore >= thrTrend * 0.6 and maPri < maPri[1] and volOK and cdSell
bool sellCons   = not flipDn and regime == -1 and alignDn and trendScore >= thrInst and high >= maPri and close < maPri and momentum < 0 and ribExpand and cdSell

bool anyBuy  = (showPrim and buyPrimary) or (showAggr and buyAggr) or (showCons and buyCons)
bool anySell = (showPrim and sellPrimary) or (showAggr and sellAggr) or (showCons and sellCons)

if anyBuy and okBar
    lastBuy := bar_index
if anySell and okBar
    lastSell := bar_index

// --- position state for exits ----------------------------------------------
var int pos = 0
if anyBuy and okBar
    pos := 1
if anySell and okBar
    pos := -1

// --- exit / warning logic ---------------------------------------------------
bool momLoss     = pos == 1 ? momentum < 0 and momentum[1] >= 0 : pos == -1 ? momentum > 0 and momentum[1] <= 0 : false
bool trendWeak   = trendScore < thrTrend and trendScore[1] >= thrTrend and pos != 0
bool exitLong    = pos ==  1 and (ta.crossunder(close, maPri) or (trendScore < thrTrend * 0.7 and momentum < 0))
bool exitShort   = pos == -1 and (ta.crossover(close, maPri)  or (trendScore < thrTrend * 0.7 and momentum > 0))
bool partialLong = pos ==  1 and (close - maSec) / math.max(atr, syminfo.mintick) > 3.0 and momentum < momentum[1]
bool partialShort= pos == -1 and (maSec - close) / math.max(atr, syminfo.mintick) > 3.0 and momentum > momentum[1]
bool revWarn     = (pos == 1 and ribCompress and momentum < -0.15) or (pos == -1 and ribCompress and momentum > 0.15)

if (exitLong or exitShort) and okBar
    pos := 0

//=============================================================================
// SECTION 9 : SIGNAL RENDERING
//=============================================================================
string lbSz  = sigSize == "Tiny" ? size.tiny : sigSize == "Small" ? size.small : sigSize == "Normal" ? size.normal : size.large

plotshape(showPrim and buyPrimary  and okBar, "Primary Buy",      style = shape.triangleup,   location = location.belowbar, color = cBull,    size = size.small)
plotshape(showPrim and sellPrimary and okBar, "Primary Sell",     style = shape.triangledown, location = location.abovebar, color = cBear,    size = size.small)
plotshape(showAggr and buyAggr     and okBar, "Aggressive Buy",   style = shape.arrowup,      location = location.belowbar, color = cStrong,  size = size.small)
plotshape(showAggr and sellAggr    and okBar, "Aggressive Sell",  style = shape.arrowdown,    location = location.abovebar, color = #e91e63,  size = size.small)
plotshape(showCons and buyCons     and okBar, "Conservative Buy", style = shape.circle,       location = location.belowbar, color = color.new(cBull, 20), size = size.tiny)
plotshape(showCons and sellCons    and okBar, "Conservative Sell",style = shape.circle,       location = location.abovebar, color = color.new(cBear, 20), size = size.tiny)

plotshape(showExit and exitLong     and okBar, "Exit Long",        style = shape.xcross, location = location.abovebar, color = cWeak,   size = size.tiny)
plotshape(showExit and exitShort    and okBar, "Exit Short",       style = shape.xcross, location = location.belowbar, color = cWeak,   size = size.tiny)
plotshape(showExit and partialLong  and okBar, "Partial Profit L", style = shape.diamond,location = location.abovebar, color = #ffd54f, size = size.tiny)
plotshape(showExit and partialShort and okBar, "Partial Profit S", style = shape.diamond,location = location.belowbar, color = #ffd54f, size = size.tiny)
plotshape(showExit and revWarn      and okBar, "Possible Reversal",style = shape.flag,   location = location.abovebar, color = #ab47bc, size = size.tiny)

if sigLabels and okBar
    if buyPrimary or buyAggr
        label.new(bar_index, low - atr * 0.8, buyPrimary ? "LONG" : "LONG (A)", style = label.style_label_up, color = color.new(cBull, 15), textcolor = color.white, size = lbSz)
    if sellPrimary or sellAggr
        label.new(bar_index, high + atr * 0.8, sellPrimary ? "SHORT" : "SHORT (A)", style = label.style_label_down, color = color.new(cBear, 15), textcolor = color.white, size = lbSz)
    if showExit and exitLong
        label.new(bar_index, high + atr * 0.6, "Exit Long", style = label.style_label_down, color = color.new(cWeak, 20), textcolor = color.white, size = size.tiny)
    if showExit and exitShort
        label.new(bar_index, low - atr * 0.6, "Exit Short", style = label.style_label_up, color = color.new(cWeak, 20), textcolor = color.white, size = size.tiny)

//=============================================================================
// SECTION 10 : STRUCTURE REACTION LEVELS
//=============================================================================
var array<line>  lvLine = array.new<line>()
var array<float> lvPx   = array.new<float>()
var array<bool>  lvSup  = array.new<bool>()

f_addLevel(float px, bool isSup) =>
    line ln = line.new(bar_index, px, bar_index + 2, px, color = color.new(isSup ? cBull : cBear, 25), width = 1)
    array.push(lvLine, ln)
    array.push(lvPx, px)
    array.push(lvSup, isSup)
    while array.size(lvLine) > lvlMax
        line.delete(array.shift(lvLine))
        array.shift(lvPx)
        array.shift(lvSup)

if showLvl and okBar
    if flipUp
        f_addLevel(ta.lowest(low, lvlLook), true)
    if flipDn
        f_addLevel(ta.highest(high, lvlLook), false)

    if array.size(lvLine) > 0
        for i = array.size(lvLine) - 1 to 0
            float px    = array.get(lvPx, i)
            bool  isSup = array.get(lvSup, i)
            bool  broke = isSup ? close < px - atr * 0.15 : close > px + atr * 0.15
            if broke
                line.delete(array.get(lvLine, i))
                array.remove(lvLine, i)
                array.remove(lvPx, i)
                array.remove(lvSup, i)
            else
                line.set_x2(array.get(lvLine, i), bar_index + 2)

// retest / bounce detection against the primary trend MA
bool bounceSup = regime ==  1 and low  <= maPri and close > maPri and momentum > 0
bool rejectRes = regime == -1 and high >= maPri and close < maPri and momentum < 0
bool breakOut  = ta.crossover(close, dynRes) and volOK
bool breakDown = ta.crossunder(close, dynSup) and volOK

//=============================================================================
// SECTION 11 : DASHBOARD
//=============================================================================
f_pos(string p) =>
    p == "Top Right" ? position.top_right : p == "Top Left" ? position.top_left : p == "Bottom Right" ? position.bottom_right : p == "Bottom Left" ? position.bottom_left : position.middle_right

string tSz = dashSize == "Tiny" ? size.tiny : dashSize == "Small" ? size.small : size.normal

var table dash = table.new(f_pos(dashPos), 2, 9, border_width = 1, frame_width = 1, frame_color = color.new(color.gray, 60), border_color = color.new(color.gray, 70))

if showDash and barstate.islast
    table.cell(dash, 0, 0, "INSTITUTIONAL MA", text_color = color.white, bgcolor = color.new(#1e2a38, 10), text_size = tSz)
    table.cell(dash, 1, 0, syminfo.ticker + " · " + timeframe.period, text_color = color.white, bgcolor = color.new(#1e2a38, 10), text_size = tSz)

    table.cell(dash, 0, 1, "Bias",            text_color = color.silver, text_size = tSz)
    table.cell(dash, 1, 1, biasTxt,           text_color = trendDir == 1 ? cBull : trendDir == -1 ? cBear : cNeut, text_size = tSz)

    table.cell(dash, 0, 2, "Trend Score",     text_color = color.silver, text_size = tSz)
    table.cell(dash, 1, 2, str.tostring(trendScore, "#") + " / 100", text_color = blendCol, text_size = tSz)

    table.cell(dash, 0, 3, "Trend Quality",   text_color = color.silver, text_size = tSz)
    table.cell(dash, 1, 3, qualTxt,           text_color = trendScore >= thrInst ? cStrong : trendScore >= thrTrend ? dirCol : cWeak, text_size = tSz)

    table.cell(dash, 0, 4, "Momentum",        text_color = color.silver, text_size = tSz)
    table.cell(dash, 1, 4, str.tostring(momentum * 100, "#.#") + "%", text_color = momentum > 0 ? cBull : momentum < 0 ? cBear : cNeut, text_size = tSz)

    table.cell(dash, 0, 5, "Volatility",      text_color = color.silver, text_size = tSz)
    table.cell(dash, 1, 5, str.tostring(volRatio, "#.##") + "x " + (volOK ? "OK" : "FLAT"), text_color = volOK ? color.white : cWeak, text_size = tSz)

    table.cell(dash, 0, 6, "Ribbon",          text_color = color.silver, text_size = tSz)
    table.cell(dash, 1, 6, ribExpand ? "EXPANDING" : ribCompress ? "COMPRESSED" : "STABLE", text_color = ribExpand ? dirCol : cNeut, text_size = tSz)

    table.cell(dash, 0, 7, "Dyn. Support",    text_color = color.silver, text_size = tSz)
    table.cell(dash, 1, 7, str.tostring(dynSup, format.mintick), text_color = cBull, text_size = tSz)

    table.cell(dash, 0, 8, "Dyn. Resistance", text_color = color.silver, text_size = tSz)
    table.cell(dash, 1, 8, str.tostring(dynRes, format.mintick), text_color = cBear, text_size = tSz)

//=============================================================================
// SECTION 12 : ALERT CONDITIONS
//=============================================================================
alertcondition(anyBuy,                          "Buy Signal",             "IMA · Buy signal on {{ticker}} {{interval}}")
alertcondition(anySell,                         "Sell Signal",            "IMA · Sell signal on {{ticker}} {{interval}}")
alertcondition(flipUp or flipDn,                "Trend Change",           "IMA · Trend regime change on {{ticker}} {{interval}}")
alertcondition(trendDir == 1  and trendScore >= thrInst, "Strong Bullish Trend", "IMA · Institutional bullish trend on {{ticker}}")
alertcondition(trendDir == -1 and trendScore >= thrInst, "Strong Bearish Trend", "IMA · Institutional bearish trend on {{ticker}}")
alertcondition(trendWeak,                       "Trend Weakening",        "IMA · Trend weakening on {{ticker}} {{interval}}")
alertcondition(bounceSup,                       "Support Bounce",         "IMA · Dynamic support bounce on {{ticker}}")
alertcondition(rejectRes,                       "Resistance Rejection",   "IMA · Dynamic resistance rejection on {{ticker}}")
alertcondition(breakOut,                        "Breakout",               "IMA · Breakout above dynamic resistance on {{ticker}}")
alertcondition(breakDown,                       "Breakdown",              "IMA · Breakdown below dynamic support on {{ticker}}")
alertcondition(momentum > 0.35 or momentum < -0.35, "Momentum Expansion", "IMA · Momentum expansion on {{ticker}}")
alertcondition(momLoss,                         "Momentum Weakening",     "IMA · Momentum loss on {{ticker}}")
alertcondition(ribExpand,                       "Ribbon Expansion",       "IMA · Ribbon expansion on {{ticker}}")
alertcondition(ribCompress,                     "Ribbon Compression",     "IMA · Ribbon compression on {{ticker}}")
alertcondition(exitLong or exitShort,           "Exit Signal",            "IMA · Exit signal on {{ticker}} {{interval}}")

