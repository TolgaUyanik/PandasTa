// @description OscLib — Oscillator primitives with typed UDTs and composition constants.
// v3: BREAKING CHANGE - f_compute_osc signature changed to use OscSpec UDT.
// Legacy /1 stays current for existing consumers. New indicators should use /3.
//
// Provides: OscSpec/OscReading/VisConfig UDTs, 8-kind oscillator dispatcher,
// 7 composition kind constants (OSC_COMP_*), tanh soft-clip normalization.
//
// Architecture: L1 (imports NumLib/4 for f_tanh)

import cybermediaboy/NumLib/4 as NL

library("OscLib", overlay=false)

// ═══════════════════════════════════════════════════════════════════════════════════
// COMPOSITION KIND CONSTANTS (7 total)
// ═══════════════════════════════════════════════════════════════════════════════════

export const string OSC_COMP_NONE = "none"
export const string OSC_COMP_SINGLE = "single"
export const string OSC_COMP_WEIGHTED_SUM = "weighted_sum"
export const string OSC_COMP_PAIR_DIVERGENCE = "pair_divergence"
export const string OSC_COMP_GS_ORTHOGONAL = "gs_orthogonal"
export const string OSC_COMP_MAHALANOBIS_3D = "mahalanobis_3d"
export const string OSC_COMP_GRANGER_BASKET = "granger_basket"

// ═══════════════════════════════════════════════════════════════════════════════════
// TYPES (3 UDTs)
// ═══════════════════════════════════════════════════════════════════════════════════

// @type Oscillator specification (kind + behavior descriptor)
// @field kind Oscillator type: "RSI", "MFI", "CCI", "STOCH", "WPR", "OBV", "CVD", "Close"
// @field source Price source: "close", "hlc3", "hl2", "ohlc4"
// @field soft_clip Use tanh soft-clip (true) or hard clamp (false)
// @field debug_code Integer debug code for logging/introspection
// Note: period and zscore_len passed separately to f_compute_osc as simple int parameters
export type OscSpec
    string kind
    string source
    bool soft_clip
    int debug_code

// @type Oscillator reading (single bar)
// @field raw_value Raw oscillator value before normalization
// @field normalized_value Z-score normalized value (soft-clipped or hard-clamped to ±6)
// @field bar_index Bar index when reading was captured
export type OscReading
    float raw_value
    float normalized_value
    int bar_index

// @type Visual configuration (separate from OscSpec for serialization purity)
// @field line_color Plot line color
// @field transparency Color transparency (0-100)
// @field line_width Plot line width
// @field display_name Human-readable name for legend
export type VisConfig
    color line_color
    int transparency
    int line_width
    string display_name

// ═══════════════════════════════════════════════════════════════════════════════════
// OSCILLATOR COMPUTATION (8 kinds)
// ═══════════════════════════════════════════════════════════════════════════════════

// @function Compute oscillator reading from specification
// @param spec OscSpec defining oscillator parameters
// @param period Oscillator period (simple int required for ta.* functions)
// @param zscore_len Z-score normalization window (simple int required for ta.sma/ta.stdev)
// @param src Price source series (overrides spec.source if provided)
// @param vol Volume series (required for MFI, CVD)
// @returns OscReading with raw and normalized values
export f_compute_osc(OscSpec spec, simple int period, simple int zscore_len, float src, float vol) =>
    // Resolve source
    float source_val = switch spec.source
        "hlc3" => hlc3
        "hl2" => hl2
        "ohlc4" => ohlc4
        => close
    
    float input_src = na(src) ? source_val : src
    
    // Compute raw oscillator value
    float raw = switch spec.kind
        "RSI" => ta.rsi(input_src, period)
        "MFI" => ta.mfi(hlc3, period)
        "CCI" => ta.cci(input_src, period)
        "STOCH" => ta.stoch(close, high, low, period)
        "WPR" => ta.wpr(period)
        "OBV" => ta.obv
        "CVD" => ta.cum(math.sign(close - close[1]) * vol * close)
        "Close" => input_src
        => ta.rsi(input_src, period)  // default fallback
    
    // Z-score normalization
    float mu = ta.sma(raw, zscore_len)
    float sd = ta.stdev(raw, zscore_len)
    float z = sd > 1e-10 ? (raw - mu) / sd : 0.0
    
    // Soft-clip (tanh) or hard-clamp
    float normalized = spec.soft_clip ? 
         6.0 * NL.f_tanh(z / 6.0) : 
         math.max(-6.0, math.min(6.0, z))
    
    OscReading.new(raw, normalized, bar_index)

// @function Get default visual configuration
// @returns VisConfig with sensible defaults
export f_default_vis_config() =>
    VisConfig.new(
         line_color = color.blue,
         transparency = 0,
         line_width = 2,
         display_name = "Oscillator")
