//@version=6
indicator("High Volume Buyers/Sellers+", overlay=true)

// Inputs
length = input.int(20, title="Volume MA Period")
mult = input.float(2.5, title="High Volume Multiplier")
multExtreme = input.float(4.0, title="Extreme Volume Multiplier")
showExtreme = input.bool(true, title="Show Extreme Volume Signals")

// Calculations
vol = volume
vol_ma = ta.sma(vol, length)
isHighVol = vol > vol_ma * mult
isExtremeVol = vol > vol_ma * multExtreme
isGreen = close > open
isRed = close < open

// Plotting shapes - High Volume (non-extreme)
plotshape(isHighVol and isGreen and (not isExtremeVol or not showExtreme), title="High Buyer Volume", location=location.belowbar, style=shape.circle, color=color.new(color.green, 0), size=size.tiny)
plotshape(isHighVol and isRed and (not isExtremeVol or not showExtreme), title="High Seller Volume", location=location.abovebar, style=shape.circle, color=color.new(color.red, 0), size=size.tiny)

// Plotting shapes - Extreme Volume (only if showExtreme is true)
plotshape(showExtreme and isExtremeVol and isGreen, title="Extreme Buyer Volume", location=location.belowbar, style=shape.triangleup, color=color.new(color.green, 0), size=size.small)
plotshape(showExtreme and isExtremeVol and isRed, title="Extreme Seller Volume", location=location.abovebar, style=shape.triangledown, color=color.new(color.red, 0), size=size.small)
