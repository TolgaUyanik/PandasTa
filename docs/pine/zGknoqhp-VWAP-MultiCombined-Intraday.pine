//@version=5
indicator("VWAP MultiCombined Intraday", overlay=true)

// === Function to calculate VWAP ===
f_vwap(_src, _tf) =>
    var float cum_tpv = na
    var float cum_vol = na
    is_new = ta.change(time(_tf))
    cum_tpv := is_new ? _src * volume : cum_tpv + _src * volume
    cum_vol := is_new ? volume : cum_vol + volume
    cum_tpv / cum_vol

// === VWAP Levels ===
vwap_session  = f_vwap(hlc3, "D")    // Intraday session (daily reset)
vwap_week     = f_vwap(hlc3, "W")    // Weekly
vwap_month    = f_vwap(hlc3, "M")    // Monthly
vwap_quarter  = f_vwap(hlc3, "3M")   // Quarterly
vwap_year     = f_vwap(hlc3, "12M")  // Yearly
vwap_decade   = f_vwap(hlc3, "120M") // 10 years
vwap_century  = f_vwap(hlc3, "1200M")// 100 years

// === Plotting ===
plot(vwap_session, "VWAP Session", color=color.new(#787b86, 12), linewidth =1)
plot(vwap_week,    "VWAP Week",    color=color.new(#787b86, 20), linewidth=1)
plot(vwap_month,   "VWAP Month",   color=color.new(color.red,   70), linewidth=1)
plot(vwap_quarter, "VWAP Quarter", color=color.new(#ff0d0d, 30),  linewidth=1)
plot(vwap_year,    "VWAP Year",    color=color.new(#229bff, 0),  linewidth=1)
plot(vwap_decade,  "VWAP Decade",  color=color.new(#03077d, 0), linewidth=1)
plot(vwap_century, "VWAP Century", color=color.new(#ff9900, 0), linewidth=1)

// === Optional: Labels or alerts can be added as needed ===