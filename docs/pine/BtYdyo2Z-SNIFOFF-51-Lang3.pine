    else if lang == "Italiano"
        _head     := kind > 0 ? "CONFLUENZA RIALZISTA — SOGLIA SUPERATA" : kind < 0 ? "CONFLUENZA RIBASSISTA — SOGLIA SUPERATA" : "INDECISIONE — TORO E ORSO PARI ALLA SOGLIA"
        _trN      := sigCode == 5 ? "Forte Uptrend" : sigCode == 6 ? "Forte Downtrend" : sigCode == 7 ? "Bias Rialzista Nascosto" : sigCode == 8 ? "Bias Ribassista Nascosto" : sigCode == 9 ? "Uptrend Attivo" : "Downtrend Attivo"
        _cvN      := convCode == 1 ? "ALTA" : convCode == 2 ? "MODERATA" : "BASSA"
        _moN      := momCode == 1 ? "In Accelerazione" : momCode == 2 ? "In Affinamento" : momCode == 3 ? "Stabile" : "In Calo"
        _lTrend   := "Trend: "
        _lAlign   := " · Allineamento "
        _lConv    := "Convinzione: "
        _lEff     := " · Efficienza: "
        _lMom     := "Momentum: "
        _lVol     := "Volume: "
        _lScore   := "Punteggio "
        _lAligned := "/5 allineate · dati a barre chiuse"
        _lBull    := "Toro: +"
        _lBear    := " | Orso: -"
        _lAct     := " | Attività: "
        _lDisc    := "Osservazione strutturale, non un consiglio di trading"
        _cB       := "Continuazione rialzista · "
        _cS       := "Continuazione ribassista · "
        _cStr     := "più forte della precedente"
        _cWk      := "più debole della precedente"
        _cEq      := "pari alla precedente"
    else if lang == "हिन्दी"
        _head     := kind > 0 ? "तेज़ी संगम — सीमा पार हुई" : kind < 0 ? "मंदी संगम — सीमा पार हुई" : "अनिर्णय — सीमा पर तेज़ी और मंदी बराबर"
        _trN      := sigCode == 5 ? "मज़बूत अपट्रेंड" : sigCode == 6 ? "मज़बूत डाउनट्रेंड" : sigCode == 7 ? "छिपा तेज़ी झुकाव" : sigCode == 8 ? "छिपा मंदी झुकाव" : sigCode == 9 ? "सक्रिय अपट्रेंड" : "सक्रिय डाउनट्रेंड"
        _cvN      := convCode == 1 ? "उच्च" : convCode == 2 ? "मध्यम" : "निम्न"
        _moN      := momCode == 1 ? "तेज़ हो रहा" : momCode == 2 ? "निखर रहा" : momCode == 3 ? "स्थिर" : "घट रहा"
        _lTrend   := "ट्रेंड: "
        _lAlign   := " · संरेखण "
        _lConv    := "दृढ़ता: "
        _lEff     := " · दक्षता: "
        _lMom     := "मोमेंटम: "
        _lVol     := "वॉल्यूम: "
        _lScore   := "स्कोर "
        _lAligned := "/5 संरेखित · बंद बार डेटा"
        _lBull    := "तेज़ी: +"
        _lBear    := " | मंदी: -"
        _lAct     := " | सक्रियता: "
        _lDisc    := "संरचनात्मक अवलोकन, ट्रेड सलाह नहीं"
        _cB       := "तेज़ी निरंतरता · "
        _cS       := "मंदी निरंतरता · "
        _cStr     := "पिछले से मज़बूत"
        _cWk      := "पिछले से कमज़ोर"
        _cEq      := "पिछले के बराबर"
    else if lang == "日本語"
        _head     := kind > 0 ? "強気コンフルエンス — しきい値を突破" : kind < 0 ? "弱気コンフルエンス — しきい値を突破" : "迷い — しきい値で強気と弱気が拮抗"
        _trN      := sigCode == 5 ? "強い上昇トレンド" : sigCode == 6 ? "強い下降トレンド" : sigCode == 7 ? "隠れた強気バイアス" : sigCode == 8 ? "隠れた弱気バイアス" : sigCode == 9 ? "上昇トレンド継続中" : "下降トレンド継続中"
        _cvN      := convCode == 1 ? "高" : convCode == 2 ? "中" : "低"
        _moN      := momCode == 1 ? "加速中" : momCode == 2 ? "改善中" : momCode == 3 ? "安定" : "低下中"
        _lTrend   := "トレンド: "
        _lAlign   := " · アライメント "
        _lConv    := "確信: "
        _lEff     := " · 効率: "
        _lMom     := "モメンタム: "
        _lVol     := "出来高: "
        _lScore   := "スコア "
        _lAligned := "/5 一致 · 確定足データ"
        _lBull    := "強気: +"
        _lBear    := " | 弱気: -"
        _lAct     := " | 活性度: "
        _lDisc    := "構造的観察であり、取引助言ではありません"
        _cB       := "強気の継続 · "
        _cS       := "弱気の継続 · "
        _cStr     := "前回より強い"
        _cWk      := "前回より弱い"
        _cEq      := "前回と同等"
    else if lang == "简体中文"
        _head     := kind > 0 ? "看涨共振 — 已突破阈值" : kind < 0 ? "看跌共振 — 已突破阈值" : "犹豫 — 多空在阈值处持平"
        _trN      := sigCode == 5 ? "强劲上升趋势" : sigCode == 6 ? "强劲下降趋势" : sigCode == 7 ? "隐性看涨倾向" : sigCode == 8 ? "隐性看跌倾向" : sigCode == 9 ? "上升趋势活跃" : "下降趋势活跃"
        _cvN      := convCode == 1 ? "高" : convCode == 2 ? "中" : "低"
        _moN      := momCode == 1 ? "加速中" : momCode == 2 ? "改善中" : momCode == 3 ? "平稳" : "衰减中"
        _lTrend   := "趋势: "
        _lAlign   := " · 对齐 "
        _lConv    := "信念: "
        _lEff     := " · 效率: "
        _lMom     := "动量: "
        _lVol     := "成交量: "
        _lScore   := "评分 "
        _lAligned := "/5 一致 · 已收盘数据"
        _lBull    := "多: +"
        _lBear    := " | 空: -"
        _lAct     := " | 活跃度: "
        _lDisc    := "结构性观察，并非交易建议"
        _cB       := "看涨延续 · "
        _cS       := "看跌延续 · "
        _cStr     := "强于前一次"
        _cWk      := "弱于前一次"
        _cEq      := "与前一次持平"
    else
        _head     := kind > 0 ? "BULLISH CONFLUENCE — THRESHOLD CROSSED" : kind < 0 ? "BEARISH CONFLUENCE — THRESHOLD CROSSED" : "INDECISION — BULL AND BEAR TIED AT THRESHOLD"
        _trN      := sigCode == 5 ? "Strong Uptrend" : sigCode == 6 ? "Strong Downtrend" : sigCode == 7 ? "Hidden Bullish Bias" : sigCode == 8 ? "Hidden Bearish Bias" : sigCode == 9 ? "Uptrend Active" : "Downtrend Active"
        _cvN      := convCode == 1 ? "HIGH" : convCode == 2 ? "MODERATE" : "LOW"
        _moN      := momCode == 1 ? "Accelerating" : momCode == 2 ? "Sharpening" : momCode == 3 ? "Steady" : "Fading"
        _lTrend   := "Trend: "
        _lAlign   := " · Align "
        _lConv    := "Conviction: "
        _lEff     := " · Efficiency: "
        _lMom     := "Momentum: "
        _lVol     := "Volume: "
        _lScore   := "Score "
        _lAligned := "/5 aligned · closed-bar data"
        _lBull    := "Bull: +"
        _lBear    := " | Bear: -"
        _lAct     := " | Activity: "
        _lDisc    := "Structural observation, not trade advice"
        _cB       := "Bullish continuation · "
        _cS       := "Bearish continuation · "
        _cStr     := "stronger than previous"
        _cWk      := "weaker than previous"
        _cEq      := "equal than previous"
    string _tip = _head
         + "\n" + _lTrend + _trN + _lAlign + (align >= 0 ? "+" : "") + str.tostring(align)
         + "\n" + _lConv + _cvN + _lEff + coupName
         + "\n" + _lMom + _moN
         + "\n" + _lVol + volName
         + "\n" + _lScore + (score >= 0 ? "+" : "") + str.tostring(score, "#") + " · " + str.tostring(consensus) + _lAligned
         + "\n" + _lBull + str.tostring(bullScr, "#") + _lBear + str.tostring(bearScr, "#") + _lAct + str.tostring(trace, "#.#") + "/5"
         + "\n" + _lDisc
    if contDir != 0
        _tip += "\n" + (contDir > 0 ? _cB : _cS) + (domScr > prevScr ? _cStr : domScr < prevScr ? _cWk : _cEq) + " (" + str.tostring(domScr, "#") + " vs " + str.tostring(prevScr, "#") + ")"
    _tip

// ══════════════════════════════════════════════════════════════════════════════════
// 11. f_rvTip — Reversal (REV) label tooltip (chart labels)
// Replaces the inline English _rvTip construction in the REVERSAL & TREND STATE
// ENGINE event renderer. English output is byte-identical to the inline strings.
// The REV label text itself stays untranslated (compact chart code, same policy as
// S12/S13). Class 2 resolves by direction: Accumulation (bull) / Distribution (bear).
// ══════════════════════════════════════════════════════════════════════════════════

// @function Builds the reversal (REV) label tooltip for chart labels.
// @param bull True for a bullish reversal, false for a bearish one.
// @param rvClass Classifier class: 1 Climactic, 2 Accumulation (bull) / Distribution (bear), 3 Exhaustion, 4 Rotation.
// @param prevPeak Peak |score| of the finished episode (depth feature).
// @param vel First-order score difference on the reversal bar (crossing velocity).
// @param score Composite pressure score on the reversal bar.
// @param lang The dashboard language selected by the user.
// @returns The complete multi-line tooltip string.
export f_rvTip(bool bull, int rvClass, float prevPeak, float vel, float score, string lang) =>
    string _hB = "",     string _hS = ""
    string _nm = "",     string _lDepth = ""
    string _lVel = "",   string _lNow = ""
    string _lDisc = ""
    if lang == "Türkçe"
        _hB     := "BOĞA DÖNÜŞÜ — "
        _hS     := "AYI DÖNÜŞÜ — "
        _nm     := rvClass == 1 ? "KLİMAKS" : rvClass == 2 ? (bull ? "TOPLAMA" : "DAĞITIM") : rvClass == 3 ? "TÜKENME" : "ROTASYON"
        _lDepth := "Önceki dönem derinliği: "
        _lVel   := "Geçiş hızı: "
        _lNow   := "Şu anki puan: "
        _lDisc  := "Yapısal gözlem, işlem tavsiyesi değildir"
    else if lang == "العربية"
        _hB     := "انعكاس صعودي — "
        _hS     := "انعكاس هبوطي — "
        _nm     := rvClass == 1 ? "ذروة" : rvClass == 2 ? (bull ? "تجميع" : "تصريف") : rvClass == 3 ? "إرهاق" : "تدوير"
        _lDepth := "عمق الفترة السابقة: "
        _lVel   := "سرعة العبور: "
        _lNow   := "الدرجة الآن: "
        _lDisc  := "ملاحظة هيكلية، وليست نصيحة تداول"
    else if lang == "Italiano"
        _hB     := "INVERSIONE RIALZISTA — "
        _hS     := "INVERSIONE RIBASSISTA — "
        _nm     := rvClass == 1 ? "CLIMAX" : rvClass == 2 ? (bull ? "ACCUMULAZIONE" : "DISTRIBUZIONE") : rvClass == 3 ? "ESAURIMENTO" : "ROTAZIONE"
        _lDepth := "Profondità dell'episodio precedente: "
        _lVel   := "Velocità di attraversamento: "
        _lNow   := "Punteggio attuale: "
        _lDisc  := "Osservazione strutturale, non un consiglio di trading"
    else if lang == "हिन्दी"
        _hB     := "तेज़ी पलटाव — "
        _hS     := "मंदी पलटाव — "
        _nm     := rvClass == 1 ? "क्लाइमेक्स" : rvClass == 2 ? (bull ? "संचय" : "वितरण") : rvClass == 3 ? "थकावट" : "रोटेशन"
        _lDepth := "पिछली अवधि की गहराई: "
        _lVel   := "क्रॉसिंग वेग: "
        _lNow   := "वर्तमान स्कोर: "
        _lDisc  := "संरचनात्मक अवलोकन, ट्रेड सलाह नहीं"
    else if lang == "日本語"
        _hB     := "強気反転 — "
        _hS     := "弱気反転 — "
        _nm     := rvClass == 1 ? "クライマックス" : rvClass == 2 ? (bull ? "買い集め" : "売り抜け") : rvClass == 3 ? "枯渇" : "ローテーション"
        _lDepth := "前局面の深さ: "
        _lVel   := "クロス速度: "
        _lNow   := "現在のスコア: "
        _lDisc  := "構造的観察であり、取引助言ではありません"
    else if lang == "简体中文"
        _hB     := "看涨反转 — "
        _hS     := "看跌反转 — "
        _nm     := rvClass == 1 ? "高潮" : rvClass == 2 ? (bull ? "吸筹" : "派发") : rvClass == 3 ? "衰竭" : "轮动"
        _lDepth := "前一阶段深度: "
        _lVel   := "穿越速度: "
        _lNow   := "当前评分: "
        _lDisc  := "结构性观察，并非交易建议"
    else
        _hB     := "BULLISH REVERSAL — "
        _hS     := "BEARISH REVERSAL — "
        _nm     := rvClass == 1 ? "CLIMACTIC" : rvClass == 2 ? (bull ? "ACCUMULATION" : "DISTRIBUTION") : rvClass == 3 ? "EXHAUSTION" : "ROTATION"
        _lDepth := "Prior episode depth: "
        _lVel   := "Cross velocity: "
        _lNow   := "Score now: "
        _lDisc  := "Structural observation, not trade advice"
    (bull ? _hB : _hS) + _nm
         + "\n" + _lDepth + str.tostring(prevPeak, "#")
         + "\n" + _lVel + (vel >= 0 ? "+" : "") + str.tostring(vel, "#.#")
         + "\n" + _lNow + (score >= 0 ? "+" : "") + str.tostring(score, "#")
         + "\n" + _lDisc

// ══════════════════════════════════════════════════════════════════════════════════
// 12. f_rtTip — Trend confirmation (TREND) label tooltip (chart labels)
// Replaces the inline English _rtTip construction in the REVERSAL & TREND STATE
// ENGINE event renderer. English output is byte-identical to the inline strings.
// The ▲ TREND / ▼ TREND label text itself stays untranslated (compact chart code).
// ══════════════════════════════════════════════════════════════════════════════════

// @function Builds the trend confirmation (TREND) label tooltip for chart labels.
// @param bull True for a bullish trend confirmation, false for a bearish one.
// @param score Composite pressure score on the confirmation bar.
// @param trendTh Trend Confirmation Level (the user's RS_TREND_TH input).
// @param bars Bars elapsed since the reversal that opened the episode.
// @param lang The dashboard language selected by the user.
// @returns The complete multi-line tooltip string.
export f_rtTip(bool bull, float score, float trendTh, int bars, string lang) =>
    string _hB = "",      string _hS = ""
    string _lReach = "",  string _lTh = ""
    string _lBars = "",   string _lActive = ""
    string _lDisc = ""
    if lang == "Türkçe"
        _hB      := "BOĞA TRENDİ TESPİT EDİLDİ"
        _hS      := "AYI TRENDİ TESPİT EDİLDİ"
        _lReach  := "Ulaşılan puan: "
        _lTh     := " (eşik "
        _lBars   := "Dönüşten bu yana bar sayısı: "
        _lActive := "Bir sonraki karşı dönüşe kadar aktif"
        _lDisc   := "Yapısal gözlem, işlem tavsiyesi değildir"
    else if lang == "العربية"
        _hB      := "تم رصد اتجاه صعودي"
        _hS      := "تم رصد اتجاه هبوطي"
        _lReach  := "وصلت الدرجة إلى "
        _lTh     := " (العتبة "
        _lBars   := "عدد الشموع منذ الانعكاس: "
        _lActive := "نشط حتى الانعكاس المعاكس التالي"
        _lDisc   := "ملاحظة هيكلية، وليست نصيحة تداول"
    else if lang == "Italiano"
        _hB      := "TREND RIALZISTA RILEVATO"
        _hS      := "TREND RIBASSISTA RILEVATO"
        _lReach  := "Punteggio raggiunto: "
        _lTh     := " (soglia "
        _lBars   := "Barre dall'inversione: "
        _lActive := "Attivo fino alla prossima inversione opposta"
        _lDisc   := "Osservazione strutturale, non un consiglio di trading"
    else if lang == "हिन्दी"
        _hB      := "तेज़ी ट्रेंड का पता चला"
        _hS      := "मंदी ट्रेंड का पता चला"
        _lReach  := "स्कोर पहुँचा: "
        _lTh     := " (सीमा "
        _lBars   := "पलटाव के बाद बार: "
        _lActive := "अगले विपरीत पलटाव तक सक्रिय"
        _lDisc   := "संरचनात्मक अवलोकन, ट्रेड सलाह नहीं"
    else if lang == "日本語"
        _hB      := "強気トレンドを検出"
        _hS      := "弱気トレンドを検出"
        _lReach  := "スコア到達: "
        _lTh     := " (しきい値 "
        _lBars   := "反転からのバー数: "
        _lActive := "次の反対方向の反転まで有効"
        _lDisc   := "構造的観察であり、取引助言ではありません"
    else if lang == "简体中文"
        _hB      := "检测到看涨趋势"
        _hS      := "检测到看跌趋势"
        _lReach  := "评分达到 "
        _lTh     := " (阈值 "
        _lBars   := "反转以来K线数: "
        _lActive := "在下一次反向反转前保持有效"
        _lDisc   := "结构性观察，并非交易建议"
    else
        _hB      := "BULLISH TREND DETECTED"
        _hS      := "BEARISH TREND DETECTED"
        _lReach  := "Score reached "
        _lTh     := " (threshold "
        _lBars   := "Bars since reversal: "
        _lActive := "Active until the next opposite reversal"
        _lDisc   := "Structural observation, not trade advice"
    (bull ? _hB : _hS)
         + "\n" + _lReach + (score >= 0 ? "+" : "") + str.tostring(score, "#") + _lTh + str.tostring(trendTh, "#") + ")"
         + "\n" + _lBars + str.tostring(bars)
         + "\n" + _lActive
         + "\n" + _lDisc

