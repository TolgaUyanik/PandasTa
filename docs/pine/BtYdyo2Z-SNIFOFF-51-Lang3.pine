// ══════════════════════════════════════════════════════════════════════════════════
// 6. f_tfNarrative — Trade Finder narrative builder
// Replaces the inline _tfNarrTxt TEMP-EN chain plus the S12/S13 override texts.
// State codes 1..8 mirror _tfState; 9 and 10 are the desktop footprint overrides:
//   1 Strong Bullish · 2 Strong Bearish · 3 Bullish Lean · 4 Bearish Lean ·
//   5 Choppy · 6 Mixed Signals · 7 Reversal Watch ▲ · 8 Reversal Watch ▼ ·
//   9 Capitulation (S12 evidence) · 10 Exhaustion (S13 evidence)
// English output is byte-identical to the current inline strings.
// ══════════════════════════════════════════════════════════════════════════════════

// @function Builds the Trade Finder narrative row text.
// @param state State code 1..10 (see section header for the mapping).
// @param dir Composite pressure direction (+1 bullish, -1 bearish, 0 flat).
// @param consensus Number of dimensions agreeing with the composite direction (0-5).
// @param lang The dashboard language selected by the user.
// @returns The narrative string for the Trade Finder dashboard row.
export f_tfNarrative(int state, int dir, int consensus, string lang) =>
    string _n = ""
    if lang == "Türkçe"
        if state == 9
            _n := "3+ ayak izi ölçeğinde satış teslimiyeti.\nDüşüş trendi yapısı tükeniyor olabilir."
        else if state == 10
            _n := "3+ ayak izi ölçeğinde alış tükenmesi.\nYükseliş trendi yapısı tükeniyor olabilir."
        else if state <= 2
            _n := (dir > 0 ? "Boğa" : "Ayı") + " baskısı: " + str.tostring(consensus) + "/5 boyut hemfikir.\nİzleyin: delta dönüşü veya M4 zayıflaması."
        else if state <= 4
            _n := (dir > 0 ? "Boğa" : "Ayı") + " eğilimi\n— henüz tüm boyutlar teyit etmiyor."
        else if state == 5
            _n := "Boyutlar arasında uzlaşı yok."
        else if state == 6
            _n := "Boyutlar çelişiyor\n— trend-hacim çatışması veya karşıtlık/sapma aktif."
        else
            _n := (state == 7 ? "Boğa" : "Ayı") + " CASCADE\n— yapısal bir dönüş oluşuyor olabilir."
    else if lang == "العربية"
        if state == 9
            _n := "استسلام بيعي على 3+ من مقاييس البصمة.\nهيكل الاتجاه الهبوطي قد يقترب من الاستنفاد."
        else if state == 10
            _n := "إرهاق شرائي على 3+ من مقاييس البصمة.\nهيكل الاتجاه الصعودي قد يقترب من الاستنفاد."
        else if state <= 2
            _n := "ضغط " + (dir > 0 ? "صعودي" : "هبوطي") + ": " + str.tostring(consensus) + "/5 أبعاد متفقة.\nراقب: انقلاب الدلتا أو تراجع M4."
        else if state <= 4
            _n := "ميل " + (dir > 0 ? "صعودي" : "هبوطي") + "\n— ليست كل الأبعاد تؤكد بعد."
        else if state == 5
            _n := "لا إجماع بين الأبعاد."
        else if state == 6
            _n := "الأبعاد متضاربة\n— تعارض اتجاه وحجم أو معاكسة/تباين نشط."
        else
            _n := (state == 7 ? "CASCADE صعودي" : "CASCADE هبوطي") + "\n— انعكاس هيكلي قد يتشكل."
    else if lang == "Italiano"
        if state == 9
            _n := "Capitolazione di vendita su 3+ scale del footprint.\nLa struttura del downtrend potrebbe esaurirsi."
        else if state == 10
            _n := "Esaurimento degli acquisti su 3+ scale del footprint.\nLa struttura dell'uptrend potrebbe esaurirsi."
        else if state <= 2
            _n := "Pressione " + (dir > 0 ? "rialzista" : "ribassista") + ": " + str.tostring(consensus) + "/5 dimensioni concordi.\nOsserva: inversione del delta o indebolimento M4."
        else if state <= 4
            _n := "Inclinazione " + (dir > 0 ? "rialzista" : "ribassista") + "\n— non tutte le dimensioni confermano ancora."
        else if state == 5
            _n := "Nessun consenso tra le dimensioni."
        else if state == 6
            _n := "Le dimensioni sono in conflitto\n— trend contro volume oppure contromossa/divergenza attiva."
        else
            _n := "CASCADE " + (state == 7 ? "rialzista" : "ribassista") + "\n— potrebbe formarsi un'inversione strutturale."
    else if lang == "हिन्दी"
        if state == 9
            _n := "3+ फुटप्रिंट पैमानों पर बिक्री समर्पण.\nडाउनट्रेंड संरचना थक रही हो सकती है."
        else if state == 10
            _n := "3+ फुटप्रिंट पैमानों पर खरीद थकावट.\nअपट्रेंड संरचना थक रही हो सकती है."
        else if state <= 2
            _n := (dir > 0 ? "तेज़ी" : "मंदी") + " दबाव: " + str.tostring(consensus) + "/5 आयाम सहमत.\nनज़र रखें: डेल्टा पलटाव या M4 कमज़ोरी."
        else if state <= 4
            _n := (dir > 0 ? "तेज़ी" : "मंदी") + " झुकाव\n— अभी सभी आयाम पुष्टि नहीं करते."
        else if state == 5
            _n := "आयामों के बीच कोई सहमति नहीं."
        else if state == 6
            _n := "आयाम टकरा रहे हैं\n— ट्रेंड बनाम वॉल्यूम या प्रतिकूल चाल/विचलन सक्रिय."
        else
            _n := (state == 7 ? "तेज़ी" : "मंदी") + " CASCADE\n— संरचनात्मक पलटाव बन सकता है."
    else if lang == "日本語"
        if state == 9
            _n := "3以上のフットプリント尺度で投げ売り。\n下降トレンド構造は枯渇しつつある可能性。"
        else if state == 10
            _n := "3以上のフットプリント尺度で買い疲れ。\n上昇トレンド構造は枯渇しつつある可能性。"
        else if state <= 2
            _n := (dir > 0 ? "強気" : "弱気") + "圧力: " + str.tostring(consensus) + "/5次元が一致。\n注視: デルタ反転またはM4減衰。"
        else if state <= 4
            _n := (dir > 0 ? "強気" : "弱気") + "傾向\n— まだ全次元が確認していません。"
        else if state == 5
            _n := "次元間のコンセンサスなし。"
        else if state == 6
            _n := "次元が対立\n— トレンド対出来高、または逆行/乖離が有効。"
        else
            _n := (state == 7 ? "強気" : "弱気") + " CASCADE\n— 構造的反転が形成中の可能性。"
    else if lang == "简体中文"
        if state == 9
            _n := "3个以上足迹尺度出现恐慌抛售。\n下跌趋势结构可能正在衰竭。"
        else if state == 10
            _n := "3个以上足迹尺度出现买盘衰竭。\n上涨趋势结构可能正在衰竭。"
        else if state <= 2
            _n := (dir > 0 ? "看涨" : "看跌") + "压力: " + str.tostring(consensus) + "/5个维度一致。\n关注: Delta翻转或M4衰减。"
        else if state <= 4
            _n := (dir > 0 ? "看涨" : "看跌") + "倾向\n— 尚未获得所有维度确认。"
        else if state == 5
            _n := "各维度之间没有共识。"
        else if state == 6
            _n := "维度相互冲突\n— 趋势与成交量相悖，或逆向/背离生效。"
        else
            _n := (state == 7 ? "看涨" : "看跌") + " CASCADE\n— 结构性反转可能正在形成。"
    else
        if state == 9
            _n := "Selling capitulation on 3+ footprint scales.\nDowntrend structure may be exhausting."
        else if state == 10
            _n := "Buying exhaustion on 3+ footprint scales.\nUptrend structure may be exhausting."
        else if state <= 2
            _n := (dir > 0 ? "Bullish" : "Bearish") + " pressure: " + str.tostring(consensus) + "/5 dimensions agree.\nWatch: delta flip or M4 fade."
        else if state <= 4
            _n := (dir > 0 ? "Bullish" : "Bearish") + " lean\n— not all dimensions confirm yet."
        else if state == 5
            _n := "No consensus across dimensions."
        else if state == 6
            _n := "Dimensions conflict\n— trend vs volume or counter/divergence active."
        else
            _n := (state == 7 ? "Bullish" : "Bearish") + " CASCADE\n— structural reversal may be forming."
    _n

// ══════════════════════════════════════════════════════════════════════════════════
// 7. f_trTipTf — Trade Finder + Signal Health tooltips (12 keys)
// Trade Finder keys (7): tf_title, tf_badge, tf_state, tf_score, tf_cons, tf_watch, tf_narr
// Signal Health keys (5): sh_title, sh_badge, sh_state, sh_score, sh_dom
// English text is byte-identical to the current inline tooltips in the indicator.
// ══════════════════════════════════════════════════════════════════════════════════

// @function Returns translated tooltip text for Trade Finder and Signal Health cells.
// @param key Tooltip key identifier (see section header for valid keys).
// @param lang The dashboard language selected by the user.
// @returns The translated tooltip string. Empty string for unknown keys.
export f_trTipTf(string key, string lang) =>
    if lang == "Türkçe"
        switch key
            "tf_title" => "Trend, Hacim, Verimlilik, Kararlılık ve Momentumu tek bir bileşik baskı okumasında sentezler"
            "tf_badge" => "Trade Finder aktif ve tüm sinyal boyutlarını işliyor"
            "tf_state" => "Trend, Hacim, Verimlilik, Kararlılık ve Momentum boyutlarından sentezlenmiş piyasa durumu"
            "tf_score" => "Bileşik baskı puanı: -100 (maksimum ayı) ile +100 (maksimum boğa) arası. 5 boyutun ağırlıklı toplamı"
            "tf_cons"  => "Boyut uzlaşısı: 5 boyuttan kaçının bileşik yönle hemfikir olduğu"
            "tf_watch" => "İzlenecek kilit faktör: Trend↔Hacim = trend ve hacim uyuşmuyor, Hacim Sapması = hacim azalıyor, Karşıtlık = güçlü karşı hareket, Verim Düşüyor = hareket kalitesi geriliyor"
            "tf_narr"  => "Mevcut durumun anlamı ve onu neyin değiştirebileceği"
            "sh_title" => "Açık mumun son çakışma dönemine karşı gerçek zamanlı kontrolü. Değerler geçicidir ve mum kapanana kadar değişebilir — asla etiket veya alarmlar için kullanılmaz."
            "sh_badge" => "Bu satır açık mumda tik tik güncellenir ve kapanışta kilitlenir (Canlı İstisna protokolü)"
            "sh_state" => "Oluşan mum, son basılan çakışma yönünü doğruluyor mu yoksa onunla savaşıyor mu?"
            "sh_score" => "Açık mumun anlık harmanlanmış bileşik puanı (geçici)"
            "sh_dom"   => "Aktif dönem yönünün baskın taraf harmanlanmış puanı (geçici)"
            => ""
    else if lang == "العربية"
        switch key
            "tf_title" => "يولّف الاتجاه والحجم والكفاءة والقناعة والزخم في قراءة ضغط مركبة واحدة"
            "tf_badge" => "Trade Finder نشط ويعالج جميع أبعاد الإشارة"
            "tf_state" => "حالة السوق المولّفة من أبعاد الاتجاه والحجم والكفاءة والقناعة والزخم"
            "tf_score" => "درجة الضغط المركبة: من -100 (أقصى هبوط) إلى +100 (أقصى صعود). مجموع مرجّح لخمسة أبعاد"
            "tf_cons"  => "إجماع الأبعاد: كم بُعداً من 5 يتفق مع الاتجاه المركب"
            "tf_watch" => "العامل الرئيسي للمراقبة: اتجاه↔حجم = الاتجاه والحجم لا يتفقان، تباين الحجم = الحجم يتراجع، معاكسة = حركة معاكسة قوية، الكفاءة تتراجع = جودة الحركة تنخفض"
            "tf_narr"  => "ماذا تعني الحالة الحالية وما الذي قد يغيّرها"
            "sh_title" => "فحص فوري للشمعة المفتوحة مقابل آخر فترة التقاء. القيم مؤقتة وقد تتغير حتى إغلاق الشمعة — لا تُستخدم أبداً للعلامات أو التنبيهات."
            "sh_badge" => "هذا الصف يُحدَّث لحظة بلحظة على الشمعة المفتوحة ويُقفل عند الإغلاق (بروتوكول الاستثناء المباشر)"
            "sh_state" => "هل الشمعة قيد التكوين تؤكد آخر اتجاه التقاء مطبوع أم تقاومه؟"
            "sh_score" => "الدرجة المركبة الممزوجة اللحظية للشمعة المفتوحة (مؤقتة)"
            "sh_dom"   => "درجة الجانب المهيمن الممزوجة لاتجاه الفترة النشطة (مؤقتة)"
            => ""
    else if lang == "Italiano"
        switch key
            "tf_title" => "Sintetizza Trend, Volume, Efficienza, Convinzione e Momentum in un'unica lettura composita della pressione"
            "tf_badge" => "Trade Finder è attivo ed elabora tutte le dimensioni del segnale"
            "tf_state" => "Stato di mercato sintetizzato dalle dimensioni Trend, Volume, Efficienza, Convinzione e Momentum"
            "tf_score" => "Punteggio di pressione composito: da -100 (massimo ribassista) a +100 (massimo rialzista). Somma ponderata di 5 dimensioni"
            "tf_cons"  => "Consenso delle dimensioni: quante delle 5 dimensioni concordano con la direzione composita"
            "tf_watch" => "Fattore chiave da osservare: Trend↔Volume = trend e volume in disaccordo, Diverg. Volume = volume in calo, Contromossa = forte movimento opposto, Efficienza in Calo = qualità del movimento in diminuzione"
            "tf_narr"  => "Cosa significa lo stato attuale e cosa potrebbe cambiarlo"
            "sh_title" => "Controllo in tempo reale della candela aperta rispetto all'ultimo episodio di confluenza. I valori sono provvisori e possono cambiare fino alla chiusura della candela — mai usati per etichette o alert."
            "sh_badge" => "Questa riga si aggiorna tick per tick sulla candela aperta e si blocca alla chiusura (protocollo Eccezione Live)"
            "sh_state" => "La candela in formazione conferma o contrasta l'ultima direzione di confluenza stampata?"
            "sh_score" => "Punteggio composito miscelato in tempo reale della candela aperta (provvisorio)"
            "sh_dom"   => "Punteggio miscelato del lato dominante della direzione dell'episodio attivo (provvisorio)"
            => ""
    else if lang == "हिन्दी"
        switch key
            "tf_title" => "ट्रेंड, वॉल्यूम, दक्षता, दृढ़ता और मोमेंटम को एक संयुक्त दबाव रीडिंग में संश्लेषित करता है"
            "tf_badge" => "Trade Finder सक्रिय है और सभी सिग्नल आयामों को संसाधित कर रहा है"
            "tf_state" => "ट्रेंड, वॉल्यूम, दक्षता, दृढ़ता और मोमेंटम आयामों से संश्लेषित बाज़ार स्थिति"
            "tf_score" => "संयुक्त दबाव स्कोर: -100 (अधिकतम मंदी) से +100 (अधिकतम तेज़ी) तक. 5 आयामों का भारित योग"
            "tf_cons"  => "आयाम सहमति: 5 में से कितने आयाम संयुक्त दिशा से सहमत हैं"
            "tf_watch" => "देखने योग्य मुख्य कारक: ट्रेंड↔वॉल्यूम = ट्रेंड और वॉल्यूम असहमत, वॉल्यूम विचलन = वॉल्यूम घट रहा, प्रतिकूल चाल = मज़बूत विपरीत चाल, दक्षता घट रही = चाल की गुणवत्ता गिर रही"
            "tf_narr"  => "मौजूदा स्थिति का अर्थ और उसे क्या बदल सकता है"
            "sh_title" => "खुली कैंडल की अंतिम संगम अवधि से वास्तविक-समय जाँच. मान अस्थायी हैं और कैंडल बंद होने तक बदल सकते हैं — लेबल या अलर्ट के लिए कभी उपयोग नहीं होते."
            "sh_badge" => "यह पंक्ति खुली कैंडल पर टिक-दर-टिक अपडेट होती है और बंद होने पर लॉक हो जाती है (लाइव अपवाद प्रोटोकॉल)"
            "sh_state" => "क्या बन रही कैंडल अंतिम मुद्रित संगम दिशा की पुष्टि कर रही है या उससे लड़ रही है?"
            "sh_score" => "खुली कैंडल का तात्कालिक मिश्रित संयुक्त स्कोर (अस्थायी)"
            "sh_dom"   => "सक्रिय अवधि की दिशा का प्रभावी-पक्ष मिश्रित स्कोर (अस्थायी)"
            => ""
    else if lang == "日本語"
        switch key
            "tf_title" => "トレンド、出来高、効率、確信、モメンタムを一つの複合圧力リーディングに統合します"
            "tf_badge" => "Trade Finderは有効で、全てのシグナル次元を処理しています"
            "tf_state" => "トレンド、出来高、効率、確信、モメンタムの各次元から統合された市場状態"
            "tf_score" => "複合圧力スコア: -100(最大弱気)から+100(最大強気)まで。5次元の加重合計"
            "tf_cons"  => "次元コンセンサス: 5次元のうち複合方向に一致する数"
            "tf_watch" => "注視すべき主要因: トレンド↔出来高 = トレンドと出来高が不一致、出来高乖離 = 出来高が減少、逆行 = 強い反対方向の動き、効率低下 = 値動きの質が低下"
            "tf_narr"  => "現在の状態の意味と、それを変えうる要因"
            "sh_title" => "確定前の足を直近のコンフルエンス局面と照合するリアルタイムチェック。値は暫定で、足が確定するまで変化します — ラベルやアラートには一切使用されません。"
            "sh_badge" => "この行は未確定足でティックごとに更新され、確定時にロックされます(ライブ例外プロトコル)"
            "sh_state" => "形成中の足は、直近に確定したコンフルエンス方向を支持していますか、それとも逆らっていますか?"
            "sh_score" => "未確定足のリアルタイム混合複合スコア(暫定)"
            "sh_dom"   => "有効な局面方向の優勢側混合スコア(暫定)"
            => ""
    else if lang == "简体中文"
        switch key
            "tf_title" => "将趋势、成交量、效率、信念与动量综合为单一复合压力读数"
            "tf_badge" => "Trade Finder已启用，正在处理所有信号维度"
            "tf_state" => "由趋势、成交量、效率、信念与动量维度综合而成的市场状态"
            "tf_score" => "复合压力评分: -100(最大看跌)至+100(最大看涨)。5个维度的加权和"
            "tf_cons"  => "维度共识: 5个维度中有多少与复合方向一致"
            "tf_watch" => "需关注的关键因素: 趋势↔成交量 = 趋势与成交量不一致，量能背离 = 成交量下降，逆向冲击 = 强劲反向行情，效率衰减 = 行情质量下降"
            "tf_narr"  => "当前状态的含义以及可能改变它的因素"
            "sh_title" => "将未收盘K线与最近一次共振阶段进行实时核对。数值为暂定，K线收盘前可能变化 — 绝不用于标签或警报。"
            "sh_badge" => "该行在未收盘K线上逐笔更新，收盘时锁定(实时例外协议)"
            "sh_state" => "正在形成的K线是在确认还是在对抗最近打印的共振方向?"
            "sh_score" => "未收盘K线的实时混合复合评分(暂定)"
            "sh_dom"   => "活跃阶段方向的主导方混合评分(暂定)"
            => ""
    else
        switch key
            "tf_title" => "Synthesizes Trend, Volume, Efficiency, Conviction and Momentum into one composite pressure read"
            "tf_badge" => "Trade Finder is active and processing all signal dimensions"
            "tf_state" => "Synthesized market state from Trend, Volume, Efficiency, Conviction, and Momentum dimensions"
            "tf_score" => "Composite pressure score: -100 (max bearish) to +100 (max bullish). Weighted sum of 5 dimensions"
            "tf_cons"  => "Dimension consensus: how many of 5 dimensions agree with the composite direction"
            "tf_watch" => "Key factor to watch: Trend↔Vol = trend and volume disagree, Vol Diverg = volume declining, Counter = strong opposing move, Eff Fading = move quality dropping"
            "tf_narr"  => "What the current state means and what could change it"
            "sh_title" => "Real-time check of the open bar against the last confluence episode. Values are provisional and can change until the bar closes — never used for labels or alerts."
            "sh_badge" => "This row updates tick by tick on the open bar and locks at the close (Live Exception protocol)"
            "sh_state" => "Is the forming bar confirming or fighting the last printed confluence direction?"
            "sh_score" => "In-flight blended composite score of the open bar (provisional)"
            "sh_dom"   => "Dominant-side blended score of the active episode direction (provisional)"
            => ""

// ══════════════════════════════════════════════════════════════════════════════════
// 8. f_trInline3 — Helper affixes for composed cell strings (4 keys)
// agree_sfx → watch cell "N/5 agree" suffix
// live_sfx  → Signal Health score " live" suffix
// bull_pfx / bear_pfx → Signal Health dominant-side "Bull +" / "Bear -" prefixes
// ══════════════════════════════════════════════════════════════════════════════════

// @function Returns translated helper affixes used inside composed dashboard strings.
// @param key Affix key identifier: agree_sfx, live_sfx, bull_pfx, bear_pfx.
// @param lang The dashboard language selected by the user.
// @returns The translated affix string. Empty string for unknown keys.
export f_trInline3(string key, string lang) =>
    if lang == "Türkçe"
        switch key
            "agree_sfx" => "/5 hemfikir"
            "live_sfx"  => " canlı"
            "bull_pfx"  => "Boğa +"
            "bear_pfx"  => "Ayı -"
            => ""
    else if lang == "العربية"
        switch key
            "agree_sfx" => "/5 متفقة"
            "live_sfx"  => " مباشر"
            "bull_pfx"  => "صعود +"
            "bear_pfx"  => "هبوط -"
            => ""
    else if lang == "Italiano"
        switch key
            "agree_sfx" => "/5 concordi"
            "live_sfx"  => " live"
            "bull_pfx"  => "Toro +"
            "bear_pfx"  => "Orso -"
            => ""
    else if lang == "हिन्दी"
        switch key
            "agree_sfx" => "/5 सहमत"
            "live_sfx"  => " लाइव"
            "bull_pfx"  => "तेज़ी +"
            "bear_pfx"  => "मंदी -"
            => ""
    else if lang == "日本語"
        switch key
            "agree_sfx" => "/5 一致"
            "live_sfx"  => " ライブ"
            "bull_pfx"  => "強気 +"
            "bear_pfx"  => "弱気 -"
            => ""
    else if lang == "简体中文"
        switch key
            "agree_sfx" => "/5 一致"
            "live_sfx"  => " 实时"
            "bull_pfx"  => "多 +"
            "bear_pfx"  => "空 -"
            => ""
    else
        switch key
            "agree_sfx" => "/5 agree"
            "live_sfx"  => " live"
            "bull_pfx"  => "Bull +"
            "bear_pfx"  => "Bear -"
            => ""

// ══════════════════════════════════════════════════════════════════════════════════
// 9. f_trTipFp3 — Native footprint display texts (4 keys)
// Covers the Native-specific strings added in ST-EP 6.3 Round 4: title tooltip,
// lock message, lock row tooltip, badge tooltip. Geometry/Intrabar strings stay
// with Lang/Lang2. Method names (Geometry, Intrabar, Native) stay untranslated by
// design — they must match the English input dropdown options.
// Input tooltips (input.*) are out of scope: Pine requires const strings there,
// so they cannot be language-routed at runtime.
// English keys pending byte-level verification against the indicator source at
// integration time — verify and sync BEFORE publishing v1.
// ══════════════════════════════════════════════════════════════════════════════════

// @function Returns Native-footprint display texts for the dashboard.
// @param key Text key: fp_title_nat, fp_lock_nat, fp_lock_tip_nat, fp_badge_nat.
// @param lang The dashboard language selected by the user.
// @returns The translated text. Empty string for unknown keys.
export f_trTipFp3(string key, string lang) =>
    if lang == "Türkçe"
        switch key
            "fp_title_nat"    => "Yerel ayak izi: TradingView'in sunucu taraflı ayak izi motorundan tik bazlı kesin alış/satış hacmi — mevcut en hassas ayrıştırma"
            "fp_lock_nat"     => "🔒 Yerel ayak izi Premium veya Ultimate plan gerektirir"
            "fp_lock_tip_nat" => "Yerel yöntem yalnızca Premium ve Ultimate planlarda sunulan request.footprint() fonksiyonunu kullanır. Planınızı yükseltin veya ayarlardan ayak izi yöntemini Geometry ya da Intrabar olarak değiştirin"
            "fp_badge_nat"    => "Kilitli: Yerel ayak izi bir Premium/Ultimate özelliğidir. Kullanılabilir bir yöntem seçildiğinde gösterge paneli otomatik olarak devam eder"
            => ""
    else if lang == "العربية"
        switch key
            "fp_title_nat"    => "البصمة الأصلية: حجم شراء/بيع دقيق قائم على التيك من محرك البصمة على خوادم TradingView — أدق تفكيك متاح"
            "fp_lock_nat"     => "🔒 البصمة الأصلية تتطلب خطة Premium أو Ultimate"
            "fp_lock_tip_nat" => "الطريقة الأصلية تستخدم request.footprint() المتاحة في خطتي Premium وUltimate فقط. رقِّ خطتك أو غيّر طريقة البصمة إلى Geometry أو Intrabar من الإعدادات"
            "fp_badge_nat"    => "مقفل: البصمة الأصلية ميزة Premium/Ultimate. تستأنف اللوحة تلقائياً عند اختيار طريقة متاحة"
            => ""
    else if lang == "Italiano"
        switch key
            "fp_title_nat"    => "Footprint nativo: volume acquisti/vendite esatto basato sui tick dal motore footprint lato server di TradingView — la scomposizione più precisa disponibile"
            "fp_lock_nat"     => "🔒 Il footprint nativo richiede un piano Premium o Ultimate"
            "fp_lock_tip_nat" => "Il metodo Nativo usa request.footprint(), disponibile solo sui piani Premium e Ultimate. Aggiorna il piano oppure imposta il metodo footprint su Geometry o Intrabar nelle impostazioni"
            "fp_badge_nat"    => "Bloccato: il footprint nativo è una funzione Premium/Ultimate. La dashboard riprende automaticamente quando si seleziona un metodo disponibile"
            => ""
    else if lang == "हिन्दी"
        switch key
            "fp_title_nat"    => "नेटिव फुटप्रिंट: TradingView के सर्वर-साइड फुटप्रिंट इंजन से टिक-आधारित सटीक खरीद/बिक्री वॉल्यूम — उपलब्ध सबसे सटीक विभाजन"
            "fp_lock_nat"     => "🔒 नेटिव फुटप्रिंट के लिए Premium या Ultimate प्लान आवश्यक है"
            "fp_lock_tip_nat" => "नेटिव विधि request.footprint() का उपयोग करती है, जो केवल Premium और Ultimate प्लान पर उपलब्ध है. अपना प्लान अपग्रेड करें या सेटिंग्स में फुटप्रिंट विधि को Geometry या Intrabar पर बदलें"
            "fp_badge_nat"    => "लॉक: नेटिव फुटप्रिंट एक Premium/Ultimate सुविधा है. उपलब्ध विधि चुनते ही डैशबोर्ड स्वतः फिर शुरू हो जाता है"
            => ""
    else if lang == "日本語"
        switch key
            "fp_title_nat"    => "ネイティブフットプリント: TradingViewのサーバーサイドフットプリントエンジンによるティックベースの正確な買い/売り出来高 — 利用可能な最も精密な分解"
            "fp_lock_nat"     => "🔒 ネイティブフットプリントにはPremiumまたはUltimateプランが必要です"
            "fp_lock_tip_nat" => "ネイティブ方式はrequest.footprint()を使用し、PremiumおよびUltimateプランでのみ利用可能です。プランをアップグレードするか、設定でフットプリント方式をGeometryまたはIntrabarに変更してください"
            "fp_badge_nat"    => "ロック中: ネイティブフットプリントはPremium/Ultimate限定機能です。利用可能な方式を選択するとダッシュボードは自動的に再開します"
            => ""
    else if lang == "简体中文"
        switch key
            "fp_title_nat"    => "原生足迹: 来自TradingView服务器端足迹引擎的基于逐笔数据的精确买/卖成交量 — 当前可用的最精确分解"
            "fp_lock_nat"     => "🔒 原生足迹需要Premium或Ultimate套餐"
            "fp_lock_tip_nat" => "原生方式使用request.footprint()，仅在Premium和Ultimate套餐中可用。请升级套餐，或在设置中将足迹方式改为Geometry或Intrabar"
            "fp_badge_nat"    => "已锁定: 原生足迹为Premium/Ultimate专属功能。选择可用方式后，仪表盘将自动恢复"
            => ""
    else
        switch key
            "fp_title_nat"    => "Native footprint: exact tick-based buy/sell volume from TradingView's server-side footprint engine — the most precise decomposition available"
            "fp_lock_nat"     => "🔒 Native footprint requires Premium or Ultimate plan"
            "fp_lock_tip_nat" => "The Native method uses request.footprint(), available on Premium and Ultimate plans only. Upgrade your plan or switch the footprint method to Geometry or Intrabar in settings"
            "fp_badge_nat"    => "Locked: Native footprint is a Premium/Ultimate feature. The dashboard resumes automatically when an available method is selected"
            => ""

// ══════════════════════════════════════════════════════════════════════════════════
// CHART-MARK TOOLTIPS (added in Round 8) — sections 10-12 follow this line.
// ══════════════════════════════════════════════════════════════════════════════════

// ══════════════════════════════════════════════════════════════════════════════════
// 10. f_cmTip — Confluence mark tooltip (chart labels)
// Replaces the inline English _mTip construction in the indicator's Confluence Mark
// Renderer. English output is byte-identical to the current inline strings.
// Pre-translated components: coupName (E01-E19 via f_trCoup) and volName (S1-S19 via
// f_trVol / f_trVol3) arrive already translated from the indicator's routers.
// Trend, conviction and momentum names resolve from their integer codes inside.
// Realization: fragment assembly — each language assigns its fragments once and one
// composition path builds the tooltip, so the line structure stays identical in all
// 7 languages and the numeric scaffolding is written exactly once.
// ══════════════════════════════════════════════════════════════════════════════════

// @function Builds the confluence mark tooltip for chart labels.
// @param kind Mark kind: +1 bullish, -1 bearish, 0 indecision (tie).
// @param sigCode Trend signal code 5..10 (gate G1 guarantees the range on mark bars).
// @param align Multi-scale alignment score (-6..+6).
// @param convCode Conviction code: 1 HIGH, 2 MODERATE, 3 LOW.
// @param coupName Pre-translated efficiency coupling label (E01-E19).
// @param momCode Momentum code: 1 Accelerating, 2 Sharpening, 3 Steady, 4 Fading.
// @param volName Pre-translated volume scenario label (S1-S19).
// @param score Composite confluence score (-100..+100).
// @param consensus Trend-coherent consensus count (0..5).
// @param bullScr Jordan bull score (0..100).
// @param bearScr Jordan bear score (0..100, positive magnitude).
// @param trace Gram-matrix trace, total activation (0..5).
// @param contDir Continuation direction: 0 birth or indecision (no extra line), +1/-1 same-direction continuation.
// @param domScr Dominant score of this mark (continuation comparison).
// @param prevScr Dominant score of the previous same-direction mark.
// @param lang The dashboard language selected by the user.
// @returns The complete multi-line tooltip string.
export f_cmTip(int kind, int sigCode, int align, int convCode, string coupName, int momCode, string volName, float score, int consensus, float bullScr, float bearScr, float trace, int contDir, float domScr, float prevScr, string lang) =>
    string _head = "",   string _trN = ""
    string _cvN = "",    string _moN = ""
    string _lTrend = "", string _lAlign = ""
    string _lConv = "",  string _lEff = ""
    string _lMom = "",   string _lVol = ""
    string _lScore = "", string _lAligned = ""
    string _lBull = "",  string _lBear = ""
    string _lAct = "",   string _lDisc = ""
    string _cB = "",     string _cS = ""
    string _cStr = "",   string _cWk = ""
    string _cEq = ""
    if lang == "Türkçe"
        _head     := kind > 0 ? "BOĞA ÇAKIŞMASI — EŞİK AŞILDI" : kind < 0 ? "AYI ÇAKIŞMASI — EŞİK AŞILDI" : "KARARSIZLIK — BOĞA VE AYI EŞİKTE BERABERE"
        _trN      := sigCode == 5 ? "Güçlü Yükseliş Trendi" : sigCode == 6 ? "Güçlü Düşüş Trendi" : sigCode == 7 ? "Gizli Boğa Eğilimi" : sigCode == 8 ? "Gizli Ayı Eğilimi" : sigCode == 9 ? "Yükseliş Trendi Aktif" : "Düşüş Trendi Aktif"
        _cvN      := convCode == 1 ? "YÜKSEK" : convCode == 2 ? "ORTA" : "DÜŞÜK"
        _moN      := momCode == 1 ? "Hızlanıyor" : momCode == 2 ? "Keskinleşiyor" : momCode == 3 ? "Sabit" : "Zayıflıyor"
        _lTrend   := "Trend: "
        _lAlign   := " · Hizalama "
        _lConv    := "Kararlılık: "
        _lEff     := " · Verimlilik: "
        _lMom     := "Momentum: "
        _lVol     := "Hacim: "
        _lScore   := "Puan "
        _lAligned := "/5 hizalı · kapanmış bar verisi"
        _lBull    := "Boğa: +"
        _lBear    := " | Ayı: -"
        _lAct     := " | Aktivite: "
        _lDisc    := "Yapısal gözlem, işlem tavsiyesi değildir"
        _cB       := "Boğa devamı · "
        _cS       := "Ayı devamı · "
        _cStr     := "öncekinden daha güçlü"
        _cWk      := "öncekinden daha zayıf"
        _cEq      := "öncekiyle eşit"
    else if lang == "العربية"
        _head     := kind > 0 ? "التقاء صعودي — تم تجاوز العتبة" : kind < 0 ? "التقاء هبوطي — تم تجاوز العتبة" : "تردد — تعادل الصعود والهبوط عند العتبة"
        _trN      := sigCode == 5 ? "اتجاه صاعد قوي" : sigCode == 6 ? "اتجاه هابط قوي" : sigCode == 7 ? "ميل صعودي خفي" : sigCode == 8 ? "ميل هبوطي خفي" : sigCode == 9 ? "اتجاه صاعد نشط" : "اتجاه هابط نشط"
        _cvN      := convCode == 1 ? "مرتفعة" : convCode == 2 ? "متوسطة" : "منخفضة"
        _moN      := momCode == 1 ? "يتسارع" : momCode == 2 ? "يشتد" : momCode == 3 ? "مستقر" : "يتلاشى"
        _lTrend   := "الاتجاه: "
        _lAlign   := " · المحاذاة "
        _lConv    := "القناعة: "
        _lEff     := " · الكفاءة: "
        _lMom     := "الزخم: "
        _lVol     := "الحجم: "
        _lScore   := "الدرجة "
        _lAligned := "/5 متوافقة · بيانات شموع مغلقة"
        _lBull    := "صعود: +"
        _lBear    := " | هبوط: -"
        _lAct     := " | النشاط: "
        _lDisc    := "ملاحظة هيكلية، وليست نصيحة تداول"
        _cB       := "استمرار صعودي · "
