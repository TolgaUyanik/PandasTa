            "— No active episode"  => "— Nessun episodio attivo"
            => en
    else if lang == "हिन्दी"
        switch en
            "🐂 Strong Bullish"    => "🐂 मज़बूत तेज़ी"
            "🐻 Strong Bearish"    => "🐻 मज़बूत मंदी"
            "▲ Bullish Lean"       => "▲ तेज़ी झुकाव"
            "▼ Bearish Lean"       => "▼ मंदी झुकाव"
            "◆ Choppy"             => "◆ अस्थिर"
            "⚠ Mixed Signals"      => "⚠ मिश्रित संकेत"
            "💢 Reversal ▲"        => "💢 पलटाव ▲"
            "💢 Reversal ▼"        => "💢 पलटाव ▼"
            "💢 Capitulation"      => "💢 समर्पण"
            "💢 Exhaustion"        => "💢 थकावट"
            "▲ Bull Lean"          => "▲ तेज़ी झुकाव"
            "▼ Bear Lean"          => "▼ मंदी झुकाव"
            "⚠ Mixed"              => "⚠ मिश्रित"
            "💢 Rev ▲"             => "💢 पलटाव ▲"
            "💢 Rev ▼"             => "💢 पलटाव ▼"
            "Trend↔Vol"            => "ट्रेंड↔वॉल्यूम"
            "Vol Diverg"           => "वॉल्यूम विचलन"
            "Counter"              => "प्रतिकूल चाल"
            "Eff Fading"           => "दक्षता घट रही"
            "✓ Confirming Bullish" => "✓ तेज़ी की पुष्टि"
            "✓ Confirming Bearish" => "✓ मंदी की पुष्टि"
            "⚠ Under Attack"       => "⚠ दबाव में"
            "◆ Neutral"            => "◆ तटस्थ"
            "◇ Indecision episode" => "◇ अनिर्णय अवधि"
            "— No active episode"  => "— कोई सक्रिय अवधि नहीं"
            => en
    else if lang == "日本語"
        switch en
            "🐂 Strong Bullish"    => "🐂 強い強気"
            "🐻 Strong Bearish"    => "🐻 強い弱気"
            "▲ Bullish Lean"       => "▲ 強気傾向"
            "▼ Bearish Lean"       => "▼ 弱気傾向"
            "◆ Choppy"             => "◆ 方向感なし"
            "⚠ Mixed Signals"      => "⚠ シグナル混在"
            "💢 Reversal ▲"        => "💢 反転 ▲"
            "💢 Reversal ▼"        => "💢 反転 ▼"
            "💢 Capitulation"      => "💢 投げ売り"
            "💢 Exhaustion"        => "💢 買い疲れ"
            "▲ Bull Lean"          => "▲ 強気傾向"
            "▼ Bear Lean"          => "▼ 弱気傾向"
            "⚠ Mixed"              => "⚠ 混在"
            "💢 Rev ▲"             => "💢 反転 ▲"
            "💢 Rev ▼"             => "💢 反転 ▼"
            "Trend↔Vol"            => "トレンド↔出来高"
            "Vol Diverg"           => "出来高乖離"
            "Counter"              => "逆行"
