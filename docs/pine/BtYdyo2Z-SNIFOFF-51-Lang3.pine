    else if lang == "简体中文"
        switch en
            "🐂 Strong Bullish"    => "🐂 强烈看涨"
            "🐻 Strong Bearish"    => "🐻 强烈看跌"
            "▲ Bullish Lean"       => "▲ 偏多"
            "▼ Bearish Lean"       => "▼ 偏空"
            "◆ Choppy"             => "◆ 震荡"
