// ══════════════════════════════════════════════════════════════════════════════════
// SNIFOFF_51_Lang3 — Multilingual dictionary (Group 3) for Smart Trader, SNIF-OFF 5.1
// Distribution: same policy as SNIFOFF_51_Lang2 (public open-source)
// Scope: Trade Finder rows, Signal Health row, S17/S18/S19 scenarios,
//   PROVISIONAL badge, Native footprint texts, chart-mark tooltips
//   (confluence marks, REV and TREND labels)
// Languages (target): English, Türkçe, العربية, Italiano, हिन्दी, 日本語, 简体中文
// Current build: ALL 7 LANGUAGES — English, Türkçe, العربية, Italiano, हिन्दी,
//   日本語, 简体中文 (Round 8, chart-mark tooltips added). Publish as v2.
// Compiler note (CE10237): exported functions must consume every argument — the
//   `lang` routing structure therefore ships from the first build.
// Architecture: one library holds all 7 languages (no Lang/Lang2-style split).
//   Label functions map English → target and fall through to English (=> en) for
//   unmapped inputs. Key functions return "" for unknown keys — mirrors Lang/Lang2.
// Consumer: ST-EP 5,1 indicator via import ata_sabanci/SNIFOFF_51_Lang3/2 as lang3
//   Replaces every TEMP-EN bypass: S17/S18/S19 label + narrative (desktop + mobile),
//   Trade Finder rows (desktop + mobile Row 5), Signal Health row, PROVISIONAL badge,
//   watch labels, 4 helper affixes, and the inline English chart-mark tooltips
//   (_mTip, _rvTip, _rtTip).
// ══════════════════════════════════════════════════════════════════════════════════

//@version=6

// @description Multilingual translation layer (Group 3) for Smart Trader, SNIF-OFF 5.1, Trade Finder.
//   Provides 12 exported functions covering the Trade Finder and Signal Health dashboard rows,
//   the S17/S18/S19 volume scenarios, the PROVISIONAL badge, the Native footprint texts,
//   the chart-mark tooltips (confluence marks, REV and TREND labels),
//   12 tooltips, and 4 helper affixes.
//   All 7 languages live in this single library; SNIFOFF_51_Lang and SNIFOFF_51_Lang2 stay frozen.
library("SNIFOFF_51_Lang3", overlay = false)

// ══════════════════════════════════════════════════════════════════════════════════
// 1. f_trVol3 — S17/S18/S19 volume scenario labels (3 keys)
// Keys (exact f_volScenarioMsg outputs):
//   "🔥 Pressure Building"  ·  "⚖ High-Volume Standoff"  ·  "◇ Balanced Flow"
// S1–S16 labels stay with Lang/Lang2 — any other input falls through unchanged.
// ══════════════════════════════════════════════════════════════════════════════════

// @function Translates the S17/S18/S19 volume scenario labels.
// @param en The English scenario label from f_volScenarioMsg (S17/S18/S19 keys only).
// @param lang The dashboard language selected by the user.
// @returns The translated scenario label. Unmapped inputs return unchanged.
export f_trVol3(string en, string lang) =>
    if lang == "Türkçe"
        switch en
            "🔥 Pressure Building"    => "🔥 Baskı Birikiyor"
            "⚖ High-Volume Standoff" => "⚖ Yüksek Hacimli Kilitlenme"
            "◇ Balanced Flow"         => "◇ Dengeli Akış"
            => en
    else if lang == "العربية"
        switch en
            "🔥 Pressure Building"    => "🔥 ضغط يتراكم"
            "⚖ High-Volume Standoff" => "⚖ تعادل بحجم مرتفع"
            "◇ Balanced Flow"         => "◇ تدفق متوازن"
            => en
    else if lang == "Italiano"
        switch en
            "🔥 Pressure Building"    => "🔥 Pressione in Aumento"
            "⚖ High-Volume Standoff" => "⚖ Stallo ad Alto Volume"
            "◇ Balanced Flow"         => "◇ Flusso Bilanciato"
            => en
    else if lang == "हिन्दी"
        switch en
            "🔥 Pressure Building"    => "🔥 दबाव बन रहा है"
            "⚖ High-Volume Standoff" => "⚖ उच्च-वॉल्यूम गतिरोध"
            "◇ Balanced Flow"         => "◇ संतुलित प्रवाह"
            => en
    else if lang == "日本語"
        switch en
            "🔥 Pressure Building"    => "🔥 圧力が蓄積中"
            "⚖ High-Volume Standoff" => "⚖ 高出来高の拮抗"
            "◇ Balanced Flow"         => "◇ 均衡フロー"
            => en
    else if lang == "简体中文"
        switch en
            "🔥 Pressure Building"    => "🔥 压力积聚中"
            "⚖ High-Volume Standoff" => "⚖ 高量对峙"
            "◇ Balanced Flow"         => "◇ 均衡流动"
            => en
    else
        en

// ══════════════════════════════════════════════════════════════════════════════════
// 2. f_volNarr3 — S17/S18/S19 volume narratives
// Replaces the inline _s17Narr / _s18Narr / _s19Narr TEMP-EN strings in the indicator.
// English text is byte-identical to the current inline strings (zero visual change).
// ══════════════════════════════════════════════════════════════════════════════════

// @function Builds the S17/S18/S19 volume narrative with optional live-spike overlay.
// @param sid Scenario ID: "S17", "S18", or "S19". Any other ID returns "".
// @param deltaDir Anchored delta direction (+1 buyers, -1 sellers, 0 balanced) — S17 wording.
// @param liveAlert Explosive bar [0] volume spike flag (Live Exception protocol).
// @param lang The dashboard language selected by the user.
// @returns The multi-line narrative string, or "" for unknown scenario IDs.
export f_volNarr3(string sid, int deltaDir, bool liveAlert, string lang) =>
    string _live = ""
    string _body = ""
    if lang == "Türkçe"
        _live := liveAlert ? "\n🔴 CANLI: Mevcut mumda patlayıcı hacim artışı." : ""
        _body := switch sid
            "S17" => "Trendsiz piyasada güçlü hacim (üst çeyrek)\nve net bir " + (deltaDir > 0 ? "alış" : "satış") + " yönlü delta.\nYön netleşmeden katılım artıyor\n— baskı birikiyor.\nHacim daha da yükselirse\nbu bir Kırılım Adayına dönüşür\n— çözülmeyi izleyin."
            "S18" => "Nötr bant içinde dengeli deltayla\nyükselmiş hacim:\nalıcılar ve satıcılar birbirini emiyor.\nBu sessiz bir piyasa değil, yüksek hacimli bir kilitlenme.\nBir taraf pes ettiğinde belirleyici bir hareket bekleyin."
            "S19" => "Son kapanan mumda dengeli alış/satış deltasıyla\naktif bir trend:\nkatılım çift taraflı, net bir inisiyatif yok.\nTrend yapısı sağlam,\nancak bu mum hiçbir yönde hacim güveni eklemiyor.\nDeltanın trendle yeniden hizalanması devamı destekler;\ntrende karşı dönmesi düzeltme uyarısıdır."
            => ""
    else if lang == "العربية"
        _live := liveAlert ? "\n🔴 مباشر: ارتفاع حجم انفجاري على الشمعة الحالية." : ""
        _body := switch sid
            "S17" => "سوق بلا اتجاه مع حجم قوي (الربع الأعلى)\nودلتا واضحة في جانب " + (deltaDir > 0 ? "الشراء" : "البيع") + ".\nالمشاركة ترتفع قبل حسم الاتجاه\n— الضغط يتراكم.\nإذا تصاعد الحجم أكثر\nيتحول هذا إلى مرشح للاختراق\n— راقب لحظة الحسم."
            "S18" => "حجم مرتفع مع دلتا متوازنة\nداخل نطاق الحياد:\nالمشترون والبائعون يمتص كل منهما الآخر.\nهذه ليست سوقاً هادئة بل مواجهة بحجم مرتفع.\nتوقع حركة حاسمة عندما يتراجع أحد الطرفين."
            "S19" => "اتجاه نشط مع دلتا شراء/بيع متوازنة\nعلى آخر شمعة مغلقة:\nالمشاركة من الجانبين بلا مبادرة صافية.\nهيكل الاتجاه لا يزال سليماً،\nلكن هذه الشمعة لا تضيف قناعة حجمية في أي اتجاه.\nعودة الدلتا للتوافق مع الاتجاه ترجّح الاستمرار؛\nوانقلابها ضده تحذير من تصحيح."
            => ""
    else if lang == "Italiano"
        _live := liveAlert ? "\n🔴 LIVE: picco di volume esplosivo sulla candela corrente." : ""
        _body := switch sid
            "S17" => "Mercato senza trend con volume forte (quartile superiore)\ne un delta chiaramente sul lato " + (deltaDir > 0 ? "acquisti" : "vendite") + ".\nLa partecipazione cresce prima che la direzione si risolva\n— la pressione sta aumentando.\nSe il volume sale ulteriormente\nquesto diventa un Candidato al Breakout\n— attendi la risoluzione."
            "S18" => "Volume elevato con delta bilanciato\ndentro la banda di neutralità:\ncompratori e venditori si assorbono a vicenda.\nQuesto è uno stallo ad alto volume, non un mercato calmo.\nAttenditi un movimento decisivo quando un lato cede."
            "S19" => "Un trend attivo con delta acquisti/vendite bilanciato\nsull'ultima candela chiusa:\nla partecipazione è bilaterale, senza iniziativa netta.\nLa struttura del trend resta intatta,\nma questa candela non aggiunge convinzione di volume in nessuna direzione.\nUn delta che si riallinea al trend favorisce la continuazione;\nun'inversione contro di esso avverte di una correzione."
            => ""
    else if lang == "हिन्दी"
        _live := liveAlert ? "\n🔴 लाइव: मौजूदा कैंडल पर विस्फोटक वॉल्यूम उछाल." : ""
        _body := switch sid
            "S17" => "बिना ट्रेंड वाला बाज़ार, मज़बूत वॉल्यूम (शीर्ष चौथाई)\nऔर स्पष्ट " + (deltaDir > 0 ? "खरीद" : "बिक्री") + "-पक्ष डेल्टा.\nदिशा तय होने से पहले भागीदारी बढ़ रही है\n— दबाव बन रहा है.\nयदि वॉल्यूम और बढ़ता है\nतो यह ब्रेकआउट उम्मीदवार बन जाता है\n— समाधान पर नज़र रखें."
            "S18" => "तटस्थता बैंड के भीतर संतुलित डेल्टा के साथ\nऊँचा वॉल्यूम:\nखरीदार और विक्रेता एक-दूसरे को सोख रहे हैं.\nयह शांत बाज़ार नहीं, उच्च-वॉल्यूम गतिरोध है.\nजब एक पक्ष झुकेगा, तब निर्णायक चाल की अपेक्षा करें."
            "S19" => "अंतिम बंद कैंडल पर संतुलित खरीद/बिक्री डेल्टा के साथ\nसक्रिय ट्रेंड:\nभागीदारी दोतरफ़ा है, कोई शुद्ध पहल नहीं.\nट्रेंड संरचना बरकरार है,\nलेकिन यह कैंडल किसी दिशा में वॉल्यूम विश्वास नहीं जोड़ती.\nडेल्टा का ट्रेंड से फिर जुड़ना निरंतरता के पक्ष में है;\nइसके विरुद्ध पलटना सुधार की चेतावनी है."
            => ""
    else if lang == "日本語"
        _live := liveAlert ? "\n🔴 ライブ: 現在のローソク足で爆発的な出来高急増。" : ""
        _body := switch sid
            "S17" => "トレンドのない市場で強い出来高(上位四分位)と\n明確な" + (deltaDir > 0 ? "買い" : "売り") + "側デルタ。\n方向が決まる前に参加が増加中\n— 圧力が蓄積しています。\n出来高がさらに拡大すれば\nブレイクアウト候補となります\n— 決着を見守ってください。"
            "S18" => "中立バンド内の均衡したデルタを伴う\n高い出来高:\n買い手と売り手が互いを吸収しています。\nこれは静かな市場ではなく、高出来高の拮抗です。\n一方が崩れたとき、決定的な動きを想定してください。"
            "S19" => "直近の確定足で買い/売りデルタが均衡した\n活発なトレンド:\n参加は双方向で、純粋な主導権はありません。\nトレンド構造は維持されていますが、\nこの足はどちらの方向にも出来高の確信を加えません。\nデルタがトレンドに再同調すれば継続が優勢;\n逆方向への反転は調整の警告です。"
            => ""
    else if lang == "简体中文"
        _live := liveAlert ? "\n🔴 实时: 当前K线出现爆发性成交量激增。" : ""
        _body := switch sid
            "S17" => "无趋势市场伴随强劲成交量(最高四分位)\n且Delta明显偏向" + (deltaDir > 0 ? "买" : "卖") + "方。\n方向未定之际参与度正在上升\n— 压力正在积聚。\n若成交量进一步放大\n则将成为突破候选\n— 关注最终决出方向。"
            "S18" => "中性区间内Delta均衡\n且成交量偏高:\n买方与卖方正在相互吸收。\n这不是平静的市场，而是高量对峙。\n一旦一方让步，预计将出现决定性行情。"
            "S19" => "最近收盘K线上买卖Delta均衡\n且趋势活跃:\n参与是双向的，没有净主动性。\n趋势结构保持完好，\n但这根K线未在任何方向增加成交量信心。\nDelta重新顺应趋势则利于延续;\n逆势翻转则是回调警告。"
            => ""
    else
        _live := liveAlert ? "\n🔴 LIVE: explosive volume spike on the current candle." : ""
        _body := switch sid
            "S17" => "Trendless market with strong volume (top quartile)\nand a clear " + (deltaDir > 0 ? "buy" : "sell") + "-side delta.\nParticipation is rising before direction is resolved\n— pressure is building.\nIf volume escalates further\nthis becomes a Breakout Candidate\n— watch for the resolution."
            "S18" => "Elevated volume with a balanced delta\ninside the neutrality band:\nbuyers and sellers are absorbing each other.\nThis is a high-volume standoff, not a quiet market.\nExpect a decisive move once one side gives way."
            "S19" => "An active trend with a balanced buy/sell delta\non the last closed bar:\nparticipation is two-sided with no net initiative.\nTrend structure remains intact,\nbut this bar adds no volume conviction in either direction.\nDelta re-engaging with the trend favors continuation;\na flip against it warns of a correction."
            => ""
    _body == "" ? "" : _body + _live

// ══════════════════════════════════════════════════════════════════════════════════
// 3. f_trBadge3 — Signal Health status badge (1 key)
// Key: "◌ PROVISIONAL". ACTIVE / LOCKED / LIVE / HIST badges stay with Lang/Lang2.
// ══════════════════════════════════════════════════════════════════════════════════

// @function Translates the Signal Health PROVISIONAL badge.
// @param en The English badge label ("◌ PROVISIONAL").
// @param lang The dashboard language selected by the user.
// @returns The translated badge label. Unmapped inputs return unchanged.
export f_trBadge3(string en, string lang) =>
    if lang == "Türkçe"
        switch en
            "◌ PROVISIONAL" => "◌ GEÇİCİ"
            => en
    else if lang == "العربية"
        switch en
            "◌ PROVISIONAL" => "◌ مؤقت"
            => en
    else if lang == "Italiano"
        switch en
            "◌ PROVISIONAL" => "◌ PROVVISORIO"
            => en
    else if lang == "हिन्दी"
        switch en
            "◌ PROVISIONAL" => "◌ अस्थायी"
            => en
    else if lang == "日本語"
        switch en
            "◌ PROVISIONAL" => "◌ 暫定"
            => en
    else if lang == "简体中文"
        switch en
            "◌ PROVISIONAL" => "◌ 暂定"
            => en
    else
        en

// ══════════════════════════════════════════════════════════════════════════════════
// 4. f_trTitle3 — Trade Finder + Signal Health section titles (2 keys)
// Keys (exact indicator strings, double spaces around the separator preserved):
//   "TRADE FINDER  ·  Pressure Synthesis"  ·  "SIGNAL HEALTH  ·  Live Monitor"
// Brand policy: TRADE FINDER stays untranslated (part of the product name);
// its subtitle and the full SIGNAL HEALTH title translate normally.
// ══════════════════════════════════════════════════════════════════════════════════

// @function Translates the Trade Finder and Signal Health section titles.
// @param en The English section title.
// @param lang The dashboard language selected by the user.
// @returns The translated section title. Unmapped inputs return unchanged.
export f_trTitle3(string en, string lang) =>
    if lang == "Türkçe"
        switch en
            "TRADE FINDER  ·  Pressure Synthesis" => "TRADE FINDER  ·  Baskı Sentezi"
            "SIGNAL HEALTH  ·  Live Monitor"      => "SİNYAL SAĞLIĞI  ·  Canlı İzleme"
            => en
    else if lang == "العربية"
        switch en
            "TRADE FINDER  ·  Pressure Synthesis" => "TRADE FINDER  ·  توليف الضغط"
            "SIGNAL HEALTH  ·  Live Monitor"      => "صحة الإشارة  ·  مراقبة مباشرة"
            => en
    else if lang == "Italiano"
        switch en
            "TRADE FINDER  ·  Pressure Synthesis" => "TRADE FINDER  ·  Sintesi della Pressione"
            "SIGNAL HEALTH  ·  Live Monitor"      => "SALUTE DEL SEGNALE  ·  Monitor Live"
            => en
    else if lang == "हिन्दी"
        switch en
            "TRADE FINDER  ·  Pressure Synthesis" => "TRADE FINDER  ·  दबाव संश्लेषण"
            "SIGNAL HEALTH  ·  Live Monitor"      => "सिग्नल स्वास्थ्य  ·  लाइव मॉनिटर"
            => en
    else if lang == "日本語"
        switch en
            "TRADE FINDER  ·  Pressure Synthesis" => "TRADE FINDER  ·  圧力統合"
            "SIGNAL HEALTH  ·  Live Monitor"      => "シグナル健全性  ·  ライブモニター"
            => en
    else if lang == "简体中文"
        switch en
            "TRADE FINDER  ·  Pressure Synthesis" => "TRADE FINDER  ·  压力综合"
            "SIGNAL HEALTH  ·  Live Monitor"      => "信号健康  ·  实时监测"
            => en
    else
        en

// ══════════════════════════════════════════════════════════════════════════════════
// 5. f_trTf — Trade Finder + Signal Health state labels (25 keys)
// Desktop states (10): "🐂 Strong Bullish" · "🐻 Strong Bearish" · "▲ Bullish Lean" ·
//   "▼ Bearish Lean" · "◆ Choppy" · "⚠ Mixed Signals" · "💢 Reversal ▲" ·
//   "💢 Reversal ▼" · "💢 Capitulation" · "💢 Exhaustion"
// Mobile compact states (5): "▲ Bull Lean" · "▼ Bear Lean" · "⚠ Mixed" ·
//   "💢 Rev ▲" · "💢 Rev ▼"   (mobile shares the remaining 3 with desktop)
// Watch labels (4): "Trend↔Vol" · "Vol Diverg" · "Counter" · "Eff Fading"
// Signal Health states (6): "✓ Confirming Bullish" · "✓ Confirming Bearish" ·
//   "⚠ Under Attack" · "◆ Neutral" · "◇ Indecision episode" · "— No active episode"
// Non-translatables ("—", "S12", "S13") fall through unchanged by design.
// ══════════════════════════════════════════════════════════════════════════════════

// @function Translates Trade Finder and Signal Health state and watch labels.
// @param en The English state or watch label.
// @param lang The dashboard language selected by the user.
// @returns The translated label. Unmapped inputs return unchanged.
export f_trTf(string en, string lang) =>
    if lang == "Türkçe"
        switch en
            "🐂 Strong Bullish"    => "🐂 Güçlü Boğa"
            "🐻 Strong Bearish"    => "🐻 Güçlü Ayı"
            "▲ Bullish Lean"       => "▲ Boğa Eğilimi"
            "▼ Bearish Lean"       => "▼ Ayı Eğilimi"
            "◆ Choppy"             => "◆ Dalgalı"
            "⚠ Mixed Signals"      => "⚠ Karışık Sinyaller"
            "💢 Reversal ▲"        => "💢 Dönüş ▲"
            "💢 Reversal ▼"        => "💢 Dönüş ▼"
            "💢 Capitulation"      => "💢 Teslimiyet"
            "💢 Exhaustion"        => "💢 Tükenme"
            "▲ Bull Lean"          => "▲ Boğa Eğilimi"
            "▼ Bear Lean"          => "▼ Ayı Eğilimi"
            "⚠ Mixed"              => "⚠ Karışık"
            "💢 Rev ▲"             => "💢 Dönüş ▲"
            "💢 Rev ▼"             => "💢 Dönüş ▼"
            "Trend↔Vol"            => "Trend↔Hacim"
            "Vol Diverg"           => "Hacim Sapması"
            "Counter"              => "Karşıtlık"
            "Eff Fading"           => "Verim Düşüyor"
            "✓ Confirming Bullish" => "✓ Boğa Teyidi"
            "✓ Confirming Bearish" => "✓ Ayı Teyidi"
            "⚠ Under Attack"       => "⚠ Baskı Altında"
            "◆ Neutral"            => "◆ Nötr"
            "◇ Indecision episode" => "◇ Kararsızlık Dönemi"
            "— No active episode"  => "— Aktif Dönem Yok"
            => en
    else if lang == "العربية"
        switch en
            "🐂 Strong Bullish"    => "🐂 صعود قوي"
            "🐻 Strong Bearish"    => "🐻 هبوط قوي"
            "▲ Bullish Lean"       => "▲ ميل صعودي"
            "▼ Bearish Lean"       => "▼ ميل هبوطي"
            "◆ Choppy"             => "◆ متقلب"
            "⚠ Mixed Signals"      => "⚠ إشارات متضاربة"
            "💢 Reversal ▲"        => "💢 انعكاس ▲"
            "💢 Reversal ▼"        => "💢 انعكاس ▼"
            "💢 Capitulation"      => "💢 استسلام"
            "💢 Exhaustion"        => "💢 إرهاق"
            "▲ Bull Lean"          => "▲ ميل صعودي"
            "▼ Bear Lean"          => "▼ ميل هبوطي"
            "⚠ Mixed"              => "⚠ متضارب"
            "💢 Rev ▲"             => "💢 انعكاس ▲"
            "💢 Rev ▼"             => "💢 انعكاس ▼"
            "Trend↔Vol"            => "اتجاه↔حجم"
            "Vol Diverg"           => "تباين الحجم"
            "Counter"              => "معاكسة"
            "Eff Fading"           => "الكفاءة تتراجع"
            "✓ Confirming Bullish" => "✓ تأكيد صعودي"
            "✓ Confirming Bearish" => "✓ تأكيد هبوطي"
            "⚠ Under Attack"       => "⚠ تحت الضغط"
            "◆ Neutral"            => "◆ محايد"
            "◇ Indecision episode" => "◇ فترة تردد"
            "— No active episode"  => "— لا فترة نشطة"
            => en
    else if lang == "Italiano"
        switch en
            "🐂 Strong Bullish"    => "🐂 Fortemente Rialzista"
            "🐻 Strong Bearish"    => "🐻 Fortemente Ribassista"
            "▲ Bullish Lean"       => "▲ Inclinazione Rialzista"
            "▼ Bearish Lean"       => "▼ Inclinazione Ribassista"
