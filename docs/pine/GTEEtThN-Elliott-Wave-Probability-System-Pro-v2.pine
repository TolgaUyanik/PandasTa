//@version=6
indicator('Elliott Wave Probability System Pro', overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 100)

// === INPUTS ===
// Elliott Wave Settings
wavePeriod = input.int(10, 'Wave Detection Period', minval = 5, maxval = 50, group = 'Elliott Wave')
showWaveLabels = input.bool(true, 'Show Wave Labels', group = 'Elliott Wave')
showWaveLines = input.bool(true, 'Show Wave Connection Lines', group = 'Elliott Wave')
trendLookback = input.int(75, 'Trend Detection Lookback', minval = 50, maxval = 200, group = 'Elliott Wave')

// Fibonacci Settings
showFibs = input.bool(true, 'Show Fibonacci Levels', group = 'Fibonacci')
fibLookback = input.int(50, 'Fib Calculation Lookback', minval = 20, maxval = 200, group = 'Fibonacci')

// RSI Settings (for probability calculation only)
rsiLength = input.int(14, 'RSI Length', group = 'Technical Indicators')

// Technical Indicators
macdFast = input.int(12, 'MACD Fast', group = 'Technical Indicators')
macdSlow = input.int(26, 'MACD Slow', group = 'Technical Indicators')
macdSignal = input.int(9, 'MACD Signal', group = 'Technical Indicators')
stochLength = input.int(14, 'Stochastic Length', group = 'Technical Indicators')
volumeLength = input.int(20, 'Volume MA Length', group = 'Technical Indicators')

// Probability Settings
showProbTable = input.bool(true, 'Show Probability Table', group = 'Probability')
numTargets = input.int(5, 'Number of Price Targets', minval = 3, maxval = 10, group = 'Probability')
adaptiveTargets = input.bool(true, 'Adaptive Target Direction', group = 'Probability')

// Colors
bullColor = input.color(color.new(color.green, 0), 'Bullish Color', group = 'Colors')
bearColor = input.color(color.new(color.red, 0), 'Bearish Color', group = 'Colors')
fibColor = input.color(color.new(color.blue, 50), 'Fibonacci Color', group = 'Colors')

// === CALCULATIONS ===
// RSI
rsi = ta.rsi(close, rsiLength)

// MACD
[macdLine, signalLine, histogram] = ta.macd(close, macdFast, macdSlow, macdSignal)
macdBullish = macdLine > signalLine and histogram > histogram[1]
macdBearish = macdLine < signalLine and histogram < histogram[1]

// Stochastic
k = ta.stoch(close, high, low, stochLength)
d = ta.sma(k, 3)
stochBullish = k > d and k < 80
stochBearish = k < d and k > 20

// Volume Analysis
volMA = ta.sma(volume, volumeLength)
volRatio = volume / volMA
highVolume = volRatio > 1.5

// === IMPROVED TREND DETECTION ===
// Multiple methods to determine trend over last 75 bars
highestInLookback = ta.highest(high, trendLookback)
lowestInLookback = ta.lowest(low, trendLookback)
midPoint = (highestInLookback + lowestInLookback) / 2

// Method 1: Price position relative to range
pricePosition = (close - lowestInLookback) / (highestInLookback - lowestInLookback)

// Method 2: Linear regression slope
linRegSlope = ta.linreg(close, trendLookback, 0) - ta.linreg(close, trendLookback, 1)

// Method 3: Moving average trend
ma20 = ta.sma(close, 20)
ma50 = ta.sma(close, 50)
maTrend = ma20 > ma50

// Method 4: Higher highs and higher lows (or opposite)
recentHigh = ta.highest(high, 20)
recentLow = ta.lowest(low, 20)
olderHigh = ta.highest(high[20], 20)
olderLow = ta.lowest(low[20], 20)
higherHighs = recentHigh > olderHigh
higherLows = recentLow > olderLow
lowerHighs = recentHigh < olderHigh
lowerLows = recentLow < olderLow

// Method 5: Count up vs down bars
upBars = 0
downBars = 0
for i = 1 to trendLookback by 1
    if close[i] > close[i + 1]
        upBars := upBars + 1
        upBars
    else
        downBars := downBars + 1
        downBars

// Combine all methods for final trend determination
trendScore = 0.0
trendScore := pricePosition > 0.6 ? trendScore + 1 : pricePosition < 0.4 ? trendScore - 1 : trendScore
trendScore := linRegSlope > 0 ? trendScore + 1 : trendScore - 1
trendScore := maTrend ? trendScore + 1 : trendScore - 1
trendScore := higherHighs and higherLows ? trendScore + 2 : lowerHighs and lowerLows ? trendScore - 2 : trendScore
trendScore := upBars > downBars * 1.1 ? trendScore + 1 : downBars > upBars * 1.1 ? trendScore - 1 : trendScore

// Final trend determination
isBullishTrend = trendScore > 1
isBearishTrend = trendScore < -1
isNeutralTrend = not isBullishTrend and not isBearishTrend

// === ELLIOTT WAVE DETECTION ===
// Find pivot points
pivotHigh = ta.pivothigh(high, wavePeriod, wavePeriod)
pivotLow = ta.pivotlow(low, wavePeriod, wavePeriod)

// Arrays to store wave points
var highPivots = array.new<float>()
var lowPivots = array.new<float>()
var highBars = array.new<int>()
var lowBars = array.new<int>()

// Add pivots to arrays
if not na(pivotHigh)
    array.push(highPivots, pivotHigh)
    array.push(highBars, bar_index - wavePeriod)
    if array.size(highPivots) > 20
        array.shift(highPivots)
        array.shift(highBars)

if not na(pivotLow)
    array.push(lowPivots, pivotLow)
    array.push(lowBars, bar_index - wavePeriod)
    if array.size(lowPivots) > 20
        array.shift(lowPivots)
        array.shift(lowBars)

// === ELLIOTT WAVE PATTERN RECOGNITION ===
// Simplified wave counting based on alternating highs and lows
var int waveCount = 0
var bool inImpulse = true
var waveLabels = array.new<string>()
if barstate.isfirst
    array.push(waveLabels, '1')
    array.push(waveLabels, '2')
    array.push(waveLabels, '3')
    array.push(waveLabels, '4')
    array.push(waveLabels, '5')
    array.push(waveLabels, 'A')
    array.push(waveLabels, 'B')
    array.push(waveLabels, 'C')

// === FIBONACCI LEVELS ===
highestHigh = ta.highest(high, fibLookback)
lowestLow = ta.lowest(low, fibLookback)
fibRange = highestHigh - lowestLow

fib0 = lowestLow
fib236 = lowestLow + fibRange * 0.236
fib382 = lowestLow + fibRange * 0.382
fib500 = lowestLow + fibRange * 0.500
fib618 = lowestLow + fibRange * 0.618
fib786 = lowestLow + fibRange * 0.786
fib100 = highestHigh

// Extension levels
fib1618 = highestHigh + fibRange * 0.618
fib2618 = highestHigh + fibRange * 1.618

// Draw Fibonacci levels
if showFibs and barstate.islast
    fibLevels = array.new<float>()
    array.push(fibLevels, fib0)
    array.push(fibLevels, fib236)
    array.push(fibLevels, fib382)
    array.push(fibLevels, fib500)
    array.push(fibLevels, fib618)
    array.push(fibLevels, fib786)
    array.push(fibLevels, fib100)
    array.push(fibLevels, fib1618)
    array.push(fibLevels, fib2618)

    fibLabels = array.new<string>()
    array.push(fibLabels, '0%')
    array.push(fibLabels, '23.6%')
    array.push(fibLabels, '38.2%')
    array.push(fibLabels, '50%')
    array.push(fibLabels, '61.8%')
    array.push(fibLabels, '78.6%')
    array.push(fibLabels, '100%')
    array.push(fibLabels, '161.8%')
    array.push(fibLabels, '261.8%')

    for i = 0 to array.size(fibLevels) - 1 by 1
        level = array.get(fibLevels, i)
        labelText = array.get(fibLabels, i) + ' | $' + str.tostring(level, '#.##')

        line.new(bar_index - fibLookback, level, bar_index + 20, level, color = fibColor, style = line.style_dashed, width = 1)

        label.new(bar_index + 20, level, labelText, color = fibColor, style = label.style_label_left, textcolor = color.white, size = size.small)

// === PROBABILITY CALCULATION ===
// Weight factors for different indicators
rsiWeight = rsi > 70 ? -2 : rsi < 30 ? 2 : 0
macdWeight = macdBullish ? 1.5 : macdBearish ? -1.5 : 0
stochWeight = stochBullish ? 1 : stochBearish ? -1 : 0
volWeight = highVolume ? close > open ? 1.5 : -1.5 : 0

// Elliott Wave position weight
wavePositionWeight = 0.0
if array.size(highPivots) > 0 and array.size(lowPivots) > 0
    lastHigh = array.get(highPivots, array.size(highPivots) - 1)
    lastLow = array.get(lowPivots, array.size(lowPivots) - 1)
    pricePos = (close - lastLow) / (lastHigh - lastLow)

    // Wave 2 or 4 positions are bullish
    if pricePos < 0.382
        wavePositionWeight := 2
        wavePositionWeight
    // Wave 3 in progress
    else if pricePos > 0.382 and pricePos < 0.618
        wavePositionWeight := 1
        wavePositionWeight
    // Wave 5 or completion
    else
        wavePositionWeight := -1
        wavePositionWeight

// Add trend weight to scoring
trendWeight = isBullishTrend ? 1.5 : isBearishTrend ? -1.5 : 0

// Calculate total score
totalScore = rsiWeight + macdWeight + stochWeight + volWeight + wavePositionWeight + trendWeight
maxScore = 10.0 // Updated maximum possible score
probabilityBase = (totalScore + maxScore) / (2 * maxScore) * 100

// === PRICE TARGETS AND PROBABILITIES ===
// Calculate targets based on Fibonacci and Elliott Wave projections
var targetPrices = array.new<float>()
var targetProbs = array.new<float>()

if barstate.islast
    array.clear(targetPrices)
    array.clear(targetProbs)

    // Determine target direction based on trend analysis
    useUpTargets = adaptiveTargets ? isBullishTrend : totalScore > 0

    if useUpTargets // Bullish targets
        // Calculate upward targets using Fibonacci extensions
        for i = 1 to numTargets by 1
            target = 0.0
            if i == 1
                target := close + (highestHigh - close) * 0.236
                target
            else if i == 2
                target := close + (highestHigh - close) * 0.382
                target
            else if i == 3
                target := close + (highestHigh - close) * 0.618
                target
            else if i == 4
                target := close + (highestHigh - close) * 1.0
                target
            else
                target := close + (highestHigh - close) * 1.618
                target

            array.push(targetPrices, target)

            // Probability based on trend strength and distance
            baseProb = isBullishTrend ? 70 : 50
            distanceFactor = 1 - (i - 1) * 0.12
            prob = math.max(baseProb * distanceFactor, 15)
            array.push(targetProbs, prob)

    // Bearish targets
    else // Calculate downward targets using Fibonacci retracements
        for i = 1 to numTargets by 1
            target = 0.0
            if i == 1
                target := close - (close - lowestLow) * 0.236
                target
            else if i == 2
                target := close - (close - lowestLow) * 0.382
                target
            else if i == 3
                target := close - (close - lowestLow) * 0.618
                target
            else if i == 4
                target := close - (close - lowestLow) * 1.0
                target
            else
                target := close - (close - lowestLow) * 1.618
                target

            array.push(targetPrices, target)

            // Probability based on trend strength and distance
            baseProb = isBearishTrend ? 70 : 50
            distanceFactor = 1 - (i - 1) * 0.12
            prob = math.max(baseProb * distanceFactor, 15)
            array.push(targetProbs, prob)

// === PROBABILITY TABLE ===
if showProbTable and barstate.islast
    var table probTable = table.new(position.top_right, 4, numTargets + 3, bgcolor = color.new(color.black, 85), border_color = color.white, border_width = 1)

    // Headers
    table.cell(probTable, 0, 0, 'ELLIOTT WAVE TARGETS', text_color = color.white, bgcolor = color.new(color.blue, 50))
    table.cell(probTable, 1, 0, 'PRICE', text_color = color.white, bgcolor = color.new(color.blue, 50))
    table.cell(probTable, 2, 0, 'PROBABILITY', text_color = color.white, bgcolor = color.new(color.blue, 50))
    table.cell(probTable, 3, 0, 'GAIN/LOSS', text_color = color.white, bgcolor = color.new(color.blue, 50))

    // Current price row
    table.cell(probTable, 0, 1, 'Current', text_color = color.yellow)
    table.cell(probTable, 1, 1, '$' + str.tostring(close, '#.##'), text_color = color.yellow)
    table.cell(probTable, 2, 1, '-', text_color = color.yellow)
    table.cell(probTable, 3, 1, '-', text_color = color.yellow)

    // Separator
    table.cell(probTable, 0, 2, '━━━━━━━━', text_color = color.gray)
    table.cell(probTable, 1, 2, '━━━━━━', text_color = color.gray)
    table.cell(probTable, 2, 2, '━━━━━━━', text_color = color.gray)
    table.cell(probTable, 3, 2, '━━━━━', text_color = color.gray)

    // Target rows
    for i = 0 to array.size(targetPrices) - 1 by 1
        target = array.get(targetPrices, i)
        prob = array.get(targetProbs, i)
        change = (target - close) / close * 100

        targetColor = change > 0 ? bullColor : bearColor
        probColor = prob > 70 ? color.green : prob > 50 ? color.yellow : color.orange

        table.cell(probTable, 0, i + 3, 'Target ' + str.tostring(i + 1), text_color = color.white)
        table.cell(probTable, 1, i + 3, '$' + str.tostring(target, '#.##'), text_color = targetColor)
        table.cell(probTable, 2, i + 3, str.tostring(prob, '#.#') + '%', text_color = color.white, bgcolor = color.new(probColor, 70))
        table.cell(probTable, 3, i + 3, (change > 0 ? '+' : '') + str.tostring(change, '#.##') + '%', text_color = targetColor)

// === ELLIOTT WAVE VISUALIZATION ===
if showWaveLines and array.size(highPivots) > 2 and array.size(lowPivots) > 2
    // Draw wave lines connecting pivots
    for i = 0 to math.min(array.size(highPivots) - 1, 4) by 1
        if i < array.size(lowPivots)
            highBar = array.get(highBars, array.size(highBars) - 1 - i)
            lowBar = array.get(lowBars, array.size(lowBars) - 1 - i)
            highPrice = array.get(highPivots, array.size(highPivots) - 1 - i)
            lowPrice = array.get(lowPivots, array.size(lowPivots) - 1 - i)

            if highBar > lowBar
                line.new(lowBar, lowPrice, highBar, highPrice, color = bullColor, width = 2, style = line.style_solid)
            else
                line.new(highBar, highPrice, lowBar, lowPrice, color = bearColor, width = 2, style = line.style_solid)

// === CURRENT STATUS DISPLAY ===
var table statusTable = table.new(position.bottom_right, 2, 6, bgcolor = color.new(color.black, 85))

if barstate.islast
    // Status headers
    table.cell(statusTable, 0, 0, 'INDICATOR', text_color = color.white, bgcolor = color.new(color.gray, 50))
    table.cell(statusTable, 1, 0, 'STATUS', text_color = color.white, bgcolor = color.new(color.gray, 50))

    // RSI Status
    rsiStatus = rsi > 70 ? 'OVERBOUGHT' : rsi < 30 ? 'OVERSOLD' : 'NEUTRAL'
    rsiStatusColor = rsi > 70 ? bearColor : rsi < 30 ? bullColor : color.gray
    table.cell(statusTable, 0, 1, 'RSI (' + str.tostring(rsi, '#.#') + ')', text_color = color.white)
    table.cell(statusTable, 1, 1, rsiStatus, text_color = color.white, bgcolor = rsiStatusColor)

    // MACD Status
    macdStatus = macdBullish ? 'BULLISH' : macdBearish ? 'BEARISH' : 'NEUTRAL'
    macdStatusColor = macdBullish ? bullColor : macdBearish ? bearColor : color.gray
    table.cell(statusTable, 0, 2, 'MACD', text_color = color.white)
    table.cell(statusTable, 1, 2, macdStatus, text_color = color.white, bgcolor = macdStatusColor)

    // Volume Status
    volStatus = volRatio > 1.5 ? 'HIGH' : volRatio > 1 ? 'ABOVE AVG' : 'NORMAL'
    volStatusColor = volRatio > 1.5 ? color.orange : volRatio > 1 ? color.yellow : color.gray
    table.cell(statusTable, 0, 3, 'Volume (' + str.tostring(volRatio, '#.#x') + ')', text_color = color.white)
    table.cell(statusTable, 1, 3, volStatus, text_color = color.white, bgcolor = volStatusColor)

    // Trend Status (NEW)
    trendStatus = isBullishTrend ? 'BULLISH' : isBearishTrend ? 'BEARISH' : 'NEUTRAL'
    trendStatusColor = isBullishTrend ? bullColor : isBearishTrend ? bearColor : color.gray
    table.cell(statusTable, 0, 4, 'Trend (75 bars)', text_color = color.white)
    table.cell(statusTable, 1, 4, trendStatus, text_color = color.white, bgcolor = trendStatusColor)

    // Overall Signal
    overallSignal = totalScore > 3 ? 'STRONG BUY' : totalScore > 1 ? 'BUY' : totalScore < -3 ? 'STRONG SELL' : totalScore < -1 ? 'SELL' : 'NEUTRAL'
    signalColor = totalScore > 1 ? bullColor : totalScore < -1 ? bearColor : color.gray
    table.cell(statusTable, 0, 5, 'SIGNAL', text_color = color.white, bgcolor = color.new(color.yellow, 50))
    table.cell(statusTable, 1, 5, overallSignal, text_color = color.black, bgcolor = signalColor)

// === ALERTS ===
alertcondition(totalScore > 3, 'Strong Buy Signal', 'Elliott Wave Probability System: Strong Buy')
alertcondition(totalScore < -3, 'Strong Sell Signal', 'Elliott Wave Probability System: Strong Sell')
alertcondition(isBullishTrend and not isBullishTrend[1], 'Trend Changed to Bullish', 'Trend has turned Bullish')
alertcondition(isBearishTrend and not isBearishTrend[1], 'Trend Changed to Bearish', 'Trend has turned Bearish')

// === WAVE PROJECTION LINES ===
if barstate.islast and array.size(targetPrices) > 0
    // Draw projection lines to most probable targets
    for i = 0 to math.min(2, array.size(targetPrices) - 1) by 1
        target = array.get(targetPrices, i)
        prob = array.get(targetProbs, i)

        if prob > 40
            lineColor = color.new(target > close ? bullColor : bearColor, 70)
            line.new(bar_index, close, bar_index + 30, target, color = lineColor, style = line.style_dotted, width = 2)

            label.new(bar_index + 30, target, 'T' + str.tostring(i + 1) + ': ' + str.tostring(prob, '#.#') + '%', color = lineColor, style = label.style_label_left, textcolor = color.white, size = size.small)
