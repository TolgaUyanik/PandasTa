//@version=5
indicator("Previous Bar OHLC + 5m 20 EMA", overlay=true)

// Get 5-minute 20-bar EMA (regardless of current chart timeframe)
ema_5m_20 = request.security(syminfo.tickerid, "5", ta.ema(close, 20))[1]

// Previous Bar: Open, High, Low, Close
ohlc_txt = 'Open: ' + str.tostring(open[1]) + '\nHigh: ' + str.tostring(high[1]) + '\nLow: ' + str.tostring(low[1]) + '\nClose: ' + str.tostring(close[1])

// Previous 5m 20 EMA value
ema_txt = '5m 20-bar EMA: ' + str.tostring(ema_5m_20)

// Combine for output
label_txt = ohlc_txt + '\n' + ema_txt

// Draw label at the previous bar
var label ohlc_label = na
if na(ohlc_label)
    ohlc_label := label.new(x=bar_index - 1, y=high[1], text=label_txt, style=label.style_label_down, color=color.orange, textcolor=color.black)
else
    label.set_xy(ohlc_label, bar_index - 1, high[1])
    label.set_text(ohlc_label, label_txt)