//@version=6
indicator("Order-Flow Market Structure", overlay=true)
import TradingView/ta/10

// === User Inputs ====

htf = input.timeframe("", "HTF Timeframe")
useSafeOffsetLimit = input.bool(true, title="Use Safe History Offset Limit?")
maxSafeOffset      = input.int(550, title="Max Safe History Offset", minval=50, tooltip="Caps how far back we look to avoid buffer overflow errors.")
lineWidth = input.int(3, title="Width of Lines", minval=1, maxval= 10)
zigzagLineColor = input.color(color.black, title="ZigZag Line Color")
zigzagLineStyle = input.string("Solid", title="ZigZag Line Style", options=["Solid", "Dotted", "Dashed"])
bosBullishLineColor = input.color(color.green, title="Bullish BOS Line Color")
bosBearishLineColor = input.color(color.red, title="Bearish BOS Line Color")
bosLineStyle = input.string("Dotted", title="BOS Line Style", options=["Solid", "Dotted", "Dashed"])
bosLineStyleConst = bosLineStyle == "Solid" ? line.style_solid : bosLineStyle == "Dotted" ? line.style_dotted : line.style_dashed

// === Fibonacci Level Colors (Shared) ===
showDowntrendFibs = input.bool(true, title="Show Downtrend Fibonacci Lines")
showUptrendFibs = input.bool(true, title="Show Uptrend Fibonacci Lines")
fibColor_0     = input.color(color.new(color.white, 0), "Fibonacci 0.0 Color")
fibColor_236   = input.color(color.new(color.purple, 10), "Fibonacci 0.236 Color")
fibColor_382   = input.color(color.new(color.purple, 20), "Fibonacci 0.382 Color")
fibColor_500   = input.color(color.new(color.orange, 30), "Fibonacci 0.5 Color")
fibColor_618   = input.color(color.new(color.orange, 40), "Fibonacci 0.618 Color")
fibColor_786   = input.color(color.new(color.black, 50), "Fibonacci 0.786 Color")
fibColor_100   = input.color(color.new(color.white, 0), "Fibonacci 1.0 Color")
hhBackgroundColor = color.rgb(76, 175, 79, 100)
hhTextColor = color.green
lhBackgroundColor = color.rgb(0, 137, 123, 100)
lhTextColor = color.red
llBackgroundColor = color.rgb(255, 82, 82, 100)
llTextColor = color.red
hlBackgroundColor = color.rgb(255, 153, 0, 100)
hlTextColor = color.green
alertMode = input.string("MTF", title= "Enable/Disable for Any Alert() Function Call↓ Alert Status→", options= ["LTF", "MTF", "HTF"])
alertHighsandLows = input.bool(true, title= "Swing Highs & Lows")
alertBoS = input.bool(true, title= "BoS")

htf_open  = request.security(syminfo.tickerid, htf, open,  lookahead=barmerge.lookahead_on)
htf_high  = request.security(syminfo.tickerid, htf, high,  lookahead=barmerge.lookahead_on)
htf_low   = request.security(syminfo.tickerid, htf, low,   lookahead=barmerge.lookahead_on)
htf_close = request.security(syminfo.tickerid, htf, close, lookahead=barmerge.lookahead_on)
htf_hl2   = request.security(syminfo.tickerid, htf, hl2,   lookahead=barmerge.lookahead_on)
body_mid = (htf_open + htf_close) / 2

isHTFBarclose = ta.change(htf_close) != 0

var int HtfBarIndex = na
if isHTFBarclose
    HtfBarIndex := bar_index


isBullish = htf_close > htf_close[1]
isBearish = htf_close < htf_close[1]

isHigh =ta.highest(HtfBarIndex[1])
isLow = ta.lowest(HtfBarIndex[1])

//Internal Structure Logic
var int bullishCount = 0
var int bearishCount = 0
var float lowestBullishPrice = na
var float highestBearishPrice = na
var float firstBullishOpen = na
var float firstBearishOpen = na
var int lastInternalShift = 0
var int lastLowIndex = na
var int lastHighIndex = na
var float lastSwingHigh = na
var float lastSwingLow = na
var float lastBullishInternalShiftPrice = na
var float lastBearishInternalShiftPrice = na
var float currentSwingHigh = na
var int currentSwingHighIndex = na
var float currentSwingLow = na
var int currentSwingLowIndex = na
var float prevSwingHigh = na
var float prevSwingLow = na
var bool isHH = false
var bool isHL = false
var bool isLL = false
var bool isLH = false
var bool isLiquiditySweep = false
var float lastOpposingLow = na  // For HH
var float lastOpposingHigh = na // For LL
var bool bullishBOSOccurred = false
var bool bearishBOSOccurred = false

internalShiftBullish = isBullish
internalShiftBearish = isBearish

allowInternalShiftBearish = internalShiftBearish and lastInternalShift != -1
allowInternalShiftBullish = internalShiftBullish and lastInternalShift != 1

var bool plotBearishInternalShift = false
var bool plotBullishInternalShift = false
var int lastBullishShiftBar = na
var int lastBearishShiftBar = na



// === Determine Internal Svar int lastBullishShiftBar = na
plotBearishInternalShift := false
plotBullishInternalShift := false

if allowInternalShiftBearish
    plotBearishInternalShift := true
    lastBearishShiftBar := bar_index
    lastInternalShift := -1

if allowInternalShiftBullish
    plotBullishInternalShift := true
    lastBullishShiftBar := bar_index
    lastInternalShift := 1

// === Plot internal shift markers ===
plotshape(plotBullishInternalShift, title="Bullish Internal Shift", location=location.belowbar, color=color.rgb(54, 58, 69, 75), style=shape.triangleup, size=size.tiny)
plotshape(plotBearishInternalShift, title="Bearish Internal Shift", location=location.abovebar, color=color.rgb(54, 58, 69, 75), style=shape.triangledown, size=size.tiny)

// === Persistent variables for multiple line handling ===
var line[] zigzagLines = array.new<line>()
var float lastZigzagPrice = na
var string lastSwingType = ""
var bool drawBullishBOSLabel = false
var bool drawBearishBOSLabel = false




// Save shift bar indices
if plotBearishInternalShift
    lastBearishShiftBar := bar_index
if plotBullishInternalShift
    lastBullishShiftBar := bar_index

// === Track Break of Structure (BOS) markers ===
// Initialize flags as mutable var variables
var bool plotBullishBOS = false
var bool plotBearishBOS = false

// === Conditions to plot the BOS markers ===
// Bullish BOS (Only plot the first candle breaking the swing high)
if not na(lastSwingHigh) and close > lastSwingHigh and not plotBullishBOS
    plotBullishBOS := true

// Bearish BOS (Only plot the first candle breaking the swing low)
if not na(lastSwingLow) and close < lastSwingLow and not plotBearishBOS
    plotBearishBOS := true  // Set the flag to true after the first BOS

// Modify these flags
var line bullishBOSLine = na
var line bearishBOSLine = na

// === Plot Break of Structure (BOS) with horizontal lines ===

// === Conditions to plot the BOS markers ===
// Bullish BOS (Previous candle must open below the swing high, current breaks it)
if not na(lastSwingHigh) and open[1] < lastSwingHigh and close > lastSwingHigh and na(bullishBOSLine)
    bullishBOSOccurred := true
    bullishBOSLine := line.new(x1=lastHighIndex, y1=lastSwingHigh, x2=bar_index, y2=lastSwingHigh, color=bosBullishLineColor, width= lineWidth, style=bosLineStyleConst)
    lastSwingHigh := na
    drawBullishBOSLabel := true

// Bearish BOS (Previous candle must open above the swing low, current breaks it)
if not na(lastSwingLow) and open[1] > lastSwingLow and close < lastSwingLow and na(bearishBOSLine)
    bearishBOSOccurred := true
    bearishBOSLine := line.new(x1=lastLowIndex, y1=lastSwingLow, x2=bar_index, y2=lastSwingLow, color=bosBearishLineColor, width=lineWidth, style=bosLineStyleConst)
    lastSwingLow := na
    drawBearishBOSLabel := true


// Optionally reset lines after new swings are formed, if needed
if close < lastSwingHigh
    bullishBOSLine := na  // Reset bullish BOS line when a new swing high is formed

if close > lastSwingLow
    bearishBOSLine := na  // Reset bearish BOS line when a new swing low is formed


// Bearish shift followed by Bullish shift → Track lowest low
if plotBullishInternalShift and not na(lastBearishShiftBar)
    shiftLength = bar_index - lastBearishShiftBar
    loopLimit = useSafeOffsetLimit ? math.min(shiftLength, maxSafeOffset) : shiftLength
    if shiftLength <= 10000
        lowest = htf_low
        lowIndex = bar_index
        for i = 0 to loopLimit
            if htf_low[i] < lowest
                lowest := htf_low[i]
                lowIndex := bar_index - i

        // Plot zigzag line
                // Plot zigzag line for LL and HL separately
        if not na(prevSwingLow)
            if lowest < prevSwingLow  // LL
                if zigzagLineStyle == "Solid"
                    line.new(x1=lastHighIndex, y1=prevSwingHigh, x2=lowIndex, y2=lowest, color=zigzagLineColor, width=lineWidth, style=line.style_solid)
                else if zigzagLineStyle == "Dotted"
                    line.new(x1=lastHighIndex, y1=prevSwingHigh, x2=lowIndex, y2=lowest, color=zigzagLineColor, width=lineWidth, style=line.style_dotted)
                else if zigzagLineStyle == "Dashed"
                    line.new(x1=lastHighIndex, y1=prevSwingHigh, x2=lowIndex, y2=lowest, color=zigzagLineColor, width=lineWidth, style=line.style_dashed)

            else  // LH
                if zigzagLineStyle == "Solid"
                    line.new(x1=lastHighIndex, y1=prevSwingHigh, x2=lowIndex, y2=lowest, color=zigzagLineColor, width=lineWidth, style=line.style_solid)
                else if zigzagLineStyle == "Dotted"
                    line.new(x1=lastHighIndex, y1=prevSwingHigh, x2=lowIndex, y2=lowest, color=zigzagLineColor, width=lineWidth, style=line.style_dotted)
                else if zigzagLineStyle == "Dashed"
                    line.new(x1=lastHighIndex, y1=prevSwingHigh, x2=lowIndex, y2=lowest, color=zigzagLineColor, width=lineWidth, style=line.style_dashed)


        // Update swing low and plot label (HL or LL)
        if not na(prevSwingLow)
            isLL := not na(prevSwingLow) and lowest < prevSwingLow
            isHL := not na(prevSwingLow) and lowest > prevSwingLow
        if isLL
            label.new(lowIndex, lowest, "LL", color=llBackgroundColor, style=label.style_label_up, textcolor=llTextColor, size=size.small)
        if isHL
            label.new(lowIndex, lowest, "HL", color=hlBackgroundColor, style=label.style_label_up, textcolor=hlTextColor, size=size.small)
        lastOpposingHigh := prevSwingHigh

        prevSwingLow := lowest

        lastZigzagPrice := lowest
        lastSwingLow := lowest
        lastLowIndex := lowIndex

// Bullish shift followed by Bearish shift → Track highest high
if plotBearishInternalShift and not na(lastBullishShiftBar)
    shiftLength = bar_index - lastBullishShiftBar
    loopLimit = useSafeOffsetLimit ? math.min(shiftLength, maxSafeOffset) : shiftLength
    if shiftLength <= 10000
        highest = htf_high
        highIndex = bar_index
        for i = 0 to loopLimit
            if htf_high[i] > highest
                highest := htf_high[i]
                highIndex := bar_index - i

        // Plot zigzag line
        if not na(prevSwingHigh)
            if highest > prevSwingHigh  // HH
                if zigzagLineStyle == "Solid"
                    line.new(x1=lastLowIndex, y1=prevSwingLow, x2=highIndex, y2=highest, color=zigzagLineColor, width=lineWidth, style=line.style_solid)
                else if zigzagLineStyle == "Dotted"
                    line.new(x1=lastLowIndex, y1=prevSwingLow, x2=highIndex, y2=highest, color=zigzagLineColor, width=lineWidth, style=line.style_dotted)
                else if zigzagLineStyle == "Dashed"
                    line.new(x1=lastLowIndex, y1=prevSwingLow, x2=highIndex, y2=highest, color=zigzagLineColor, width=lineWidth, style=line.style_dashed)

            else  // LH
                if zigzagLineStyle == "Solid"
                    line.new(x1=lastLowIndex, y1=prevSwingLow, x2=highIndex, y2=highest, color=zigzagLineColor, width=lineWidth, style=line.style_solid)
                else if zigzagLineStyle == "Dotted"
                    line.new(x1=lastLowIndex, y1=prevSwingLow, x2=highIndex, y2=highest, color=zigzagLineColor, width=lineWidth, style=line.style_dotted)
                else if zigzagLineStyle == "Dashed"
                    line.new(x1=lastLowIndex, y1=prevSwingLow, x2=highIndex, y2=highest, color=zigzagLineColor, width=lineWidth, style=line.style_dashed)

        // Update swing high and plot label (HH or LH)
        if not na(prevSwingHigh)
            isHH := not na(prevSwingHigh) and highest > prevSwingHigh
            isLH := not na(prevSwingHigh) and highest < prevSwingHigh
        if isHH
            label.new(highIndex, highest, "HH", color=hhBackgroundColor, style=label.style_label_down, textcolor=hhTextColor, size=size.small)
        if isLH
            label.new(highIndex, highest, "LH", color=lhBackgroundColor, style=label.style_label_down, textcolor=lhTextColor, size=size.small)
            lastOpposingLow := prevSwingLow

        prevSwingHigh := highest

        lastZigzagPrice := highest
        lastSwingHigh := highest
        lastHighIndex := highIndex

// === Line storage arrays ===
var line[] downtrendRetraceLines = array.new_line()
var line[] uptrendRetraceLines = array.new_line()

// === Helper function to delete lines ===
f_clear_lines(arr) =>
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            ln = array.get(arr, i)
            line.delete(ln)
        array.clear(arr)

// === Draw Bullish Fibonacci Lines ===
if showDowntrendFibs
    f_clear_lines(downtrendRetraceLines)
    fib0 = ta.lowestSince(plotBearishInternalShift, low)
    fib100 = lastSwingHigh
    array.push(downtrendRetraceLines, line.new(lastHighIndex, fib0, bar_index, fib0, color=fibColor_0, width=lineWidth))
    array.push(downtrendRetraceLines, line.new(lastHighIndex, fib0 + (fib100 - fib0) * 0.236, bar_index, fib0 + (fib100 - fib0) * 0.236, color=fibColor_236, width=lineWidth))
    array.push(downtrendRetraceLines, line.new(lastHighIndex, fib0 + (fib100 - fib0) * 0.382, bar_index, fib0 + (fib100 - fib0) * 0.382, color=fibColor_382, width=lineWidth))
    array.push(downtrendRetraceLines, line.new(lastHighIndex, fib0 + (fib100 - fib0) * 0.5, bar_index, fib0 + (fib100 - fib0) * 0.5, color=fibColor_500, width=lineWidth))
    array.push(downtrendRetraceLines, line.new(lastHighIndex, fib0 + (fib100 - fib0) * 0.618, bar_index, fib0 + (fib100 - fib0) * 0.618, color=fibColor_618, width=lineWidth))
    array.push(downtrendRetraceLines, line.new(lastHighIndex, fib0 + (fib100 - fib0) * 0.786, bar_index, fib0 + (fib100 - fib0) * 0.786, color=fibColor_786, width=lineWidth))
    array.push(downtrendRetraceLines, line.new(lastHighIndex, fib100, bar_index, fib100, color=fibColor_100, width=lineWidth))

// === Draw Bearish Fibonacci Lines ===
if showUptrendFibs
    f_clear_lines(uptrendRetraceLines)
    fib0 = ta.highestSince(plotBullishInternalShift, high)
    fib100 = lastSwingLow
    array.push(uptrendRetraceLines, line.new(lastLowIndex, fib0, bar_index, fib0, color=fibColor_0, width=lineWidth))
    array.push(uptrendRetraceLines, line.new(lastLowIndex, fib0 - (fib0 - fib100) * 0.236, bar_index, fib0 - (fib0 - fib100) * 0.236, color=fibColor_236, width=lineWidth))
    array.push(uptrendRetraceLines, line.new(lastLowIndex, fib0 - (fib0 - fib100) * 0.382, bar_index, fib0 - (fib0 - fib100) * 0.382, color=fibColor_382, width=lineWidth))
    array.push(uptrendRetraceLines, line.new(lastLowIndex, fib0 - (fib0 - fib100) * 0.5, bar_index, fib0 - (fib0 - fib100) * 0.5, color=fibColor_500, width=lineWidth))
    array.push(uptrendRetraceLines, line.new(lastLowIndex, fib0 - (fib0 - fib100) * 0.618, bar_index, fib0 - (fib0 - fib100) * 0.618, color=fibColor_618, width=lineWidth))
    array.push(uptrendRetraceLines, line.new(lastLowIndex, fib0 - (fib0 - fib100) * 0.786, bar_index, fib0 - (fib0 - fib100) * 0.786, color=fibColor_786, width=lineWidth))
    array.push(uptrendRetraceLines, line.new(lastLowIndex, fib100, bar_index, fib100, color=fibColor_100, width=lineWidth))

// === Alerts ===
alertcondition(isHH, title="Higher High Detected", message="Higher High (HH) detected!")
alertcondition(isLH, title="Lower High Detected", message="Lower High (LH) detected!")
alertcondition(isLL, title="Lower Low Detected", message="Lower Low (LL) detected!")
alertcondition(isHL, title="Higher Low Detected", message="Higher Low (HL) detected!")

// === Bullish Fibonacci Cross Logic ===
crossedDowntrendFibLevel(fibLevel) =>
    showDowntrendFibs and not na(fibLevel) and close[1] < fibLevel and close > fibLevel

// === Bearish Fibonacci Cross Logic ===
crossedUptrendFibLevel(fibLevel) =>
    showUptrendFibs and not na(fibLevel) and close[1] > fibLevel and close < fibLevel

// --- Bullish Fibs Cross Conditions
fib0_bull  = crossedDowntrendFibLevel(lastSwingLow)
fib236_bull = crossedDowntrendFibLevel(lastSwingLow + (lastSwingHigh - lastSwingLow) * 0.236)
fib382_bull = crossedDowntrendFibLevel(lastSwingLow + (lastSwingHigh - lastSwingLow) * 0.382)
fib500_bull = crossedDowntrendFibLevel(lastSwingLow + (lastSwingHigh - lastSwingLow) * 0.5)
fib618_bull = crossedDowntrendFibLevel(lastSwingLow + (lastSwingHigh - lastSwingLow) * 0.618)
fib786_bull = crossedDowntrendFibLevel(lastSwingLow + (lastSwingHigh - lastSwingLow) * 0.786)
fib100_bull = crossedDowntrendFibLevel(lastSwingHigh)

// --- Bearish Fibs Cross Conditions
fib0_bear  = crossedUptrendFibLevel(lastSwingHigh)
fib236_bear = crossedUptrendFibLevel(lastSwingHigh - (lastSwingHigh - lastSwingLow) * 0.236)
fib382_bear = crossedUptrendFibLevel(lastSwingHigh - (lastSwingHigh - lastSwingLow) * 0.382)
fib500_bear = crossedUptrendFibLevel(lastSwingHigh - (lastSwingHigh - lastSwingLow) * 0.5)
fib618_bear = crossedUptrendFibLevel(lastSwingHigh - (lastSwingHigh - lastSwingLow) * 0.618)
fib786_bear = crossedUptrendFibLevel(lastSwingHigh - (lastSwingHigh - lastSwingLow) * 0.786)
fib100_bear = crossedUptrendFibLevel(lastSwingLow)

// === Bullish Alerts
alertcondition(fib0_bull, title="Downtrend Fib 0.0 Break", message="Price crossed downtrend Fibonacci 0.0 level")
alertcondition(fib236_bull, title="Downtrend Fib 0.236 Break", message="Price crossed downtrend Fibonacci 0.236 level")
alertcondition(fib382_bull, title="Downtrend Fib 0.382 Break", message="Price crossed downtrend Fibonacci 0.382 level")
alertcondition(fib500_bull, title="Downtrend Fib 0.5 Break", message="Price crossed downtrend Fibonacci 0.5 level")
alertcondition(fib618_bull, title="Downtrend Fib 0.618 Break", message="Price crossed downtrend Fibonacci 0.618 level")
alertcondition(fib786_bull, title="Downtrend Fib 0.786 Break", message="Price crossed downtrend Fibonacci 0.786 level")
alertcondition(fib100_bull, title="Downtrend Fib 1.0 Break", message="Price crossed downtrend Fibonacci 1.0 level")

// === Uptrend Alerts
alertcondition(fib0_bear, title="Uptrend Fib 0.0 Break", message="Price crossed uptrend Fibonacci 0.0 level")
alertcondition(fib236_bear, title="Uptrend Fib 0.236 Break", message="Price crossed uptrend Fibonacci 0.236 level")
alertcondition(fib382_bear, title="Uptrend Fib 0.382 Break", message="Price crossed uptrend Fibonacci 0.382 level")
alertcondition(fib500_bear, title="Uptrend Fib 0.5 Break", message="Price crossed uptrend Fibonacci 0.5 level")
alertcondition(fib618_bear, title="Uptrend Fib 0.618 Break", message="Price crossed uptrend Fibonacci 0.618 level")
alertcondition(fib786_bear, title="Uptrend Fib 0.786 Break", message="Price crossed uptrend Fibonacci 0.786 level")
alertcondition(fib100_bear, title="Uptrend Fib 1.0 Break", message="Price crossed uptrend Fibonacci 1.0 level")


// === Alerts ===
alertcondition(drawBullishBOSLabel, title="Bullish Break of Structure", message="Bullish Break of Structure detected!")
alertcondition(drawBearishBOSLabel, title="Bearish Break of Structure", message="Bearish Break of Structure detected!")
alertcondition(isHH and plotBearishInternalShift, title="Higher High (HH)", message="Higher High (HH) detected")
alertcondition(isHL and plotBullishInternalShift, title="Higher Low (HL)", message="Higher Low (HL) detected")
alertcondition(isLL and plotBullishInternalShift, title="Lower Low (LL)", message="Lower Low (LL) detected")
alertcondition(isLH and plotBearishInternalShift, title="Lower High (LH)", message="Lower High (LH) detected")

// === Alerts ===
if alertMode == "LTF"
    if isHH and plotBearishInternalShift and not isLiquiditySweep and (alertHighsandLows == true)
        alert("Higher High (HH) detected (LTF)", alert.freq_once_per_bar_close)

    if isHL and plotBullishInternalShift and (alertHighsandLows == true)
        alert("Higher Low (HL) detected (LTF)", alert.freq_once_per_bar_close)

    if isLL and plotBullishInternalShift and not isLiquiditySweep and (alertHighsandLows == true)
        alert("Lower Low (LL) detected (LTF)" , alert.freq_once_per_bar_close)

    if isLH and plotBearishInternalShift and (alertHighsandLows == true)
        alert("Lower High (LH) detected (LTF)", alert.freq_once_per_bar_close)

    if drawBullishBOSLabel and (alertBoS == true)
        alert("Bullish BoS detected. (LTF)", alert.freq_once_per_bar_close)

    if drawBearishBOSLabel and (alertBoS == true)
        alert("Bearish BoS detected. (LTF)", alert.freq_once_per_bar_close)

if alertMode == "MTF"
    if isHH and plotBearishInternalShift and not isLiquiditySweep and (alertHighsandLows == true)
        alert("Higher High (HH) detected (MTF)", alert.freq_once_per_bar_close)

    if isHL and plotBullishInternalShift and (alertHighsandLows == true)
        alert("Higher Low (HL) detected (MTF)", alert.freq_once_per_bar_close)

    if isLL and plotBullishInternalShift and not isLiquiditySweep and (alertHighsandLows == true)
        alert("Lower Low (LL) detected (MTF)" , alert.freq_once_per_bar_close)

    if isLH and plotBearishInternalShift and (alertHighsandLows == true)
        alert("Lower High (LH) detected (MTF)", alert.freq_once_per_bar_close)

    if drawBullishBOSLabel and (alertBoS == true)
        alert("Bullish BoS detected. (MTF)", alert.freq_once_per_bar_close)

    if drawBearishBOSLabel and (alertBoS == true)
        alert("Bearish BoS detected. (MTF)", alert.freq_once_per_bar_close)



if alertMode == "HTF"
    if isHH and plotBearishInternalShift and not isLiquiditySweep and (alertHighsandLows == true)
        alert("Higher High (HH) detected (HTF)", alert.freq_once_per_bar_close)

    if isHL and plotBullishInternalShift and (alertHighsandLows == true)
        alert("Higher Low (HL) detected (HTF)", alert.freq_once_per_bar_close)

    if isLL and plotBullishInternalShift and not isLiquiditySweep and (alertHighsandLows == true)
        alert("Lower Low (LL) detected (HTF)" , alert.freq_once_per_bar_close)

    if isLH and plotBearishInternalShift and (alertHighsandLows == true)
        alert("Lower High (LH) detected (HTF)", alert.freq_once_per_bar_close)

    if drawBullishBOSLabel and (alertBoS == true)
        alert("Bullish BoS detected. (HTF)", alert.freq_once_per_bar_close)

    if drawBearishBOSLabel and (alertBoS == true)
        alert("Bearish BoS detected. (HTF)", alert.freq_once_per_bar_close)




