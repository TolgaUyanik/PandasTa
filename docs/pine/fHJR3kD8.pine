//@version=6
indicator('EMA 377 MULTI-MTF)', shorttitle = 'EMA377_MULTI_MTF', overlay = true)

// ==========================================
// USER INPUTS & CUSTOMIZATION
// ==========================================

// --- Shared Core Settings ---
grp_core = 'Core EMA & Fibonacci Settings'
emaLength = input.int(377, title = 'EMA Period', group = grp_core)
fib1 = input.float(1.618, title = 'Level 1 (%)', group = grp_core) / 100
fib2 = input.float(2.360, title = 'Level 2 (%)', group = grp_core) / 100
fib3 = input.float(3.820, title = 'Level 3 (%)', group = grp_core) / 100
fib4 = input.float(6.180, title = 'Level 4 (%) [Default Active]', group = grp_core) / 100

// Visibility Toggles for Inner Levels (Applies to all TFs)
showFib1 = input.bool(false, title = 'Show Level 1 (%1.618)', group = grp_core)
showFib2 = input.bool(false, title = 'Show Level 2 (%2.360)', group = grp_core)
showFib3 = input.bool(false, title = 'Show Level 3 (%3.820)', group = grp_core)

// --- Timeframe 1 Settings (Default: Active / Daily) ---
grp_tf1 = 'Timeframe 1 Settings (Primary)'
useTF1 = input.bool(true, title = 'Enable Timeframe 1', group = grp_tf1)
tf1Input = input.timeframe('D', title = 'Timeframe 1', group = grp_tf1)
tf1EmaColor = input.color(color.white, title = 'EMA Color', group = grp_tf1)
tf1UpColor = input.color(color.green, title = 'Upper Band Color', group = grp_tf1)
tf1LowColor = input.color(color.red, title = 'Lower Band Color', group = grp_tf1)
tf1FillColor = input.color(color.new(color.blue, 95), title = 'Channel Fill Color', group = grp_tf1)

// --- Timeframe 2 Settings (Default: Disabled / Monthly) ---
grp_tf2 = 'Timeframe 2 Settings (Secondary)'
useTF2 = input.bool(false, title = 'Enable Timeframe 2', group = grp_tf2)
tf2Input = input.timeframe('M', title = 'Timeframe 2', group = grp_tf2)
tf2EmaColor = input.color(color.yellow, title = 'EMA Color', group = grp_tf2)
tf2UpColor = input.color(color.teal, title = 'Upper Band Color', group = grp_tf2)
tf2LowColor = input.color(color.maroon, title = 'Lower Band Color', group = grp_tf2)
tf2FillColor = input.color(color.new(color.purple, 95), title = 'Channel Fill Color', group = grp_tf2)

// --- Timeframe 3 Settings (Default: Disabled / Weekly) ---
grp_tf3 = 'Timeframe 3 Settings (Tertiary)'
useTF3 = input.bool(false, title = 'Enable Timeframe 3', group = grp_tf3)
tf3Input = input.timeframe('W', title = 'Timeframe 3', group = grp_tf3)
tf3EmaColor = input.color(color.orange, title = 'EMA Color', group = grp_tf3)
tf3UpColor = input.color(color.lime, title = 'Upper Band Color', group = grp_tf3)
tf3LowColor = input.color(color.fuchsia, title = 'Lower Band Color', group = grp_tf3)
tf3FillColor = input.color(color.new(color.orange, 95), title = 'Channel Fill Color', group = grp_tf3)

// ==========================================
// CALCULATIONS & FUNCTIONS
// ==========================================

calcEma() =>
    ta.ema(close, emaLength)

// Timeframe 1 Calculations
ema1 = useTF1 ? request.security(syminfo.tickerid, tf1Input, calcEma(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off) : na
u1_4 = ema1 * (1 + fib4)
u1_3 = ema1 * (1 + fib3)
u1_2 = ema1 * (1 + fib2)
u1_1 = ema1 * (1 + fib1)
l1_1 = ema1 * (1 - fib1)
l1_2 = ema1 * (1 - fib2)
l1_3 = ema1 * (1 - fib3)
l1_4 = ema1 * (1 - fib4)

// Timeframe 2 Calculations
ema2 = useTF2 ? request.security(syminfo.tickerid, tf2Input, calcEma(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off) : na
u2_4 = ema2 * (1 + fib4)
u2_3 = ema2 * (1 + fib3)
u2_2 = ema2 * (1 + fib2)
u2_1 = ema2 * (1 + fib1)
l2_1 = ema2 * (1 - fib1)
l2_2 = ema2 * (1 - fib2)
l2_3 = ema2 * (1 - fib3)
l2_4 = ema2 * (1 - fib4)

// Timeframe 3 Calculations
ema3 = useTF3 ? request.security(syminfo.tickerid, tf3Input, calcEma(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off) : na
u3_4 = ema3 * (1 + fib4)
u3_3 = ema3 * (1 + fib3)
u3_2 = ema3 * (1 + fib2)
u3_1 = ema3 * (1 + fib1)
l3_1 = ema3 * (1 - fib1)
l3_2 = ema3 * (1 - fib2)
l3_3 = ema3 * (1 - fib3)
l3_4 = ema3 * (1 - fib4)

// Display Controls
disp1 = showFib1 ? display.all : display.none
disp2 = showFib2 ? display.all : display.none
disp3 = showFib3 ? display.all : display.none

// ==========================================
// PLOTTING TIMEFRAME 1
// ==========================================

pEma1 = plot(ema1, title = 'TF1 EMA', color = tf1EmaColor, linewidth = 2)
pu1_4 = plot(u1_4, title = 'TF1 Upper +6.18%', color = tf1UpColor, linewidth = 2)
pl1_4 = plot(l1_4, title = 'TF1 Lower -6.18%', color = tf1LowColor, linewidth = 2)

plot(u1_3, title = 'TF1 Upper +3.82%', color = color.new(tf1UpColor, 30), display = disp3)
plot(u1_2, title = 'TF1 Upper +2.36%', color = color.new(tf1UpColor, 40), display = disp2)
plot(u1_1, title = 'TF1 Upper +1.61%', color = color.new(tf1UpColor, 50), display = disp1)
plot(l1_1, title = 'TF1 Lower -1.61%', color = color.new(tf1LowColor, 50), display = disp1)
plot(l1_2, title = 'TF1 Lower -2.36%', color = color.new(tf1LowColor, 40), display = disp2)
plot(l1_3, title = 'TF1 Lower -3.82%', color = color.new(tf1LowColor, 30), display = disp3)

fill(pu1_4, pl1_4, color = tf1FillColor, title = 'TF1 Channel Fill')

// ==========================================
// PLOTTING TIMEFRAME 2
// ==========================================

pEma2 = plot(ema2, title = 'TF2 EMA', color = tf2EmaColor, linewidth = 2)
pu2_4 = plot(u2_4, title = 'TF2 Upper +6.18%', color = tf2UpColor, linewidth = 2)
pl2_4 = plot(l2_4, title = 'TF2 Lower -6.18%', color = tf2LowColor, linewidth = 2)

plot(u2_3, title = 'TF2 Upper +3.82%', color = color.new(tf2UpColor, 30), display = disp3)
plot(u2_2, title = 'TF2 Upper +2.36%', color = color.new(tf2UpColor, 40), display = disp2)
plot(u2_1, title = 'TF2 Upper +1.61%', color = color.new(tf2UpColor, 50), display = disp1)
plot(l2_1, title = 'TF2 Lower -1.61%', color = color.new(tf2LowColor, 50), display = disp1)
plot(l2_2, title = 'TF2 Lower -2.36%', color = color.new(tf2LowColor, 40), display = disp2)
plot(l2_3, title = 'TF2 Lower -3.82%', color = color.new(tf2LowColor, 30), display = disp3)

fill(pu2_4, pl2_4, color = tf2FillColor, title = 'TF2 Channel Fill')

// ==========================================
// PLOTTING TIMEFRAME 3
// ==========================================

pEma3 = plot(ema3, title = 'TF3 EMA', color = tf3EmaColor, linewidth = 2)
pu3_4 = plot(u3_4, title = 'TF3 Upper +6.18%', color = tf3UpColor, linewidth = 2)
pl3_4 = plot(l3_4, title = 'TF3 Lower -6.18%', color = tf3LowColor, linewidth = 2)

plot(u3_3, title = 'TF3 Upper +3.82%', color = color.new(tf3UpColor, 30), display = disp3)
plot(u3_2, title = 'TF3 Upper +2.36%', color = color.new(tf3UpColor, 40), display = disp2)
plot(u3_1, title = 'TF3 Upper +1.61%', color = color.new(tf3UpColor, 50), display = disp1)
plot(l3_1, title = 'TF3 Lower -1.61%', color = color.new(tf3LowColor, 50), display = disp1)
plot(l3_2, title = 'TF3 Lower -2.36%', color = color.new(tf3LowColor, 40), display = disp2)
plot(l3_3, title = 'TF3 Lower -3.82%', color = color.new(tf3LowColor, 30), display = disp3)

fill(pu3_4, pl3_4, color = tf3FillColor, title = 'TF3 Channel Fill')
