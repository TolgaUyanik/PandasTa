//@version=6
library("ChopEngine")

export chopBase(series float _high = high, series float _low  = low, simple int   _len  = 14) =>
    float rng     = ta.highest(_high, _len) - ta.lowest(_low, _len)
    float atrSum  = math.sum(ta.atr(1), _len)
    // Guard: prevent log(0) on flat / halted instruments
    float safeRng = rng == 0 ? 1e-10 : rng
    100.0 * math.log10(atrSum / safeRng) / math.log10(_len)

export gaugeFromCi(series float _ci, simple float _tl = 38.2, simple float _cl = 61.8) =>
    float rng = _cl - _tl
    math.max(0.0, math.min(2.0, (_ci - _tl) / rng))

export chopGauge(series float _high = high, series float _low  = low, simple float _tl   = 38.2, simple float _cl   = 61.8, simple int   _len  = 14) =>
    gaugeFromCi(chopBase(_high, _low, _len), _tl, _cl)

export getChopBase(simple string _sym = syminfo.tickerid, simple string _tf  = "15") =>
    request.security(_sym, _tf,[chopBase(high, low), chopBase(high, low)[1]], lookahead = barmerge.lookahead_on, gaps = barmerge.gaps_off)

export getChop(simple float _ciPrev, simple float _ci, simple float  _tl  = 38.2, simple float  _cl  = 61.8) =>
	[gaugeFromCi(_ci, _tl, _cl), gaugeFromCi(_ciPrev, _tl, _cl)]

export chgStateLabel(float _g) =>
    _g >= 0.75 ? "Strong Chop"  : _g >= 0.55 ? "Choppy" : _g <= 0.25 ? "Strong Trend" : _g <= 0.45 ? "Trend"  : "Neutral"

export chgColor(float _chg) =>
    na(_chg)  ? color.gray  : _chg > 0  ? color.red   : _chg < 0  ? color.green : color.gray

export chgCell(float _chg, string _prefix) =>
    string arrow = _chg > 0  ? "▲ "  : _chg < 0  ? "▼ "  : "— "
    string val   = str.tostring(math.round(math.abs(nz(_chg)), 2))
    string txt   = na(_chg)  ? _prefix + ": —" : _prefix + ": " + arrow + val
    color  bg    = chgColor(_chg)
    [txt, bg]

export type Chop
    float now   // current gauge  (0 = trend … 1 = chop)
    float prev  // previous bar gauge at the chosen timeframe
    float eod   // session / period boundary gauge (set externally)

export method init(Chop this, float _ciPrev, float _ci, simple float  _tl  = 38.2, simple float  _cl  = 61.8) =>
    this.eod  := gaugeFromCi(_ciPrev, _tl, _cl)
	this.prev := this.eod
	this.now  := gaugeFromCi(_ci, _tl, _cl)

export method update(Chop this, float _ciPrev, float _ci, simple float  _tl  = 38.2, simple float  _cl  = 61.8) =>
    this.prev  := gaugeFromCi(_ciPrev, _tl, _cl)
	this.now  := gaugeFromCi(_ci, _tl, _cl)

export method chgVsPrev(Chop this) =>
    na(this.prev) ? na : this.now - this.prev

export method chgVsEod(Chop this) =>
    na(this.eod) ? na : this.now - this.eod

export method state(Chop this) =>
    chgStateLabel(nz(this.now))

export method isTrending(Chop this) =>
    not na(this.now) and this.now <= 0
export method isChoppy(Chop this) =>
    not na(this.now) and this.now >= 0.55

export method isImproving(Chop this) =>
    not na(this.now) and not na(this.prev) and this.now < this.prev

export method isDeteriorating(Chop this) =>
    not na(this.now) and not na(this.prev) and this.now > this.prev