//@version=6
//indicator("My script")

//@version=5
//@version=5
strategy("9/21 EMA + VWAP + Volume Spike + Bollinger Bands", overlay=true)

// Inputs
emaFastLen    = input.int(9, "Fast EMA Length")
emaSlowLen    = input.int(21, "Slow EMA Length")
volLookback   = input.int(20, "Avg Volume Lookback")
volMultiplier = input.float(1.5, "Volume Multiplier")

// Bollinger Band Inputs
bbLength = input.int(21, "BB Length")
bbStdDev = input.float(2.0, "BB StdDev")

// Indicators
emaFast   = ta.ema(close, emaFastLen)
emaSlow   = ta.ema(close, emaSlowLen)
vwapValue = ta.vwap(close)

// Plot EMAs
plot(emaFast, color=color.green, linewidth=2, title="EMA 9")
plot(emaSlow, color=color.red, linewidth=2, title="EMA 21")

// Plot VWAP
plot(vwapValue, color=color.purple, linewidth=2, title="VWAP")

// Bollinger Bands using EMA
bbBasis = ta.ema(close, bbLength)
bbDev   = ta.stdev(close, bbLength) * bbStdDev
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev

// Plot Bollinger Bands
pBasis = plot(bbBasis, color=color.orange, title="BB Basis (EMA)")
pUpper = plot(bbUpper, color=color.blue, title="BB Upper")
pLower = plot(bbLower, color=color.blue, title="BB Lower")

// Fill Bands
fill(pUpper, pLower, color=color.new(color.blue, 90))

// Volume
avgVol     = ta.sma(volume, volLookback)
highVolume = volume >= avgVol * volMultiplier

// EMA Crosses
bullishCross = ta.crossover(emaFast, emaSlow)
bearishCross = ta.crossunder(emaFast, emaSlow)

// Buy & Sell Conditions
buySignal  = bullishCross and highVolume
sellSignal = bearishCross and highVolume

// Debug Labels (EMA cross regardless of volume)
if bullishCross
    label.new(
         bar_index,
         low,
         "BUY",
         color=color.new(color.green, 0),
         style=label.style_label_up,
         textcolor=color.white)

if bearishCross
    label.new(
         bar_index,
         high,
         "SELL",
         color=color.new(color.red, 0),
         style=label.style_label_down,
         textcolor=color.white)

// True Buy/Sell Signals (EMA cross + volume spike)
if buySignal
    label.new(
         bar_index,
         low,
         "BUY",
         color=color.green,
         style=label.style_label_up,
         textcolor=color.white)

if sellSignal
    label.new(
         bar_index,
         high,
         "SELL",
         color=color.red,
         style=label.style_label_down,
         textcolor=color.white)

// Strategy Entries
if buySignal
    strategy.entry("Long", strategy.long)

if sellSignal
    strategy.close("Long")

/// Alerts
alertcondition(
     buySignal,
     title="Buy Signal",
     message="9 EMA crossed above 21 EMA with volume spike")

alertcondition(
     sellSignal,
     title="Sell Signal",
     message="9 EMA crossed below 21 EMA with volume spike")