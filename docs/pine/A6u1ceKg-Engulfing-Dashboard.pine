//@version=6
indicator("Engulfing Dashboard", overlay=true, precision=0)

// === Dashboard Settings ===
show_dashboard = input.bool(true, "Show Dashboard", group="Dashboard")
dashboard_size = input.string("medium", "Size", options=["small", "medium", "large"], group="Dashboard")

// === Helper Functions ===
get_engulfing_status(timeframe) =>
    // Get data from the specified timeframe
    [h, l, o, c] = request.security(syminfo.tickerid, timeframe, [high, low, open, close])
    
    // Determine if current candle is bearish or bullish
    is_bearish = c < o
    is_bullish = c > o
    
    // Check if this is an Engulfing pattern
    // For now, we'll show the basic direction (Buy/Sell based on current candle)
    if is_bullish
        "BUY"
    else if is_bearish
        "SELL"
    else
        "NEUTRAL"

// === Get Engulfing Status for Each Timeframe ===
daily_status = get_engulfing_status("D")
weekly_status = get_engulfing_status("W")
monthly_status = get_engulfing_status("M")
h4_status = get_engulfing_status("240")
m30_status = get_engulfing_status("30")

// === Create Dashboard ===
if show_dashboard
    var table dashboard = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 80), border_width=1, border_color=color.white)
    
    // Determine text size based on dashboard size setting
    text_size = dashboard_size == "small" ? size.tiny : dashboard_size == "medium" ? size.small : size.normal
    
    // Update table headers
    table.cell(dashboard, 0, 0, "Timeframe", text_color=color.white, bgcolor=color.gray, text_size=text_size)
    table.cell(dashboard, 1, 0, "Status", text_color=color.white, bgcolor=color.gray, text_size=text_size)
    
    // Update timeframe rows
    table.cell(dashboard, 0, 1, "Monthly", text_color=color.white, bgcolor=color.new(color.black, 50), text_size=text_size)
    table.cell(dashboard, 1, 1, monthly_status, 
               text_color=monthly_status == "BUY" ? color.green : monthly_status == "SELL" ? color.red : color.yellow, 
               bgcolor=color.new(color.black, 50), text_size=text_size)
    
    table.cell(dashboard, 0, 2, "Weekly", text_color=color.white, bgcolor=color.new(color.black, 50), text_size=text_size)
    table.cell(dashboard, 1, 2, weekly_status, 
               text_color=weekly_status == "BUY" ? color.green : weekly_status == "SELL" ? color.red : color.yellow, 
               bgcolor=color.new(color.black, 50), text_size=text_size)
    
    table.cell(dashboard, 0, 3, "Daily", text_color=color.white, bgcolor=color.new(color.black, 50), text_size=text_size)
    table.cell(dashboard, 1, 3, daily_status, 
               text_color=daily_status == "BUY" ? color.green : daily_status == "SELL" ? color.red : color.yellow, 
               bgcolor=color.new(color.black, 50), text_size=text_size)
    
    table.cell(dashboard, 0, 4, "4H", text_color=color.white, bgcolor=color.new(color.black, 50), text_size=text_size)
    table.cell(dashboard, 1, 4, h4_status, 
               text_color=h4_status == "BUY" ? color.green : h4_status == "SELL" ? color.red : color.yellow, 
               bgcolor=color.new(color.black, 50), text_size=text_size)
    
    table.cell(dashboard, 0, 5, "30M", text_color=color.white, bgcolor=color.new(color.black, 50), text_size=text_size)
    table.cell(dashboard, 1, 5, m30_status, 
               text_color=m30_status == "BUY" ? color.green : m30_status == "SELL" ? color.red : color.yellow, 
               bgcolor=color.new(color.black, 50), text_size=text_size)

// End of indicator