//@version=5
library("GLLV_Helpers")

// -----------------------------------------------------------------------------
// General utility functions used by the G_L_L_V strategy.
// This is intended as a "helper library" that can be copied into a script
// or republished as a TradingView library and imported.
// -----------------------------------------------------------------------------

// Builds the standard alert message used by the strategy.
// This helper is provided in the library so it can be reused by other scripts.
export buildAlertMsg(string pineLic, string action, string ticker, float risk, float sl, float tp, string strategyCode) =>
    '7540297236693' + str.tostring(pineLic) + ',' + action + ',' + ticker + ',risk=' + str.tostring(risk) + ',sl=' + str.tostring(sl) + ',tp=' + str.tostring(tp) + ',comment=' + strategyCode

// Builds the standard alert message used by the strategy.
// This helper is provided in the library so it can be reused by other scripts.
export buildAlertMsgtrl(string pineLic, string action, string ticker, float risk, float sl, float tp, float trltrig, float trldist, float trlstep, string strategyCode) =>
    '7540297236693' + str.tostring(pineLic) + ',' + action + ',' + ticker + ',risk=' + str.tostring(risk) + ',sl=' + str.tostring(sl) + ',tp=' + str.tostring(tp) + ',trailtrig=' + str.tostring(trltrig) + ',traildist=' + str.tostring(trldist) + ',trailstep=' +str.tostring(trlstep) +',comment=' + strategyCode 

// Returns true when the supplied series is strictly rising for `points` values
// spaced by `step` bars. Uses an array to avoid evaluating multiple chained history references.
export isRising(float src, int points, int step) =>
    if points < 2
        false
    else
        var float[] arr = array.new_float()
        array.clear(arr)
        for i = 0 to points - 1
            array.push(arr, src[step * i])
        rising = true
        for i = 0 to points - 2
            if array.get(arr, i) <= array.get(arr, i + 1)
                rising := false
                break
        rising

// Faster version of `isRising` that avoids array allocations.
// Useful when you want a lightweight, per-bar rising check.
export isRisingFast(float src, int points, int step) =>
    if points < 2
        false
    else
        rising = true
        for i = 0 to points - 2
            if src[step * i] <= src[step * (i + 1)]
                rising := false
                break
        rising

// Simple trend regime classifier used for pip2 regime logic.
// Returns 1 for up, 2 for range, 3 for down.
export regimeOf(float pip2, float posLimit, float negLimit) =>
    pip2 > posLimit ? 1 : pip2 < negLimit ? 3 : 2

// Counts the number of times each regime occurred over a lookback window.
// Returns [upCount, rangeCount, downCount].
export regimeCounts(float pip2, float posLimit, float negLimit, int lookback) =>
    upCount = math.sum(regimeOf(pip2, posLimit, negLimit) == 1 ? 1 : 0, lookback)
    rangeCount = math.sum(regimeOf(pip2, posLimit, negLimit) == 2 ? 1 : 0, lookback)
    downCount = math.sum(regimeOf(pip2, posLimit, negLimit) == 3 ? 1 : 0, lookback)
    [upCount, rangeCount, downCount]

// Returns a color based on direction booleans.
export directionColor(bool up, bool down, color upColor, color downColor, color neutral) =>
    up ? upColor : down ? downColor : neutral

// Calculate MATA direction and change points.
// Returns [direction, startUp, startDown, closeUp, closeDown]
// direction: 1=up, -1=down, 0=flat
export calcMata(float fast, float mid, float slow) =>
    mataUp = (fast > mid) and (mid > slow)
    mataDown = (fast < mid) and (mid < slow)
    dir = mataUp ? 1 : mataDown ? -1 : 0
    // keep previous bar direction for changes
    prev = nz(dir[1], 0)
    startUp = (dir == 1) and (prev == 0)
    startDown = (dir == -1) and (prev == 0)
    closeUp = (dir == 0) and (prev == 1)
    closeDown = (dir == 0) and (prev == -1)
    [dir, startUp, startDown, closeUp, closeDown]

// Returns true when `src` crosses over `ema` AND `pvsraColor` matches the specified `color`.
export crossUpByColor(float src, float ema, color pvsraColor, color expectedColor) =>
    pvsraColor == expectedColor and ta.crossover(src, ema)

// Returns true when `src` crosses under `ema` AND `pvsraColor` matches the specified `color`.
export crossDownByColor(float src, float ema, color pvsraColor, color expectedColor) =>
    pvsraColor == expectedColor and ta.crossunder(src, ema)

// Calculate slope for trendline system.
// Methods: "Atr", "Stdev", "Linreg".
export calcSlope(float src, int length, float mult, string method) =>
    n = bar_index

    atrVal   = ta.atr(length)
    stdevVal = ta.stdev(src, length)
    smaSrc   = ta.sma(src * n, length)
    smaSrc2  = ta.sma(src, length)
    smaN     = ta.sma(n, length)
    varVal   = ta.variance(n, length)

    slope = switch method
        'Atr'    => atrVal / length * mult
        'Stdev'  => stdevVal / length * mult
        'Linreg' => math.abs(smaSrc - smaSrc2 * smaN) / varVal / 2 * mult
    slope

// Returns true when the candle body is smaller than `pct` percent of total wick length.
export isBodyLessThanWicksPercent(float o, float h, float l, float c, float pct) =>
    body = math.abs(c - o)
    totalWicks = (h - l) - body
    pctRatio = pct / 100.0
    totalWicks > 0 and body <= totalWicks * pctRatio

// Calculate RSI + MA (common RSI processing used throughout scripts)
export calcRsi(float src, int length, string maType, int maLen) =>
    up = ta.rma(math.max(ta.change(src), 0), length)
    down = ta.rma(-math.min(ta.change(src), 0), length)
    rsi = down == 0 ? 100 : up == 0 ? 0 : 100 - (100 / (1 + up / down))
    rsiSma = ta.sma(rsi, maLen)
    rsiEma = ta.ema(rsi, maLen)
    rsiRma = ta.rma(rsi, maLen)
    rsiWma = ta.wma(rsi, maLen)
    rsiVwma = ta.vwma(rsi, maLen)
    rsiMa = rsiSma
    if maType == "EMA"
        rsiMa := rsiEma
    else if maType == "SMMA (RMA)"
        rsiMa := rsiRma
    else if maType == "WMA"
        rsiMa := rsiWma
    else if maType == "VWMA"
        rsiMa := rsiVwma
    [rsi, rsiMa]

// Calculate Williams %R + MA (common Willr processing used throughout scripts)
export calcWillr(float src, int length, string maType, int maLen) =>
    maxVal = ta.highest(src, length)
    minVal = ta.lowest(src, length)
    willr = 100 * (src - maxVal) / (maxVal - minVal)
    willrSma = ta.sma(willr, maLen)
    willrEma = ta.ema(willr, maLen)
    willrRma = ta.rma(willr, maLen)
    willrWma = ta.wma(willr, maLen)
    willrVwma = ta.vwma(willr, maLen)
    willrMa = willrSma
    if maType == "EMA"
        willrMa := willrEma
    else if maType == "SMMA (RMA)"
        willrMa := willrRma
    else if maType == "WMA"
        willrMa := willrWma
    else if maType == "VWMA"
        willrMa := willrVwma
    [willr, willrMa]

// Debug table helper for showing internal state on screen.
// Call once at the top of the script and then update with values.
export createDebugTable() =>
    table.new(position.top_right, 3, 6, border_width=1)

export updateDebugTable(table tbl, int row, string label, string value) =>
    table.cell(tbl, row, 0, label, text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(tbl, row, 1, value, text_color=color.white, bgcolor=color.new(color.gray, 70))
