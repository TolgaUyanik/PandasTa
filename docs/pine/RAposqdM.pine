library("TradingSystems_AlphaLib_v6")

// @function Calcula la EMA de forma estandarizada
// @param len Periodo de la media
export calc_ema(int len) =>
    ta.ema(close, len)

// @function Calcula ADX y DI de forma precisa
// @param len Periodo del cálculo
export calc_adx(int len) =>
    [di_plus, di_minus, adx_val] = ta.dmi(len, len)                                 
    [di_plus, di_minus, adx_val]