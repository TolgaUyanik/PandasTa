//@version=6
indicator("5 EMAs", overlay=true)

// --- EMA 1 ---
mostrar_ema1 = input.bool(true, title="Mostrar", group="EMA 1 (Verde por defecto)")
long_ema1 = input.int(10, title="Longitud", group="EMA 1 (Verde por defecto)")
col_ema1 = input.color(color.green, title="Color", group="EMA 1 (Verde por defecto)")

// --- EMA 2 ---
mostrar_ema2 = input.bool(true, title="Mostrar", group="EMA 2 (Rojo por defecto)")
long_ema2 = input.int(50, title="Longitud", group="EMA 2 (Rojo por defecto)")
col_ema2 = input.color(color.red, title="Color", group="EMA 2 (Rojo por defecto)")

// --- EMA 3 ---
mostrar_ema3 = input.bool(true, title="Mostrar", group="EMA 3 (Amarillo por defecto)")
long_ema3 = input.int(200, title="Longitud", group="EMA 3 (Amarillo por defecto)")
col_ema3 = input.color(color.yellow, title="Color", group="EMA 3 (Amarillo por defecto)")

// --- EMA 4 (Opcional) ---
mostrar_ema4 = input.bool(false, title="Mostrar (Opcional)", group="EMA 4")
long_ema4 = input.int(100, title="Longitud", group="EMA 4")
col_ema4 = input.color(color.blue, title="Color", group="EMA 4")

// --- EMA 5 (Opcional) ---
mostrar_ema5 = input.bool(false, title="Mostrar (Opcional)", group="EMA 5")
long_ema5 = input.int(150, title="Longitud", group="EMA 5")
col_ema5 = input.color(color.fuchsia, title="Color", group="EMA 5")

// --- Cálculos ---
ema1 = ta.ema(close, long_ema1)
ema2 = ta.ema(close, long_ema2)
ema3 = ta.ema(close, long_ema3)
ema4 = ta.ema(close, long_ema4)
ema5 = ta.ema(close, long_ema5)

// --- Dibujo ---
plot(mostrar_ema1 ? ema1 : na, color=col_ema1, title="EMA 1", linewidth=2, display=display.pane)
plot(mostrar_ema2 ? ema2 : na, color=col_ema2, title="EMA 2", linewidth=2, display=display.pane)
plot(mostrar_ema3 ? ema3 : na, color=col_ema3, title="EMA 3", linewidth=2, display=display.pane)
plot(mostrar_ema4 ? ema4 : na, color=col_ema4, title="EMA 4", linewidth=1, display=display.pane)
plot(mostrar_ema5 ? ema5 : na, color=col_ema5, title="EMA 5", linewidth=1, display=display.pane)