//@version=6
indicator("CM’s Custom Trend Indicator", overlay=true)

// Inputs
ema_len = input.int(20, "EMA Length")
sma_len = input.int(50, "SMA Length")
ema100_show = input.bool(true, "Show EMA 100")
sma200_show = input.bool(true, "Show SMA 200")
bull_above_perc = input.float(12, "Bull Signal Above %")
bull_below_perc = input.float(3, "Bull Signal Below %")
bear_above_perc = input.float(3, "Bear Signal Above %")
bear_below_perc = input.float(12, "Bear Signal Below %")
price_bear_perc = input.float(3, "Price Bear Trigger % Below SMA")
price_bull_perc = input.float(2, "Price Bull Trigger % Above SMA")
vol_sma_len = input.int(20, "Volume SMA Length for Support")
rsi_len = input.int(14, "RSI Length")
near_threshold = input.float(0.5, "Near Level Threshold %")
pivot_left = input.int(5, "Pivot Left Bars")
pivot_right = input.int(5, "Pivot Right Bars")
max_hist_levels = input.int(10, "Max Historical Levels")

ema_color = input.color(color.yellow, "EMA Color")
sma_color = input.color(color.red, "SMA Color")
ema100_color = input.color(color.new(#FFB6C1, 50), "EMA100 Color") // Light pink
sma200_color = input.color(color.blue, "SMA200 Color")
sig_above_color = input.color(color.green, "Signal Above Color")
sig_below_color = input.color(color.red, "Signal Below Color")

// Calculations
ema20 = ta.ema(close, ema_len)
sma50 = ta.sma(close, sma_len)
ema100 = ta.ema(close, 100)
sma200 = ta.sma(close, 200)
rsi = ta.rsi(close, rsi_len)
vol_sma = ta.sma(volume, vol_sma_len)

// Plot MAs
plot(ema20, color=ema_color, title="EMA")
plot(sma50, color=sma_color, title="SMA")
plot(ema100_show ? ema100 : na, color=ema100_color, title="EMA100")
plot(sma200_show ? sma200 : na, color=sma200_color, title="SMA200")

// Trend Detection
bull_cross = ta.crossover(ema20, sma50)
bear_cross = ta.crossunder(ema20, sma50)

var bool is_bull_trend = false
var bool is_bear_trend = false

if bull_cross
    is_bull_trend := true
    is_bear_trend := false
else if bear_cross
    is_bull_trend := false
    is_bear_trend := true

// Additional Trend Triggers with Volume Support
vol_support = volume > vol_sma

bear_threshold = sma50 * (1 - price_bear_perc / 100)
bull_threshold = sma50 * (1 + price_bull_perc / 100)

if close < bear_threshold and vol_support
    is_bear_trend := true
    is_bull_trend := false

if close > bull_threshold and vol_support
    is_bull_trend := true
    is_bear_trend := false

// Signal Lines (Leading Indicator Lines?)
sig_above = is_bull_trend ? ema20 * (1 + bull_above_perc / 100) : is_bear_trend ? ema20 * (1 + bear_above_perc / 100) : na
sig_below = is_bull_trend ? ema20 * (1 - bull_below_perc / 100) : is_bear_trend ? ema20 * (1 - bear_below_perc / 100) : na

plot(sig_above, color=sig_above_color, title="Signal Above")
plot(sig_below, color=sig_below_color, title="Signal Below")

// Fibonacci and Historical Levels
fib_ratios = array.from(-0.618, 0.0, 0.236, 0.382, 0.5, 0.618, 0.786, 1.0, 1.272, 1.618)

var float swing_high = na
var float swing_low = na

ph = ta.pivothigh(pivot_left, pivot_right)
pl = ta.pivotlow(pivot_left, pivot_right)

if not na(ph)
    swing_high := ph
if not na(pl)
    swing_low := pl

var float[] fib_levels = array.new_float(0)
array.clear(fib_levels)
if not na(swing_high) and not na(swing_low) and swing_high > swing_low
    for ratio in fib_ratios
        level = swing_low + (swing_high - swing_low) * ratio
        array.push(fib_levels, level)

var float[] hist_supports = array.new_float(0)
var float[] hist_resistances = array.new_float(0)

if not na(pl)
    array.push(hist_supports, pl)
    if array.size(hist_supports) > max_hist_levels
        array.shift(hist_supports)

if not na(ph)
    array.push(hist_resistances, ph)
    if array.size(hist_resistances) > max_hist_levels
        array.shift(hist_resistances)

// Functions to check near support/resistance
is_near_support() =>
    near = false
    // Check historical supports
    for sup in hist_supports
        if math.abs(close - sup) / close < near_threshold / 100
            near := true
    // Check fib levels as supports (levels <= close)
    for fib in fib_levels
        if math.abs(close - fib) / close < near_threshold / 100 and fib <= close
            near := true
    near

is_near_resistance() =>
    near = false
    // Check historical resistances
    for res in hist_resistances
        if math.abs(close - res) / close < near_threshold / 100
            near := true
    // Check fib levels as resistances (levels >= close)
    for fib in fib_levels
        if math.abs(close - fib) / close < near_threshold / 100 and fib >= close
            near := true
    near

// Buy and Sell Signals
sell_condition = high <= math.max(high[1], high[2]) and rsi < rsi[1] and is_near_resistance()
buy_condition = low >= math.min(math.min(low[1], low[2]), low[3]) and rsi > rsi[1] and is_near_support()

plotshape(series=buy_condition, title="Buy Signal", location=location.belowbar, color=color.green, style=shape.triangleup, text="Buy")
plotshape(series=sell_condition, title="Sell Signal", location=location.abovebar, color=color.red, style=shape.triangledown, text="Sell")

// Background color for trend
bgcolor(is_bull_trend ? color.new(color.green, 90) : is_bear_trend ? color.new(color.red, 90) : na, title="Trend Background")