//@version=6
indicator(title="2 VWAP + ICHIMOKU", shorttitle="2 VWAP + ICH", overlay=true, timeframe="", timeframe_gaps=true)

//=============================================================================
// VWAP 1 — INPUTS ORIGINALES
//=============================================================================

VWAP1_SETTINGS = "VWAP 1 Settings"
VWAP1_BANDS = "VWAP 1 Bands Settings"

hideonDWM1 = input(false, title="Hide VWAP on 1D or Above", group=VWAP1_SETTINGS, display=display.none)

var anchor1 = input.string(
     defval="Session",
     title="Anchor Period",
     options=["Session", "Week", "Month", "Quarter", "Year", "Decade", "Century", "Earnings", "Dividends", "Splits"],
     group=VWAP1_SETTINGS
)

src1 = input(title="Source", defval=hlc3, group=VWAP1_SETTINGS, display=display.none)
offset1 = input.int(0, title="Offset", group=VWAP1_SETTINGS, display=display.none)

CALC_MODE_TOOLTIP = "Determines the units used to calculate the distance of the bands. When 'Percentage' is selected, a multiplier of 1 means 1%."

calcModeInput1 = input.string(
     "Standard Deviation",
     "Bands Calculation Mode",
     options=["Standard Deviation", "Percentage"],
     group=VWAP1_BANDS,
     tooltip=CALC_MODE_TOOLTIP,
     display=display.none
)

showBand1_1 = input(
     true,
     title="",
     group=VWAP1_BANDS,
     inline="VWAP1_BAND_1",
     display=display.none
)

bandMult1_1 = input.float(
     1.0,
     title="Bands Multiplier #1",
     group=VWAP1_BANDS,
     inline="VWAP1_BAND_1",
     step=0.5,
     minval=0,
     display=display.none,
     active=showBand1_1
)

showBand1_2 = input(
     false,
     title="",
     group=VWAP1_BANDS,
     inline="VWAP1_BAND_2",
     display=display.none
)

bandMult1_2 = input.float(
     2.0,
     title="Bands Multiplier #2",
     group=VWAP1_BANDS,
     inline="VWAP1_BAND_2",
     step=0.5,
     minval=0,
     display=display.none,
     active=showBand1_2
)

showBand1_3 = input(
     false,
     title="",
     group=VWAP1_BANDS,
     inline="VWAP1_BAND_3",
     display=display.none
)

bandMult1_3 = input.float(
     3.0,
     title="Bands Multiplier #3",
     group=VWAP1_BANDS,
     inline="VWAP1_BAND_3",
     step=0.5,
     minval=0,
     display=display.none,
     active=showBand1_3
)

//=============================================================================
// VWAP 2 — INPUTS ORIGINALES
//=============================================================================

VWAP2_SETTINGS = "VWAP 2 Settings"
VWAP2_BANDS = "VWAP 2 Bands Settings"

hideonDWM2 = input(false, title="Hide VWAP on 1D or Above", group=VWAP2_SETTINGS, display=display.none)

var anchor2 = input.string(
     defval="Month",
     title="Anchor Period",
     options=["Session", "Week", "Month", "Quarter", "Year", "Decade", "Century", "Earnings", "Dividends", "Splits"],
     group=VWAP2_SETTINGS
)

src2 = input(title="Source", defval=hlc3, group=VWAP2_SETTINGS, display=display.none)
offset2 = input.int(0, title="Offset", group=VWAP2_SETTINGS, display=display.none)

calcModeInput2 = input.string(
     "Standard Deviation",
     "Bands Calculation Mode",
     options=["Standard Deviation", "Percentage"],
     group=VWAP2_BANDS,
     tooltip=CALC_MODE_TOOLTIP,
     display=display.none
)

showBand2_1 = input(
     true,
     title="",
     group=VWAP2_BANDS,
     inline="VWAP2_BAND_1",
     display=display.none
)

bandMult2_1 = input.float(
     1.0,
     title="Bands Multiplier #1",
     group=VWAP2_BANDS,
     inline="VWAP2_BAND_1",
     step=0.5,
     minval=0,
     display=display.none,
     active=showBand2_1
)

showBand2_2 = input(
     false,
     title="",
     group=VWAP2_BANDS,
     inline="VWAP2_BAND_2",
     display=display.none
)

bandMult2_2 = input.float(
     2.0,
     title="Bands Multiplier #2",
     group=VWAP2_BANDS,
     inline="VWAP2_BAND_2",
     step=0.5,
     minval=0,
     display=display.none,
     active=showBand2_2
)

showBand2_3 = input(
     false,
     title="",
     group=VWAP2_BANDS,
     inline="VWAP2_BAND_3",
     display=display.none
)

bandMult2_3 = input.float(
     3.0,
     title="Bands Multiplier #3",
     group=VWAP2_BANDS,
     inline="VWAP2_BAND_3",
     step=0.5,
     minval=0,
     display=display.none,
     active=showBand2_3
)

//=============================================================================
// ICHIMOKU — INPUTS ORIGINALES
//=============================================================================

ICHIMOKU_SETTINGS = "ICHIMOKU Settings"

showIchimoku = input.bool(
     true,
     title="Show Ichimoku",
     group=ICHIMOKU_SETTINGS
)

TKlength = input.int(
     9,
     title="Tenkansen Length",
     minval=1,
     group=ICHIMOKU_SETTINGS
)

KJlength = input.int(
     26,
     title="Kijunsen Length",
     minval=1,
     group=ICHIMOKU_SETTINGS
)

CSHSlength = input.int(
     26,
     title="Chikouspan Length/Horizontal Shift",
     minval=1,
     group=ICHIMOKU_SETTINGS
)

SBlength = input.int(
     52,
     title="SenkouspanB Length",
     minval=1,
     group=ICHIMOKU_SETTINGS
)

SAlength = input.int(
     26,
     title="SenkouspanA Length",
     minval=1,
     group=ICHIMOKU_SETTINGS
)

//=============================================================================
// VALIDACIÓN DE VOLUMEN
//=============================================================================

cumVolume = ta.cum(volume)

if barstate.islast and cumVolume == 0
    runtime.error("No volume is provided by the data vendor.")

//=============================================================================
// VWAP 1 — NUEVO PERIODO
//=============================================================================

isNewPeriod1 = switch anchor1
    "Earnings" =>
        newEarningsActual1 = request.earnings(
             syminfo.tickerid,
             earnings.actual,
             barmerge.gaps_on,
             barmerge.lookahead_on,
             ignore_invalid_symbol=true
        )

        newEarningsStandardized1 = request.earnings(
             syminfo.tickerid,
             earnings.standardized,
             barmerge.gaps_on,
             barmerge.lookahead_on,
             ignore_invalid_symbol=true
        )

        not na(newEarningsActual1) or not na(newEarningsStandardized1)

    "Dividends" =>
        newDividends1 = request.dividends(
             syminfo.tickerid,
             dividends.gross,
             barmerge.gaps_on,
             barmerge.lookahead_on,
             ignore_invalid_symbol=true
        )

        not na(newDividends1)

    "Splits" =>
        newSplit1 = request.splits(
             syminfo.tickerid,
             splits.denominator,
             barmerge.gaps_on,
             barmerge.lookahead_on,
             ignore_invalid_symbol=true
        )

        not na(newSplit1)

    "Session" =>
        timeframe.change("D")

    "Week" =>
        timeframe.change("W")

    "Month" =>
        timeframe.change("M")

    "Quarter" =>
        timeframe.change("3M")

    "Year" =>
        timeframe.change("12M")

    "Decade" =>
        timeframe.change("12M") and year % 10 == 0

    "Century" =>
        timeframe.change("12M") and year % 100 == 0

    =>
        false

isEsdAnchor1 = anchor1 == "Earnings" or anchor1 == "Dividends" or anchor1 == "Splits"

if na(src1[1]) and not isEsdAnchor1
    isNewPeriod1 := true

//=============================================================================
// VWAP 2 — NUEVO PERIODO
//=============================================================================

isNewPeriod2 = switch anchor2
    "Earnings" =>
        newEarningsActual2 = request.earnings(
             syminfo.tickerid,
             earnings.actual,
             barmerge.gaps_on,
             barmerge.lookahead_on,
             ignore_invalid_symbol=true
        )

        newEarningsStandardized2 = request.earnings(
             syminfo.tickerid,
             earnings.standardized,
             barmerge.gaps_on,
             barmerge.lookahead_on,
             ignore_invalid_symbol=true
        )

        not na(newEarningsActual2) or not na(newEarningsStandardized2)

    "Dividends" =>
        newDividends2 = request.dividends(
             syminfo.tickerid,
             dividends.gross,
             barmerge.gaps_on,
             barmerge.lookahead_on,
             ignore_invalid_symbol=true
        )

        not na(newDividends2)

    "Splits" =>
        newSplit2 = request.splits(
             syminfo.tickerid,
             splits.denominator,
             barmerge.gaps_on,
             barmerge.lookahead_on,
             ignore_invalid_symbol=true
        )

        not na(newSplit2)

    "Session" =>
        timeframe.change("D")

    "Week" =>
        timeframe.change("W")

    "Month" =>
        timeframe.change("M")

    "Quarter" =>
        timeframe.change("3M")

    "Year" =>
        timeframe.change("12M")

    "Decade" =>
        timeframe.change("12M") and year % 10 == 0

    "Century" =>
        timeframe.change("12M") and year % 100 == 0

    =>
        false

isEsdAnchor2 = anchor2 == "Earnings" or anchor2 == "Dividends" or anchor2 == "Splits"

if na(src2[1]) and not isEsdAnchor2
    isNewPeriod2 := true

//=============================================================================
// VWAP 1 — CÁLCULO
//=============================================================================

float vwapValue1 = na
float upperBandValue1_1 = na
float lowerBandValue1_1 = na
float upperBandValue1_2 = na
float lowerBandValue1_2 = na
float upperBandValue1_3 = na
float lowerBandValue1_3 = na

if not (hideonDWM1 and timeframe.isdwm)
    [_vwap1, _stdevUpper1, _] = ta.vwap(src1, isNewPeriod1, 1)

    vwapValue1 := _vwap1

    stdevAbs1 = _stdevUpper1 - _vwap1
    bandBasis1 = calcModeInput1 == "Standard Deviation" ? stdevAbs1 : _vwap1 * 0.01

    upperBandValue1_1 := _vwap1 + bandBasis1 * bandMult1_1
    lowerBandValue1_1 := _vwap1 - bandBasis1 * bandMult1_1

    upperBandValue1_2 := _vwap1 + bandBasis1 * bandMult1_2
    lowerBandValue1_2 := _vwap1 - bandBasis1 * bandMult1_2

    upperBandValue1_3 := _vwap1 + bandBasis1 * bandMult1_3
    lowerBandValue1_3 := _vwap1 - bandBasis1 * bandMult1_3

//=============================================================================
// VWAP 2 — CÁLCULO
//=============================================================================

float vwapValue2 = na
float upperBandValue2_1 = na
float lowerBandValue2_1 = na
float upperBandValue2_2 = na
float lowerBandValue2_2 = na
float upperBandValue2_3 = na
float lowerBandValue2_3 = na

if not (hideonDWM2 and timeframe.isdwm)
    [_vwap2, _stdevUpper2, _] = ta.vwap(src2, isNewPeriod2, 1)

    vwapValue2 := _vwap2

    stdevAbs2 = _stdevUpper2 - _vwap2
    bandBasis2 = calcModeInput2 == "Standard Deviation" ? stdevAbs2 : _vwap2 * 0.01

    upperBandValue2_1 := _vwap2 + bandBasis2 * bandMult2_1
    lowerBandValue2_1 := _vwap2 - bandBasis2 * bandMult2_1

    upperBandValue2_2 := _vwap2 + bandBasis2 * bandMult2_2
    lowerBandValue2_2 := _vwap2 - bandBasis2 * bandMult2_2

    upperBandValue2_3 := _vwap2 + bandBasis2 * bandMult2_3
    lowerBandValue2_3 := _vwap2 - bandBasis2 * bandMult2_3

//=============================================================================
// ICHIMOKU — CÁLCULO
//=============================================================================

TK = math.avg(
     ta.lowest(low, TKlength),
     ta.highest(high, TKlength)
)

KJ = math.avg(
     ta.lowest(low, KJlength),
     ta.highest(high, KJlength)
)

CS = close

SB = math.avg(
     ta.lowest(low, SBlength),
     ta.highest(high, SBlength)
)

SA = math.avg(TK, KJ)

//=============================================================================
// VWAP 1 — PLOTS
//=============================================================================

plot(
     vwapValue1,
     title="VWAP 1",
     color=#2962FF,
     offset=offset1
)

displayBand1_1 = showBand1_1 ? display.all : display.none

upperBand1_1Plot = plot(
     upperBandValue1_1,
     title="VWAP 1 Upper Band #1",
     color=color.green,
     offset=offset1,
     display=displayBand1_1,
     editable=showBand1_1
)

lowerBand1_1Plot = plot(
     lowerBandValue1_1,
     title="VWAP 1 Lower Band #1",
     color=color.green,
     offset=offset1,
     display=displayBand1_1,
     editable=showBand1_1
)

fill(
     upperBand1_1Plot,
     lowerBand1_1Plot,
     title="VWAP 1 Bands Fill #1",
     color=color.new(color.green, 95),
     display=displayBand1_1,
     editable=showBand1_1
)

displayBand1_2 = showBand1_2 ? display.all : display.none

upperBand1_2Plot = plot(
     upperBandValue1_2,
     title="VWAP 1 Upper Band #2",
     color=color.olive,
     offset=offset1,
     display=displayBand1_2,
     editable=showBand1_2
)

lowerBand1_2Plot = plot(
     lowerBandValue1_2,
     title="VWAP 1 Lower Band #2",
     color=color.olive,
     offset=offset1,
     display=displayBand1_2,
     editable=showBand1_2
)

fill(
     upperBand1_2Plot,
     lowerBand1_2Plot,
     title="VWAP 1 Bands Fill #2",
     color=color.new(color.olive, 95),
     display=displayBand1_2,
     editable=showBand1_2
)

displayBand1_3 = showBand1_3 ? display.all : display.none

upperBand1_3Plot = plot(
     upperBandValue1_3,
     title="VWAP 1 Upper Band #3",
     color=color.teal,
     offset=offset1,
     display=displayBand1_3,
     editable=showBand1_3
)

lowerBand1_3Plot = plot(
     lowerBandValue1_3,
     title="VWAP 1 Lower Band #3",
     color=color.teal,
     offset=offset1,
     display=displayBand1_3,
     editable=showBand1_3
)

fill(
     upperBand1_3Plot,
     lowerBand1_3Plot,
     title="VWAP 1 Bands Fill #3",
     color=color.new(color.teal, 95),
     display=displayBand1_3,
     editable=showBand1_3
)

//=============================================================================
// VWAP 2 — PLOTS
//=============================================================================

plot(
     vwapValue2,
     title="VWAP 2",
     color=color.orange,
     offset=offset2
)

displayBand2_1 = showBand2_1 ? display.all : display.none

upperBand2_1Plot = plot(
     upperBandValue2_1,
     title="VWAP 2 Upper Band #1",
     color=color.red,
     offset=offset2,
     display=displayBand2_1,
     editable=showBand2_1
)

lowerBand2_1Plot = plot(
     lowerBandValue2_1,
     title="VWAP 2 Lower Band #1",
     color=color.red,
     offset=offset2,
     display=displayBand2_1,
     editable=showBand2_1
)

fill(
     upperBand2_1Plot,
     lowerBand2_1Plot,
     title="VWAP 2 Bands Fill #1",
     color=color.new(color.red, 95),
     display=displayBand2_1,
     editable=showBand2_1
)

displayBand2_2 = showBand2_2 ? display.all : display.none

upperBand2_2Plot = plot(
     upperBandValue2_2,
     title="VWAP 2 Upper Band #2",
     color=color.orange,
     offset=offset2,
     display=displayBand2_2,
     editable=showBand2_2
)

lowerBand2_2Plot = plot(
     lowerBandValue2_2,
     title="VWAP 2 Lower Band #2",
     color=color.orange,
     offset=offset2,
     display=displayBand2_2,
     editable=showBand2_2
)

fill(
     upperBand2_2Plot,
     lowerBand2_2Plot,
     title="VWAP 2 Bands Fill #2",
     color=color.new(color.orange, 95),
     display=displayBand2_2,
     editable=showBand2_2
)

displayBand2_3 = showBand2_3 ? display.all : display.none

upperBand2_3Plot = plot(
     upperBandValue2_3,
     title="VWAP 2 Upper Band #3",
     color=color.purple,
     offset=offset2,
     display=displayBand2_3,
     editable=showBand2_3
)

lowerBand2_3Plot = plot(
     lowerBandValue2_3,
     title="VWAP 2 Lower Band #3",
     color=color.purple,
     offset=offset2,
     display=displayBand2_3,
     editable=showBand2_3
)

fill(
     upperBand2_3Plot,
     lowerBand2_3Plot,
     title="VWAP 2 Bands Fill #3",
     color=color.new(color.purple, 95),
     display=displayBand2_3,
     editable=showBand2_3
)

//=============================================================================
// ICHIMOKU — PLOTS
//=============================================================================

plot(
     showIchimoku ? TK : na,
     linewidth=2,
     color=color.blue,
     title="TenkanSen"
)

plot(
     showIchimoku ? KJ : na,
     linewidth=2,
     color=color.red,
     title="KijunSen"
)

plot(
     showIchimoku ? CS : na,
     offset=-CSHSlength,
     linewidth=2,
     color=#DDA0DD,
     title="ChikouSpan"
)

SenkouA = plot(
     showIchimoku ? SA : na,
     offset=CSHSlength,
     linewidth=1,
     color=color.green,
     title="SenkouSpanA"
)

SenkouB = plot(
     showIchimoku ? SB : na,
     offset=CSHSlength,
     linewidth=1,
     color=color.purple,
     title="SenkouSpanB"
)

fill(
     SenkouA,
     SenkouB,
     title="Ichimoku Cloud",
     color=showIchimoku ? (SA > SB ? color.green : color.red) : na
)