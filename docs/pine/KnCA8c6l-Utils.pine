//@version=6

// @description A collection of convenience and helper functions for indicator and library authors on TradingView
library("Utils", overlay=true)

import jmosullivan/Session/6

// @function My version of format number that doesn't have so many decimal places...
// @param num The number to be formatted
// @returns The formatted number
export formatNumber(float num) =>
    var n = num
    var ret = str.format("{0,number,#}", n)

    if (num > 999)
        n := num / 1000
        ret := str.format("{0,number,#.#}", n) + "k"

    if (num > 999999)
        n := num / 1000000
        ret := str.format("{0,number,#.#}", n) + "M"

    if (num > 999999999)
        n := num / 1000000000
        ret := str.format("{0,number,#.#}", n) + "B"

    ret


// @function Convenience function returns timestamp in yyyy/MM/dd format.
// @param timestamp The timestamp to stringify
// @returns The date string
export getDateString(int timestamp) =>
    str.format('{0,date,yyyy/MM/dd}', timestamp)

// @function Convenience function returns timestamp in yyyy/MM/dd hh:mm format.
// @param timestamp The timestamp to stringify
// @returns The date string
export getDateTimeString(int timestamp) =>
    str.format('{0,date,yyyy/MM/dd hh:mm}', timestamp)

// @function Gets the number of inside bars for the current chart. Can also be passed to request.security to get the same for different timeframes.
// @returns The # of inside bars on the chart right now.
export getInsideBarCount() => 
    ibCount = 0
    i = 0
    maxLoops = 10
    while i <= maxLoops
        if (high[i+1] > high[i] and low[i+1] < low[i])
            ibCount := ibCount + 1
            i := i + 1
        else
            i := maxLoops + 1

    ibCount

// @function Tradingview doesn't give you a nice way to put the label styles into a dropdown for configuration settings. So, I specify them in the following format: "Center", "Left", "Lower Left", "Lower Right", "Right", "Up", "Upper Left", "Upper Right", "Plain Text", "No Labels". This function takes care of converting those custom strings back to the ones expected by tradingview scripts. 
// @param show styleString The plain english version of the string to convert back to the expected TradingView format.
// @param acceptGivenIfNoMatch If no match for styleString is found and this is true, the function will return styleString, otherwise it will return tradingview's preferred default
// @returns The string expected by tradingview functions
export getLabelStyleFromString(string styleString, bool acceptGivenIfNoMatch = true) =>
    ret = switch styleString
        "Down" => label.style_label_down
        "Center" => label.style_label_center
        "Left" => label.style_label_left
        "Label" => label.style_label_left
        "Lower Left" => label.style_label_lower_left
        "Lower Right" => label.style_label_lower_right
        "Right" => label.style_label_right
        "Up" => label.style_label_up
        "Upper Left" => label.style_label_upper_left
        "Upper Right" => label.style_label_upper_right
        "Plain Text" => label.style_none
        => acceptGivenIfNoMatch ? styleString : label.style_label_down
    ret

// @function Given an hour number and minute number, adds them together and returns the sum. To be used by getLevelBetweenTimes when fetching specific price levels during a time window on the day.
// @param hourNumber The hour number
// @param minuteNumber The minute number
// @returns The sum of all the minutes
export getTime(int hourNumber, int minuteNumber) =>
    (hourNumber * 60) + minuteNumber

// @function Given a start and end time, returns the high or low price during that time window.
// @param start The timestamp to start with (# of seconds)
// @param end The timestamp to end with (# of seconds)
// @returns The high or low value
export getHighAndLowBetweenTimes(int start, int end) =>
    // ref: https://www.pinecoders.com/faq_and_code/
    var float h = 0.
    var float l = 10e10
    var reset = true
    minNow = getTime(hour, minute)
    if minNow >= start and minNow <= end
        if reset
            h := high
			l := low
            reset := false
        else
            h := math.max(h, high) 
			l := math.min(l, low)
    else
        reset := true
    [h, l]

// @function Returns an expression that can be used by request.security to fetch the premarket high & low levels in a tuple.
// @returns (tuple) [premarketHigh, premarketLow]
export getPremarketHighsAndLows() =>
    premarketStart = getTime(4, 0)
    premarketEnd = getTime(9, 29)
	getHighAndLowBetweenTimes(premarketStart, premarketEnd)

// @function Returns an expression that can be used by request.security to fetch the after hours high & low levels in a tuple.
// @returns (tuple) [afterHoursHigh, afterHoursLow]
export getAfterHoursHighsAndLows() =>
    afterHoursStart = getTime(16, 0)
    afterHoursEnd = getTime(19, 59)
	getHighAndLowBetweenTimes(afterHoursStart, afterHoursEnd)

// @function Returns an expression that can be used by request.security to fetch the overnight high & low levels in a tuple.
// @returns (tuple) [overnightHigh, overnightLow]
export getOvernightHighsAndLows() =>
    overnightStart = getTime(16, 0)
    overnightEnd = getTime(9, 29)
	getHighAndLowBetweenTimes(overnightStart, overnightEnd)

// @function Returns an expression that can be used by request.security to fetch the high & low levels for premarket, after hours and overnight in a tuple.
// @returns (tuple) [premarketHigh, premarketLow, afterHoursHigh, afterHoursLow, overnightHigh, overnightLow]
export getNonRthHighsAndLows() =>
	[premarketHigh, premarketLow] = getPremarketHighsAndLows()
	[afterHoursHigh, afterHoursLow] = getAfterHoursHighsAndLows()
	overnightHigh = math.max(afterHoursHigh, premarketHigh)
	overnightLow = math.min(afterHoursLow, premarketLow)
    [premarketHigh, premarketLow, afterHoursHigh, afterHoursLow, overnightHigh, overnightLow]

// @function Tradingview doesn't give you a nice way to put the line styles into a dropdown for configuration settings. So, I specify them in the following format: "Solid", "Dashed", "Dotted", "None/Hidden". This function takes care of converting those custom strings back to the ones expected by tradingview scripts. 
// @param styleString Plain english (or TV Standard) version of the style string
// @param acceptGivenIfNoMatch If no match for styleString is found and this is true, the function will return styleString, otherwise it will return tradingview's preferred default
// @returns The string expected by tradingview functions
export getLineStyleFromString(string styleString, bool acceptGivenIfNoMatch = true) =>
    ret = switch styleString
        "Dotted" => line.style_dotted
        "Dashed" => line.style_dashed
        "Solid" => line.style_solid
        => acceptGivenIfNoMatch ? styleString : line.style_solid
    ret

// @function Get the % the current price is away from the given price.
// @returns The % the current price is away from the given price.
export getPercentFromPrice(float price) =>
    diff = price - close
    (price < close ? diff / close : diff / price)

// @function Tradingview doesn't give you a nice way to put the positions into a dropdown for configuration settings. So, I specify them in the following format: "Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right". This function takes care of converting those custom strings back to the ones expected by tradingview scripts. 
// @param position Plain english position string
// @returns The string expected by tradingview functions
export getPositionFromString(string position) =>
    switch position
        "Top Left" => position.top_left
        "Top Center" => position.top_center
        "Top Right" => position.top_right
        "Middle Left" => position.middle_left
        "Middle Center" => position.middle_center
        "Middle Right" => position.middle_right
        "Bottom Left" => position.bottom_left
        "Bottom Center" => position.bottom_center
        "Bottom Right" => position.bottom_right
        => position

// @function Call request.security with this as the expression to get the average up/down values that can be used with getRsiPrice (below) to calculate the price level where the supplied RSI level would be reached.
// @param rsiLength The length of the RSI requested.
// @returns A tuple containing the avgUp and avgDown values required by the getRsiPrice function.
export getRsiAvgsExpression(int rsiLength) =>
    ep = 2 * rsiLength - 1
    avgUp = ta.ema(math.max(close - close[1], 0), ep)
    avgDown = ta.ema(math.max(close[1] - close, 0), ep)
    rsi = ta.rsi(close, rsiLength)
    [rsi, avgUp, avgDown]

// @function use the values returned by getRsiAvgsExpression() to calculate the price level when the provided RSI level would be reached.
// @param rsiLevel The RSI level to find price at.
// @param rsiLength The length of the RSI to calculate.
// @param avgUp The average move up of RSI.
// @param avgDown The average move down of RSI.
// @returns The price level where the provided RSI level would be met. 
export getRsiPrice(float rsiLevel, int rsiLength, float avgUp, float avgDown) => 
    x = (rsiLength - 1) * (avgDown * rsiLevel / (100 - rsiLevel) - avgUp)
    x >= 0 ? close + x : close + x * (100 - rsiLevel) / rsiLevel

// @function Tradingview doesn't give you a nice way to put the sizes into a dropdown for configuration settings. So, I specify them in the following format: "Auto", "Huge", "Large", "Normal", "Small", "Tiny". This function takes care of converting those custom strings back to the ones expected by tradingview scripts. 
// @param sizeString Plain english size string
// @returns The string expected by tradingview functions
export getSizeFromString(string sizeString) =>
    switch sizeString
        "Auto" => size.auto
        "Huge" => size.huge
        "Large" => size.large
        "Normal" => size.normal
        "Tiny" => size.tiny
        => size.small // Defaulting to small if size is unrecognized

// @function Get the timeframe of the current chart for display
// @returns The string of the current chart timeframe
export getTimeframeOfChart() =>
    string rtf = str.tostring(timeframe.multiplier)
    if (timeframe.isseconds)
        rtf := rtf + "s"
    if (timeframe.isminutes)
        rtf := rtf + "m"
    if (timeframe.isdaily)
        rtf := rtf + "D"
    if (timeframe.isweekly)
        rtf := rtf + "W"
    if (timeframe.ismonthly)
        rtf := rtf + "M"

// @function Helper function for drawings that use xloc.bar_time to help you know the time offset if you want to place the end of the drawing out into the future. This determines the time-size of one candle and then returns a time n candleOffsets into the future. 
// @param candleOffset The number of items to find singular/plural for.
// @returns The future time
export getTimeNowPlusOffset(int candleOffset) =>
	oneCandleInMS = timeframe.in_seconds() * 1000
	time + (oneCandleInMS * candleOffset)

// @function Given a start and end time, returns the sum of all volume across bars during that time window.
// @param start The timestamp to start with (# of seconds)
// @param end The timestamp to end with (# of seconds)
// @returns The volume
export getVolumeBetweenTimes(int start, int end) =>
    var float vol = 0
    var reset = true
    minNow = (hour * 60) + minute
    if minNow >= start and minNow <= end
        if reset
            vol := volume
            reset := false
        else
            vol += volume
    else
        reset := true
    vol

// @function Returns true if the current bar occurs on today's date.
// @returns True if current bar is today
export isToday() =>
    year(timenow) == year(time) and month(timenow) == month(time) and dayofmonth(timenow) == dayofmonth(time)

// @function Pads a label string so that it appears properly in or not in a label. When label.style_none is used, this will make sure it is left-aligned instead of center-aligned. When any other type is used, it adds a single space to the right so there is padding against the right end of the label.
// @param labelText The string to be padded
// @param labelStyle The style of the label being padded for.
// @returns The padded string
export padLabelString(string labelText, string labelStyle) =>
    SPACE = " "
    returnString = labelText
    _labelStyle = getLabelStyleFromString(labelStyle)
    if _labelStyle == label.style_none
        for i = 0 to str.length(labelText)
            returnString := SPACE + returnString
    else
        returnString := returnString + SPACE

    returnString

// @function Helps format a string for plural/singular. By default, if you only provide num, it will just return "s" for plural and nothing for singular (eg. plural(numberOfCats)). But you can optionally specify the full singular/plural words for more complicated nomenclature (eg. plural(numberOfBenches, 'bench', 'benches'))
// @param num The number of items to find singular/plural for.
// @param singular The string to return if num is singular. Defaults to an empty string. 
// @param plural The string to return if num is plural. Defaults to 's' so you can just add 's' to the end of a word.
// @returns The singular or plural provided strings depending on the num provided.
export plural(int num, string singular = '', string plural = 's') =>
    num != 1 ? plural : singular

// @function Get the # of seconds in a given timeframe. Tradingview's timeframe.in_seconds() expects a simple string, and we often need to use series string, so this is an alternative to get you the value you need.
// @param tf The timeframe to convert
// @returns The number of secondsof that timeframe
export timeframeInSeconds(string timeframe) =>
    sMinute = 60
    sHour = sMinute * 60
    sDay = sHour * 24
    sWeek = sDay * 7
    sMonth = timeframe.in_seconds("M") // TV has a weird value for this, so I'm just using theirs
    letter = str.substring(timeframe, str.length(timeframe) - 1)
    multiplier = switch letter
        "M" => sMonth
        "W" => sWeek
        "D" => sDay
        "H" => sHour
        => sMinute

    number = int(str.tonumber(timeframe))
    increment = na(number) ? 1 : number
    increment * multiplier

// @function Convert a timeframe string to a consistent standard.
// @param tf The timeframe string to convert
// @returns The standard format for the string, or the unchanged value if it is unknown.
export timeframeOfChart() =>
	suffix = switch
    	timeframe.isseconds => 's'
    	timeframe.isminutes and timeframe.multiplier <= 60 => 'm'
    	timeframe.isseconds and timeframe.multiplier > 60 => 'h'
    	timeframe.isdaily => 'D'
    	timeframe.isweekly => 'W'
    	timeframe.ismonthly => 'M'
		=> ''
	multiplier = timeframe.multiplier
	if suffix == 'h' and multiplier > 60
		multiplier := math.floor(multiplier/60)
		// If there are additional minutes unaccounted for, concatenate them in the suffix
		if multiplier * 60 != timeframe.multiplier
			minutes = timeframe.multiplier - (multiplier * 60)
			suffix := str.format('h{0}m', minutes)

	str.format('{0}{1}', multiplier, suffix)

// @function Convert a timeframe string to a consistent standard.
// @param tf (string) The timeframe string to convert
// @returns (string) The standard format for the string, or the unchanged value if it is unknown.
export timeframeToString(string timeframe) =>
    inSeconds = timeframe.in_seconds(timeframe)
    switch
        inSeconds < 60 => str.format('{0,number,#}s', inSeconds)
        inSeconds < 3600 => str.format('{0,number,#}m', inSeconds / 60)
        inSeconds < 86400 => str.format('{0,number,#}h', inSeconds / 3600)
        inSeconds < 604800 => str.format('{0,number,#}D', inSeconds / 86400)
    	=> timeframe

// @function Convert an english-friendly timeframe string to a value that can be used by request.security. Specifically, this corrects hour strings (eg. 4h) to their numeric "minute" equivalent (eg. 240)
// @param tf (string) The timeframe string to convert
// @returns (string) The standard format for the string, or the unchanged value if it is unknown.
export stringToTimeframe(string timeframe) =>
    tf = timeframe
    // Make sure that hour strings are handled like seconds, days, weeks, months, etc
    if str.endswith(str.lower(tf), 'h') 
        hours = str.tonumber(str.replace(tf, 'h', ''))
        if not na(hours)
            log.info('hours {0}', hours)
            tf := str.tostring(hours * 60)
        else
            // Assume 1 hour (in case a number was not specified)
            tf := '60'
    tf

// @function Takes a user-defined "timeframe" string, parses it to determine it's validity, and returns 
// everything you need to use the timeframe in request.security calls or in labels. It also takes care of 
// correcting user input errors like incorrect case or using "h" which is not supported by tradingview.
// @param userTimeframe (string) User-defined string representing the timeframe. 
// @returns (tuple) Four values: 1. The count of the timeframe (eg. "5" from "5D"), 2. The Unit of the 
// timeframe (eg. "D" from "5D", 3. A user-friendly label (eg. "2h" from "120"), 4. A string safe for use 
// in request.security functions (eg. "240" from "4h").
export getTimeframePartsFromUserString(string userTimeframe) =>
    tfInput = str.trim(userTimeframe)
    isEmpty = tfInput == ""

    rawTf = isEmpty ? timeframe.period : tfInput
    tfLen = str.length(rawTf)

    tfNumRaw = str.tonumber(rawTf)
    isNumericOnly = not na(tfNumRaw)

    tfNum = isNumericOnly ? tfNumRaw :
      tfLen == 1 ? 1 :  // If only one char (e.g., "D"), assume 1
      str.tonumber(str.substring(rawTf, 0, tfLen - 1))

    tfUnitRaw = isNumericOnly ? "m" : str.substring(rawTf, tfLen - 1, tfLen)

    // Whitelist-style normalization: only correct known incorrect cases
    suffix = switch tfUnitRaw
        "S" => "s"
        "H" => "h"
        "d" => "D"
        "w" => "W"
        "s" => "s"
        "m" => "m"
        "h" => "h"
        "D" => "D"
        "W" => "W"
        "M" => "M"
        => ""

    isValid = suffix != "" and not na(tfNum)

    // Promote m → h for display if evenly divisible by 60
    isPromotableToHours = isValid and suffix == "m" and (tfNum % 60 == 0)
    displayNum = isPromotableToHours ? tfNum / 60 : tfNum
    displaySuffix = isPromotableToHours ? "h" : suffix

    num = isValid ? math.round(displayNum) : na
    label = isValid ? str.tostring(math.round(displayNum)) + displaySuffix : ""
    tradingViewSafeVal = switch suffix
        "s" => str.tostring(tfNum) + "S"
        "m" => str.tostring(tfNum)
        "h" => str.tostring(tfNum * 60)
        "D" => str.tostring(tfNum) + "D"
        "W" => str.tostring(tfNum) + "W"
        "M" => str.tostring(tfNum) + "M"
        => rawTf  // fallback to raw input or chart timeframe

    tradingViewSafe = isValid ? tradingViewSafeVal : rawTf

    [num, displaySuffix, label, tradingViewSafe]

// @function Takes the timeframe values returned from getTimeframePartsFromUserString(), the length of a
// moving average, and the type of moving average and returns a user-friendly formatted string.
// @param tfCount (int) Timeframe count (eg. "5" from "5D")
// @param tfUnit (string) Timeframe unit (eg. "D" from "5D")
// @param length (int) The length of a moving average
// @param maType (str) The type of moving average being defined (eg. sma, ema, etc)
// @returns (string) User-friendly formatted string representing the moving average (eg. "5D sma" or "4h ema 12"
export getMovingAverageLabel(int tfCount, string tfUnit, int length, string maType) =>
    str.tostring(tfCount) + tfUnit + " " + str.tostring(length) + str.lower(maType)

// @function Returns the number of minutes in the given session for the specified symbol.
// @param session The session type ('market', 'overnight', etc.).
// @param symbol The symbol to check. Defaults to chart symbol if empty.
// @param sessionMap The session map. Defaults to the internal map if not provided.
// @returns The number of minutes in the session, or a default fallback if unavailable.
export getMinutesInSession(string session = 'market', string symbol = '', map<string, string> sessionMap = na) =>
    sessionStr = Session.getSessionString(session, symbol, sessionMap)

    // Assign default minutes based on asset type and session
    minutes = switch syminfo.type
        "stock"   => session == "overnight" ? 840 : 390  // Stocks: RTH (9:30-4:00) or ETH (4:00-8:00)
        "futures" => session == "overnight" ? 810 : 405  // Futures: RTH (8:30-3:15) or ETH (6:00 PM - 9:00 AM)
        "forex"   => 1440  // Forex: 24/7
        "crypto"  => 1440  // Crypto: 24/7
        => session == "overnight" ? 840 : 390  // Default to stock market hours

    if not na(sessionStr)
        parts = str.split(sessionStr, "-")  // Extract session start/end times
        if array.size(parts) == 2
            startStr = array.get(parts, 0)
            endStr = array.get(parts, 1)

            // Convert HHMM string to minutes
            startHour = str.tonumber(str.substring(startStr, 0, 2))
            startMinute = str.tonumber(str.substring(startStr, 2, 4))
            endHour = str.tonumber(str.substring(endStr, 0, 2))
            endMinute = str.tonumber(str.substring(endStr, 2, 4))

            // Compute session duration in minutes and force integer type
            minutes := int(math.round((endHour * 60 + endMinute) - (startHour * 60 + startMinute)))

    minutes

// @function Convenience function used to determine if a provided timeframe can be used when calculating a moving average on the current chart (instead of calling request.security for the same) 
// @param int tfCount Int representing the # of timeframe units being requested
// @param string tfUnit String representing the TradingView-safe timeframe being requested
// @param string tfSafe A TradingView safe string representing the timeframe being requested
// @param map sessionMap Session.getSessionMap()
// @returns int the number of minutes in the provided timeframe if valid for these kinds of calculations, na otherwise.
// Determine the number of candles required to use the current chart to capture a higher timeframe moving average safely
export getTimeframeMinutes(int tfCount, string tfUnit, string tfSafe, map<string, string> sessionMap) =>
    chartSeconds = timeframe.in_seconds(timeframe.period)

    // If input is empty or invalid
    if na(tfCount) or tfUnit == ""
        // Fall back to using the chart timeframe, but only if it's intraday
        if not na(chartSeconds) and chartSeconds < 86400
            chartSeconds / 60
        else
            na

    // Block unsupported higher timeframes
    else if tfUnit == "W" or tfUnit == "M"
        na

    // Special handling for daily timeframe: only allow if chart <= 30m
    else if tfUnit == "D"
        if chartSeconds > 1800
            na
        else
            seconds = timeframe.in_seconds(tfSafe)
            not na(seconds) ? (seconds / 86400) * getMinutesInSession('market', '', sessionMap) : na

    // Standard intraday timeframes
    else if tfUnit == 'S'
        na // Seconds is less than minutes, skip
    else 
        seconds = timeframe.in_seconds(tfSafe)
        not na(seconds) ? seconds / 60 : na

// @function Gives you a bug-free object to use in request.security calls.
// Workaround for 3 bugs: 
// Bug 1: request.security() behaves differently in Bar Replay when the symbol argument is a ticker.new(...) object vs syminfo.tickerid. 
// In Replay, request.security(ticker.new(...), ...) can stop advancing, while request.security(syminfo.tickerid, ...) keeps updating normally.
// Why? TradingView’s MTF engine aggressively caches request.security() results keyed on the request’s identity (symbol + timeframe + expression + options). 
// In Bar Replay, the “current bar” is recalculated repeatedly as you step.
// syminfo.tickerid is a stable identifier string for the chart’s symbol, so the engine can consistently resolve and advance the MTF series as replay progresses.
// ticker.new(syminfo.prefix, syminfo.ticker, syminfo.session) produces a constructed ticker object (and you’re constructing it inside the script). 
// In Replay, TradingView sometimes treats that as not the same stable identity across replay steps, so the cached security() stream doesn’t get advanced/refreshed correctly and effectively “sticks”.
// Bug 2: For futures symbols, if you use a ticker object with session.extended and pass into request.security, it results in wildly innacurate candle data and moving averages.
// Bug 3: If you use a ticker with session.extended on timeframes daily and above, it returns wildly innacurate data. 
// The fix? 
// Don't use the ticker object at all if any of the following are true:
// 1. You're in replay mode
// 2. You're on a futures symbol
// 3. You're requesting data on the daily timeframe or higher
// @param session session.extended or session.regular
// @param tf The timeframe string being requested
// @returns Either syminfo.tickerid or a ticker object configured with the requested session
export getSafeTicker(string session, string tf = '') =>
    // Are we in replay mode?
    isReplay = str.contains(syminfo.tickerid, "replay")
    // Are we requesting for the daily timeframe or higher?
    tfLastChar = str.length(tf) > 0 ? str.upper(str.substring(tf, str.length(tf) - 1, str.length(tf))) : ''
    isDailyOrHigher = (tfLastChar == "D" or tfLastChar == "W" or tfLastChar == "M")
      or (str.length(tf) == 0 and timeframe.in_seconds() >= timeframe.in_seconds("D")) 
    // Are we on a futures symbol?
    isFutures = syminfo.type == 'futures'
    isReplay or isDailyOrHigher or isFutures ? syminfo.tickerid : ticker.new(syminfo.prefix, syminfo.ticker, session)

// @function Used when determining if a moving average on a higher timeframe can be calculated using the bars on the current chart. 
// @param htfMinutes The number of minutes in the higher timeframe being requested for the moving average
// @param length The length of the moving average being calculated
// @param maxBarsBack The max # of bars back that we should be allowed to use. Defaults to 5000
// @returns int The number of minutes in the higher timeframe moving average if there is enough data on the chart to calculate the moving average
export getValidMALength(int htfMinutes, int length, int maxBarsBack = 5000) =>
    chartSeconds = timeframe.in_seconds()  // Get chart timeframe in seconds

    if na(htfMinutes) or na(chartSeconds) or chartSeconds == 0
        na  // Invalid inputs, fallback to request.security()
    else
        chartMinutes = chartSeconds / 60  // Convert chart timeframe to minutes
        barsPerPeriod = htfMinutes / chartMinutes  // Works for minute-based charts

        // Handle second-based charts separately
        if chartSeconds < 60
            barsPerPeriod := (htfMinutes * 60) / chartSeconds  // Convert HTF to seconds

        // Ensure `barsPerPeriod` is a whole number
        isWholeNumber = barsPerPeriod == math.floor(barsPerPeriod)

        // Check if requested bars exceed TradingView’s processing limit
        enoughBars = (length * barsPerPeriod) <= maxBarsBack and isWholeNumber

        enoughBars ? (length * barsPerPeriod) : na

// @function Computes a moving average for daily timeframes, using only regular session bars.
// @param float src The source price input for the moving average.
// @param int length The number of days to average.
// @param string maType The type of moving average: "SMA", "EMA".
// @returns The moving average for the daily timeframe, or `na` during extended hours.
export getDailyMA(float src, int length, string maType = "SMA") =>
    var float sumPrice = 0.
    var int validBars = 0
    var float dailyMA = na
    var float emaVal = na
    var bars = array.new<float>()

    if Session.ismarket()  // Only process bars during regular session
        array.push(bars, src)
        sumPrice := sumPrice + src
        validBars := validBars + 1

        // Accumulate values for different MA types
        alpha = 2 / (length + 1)
        emaVal := na(emaVal[1]) ? src : alpha * src + (1 - alpha) * nz(emaVal[1])
        
        // Once we have enough bars for `length` full sessions, calculate MA
        if validBars >= length
            dailyMA := switch maType
                "EMA" => emaVal
                => sumPrice / length  // Default to SMA

            // Prevent subtracting `src[length]` before we have enough data
            oldestRTHBar = array.shift(bars)
            sumPrice := sumPrice - oldestRTHBar  // Remove oldest price
            validBars := validBars - 1

    dailyMA

// @function Calculates the price that a plot will be at on a specific bar_index if it continues in it's current direction.
// @param secondLastPrice The second-last known price of a plot.
// @param lastPrice The last known price of a plot.
// @param secondLastIndex The second-last known bar_index of a plot.
// @param lastIndex The last known bar_index of a plot.
// @param targetIndex The bar_index at which you want to calculate price. Must be greater than lastIndex. Defaults to bar_index.
// @returns The value of price when the plot gets to targetIndex or na if unable to calculate.
export projectPrice(float secondLastPrice, float lastPrice, int secondLastIndex, int lastIndex, int targetIndex = bar_index) =>
    // Must have two valid points and targetIndex must be >= lastIndex
    valid = not na(secondLastPrice) and not na(lastPrice) and
      not na(secondLastIndex) and not na(lastIndex) and
      (lastIndex > secondLastIndex)

    if not valid
        na
    else
        dx = float(lastIndex - secondLastIndex)
        dy = lastPrice - secondLastPrice
        slope = dx != 0 ? dy / dx : 0.0

        // Project from lastPrice toward targetIndex
        barsAhead = float(targetIndex - lastIndex)
        lastPrice + slope * barsAhead

// @function Projects a plot value to a future bar_index using confirmed history,
//           with an optional decaying adjustment based on a live "guess" value.
//
//           The confirmed projection is calculated linearly from the last two
//           confirmed plot points. If a live guess (e.g., from getMaLive) is
//           provided for the current bar, the difference ("shock") between the
//           confirmed projection and the live guess at the current bar is
//           applied to the far target with exponential decay.
//
//           This prevents sharp kinks when projecting far to the right while
//           still allowing near-term projections to reflect live HTF updates.
//
//           IMPORTANT: This function does NOT predict future EMA values.
//           It is purely a UI smoothing utility for drawing projection lines.
//
// @param secondLastPrice   The second-most recent confirmed plot value.
// @param lastPrice         The most recent confirmed plot value.
// @param secondLastIndex   bar_index of secondLastPrice.
// @param lastIndex         bar_index of lastPrice.
// @param yNowLive          Live estimate of the plot value at `nowIndex`
//                          (e.g., output of getMaLive).
// @param nowIndex          bar_index corresponding to yNowLive (typically bar_index).
// @param targetIndex       bar_index where the projection should end (label location).
//                          Must be >= nowIndex.
// @param halfLifeBars      Controls how quickly the live shock influence decays
//                          as targetIndex moves farther from nowIndex.
//                          Smaller values = live guess affects only near labels.
//                          Larger values = live guess influences farther projections.
// @returns                 Projected plot value at targetIndex, adjusted by
//                          decayed live shock. Returns na if insufficient data.
export projectWithShockDecay(
    float secondLastPrice,
    float lastPrice,
    int secondLastIndex,
    int lastIndex,
    float yNowLive,
    int nowIndex,
    int targetIndex,
    float halfLifeBars = 15.0
) =>
    // Need valid confirmed history
    bool valid =
         not na(secondLastPrice) and not na(lastPrice) and
         not na(secondLastIndex) and not na(lastIndex) and
         (lastIndex > secondLastIndex) and
         (targetIndex >= nowIndex)

    if not valid
        na
    else
        // Confirmed projection at nowIndex and targetIndex
        float yNowConfirmed = projectPrice(secondLastPrice, lastPrice, secondLastIndex, lastIndex, nowIndex)

        float yTargetConfirmed = projectPrice(secondLastPrice, lastPrice, secondLastIndex, lastIndex, targetIndex)

        if na(yNowConfirmed) or na(yTargetConfirmed) or na(yNowLive)
            yTargetConfirmed
        else
            // Shock = deviation of live guess from confirmed trend at "now"
            float shock = yNowLive - yNowConfirmed

            // Exponential decay of shock influence over distance
            float barsAhead = float(targetIndex - nowIndex)
            float hl = math.max(1.0, halfLifeBars)
            float decay = math.exp(-barsAhead / hl)

            yTargetConfirmed + shock * decay

// @function Computes a progress-weighted "live" EMA guess for a higher timeframe bar.
// @param maPrev The last confirmed HTF EMA (e.g., ema[1] from HTF)
// @param length EMA length
// @param htfOpen HTF bar open time (ms)
// @param htfClose HTF bar close time (ms)
// @returns A blended guess (near maPrev early in bar, near raw live EMA late in bar)
export getMaLive(float maPrev, int length, int htfOpen, int htfClose) =>
    if na(maPrev) or na(htfOpen) or na(htfClose) or htfClose <= htfOpen
        na
    else
        float alpha = 2.0 / (length + 1)

        // Raw "live" EMA as-if on the HTF chart right now
        float raw = alpha * close + (1.0 - alpha) * maPrev

        // Progress through the HTF bar (0..1)
        float p = float(time - htfOpen) / float(htfClose - htfOpen)
        p := math.max(0.0, math.min(1.0, p))

        // Ease it (optional but looks better than linear)
        float w = p * p * (3.0 - 2.0 * p)  // smoothstep

        // Blend: early -> maPrev, late -> raw
        maPrev + (raw - maPrev) * w

// @function Calculates plot points for extrapolating a dotted line to a label.
//          x1/y1 ALWAYS equals the last confirmed plot point (lastIndex/lastPrice).
//          If guessPrice is provided (live value from getMaLive at bar_index),
//          it adjusts the far endpoint by a decaying "shock" so gaps don't create cartoon kinks.
// @param price The confirmed plot value (typically from request.security). Often na between HTF updates.
// @param targetIndex The bar_index where you want the dotted line to end (label position).
// @param guessPrice Live "now" estimate from getMaLive (value at bar_index). Optional.
// @param halfLifeBars Controls how quickly the live shock influence decays as the label is farther right.
// @returns x1, y1, x2, y2
export getPlotPoints(float price, int targetIndex = bar_index, float guessPrice = na, float halfLifeBars = 15.0) =>
    var float secondLastPrice = na
    var float lastPrice = na
    var secondLastIndex = int(na)
    var lastIndex = int(na)

    // Track last confirmed points
    if not na(price)
        secondLastPrice := lastPrice
        lastPrice := price
        secondLastIndex := lastIndex
        lastIndex := bar_index

    // Need at least one confirmed point to draw
    if na(lastPrice) or na(lastIndex)
        [na, na, na, na]
    else
        int x1 = lastIndex
        float y1 = lastPrice

        int x2 = math.max(targetIndex, x1)

        bool haveTwoConfirmed = not na(secondLastPrice) and not na(secondLastIndex) and (lastIndex > secondLastIndex)

        // Base target: straight projection from confirmed history (or flat if only one point)
        float y2 = haveTwoConfirmed ? projectPrice(secondLastPrice, lastPrice, secondLastIndex, lastIndex, x2) : lastPrice

        // Optional shock-decay adjustment using the live guess at bar_index
        if not na(guessPrice) and haveTwoConfirmed
            int nowIndex = bar_index

            // Where confirmed projection says we should be NOW
            float yNowConfirmed = projectPrice(secondLastPrice, lastPrice, secondLastIndex, lastIndex, nowIndex)

            if not na(yNowConfirmed)
                float barsAhead = float(x2 - nowIndex)
                float hl = math.max(1.0, halfLifeBars)
                float decay = math.exp(-barsAhead / hl)

                float shock = guessPrice - yNowConfirmed
                y2 += shock * decay

        [x1, y1, x2, y2]

// @function Defines a label for the end of a price level line. 
// @param price The price level to render the label at.
// @param labelOffset The number of candles to place the label to the right of price. 
// @param labelStyle A plain english string as defined in getLabelStyleFromString.
// @param labelSize The size of the label.
// @param labelColor The color of the label. 
// @param textColor The color of the label text (defaults to #ffffff)
// @returns The label that was created.
export getPriceLabel(float price, int labelOffset, string labelStyle, string labelSize, color labelColor, color textColor = #ffffff) =>
    labelTime = getTimeNowPlusOffset(labelOffset)
    txtColor = labelStyle == 'Plain Text' ? labelColor : textColor
    lblColor = labelStyle != 'Plain Text' ? labelColor : #ffffff00
    label.new(labelTime, price, '', xloc=xloc.bar_time, color=lblColor, textcolor=txtColor, style=label.style_label_left, size=labelSize)

// @function Updates the label position & text based on price changes.
// @param label The label to update.
// @param labelName The name of the price level to be placed on the label.
// @param price The price level to render the label at.
// @param labelOffset The number of candles to place the label to the right of price. 
// @param labelTemplate The str.format template to use for the label. Defaults to: '{0}: {1} {2}{3,number,#.##}%' which means '{price}: {labelName} {+/-}{percentFromPrice}%'
export setPriceLabel(label label, string labelName, float price, int labelOffset, string labelTemplate = '', string labelStyle = na, color labelColor = na, color textColor = #ffffff) =>
    labelTime = getTimeNowPlusOffset(labelOffset)
    _labelTemplate = labelTemplate == '' ? '{0}: {1} {2}{3,number,#.##}%' : labelTemplate
    pfp = getPercentFromPrice(price)*100
    op = pfp > 0 ? '+' : ''
    _price = str.tostring(price, format.mintick)
    labelText = str.format(_labelTemplate, _price, labelName, op, pfp)
    label.set_text(label, labelText)
    label.set_xy(label, labelTime, price)
    if na(labelStyle) == false and na(labelColor) == false
        txtColor = labelStyle == 'Plain Text' ? labelColor : textColor
        lblColor = labelStyle != 'Plain Text' ? labelColor : #ffffff00
        label.set_textcolor(label, txtColor)
        label.set_color(label, lblColor)


// @function Defines a line that will stretch from the plot line to the label.
// @param price The price level to render the label at.
// @param labelOffset The number of candles to place the label to the right of price. 
// @param labelStyle A plain english string as defined in getLabelStyleFromString.
// @param lineWidth The width of the line. Defaults to 1. 
// @param lineStyle The style of the line. Defaults to line.style_solid.
export getPriceLabelLine(float price, int labelOffset, color labelColor, int lineWidth=1, string lineStyle=line.style_solid) =>
    labelTime = getTimeNowPlusOffset(labelOffset)
    line.new(time, price, labelTime, price, xloc=xloc.bar_time, color=labelColor, width=lineWidth, style=lineStyle)

// @function Updates the price label line based on price changes.
// @param line The line to update.
// @param price The price level to render the label at.
// @param labelOffset The number of candles to place the label to the right of price. 
// @param lastTime The last time that the line should stretch from. Defaults to time.
export setPriceLabelLine(line line, float price, int labelOffset, int lastTime = time, color lineColor = na) =>
    labelTime = getTimeNowPlusOffset(labelOffset)
    line.set_xy1(line, lastTime, price)
    line.set_xy2(line, labelTime, price)
    if na(lineColor) == false
        line.set_color(line, lineColor)

// @type Key daily level. Used by the "Day Trader Levels" indicators to remember key levels from key moments each day.
export type Level
    // string kind = 'day' // The type of level: day, rth, premarket. This value is used to determine when to draw the lines/labels on the screen
    string name = 'Level Name'
    string label = 'Level Label'
    color color = color.blue
    string style = line.style_solid
    int startTime = 0 // The timestamp where the line for this level should start
    int firmness = 0 // The higher the number, the firmer the level (ie. a break is more significant)
    bool shade = true // Apply firmness shade to level
    float price = 0.
    string whenToHide = 'Never'
    bool show = true

// @function Renders a <Level>level line & label.
// @param sessionMap Session library sessionMap
// @param level Level to be rendered
// @param labelStyle label.style_* enum.
// @param labelSize size.* enum.
// @param labelOffset int The number of bars to the right of price to end the label line.
// @param labelTemplate string The template to use when rendering the label text.
export drawLevel(map<string, string> sessionMap, Level level, string labelStyle, string labelSize, int labelOffset = 0, string labelTemplate='') =>
    showLevel = level.whenToHide != 'Never' and Session.inSession(level.whenToHide, sessionMap) ? false : true
    levelIsValid = level.price > 0 and level.price < 10e10 and not na(level.price)
    var label levelLabel = na
    var line levelLine = na
    var line levelLineBG = na
    if showLevel and levelIsValid and level.show
        if na(levelLabel)
            levelLabel := getPriceLabel(level.price, labelOffset, labelStyle, labelSize, level.color, #ffffff)
            levelLine := getPriceLabelLine(level.price, labelOffset, level.color, 1, level.style)
            if level.shade
                bgColor = color.new(level.color, 90 - level.firmness)
                levelLineBG := getPriceLabelLine(level.price, labelOffset, bgColor, 8)

        setPriceLabel(levelLabel, level.label, level.price, labelOffset, labelTemplate=labelTemplate)
        setPriceLabelLine(levelLine, level.price, labelOffset, level.startTime)
        if level.shade
            setPriceLabelLine(levelLineBG, level.price, labelOffset, level.startTime)
    else
        label.delete(levelLabel)
        line.delete(levelLine)
        line.delete(levelLineBG)


// @function Uses the last three candles to detect a fair value gap. 
// @param allowHybrid If true, allow “non-pure” fvgs
// @param minBodyRangePercent For hybrid: middle candle body / range must be >= this
// @param minAtrMultiple Minimum gap size in ATR (e.g. 0.25)
// @returns tuple fvgType, fvgIsPure, fvgStrong, fvgTop, fvgBottom
// fvgType 'Bull', 'Bear', 'None'
// fvgIsPure True if it passed strict body-intersection rules
// fvgStrong True when all three candles were moving in the same direction
// fvgTop The price level of the fvg top
// fvgBottom The price level of the fvg bottom
export getFVG(bool allowHybrid = true, float minBodyRangePercent = 0.8, float minAtrMultiple = 0.25) =>
    atrValue = ta.atr(14)
    // Use bars: [2] = left, [1] = middle, [0] = current/right
    // Middle candle body and range
    midOpen  = open[1]
    midClose = close[1]
    midHigh  = math.max(midOpen, midClose)  // body high
    midLow   = math.min(midOpen, midClose)  // body low

    midRange = high[1] - low[1]
    midBody  = math.abs(midClose - midOpen)
    bodyFrac = midRange > 0.0 ? midBody / midRange : 0.0

    // ── STRICT (pure) FVGs ────────────────────────────────
    bullPure = barstate.isconfirmed and low > high[2] and low < midHigh and high[2] > midLow
    bearPure = barstate.isconfirmed and low[2] > high and high > midLow and low[2] < midHigh

    // ── HYBRID / NON-PURE FVGs ────────────────────────────
    // Idea: still have a clean gap between [2] and [0],
    // but candle [2] only reaches into [1]'s *wick range* (not its body),
    // and [1] is a strong displacement candle (big body vs range).

    bullHybrid = false
    bearHybrid = false

    if allowHybrid and barstate.isconfirmed
        // Bullish hybrid:
        //   - gap between [2] high and [0] low still exists
        //   - [2] high is inside [1] total range, but not inside [1] body
        //   - [0] low still intersects [1] range somewhere above its low
        //   - middle candle has a big body (strong displacement)
        priorInMidRangeBull   = high[2] > low[1] and high[2] <= midLow
        rightTouchesMidRange  = low < high[1]
        bullHybrid := low > high[2] and priorInMidRangeBull and rightTouchesMidRange and bodyFrac >= minBodyRangePercent and not bullPure

        // Bearish hybrid (mirror logic)
        priorInMidRangeBear   = low[2] < high[1] and low[2] >= midHigh
        rightTouchesMidRangeB = high > low[1]
        bearHybrid := low[2] > high and priorInMidRangeBear and rightTouchesMidRangeB and bodyFrac >= minBodyRangePercent and not bearPure

    // ── Combine & size filter ─────────────────────────────
    bullAny = bullPure or bullHybrid
    bearAny = bearPure or bearHybrid

    fvgTop    = bullAny ? low : bearAny ? low[2] : na
    fvgBottom = bullAny ? high[2] : bearAny ? high : na

    isBigEnough = bullAny or bearAny ? (fvgTop - fvgBottom) > atrValue * minAtrMultiple : false

    fvgBull = bullAny and isBigEnough
    fvgBear = bearAny and isBigEnough
    fvgIsPure = isBigEnough ? (fvgBull ? bullPure : fvgBear ? bearPure : false) : false

    fvgType = fvgBull ? 'Bull' : fvgBear ? 'Bear' : 'None'
    fvgBullStrong = fvgBull and open[2] < close[2] and open[1] < close[1] and open < close
    fvgBearStrong = fvgBear and open[2] > close[2] and open[1] > close[1] and open > close
    fvgStrong = fvgBullStrong or fvgBearStrong

    [fvgType, fvgIsPure, fvgStrong, fvgTop, fvgBottom]

// Sample usage of the user-friendly input conversions

friendlyLineStyle = input.string('Solid', 'Line Style', ["Solid", "Dashed", "Dotted", "None/Hidden"])
lineStyle = getLineStyleFromString(friendlyLineStyle)

friendlyLabelStyle = input.string('Left', 'Label Position', ["Center", "Left", "Lower Left", "Lower Right", "Right", "Up", "Upper Left", "Upper Right", "Plain Text", "No Labels"])
labelStyle = getLabelStyleFromString(friendlyLabelStyle)

// Note: there are no tables in this library, but this example provided nonetheless...
friendlyPosition = input.string('Bottom Center', 'Table Position', ["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"])
position = getPositionFromString(friendlyPosition)

// Example of the various string & timeframe functions

// Variables 

[premarketHigh, premarketLow] = request.security(syminfo.tickerid, timeframe.period, getPremarketHighsAndLows())
percentFromPremarketHigh = getPercentFromPrice(premarketHigh)*100
friendlyVolume = formatNumber(volume)
date = getDateString(time)
dateTime = getDateTimeString(time)
insideBarCount = getInsideBarCount()
fiveCandlesIntoTheFuture = getTimeNowPlusOffset(5)
numberOfDogs = 1
labelTemplate = 'Premarket High: {0,number,currency} ({1})'
  + '\nVolume: {2}'
  + '\nDate String: {3}'
  + '\nDateTime String: {4}'
  + '\nInside Bar Count: {5}'
  + '\nDogs: {6} dog{7}'
labelString = str.format(labelTemplate, premarketHigh, str.tostring(percentFromPremarketHigh, format.percent), friendlyVolume, date, dateTime, insideBarCount, numberOfDogs, plural(numberOfDogs))
var line exampleLine = na
var label exampleLabel = na

// Drawings

if lineStyle != "None/Hidden"
	if na(exampleLine)
		exampleLine := line.new(time[1], premarketHigh, time[0], premarketHigh, xloc.bar_time, extend.both, color.blue, lineStyle)
	else
		line.set_x2(exampleLine, fiveCandlesIntoTheFuture)
		line.set_y1(exampleLine, premarketHigh)
		line.set_y2(exampleLine, premarketHigh)

if labelStyle != "No Labels"
	bgColor = labelStyle == label.style_none ? #ffffff00 : color.blue
	textColor = labelStyle == label.style_none ? color.blue : color.white
	if na(exampleLabel)
		exampleLabel := label.new(time, premarketHigh, '', xloc.bar_time, yloc.price, bgColor, labelStyle, textColor, size.small)
	else
		label.set_xy(exampleLabel, fiveCandlesIntoTheFuture, premarketHigh)
		label.set_text(exampleLabel, padLabelString(labelString, labelStyle))


// Example of how to get the price level associated with an RSI level
rsiLength = 14
labelOffset = 10
labelStyle := "Plain Text"
rsiOBColor = color.red
rsiOSColor = color.green
[hourRsi, avgUp, avgDown] = request.security(syminfo.tickerid, '60', getRsiAvgsExpression(rsiLength), lookahead=barmerge.lookahead_on)
hourOverbought = getRsiPrice(70, rsiLength, avgUp, avgDown)
hourOversold = getRsiPrice(30, rsiLength, avgUp, avgDown)
plot(hourOverbought, 'Hourly RSI Overbought', rsiOBColor)
plot(hourOversold, 'Hourly RSI Oversold', rsiOSColor)

var rsiOBLabel = getPriceLabel(hourOverbought, labelOffset, labelStyle, size.small, rsiOBColor)
var rsiOBLine = getPriceLabelLine(hourOverbought, labelOffset, rsiOBColor)
setPriceLabel(rsiOBLabel, 'RSI OB', hourOverbought, labelOffset)
setPriceLabelLine(rsiOBLine, hourOverbought, labelOffset)

var rsiOSLabel = getPriceLabel(hourOversold, labelOffset, labelStyle, size.small, rsiOSColor)
var rsiOSLine = getPriceLabelLine(hourOversold, labelOffset, rsiOSColor)
setPriceLabel(rsiOSLabel, 'RSI OS', hourOversold, labelOffset)
setPriceLabelLine(rsiOSLine, hourOversold, labelOffset)