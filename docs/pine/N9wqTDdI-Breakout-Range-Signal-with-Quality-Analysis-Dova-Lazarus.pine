//@version=6
indicator("Breakout Range Signal with Quality Analysis [Dova Lazarus]", shorttitle="BRS-QA [Dova Lazarus]", overlay=true)

// ═══════════════════ USER INPUT SETTINGS ═══════════════════

// Channel Settings
channel_length = 10
channel_multiplier = 0.0
channel_smoothing_type = "SMA" 

// Signal Settings
body_threshold_percent = input.float(50, "Body > Channel %", step=1, minval=10.0, maxval = 100.0, tooltip="How many persent is the candle larger than the channel") / 100
signal_mode = input.string("Weak", "Signal Mode", 
     options=["Weak", "Strong"], 
     tooltip="Weak = all signals, Strong = only first in series")

// Signal Colors
bullish_signal_color = color.blue//input.color(color.blue, "Bullish Signal Color")
bearish_signal_color = color.yellow//input.color(color.yellow, "Bearish Signal Color")

// Trend Filter Settings
trend_filter_enabled = input.bool(false, "Enable Trend Filter", 
     tooltip="Filters signals based on trend direction")
trend_length = 10 //input.int(10, "Trend Length", minval=1, maxval=500)
trend_smoothing_type = "SMA" //input.string("SMA", "Trend Smoothing Type", options=["SMA", "EMA", "WMA", "VWMA"])
trend_timeframe = input.timeframe("1D", "Trend Timeframe", tooltip="Should be higher than chart timeframe")

// Quality Analysis Settings
enable_quality_analysis = input.bool(true, "Enable Quality Analysis", 
     tooltip="Analyze signal quality and calculate win rate")
show_channel= input.bool(false, "Show Channel", 
     tooltip="Display Channel and Trand line")
show_stoploss_takeprofit_lines= input.bool(true, "Show SL & TP lines", tooltip="Display Stop Loss and Take Profit lines")
profit_stoploss_lines = input.int(title="Signals too show", defval=1, minval=0, tooltip="How many days to show stop loss and take prifit lines")
profit_target_multiplier = input.float(1.0, "Profit Target Multiplier", step=0.1, minval=0.1, 
     tooltip="How many times channel width for profit target")
stoploss_target_multiplier = input.float(0.0, "Stop Loss Target Multiplier", step=0.1, minval=0.0, 
     tooltip="How many times channel width for Stop Loss")
max_bars_to_analyze = 500

// ═══════════════════ HELPER FUNCTIONS ═══════════════════

// Universal function for calculating moving averages
calculate_moving_average(source, length, ma_type) =>
    switch ma_type
        "SMA"  => ta.sma(source, length)
        "EMA"  => ta.ema(source, length) 
        "WMA"  => ta.wma(source, length)
        "VWMA" => ta.vwma(source, length)
        => na

// ═══════════════════ CORE CALCULATIONS ═══════════════════

// Channel boundaries based on high/low moving averages
upper_channel_ma = calculate_moving_average(high, channel_length, channel_smoothing_type)
lower_channel_ma = calculate_moving_average(low, channel_length, channel_smoothing_type)

// Channel expansion with multiplier
channel_width = math.abs(upper_channel_ma - lower_channel_ma)
upper_channel_border = upper_channel_ma + (channel_width * channel_multiplier)
lower_channel_border = lower_channel_ma - (channel_width * channel_multiplier)

// Trend line from higher timeframe
trend_line = request.security(syminfo.tickerid, trend_timeframe, 
     calculate_moving_average(close, trend_length, trend_smoothing_type))

// Candle body size and average channel width
candle_body_size = math.abs(close - open)
average_channel_width = math.abs(upper_channel_border - lower_channel_border)

// ═══════════════════ SIGNAL CONDITIONS ═══════════════════

// Base conditions for channel entry
is_open_within_channel = open > lower_channel_border and open < upper_channel_border
is_body_significant = candle_body_size > average_channel_width * (body_threshold_percent + 1)

// Bearish signal conditions (yellow candle)
bearish_candle_pattern = open > close
bearish_price_action = high < upper_channel_border
bearish_trend_alignment = trend_filter_enabled ? trend_line > upper_channel_border : true
bearish_signal_condition = is_body_significant and is_open_within_channel and 
                          bearish_candle_pattern and bearish_price_action and bearish_trend_alignment

// Bullish signal conditions (blu candle)
bullish_candle_pattern = open < close
bullish_price_action = low > lower_channel_border
bullish_trend_alignment = trend_filter_enabled ? trend_line < lower_channel_border : true
bullish_signal_condition = is_body_significant and is_open_within_channel and 
                          bullish_candle_pattern and bullish_price_action and bullish_trend_alignment

// ═══════════════════ SIGNAL MANAGEMENT ═══════════════════

// Variable to track last signal type
var string last_signal_type = na

// Determine final signals based on mode
var color candle_highlight_color = na
var bool final_bullish_signal = false
var bool final_bearish_signal = false

if signal_mode == "Strong"
    // Strong mode - only first signals in a series
    if bearish_signal_condition and last_signal_type != "bearish"
        candle_highlight_color := bearish_signal_color
        last_signal_type := "bearish"
        final_bearish_signal := true
    else if bullish_signal_condition and last_signal_type != "bullish"
        candle_highlight_color := bullish_signal_color
        last_signal_type := "bullish"
        final_bullish_signal := true
    else
        candle_highlight_color := na
        final_bullish_signal := false
        final_bearish_signal := false
else
    // Weak mode - all qualifying signals
    candle_highlight_color := bearish_signal_condition ? bearish_signal_color : 
                             bullish_signal_condition ? bullish_signal_color : na
    final_bullish_signal := bullish_signal_condition
    final_bearish_signal := bearish_signal_condition

// ═══════════════════ QUALITY ANALYSIS SYSTEM ═══════════════════

// Arrays to store signal data for analysis
var array<float> bullish_entry_prices = array.new<float>()
var array<int> bullish_entry_bars = array.new<int>()
var array<float> bullish_stop_levels = array.new<float>()
var array<float> bullish_target_levels = array.new<float>()

var array<float> bearish_entry_prices = array.new<float>()
var array<int> bearish_entry_bars = array.new<int>()
var array<float> bearish_stop_levels = array.new<float>()
var array<float> bearish_target_levels = array.new<float>()

// Statistics counters
var int total_bullish_signals = 0
var int winning_bullish_signals = 0
var int total_bearish_signals = 0
var int winning_bearish_signals = 0

// Lines SL and TP
var line profit_target_line = na
var line stop_loss_line = na
var array_profit_target_line = array.new_line(profit_stoploss_lines)
var array_stop_loss_line = array.new_line(profit_stoploss_lines)

// Lables SL and TP
var label profit_target_text = na
var label stop_loss_text = na
var array_profit_target_text = array.new_label(profit_stoploss_lines)
var array_stop_loss_text = array.new_label(profit_stoploss_lines)

if enable_quality_analysis
    // Record new bullish signals
    if final_bullish_signal
        entry_price = close
        stop_loss = lower_channel_border - (average_channel_width* stoploss_target_multiplier)
        profit_target = entry_price + (average_channel_width* profit_target_multiplier)

        if show_stoploss_takeprofit_lines
            profit_target_line := line.new(bar_index, profit_target, bar_index + 10, profit_target,style = line.style_solid, extend = extend.none, color = bullish_signal_color)
            stop_loss_line := line.new(bar_index, stop_loss, bar_index + 10, stop_loss, style = line.style_solid, extend = extend.none, color = bullish_signal_color)
            profit_target_text := label.new(bar_index + 8, profit_target, text="TP", textcolor=bullish_signal_color, style=label.style_label_lower_left, color = color.rgb(255, 255, 255, 100), textalign = text.align_right)
            stop_loss_text := label.new(bar_index + 8, stop_loss, text="SL", textcolor=bullish_signal_color, style=label.style_label_upper_left, color = color.rgb(255, 255, 255, 100), textalign = text.align_right)


        array.push(array_profit_target_text, profit_target_text)
        array.push(array_stop_loss_text, stop_loss_text)
        label.delete(array.shift(array_profit_target_text))
        label.delete(array.shift(array_stop_loss_text))

        array.push(array_profit_target_line, profit_target_line)
        array.push(array_stop_loss_line, stop_loss_line)
        line.delete(array.shift(array_profit_target_line))
        line.delete(array.shift(array_stop_loss_line))

        array.push(bullish_entry_prices, entry_price)
        array.push(bullish_entry_bars, bar_index)
        array.push(bullish_stop_levels, stop_loss)
        array.push(bullish_target_levels, profit_target)
        
        total_bullish_signals := total_bullish_signals + 1

    // Record new bearish signals
    if final_bearish_signal
        entry_price = close
        stop_loss = upper_channel_border + (average_channel_width* stoploss_target_multiplier)
        profit_target = entry_price - (average_channel_width * profit_target_multiplier)
        if show_stoploss_takeprofit_lines
            profit_target_line := line.new(bar_index, profit_target, bar_index + 10, profit_target,style = line.style_solid, extend = extend.none, color = bearish_signal_color)
            stop_loss_line := line.new(bar_index, stop_loss, bar_index + 10, stop_loss, style = line.style_solid, extend = extend.none, color = bearish_signal_color)
            profit_target_text := label.new(bar_index + 8, profit_target, text="TP", textcolor=bearish_signal_color, style=label.style_label_upper_left, color = color.rgb(255, 255, 255, 100), textalign = text.align_right)
            stop_loss_text := label.new(bar_index + 8, stop_loss, text="SL", textcolor=bearish_signal_color, style=label.style_label_lower_left, color = color.rgb(255, 255, 255, 100), textalign = text.align_right)

        array.push(array_profit_target_text, profit_target_text)
        array.push(array_stop_loss_text, stop_loss_text)
        label.delete(array.shift(array_profit_target_text))
        label.delete(array.shift(array_stop_loss_text))

        array.push(array_profit_target_line, profit_target_line)
        array.push(array_stop_loss_line, stop_loss_line)
        line.delete(array.shift(array_profit_target_line))
        line.delete(array.shift(array_stop_loss_line))

        array.push(bearish_entry_prices, entry_price)
        array.push(bearish_entry_bars, bar_index)
        array.push(bearish_stop_levels, stop_loss)
        array.push(bearish_target_levels, profit_target)
        
        total_bearish_signals := total_bearish_signals + 1

    // Analyze existing bullish signals
    if array.size(bullish_entry_bars) > 0
        for i = array.size(bullish_entry_bars) - 1 to 0
            entry_bar = array.get(bullish_entry_bars, i)
            bars_elapsed = bar_index - entry_bar
            
            if bars_elapsed <= max_bars_to_analyze
                stop_level = array.get(bullish_stop_levels, i)
                target_level = array.get(bullish_target_levels, i)
                
                // Check if signal resolved
                if low <= stop_level
                    // Stop loss hit - losing trade
                    array.remove(bullish_entry_prices, i)
                    array.remove(bullish_entry_bars, i)
                    array.remove(bullish_stop_levels, i)
                    array.remove(bullish_target_levels, i)
                else if high >= target_level
                    // Target hit - winning trade
                    winning_bullish_signals := winning_bullish_signals + 1
                    array.remove(bullish_entry_prices, i)
                    array.remove(bullish_entry_bars, i)
                    array.remove(bullish_stop_levels, i)
                    array.remove(bullish_target_levels, i)
            else
                // Signal expired - remove from analysis
                array.remove(bullish_entry_prices, i)
                array.remove(bullish_entry_bars, i)
                array.remove(bullish_stop_levels, i)
                array.remove(bullish_target_levels, i)

    // Analyze existing bearish signals
    if array.size(bearish_entry_bars) > 0
        for i = array.size(bearish_entry_bars) - 1 to 0
            entry_bar = array.get(bearish_entry_bars, i)
            bars_elapsed = bar_index - entry_bar
            
            if bars_elapsed <= max_bars_to_analyze
                stop_level = array.get(bearish_stop_levels, i)
                target_level = array.get(bearish_target_levels, i)
                
                // Check if signal resolved
                if high >= stop_level
                    // Stop loss hit - losing trade
                    array.remove(bearish_entry_prices, i)
                    array.remove(bearish_entry_bars, i)
                    array.remove(bearish_stop_levels, i)
                    array.remove(bearish_target_levels, i)
                else if low <= target_level
                    // Target hit - winning trade
                    winning_bearish_signals := winning_bearish_signals + 1
                    array.remove(bearish_entry_prices, i)
                    array.remove(bearish_entry_bars, i)
                    array.remove(bearish_stop_levels, i)
                    array.remove(bearish_target_levels, i)
            else
                // Signal expired - remove from analysis
                array.remove(bearish_entry_prices, i)
                array.remove(bearish_entry_bars, i)
                array.remove(bearish_stop_levels, i)
                array.remove(bearish_target_levels, i)

// Calculate win rates
bullish_win_rate = total_bullish_signals > 0 ? (winning_bullish_signals / total_bullish_signals) * 100 : 0
bearish_win_rate = total_bearish_signals > 0 ? (winning_bearish_signals / total_bearish_signals) * 100 : 0
total_signals = total_bullish_signals + total_bearish_signals
total_wins = winning_bullish_signals + winning_bearish_signals
overall_win_rate = total_signals > 0 ? (total_wins / total_signals) * 100 : 0

// ═══════════════════ VISUALIZATION ═══════════════════

// Color candles based on signals
barcolor(candle_highlight_color)

// Plot channel boundaries and trend line

plot(upper_channel_border, color=color.blue, title="Upper Channel Border", linewidth=1, display = show_channel ? display.all : display.none)
plot(lower_channel_border, color=color.orange, title="Lower Channel Border", linewidth=1, display = show_channel ? display.all : display.none)
plot(trend_line, color=color.green, title="Trend Line", linewidth=2, display = show_channel and trend_filter_enabled ? display.all : display.none)

// Statistics Table
if enable_quality_analysis
    var table stats_table = table.new(position.top_right, 2, 6, bgcolor=color.white, border_width=1)
    
    if barstate.islast
        table.cell(stats_table, 0, 0, "Signal Statistics", text_color=color.black, text_size=size.normal, bgcolor=color.gray)
        table.cell(stats_table, 1, 0, "", text_color=color.black, text_size=size.normal, bgcolor=color.gray)
        
        table.cell(stats_table, 0, 1, "Overall Win Rate", text_color=color.black, text_size=size.small)
        table.cell(stats_table, 1, 1, str.tostring(overall_win_rate, "#.##") + "%", 
                  text_color=overall_win_rate >= 50 ? color.green : color.red, text_size=size.small)
        
        table.cell(stats_table, 0, 2, "Bullish Win Rate", text_color=color.black, text_size=size.small)
        table.cell(stats_table, 1, 2, str.tostring(bullish_win_rate, "#.##") + "%", 
                  text_color=bullish_win_rate >= 50 ? color.green : color.red, text_size=size.small)
        
        table.cell(stats_table, 0, 3, "Bearish Win Rate", text_color=color.black, text_size=size.small)
        table.cell(stats_table, 1, 3, str.tostring(bearish_win_rate, "#.##") + "%", 
                  text_color=bearish_win_rate >= 50 ? color.green : color.red, text_size=size.small)
        
        table.cell(stats_table, 0, 4, "Total Signals", text_color=color.black, text_size=size.small)
        table.cell(stats_table, 1, 4, str.tostring(total_signals), text_color=color.black, text_size=size.small)
        
        table.cell(stats_table, 0, 5, "Pending Analysis", text_color=color.black, text_size=size.small)
        pending_signals = array.size(bullish_entry_bars) + array.size(bearish_entry_bars)
        table.cell(stats_table, 1, 5, str.tostring(pending_signals), text_color=color.blue, text_size=size.small)
