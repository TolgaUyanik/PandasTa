//@version=6
// @description Murrey Math level calculation and zone detection.
// Adapted from Murrey Math Lines by Nanda86: https://www.tradingview.com/script/Pr1XQhCm-Murrey-Math-Lines-with-labels/
// Call via request.security() for desired timeframe (typically W).
library("lib_murrey", overlay=true)

// Calculate Murrey Math levels and current price zone.
// frame: frame size (default 64), mult: frame multiplier (default 1.5)
// Returns: [eight_eight, four_eight, zero_eight, zone, plus_18, minus_18, increment]
// zone: 2=extreme overshoot top, 1=overshoot top, 0=normal, -1=oversold, -2=extreme oversold
export get_murrey_levels(simple int frame, simple float mult) =>
    float logTen = math.log(10)
    float log8   = math.log(8)
    float log2   = math.log(2)
    int lookback  = int(math.round(frame * mult))

    // Use body (ignore wicks) for range calculation
    float uPrice = math.max(open, close)
    float lPrice = math.min(open, close)

    float vLow  = ta.lowest(lPrice, lookback)
    float vHigh = ta.highest(uPrice, lookback)
    float vDist = vHigh - vLow

    // Handle negative prices
    float tmpHigh = vLow < 0 ? 0.0 - vLow : vHigh
    float tmpLow  = vLow < 0 ? 0.0 - vLow - vDist : vLow
    bool shift    = vLow < 0

    // Calculate scale frame
    float sfVar = math.log(0.4 * tmpHigh) / logTen - math.floor(math.log(0.4 * tmpHigh) / logTen)
    float SR = tmpHigh > 25 ?
       (sfVar > 0 ? math.exp(logTen * (math.floor(math.log(0.4 * tmpHigh) / logTen) + 1)) :
       math.exp(logTen * math.floor(math.log(0.4 * tmpHigh) / logTen))) :
       100 * math.exp(log8 * math.floor(math.log(0.005 * tmpHigh) / log8))

    float nVar1 = math.log(SR / (tmpHigh - tmpLow)) / log8
    float nVar2 = nVar1 - math.floor(nVar1)
    float N = nVar1 <= 0 ? 0.0 : nVar2 == 0 ? math.floor(nVar1) : math.floor(nVar1) + 1

    // Scale interval and frame boundaries
    float SI  = SR * math.exp(-N * log8)
    float M   = math.floor(1.0 / log2 * math.log((tmpHigh - tmpLow) / SI) + 0.0000001)
    float I   = math.round((tmpHigh + tmpLow) * 0.5 / (SI * math.exp((M - 1) * log2)))
    float Bot = (I - 1) * SI * math.exp((M - 1) * log2)
    float Top = (I + 1) * SI * math.exp((M - 1) * log2)

    // Frame shift check
    bool doShift = tmpHigh - Top > 0.25 * (Top - Bot) or Bot - tmpLow > 0.25 * (Top - Bot)
    float ER = doShift ? 1.0 : 0.0

    float MM = ER == 0 ? M : (ER == 1 and M < 2 ? M + 1 : 0.0)
    float NN = ER == 0 ? N : (ER == 1 and M < 2 ? N : N - 1)

    // Recalculate if frame shift needed
    float finalSI  = ER == 1 ? SR * math.exp(-NN * log8) : SI
    float finalI   = ER == 1 ? math.round((tmpHigh + tmpLow) * 0.5 / (finalSI * math.exp((MM - 1) * log2))) : I
    float finalBot = ER == 1 ? (finalI - 1) * finalSI * math.exp((MM - 1) * log2) : Bot
    float finalTop = ER == 1 ? (finalI + 1) * finalSI * math.exp((MM - 1) * log2) : Top

    float Increment = (finalTop - finalBot) / 8.0
    float absTop = shift ? -(finalBot - 3 * Increment) : finalTop + 3 * Increment

    // Key Murrey levels
    float Plus18     = absTop - 2 * Increment     // +1/8 Overshoot
    float Plus28     = absTop - 1 * Increment     // +2/8 Extreme Overshoot
    float EightEight = absTop - 3 * Increment     // 8/8 Ultimate resistance
    float SevenEight = absTop - 4 * Increment     // 7/8 Weak, Stop & Reverse
    float SixEight   = absTop - 5 * Increment     // 6/8 Strong pivot reverse
    float FiveEight  = absTop - 6 * Increment     // 5/8 Top of trading range
    float FourEight  = absTop - 7 * Increment     // 4/8 Major S/R pivot
    float ThreeEight = absTop - 8 * Increment     // 3/8 Bottom of trading range
    float TwoEight   = absTop - 9 * Increment     // 2/8 Strong pivot reverse
    float OneEight   = absTop - 10 * Increment    // 1/8 Weak, Stop & Reverse
    float ZeroEight  = absTop - 11 * Increment    // 0/8 Ultimate Support
    float Minus18    = absTop - 12 * Increment    // -1/8 Oversold
    float Minus28    = absTop - 13 * Increment    // -2/8 Extreme Oversold

    // Zone detection: where is price relative to extreme levels?
    float zone = close >= Plus28 ? 2.0 :
                 close >= Plus18 ? 1.0 :
                 close <= Minus28 ? -2.0 :
                 close <= Minus18 ? -1.0 : 0.0

    [EightEight, FourEight, ZeroEight, zone, Plus18, Minus18, Increment]

// Get zone label for display
export zone_label(float zone) =>     zone >= 2.0  ? "EXTREME OVERSHOOT" :    zone >= 1.0  ? "OVERSHOOT" :    zone <= -2.0 ? "EXTREME OVERSOLD" : zone <= -1.0 ? "OVERSOLD" : "NORMAL"

// Check if price is in extreme Murrey zone (reversal territory)
export is_extreme(float zone) =>
    math.abs(zone) >= 1.0
