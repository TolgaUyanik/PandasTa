//@version=5
indicator("Pocket Pivot Buy Signal (PP-B)", overlay=true)

// === Input Parameters ===
length = input.int(10, minval=1, title="SMA Length")

// === Price and Volume Data ===
closeToday = close
closePrev = close[1]
lowToday = low
volumeToday = volume

// === 10-day Simple Moving Average ===
sma10 = ta.sma(close, length)

// === Condition 1: Closing price > prior close ===
cond1 = closeToday > closePrev

// === Condition 2: Low is on or below the 10-day SMA ===
cond2 = lowToday <= sma10

// === Find the highest down-volume day in the last 10 sessions (excluding today) ===
downVolumeArray = array.new_float()

for i = 1 to length
    if close[i] < close[i+1]
        array.push(downVolumeArray, volume[i])

maxDownVolume = array.size(downVolumeArray) > 0 ? array.max(downVolumeArray) : na

// === Condition 3: Today’s volume > highest down volume in past 10 days ===
cond3 = volumeToday > maxDownVolume

// === Combine all conditions ===
isPPB = cond1 and cond2 and cond3

// === Plot Signal on Chart ===
plotshape(isPPB, title="PP-B Signal", location=location.belowbar, color=color.black, style=shape.labeldown, text="PP-B", textcolor=color.white, size=size.small)
