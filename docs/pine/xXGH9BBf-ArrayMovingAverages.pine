//@version=6
library("ArrayMovingAverages", overlay = false)

// This code was written using the recommendations from the Pine Script™ User Manual's Style Guide:
// https://www.tradingview.com/pine-script-docs/en/v5/writing/Style_guide.html

bool inputDebug = input.bool(false, "Debug library")

// ————— Constants
float EMA_ALPHA_MULTIPLIER = 2.0

// ————— Utility Functions
// @function          Determine effective window size for moving averages
// @param id          (array<float>) Input array
// @param windowSize  (int) Desired window size
// @returns           (int) Effective window size based on array length
getWindowSize(array<float> id, int windowSize) =>
    na(windowSize) or windowSize > array.size(id) ? array.size(id) : windowSize

// @function  Retrieve the latest value from a calculated array
// @param id  (array<float>) Input array
// @returns   (float) Last value in array or na if empty
getLast(array<float> id) =>
    array.size(id) > 0 ? array.get(id, array.size(id) - 1) : na

// ————— Moving Average Methods
// @function      Calculate Exponential Moving Average (EMA) for Arrays
// @param id      (array<float>) Input array
// @param length  (int) Length of the EMA
// @returns       (array<float>) Array of EMA values
export method emaArray(array<float> id, int length) =>
    emaArr = array.new_float(array.size(id), na)
    if array.size(id) > 0
        alpha = EMA_ALPHA_MULTIPLIER / (length + 1.0)
        array.set(emaArr, 0, array.get(id, 0))
        for i = 1 to array.size(id) - 1
            prevEma = array.get(emaArr, i - 1)
            currentVal = array.get(id, i)
            ema = alpha * currentVal + (1 - alpha) * prevEma
            array.set(emaArr, i, ema)
    emaArr

// @function      Get the last value of the EMA array
// @param id      (array<float>) Input array
// @param length  (int) Length of the EMA
// @returns       (float) Last EMA value or na if empty
export method ema(array<float> id, int length) =>
    if array.size(id) > 0
        alpha = EMA_ALPHA_MULTIPLIER / (length + 1.0)
        ema = array.get(id, 0)
        for i = 1 to array.size(id) - 1
            ema := alpha * array.get(id, i) + (1 - alpha) * ema
        ema
    else
        na

// @function      Calculate Rolling Moving Average (RMA) for Arrays
// @param id      (array<float>) Input array
// @param length  (int) Length of the RMA
// @returns       (array<float>) Array of RMA values
export method rmaArray(array<float> id, int length) =>
    rmaArr = array.new_float(array.size(id), na)
    if array.size(id) > 0
        // There's another method which starts with the initial value as the 
        // first value of the array, vs. initializing with na and then 
        // the first `length` values' sma, but I went with this way.

        // Fill in na values for positions before we have enough data
        for i = 0 to length - 2
            array.set(rmaArr, i, na)
        
        // Calculate first SMA value using array.slice().avg()
        if array.size(id) >= length
            smaSlice = array.slice(id, 0, length)
            array.set(rmaArr, length - 1, array.avg(smaSlice))
        
        // Calculate subsequent RMA values using exact formula
        alpha = 1.0 / length
        for i = length to array.size(id) - 1
            prevRma = array.get(rmaArr, i - 1)
            currentVal = array.get(id, i)
            rma = (currentVal * alpha) + (prevRma * (1 - alpha))
            array.set(rmaArr, i, rma)
    rmaArr

// @function      Get the last value of the RMA array
// @param id      (array<float>) Input array
// @param length  (int) Length of the RMA
// @returns       (float) Last RMA value or na if empty
export method rma(array<float> id, int length) =>
    if array.size(id) >= length
        smaSlice = array.slice(id, 0, length)
        rma = array.avg(smaSlice)
        alpha = 1.0 / length
        for i = length to array.size(id) - 1
            rma := (array.get(id, i) * alpha) + (rma * (1 - alpha))
        rma
    else
        na

// @function          Calculate Simple Moving Average (SMA) for Arrays
// @param id          (array<float>) Input array
// @param windowSize  (int) Window size for calculation, defaults to array size
// @returns           (array<float>) Array of SMA values
export method smaArray(array<float> id, int windowSize = na) =>
    effectiveWindow = getWindowSize(id, windowSize)
    smaArr = array.new_float(array.size(id), na)
    if array.size(id) >= effectiveWindow
        for i = effectiveWindow - 1 to array.size(id) - 1
            slice = array.slice(id, i - effectiveWindow + 1, i + 1)
            array.set(smaArr, i, array.avg(slice))
    smaArr

// @function          Get the last value of the SMA array
// @param id          (array<float>) Input array
// @param windowSize  (int) Window size for calculation, defaults to array size
// @returns           (float) Last SMA value or na if empty
export method sma(array<float> id, int windowSize = na) =>
    effectiveWindow = getWindowSize(id, windowSize)
    if array.size(id) >= effectiveWindow
        slice = array.slice(id, array.size(id) - effectiveWindow, array.size(id))
        array.avg(slice)
    else
        na

// @function          Calculate Weighted Moving Average (WMA) for Arrays
// @param id          (array<float>) Input array
// @param windowSize  (int) Window size for calculation, defaults to array size
// @returns           (array<float>) Array of WMA values
export method wmaArray(array<float> id, int windowSize = na) =>
    effectiveWindow = getWindowSize(id, windowSize)
    wmaArr = array.new_float(array.size(id), na)
    if array.size(id) >= effectiveWindow
        weightSum = effectiveWindow * (effectiveWindow + 1) / 2.0
        
        // Calculate WMA for each window
        for i = effectiveWindow - 1 to array.size(id) - 1
            sum = 0.0
            // Weight values within each window (most recent gets highest weight)
            for j = 0 to effectiveWindow - 1
                sum += array.get(id, i - effectiveWindow + 1 + j) * (j + 1)
            array.set(wmaArr, i, sum / weightSum)
    wmaArr

// @function          Get the last value of the WMA array
// @param id          (array<float>) Input array
// @param windowSize  (int) Window size for calculation, defaults to array size
// @returns           (float) Last WMA value or na if empty
export method wma(array<float> id, int windowSize = na) =>
    effectiveWindow = getWindowSize(id, windowSize)
    size = id.size()
    if size >= effectiveWindow
        weightSum = effectiveWindow * (effectiveWindow + 1) / 2.0
        weightedSum = 0.0
        for j = 0 to effectiveWindow - 1
            weightedSum += array.get(id, size - effectiveWindow + j) * (j + 1)
        weightedSum / weightSum
    else
        na

// @function      Calculate Hull Moving Average (HMA) for Arrays
// @param id      (array<float>) Input array
// @param length  (int) Length of the HMA
// @returns       (array<float>) Array of HMA values
export method hmaArray(array<float> id, int length) =>
    // Calculate WMA with length/2
    halfLengthWMA = id.wmaArray(length / 2)
    // Calculate WMA with full length
    fullLengthWMA = id.wmaArray(length)
    
    // Create array for 2*WMA(n/2) - WMA(n)
    diffArray = array.new_float(array.size(id), na)
    for i = 0 to array.size(id) - 1
        half = array.get(halfLengthWMA, i)
        full = array.get(fullLengthWMA, i)
        if not na(half) and not na(full)
            array.set(diffArray, i, 2 * half - full)
    
    // Calculate final WMA with sqrt(length)
    diffArray.wmaArray(math.floor(math.sqrt(length)))

// @function      Get the last value of the HMA array
// @param id      (array<float>) Input array
// @param length  (int) Length of the HMA
// @returns       (float) Last HMA value or na if empty
export method hma(array<float> id, int length) =>
    size = array.size(id)
    if size >= length
        halfLength = length / 2
        sqrtLength = math.floor(math.sqrt(length))
        
        // Calculate WMA with length/2
        halfWMAArray = id.wmaArray(halfLength)
        
        // Calculate WMA with full length
        fullWMAArray = id.wmaArray(length)
        
        // Calculate 2 * WMA(n/2) - WMA(n)
        diffArray = array.new_float(size, na)
        for i = 0 to size - 1
            halfWMA = array.get(halfWMAArray, i)
            fullWMA = array.get(fullWMAArray, i)
            if not na(halfWMA) and not na(fullWMA)
                array.set(diffArray, i, 2 * halfWMA - fullWMA)
        
        // Calculate final WMA with sqrt(length)
        diffArray.wma(sqrtLength)
    else
        na

// ————— Example Usage
// We use non-linear data to emphasize the difference between certain MAs
var sampleArray = array.new_float(20)
if barstate.isfirst and inputDebug
    for i = 0 to array.size(sampleArray) - 1
        sampleArray.set(i, math.pow(i + 1, 2)) 

// ————— Plots
plot(inputDebug ? sampleArray.sma(10) : na, "SMA", color = color.red)
// plot(inputDebug ? getLast(sampleArray.smaArray(10)) : na, "SMA (array)", color = color.red)
plot(inputDebug ? sampleArray.ema(10) : na, "EMA", color = color.blue)
// plot(inputDebug ? getLast(sampleArray.emaArray(10)) : na, "EMA (array)", color = color.blue)
plot(inputDebug ? sampleArray.wma(10) : na, "WMA", color = color.orange)
// plot(inputDebug ? getLast(sampleArray.wmaArray(10)) : na, "WMA (array)", color = color.yellow)
plot(inputDebug ? sampleArray.rma(10) : na, "RMA", color = color.green)
// plot(inputDebug ? getLast(sampleArray.rmaArray(10)) : na, "RMA (array)", color = color.green)
plot(inputDebug ? sampleArray.hma(10) : na, "HMA", color = color.purple)
// plot(inputDebug ? getLast(sampleArray.hmaArray(10)) : na, "HMA (array)", color = color.purple)


