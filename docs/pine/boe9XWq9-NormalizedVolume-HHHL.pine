//@version=6
library("NormalizedVolume_HHHL")

//────────────────────────────────────────────────────────────
// Helpers
//────────────────────────────────────────────────────────────
export clamp(float x, float lo, float hi) =>
    math.min(math.max(x, lo), hi)

// Relative Volume (RVOL) using a passed-in volume series
export rvol(series float vol, int len) =>
    float vAvg = ta.sma(vol, len)
    float r    = na(vAvg) or vAvg == 0.0 ? na : (vol / vAvg)
    r

export volScore(series float vol, int len, float maxScore=300.0) =>
    float r = rvol(vol, len)
    float s = na(r) ? na : clamp(r * 100.0, 0.0, maxScore)
    s

export volTrend(series float vol, int len, int slopeLen=5, float flatEps=0.02) =>
    float r  = rvol(vol, len)
    float rs = ta.sma(r, slopeLen)
    float prev = rs[1]
    float d = na(rs) or na(prev) ? na : (rs - prev)
    int t = na(d) ? 0 : (d > flatEps ? 1 : d < -flatEps ? -1 : 0)
    t

//────────────────────────────────────────────────────────────
// Structure events via pivots, using passed-in high/low series
//────────────────────────────────────────────────────────────
export structureEvents(series float hi, series float lo, int left=3, int right=3) =>
    float ph = ta.pivothigh(hi, left, right)
    float pl = ta.pivotlow(lo,  left, right)

    var float lastHigh = na
    var float lastLow  = na

    bool isHH = false
    bool isLH = false
    bool isHL = false
    bool isLL = false

    if not na(ph)
        isHH := na(lastHigh) ? false : ph > lastHigh
        isLH := na(lastHigh) ? false : ph < lastHigh
        lastHigh := ph

    if not na(pl)
        isHL := na(lastLow) ? false : pl > lastLow
        isLL := na(lastLow) ? false : pl < lastLow
        lastLow := pl

    [isHH, isHL, isLH, isLL, ph, pl, lastHigh, lastLow]

//────────────────────────────────────────────────────────────
// Read logic: structure event + normalized volume
//────────────────────────────────────────────────────────────
export structureRead(
     bool isHH, bool isHL, bool isLH, bool isLL,
     series float vol,
     int volLen=20, float strongRvol=2.0, float weakRvol=0.9,
     int slopeLen=5
) =>
    float r     = rvol(vol, volLen)
    float score = volScore(vol, volLen)
    int vT      = volTrend(vol, volLen, slopeLen)

    int code = 0
    string txt = "Neutral / no event"

    if (isHH or isHL or isLH or isLL) and not na(r)
        if isHH
            if r >= strongRvol
                code := 2
                txt  := "HH + high RVOL: continuation confirmed / ignition"
            else if r <= weakRvol or vT == -1
                code := -1
                txt  := "HH + weak/falling RVOL: breakout risk / trap"
            else
                code := 1
                txt  := "HH + normal RVOL: acceptable continuation"

        if isLL
            if r >= strongRvol
                code := 2
                txt  := "LL + high RVOL: breakdown confirmed / momentum"
            else if r <= weakRvol or vT == -1
                code := -1
                txt  := "LL + weak/falling RVOL: bear trap potential"
            else
                code := 1
                txt  := "LL + normal RVOL: acceptable breakdown"

        if isHL
            if vT == 1 and r >= 1.1
                code := 2
                txt  := "HL + rising RVOL: accumulation / strong support"
            else if vT == 0
                code := 1
                txt  := "HL + flat RVOL: healthy pullback"
            else
                code := -1
                txt  := "HL + falling RVOL: weak buyers / caution"

        if isLH
            if vT == -1 and r <= 1.0
                code := 2
                txt  := "LH + declining RVOL: sellers losing control (possible reversal setup)"
            else if vT == 1 and r >= 1.2
                code := -1
                txt  := "LH + rising RVOL: distribution / bear continuation risk"
            else
                code := 0
                txt  := "LH + mixed RVOL: watch next break"

    [code, txt, score, r, vT]
