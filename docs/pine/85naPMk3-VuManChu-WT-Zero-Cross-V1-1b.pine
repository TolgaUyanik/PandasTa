//@version=6
strategy("VuManChu WT Zero Cross V1.1b",
overlay=true,
pyramiding=0,
process_orders_on_close=true,
default_qty_type=strategy.percent_of_equity,
default_qty_value=2)

//--------------------------------------------------
// INPUTS
//--------------------------------------------------

wtChannelLen = input.int(9, "WT Channel Length", minval=1)
wtAverageLen = input.int(27, "WT Average Length", minval=1)
wtMALen = input.int(3, "WT MA Length", minval=1)
wtSource = input.source(hlc3, "WT Source")

enableTrendFilter = input.bool(false, "Enable EMA Filter")
emaLength = input.int(200, "EMA Length")

showEMA = input.bool(true, "Show EMA")
showPSAR = input.bool(true, "Show HTF PSAR")
showArrows = input.bool(true, "Show Entry Arrows")

psarStart = input.float(0.0075, "PSAR Start")
psarInc = input.float(0.0075, "PSAR Increment")
psarMax = input.float(0.075, "PSAR Maximum")

psarTF = input.string(
     "Auto",
     "PSAR Timeframe",
     options=["Auto","5","10","15","30","60","120","240","480","D"])

//--------------------------------------------------
// AUTO PSAR TF
//--------------------------------------------------

selectedPSARTF =
     psarTF != "Auto" ? psarTF :
     timeframe.period == "1" ? "2" :
     timeframe.period == "5" ? "10" :
     timeframe.period == "15" ? "30" :
     timeframe.period == "30" ? "60" :
     timeframe.period == "60" ? "120" :
     timeframe.period == "240" ? "480" :
     timeframe.period == "D" ? "2D" :
     "120"

//--------------------------------------------------
// WAVETREND
//--------------------------------------------------

esa = ta.ema(wtSource, wtChannelLen)
de = ta.ema(math.abs(wtSource - esa), wtChannelLen)
ci = (wtSource - esa) / (0.015 * de)

wt1 = ta.ema(ci, wtAverageLen)
wt2 = ta.sma(wt1, wtMALen)

// WT1 CROSSING ZERO
longSignal = ta.crossover(wt1, 0)
shortSignal = ta.crossunder(wt1, 0)

//--------------------------------------------------
// TREND FILTER
//--------------------------------------------------

emaFilter = ta.ema(close, emaLength)

longAllowed = not enableTrendFilter or close > emaFilter
shortAllowed = not enableTrendFilter or close < emaFilter

//--------------------------------------------------
// HTF PSAR
//--------------------------------------------------

psarHTF = request.security(
     syminfo.tickerid,
     selectedPSARTF,
     ta.sar(psarStart, psarInc, psarMax))

//--------------------------------------------------
// ENTRIES
//--------------------------------------------------

if barstate.isconfirmed and longSignal and longAllowed
    if strategy.position_size < 0
        strategy.close("Short")
    strategy.entry("Long", strategy.long)

if barstate.isconfirmed and shortSignal and shortAllowed
    if strategy.position_size > 0
        strategy.close("Long")
    strategy.entry("Short", strategy.short)

//--------------------------------------------------
// STOPS
//--------------------------------------------------

strategy.exit(
     "Long Stop",
     from_entry="Long",
     stop=psarHTF)

strategy.exit(
     "Short Stop",
     from_entry="Short",
     stop=psarHTF)

//--------------------------------------------------
// VISUALS
//--------------------------------------------------

plot(showEMA ? emaFilter : na, title="EMA")

plot(
     showPSAR ? psarHTF : na,
     title="HTF PSAR",
     style=plot.style_cross)

plotshape(
     showArrows and longSignal,
     title="Long Arrow",
     style=shape.arrowup,
     location=location.belowbar,
     color=color.green,
     size=size.small)

plotshape(
     showArrows and shortSignal,
     title="Short Arrow",
     style=shape.arrowdown,
     location=location.abovebar,
     color=color.red,
     size=size.small)

//--------------------------------------------------
// ALERTS
//--------------------------------------------------

alertcondition(
     longSignal,
     title="Long Entry",
     message="WT1 crossed above zero")

alertcondition(
     shortSignal,
     title="Short Entry",
     message="WT1 crossed below zero")