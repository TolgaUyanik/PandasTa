f_hhmmToMs(int _hhmm) =>
    int _hh = int(_hhmm / 100)
    int _mm = _hhmm - _hh * 100
    int _ms = (_hh * 60 + _mm) * 60000
    _ms


f_addNews(string _d, int _hhmm, int _tid, string[] _dArr, int[] _tArr, int[] _idArr) =>
    int _ms = f_hhmmToMs(_hhmm)
    array.push(_dArr, _d)
    array.push(_tArr, _ms)
    array.push(_idArr, _tid)
    0

f_addNewsMs(string _d, int _ms, int _tid, string[] _dArr, int[] _tArr, int[] _idArr) =>
    array.push(_dArr, _d)
    array.push(_tArr, _ms)
    array.push(_idArr, _tid)
    0

