//@version=6
indicator("Bank Nifty First 5M ±0.09% Bands + VWAP", overlay = true)

// Settings
bandPercent = input.float(0.09, "Band Percentage", minval = 0.001, step = 0.01)
showVWAP    = input.bool(true, "Show VWAP")

// First 5-minute candle begins at 9:15 AM
first5mClose = request.security(
     syminfo.tickerid,
     "5",
     hour == 9 and minute == 15 ? close : na,
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_off
)

// Detect a new trading day
newDay = ta.change(time("D")) != 0

// Store the day's first 5-minute closing price
var float dailyBasePrice = na

if newDay
    dailyBasePrice := na

if not na(first5mClose)
    dailyBasePrice := first5mClose

// Calculate upper and lower bands
percentage = bandPercent / 100.0

upperBand = not na(dailyBasePrice) ? dailyBasePrice * (1 + percentage) : na
lowerBand = not na(dailyBasePrice) ? dailyBasePrice * (1 - percentage) : na

// Plot only the top and bottom bands
plot(
     upperBand,
     title = "Upper Band",
     color = color.lime,
     linewidth = 2,
     style = plot.style_linebr
)

plot(
     lowerBand,
     title = "Lower Band",
     color = color.red,
     linewidth = 2,
     style = plot.style_linebr
)

// Daily VWAP
dailyVWAP = ta.vwap(hlc3)

plot(
     showVWAP ? dailyVWAP : na,
     title = "VWAP",
     color = color.aqua,
     linewidth = 2
)