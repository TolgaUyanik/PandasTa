//@version=5
indicator(title="Scout Regiment - K13", shorttitle="Scout Regiment - K13", format=format.price, precision=2, timeframe="", timeframe_gaps=true)

// === 参数分类标题 ===
// --------------------------
// 1. 基础指标设置
// --------------------------
// 2. Bias 设置
// --------------------------
// 3. KSI 设置
// --------------------------
// 4. MACD 设置
// --------------------------

// === 显示/隐藏选项 ===
showBias = input.bool(true, title="显示 Bias", group="1. 基础指标设置")
showKSI = input.bool(true, title="显示 KSI", group="1. 基础指标设置") 
showMACD = input.bool(true, title="显示 MACD", group="1. 基础指标设置")

// === Bias 乖离率部分 ===
show_ema55 = input.bool(true, title="EMA55 周期", group="2. Bias 设置", inline="ema55")
ema55_len = input.int(55, title="", group="2. Bias 设置", inline="ema55")

show_ema144 = input.bool(true, title="EMA144 周期", group="2. Bias 设置", inline="ema144")
ema144_len = input.int(144, title="", group="2. Bias 设置", inline="ema144")

show_ema233 = input.bool(true, title="EMA233 周期", group="2. Bias 设置", inline="ema233")
ema233_len = input.int(233, title="", group="2. Bias 设置", inline="ema233")

bias_src = input(close, title="计算乖离率的价格源", group="2. Bias 设置")
show_histogram = input.bool(true, title="显示柱状图 (基于EMA55)", group="2. Bias 设置")

// EMA55背离参数
show_div_ema55 = input.bool(true, title="显示EMA55背离", group="2. Bias 设置")
ema55_lbL = input.int(5, title="左侧回溯", minval=1, group="2. Bias 设置")
ema55_lbR = input.int(1, title="右侧回溯", minval=1, group="2. Bias 设置")
ema55_rangeUpper = input.int(60, title="最大回溯范围", minval=5, group="2. Bias 设置")
ema55_rangeLower = input.int(5, title="最小回溯范围", minval=1, group="2. Bias 设置")

// EMA144背离参数
show_div_ema144 = input.bool(true, title="显示EMA144背离", group="2. Bias 设置")
ema144_lbL = input.int(5, title="左侧回溯", minval=1, group="2. Bias 设置")
ema144_lbR = input.int(1, title="右侧回溯", minval=1, group="2. Bias 设置")
ema144_rangeUpper = input.int(60, title="最大回溯范围", minval=5, group="2. Bias 设置")
ema144_rangeLower = input.int(5, title="最小回溯范围", minval=1, group="2. Bias 设置")

// EMA233背离参数
show_div_ema233 = input.bool(true, title="显示EMA233背离", group="2. Bias 设置")
ema233_lbL = input.int(5, title="左侧回溯", minval=1, group="2. Bias 设置")
ema233_lbR = input.int(1, title="右侧回溯", minval=1, group="2. Bias 设置")
ema233_rangeUpper = input.int(60, title="最大回溯范围", minval=5, group="2. Bias 设置")
ema233_rangeLower = input.int(5, title="最小回溯范围", minval=1, group="2. Bias 设置")

// 定义Bias的0轴位置
bias_zero_line = 250

// 计算EMA和Bias
ema55 = ta.ema(bias_src, ema55_len)
ema144 = ta.ema(bias_src, ema144_len)
ema233 = ta.ema(bias_src, ema233_len)

bias55 = (bias_src - ema55) / ema55 * 100
bias144 = (bias_src - ema144) / ema144 * 100
bias233 = (bias_src - ema233) / ema233 * 100

// 计算Bias的平均波动性，用于动态缩放
bias_abs_avg = ta.ema(math.abs(bias55), 50)
bias_target_width = 20.0
bias_scale_factor = bias_abs_avg != 0 ? bias_target_width / bias_abs_avg : 0

// 应用缩放和平移
scaled_bias55 = bias55 * bias_scale_factor + bias_zero_line
scaled_bias144 = bias144 * bias_scale_factor + bias_zero_line
scaled_bias233 = bias233 * bias_scale_factor + bias_zero_line

// Bias 乖离率柱状图修正
histbase_bias = bias_zero_line
hist_color = bias55 > 0 ? color.aqua : color.new(#666666, 1)
plot(showBias and show_histogram ? scaled_bias55 : na, title="[Bias] 乖离率柱状图", style=plot.style_columns, color=hist_color, linewidth=4, histbase=histbase_bias)

hline(showBias ? bias_zero_line : na, title="[Bias] 零轴", color=color.new(#ffffff, 70), linestyle=hline.style_solid, linewidth=1)

plot(showBias and show_ema55 ? scaled_bias55 : na, title="[Bias] 55周期乖离率", color=color.new(#7F00FF, 0), linewidth=2, style=plot.style_stepline)
plot(showBias and show_ema144 ? scaled_bias144 : na, title="[Bias] 144周期乖离率", color=color.new(#FF007F, 0), linewidth=2)
plot(showBias and show_ema233 ? scaled_bias233 : na, title="[Bias] 233周期乖离率", color=color.new(#ffffff, 0), linewidth=2)

// 通用背离检测函数（每条线独立参数）
find_divergence(bias, lbL, lbR, rangeLower, rangeUpper) =>
    plFound = na(ta.pivotlow(bias, lbL, lbR)) ? false : true
    phFound = na(ta.pivothigh(bias, lbL, lbR)) ? false : true
    // 常规看涨背离
    oscHL = bias[lbR] > ta.valuewhen(plFound, bias[lbR], 1) and rangeLower <= ta.barssince(plFound[1]) and ta.barssince(plFound[1]) <= rangeUpper
    priceLL = bias_src[lbR] < ta.valuewhen(plFound, bias_src[lbR], 1)
    bullCond = oscHL and priceLL and plFound
    // 常规看跌背离
    oscLH = bias[lbR] < ta.valuewhen(phFound, bias[lbR], 1) and rangeLower <= ta.barssince(phFound[1]) and ta.barssince(phFound[1]) <= rangeUpper
    priceHH = bias_src[lbR] > ta.valuewhen(phFound, bias_src[lbR], 1)
    bearCond = oscLH and priceHH and phFound
    [bullCond, plFound, bearCond, phFound]

// EMA55背离
[bull55, pl55, bear55, ph55] = find_divergence(bias55, ema55_lbL, ema55_lbR, ema55_rangeLower, ema55_rangeUpper)
// EMA144背离
[bull144, pl144, bear144, ph144] = find_divergence(bias144, ema144_lbL, ema144_lbR, ema144_rangeLower, ema144_rangeUpper)
// EMA233背离
[bull233, pl233, bear233, ph233] = find_divergence(bias233, ema233_lbL, ema233_lbR, ema233_rangeLower, ema233_rangeUpper)

// 颜色
bullColor = color.new(color.yellow, 0)
bearColor = color.new(#7F00FF, 0)
noneColor = color.new(color.white, 100)
textColor = color.new(#ffffff, 0)

// EMA55背离绘制 - 使用缩放后的值
plot(pl55 and show_div_ema55 and showBias ? scaled_bias55[ema55_lbR] : na, offset=-ema55_lbR, title="EMA55常规看涨背离", linewidth=2, color=(bull55 and show_div_ema55 and showBias ? bullColor : noneColor))
plotshape(bull55 and show_div_ema55 and showBias ? scaled_bias55[ema55_lbR] : na, offset=-ema55_lbR, title="EMA55常规看涨背离标签", text=" 55涨 ", style=shape.labelup, location=location.absolute, color=color.new(color.yellow, 60), textcolor=textColor, size=size.small)
plot(ph55 and show_div_ema55 and showBias ? scaled_bias55[ema55_lbR] : na, offset=-ema55_lbR, title="EMA55常规看跌背离", linewidth=2, color=(bear55 and show_div_ema55 and showBias ? bearColor : noneColor))
plotshape(bear55 and show_div_ema55 and showBias ? scaled_bias55[ema55_lbR] : na, offset=-ema55_lbR, title="EMA55常规看跌背离标签", text=" 55跌 ", style=shape.labeldown, location=location.absolute, color=color.new(#7F00FF, 60), textcolor=textColor, size=size.small)

// EMA144背离绘制 - 使用缩放后的值
plot(pl144 and show_div_ema144 and showBias ? scaled_bias144[ema144_lbR] : na, offset=-ema144_lbR, title="EMA144常规看涨背离", linewidth=2, color=(bull144 and show_div_ema144 and showBias ? bullColor : noneColor))
plotshape(bull144 and show_div_ema144 and showBias ? scaled_bias144[ema144_lbR] : na, offset=-ema144_lbR, title="EMA144常规看涨背离标签", text=" 144涨 ", style=shape.labelup, location=location.absolute, color=color.new(color.yellow, 60), textcolor=textColor, size=size.small)
plot(ph144 and show_div_ema144 and showBias ? scaled_bias144[ema144_lbR] : na, offset=-ema144_lbR, title="EMA144常规看跌背离", linewidth=2, color=(bear144 and show_div_ema144 and showBias ? bearColor : noneColor))
plotshape(bear144 and show_div_ema144 and showBias ? scaled_bias144[ema144_lbR] : na, offset=-ema144_lbR, title="EMA144常规看跌背离标签", text=" 144跌 ", style=shape.labeldown, location=location.absolute, color=color.new(#7F00FF, 60), textcolor=textColor, size=size.small)

// EMA233背离绘制 - 使用缩放后的值
plot(pl233 and show_div_ema233 and showBias ? scaled_bias233[ema233_lbR] : na, offset=-ema233_lbR, title="EMA233常规看涨背离", linewidth=2, color=(bull233 and show_div_ema233 and showBias ? bullColor : noneColor))
plotshape(bull233 and show_div_ema233 and showBias ? scaled_bias233[ema233_lbR] : na, offset=-ema233_lbR, title="EMA233常规看涨背离标签", text=" 233涨 ", style=shape.labelup, location=location.absolute, color=color.new(color.yellow, 60), textcolor=textColor, size=size.small)
plot(ph233 and show_div_ema233 and showBias ? scaled_bias233[ema233_lbR] : na, offset=-ema233_lbR, title="EMA233常规看跌背离", linewidth=2, color=(bear233 and show_div_ema233 and showBias ? bearColor : noneColor))
plotshape(bear233 and show_div_ema233 and showBias ? scaled_bias233[ema233_lbR] : na, offset=-ema233_lbR, title="EMA233常规看跌背离标签", text=" 233跌 ", style=shape.labeldown, location=location.absolute, color=color.new(#7F00FF, 60), textcolor=textColor, size=size.small)

// === KSI 设置 ===
showStochRSI = input.bool(false, title="显示 ① Stoch RSI", group="3. KSI 设置")
showKDJ = input.bool(false, title="显示 ② KDJ", group="3. KSI 设置")
showRSI = input.bool(true, title="显示 ③ RSI", group="3. KSI 设置") 
showCCI = input.bool(true, title="显示 ④ CCI", group="3. KSI 设置")
showWR = input.bool(false, title="显示 ⑤ Williams %R", group="3. KSI 设置")
showMFI = input.bool(false, title="显示 ⑥ MFI", group="3. KSI 设置")

// KSI 轨道与背景
h0 = hline(showKSI ? 80 : na, "上轨", color=color.new(#ffffff, 70), linestyle=hline.style_solid)
hline(showKSI ? 50 : na, "中轨", color=color.new(#ffffff, 0))
h1 = hline(showKSI ? 20 : na, "下轨", color=color.new(#ffffff, 70), linestyle=hline.style_solid)
fill(h0, h1, color=color.new(#000000, 0), title="Band Fill")

// === ① Stoch RSI 设置 ===
smoothK = input.int(3, "K", minval=1, group="① Stoch RSI 设置")
smoothD = input.int(3, "D", minval=1, group="① Stoch RSI 设置")
lengthRSI = input.int(55, "RSI Length", minval=1, group="① Stoch RSI 设置")
lengthStoch = input.int(55, "Stochastic Length", minval=1, group="① Stoch RSI 设置")
src = input.source(close, title="RSI Source", group="① Stoch RSI 设置")

rsi1 = ta.rsi(src, lengthRSI)
k = ta.sma(ta.stoch(rsi1, rsi1, rsi1, lengthStoch), smoothK)
d = ta.sma(k, smoothK)

pK = plot(showKSI and showStochRSI ? k : na, "[StochRSI] K", color=#5729ff)
pD = plot(showKSI and showStochRSI ? d : na, "[StochRSI] D", color=#5729ff)

is_bull_cross = ta.crossover(k, d)
is_bear_cross = ta.crossunder(k, d)

var float cross_start_k = na
var float cross_start_d = na
var int cross_type = 0

if is_bull_cross
    cross_start_k := k
    cross_start_d := d
    cross_type := 1
else if is_bear_cross
    cross_start_k := k
    cross_start_d := d
    cross_type := -1

var int fill_bull = na
var int fill_bear = na

fill_bull := cross_type == 1 ? 1 : cross_type == -1 ? 0 : fill_bull
fill_bear := cross_type == -1 ? 1 : cross_type == 1 ? 0 : fill_bear

bull_fill = fill_bull == 1 ? color.new(#11D1FF, 0) : na
bear_fill = fill_bear == 1 ? color.new(#ffffff, 0) : na

fill(pK, pD, color=showKSI and showStochRSI ? bull_fill : na, title="[Stoch RSI] 金叉填充")
fill(pK, pD, color=showKSI and showStochRSI ? bear_fill : na, title="[Stoch RSI] 死叉填充")

// === ② KDJ 设置 ===
ilong = input.int(8, title="周期", group="② KDJ 设置")
isig = input.int(3, title="信号", group="② KDJ 设置")
showK = input.bool(false, title="显示K线", group="② KDJ 设置")
showD = input.bool(true, title="显示D线", group="② KDJ 设置")
showJ = input.bool(true, title="显示J线", group="② KDJ 设置")

bcwsma(s, l, m) =>
    var float _bcwsma = na
    _bcwsma := (m * s + (l - m) * nz(_bcwsma[1])) / l

c = close
h = ta.highest(high, ilong)
l = ta.lowest(low, ilong)
RSV = 100 * ((c - l) / (h - l))
pK_kdj = bcwsma(RSV, isig, 1)
pD_kdj = bcwsma(pK_kdj, isig, 1)
pJ_kdj = 3 * pK_kdj - 2 * pD_kdj

pK_plot = plot(showKSI and showKDJ and showK ? pK_kdj : na, color=color.new(#1E88E5, 0), title="[KDJ] k")
pD_plot = plot(showKSI and showKDJ and showD ? pD_kdj : na, color=color.new(#FF6F00, 0), title="[KDJ] D")
pJ_plot = plot(showKSI and showKDJ and showJ ? pJ_kdj : na, color=color.new(color.white, 0), title="[KDJ] J")

golden_cross = ta.crossover(pJ_kdj, pD_kdj)
death_cross = ta.crossunder(pJ_kdj, pD_kdj)

var int cross_state = na
if golden_cross
    cross_state := 1
else if death_cross
    cross_state := -1
else
    cross_state := nz(cross_state[1], 0)

green_fill = cross_state == 1
white_fill = cross_state == -1

fill(pJ_plot, pD_plot, color = showKSI and showKDJ and green_fill ? color.new(#003cff, 35) : na, title="[KDJ] 金叉填充")
fill(pJ_plot, pD_plot, color = showKSI and showKDJ and white_fill ? color.new(#ffffff, 70) : na, title="[KDJ] 死叉填充")

// === ③ RSI 设置 ===
rsiLengthInput = input.int(8, minval=1, title="RSI长度", group="③ RSI 设置")
rsiMidLength = input.int(22, minval=1, title="RSI中期长度", group="③ RSI 设置")
rsiSourceInput = input.source(close, "数据源", group="③ RSI 设置")

showRSIMain = input.bool(false, title="显示RSI(8)", group="③ RSI 设置") 
showRSIMid = input.bool(true, title="显示RSI中期(22)", group="③ RSI 设置")

change = ta.change(rsiSourceInput)
up = ta.rma(math.max(change, 0), rsiLengthInput)
down = ta.rma(-math.min(change, 0), rsiLengthInput)
rsi = down == 0 ? 100 : up == 0 ? 0 : 100 - (100 / (1 + up / down))

// 计算中期RSI
upMid = ta.rma(math.max(change, 0), rsiMidLength)
downMid = ta.rma(-math.min(change, 0), rsiMidLength)
rsiMid = downMid == 0 ? 100 : upMid == 0 ? 0 : 100 - (100 / (1 + upMid / downMid))

rsiPlot = plot(showKSI and showRSI and showRSIMain ? rsi : na, "RSI", color.new(color.yellow, 0), linewidth=2)
rsiMidPlot = plot(showKSI and showRSI and showRSIMid ? rsiMid : na, "RSI中期", color.new(#2962FF, 0), linewidth=3)
midLinePlot = plot(50, color = na, editable = false, display = display.none)

// === ④ CCI 设置 ===
cciLength = input.int(33, minval=1, title="CCI长度", group="④ CCI 设置")
cciMidLength = input.int(77, minval=1, title="CCI中期长度", group="④ CCI 设置")
cciSrc = input(hlc3, title="数据源", group="④ CCI 设置")
showCCIMain = input.bool(false, title="显示CCI(33)", group="④ CCI 设置")
showCCIMid = input.bool(true, title="显示CCI中期(89)", group="④ CCI 设置")

// 计算CCI指标
calcCCI(length) =>
    ma = ta.sma(cciSrc, length)
    rawCci = (cciSrc - ma) / (0.015 * ta.dev(cciSrc, length))
    (rawCci - (-100)) * (80 - 20) / (100 - (-100)) + 20

cci = calcCCI(cciLength)
cciMid = calcCCI(cciMidLength)

cciPlot = plot(showKSI and showCCI and showCCIMain ? cci : na, "CCI", color.new(#00FF00, 0), linewidth=2)
cciMidPlot = plot(showKSI and showCCI and showCCIMid ? cciMid : na, "CCI中期", color.new(#FFA500, 0), linewidth=2)

// === ⑤ Williams %R 设置 ===
wrLength = input.int(28, minval=1, title="长度", group="⑤ Williams %R 设置")
wrSrc = input.source(close, "数据源", group="⑤ Williams %R 设置")

_wr(length) =>
    max = ta.highest(length)
    min = ta.lowest(length)
    100 * (wrSrc - max) / (max - min)
rawPercentR = _wr(wrLength)

percentR = (rawPercentR - (-100)) * (100 - 0) / (0 - (-100)) + 0

pWR = plot(showKSI and showWR ? percentR : na, title="[%R]", color=color.new(#FF00FF, 0), linewidth=2)

// === ⑥ MFI 设置 ===
mfiLength = input.int(28, minval=1, title="MFI周期长度", group="⑥ MFI 设置")
mfiSrc = input(hlc3, "MFI数据源", group="⑥ MFI 设置")

osc = ta.mfi(mfiSrc, mfiLength)
mfiPlot = plot(showKSI and showMFI ? osc : na, title="MFI", color=color.new(#ffffff, 0), linewidth=2)

// === MACD 设置 ===
fastLengthMACD = input.int(13, minval=1, title="快速EMA周期", group="4. MACD 设置")
slowLengthMACD = input.int(34, minval=1, title="慢速EMA周期", group="4. MACD 设置")
signalLengthMACD = input.int(9, minval=1, title="信号线周期", group="4. MACD 设置")
useCurrentRes = input.bool(true, title="使用当前图表周期?", group="4. MACD 设置")
resCustom = input.timeframe(title="使用不同周期? (取消勾选上方选项)", defval="60", group="4. MACD 设置")
smd = input.bool(true, title="显示MACD线和信号线?", group="4. MACD 设置")
sd = input.bool(true, title="在MACD穿越信号线时显示圆点?", group="4. MACD 设置")
sh = input.bool(true, title="显示直方图?", group="4. MACD 设置")
macd_colorChange = input.bool(true, title="MACD线颜色根据穿越而变化?", group="4. MACD 设置")
hist_colorChange = input.bool(true, title="直方图显示4种颜色?", group="4. MACD 设置")

// 新增：MACD MA类型选择
sma_source = input.string(title = "Oscillator MA Type", defval = "EMA", options = ["SMA", "EMA"], group="4. MACD 设置", display = display.data_window)
sma_signal = input.string(title = "Signal Line MA Type", defval = "EMA", options = ["SMA", "EMA"], group="4. MACD 设置", display = display.data_window)

// 定义平移值
shift = -150

// MACD 计算 - 使用选择的MA类型
res = useCurrentRes ? timeframe.period : resCustom
fastMA = sma_source == "SMA" ? ta.sma(close, fastLengthMACD) : ta.ema(close, fastLengthMACD)
slowMA = sma_source == "SMA" ? ta.sma(close, slowLengthMACD) : ta.ema(close, slowLengthMACD)
macd_raw = fastMA - slowMA
signal_raw = sma_signal == "SMA" ? ta.sma(macd_raw, signalLengthMACD) : ta.ema(macd_raw, signalLengthMACD)
hist_raw = macd_raw - signal_raw

[outMacD_raw, outSignal_raw, outHist_raw] = request.security(syminfo.tickerid, res, [macd_raw, signal_raw, hist_raw])

// --- 动态缩放逻辑 ---
hist_abs_avg = ta.ema(math.abs(outHist_raw), 50)
target_width = 15.0
scale_factor = hist_abs_avg != 0 ? target_width / hist_abs_avg : 0
outMacD = outMacD_raw * scale_factor
outSignal = outSignal_raw * scale_factor
outHist = outHist_raw * scale_factor
// --- 动态缩放逻辑结束 ---

// 颜色逻辑
histA_IsUp = outHist_raw > 0 and outHist_raw > outHist_raw[1]
histA_IsDown = outHist_raw > 0 and outHist_raw < outHist_raw[1]
histB_IsUp = outHist_raw <= 0 and outHist_raw > outHist_raw[1]
histB_IsDown = outHist_raw <= 0 and outHist_raw < outHist_raw[1]
macd_IsAbove = outMacD_raw >= outSignal_raw

plot_color = hist_colorChange ? histA_IsUp ? color.aqua : histA_IsDown ? color.blue : histB_IsDown ? color.new(#FF3399, 0) : histB_IsUp ? color.new(#99004C, 0) : color.rgb(56, 56, 56) : color.gray
macd_color = macd_colorChange ? (macd_IsAbove ? color.new(#00FF00, 0) : color.new(#FF00FF, 0)) : color.red
signal_color = macd_colorChange ? color.rgb(255, 255, 255, 60) : color.new(#00FF00, 0)

// 绘图 (应用平移值)
plot(showMACD and sh ? outHist + shift : na, title="[MACD] 直方图", color=plot_color, style=plot.style_columns, linewidth=4, histbase=shift, display=display.all, transp=0)
plot(showMACD and smd ? outMacD + shift : na, title="[MACD] MACD线", color=macd_color, linewidth=2, style=plot.style_line, display=display.all)
plot(showMACD and smd ? outSignal + shift : na, title="[MACD] 信号线", color=signal_color, style=plot.style_line, linewidth=2, display=display.all)
plot(showMACD and sd and smd and ta.cross(outMacD_raw, outSignal_raw) ? outSignal + shift : na, title="[MACD] 交叉点", style=plot.style_circles, linewidth=4, color=macd_color)
hline(showMACD ? shift : na, '[MACD] 中心线', linestyle=hline.style_solid, linewidth=2, color=color.new(color.white, 50))

// === MACD 直方图背离设置 ===
show_hist_div = input.bool(true, title="显示直方图背离信号", group="MACD直方图背离设置")
hist_divsrc = input.string("影线", title="价格参考", options=["影线", "实体"], group="MACD直方图背离设置")
hist_lbR = input.int(2, title="右侧回溯", minval=1, group="MACD直方图背离设置")
hist_lbL = input.int(5, title="左侧回溯", minval=1, group="MACD直方图背离设置")
hist_rangeUpper = input.int(60, title="最大回溯范围", minval=5, group="MACD直方图背离设置")
hist_rangeLower = input.int(5, title="最小回溯范围", minval=1, group="MACD直方图背离设置")
hist_plotBull = input.bool(true, title="显示常规看涨背离", group="MACD直方图背离设置")
hist_plotBear = input.bool(true, title="显示常规看跌背离", group="MACD直方图背离设置")

// 直方图背离标签显示开关
hist_showBullLabel = input.bool(true, title="显示直方图看涨背离标签", group="MACD直方图背离设置")
hist_showBearLabel = input.bool(true, title="显示直方图看跌背离标签", group="MACD直方图背离设置")

// 直方图背离柱状图符号条件开关
hist_requireSameSign = input.bool(true, title="要求背离点柱状图同符号", group="MACD直方图背离设置", tooltip="顶背离两点柱状图必须为正，底背离两点柱状图必须为负")

// === MACD线背离设置 ===
show_macd_div = input.bool(true, title="显示MACD线背离信号", group="MACD线背离设置")
macd_divsrc = input.string("影线", title="价格参考", options=["影线", "实体"], group="MACD线背离设置")
macd_lbR = input.int(1, title="右侧回溯", minval=1, group="MACD线背离设置")
macd_lbL = input.int(5, title="左侧回溯", minval=1, group="MACD线背离设置")
macd_rangeUpper = input.int(60, title="最大回溯范围", minval=5, group="MACD线背离设置")
macd_rangeLower = input.int(5, title="最小回溯范围", minval=1, group="MACD线背离设置")
macd_plotBull = input.bool(true, title="显示常规看涨背离", group="MACD线背离设置")
macd_plotBear = input.bool(true, title="显示常规看跌背离", group="MACD线背离设置")

// MACD线背离标签显示开关
macd_showBullLabel = input.bool(true, title="显示MACD线看涨背离标签", group="MACD线背离设置")
macd_showBearLabel = input.bool(true, title="显示MACD线看跌背离标签", group="MACD线背离设置")

// 颜色定义 - 修改了背离颜色
bullColor_macd = color.new(color.yellow, 0)  // 修改为黄色
bearColor_macd = color.new(#7F00FF, 0)      // 修改为紫色
textColor_macd = color.new(#ffffff, 0)
noneColor_macd = color.new(color.white, 100)

// 直方图背离逻辑 - 使用缩放后的值进行背离检测
hist_osc = outHist_raw  // 使用原始值进行背离检测，保持逻辑一致性
hist_plFound = na(ta.pivotlow(hist_osc, hist_lbL, hist_lbR)) ? false : true
hist_phFound = na(ta.pivothigh(hist_osc, hist_lbL, hist_lbR)) ? false : true

_inRange(cond, rangeLower, rangeUpper) =>
    bars = ta.barssince(cond == true)
    rangeLower <= bars and bars <= rangeUpper

hist_srch = hist_divsrc == "影线" ? high : math.max(close, open)
hist_srcl = hist_divsrc == "影线" ? low : math.min(close, open)

// 检查柱状图符号条件函数
_checkHistSignCondition(currentOsc, previousOsc, isBull) =>
    not hist_requireSameSign or 
     (isBull ? (currentOsc <= 0 and previousOsc <= 0) : (currentOsc >= 0 and previousOsc >= 0))

// 直方图常规看涨背离
hist_oscHL = hist_osc[hist_lbR] > ta.valuewhen(hist_plFound, hist_osc[hist_lbR], 1) and _inRange(hist_plFound[1], hist_rangeLower, hist_rangeUpper)
hist_priceLL = hist_srcl[hist_lbR] < ta.valuewhen(hist_plFound, hist_srcl[hist_lbR], 1)

current_hist_osc = hist_osc[hist_lbR]
previous_hist_osc = ta.valuewhen(hist_plFound, hist_osc[hist_lbR], 1)
hist_signCondition = _checkHistSignCondition(current_hist_osc, previous_hist_osc, true)

hist_bullCond = showMACD and hist_plotBull and hist_priceLL and hist_oscHL and hist_plFound and show_hist_div and hist_signCondition
plot(showMACD and hist_plFound and show_hist_div ? outHist[hist_lbR] + shift : na, offset=-hist_lbR, title="直方图常规看涨背离", linewidth=2, color=(hist_bullCond ? bullColor_macd : noneColor_macd))
plotshape(hist_bullCond and hist_showBullLabel ? outHist[hist_lbR] + shift : na, offset=-hist_lbR, title="直方图常规看涨背离标签", text=" H涨 ", style=shape.labelup, location=location.absolute, color=color.new(color.yellow, 60), textcolor=textColor_macd, size=size.small)

// 直方图常规看跌背离
hist_oscLH = hist_osc[hist_lbR] < ta.valuewhen(hist_phFound, hist_osc[hist_lbR], 1) and _inRange(hist_phFound[1], hist_rangeLower, hist_rangeUpper)
hist_priceHH = hist_srch[hist_lbR] > ta.valuewhen(hist_phFound, hist_srch[hist_lbR], 1)

current_hist_osc_bear = hist_osc[hist_lbR]
previous_hist_osc_bear = ta.valuewhen(hist_phFound, hist_osc[hist_lbR], 1)
hist_signCondition_bear = _checkHistSignCondition(current_hist_osc_bear, previous_hist_osc_bear, false)

hist_bearCond = showMACD and hist_plotBear and hist_priceHH and hist_oscLH and hist_phFound and show_hist_div and hist_signCondition_bear
plot(showMACD and hist_phFound and show_hist_div ? outHist[hist_lbR] + shift : na, offset=-hist_lbR, title="直方图常规看跌背离", linewidth=2, color=(hist_bearCond ? bearColor_macd : noneColor_macd))
plotshape(hist_bearCond and hist_showBearLabel ? outHist[hist_lbR] + shift : na, offset=-hist_lbR, title="直方图常规看跌背离标签", text=" H跌 ", style=shape.labeldown, location=location.absolute, color=color.new(#7F00FF, 60), textcolor=textColor_macd, size=size.small)

// MACD线背离逻辑 - 使用缩放后的值进行背离检测
macd_osc = outMacD_raw  // 使用原始值进行背离检测，保持逻辑一致性
macd_plFound = na(ta.pivotlow(macd_osc, macd_lbL, macd_lbR)) ? false : true
macd_phFound = na(ta.pivothigh(macd_osc, macd_lbL, macd_lbR)) ? false : true

macd_srch = macd_divsrc == "影线" ? high : math.max(close, open)
macd_srcl = macd_divsrc == "影线" ? low : math.min(close, open)

// MACD线常规看涨背离
macd_oscHL = macd_osc[macd_lbR] > ta.valuewhen(macd_plFound, macd_osc[macd_lbR], 1) and _inRange(macd_plFound[1], macd_rangeLower, macd_rangeUpper)
macd_priceLL = macd_srcl[macd_lbR] < ta.valuewhen(macd_plFound, macd_srcl[macd_lbR], 1)
macd_bullCond = showMACD and macd_plotBull and macd_priceLL and macd_oscHL and macd_plFound and show_macd_div
plot(showMACD and macd_plFound and show_macd_div ? outMacD[macd_lbR] + shift : na, offset=-macd_lbR, title="MACD线常规看涨背离", linewidth=2, color=(macd_bullCond ? bullColor_macd : noneColor_macd))
plotshape(macd_bullCond and macd_showBullLabel ? outMacD[macd_lbR] + shift : na, offset=-macd_lbR, title="MACD线常规看涨背离标签", text=" M涨 ", style=shape.labelup, location=location.absolute, color=color.new(color.yellow, 60), textcolor=textColor_macd, size=size.small)

// MACD线常规看跌背离
macd_oscLH = macd_osc[macd_lbR] < ta.valuewhen(macd_phFound, macd_osc[macd_lbR], 1) and _inRange(macd_phFound[1], macd_rangeLower, macd_rangeUpper)
macd_priceHH = macd_srch[macd_lbR] > ta.valuewhen(macd_phFound, macd_srch[macd_lbR], 1)
macd_bearCond = showMACD and macd_plotBear and macd_priceHH and macd_oscLH and macd_phFound and show_macd_div
plot(showMACD and macd_phFound and show_macd_div ? outMacD[macd_lbR] + shift : na, offset=-macd_lbR, title="MACD线常规看跌背离", linewidth=2, color=(macd_bearCond ? bearColor_macd : noneColor_macd))
plotshape(macd_bearCond and macd_showBearLabel ? outMacD[macd_lbR] + shift : na, offset=-macd_lbR, title="MACD线常规看跌背离标签", text=" M跌 ", style=shape.labeldown, location=location.absolute, color=color.new(#7F00FF, 60), textcolor=textColor_macd, size=size.small)