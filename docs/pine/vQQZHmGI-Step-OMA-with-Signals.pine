//@version=6
//copyright AlgoAlex81
indicator("Step-OMA with Signals", overlay=true)

// Input parameters
src = input.source(close, "Source")
length = input.int(25, "Length", minval=1)
speed = input.float(3.0, "Speed", minval=-1.5)
adaptive = input.bool(true, "Adaptive")
sensitivity = input.float(3.0, "Sensitivity Factor", minval=0.0001)
stepSize = input.int(50, "Step Size period", minval=1)

// Signal display settings
showSignals = input.bool(true, "Show Signal Dots", group="Signals")

// OMA calculation function based on Loxx's implementation
_oma(src, len, const, adapt) =>
    var float e1 = nz(src[1], src)
    var float e2 = nz(src[1], src)
    var float e3 = nz(src[1], src)
    var float e4 = nz(src[1], src)
    var float e5 = nz(src[1], src)
    var float e6 = nz(src[1], src)
    
    float averagePeriod = float(len)
    float noise = 0.00000000001
    float minPeriod = averagePeriod/2.0
    float maxPeriod = minPeriod*5.0
    int endPeriod = int(math.ceil(maxPeriod))
    float signal = math.abs(src - nz(src[endPeriod], src))
    
    if adapt
        for k = 1 to endPeriod
            noise += math.abs(src - nz(src[k], src))
        averagePeriod := ((signal / noise) * (maxPeriod - minPeriod)) + minPeriod
        
    float alpha = (2.0 + const) / (1.0 + const + averagePeriod)
    
    e1 := nz(e1[1] + alpha * (src - e1[1]), src)
    e2 := nz(e2[1] + alpha * (e1 - e2[1]), e1)
    float v1 = 1.5 * e1 - 0.5 * e2
    
    e3 := nz(e3[1] + alpha * (v1 - e3[1]), v1)
    e4 := nz(e4[1] + alpha * (e3 - e4[1]), e3)
    float v2 = 1.5 * e3 - 0.5 * e4
    
    e5 := nz(e5[1] + alpha * (v2 - e5[1]), v2) 
    e6 := nz(e6[1] + alpha * (e5 - e6[1]), e5) 
    float v3 = 1.5 * e5 - 0.5 * e6
    v3

// Calculate the OMA value
float omaValue = _oma(src, length, speed, adaptive)

// Create a series just for maintaining history of OMA values
var float omaHistory = omaValue
omaHistory := omaValue

// Step function with trend change detection
_stepma(float omaValue, float sensitivity, int stepSizeParam) =>
    // These var variables maintain their values across bars
    var float prevTrend = 0.0
    var float prevSmax = omaValue
    var float prevSmin = omaValue
    
    // Step calculation - similar to MQL4 version
    float atrValue = ta.atr(stepSizeParam)
    float step = math.max(atrValue, syminfo.mintick)
    float size = math.max(sensitivity, syminfo.mintick) * step
    float stepMulti = 1.0
    
    // Get historical OMA value (7 bars back)
    float plow = bar_index >= 7 ? omaHistory[7] : omaHistory
    float phigh = omaValue
    
    // Calculate current thresholds
    float smax = phigh + 2.0 * size * stepMulti
    float smin = plow - 2.0 * size * stepMulti
    
    // Start with previous trend
    float trend = prevTrend
    
    // Determine trend changes by comparing price to PREVIOUS thresholds
    if src > prevSmax
        trend := 1.0
    
    if src < prevSmin
        trend := -1.0
    
    // Calculate result based on current trend
    float result = src
    
    if trend == 1.0
        // In uptrend, maintain minimum threshold
        if smin < prevSmin
            smin := prevSmin
            
        result := smin + size * stepMulti
        
    else if trend == -1.0
        // In downtrend, maintain maximum threshold
        if smax > prevSmax
            smax := prevSmax
            
        result := smax - size * stepMulti
    
    // Better signal detection that catches all changes
    bool trendChanged = trend != prevTrend and (trend == 1.0 or trend == -1.0)
    
    // Store current values for next bar's calculation
    prevSmax := smax
    prevSmin := smin
    prevTrend := trend
    
    [result, trend, trendChanged]

// Get step result, trend, and trend change signal
[stepResult, trend, trendChanged] = _stepma(omaValue, sensitivity, stepSize)

// Wait for indicator to stabilize before showing signals
bool validSignal = bar_index > 25

// Plot the main indicator line
plot(stepResult, title="OMA Step", color=trend == 1.0 ? color.lime : color.red, linewidth=2)

// Instead of directly plotting signals or creating alerts, create alert conditions
// Create a condition for bullish trend change
bool bullishChange = trendChanged and trend == 1.0 and validSignal
// Create a condition for bearish trend change
bool bearishChange = trendChanged and trend == -1.0 and validSignal

// Simple plot of dots for trend changes if display is enabled
plot(showSignals and bullishChange ? stepResult : na, title="Bullish Signal", style=plot.style_circles, linewidth=5, color=color.lime)
plot(showSignals and bearishChange ? stepResult : na, title="Bearish Signal", style=plot.style_circles, linewidth=5, color=color.red)

// Create alert conditions that can be configured through TradingView's interface
alertcondition(bullishChange, title="OMA Step Bullish Signal", message="OMA Step: Bullish trend change detected")
alertcondition(bearishChange, title="OMA Step Bearish Signal", message="OMA Step: Bearish trend change detected")
alertcondition(trendChanged and validSignal, title="OMA Step Any Signal", message="OMA Step: Trend change detected")