library("MahjongHighYaku", overlay=false)

// ==========================================
// 染め手（清一色・混一色）判定
// ==========================================
export check_somete(int[] counts) =>
    int manzu = 0
    int pinzu = 0
    int souzu = 0
    int jihai = 0
    
    for i = 0 to 33
        int c = counts.get(i)
        if c > 0
            if i <= 8
                manzu += c
            else if i <= 17
                pinzu += c
            else if i <= 26
                souzu += c
            else
                jihai += c
                
    bool is_chinitsu = false
    bool is_honitsu  = false
    
    if jihai == 0
        if (manzu > 0 and pinzu == 0 and souzu == 0) or (pinzu > 0 and manzu == 0 and souzu == 0) or (souzu > 0 and manzu == 0 and pinzu == 0)
            is_chinitsu := true
    else if jihai > 0
        if (manzu > 0 and pinzu == 0 and souzu == 0) or (pinzu > 0 and manzu == 0 and souzu == 0) or (souzu > 0 and manzu == 0 and pinzu == 0)
            is_honitsu := true
            
    [is_chinitsu, is_honitsu]

// ==========================================
// 対々和 / 四暗刻 判定
// ==========================================
export is_toitoi(int[] counts) =>
    int kotsu_count = 0
    int janto_count = 0
    bool is_valid = true
    
    for i = 0 to 33
        int c = counts.get(i)
        if c == 1
            is_valid := false
            break
        else if c == 2
            janto_count += 1
        else if c >= 3
            kotsu_count += 1
            
    if is_valid and kotsu_count == 4 and janto_count == 1
        true
    else
        false

// ==========================================
// 三元役（大三元・小三元）判定
// ==========================================
export check_sangen(int[] counts) =>
    int haku = counts.get(31)
    int hatsu = counts.get(32)
    int chun = counts.get(33)
    
    int sangen_kotsu = 0
    int sangen_janto = 0
    
    if haku >= 3
        sangen_kotsu += 1
    else if haku == 2
        sangen_janto += 1
        
    if hatsu >= 3
        sangen_kotsu += 1
    else if hatsu == 2
        sangen_janto += 1
        
    if chun >= 3
        sangen_kotsu += 1
    else if chun == 2
        sangen_janto += 1

    bool is_daisangen = (sangen_kotsu == 3)
    bool is_shousangen = (sangen_kotsu == 2 and sangen_janto == 1)
    
    [is_daisangen, is_shousangen]

// ==========================================
// 老頭役・字一色 判定
// ==========================================
export check_routou_tsuuiisou(int[] counts) =>
    bool has_middle_tiles = false
    bool has_jihai = false
    bool has_yaochuu_number = false 
    
    for i = 0 to 33
        int c = counts.get(i)
        if c > 0
            if i >= 27
                has_jihai := true
            else
                int mod = i % 9
                if mod == 0 or mod == 8
                    has_yaochuu_number := true
                else
                    has_middle_tiles := true
                    break

    bool is_tsuuiisou = (not has_middle_tiles and not has_yaochuu_number and has_jihai)
    bool is_chinroutou = (not has_middle_tiles and has_yaochuu_number and not has_jihai)
    bool is_honroutou = (not has_middle_tiles and has_yaochuu_number and has_jihai)

    [is_tsuuiisou, is_chinroutou, is_honroutou]

// ==========================================
// [新規] 四喜和（大四喜・小四喜）判定
// ==========================================
export check_suushii(int[] counts) =>
    int kotsu_count = 0
    int janto_count = 0
    
    // 東(27), 南(28), 西(29), 北(30)
    for i = 27 to 30
        int c = counts.get(i)
        if c >= 3
            kotsu_count += 1
        else if c == 2
            janto_count += 1
            
    bool is_daisuushii = (kotsu_count == 4)
    bool is_shousuushii = (kotsu_count == 3 and janto_count == 1)
    
    [is_daisuushii, is_shousuushii]

// ==========================================
// [新規] 緑一色 判定
// ==========================================
export is_ryuuiisou(int[] counts) =>
    bool is_valid = true
    // 許容される牌: 2索(19), 3索(20), 4索(21), 6索(23), 8索(25), 発(32)
    for i = 0 to 33
        if counts.get(i) > 0
            if not (i == 19 or i == 20 or i == 21 or i == 23 or i == 25 or i == 32)
                is_valid := false
                break
    is_valid

// ==========================================
// [新規] 九蓮宝燈 判定
// ==========================================
export is_kyuuren(int[] counts) =>
    [is_chin, is_hon] = check_somete(counts)
    bool is_valid = false
    
    if is_chin
        int base_idx = -1
        if counts.get(0) > 0 or counts.get(1) > 0 // 萬子
            base_idx := 0
        else if counts.get(9) > 0 or counts.get(10) > 0 // 筒子
            base_idx := 9
        else if counts.get(18) > 0 or counts.get(19) > 0 // 索子
            base_idx := 18
            
        if base_idx >= 0
            is_valid := true
            // 1と9が3枚以上あるか
            if counts.get(base_idx + 0) < 3 or counts.get(base_idx + 8) < 3
                is_valid := false
            else
                // 2〜8が1枚以上あるか
                for i = 1 to 7
                    if counts.get(base_idx + i) < 1
                        is_valid := false
                        break
    is_valid