//@version=6
// TWhatzRapz Scalper Triple stoch with signals
//   Top:    %K 9  / smooth 9  / %D 3   (aqua)
//   Middle: %K 60 / smooth 10 / %D 1   (orange)
//   Bottom: %K 40 / smooth 40 / %D 4   (purple)
// Bands: 80 red / 20 green in each section.
indicator("Triple Stochastic", overlay = false)

// ---- inputs -----------------------------------------------------------------
len1    = input.int(9,  "%K Length",    minval = 1, group = "Stochastic 1 (top)")
smooth1 = input.int(9,  "%K Smoothing", minval = 1, group = "Stochastic 1 (top)")
sigLen1 = input.int(3,  "%D Smoothing", minval = 1, group = "Stochastic 1 (top)")

len2    = input.int(60, "%K Length",    minval = 1, group = "Stochastic 2 (middle)")
smooth2 = input.int(10, "%K Smoothing", minval = 1, group = "Stochastic 2 (middle)")
sigLen2 = input.int(1,  "%D Smoothing", minval = 1, group = "Stochastic 2 (middle)")

len3    = input.int(40, "%K Length",    minval = 1, group = "Stochastic 3 (bottom)")
smooth3 = input.int(40, "%K Smoothing", minval = 1, group = "Stochastic 3 (bottom)")
sigLen3 = input.int(4,  "%D Smoothing", minval = 1, group = "Stochastic 3 (bottom)")

showD      = input.bool(true, "Show %D signal lines", group = "Display")
showTitles = input.bool(true, "Show band titles",     group = "Display")

showSignals = input.bool(true, "Show buy/sell signals", group = "Signals", tooltip = "BUY when all three %K are below 20, SELL when all three are above 80. Fires on the first bar the condition appears.")

// ---- calc -------------------------------------------------------------------
stoch(len, smooth, sigLen) =>
    k = ta.sma(ta.stoch(close, high, low, len), smooth)
    d = ta.sma(k, sigLen)
    [k, d]

[k1, d1] = stoch(len1, smooth1, sigLen1)
[k2, d2] = stoch(len2, smooth2, sigLen2)
[k3, d3] = stoch(len3, smooth3, sigLen3)

// Vertical offsets: bottom band 0-100, middle 120-220, top 240-340.
OFF2 = 120
OFF1 = 240

// ---- plots ------------------------------------------------------------------
plot(k1 + OFF1, "Stoch 1 %K", color = color.new(color.aqua,   0), linewidth = 2)
plot(showD ? d1 + OFF1 : na, "Stoch 1 %D", color = color.new(color.aqua, 60))

plot(k2 + OFF2, "Stoch 2 %K", color = color.new(color.orange, 0), linewidth = 2)
plot(showD ? d2 + OFF2 : na, "Stoch 2 %D", color = color.new(color.orange, 60))

plot(k3, "Stoch 3 %K", color = color.new(color.purple, 0), linewidth = 2)
plot(showD ? d3 : na, "Stoch 3 %D", color = color.new(color.purple, 60))

// 80 / 20 limits inside each band (band bases: 240, 120, 0).
hline(320, "Stoch 1 upper", color = color.red,   linestyle = hline.style_dashed)
hline(260, "Stoch 1 lower", color = color.green, linestyle = hline.style_dashed)
hline(200, "Stoch 2 upper", color = color.red,   linestyle = hline.style_dashed)
hline(140, "Stoch 2 lower", color = color.green, linestyle = hline.style_dashed)
hline(80,  "Stoch 3 upper", color = color.red,   linestyle = hline.style_dashed)
hline(20,  "Stoch 3 lower", color = color.green, linestyle = hline.style_dashed)

// Faint separators between the bands.
hline(110, "Separator", color = color.new(color.gray, 70))
hline(230, "Separator", color = color.new(color.gray, 70))

// ---- buy/sell signals -------------------------------------------------------
allBelow = k1 < 20 and k2 < 20 and k3 < 20
allAbove = k1 > 80 and k2 > 80 and k3 > 80
buySignal  = allBelow and not allBelow[1]
sellSignal = allAbove and not allAbove[1]

plotshape(showSignals and buySignal,  "Buy",  style = shape.triangleup,   location = location.bottom, color = color.green, size = size.small, text = "BUY",  textcolor = color.green)
plotshape(showSignals and sellSignal, "Sell", style = shape.triangledown, location = location.top,    color = color.red,   size = size.small, text = "SELL", textcolor = color.red)

alertcondition(buySignal,  "Triple Stoch BUY",  "All three stochastics below 20")
alertcondition(sellSignal, "Triple Stoch SELL", "All three stochastics above 80")

// ---- band titles ------------------------------------------------------------
var label t1 = na
var label t2 = na
var label t3 = na
if barstate.islast and showTitles
    label.delete(t1)
    label.delete(t2)
    label.delete(t3)
    t1 := label.new(bar_index, OFF1 + 100, str.format("Stoch {0} {1} {2}", len1, smooth1, sigLen1), style = label.style_label_lower_left, color = color.new(color.black, 100), textcolor = color.new(color.aqua,   20), size = size.small)
    t2 := label.new(bar_index, OFF2 + 100, str.format("Stoch {0} {1} {2}", len2, smooth2, sigLen2), style = label.style_label_lower_left, color = color.new(color.black, 100), textcolor = color.new(color.orange, 20), size = size.small)
    t3 := label.new(bar_index, 100,        str.format("Stoch {0} {1} {2}", len3, smooth3, sigLen3), style = label.style_label_lower_left, color = color.new(color.black, 100), textcolor = color.new(color.purple, 20), size = size.small)