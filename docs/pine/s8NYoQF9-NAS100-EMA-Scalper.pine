//@version=6
strategy('NAS100 EMA Scalper', overlay = true, calc_on_every_tick = true, default_qty_type = strategy.percent_of_equity, default_qty_value = 10)

// =======================
// INPUTS
// =======================
scalpMode = input.bool(true, title = 'Enable Scalping Mode (1m/5m)')

ema5_len = input.int(5)
ema10_len = input.int(10)
ema20_len = input.int(20)
ema50_len = input.int(50)
ema200_len = input.int(200)

atrLen = input.int(14)
slMult = input.float(1.2, title = 'SL Multiplier (Scalp tighter)')
tpMult = input.float(2.0, title = 'TP Multiplier')

// =======================
// EMA CALC
// =======================
ema5 = ta.ema(close, ema5_len)
ema10 = ta.ema(close, ema10_len)
ema20 = ta.ema(close, ema20_len)
ema50 = ta.ema(close, ema50_len)
ema200 = ta.ema(close, ema200_len)

// =======================
// PLOTS
// =======================
p5 = plot(ema5, color = color.red)
p10 = plot(ema10, color = color.blue)
p20 = plot(ema20, color = color.orange)
p50 = plot(ema50, color = color.green)
p200 = plot(ema200, color = color.white)


fill(p10, p20, color = color.new(color.gray, 80))

trendBull = ema50 > ema200
trendBear = ema50 < ema200

fill(p50, p200, color = trendBull ? color.new(color.green, 85) : color.new(color.red, 85))

// =======================
// SCALPING FILTERS
// =======================
// Faster momentum confirmation using EMA 5
fastBull = ema5 > ema10 and ema10 > ema20
fastBear = ema5 < ema10 and ema10 < ema20

// Optional: require candle momentum
strongBullCandle = close > open
strongBearCandle = close < open

// =======================
// CROSS + TREND
// =======================
bullCross = ta.crossover(ema10, ema20)
bearCross = ta.crossunder(ema10, ema20)

// Scalping entries (more aggressive)
longCond = trendBull and bullCross and (scalpMode ? fastBull and strongBullCandle : true)
shortCond = trendBear and bearCross and (scalpMode ? fastBear and strongBearCandle : true)


// =======================
// EXECUTION (STRATEGY)
// =======================
if longCond
    strategy.entry('BUY', strategy.long)
    

if shortCond
    strategy.entry('SELL', strategy.short)
    

// =======================
// VISUAL SIGNALS
// =======================
plotshape(longCond, location = location.belowbar, color = color.green, style = shape.labelup, text = 'BUY')
plotshape(shortCond, location = location.abovebar, color = color.red, style = shape.labeldown, text = 'SELL')

// =======================
// ALERTS
// =======================
alertcondition(longCond, title = 'Scalp BUY', message = 'NAS100 Scalp BUY')
alertcondition(shortCond, title = 'Scalp SELL', message = 'NAS100 Scalp SELL')

