//@version=6
// @description Custom Regional Exponential Moving Average with enhanced sensitivity to recent price action
library('REMA')

// @function Regional Exponential Moving Average that maintains recent price sensitivity even with long lookback periods
// @param src Input source series
// @param length Overall EMA period length
// @param recency_bias Weighting factor to increase sensitivity to recent prices (1.0-3.0 recommended)
// @param transition_point Percentage point (0.0-1.0) in the lookback period where weighting shifts from recent to historical
// @returns Custom exponentially weighted moving average with regional bias
export rema(float src, int length, float recency_bias = 1.5, float transition_point = 0.33) =>
    // Parameter validation
    _length = math.max(1, length)
    _recency_bias = math.max(1.0, math.min(5.0, recency_bias))
    _transition = math.max(0.1, math.min(0.9, transition_point))

    // Calculate transition index in the series
    transition_idx = math.round(_length * _transition)

    // Initialize result
    var float result = src

    // Define custom weighting function
    // This function will create two different alpha values:
    // - One stronger alpha for recent data (first transition_point % of the window)
    // - One weaker alpha for older data
    float alpha_recent = 2.0 * _recency_bias / (transition_idx + 1)
    float alpha_historical = 2.0 / (_length - transition_idx + 1)

    // Create a weighted buffer to store intermediate calculations
    var array<float> weights = array.new_float(_length, 0.0)
    var array<float> values = array.new_float(_length, 0.0)

    // Update values buffer (shift and add new value)
    for i = _length - 1 to 1 by 1
        array.set(values, i, array.get(values, i - 1))
    array.set(values, 0, src)

    // Calculate weights for each position with regional bias
    float weight_sum = 0.0

    for i = 0 to _length - 1 by 1
        float weight = 0.0
        if i < transition_idx // Recent data
            weight := math.pow(1 - alpha_recent, i) * alpha_recent
            weight
        // Historical data
        else // Smooth transition between regions
            weight := math.pow(1 - alpha_historical, i - transition_idx) * math.pow(1 - alpha_recent, transition_idx) * alpha_historical
            weight

        array.set(weights, i, weight)
        weight_sum := weight_sum + weight
        weight_sum

    // Normalize weights to ensure they sum to 1.0
    for i = 0 to _length - 1 by 1
        array.set(weights, i, array.get(weights, i) / weight_sum)

    // Calculate weighted sum
    float sum = 0.0
    for i = 0 to _length - 1 by 1
        sum := sum + array.get(values, i) * array.get(weights, i)
        sum

    result := sum
    result

// @function Simplified Regional EMA that uses a recursive calculation method
// @param src Input source series
// @param length Overall EMA period
// @param recency_bias Factor to increase sensitivity to recent price (1.0-3.0 recommended)
// @returns Computationally efficient regional EMA
export rema_fast(float src, int length, float recency_bias = 1.5) =>
    // Parameter validation and preparation
    _length = math.max(1, length)
    _recency_bias = math.max(1.0, math.min(5.0, recency_bias))

    // Calculate two different alpha values
    alpha_recent = 2.0 * _recency_bias / (_length / 3 + 1) // Stronger alpha for recent 1/3
    alpha_historical = 2.0 / (_length + 1) // Standard alpha for complete series

    // Initialize with first value
    var float recent_ema = src
    var float historical_ema = src

    // Update both EMAs with respective decay rates
    recent_ema := alpha_recent * src + (1 - alpha_recent) * recent_ema
    historical_ema := alpha_historical * src + (1 - alpha_historical) * historical_ema

    // Blend the two EMAs with a weighted combination
    // More weight to recent_ema for shorter lengths, more to historical_ema for longer lengths
    blend_factor = math.min(0.8, 5.0 / math.sqrt(_length))
    result = blend_factor * recent_ema + (1 - blend_factor) * historical_ema

    result
