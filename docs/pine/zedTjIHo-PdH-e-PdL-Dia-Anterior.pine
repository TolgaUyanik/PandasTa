//@version=5
indicator("PdH e PdL (Dia Anterior)", overlay=true)

// Obter os valores do dia anterior
prevHigh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
prevLow  = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_on)

// Variáveis persistentes para linhas e labels
var line highLine = na
var line lowLine = na
var label highLabel = na
var label lowLabel = na

// Atualizar no início de cada novo dia
if ta.change(time("D"))
    // Apagar linhas antigas
    if not na(highLine)
        line.delete(highLine)
    if not na(lowLine)
        line.delete(lowLine)
    if not na(highLabel)
        label.delete(highLabel)
    if not na(lowLabel)
        label.delete(lowLabel)

    // Desenhar linhas com 30 barras de comprimento
    lineLength = 30
    highLine := line.new(x1=bar_index, y1=prevHigh, x2=bar_index + lineLength, y2=prevHigh, color=color.green, width=1)
    lowLine  := line.new(x1=bar_index, y1=prevLow,  x2=bar_index + lineLength, y2=prevLow,  color=color.red,   width=1)

    // Labels simples (sem caixa, só texto)
    highLabel := label.new(x=bar_index + lineLength, y=prevHigh, text="PdH",
                           style=label.style_none, textcolor=color.green, size=size.normal)
    lowLabel  := label.new(x=bar_index + lineLength, y=prevLow, text="PdL",
                           style=label.style_none, textcolor=color.red, size=size.normal)
