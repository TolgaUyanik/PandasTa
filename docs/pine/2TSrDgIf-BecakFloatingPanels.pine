// BECAK FLOATING Panels Library
//@version=6
//@description Library for creating floating indicator panels with MACD, RSI, and Stochastic indicators

library("BecakFloatingPanels")

// =============================================================================
// LIBRARY TYPE DEFINITIONS
// =============================================================================

//@type Chart metrics container
//@field visibleHigh Highest visible price
//@field visibleLow Lowest visible price  
//@field chartRange Price range of chart
//@field chartCenter Center point of chart
export type ChartMetrics
    float visibleHigh
    float visibleLow
    float chartRange
    float chartCenter

//@type MACD calculation results
//@field macdLine Main MACD line
//@field signalLine Signal line
//@field histogram MACD histogram
export type MacdData
    float macdLine
    float signalLine
    float histogram

//@type MACD range metrics for normalization
//@field highest Highest MACD value
//@field lowest Lowest MACD value
//@field BRange Total range
export type MacdRange
    float highest
    float lowest
    float BRange

//@type Stochastic calculation results
//@field k_smooth Smoothed %K line
//@field d %D line
export type StochData
    float k_smooth
    float d

//@type Stochastic signals
//@field buySignal Buy signal flag
//@field sellSignal Sell signal flag
export type StochSignals
    bool buySignal
    bool sellSignal

//@type Panel positioning data
//@field macdTop MACD panel top
//@field macdBottom MACD panel bottom
//@field rsiTop RSI panel top
//@field rsiBottom RSI panel bottom
//@field stochTop Stochastic panel top
//@field stochBottom Stochastic panel bottom
export type PanelPositions
    float macdTop
    float macdBottom
    float rsiTop
    float rsiBottom
    float stochTop
    float stochBottom

//@type Visual elements arrays container
//@field macdLines Array of MACD lines
//@field macdHist Array of MACD histogram boxes
//@field rsiLines Array of RSI lines
//@field stochLines Array of Stochastic lines
//@field stochAreas Array of Stochastic areas
//@field stochSignals Array of Stochastic signals
//@field panelBackgrounds Array of panel backgrounds
export type VisualArrays
    array<line> macdLines
    array<box> macdHist
    array<line> rsiLines
    array<line> stochLines
    array<box> stochAreas
    array<label> stochSignals
    array<box> panelBackgrounds

// =============================================================================
// CORE CALCULATION FUNCTIONS
// =============================================================================

//@function Calculate MACD components
//@param source Price source for calculation
//@param fastLength Fast EMA period
//@param slowLength Slow EMA period
//@param signalLength Signal line period
//@returns MacdData MACD calculation results
export calculateMacd(series float source, int fastLength, int slowLength, int signalLength) =>
    fastMA = ta.ema(source, fastLength)
    slowMA = ta.ema(source, slowLength)
    macdLine = fastMA - slowMA
    signalLine = ta.ema(macdLine, signalLength)
    histogram = macdLine - signalLine
    MacdData.new(macdLine, signalLine, histogram)

//@function Calculate RSI
//@param source Price source for calculation
//@param length RSI period
//@returns float RSI value
export calculateRsi(series float source, int length) =>
    ta.rsi(source, length)

//@function Calculate Stochastic components
//@param source Price source for calculation
//@param high High prices
//@param low Low prices
//@param kLength %K period
//@param kSmoothing %K smoothing period
//@param dSmoothing %D smoothing period
//@returns StochData Stochastic calculation results
export calculateStochastic(series float source, series float high, series float low, int kLength, int kSmoothing, int dSmoothing) =>
    stoch_k = ta.stoch(source, high, low, kLength)
    stoch_k_smooth = ta.sma(stoch_k, kSmoothing)
    stoch_d = ta.sma(stoch_k_smooth, dSmoothing)
    StochData.new(stoch_k_smooth, stoch_d)

//@function Calculate Stochastic signals
//@param stochK Stochastic %K series
//@param stochD Stochastic %D series
//@param overboughtLevel Overbought threshold
//@param oversoldLevel Oversold threshold
//@returns StochSignals Signal flags
export calculateStochSignals(series float stochK, series float stochD, float overboughtLevel, float oversoldLevel) =>
    buySignal = ta.crossover(stochK, stochD) and stochK < oversoldLevel and ta.barssince(ta.crossover(stochK, stochD)) == 0
    sellSignal = ta.crossunder(stochK, stochD) and stochK > overboughtLevel and ta.barssince(ta.crossunder(stochK, stochD)) == 0
    StochSignals.new(buySignal, sellSignal)

//@function Calculate chart range and positioning metrics
//@param high High prices
//@param low Low prices
//@param lookbackLength Lookback period
//@returns ChartMetrics Chart positioning data
export calculateChartMetrics(series float high, series float low, int lookbackLength) =>
    safeLookback = math.min(lookbackLength, 50)
    stableRangeLookback = math.min(lookbackLength, math.min(100, bar_index + 1))
    
    visibleHigh = ta.highest(high, stableRangeLookback)
    visibleLow = ta.lowest(low, stableRangeLookback)
    chartRange = visibleHigh - visibleLow
    
    // Ensure minimum chart range
    avgPrice = (visibleHigh + visibleLow) / 2
    minRangePercent = 0.01
    if chartRange < avgPrice * minRangePercent
        chartRange := avgPrice * minRangePercent
    
    chartCenter = visibleLow + chartRange * 0.5
    ChartMetrics.new(visibleHigh, visibleLow, chartRange, chartCenter)

//@function Calculate MACD range for normalization
//@param macdLine MACD line series
//@param signalLine Signal line series
//@param histogram Histogram series
//@param safeLookback Lookback period
//@returns MacdRange MACD range metrics
export calculateMacdRange(series float macdLine, series float signalLine, series float histogram, int safeLookback) =>
    macdHighest = ta.highest(macdLine, safeLookback)
    macdLowest = ta.lowest(macdLine, safeLookback)
    signalHighest = ta.highest(signalLine, safeLookback)
    signalLowest = ta.lowest(signalLine, safeLookback)
    histHighest = ta.highest(histogram, safeLookback)
    histLowest = ta.lowest(histogram, safeLookback)
    
    oscHighest = math.max(math.max(macdHighest, signalHighest), histHighest)
    oscLowest = math.min(math.min(macdLowest, signalLowest), histLowest)
    oscRange = oscHighest - oscLowest
    
    // Ensure minimum range
    if oscRange <= 0
        oscRange := math.abs(oscHighest) * 0.1
        if oscRange <= 0
            oscRange := 1.0
    
    MacdRange.new(oscHighest, oscLowest, oscRange)

// =============================================================================
// VISUAL MANAGEMENT FUNCTIONS
// =============================================================================

//@function Initialize visual arrays
//@returns VisualArrays Container with initialized arrays
export initVisualArrays() =>
    VisualArrays.new(
         array.new_line(),
         array.new_box(),
         array.new_line(),
         array.new_line(),
         array.new_box(),
         array.new_label(),
         array.new_box()
     )

//@function Clear all visual elements
//@param visuals VisualArrays container
//@returns void
export clearVisuals(VisualArrays visuals) =>
    // Clear lines
    if array.size(visuals.macdLines) > 0
        for i = 0 to array.size(visuals.macdLines) - 1
            line.delete(array.get(visuals.macdLines, i))
    array.clear(visuals.macdLines)
    
    if array.size(visuals.rsiLines) > 0
        for i = 0 to array.size(visuals.rsiLines) - 1
            line.delete(array.get(visuals.rsiLines, i))
    array.clear(visuals.rsiLines)
    
    if array.size(visuals.stochLines) > 0
        for i = 0 to array.size(visuals.stochLines) - 1
            line.delete(array.get(visuals.stochLines, i))
    array.clear(visuals.stochLines)
    
    // Clear boxes
    if array.size(visuals.macdHist) > 0
        for i = 0 to array.size(visuals.macdHist) - 1
            box.delete(array.get(visuals.macdHist, i))
    array.clear(visuals.macdHist)
    
    if array.size(visuals.stochAreas) > 0
        for i = 0 to array.size(visuals.stochAreas) - 1
            box.delete(array.get(visuals.stochAreas, i))
    array.clear(visuals.stochAreas)
    
    if array.size(visuals.panelBackgrounds) > 0
        for i = 0 to array.size(visuals.panelBackgrounds) - 1
            box.delete(array.get(visuals.panelBackgrounds, i))
    array.clear(visuals.panelBackgrounds)
    
    // Clear signals
    if array.size(visuals.stochSignals) > 0
        for i = 0 to array.size(visuals.stochSignals) - 1
            label.delete(array.get(visuals.stochSignals, i))
    array.clear(visuals.stochSignals)

//@function Calculate panel positions based on placement option
//@param chartMetrics Chart metrics object
//@param oscPlacement Panel placement option
//@param panelHeight Panel height percentage
//@param panelSpacing Panel spacing percentage
//@param centerOffset Center offset percentage
//@returns PanelPositions Panel boundary coordinates
export calculatePanelPositions(ChartMetrics chartMetrics, string oscPlacement, float panelHeight, float panelSpacing, float centerOffset) =>
    adjustedCenter = chartMetrics.chartCenter + chartMetrics.chartRange * centerOffset / 100.0
    singlePanelHeight = chartMetrics.chartRange * panelHeight
    spacingHeight = chartMetrics.chartRange * panelSpacing
    totalPanelSpace = singlePanelHeight * 3 + spacingHeight * 2
    
    var float macdTop = na
    var float macdBottom = na
    var float rsiTop = na
    var float rsiBottom = na
    var float stochTop = na
    var float stochBottom = na
    
    if oscPlacement == 'Auto-Center'
        groupTop = adjustedCenter + totalPanelSpace * 0.5
        macdTop := groupTop
        macdBottom := macdTop - singlePanelHeight
        rsiTop := macdBottom - spacingHeight
        rsiBottom := rsiTop - singlePanelHeight
        stochTop := rsiBottom - spacingHeight
        stochBottom := stochTop - singlePanelHeight
    else if oscPlacement == 'Top'
        topMargin = chartMetrics.chartRange * 0.05
        macdTop := chartMetrics.visibleHigh - topMargin
        macdBottom := macdTop - singlePanelHeight
        rsiTop := macdBottom - spacingHeight
        rsiBottom := rsiTop - singlePanelHeight
        stochTop := rsiBottom - spacingHeight
        stochBottom := stochTop - singlePanelHeight
    else // Bottom
        bottomMargin = chartMetrics.chartRange * 0.05
        stochBottom := chartMetrics.visibleLow + bottomMargin
        stochTop := stochBottom + singlePanelHeight
        rsiBottom := stochTop + spacingHeight
        rsiTop := rsiBottom + singlePanelHeight
        macdBottom := rsiTop + spacingHeight
        macdTop := macdBottom + singlePanelHeight
    
    PanelPositions.new(macdTop, macdBottom, rsiTop, rsiBottom, stochTop, stochBottom)

//@function Create panel backgrounds
//@param visuals VisualArrays container
//@param positions PanelPositions object
//@param panelLeft Left boundary
//@param panelRight Right boundary
//@param showBackground Show background flag
//@param transparency Background transparency
//@returns void
export createPanelBackgrounds(VisualArrays visuals, PanelPositions positions, int panelLeft, int panelRight, bool showBackground, int transparency) =>
    if showBackground
        // MACD panel background
        array.push(visuals.panelBackgrounds, box.new(panelLeft, positions.macdTop, panelRight, positions.macdBottom, 
             border_color = color.new(color.gray, 40), 
             bgcolor = color.new(color.gray, transparency), 
             border_width = 2, 
             xloc = xloc.bar_index))
        
        // RSI panel background
        array.push(visuals.panelBackgrounds, box.new(panelLeft, positions.rsiTop, panelRight, positions.rsiBottom, 
             border_color = color.new(color.gray, 40), 
             bgcolor = color.new(color.gray, transparency), 
             border_width = 2, 
             xloc = xloc.bar_index))
        
        // Stochastic panel background
        array.push(visuals.panelBackgrounds, box.new(panelLeft, positions.stochTop, panelRight, positions.stochBottom, 
             border_color = color.new(color.gray, 40), 
             bgcolor = color.new(color.gray, transparency), 
             border_width = 2, 
             xloc = xloc.bar_index))

//@function Draw reference lines for all panels
//@param visuals VisualArrays container
//@param positions PanelPositions object
//@param chartMetrics ChartMetrics object
//@param macdRange MacdRange object
//@param dataLeft Left data boundary
//@param dataRight Right data boundary
//@param panelHeight Panel height percentage
//@param rsiOverbought RSI overbought level
//@param rsiOversold RSI oversold level
//@param stochOverbought Stochastic overbought level
//@param stochOversold Stochastic oversold level
//@returns void
export drawReferenceLines(VisualArrays visuals, PanelPositions positions, ChartMetrics chartMetrics, MacdRange macdRange, int dataLeft, int dataRight, float panelHeight, int rsiOverbought, int rsiOversold, int stochOverbought, int stochOversold) =>
    singlePanelHeight = chartMetrics.chartRange * panelHeight
    
    // MACD zero line
    if macdRange.BRange > 0
        macdZeroNormalizedValue = (0.0 - macdRange.lowest) / macdRange.BRange
        macdZeroLineLevel = positions.macdBottom + macdZeroNormalizedValue * singlePanelHeight
        array.push(visuals.macdLines, line.new(dataLeft, macdZeroLineLevel, dataRight, macdZeroLineLevel, xloc.bar_index, extend.none, color.new(color.white, 30), line.style_solid, 1))
    
    // RSI reference lines
    rsi50Level = positions.rsiBottom + 0.5 * singlePanelHeight
    rsiOverboughtLevel = positions.rsiBottom + rsiOverbought / 100.0 * singlePanelHeight
    rsiOversoldLevel = positions.rsiBottom + rsiOversold / 100.0 * singlePanelHeight
    
    array.push(visuals.rsiLines, line.new(dataLeft, rsi50Level, dataRight, rsi50Level, xloc.bar_index, extend.none, color.new(color.white, 30), line.style_solid, 1))
    array.push(visuals.rsiLines, line.new(dataLeft, rsiOverboughtLevel, dataRight, rsiOverboughtLevel, xloc.bar_index, extend.none, color.new(color.red, 40), line.style_dashed, 1))
    array.push(visuals.rsiLines, line.new(dataLeft, rsiOversoldLevel, dataRight, rsiOversoldLevel, xloc.bar_index, extend.none, color.new(color.green, 40), line.style_dashed, 1))
    
    // Stochastic reference lines
    stoch50Level = positions.stochBottom + 0.5 * singlePanelHeight
    stochOverboughtLevel = positions.stochBottom + stochOverbought / 100.0 * singlePanelHeight
    stochOversoldLevel = positions.stochBottom + stochOversold / 100.0 * singlePanelHeight
    
    array.push(visuals.stochLines, line.new(dataLeft, stoch50Level, dataRight, stoch50Level, xloc.bar_index, extend.none, color.new(color.white, 30), line.style_solid, 1))
    array.push(visuals.stochLines, line.new(dataLeft, stochOverboughtLevel, dataRight, stochOverboughtLevel, xloc.bar_index, extend.none, color.new(color.red, 40), line.style_dashed, 1))
    array.push(visuals.stochLines, line.new(dataLeft, stochOversoldLevel, dataRight, stochOversoldLevel, xloc.bar_index, extend.none, color.new(color.green, 40), line.style_dashed, 1))

// =============================================================================
// INDICATOR DRAWING FUNCTIONS
// =============================================================================

//@function Draw MACD indicator
//@param visuals VisualArrays container
//@param macdLine MACD line series
//@param signalLine Signal line series
//@param histogram Histogram series
//@param macdRange MacdRange object
//@param positions PanelPositions object
//@param chartMetrics ChartMetrics object
//@param barIndex Current bar index
//@param nextBarIndex Next bar index
//@param barIndexOffset Horizontal offset
//@param panelHeight Panel height percentage
//@returns void
export drawMacdIndicator(VisualArrays visuals, series float macdLine, series float signalLine, series float histogram, MacdRange macdRange, PanelPositions positions, ChartMetrics chartMetrics, int barIndex, int nextBarIndex, int barIndexOffset, float panelHeight) =>
    singlePanelHeight = chartMetrics.chartRange * panelHeight
    
    // MACD Line
    if not na(macdLine[barIndex]) and not na(macdLine[nextBarIndex]) and macdRange.BRange > 0
        macdNormalizedCurrent = (macdLine[barIndex] - macdRange.lowest) / macdRange.BRange
        macdLevelCurrent = positions.macdBottom + macdNormalizedCurrent * singlePanelHeight
        macdNormalizedNext = (macdLine[nextBarIndex] - macdRange.lowest) / macdRange.BRange
        macdLevelNext = positions.macdBottom + macdNormalizedNext * singlePanelHeight
        
        currentBarX = bar_index - barIndex + barIndexOffset
        nextBarX = bar_index - nextBarIndex + barIndexOffset
        
        array.push(visuals.macdLines, line.new(currentBarX, macdLevelCurrent, nextBarX, macdLevelNext, xloc.bar_index, extend.none, color.blue, line.style_solid, 3))
    
    // Signal Line
    if not na(signalLine[barIndex]) and not na(signalLine[nextBarIndex]) and macdRange.BRange > 0
        signalNormalizedCurrent = (signalLine[barIndex] - macdRange.lowest) / macdRange.BRange
        signalLevelCurrent = positions.macdBottom + signalNormalizedCurrent * singlePanelHeight
        signalNormalizedNext = (signalLine[nextBarIndex] - macdRange.lowest) / macdRange.BRange
        signalLevelNext = positions.macdBottom + signalNormalizedNext * singlePanelHeight
        
        currentBarX = bar_index - barIndex + barIndexOffset
        nextBarX = bar_index - nextBarIndex + barIndexOffset
        
        array.push(visuals.macdLines, line.new(currentBarX, signalLevelCurrent, nextBarX, signalLevelNext, xloc.bar_index, extend.none, color.orange, line.style_solid, 2))
    
    // Histogram
    histValue = histogram[barIndex]
    if not na(histValue) and macdRange.BRange > 0
        histColor = histValue >= 0 ? color.new(color.green, 40) : color.new(color.red, 40)
        histNormalizedTop = (math.max(histValue, 0) - macdRange.lowest) / macdRange.BRange
        histTopLevel = positions.macdBottom + histNormalizedTop * singlePanelHeight
        histNormalizedBottom = (math.min(histValue, 0) - macdRange.lowest) / macdRange.BRange
        histBottomLevel = positions.macdBottom + histNormalizedBottom * singlePanelHeight
        
        currentBarX = bar_index - barIndex + barIndexOffset
        
        array.push(visuals.macdHist, box.new(currentBarX - 1, histTopLevel, currentBarX + 1, histBottomLevel, border_color = color.new(color.white, 90), bgcolor = histColor, border_width = 0, xloc = xloc.bar_index))

//@function Draw RSI indicator
//@param visuals VisualArrays container
//@param rsiValue RSI value
//@param positions PanelPositions object
//@param chartMetrics ChartMetrics object
//@param barIndex Current bar index
//@param nextBarIndex Next bar index
//@param barIndexOffset Horizontal offset
//@param panelHeight Panel height percentage
//@returns void
export drawRsiIndicator(VisualArrays visuals, series float rsiValue, PanelPositions positions, ChartMetrics chartMetrics, int barIndex, int nextBarIndex, int barIndexOffset, float panelHeight) =>
    singlePanelHeight = chartMetrics.chartRange * panelHeight
    
    if not na(rsiValue[barIndex]) and not na(rsiValue[nextBarIndex])
        rsiNormalizedCurrent = rsiValue[barIndex] / 100.0
        rsiLevelCurrent = positions.rsiBottom + rsiNormalizedCurrent * singlePanelHeight
        rsiNormalizedNext = rsiValue[nextBarIndex] / 100.0
        rsiLevelNext = positions.rsiBottom + rsiNormalizedNext * singlePanelHeight
        
        currentBarX = bar_index - barIndex + barIndexOffset
        nextBarX = bar_index - nextBarIndex + barIndexOffset
        
        array.push(visuals.rsiLines, line.new(currentBarX, rsiLevelCurrent, nextBarX, rsiLevelNext, xloc.bar_index, extend.none, color.purple, line.style_solid, 3))

//@function Draw Stochastic indicator
//@param visuals VisualArrays container
//@param stochK Stochastic %K series
//@param stochD Stochastic %D series
//@param positions PanelPositions object
//@param chartMetrics ChartMetrics object
//@param barIndex Current bar index
//@param nextBarIndex Next bar index
//@param barIndexOffset Horizontal offset
//@param panelHeight Panel height percentage
//@param stochOverbought Overbought level
//@param stochOversold Oversold level
//@returns void
export drawStochasticIndicator(VisualArrays visuals, series float stochK, series float stochD, PanelPositions positions, ChartMetrics chartMetrics, int barIndex, int nextBarIndex, int barIndexOffset, float panelHeight, int stochOverbought, int stochOversold) =>
    singlePanelHeight = chartMetrics.chartRange * panelHeight
    
    // %K Line
    if not na(stochK[barIndex]) and not na(stochK[nextBarIndex])
        stochKNormalizedCurrent = stochK[barIndex] / 100.0
        stochKLevelCurrent = positions.stochBottom + stochKNormalizedCurrent * singlePanelHeight
        stochKNormalizedNext = stochK[nextBarIndex] / 100.0
        stochKLevelNext = positions.stochBottom + stochKNormalizedNext * singlePanelHeight
        
        currentBarX = bar_index - barIndex + barIndexOffset
        nextBarX = bar_index - nextBarIndex + barIndexOffset
        
        array.push(visuals.stochLines, line.new(currentBarX, stochKLevelCurrent, nextBarX, stochKLevelNext, xloc.bar_index, extend.none, color.blue, line.style_solid, 3))
    
    // %D Line
    if not na(stochD[barIndex]) and not na(stochD[nextBarIndex])
        stochDNormalizedCurrent = stochD[barIndex] / 100.0
        stochDLevelCurrent = positions.stochBottom + stochDNormalizedCurrent * singlePanelHeight
        stochDNormalizedNext = stochD[nextBarIndex] / 100.0
        stochDLevelNext = positions.stochBottom + stochDNormalizedNext * singlePanelHeight
        
        currentBarX = bar_index - barIndex + barIndexOffset
        nextBarX = bar_index - nextBarIndex + barIndexOffset
        
        array.push(visuals.stochLines, line.new(currentBarX, stochDLevelCurrent, nextBarX, stochDLevelNext, xloc.bar_index, extend.none, color.orange, line.style_solid, 2))
    
    // Overbought/Oversold Areas
    currentStochK = stochK[barIndex]
    if not na(currentStochK)
        currentBarX = bar_index - barIndex + barIndexOffset
        
        if currentStochK >= stochOverbought
            array.push(visuals.stochAreas, box.new(currentBarX - 1, positions.stochTop, currentBarX + 1, positions.stochBottom + stochOverbought / 100.0 * singlePanelHeight, border_color = color.new(color.red, 80), bgcolor = color.new(color.red, 90), border_width = 0, xloc = xloc.bar_index))
        
        if currentStochK <= stochOversold
            array.push(visuals.stochAreas, box.new(currentBarX - 1, positions.stochBottom + stochOversold / 100.0 * singlePanelHeight, currentBarX + 1, positions.stochBottom, border_color = color.new(color.green, 80), bgcolor = color.new(color.green, 90), border_width = 0, xloc = xloc.bar_index))

//@function Add Stochastic buy/sell signals
//@param visuals VisualArrays container
//@param buySignal Buy signal series
//@param sellSignal Sell signal series
//@param positions PanelPositions object
//@param chartMetrics ChartMetrics object
//@param currentBarIndex Current bar index
//@param barIndexOffset Horizontal offset
//@param panelHeight Panel height percentage
//@param signalIndex Signal index for lookback
//@returns void
export addStochasticSignals(VisualArrays visuals, series bool buySignal, series bool sellSignal, PanelPositions positions, ChartMetrics chartMetrics, int currentBarIndex, int barIndexOffset, float panelHeight, int signalIndex) =>
    singlePanelHeight = chartMetrics.chartRange * panelHeight
    
    currentBarX = bar_index - currentBarIndex + barIndexOffset
    
    if buySignal[signalIndex]
        stochSignalLevel = positions.stochBottom + singlePanelHeight * 0.1
        array.push(visuals.stochSignals, label.new(currentBarX, stochSignalLevel, text = 'B', textcolor = color.white, color = color.new(color.green, 0), style = label.style_circle, size = size.small))
    
    if sellSignal[signalIndex]
        stochSignalLevel = positions.stochTop - singlePanelHeight * 0.1
        array.push(visuals.stochSignals, label.new(currentBarX, stochSignalLevel, text = 'S', textcolor = color.white, color = color.new(color.red, 0), style = label.style_circle, size = size.small))

//@function Set panel title labels
//@param macdLabel MACD label reference
//@param rsiLabel RSI label reference
//@param stochLabel Stochastic label reference
//@param positions PanelPositions object
//@param chartMetrics ChartMetrics object
//@param labelOffset Label horizontal offset
//@param panelHeight Panel height percentage
//@param barIndexOffset Horizontal offset
//@returns void
export setPanelLabels(label macdLabel, label rsiLabel, label stochLabel, PanelPositions positions, ChartMetrics chartMetrics, int labelOffset, float panelHeight, int barIndexOffset) =>
    singlePanelHeight = chartMetrics.chartRange * panelHeight
    labelMargin = singlePanelHeight * 0.03
    
    label.set_xy(macdLabel, bar_index[labelOffset] + barIndexOffset, positions.macdTop - labelMargin)
    label.set_text(macdLabel, 'MACD (12,26,9)')
    
    label.set_xy(rsiLabel, bar_index[labelOffset] + barIndexOffset, positions.rsiTop - labelMargin)
    label.set_text(rsiLabel, 'RSI (14)')
    
    label.set_xy(stochLabel, bar_index[labelOffset] + barIndexOffset, positions.stochTop - labelMargin)
    label.set_text(stochLabel, 'Stochastic (14,3,3)')

//@function Display debug information
//@param chartMetrics ChartMetrics object
//@param debugMode Debug mode flag
//@returns void
export showDebugInfo(ChartMetrics chartMetrics, bool debugMode) =>
    if barstate.islast and debugMode
        var debug_label = label.new(na, na, '', color = color.new(color.white, 100), textcolor = color.yellow, style = label.style_none, size = size.tiny)
        avgPrice = (chartMetrics.visibleHigh + chartMetrics.visibleLow) / 2
        assetType = avgPrice < 10.0 ? 'crypto' : 'stock'
        debugText = 'Asset: ' + assetType + ' | Range: ' + str.tostring(chartMetrics.chartRange, '#.######') + ' | High: ' + str.tostring(chartMetrics.visibleHigh, '#.######') + ' | Low: ' + str.tostring(chartMetrics.visibleLow, '#.######')
        label.set_xy(debug_label, bar_index[5], chartMetrics.visibleHigh)
        label.set_text(debug_label, debugText)