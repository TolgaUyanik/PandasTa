//@version=5

//Useful functions that simplify comparison of dates, time and values

library("Functions")

export is_date_equal(int date1,int date2,string time_zone)=>
	result = str.format_time(date1,"dd-MM-yyyy",time_zone)==str.format_time(date2,"dd-MM-yyyy",time_zone)

export is_date_equal(int date1,string date2_str,string time_zone)=>
	result = str.format_time(date1,"dd-MM-yyyy",time_zone)==date2_str

export is_date_between(int date_, int start_year, int start_month, int end_year, int end_month, string time_zone_)=>
	value = year(date_, time_zone_)*12+month(date_,time_zone_)
	result = value >= (start_year*12+start_month) and value <= (end_year*12+end_month)

export is_time_equal(int time1,string time2_str,string time_zone)=>
	result = str.format_time(time1,"HH:mm",time_zone)==time2_str

export is_time_equal(int time1,int time2,string time_zone)=>
	result = str.format_time(time1,"HH:mm",time_zone)==str.format_time(time2,"HH:mm",time_zone)

export create_timezone(int offset)=>
	time_zone = "UTC"
	if offset > 0 
		time_zone := str.format("UTC+{0,number}",offset)
	if offset < 0 
		time_zone := str.format("UTC-{0,number}",offset)
	time_zone


export is_time_between(int time_, int start_hour, int start_minute, int end_hour, int end_minute, string time_zone_)=>
	value = hour(time_, time_zone_)*60+minute(time_,time_zone_)
	result = value >= (start_hour*60+start_minute) and value < (end_hour*60+end_minute)

export is_time_between(int time_, string start_time, string end_time, string time_zone_)=>
	start_hour = str.tonumber(str.substring(start_time,0,2))
	start_minute =  str.tonumber(str.substring(start_time,3,5))
	end_hour =  str.tonumber(str.substring(end_time,0,2))
	end_minute =  str.tonumber(str.substring(end_time,3,5))
	value = hour(time_, time_zone_)*60+minute(time_,time_zone_)
	result = value >= (start_hour*60+start_minute) and value < (end_hour*60+end_minute)

export is_close(float value, float level, int ticks)=>
	result = value>=level-ticks*syminfo.mintick and value<=level+ticks*syminfo.mintick
	result

export is_inrange(float value, float lb, float hb)=>
	result = value>=lb and value<=hb
	result

export is_above(float value, float level, int ticks)=>
	result = value>=level and value<=level+ticks*syminfo.mintick
	result

export is_below(float value, float level, int ticks)=>
	result = value>=level-ticks*syminfo.mintick and value<=level
	result

export is_leap_year() =>
    if ((year % 4) != 0)
        false
    else if ((year % 100) != 0)
        true
    else if ((year % 400) == 0)
        true
    else
        false

export get_last_day() =>
    if (month == 1) or (month == 3) or (month == 5) or (month == 7) or (month == 8) or (month == 10) or (month == 12)
        31
    else if (month == 4) or (month == 6) or (month == 9) or (month == 11)
        30
    else
    	is_leap_year() ? 29 : 28  // February


OPEN_TIME = "15:30"
CLOSE_TIME = "22:00"
time_zone = "UTC+1"

plotshape(is_time_between(time,OPEN_TIME,CLOSE_TIME,time_zone))