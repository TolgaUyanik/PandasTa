//@version=5

// @description TODO: add library description here
library("lib_dates",overlay = true)

// === INPUT BACKTEST RANGE ===
i_from = input.time(defval = timestamp("01 Jan 2024 00:00 +0000"), title = "From")
i_thru = input.time(defval = timestamp("01 July 2024 00:00 +0000"), title = "Thru")

// === INPUT SHOW PLOT ===
i_show = input     (defval = true, title = "Show Date Range")


// @function inDateRange: Checks if the time `t` is in range between `from` to `thru`
// @param x TODO: add parameter x description here
// @returns bool: true if time is in range false otherwise
export inDateRange(int from, int thru) =>
    time >= from and time <= thru

bgcolor(color = i_show and inDateRange(i_from, i_thru) ? #0e7c101a : na)  // plot if "Show Date Range" and "within window of time"
