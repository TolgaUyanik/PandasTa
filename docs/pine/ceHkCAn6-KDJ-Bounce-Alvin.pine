//@version=6
strategy(title="KDJ Bounce [Alvin]", overlay=true, format=format.price,
     initial_capital=100000,
     default_qty_type=strategy.fixed,
     default_qty_value=1,
     calc_on_every_tick=true)

// ============================================================
//  KDJ Parameters
// ============================================================
kPeriod     = input.int(9,  "K Period")
kSmooth     = input.int(3,  "K Smoothing")
dSmooth     = input.int(3,  "D Smoothing")
jOversold   = input.float(20, "J Oversold Threshold",  step=1, minval=0,  maxval=50)
jOverbought = input.float(80, "J Overbought Threshold", step=1, minval=50, maxval=100)

// ============================================================
//  KDJ Computation
// ============================================================
float hh = ta.highest(high, kPeriod)
float ll = ta.lowest(low, kPeriod)
float rsv = (hh == ll) ? 50 : (close - ll) / (hh - ll) * 100

var float k = na
var float d = na
k := na(k[1]) ? rsv : (rsv + 2 * nz(k[1])) / 3
d := na(d[1]) ? k   : (k   + 2 * nz(d[1])) / 3
float j = 3 * k - 2 * d

// ============================================================
//  Entry Signals
// ============================================================
bool longEntry  = ta.crossover(j, jOversold)   and strategy.position_size == 0
bool shortEntry = ta.crossunder(j, jOverbought) and strategy.position_size == 0

// ============================================================
//  Long Exit — 2 consecutive down bars
// ============================================================
var bool  exitDnSeq = false
var float exitDnRef = na
bool      exitLong  = false

if strategy.position_size > 0
    bool isDown = close < open
    if isDown
        if not exitDnSeq
            exitDnSeq := true
            exitDnRef := close
        else
            if close < exitDnRef
                exitLong := true
            else
                exitDnRef := close
    else
        exitDnSeq := false
        exitDnRef := na
else
    exitDnSeq := false
    exitDnRef := na

// ============================================================
//  Short Exit — 2 consecutive up bars
// ============================================================
var bool  exitUpSeq = false
var float exitUpRef = na
bool      exitShort = false

if strategy.position_size < 0
    bool isUp = close > open
    if isUp
        if not exitUpSeq
            exitUpSeq := true
            exitUpRef := close
        else
            if close > exitUpRef
                exitShort := true
            else
                exitUpRef := close
    else
        exitUpSeq := false
        exitUpRef := na
else
    exitUpSeq := false
    exitUpRef := na

// ============================================================
//  Order Execution
// ============================================================
if longEntry
    strategy.entry("Long", strategy.long, comment="Long")

if exitLong
    strategy.close("Long", comment="Exit Long")

if shortEntry
    strategy.entry("Short", strategy.short, comment="Short")

if exitShort
    strategy.close("Short", comment="Exit Short")

// ============================================================
//  Signals — Minimalist styling, theme-agnostic colors
// ============================================================
color cBuy  = #4caf50   // green — clear on both themes
color cSell = #ef5350   // red — clear on both themes
color cExit = #78909c   // blue-gray — neutral

// Entry arrows
plotshape(longEntry,  style=shape.triangleup,   location=location.belowbar,
     color=cBuy,  size=size.small, text="")
plotshape(shortEntry, style=shape.triangledown, location=location.abovebar,
     color=cSell, size=size.small, text="")

// Exit markers
plotshape(exitLong,  style=shape.labeldown, location=location.abovebar,
     color=cExit, size=size.large, text="Close")
plotshape(exitShort, style=shape.labelup,   location=location.belowbar,
     color=cExit, size=size.large, text="Close")

// ============================================================
//  Alerts
// ============================================================
alertcondition(longEntry,  title="KDJ Long Entry",  message="KDJ Long: J crossed above oversold")
alertcondition(shortEntry, title="KDJ Short Entry", message="KDJ Short: J crossed below overbought")
alertcondition(exitLong,   title="KDJ Long Exit",   message="KDJ Long Exit: 2 consecutive down bars")
alertcondition(exitShort,  title="KDJ Short Exit",  message="KDJ Short Exit: 2 consecutive up bars")
