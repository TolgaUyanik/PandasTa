//@version=6
strategy("My strategy", overlay=true, fill_orders_on_standard_ohlc = true)

longCondition = ta.crossover(ta.sma(close, 14), ta.sma(close, 28))
if (longCondition)
    strategy.entry("My Long Entry Id", strategy.long)

shortCondition = ta.crossunder(ta.sma(close, 14), ta.sma(close, 28))
if (shortCondition)
    strategy.entry("My Short Entry Id", strategy.short)

//@version=5

// ==========================================
// 1. INPUTS & CONFIGURATION
// ==========================================
leftLen  = input.int(5, title="Pivot Left Bars (Structure)")
rightLen = input.int(5, title="Pivot Right Bars (Structure)")
boxLimit = input.int(10, title="Max Displayed Zones")

// ==========================================
// 2. MARKET STRUCTURE SHIFTS (MSS)
// ==========================================
pHi = ta.pivothigh(high, leftLen, rightLen)
pLo = ta.pivotlow(low, leftLen, rightLen)

var float lastPivotHigh = na
var float lastPivotLow  = na

if not na(pHi)
    lastPivotHigh := pHi
if not na(pLo)
    lastPivotLow := pLo

// Track when an aggressive candle closes past recent structure
bullishBreak = ta.crossover(close, lastPivotHigh)
bearishBreak = ta.crossunder(close, lastPivotLow)

// ==========================================
// 3. ORDER BLOCK DETECTION & BOX PLOTTING
// ==========================================
var box[] bullishBoxes = array.new<box>()
var box[] bearishBoxes = array.new<box>()

// A. Bullish Order Block (Institutional Support)
if bullishBreak
    // Find the lowest bearish candle in the lookback window before the breakout
    int obIndex = 0
    float lowestLow = low[0]
    for i = 1 to (leftLen + rightLen)
        if close[i] < open[i] and low[i] < lowestLow
            lowestLow := low[i]
            obIndex := i
            
    // Create a support zone box using that candle's dimensions
    box obBox = box.new(left=bar_index - obIndex, top=high[obIndex], right=bar_index, bottom=low[obIndex],
                  bgcolor=color.new(color.green, 90), border_color=color.new(color.green, 40), border_width=1)
                  
    array.push(bullishBoxes, obBox)
    if array.size(bullishBoxes) > boxLimit
        box.delete(array.shift(bullishBoxes))

// B. Bearish Order Block (Institutional Resistance)
if bearishBreak
    // Find the highest bullish candle in the lookback window before the breakdown
    int obIndex = 0
    float highestHigh = high[0]
    for i = 1 to (leftLen + rightLen)
        if close[i] > open[i] and high[i] > highestHigh
            highestHigh := high[i]
            obIndex := i
            
    // Create a resistance zone box
    box obBox = box.new(left=bar_index - obIndex, top=high[obIndex], right=bar_index, bottom=low[obIndex],
                  bgcolor=color.new(color.red, 90), border_color=color.new(color.red, 40), border_width=1)
                  
    array.push(bearishBoxes, obBox)
    if array.size(bearishBoxes) > boxLimit
        box.delete(array.shift(bearishBoxes))

// ==========================================
// 4. EXTEND ACTIVE ZONES TO REAL-TIME PRICE
// ==========================================
if array.size(bullishBoxes) > 0
    for i = 0 to array.size(bullishBoxes) - 1
        box.set_right(array.get(bullishBoxes, i), bar_index)

if array.size(bearishBoxes) > 0
    for i = 0 to array.size(bearishBoxes) - 1
        box.set_right(array.get(bearishBoxes, i), bar_index)

// Plots structural triggers for reference
plotshape(bullishBreak, title="Institutional Shift Up", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)
plotshape(bearishBreak, title="Institutional Shift Down", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)

