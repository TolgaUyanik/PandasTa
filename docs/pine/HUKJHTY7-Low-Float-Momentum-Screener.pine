//@version=6
indicator("Low Float Momentum Screener", overlay=false)

rvolLength = input.int(10, title="RVOL lookback (bars)")

floatShares = syminfo.shares_outstanding_float
avgVol = ta.sma(volume[1], rvolLength)
rvol = avgVol > 0 ? volume / avgVol : na
changePct = (close - open) / open * 100

plot(floatShares, title="Float")
plot(rvol, title="RelVolume")
plot(changePct, title="ChangePct")
plot(close, title="Price")