    switch index
        0  => "S16E6"
        1  => "T30E6"
        2  => "T13F6"
        3  => "S27F6"
        4  => "TTM26"
        5  => "S17A6"
        6  => "S30A6"
        7  => "S29Y6"
        8  => "T30J6"
        9  => "TTJ26"
        10 => "S31G6"
        11 => "TTS26"
        12 => "S30O6"
        13 => "S30N6"
        14 => "TTD26"
        15 => "T15E7"
        16 => "T30A7"
        17 => "T31Y7"
        => ""

// ----------------------------------------------------------------------------
// MATURITY PRICES (px_finish) - Price at maturity from auction
// ----------------------------------------------------------------------------
export getMaturityPrice(int index) =>
    switch index
        0  => 119.062
        1  => 142.222
        2  => 144.966
        3  => 125.842
        4  => 135.238
        5  => 109.938
        6  => 127.486
        7  => 132.044
        8  => 144.896
        9  => 144.629
        10 => 127.064
        11 => 152.095
        12 => 135.278
        13 => 129.889
        14 => 161.144
        15 => 161.104
        16 => 157.340
        17 => 152.185
        => 0.0

// ----------------------------------------------------------------------------
// MATURITY DATES - Timestamp format for PineScript
// Format: timestamp(year, month, day, 0, 0)
// ----------------------------------------------------------------------------
export getMaturityTimestamp(int index) =>
    switch index
        0  => timestamp(2026, 1, 16, 0, 0)   // S16E6
        1  => timestamp(2026, 1, 30, 0, 0)   // T30E6
        2  => timestamp(2026, 2, 13, 0, 0)   // T13F6
        3  => timestamp(2026, 2, 27, 0, 0)   // S27F6
        4  => timestamp(2026, 3, 16, 0, 0)   // TTM26
        5  => timestamp(2026, 4, 17, 0, 0)   // S17A6
        6  => timestamp(2026, 4, 30, 0, 0)   // S30A6
        7  => timestamp(2026, 5, 29, 0, 0)   // S29Y6
        8  => timestamp(2026, 6, 30, 0, 0)   // T30J6
        9  => timestamp(2026, 6, 30, 0, 0)   // TTJ26
        10 => timestamp(2026, 8, 31, 0, 0)   // S31G6
        11 => timestamp(2026, 9, 15, 0, 0)   // TTS26
        12 => timestamp(2026, 10, 30, 0, 0)  // S30O6
        13 => timestamp(2026, 11, 30, 0, 0)  // S30N6
        14 => timestamp(2026, 12, 15, 0, 0)  // TTD26
        15 => timestamp(2027, 1, 15, 0, 0)   // T15E7
        16 => timestamp(2027, 4, 30, 0, 0)   // T30A7
        17 => timestamp(2027, 5, 31, 0, 0)   // T31Y7
        => 0

