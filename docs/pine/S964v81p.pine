// ----------------------------------------------------------------------------
// INSTRUMENT TYPE (LECAP or BONCAP)
// LECAPs start with 'S', BONCAPs start with 'T'
// ----------------------------------------------------------------------------
export isBoncap(int index) =>
    ticker = getTickerShort(index)
    str.startswith(ticker, "T")

export isLecap(int index) =>
    ticker = getTickerShort(index)
    str.startswith(ticker, "S")

export getInstrumentType(int index) =>
    isBoncap(index) ? "BONCAP" : "LECAP"

// ----------------------------------------------------------------------------
// DOLAR FUTURES DATA (MATBAROFEX)
// TradingView symbols and expiration dates
// ----------------------------------------------------------------------------
export getDolarFuturesCount() =>
    11

export getDolarFuturesTicker(int index) =>
    switch index
        0  => "MATBAROFEX:DLR.AF2026"  // Jan 2026
        1  => "MATBAROFEX:DLR.AG2026"  // Feb 2026
        2  => "MATBAROFEX:DLR.AH2026"  // Mar 2026
        3  => "MATBAROFEX:DLR.AJ2026"  // Apr 2026
        4  => "MATBAROFEX:DLR.AK2026"  // May 2026
        5  => "MATBAROFEX:DLR.AM2026"  // Jun 2026
        6  => "MATBAROFEX:DLR.AN2026"  // Jul 2026
        7  => "MATBAROFEX:DLR.AQ2026"  // Aug 2026
        8  => "MATBAROFEX:DLR.AU2026"  // Sep 2026
        9  => "MATBAROFEX:DLR.AV2026"  // Oct 2026
        10 => "MATBAROFEX:DLR.AX2026"  // Nov 2026
        => ""

export getDolarFuturesShort(int index) =>
    switch index
        0  => "DLR Ene26"
        1  => "DLR Feb26"
        2  => "DLR Mar26"
        3  => "DLR Abr26"
        4  => "DLR May26"
        5  => "DLR Jun26"
        6  => "DLR Jul26"
        7  => "DLR Ago26"
        8  => "DLR Sep26"
        9  => "DLR Oct26"
        10 => "DLR Nov26"
        => ""

export getDolarFuturesExpiry(int index) =>
    switch index
        0  => timestamp(2026, 1, 30, 0, 0)
        1  => timestamp(2026, 2, 27, 0, 0)
        2  => timestamp(2026, 3, 31, 0, 0)
        3  => timestamp(2026, 4, 30, 0, 0)
        4  => timestamp(2026, 5, 29, 0, 0)
        5  => timestamp(2026, 6, 30, 0, 0)
        6  => timestamp(2026, 7, 31, 0, 0)
        7  => timestamp(2026, 8, 31, 0, 0)
        8  => timestamp(2026, 9, 30, 0, 0)
        9  => timestamp(2026, 10, 30, 0, 0)
        10 => timestamp(2026, 11, 30, 0, 0)
        => 0

// ----------------------------------------------------------------------------
// HELPER FUNCTIONS
// ----------------------------------------------------------------------------

// Calculate days until maturity from current time
export getDaysToMaturity(int index) =>
    maturityTs = getMaturityTimestamp(index)
    currentTs = timenow
    math.max(0, math.floor((maturityTs - currentTs) / (24 * 60 * 60 * 1000)))

// Get all data as formatted string for debugging
export getDataSummary(int index) =>
    ticker = getTickerShort(index)
    pxFinish = getMaturityPrice(index)
    year = getMaturityYear(index)
    month = getMaturityMonth(index)
    day = getMaturityDay(index)
    instType = getInstrumentType(index)
    str.format("{0} | {1} | {2}/{3}/{4} | ${5}", ticker, instType, day, month, year, str.tostring(pxFinish, "#.###"))
