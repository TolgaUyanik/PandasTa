//@version=6

// @description Collection of all custom and enhanced TA indicators - Object oriented methods implementation
library('oota', overlay = true)

//@type Custom candle object
//@field o open
//@field h high
//@field l low
//@field c close
//@field barindex bar_index
//@field bartime time
//@field bartimeclose time_close
//@field v volume
export type Candle
    float o = open
    float h = high
    float l = low
    float c = close
    int barindex = bar_index
    int bartime = time
    int bartimeclose = time_close
    float v = volume

//@enum Contains Custom Series types
//@field EMA Exponential moving average
//@field SMA Simple moving average
//@field RMA Rolling moving average
//@field HMA Hull moving average
//@field WMA Weighted moving average
//@field VWMA Volume weighted moving average
//@field SWMA Symmetrically weighted moving average
//@field LINREG Linear regression
//@field MEDIAN Median
//@field MOM Momentum
//@field HIGH high
//@field LOW low
//@field MEDIAN_HIGH Median of high values
//@field MEDIAN_LOW Median of low values
//@field PERCENTRANK Percentrank
//@field HIGHLOW High of low or Low of High
export enum CustomSeries
    EMA
    SMA
    RMA
    HMA
    WMA
    VWMA
    SWMA
    LINREG
    MEDIAN
    MOM
    HIGH
    LOW
    MEDIAN_HIGH
    MEDIAN_LOW
    PERCENTRANK
    HIGHLOW
    
bandwidth(float middle, float upper, float lower) =>
    100 * (upper - lower) / middle
percentb(float source, float upper, float lower) =>
    100 * (source - lower) / (upper - lower)
customseries(float source = close, simple CustomSeries maType = CustomSeries.SMA, simple int length) =>
    switch maType
        CustomSeries.EMA => ta.ema(source, length)
        CustomSeries.SMA => ta.sma(source, length)
        CustomSeries.RMA => ta.rma(source, length)
        CustomSeries.HMA => ta.hma(source, length)
        CustomSeries.WMA => ta.wma(source, length)
        CustomSeries.VWMA => ta.vwma(source, length)
        CustomSeries.SWMA => ta.swma(source)
        CustomSeries.LINREG => ta.linreg(source, length, 0)
        CustomSeries.MEDIAN => ta.median(source, length)
        CustomSeries.MOM => ta.mom(source, length)
        CustomSeries.HIGH => ta.highest(source, length)
        CustomSeries.LOW => ta.lowest(source, length)
        CustomSeries.MEDIAN_HIGH => ta.median(ta.highest(source, length), length)
        CustomSeries.MEDIAN_LOW => ta.median(ta.lowest(source, length), length)
        CustomSeries.PERCENTRANK => ta.percentrank(source, length)
        => (ta.highest(length) + ta.lowest(length)) / 2

getStickyRange(float highsource, float lowsource, float upper, float lower, simple bool sticky = false) =>
    newUpper = upper
    newLower = lower
    highBreakout = highsource[1] >= newUpper[1]
    lowBreakout = lowsource[1] <= newLower[1]
    newUpper := highBreakout or lowBreakout or not sticky ? newUpper : nz(newUpper[1], newUpper)
    newLower := highBreakout or lowBreakout or not sticky ? newLower : nz(newLower[1], newLower)
    [newUpper, newLower]

// @function returns true range of the candle
// @param c Candle object containing ohlc data
// @param useTrueRange Use true range for atr calculation instead of just high/low difference
export method tr(Candle c, bool useTrueRange = true)=>
    cl = c.c
    useTrueRange? math.max(c.h, nz(cl[1], c.h))-math.min(c.l, nz(cl[1], c.l)): c.h-c.l

// @function returns custom moving averages
// @param maType Custom series type
// @param length Moving Average Length
// @param source Moving Average Source
// @returns moving average for the given type and length
export method ma(simple CustomSeries maType = CustomSeries.SMA, simple int length, float source = close) =>
    customseries(source, maType, length)

// @function returns ATR with custom moving average
// @param maType Custom series type
// @param length Moving Average Length
// @param useTrueRange Use true range for atr calculation instead of just high/low difference
// @param c Candle object containing ohlc
// @returns ATR for the given moving average type and length
export method atr(simple CustomSeries maType = CustomSeries.SMA, simple int length, bool useTrueRange = true, Candle c = na) =>
    candle = na(c)? Candle.new() : c
    tr = candle.tr(useTrueRange)
    nz(customseries(tr, maType, length), tr)

// @function returns ATR as percentage of close price
// @param maType Custom series type
// @param length Moving Average Length
// @param useTrueRange Use true range for atr calculation instead of just high/low difference
// @param c Candle object containing ohlc
// @returns ATR as percentage of close price for the given moving average type and length
export method atrpercent(simple CustomSeries maType = CustomSeries.SMA, simple int length, bool useTrueRange = true, Candle c = na) =>
    candle = na(c)? Candle.new() : c
    100 * maType.atr(length, useTrueRange, candle) / candle.c

// @function returns Bollinger band for custom moving average
// @param maType Custom series type
// @param length Moving Average Length
// @param multiplier Standard Deviation multiplier
// @param sticky - sticky boundaries which will only change when value is outside boundary.
// @param c Candle object containing ohlc
// @returns Bollinger band with custom moving average for given source, length and multiplier
export method bb(simple CustomSeries maType = CustomSeries.SMA, simple int length = 20, float multiplier = 2.0, simple bool sticky = false, Candle c = na) =>
    candle = na(c)? Candle.new() : c
    float middle = maType.ma(length, candle.c)
    float upper = middle + ta.stdev(candle.c, length) * multiplier
    float lower = middle - ta.stdev(candle.c, length) * multiplier
    [newUpper, newLower] = getStickyRange(candle.h, candle.l, upper, lower, sticky)
    upper := newUpper
    lower := newLower
    [middle, upper, lower]

// @function returns Bollinger bandwidth for custom moving average
// @param maType Custom series type
// @param length Moving Average Length
// @param multiplier Standard Deviation multiplier
// @param sticky sticky boundaries which will only change when value is outside boundary.
// @param c Candle object containing ohlc
// @returns Bollinger Bandwidth for custom moving average for given source, length and multiplier
export method bbw(simple CustomSeries maType = CustomSeries.SMA, simple int length = 20, float multiplier = 2.0, simple bool sticky = false, Candle c = na) =>
    [middle, upper, lower] = maType.bb(length, multiplier, sticky, c)
    bandwidth(middle, upper, lower)

// @function returns Bollinger Percent B for custom moving average
// @param maType Custom series type
// @param length Moving Average Length
// @param multiplier Standard Deviation multiplier
// @param sticky - sticky boundaries which will only change when value is outside boundary.
// @param c Candle object containing ohlc
// @returns Bollinger Percent B for custom moving average for given source, length and multiplier
export method bpercentb(simple CustomSeries maType = CustomSeries.SMA, simple int length = 20, float multiplier = 2.0, simple bool sticky = false, Candle c = na) =>
    candle = na(c)? Candle.new() : c
    [middle, upper, lower] = maType.bb(length, multiplier, sticky, candle)
    percentb(candle.c, upper, lower)

// @function returns Keltner Channel for custom moving average
// @param maType Custom series type
// @param length Moving Average Length
// @param multiplier Standard Deviation multiplier
// @param useTrueRange - if set to false, uses high-low.
// @param sticky - sticky boundaries which will only change when value is outside boundary.
// @param c Candle object containing ohlc
// @returns Keltner Channel for custom moving average for given souce, length and multiplier
export method kc(simple CustomSeries maType = CustomSeries.EMA, simple int length = 20, float multiplier = 2, simple bool useTrueRange = true, simple bool sticky = false, Candle c = na) =>
    candle = na(c)? Candle.new() : c
    float middle = maType.ma(length, candle.c)
    float span = useTrueRange ? ta.tr : high - low
    float rangeMa = maType.atr(length, useTrueRange, candle)
    float upper = middle + rangeMa * multiplier
    float lower = middle - rangeMa * multiplier
    [newUpper, newLower] = getStickyRange(high, low, upper, lower, sticky)
    upper := newUpper
    lower := newLower
    [middle, upper, lower]

// @function returns Keltner Channel Width with custom moving average
// @param maType Custom series type
// @param length Moving Average Length
// @param multiplier Standard Deviation multiplier
// @param useTrueRange - if set to false, uses high-low.
// @param sticky - sticky boundaries which will only change when value is outside boundary.
// @param c Candle object containing ohlc
// @returns Keltner Channel Width for custom moving average
export method kcw(simple CustomSeries maType = CustomSeries.EMA, simple int length = 20, float multiplier = 2, simple bool useTrueRange = true, simple bool sticky = false, Candle c = na) =>
    [middle, upper, lower] = maType.kc(length, multiplier, useTrueRange, sticky, c)
    bandwidth(middle, upper, lower)

// @function returns Keltner Channel Percent K Width with custom moving average
// @param maType Custom series type
// @param length Moving Average Length
// @param multiplier Standard Deviation multiplier
// @param useTrueRange - if set to false, uses high-low.
// @param sticky - sticky boundaries which will only change when value is outside boundary.
// @param c Candle object containing ohlc
// @returns Keltner Percent K for given moving average, source, length and multiplier
export method kpercentk(simple CustomSeries maType = CustomSeries.EMA, simple int length = 20, float multiplier = 2, simple bool useTrueRange = true, simple bool sticky = false, Candle c = na) =>
    candle = na(c)? Candle.new() : c
    [middle, upper, lower] = maType.kc(length, multiplier, useTrueRange, sticky, candle)
    percentb(candle.c, upper, lower)

// @function returns Custom Donchian Channel
// @param c Candle object containing ohlc
// @param length - donchian channel length
// @param sticky - sticky boundaries which will only change when value is outside boundary.
// @returns Donchian channel
export method dc(Candle c = na, simple int length = 20, simple bool sticky = false) =>
    candle = na(c)? Candle.new() : c
    [upper, lower] = getStickyRange(candle.h, candle.l, ta.highest(candle.h, length), ta.lowest(candle.l, length), sticky)
    middle = (upper + lower) / 2
    [middle, upper, lower]

// @function returns Donchian Channel Width
// @param c Candle object containing ohlc
// @param length - donchian channel length
// @param sticky - sticky boundaries which will only change when value is outside boundary.
// @returns Donchian channel width
export method dcw(Candle c = na, simple int length = 20, simple bool sticky = false) =>
    [middle, upper, lower] = c.dc(length, sticky)
    bandwidth(middle, upper, lower)

// @function returns Donchian Channel Percent of price
// @param c Candle object containing ohlc
// @param length - donchian channel length
// @param sticky - sticky boundaries which will only change when value is outside boundary.
// @returns Donchian channel Percent D
export method dpercentd(Candle c = na, simple int length = 20, simple bool sticky = false) =>
    candle = na(c)? Candle.new() : c
    [middle, upper, lower] = candle.dc(length, sticky)
    percentb(candle.c, upper, lower)

// @function supertrend Simple supertrend based on atr but also takes into consideration of custom MA Type, sources
// @param maType Custom Series
// @param length ATR Length
// @param multiplier ATR Multiplier
// @param useTrueRange - if set to false, uses high-low.
// @param waitForClose : Considers source for direction change crossover if checked. Else, uses highSource and lowSource.
// @param delayed : if set to true lags supertrend atr stop based on target levels.
// @param c Candle object containing ohlc
// @returns dir : Supertrend direction
//          supertrend : BuyStop if direction is 1 else SellStop
export method supertrend(simple CustomSeries maType, simple int length, simple float multiplier, simple bool useTrueRange = true,
                                                     simple bool waitForClose = false, simple bool delayed = false, Candle c = na) =>
    candle = na(c)? Candle.new() : c
    atrDiff = maType.atr(length, useTrueRange, candle) * multiplier
    var buyStop = candle.l - atrDiff
    var sellStop = candle.h + atrDiff
    var dir = 1

    buyStopCurrent = candle.l - atrDiff
    sellStopCurrent = candle.h + atrDiff

    buyStopInverse = candle.l - atrDiff / 2
    sellStopInverse = candle.h + atrDiff / 2

    highConfirmation = waitForClose ? candle.c : candle.h
    lowConfirmation = waitForClose ? candle.c : candle.l
    dir := dir == 1 and lowConfirmation[1] < buyStop[1] ? -1 : dir == -1 and highConfirmation[1] > sellStop[1] ? 1 : dir
    targetReached = dir == 1 and nz(highConfirmation[1]) >= nz(sellStop[1]) or dir == -1 and nz(lowConfirmation[1]) <= nz(buyStop[1]) or not delayed
    buyStop := dir == 1 ? targetReached ? math.max(nz(buyStop, buyStopCurrent), buyStopCurrent) : buyStop : targetReached ? buyStopCurrent : math.max(nz(buyStop, buyStopInverse), buyStopInverse)
    sellStop := dir == -1 ? targetReached ? math.min(nz(sellStop, sellStopCurrent), sellStopCurrent) : sellStop : targetReached ? sellStopCurrent : math.min(nz(sellStop, sellStopInverse), sellStopInverse)
    [dir, dir > 0 ? buyStop : sellStop]

// @function oscillatorRange - returns Custom overbought/oversold areas for an oscillator input
// @param source - Osillator source such as RSI, COG etc.
// @param seriesType - Custom series type
// @param highlowLength - length on which highlow of the oscillator is calculated
// @param rangeLength - length used for calculating oversold/overbought range - usually same as oscillator length
// @param sticky - overbought, oversold levels won't change unless crossed
// @returns Dynamic overbought and oversold range for oscillator input
export method oscillatorRange(simple CustomSeries seriesType, float source, simple int highlowLength = 50, simple int rangeLength = 14, simple bool sticky = false) =>
    oscillatorHighest = customseries(source, CustomSeries.HIGH, highlowLength)
    oscillatorLowest = customseries(source, CustomSeries.LOW, highlowLength)

    oscOverbought = customseries(oscillatorHighest, seriesType == CustomSeries.HIGHLOW ? CustomSeries.LOW : seriesType, rangeLength)
    oscOversold = customseries(oscillatorLowest, seriesType == CustomSeries.HIGHLOW ? CustomSeries.HIGH : seriesType, rangeLength)

    getStickyRange(source, source, oscOverbought, oscOversold, sticky)

//@enum Oscillator types
//@field CCI commodity channel index
//@field CMO Chande Momentum oscillator
//@field COG center of gravity
//@field MFI money flow index
//@field ROC rate of change
//@field RSI relative strength index
//@field STOCH stochasic oscillator
//@field TSI true strength index
//@field WPR Williams %R Oscillator
export enum OscillatorType
    CCI
    CMO
    COG
    MFI
    ROC
    RSI
    STOCH
    TSI
    WPR

// @function oscillator - returns Choice of oscillator with custom overbought/oversold range
// @param oscillatorType OscillatorType object
// @param length - Oscillator length - not used for TSI
// @param shortLength - shortLength only used for TSI
// @param longLength - longLength only used for TSI
// @param c Candle object containing ohlc
// @returns Oscillator value
export method oscillator(simple OscillatorType oscillatorType = OscillatorType.RSI, simple int length = 14, simple int shortLength = 13, simple int longLength = 25, Candle c = na) =>
    candle = na(c)? Candle.new() : c
    switch oscillatorType
        OscillatorType.CCI => ta.cci(candle.c, length)
        OscillatorType.CMO => ta.cmo(candle.c, length)
        OscillatorType.COG => ta.cog(candle.c, length)
        OscillatorType.MFI => ta.mfi(candle.c, length)
        OscillatorType.ROC => ta.roc(candle.c, length)
        OscillatorType.RSI => ta.rsi(candle.c, length)
        OscillatorType.STOCH => ta.stoch(candle.c, candle.h, candle.l, length)
        OscillatorType.TSI => ta.tsi(candle.c, shortLength, longLength)
        OscillatorType.WPR => ta.wpr(length)
        => ta.rsi(candle.c, length)


// @function oscillatorWithRange - returns Choice of oscillator with custom overbought/oversold range
// @param oscillatorType OscillatorType object
// @param length - Oscillator length - not used for TSI
// @param shortLength - shortLength only used for TSI
// @param longLength - longLength only used for TSI
// @param seriesType - CustomSeries enum type
// @param highlowLength - length on which highlow of the oscillator is calculated
// @param sticky - overbought, oversold levels won't change unless crossed
// @param c Candle object containing ohlc
// @returns Oscillator value along with dynamic overbought and oversold range for oscillator input
export method oscillatorWithRange(simple OscillatorType oscillatorType = OscillatorType.RSI, simple int length = 14, simple int shortLength = 13, simple int longLength = 25,
                     simple CustomSeries seriesType = CustomSeries.HIGHLOW, simple int highlowLength = 50, simple bool sticky = false, Candle c = na) =>
    oscillator = oscillatorType.oscillator(length, shortLength, longLength, c)
    [overbought, oversold] = seriesType.oscillatorRange(oscillator, highlowLength, length, sticky)
    [oscillator, overbought, oversold]


