//@version=6
indicator("Balanced Demand Supply", overlay=true, max_labels_count=500)

balRsiLength  = input.int(14, "RSI Length", minval=2)
balPivotBars  = input.int(3, "Pivot Strength", minval=1)
balDemandRsi  = input.float(45.0, "Demand RSI")
balSupplyRsi  = input.float(55.0, "Supply RSI")

balVolumeLen  = input.int(20, "Volume Average", minval=2)
balVolumeMult = input.float(1.05, "Volume Expansion", step=0.05)

balAtrLength  = input.int(14, "ATR Length", minval=2)
balAtrMove    = input.float(0.60, "ATR Move Away", step=0.1)

balWickRatio  = input.float(0.25, "Minimum Wick Ratio", step=0.05)
balStrongWick = input.float(0.40, "Strong Wick Ratio", step=0.05)
balMinGap     = input.int(6, "Minimum Signal Gap", minval=1)

balRsi = ta.rsi(close, balRsiLength)
balAtr = ta.atr(balAtrLength)
balAvgVolume = ta.sma(volume, balVolumeLen)

balPivotHigh = ta.pivothigh(high, balPivotBars, balPivotBars)
balPivotLow  = ta.pivotlow(low, balPivotBars, balPivotBars)

balRange = math.max(
     high[balPivotBars] - low[balPivotBars],
     syminfo.mintick)

balLowerWick = math.min(
     open[balPivotBars],
     close[balPivotBars]) - low[balPivotBars]

balUpperWick = high[balPivotBars] - math.max(
     open[balPivotBars],
     close[balPivotBars])

balLowerWickRatio = balLowerWick / balRange
balUpperWickRatio = balUpperWick / balRange

balVolumeOk =
     volume[balPivotBars] >=
     balAvgVolume[balPivotBars] * balVolumeMult

balDemandConfirmation =
     balVolumeOk or balLowerWickRatio >= balStrongWick

balSupplyConfirmation =
     balVolumeOk or balUpperWickRatio >= balStrongWick

balBullMove =
     close - low[balPivotBars] >=
     balAtr[balPivotBars] * balAtrMove

balBearMove =
     high[balPivotBars] - close >=
     balAtr[balPivotBars] * balAtrMove

balDemandRaw =
     not na(balPivotLow) and
     balRsi[balPivotBars] <= balDemandRsi and
     balLowerWickRatio >= balWickRatio and
     balDemandConfirmation and
     balBullMove

balSupplyRaw =
     not na(balPivotHigh) and
     balRsi[balPivotBars] >= balSupplyRsi and
     balUpperWickRatio >= balWickRatio and
     balSupplyConfirmation and
     balBearMove

var int balLastDemand = na
var int balLastSupply = na

balDemandSignal =
     balDemandRaw and
     (na(balLastDemand) or
     bar_index - balPivotBars - balLastDemand >= balMinGap)

balSupplySignal =
     balSupplyRaw and
     (na(balLastSupply) or
     bar_index - balPivotBars - balLastSupply >= balMinGap)

balDate =
     str.format_time(
     time[balPivotBars],
     "dd-MM",
     syminfo.timezone)

if balDemandSignal
    balLastDemand := bar_index - balPivotBars
    label.new(
         bar_index - balPivotBars,
         balPivotLow,
         "D @ " +
         str.tostring(balPivotLow, format.mintick) +
         " " + balDate,
         xloc=xloc.bar_index,
         yloc=yloc.price,
         style=label.style_label_up,
         color=color.green,
         textcolor=color.white,
         size=size.small)

if balSupplySignal
    balLastSupply := bar_index - balPivotBars
    label.new(
         bar_index - balPivotBars,
         balPivotHigh,
         "S @ " +
         str.tostring(balPivotHigh, format.mintick) +
         " " + balDate,
         xloc=xloc.bar_index,
         yloc=yloc.price,
         style=label.style_label_down,
         color=color.red,
         textcolor=color.white,
         size=size.small)

alertcondition(balDemandSignal, "Demand", "Demand on {{ticker}}")
alertcondition(balSupplySignal, "Supply", "Supply on {{ticker}}")