//@version=5
indicator("Liquidity Grab Detector (Stop Hunt Sniper) v2.2", overlay=true, max_lines_count=500)

// === Inputs ===
lookbackBars = input.int(10, "Lookback for High/Low", minval=2)
volumeMult = input.float(1.5, "Volume Spike Multiplier", minval=0.1)
useCloseConfirmation = input.bool(true, "Confirm by Close Back Inside")
emaLength = input.int(50, "EMA Filter Length")
minRetrace = input.float(0.2, "Min Retrace (0-1)")
adxLen = input.int(14, "ADX Length")
adxMax = input.float(25, "Max ADX for valid signal")

// === Extremes ===
prevHigh = ta.highest(high[1], lookbackBars)
prevLow = ta.lowest(low[1], lookbackBars)

// === Volume Spike ===
volSMA = ta.sma(volume, lookbackBars)
volSpike = volume > volSMA * volumeMult

// === EMA Filter (Trend Direction) ===
ema50 = ta.ema(close, emaLength)
trendUp = close > ema50
trendDown = close < ema50

// === ADX Filter ===
[plusDI, minusDI, adx] = ta.dmi(adxLen, adxLen)
lowTrend = adx < adxMax

// === Signals (Trend Direction enforced) ===
bearHunt = high > prevHigh and (useCloseConfirmation ? close < prevHigh - (high - prevHigh) * minRetrace : true) and volSpike and lowTrend and trendDown
bullHunt = low < prevLow and (useCloseConfirmation ? close > prevLow + (prevLow - low) * minRetrace : true) and volSpike and lowTrend and trendUp

// === Plots ===
plot(ema50, "EMA 50", color=color.orange)
plotshape(bearHunt, title="Bearish Liquidity Grab", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="LG⬇")
plotshape(bullHunt, title="Bullish Liquidity Grab", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, text="LG⬆")

// === Alerts ===
alertcondition(bearHunt, title="Bearish Liquidity Grab", message="Bearish Liquidity Grab (Stop Hunt) detected")
alertcondition(bullHunt, title="Bullish Liquidity Grab", message="Bullish Liquidity Grab (Stop Hunt) detected")
