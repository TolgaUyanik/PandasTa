//@version=6
indicator("VWAP MACD Alerts", overlay=true)

// --- 1. VWAP Calculation Variables ---
cumulativePeriod = input.int(14, "VWAP Period")
typicalPrice = (high + low + close) / 3
typicalPriceVolume = typicalPrice * volume
cumulativeTypicalPriceVolume = math.sum(typicalPriceVolume, cumulativePeriod)
cumulativeVolume = math.sum(volume, cumulativePeriod)
vwapValue = cumulativeTypicalPriceVolume / cumulativeVolume

// Plot VWAP on the chart
plot(vwapValue, title="VWAP", color=color.orange, linewidth=2)

// --- 2. MACD Calculation Filter ---
fastLength = input.int(12, "MACD Fast Length")
slowLength = input.int(26, "MACD Slow Length")
signalLength = input.int(9, "MACD Signal Length")

// Standard MACD mathematical components
fastMA = ta.ema(close, fastLength)
slowMA = ta.ema(close, slowLength)
macdLine = fastMA - slowMA
signalLine = ta.ema(macdLine, signalLength)

// Define "MACD in the green" (MACD Line above Signal Line)
macdIsGreen = macdLine > signalLine

// --- 3. Filtered Crossover Conditions ---
// Core crossover calculation rule components
rawCrossUp = ta.crossover(close, vwapValue)
crossDown = ta.crossunder(close, vwapValue)

// Apply the MACD green filter rule exclusively to the upward signal
crossUp = rawCrossUp and macdIsGreen

// --- 4. Visual Shapes on Chart ---
plotshape(crossUp, title="Cross Up (MACD Filtered)", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)
plotshape(crossDown, title="Cross Down Shape", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)

// --- 5. Alert Conditions for TradingView V6 ---
if crossUp
    alert("yes", alert.freq_once_per_bar_close)

if crossDown
    alert("no", alert.freq_once_per_bar_close)
