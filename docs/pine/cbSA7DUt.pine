library("MahjongCoreEngine", overlay=false)

// ==========================================
// 0. 全牌リスト取得関数（スコープエラー回避のため内部定義）
// ==========================================
export get_all_tiles() => 
    array.from(
         "🀇","🀈","🀉","🀊","🀋","🀌","🀍","🀎","🀏", // 萬子 0-8
         "🀙","🀚","🀛","🀜","🀝","🀞","🀟","🀠","🀡", // 筒子 9-17
         "🀐","🀑","🀒","🀓","🀔","🀕","🀖","🀗","🀘", // 索子 18-26
         "🀀","🀁","🀂","🀃","🀄","🀅","🀆"            // 字牌 27-33
     )

// ==========================================
// 1. 牌のインデックス変換ヘルパー
// ==========================================
export tile_to_index(string tile) =>
    array.indexof(get_all_tiles(), tile)

export hand_to_counts(string[] hand) =>
    int[] counts = array.new_int(34, 0)
    string[] all_t = get_all_tiles()
    for t in hand
        int idx = array.indexof(all_t, t)
        if idx >= 0
            array.set(counts, idx, array.get(counts, idx) + 1)
    counts

export counts_to_hand(int[] counts) =>
    string[] hand = array.new_string()
    string[] all_t = get_all_tiles()
    for i = 0 to 33
        int c = counts.get(i)
        if c > 0
            for j = 1 to c
                array.push(hand, array.get(all_t, i))
    hand

// ==========================================
// 2. 4面子1雀頭の完全判定アルゴリズム (アンロール型DFS)
// ==========================================

check_m0(int[] c) =>
    int first_idx = -1
    for i = 0 to 33
        if c.get(i) > 0
            first_idx := i
            break
    first_idx == -1 // 全て0なら成功

check_m1(int[] c) =>
    int first_idx = -1
    for i = 0 to 33
        if c.get(i) > 0
            first_idx := i
            break
            
    bool res = false
    if first_idx == -1
        res := true
    else
        // 刻子テスト
        if c.get(first_idx) >= 3
            c.set(first_idx, c.get(first_idx) - 3)
            if check_m0(c)
                res := true
            c.set(first_idx, c.get(first_idx) + 3)
            
        // 順子テスト
        if not res and first_idx < 27 and first_idx % 9 <= 6
            if c.get(first_idx + 1) > 0 and c.get(first_idx + 2) > 0
                c.set(first_idx, c.get(first_idx) - 1)
                c.set(first_idx + 1, c.get(first_idx + 1) - 1)
                c.set(first_idx + 2, c.get(first_idx + 2) - 1)
                if check_m0(c)
                    res := true
                c.set(first_idx, c.get(first_idx) + 1)
                c.set(first_idx + 1, c.get(first_idx + 1) + 1)
                c.set(first_idx + 2, c.get(first_idx + 2) + 1)
    res

check_m2(int[] c) =>
    int first_idx = -1
    for i = 0 to 33
        if c.get(i) > 0
            first_idx := i
            break
            
    bool res = false
    if first_idx == -1
        res := true
    else
        if c.get(first_idx) >= 3
            c.set(first_idx, c.get(first_idx) - 3)
            if check_m1(c)
                res := true
            c.set(first_idx, c.get(first_idx) + 3)
            
        if not res and first_idx < 27 and first_idx % 9 <= 6
            if c.get(first_idx + 1) > 0 and c.get(first_idx + 2) > 0
                c.set(first_idx, c.get(first_idx) - 1)
                c.set(first_idx + 1, c.get(first_idx + 1) - 1)
                c.set(first_idx + 2, c.get(first_idx + 2) - 1)
                if check_m1(c)
                    res := true
                c.set(first_idx, c.get(first_idx) + 1)
                c.set(first_idx + 1, c.get(first_idx + 1) + 1)
                c.set(first_idx + 2, c.get(first_idx + 2) + 1)
    res

check_m3(int[] c) =>
    int first_idx = -1
    for i = 0 to 33
        if c.get(i) > 0
            first_idx := i
            break
            
    bool res = false
    if first_idx == -1
        res := true
    else
        if c.get(first_idx) >= 3
            c.set(first_idx, c.get(first_idx) - 3)
            if check_m2(c)
                res := true
            c.set(first_idx, c.get(first_idx) + 3)
            
        if not res and first_idx < 27 and first_idx % 9 <= 6
            if c.get(first_idx + 1) > 0 and c.get(first_idx + 2) > 0
                c.set(first_idx, c.get(first_idx) - 1)
                c.set(first_idx + 1, c.get(first_idx + 1) - 1)
                c.set(first_idx + 2, c.get(first_idx + 2) - 1)
                if check_m2(c)
                    res := true
                c.set(first_idx, c.get(first_idx) + 1)
                c.set(first_idx + 1, c.get(first_idx + 1) + 1)
                c.set(first_idx + 2, c.get(first_idx + 2) + 1)
    res

check_m4(int[] c) =>
    int first_idx = -1
    for i = 0 to 33
        if c.get(i) > 0
            first_idx := i
            break
            
    bool res = false
    if first_idx == -1
        res := true
    else
        if c.get(first_idx) >= 3
            c.set(first_idx, c.get(first_idx) - 3)
            if check_m3(c)
                res := true
            c.set(first_idx, c.get(first_idx) + 3)
            
        if not res and first_idx < 27 and first_idx % 9 <= 6
            if c.get(first_idx + 1) > 0 and c.get(first_idx + 2) > 0
                c.set(first_idx, c.get(first_idx) - 1)
                c.set(first_idx + 1, c.get(first_idx + 1) - 1)
                c.set(first_idx + 2, c.get(first_idx + 2) - 1)
                if check_m3(c)
                    res := true
                c.set(first_idx, c.get(first_idx) + 1)
                c.set(first_idx + 1, c.get(first_idx + 1) + 1)
                c.set(first_idx + 2, c.get(first_idx + 2) + 1)
    res

export is_standard_form(int[] counts) =>
    bool has_win = false
    
    // 合計枚数が「14枚」等のアガリ形 (3n + 2) に合致するか
    int total_tiles = array.sum(counts)
    if total_tiles % 3 != 2
        has_win := false
    else
        // 雀頭の候補を試行
        for p = 0 to 33
            if counts.get(p) >= 2
                int[] temp = array.copy(counts)
                temp.set(p, temp.get(p) - 2)
                
                // 最大4面子のアンロール判定を実行
                if check_m4(temp)
                    has_win := true
                    break
                    
    has_win