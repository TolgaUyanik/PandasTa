//@version=6
indicator('10AM & 10PM Open Levels', overlay = true, max_lines_count = 500, max_labels_count = 500)

//━━━━━━━━━━━━━━━━━━━
// Inputs
//━━━━━━━━━━━━━━━━━━━
tz = input.string('America/New_York', 'Timezone')

show10AM = input.bool(true, 'Show 10 AM Open')
show10PM = input.bool(true, 'Show 10 PM Open')

lineLength = input.int(100, 'Line Length In Bars', minval = 1, maxval = 500)

color10AM = input.color(color.lime, '10 AM Line Color')
color10PM = input.color(color.red, '10 PM Line Color')

lineWidth = input.int(2, 'Line Width', minval = 1, maxval = 5)
lineStyleInput = input.string('Solid', 'Line Style', options = ['Solid', 'Dashed', 'Dotted'])

showLabels = input.bool(true, 'Show Labels')
labelTextColor = input.color(color.white, 'Label Text Color')
labelBg10AM = input.color(color.new(color.lime, 0), '10 AM Label Background')
labelBg10PM = input.color(color.new(color.red, 0), '10 PM Label Background')

keepPrevious = input.bool(true, 'Keep Previous Opens')
maxLevels = input.int(20, 'Max Previous Levels', minval = 1, maxval = 100)

//━━━━━━━━━━━━━━━━━━━
// Line style converter
//━━━━━━━━━━━━━━━━━━━
lineStyle = lineStyleInput == 'Dashed' ? line.style_dashed : lineStyleInput == 'Dotted' ? line.style_dotted : line.style_solid

//━━━━━━━━━━━━━━━━━━━
// Arrays
//━━━━━━━━━━━━━━━━━━━
var array<line> openLines = array.new_line()
var array<label> openLabels = array.new_label()

//━━━━━━━━━━━━━━━━━━━
// Time detection
//━━━━━━━━━━━━━━━━━━━
barHour = hour(time, tz)
barMinute = minute(time, tz)

is10AM = barHour == 10 and barMinute == 0
is10PM = barHour == 22 and barMinute == 0

//━━━━━━━━━━━━━━━━━━━
// Function to draw open level
//━━━━━━━━━━━━━━━━━━━
drawOpenLevel(_price, _color, _text, _labelBg) =>
    if not keepPrevious
        for i = 0 to array.size(openLines) - 1 by 1
            line.delete(array.get(openLines, i))
        for i = 0 to array.size(openLabels) - 1 by 1
            label.delete(array.get(openLabels, i))
        array.clear(openLines)
        array.clear(openLabels)

    newLine = line.new(x1 = bar_index, y1 = _price, x2 = bar_index + lineLength, y2 = _price, xloc = xloc.bar_index, extend = extend.none, color = _color, width = lineWidth, style = lineStyle)

    array.push(openLines, newLine)

    if showLabels
        newLabel = label.new(x = bar_index + lineLength, y = _price, text = _text + ' Open', xloc = xloc.bar_index, style = label.style_label_left, textcolor = labelTextColor, color = _labelBg, size = size.small)

        array.push(openLabels, newLabel)

    while array.size(openLines) > maxLevels
        oldLine = array.shift(openLines)
        line.delete(oldLine)

    while array.size(openLabels) > maxLevels
        oldLabel = array.shift(openLabels)
        label.delete(oldLabel)

//━━━━━━━━━━━━━━━━━━━
// Draw levels
//━━━━━━━━━━━━━━━━━━━
if show10AM and is10AM
    drawOpenLevel(open, color10AM, '10 AM', labelBg10AM)

if show10PM and is10PM
    drawOpenLevel(open, color10PM, '10 PM', labelBg10PM)
