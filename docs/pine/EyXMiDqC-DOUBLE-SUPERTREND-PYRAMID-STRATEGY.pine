// This source code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// STRATEGY: DOUBLE SUPERTREND PYRAMID STRATEGY
// Built on top of "Double Supertrend HTF Filter" (c) Harrocop
//
// CHANGE LOG (this revision):
// - Renamed strategy.
// - Every pyramid type now has its OWN entry id and its OWN strategy.exit,
//   so each type is closed independently instead of sharing one exit call.
// - Added Master Pyramid TP/SL/Trailing override switch: when ON it overrides
//   every individual pyramid type's exit settings; when OFF each type runs
//   its own TP/SL/Trailing (or none, if left at 0).
// - Added per-type: max contracts added per course, max signals per course,
//   delay between signals (seconds), minimum distance before next add
//   (Multiplier-of-ATR / Percent / Ticks / Points / Dollar).
// - Added master "Max Total Contract Signals Allowed Per Plotted Course".
// - Added master "Enable Tiered Exit System" checkbox.
// - Fixed a trail_points/trail_offset swap bug in the tiered exits.
// - Added on-chart debug labels for every actual order fill (entries, tier
//   exits, course exit, protective stop, volatility exit, reversals) so you
//   can see exactly what closed a position and why.
// - Session timezone is now a dropdown of common IANA zones (incl. UTC).
// - New defaults: Supertrend 1 = 1min/ATR10/Factor3, Supertrend 2 = 2min/ATR10/Factor3,
//   Max Reversals Per Course = 2.
// - Removed the old "Z-Score/Student-T" pyramid type entirely (redundant with
//   the Error-Function One-Tailed Test type). Pyramid types renumbered 1-8.
//
// NOTE: still a large, feature-dense script - validate every group in the
// Pine Editor / Strategy Tester before trusting it live.

//@version=6
strategy(title = "DOUBLE SUPERTREND PYRAMID STRATEGY", shorttitle = "DBLST-PYR", overlay = true, initial_capital = 100000, default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 30, calc_on_every_tick = true, process_orders_on_close = true, max_bars_back = 2000, currency = currency.USD, margin_long = 0, margin_short = 0)

tick = syminfo.mintick

// =========================================================================
// SECTION 1: TRADE DIRECTION
// =========================================================================
grpDir = "1) Trade Direction"
tradeDirection = input.string(defval = "Both", title = "Allowed Direction", options = ["Long Only", "Short Only", "Both"], group = grpDir, tooltip = "When 'Both' is selected the strategy runs continuously and will flip / re-enter at each new plotting course when trend direction changes.")

allowLong  = tradeDirection == "Long Only"  or tradeDirection == "Both"
allowShort = tradeDirection == "Short Only" or tradeDirection == "Both"

// =========================================================================
// SECTION 2: SESSION / TIME WINDOW FILTER
// =========================================================================
grpTime = "2) Session Time Filter"
useTimeFilter   = input.bool(true, title = "Enable Trading Time Window?", group = grpTime)
sessionString   = input.session(defval = "0930-1600", title = "Trading Time Window", group = grpTime, tooltip = "When unchecked above, the strategy runs continuously with no time restriction.")
sessionTZ       = input.string(defval = "America/New_York", title = "Session Timezone", options = ["UTC", "America/New_York", "America/Chicago", "America/Denver", "America/Los_Angeles", "America/Sao_Paulo", "Europe/London", "Europe/Berlin", "Europe/Moscow", "Africa/Johannesburg", "Asia/Dubai", "Asia/Kolkata", "Asia/Shanghai", "Asia/Singapore", "Asia/Tokyo", "Australia/Sydney", "Pacific/Auckland"], group = grpTime)
closeAtSessionEnd = input.bool(true, title = "Close All Positions At End Of Time Window?", group = grpTime)

inSession = not useTimeFilter or not na(time(timeframe.period, sessionString, sessionTZ))
sessionActive     = useTimeFilter ? inSession : true
sessionEndThisBar = useTimeFilter and sessionActive[1] and not sessionActive

// =========================================================================
// SECTION 3: MASTER DAILY RISK (TAKE PROFIT / MAX LOSS) & CONTRACT LIMIT
// =========================================================================
grpRisk = "3) Master Daily Risk / Position Limits"
useDailyTP   = input.bool(false, title = "Enable Master Daily Take Profit ($)", inline = "dtp", group = grpRisk)
dailyTPUSD   = input.float(defval = 500.0, title = "Amount ($)", minval = 0.0, inline = "dtp", group = grpRisk)
useDailyMaxLoss = input.bool(false, title = "Enable Master Daily Max Loss ($)", inline = "dml", group = grpRisk)
dailyMaxLossUSD = input.float(defval = 500.0, title = "Amount ($)", minval = 0.0, inline = "dml", group = grpRisk)
useMaxContracts = input.bool(true, title = "Enable Max Contract Position Limit", inline = "mc", group = grpRisk)
maxContracts    = input.int(defval = 5, title = "Max Contracts Per Trade (incl. pyramids)", minval = 1, inline = "mc", group = grpRisk)

var float dayStartEquity = na
var bool  dailyHalt      = false
newDay = ta.change(time("D")) != 0
if newDay
    dayStartEquity := strategy.equity
    dailyHalt := false

dayPnL = strategy.equity - nz(dayStartEquity, strategy.equity)
if useDailyTP and dayPnL >= dailyTPUSD
    dailyHalt := true
if useDailyMaxLoss and dayPnL <= -dailyMaxLossUSD
    dailyHalt := true

canTrade = sessionActive and not dailyHalt

// =========================================================================
// SECTION 4: SUPERTREND HTF 1
// =========================================================================
grpST1 = "4) Supertrend HTF 1"
useSupertrend1 = input.bool(true, title = "Plot Supertrend 1?", inline = "st1a", group = grpST1)
tfSupertrend1  = input.timeframe(defval = "1", title = "Higher Time Frame", inline = "st1a", group = grpST1)
atrLen1        = input.int(defval = 10, title = "ATR Length", minval = 1, maxval = 1000, step = 1, inline = "st1b", group = grpST1)
factor1        = input.float(defval = 3.0, title = "ATR Factor", minval = 0.1, maxval = 10.0, step = 0.1, inline = "st1b", group = grpST1)

[supertrend1Raw, direction1Raw] = ta.supertrend(factor1, atrLen1)
supertrendHTF1 = request.security(syminfo.tickerid, tfSupertrend1, supertrend1Raw, barmerge.gaps_off, barmerge.lookahead_off)
directionHTF1  = request.security(syminfo.tickerid, tfSupertrend1, direction1Raw, barmerge.gaps_off, barmerge.lookahead_off)

// =========================================================================
// SECTION 5: SUPERTREND HTF 2
// =========================================================================
grpST2 = "5) Supertrend HTF 2"
useSupertrend2 = input.bool(true, title = "Plot Supertrend 2?", inline = "st2a", group = grpST2)
tfSupertrend2  = input.timeframe(defval = "2", title = "Higher Time Frame", inline = "st2a", group = grpST2)
atrLen2        = input.int(defval = 10, title = "ATR Length", minval = 1, maxval = 1000, step = 1, inline = "st2b", group = grpST2)
factor2        = input.float(defval = 3.0, title = "ATR Factor", minval = 0.1, maxval = 10.0, step = 0.1, inline = "st2b", group = grpST2)

[supertrend2Raw, direction2Raw] = ta.supertrend(factor2, atrLen2)
supertrendHTF2 = request.security(syminfo.tickerid, tfSupertrend2, supertrend2Raw, barmerge.gaps_off, barmerge.lookahead_off)
directionHTF2  = request.security(syminfo.tickerid, tfSupertrend2, direction2Raw, barmerge.gaps_off, barmerge.lookahead_off)

colorHTF1 = directionHTF1 < 0 ? color.new(color.green, 0) : color.new(color.red, 0)
colorHTF2 = directionHTF2 < 0 ? color.new(color.lime, 20) : color.new(color.maroon, 20)
plot(useSupertrend1 ? supertrendHTF1 : na, title = "Supertrend HTF 1", color = colorHTF1, linewidth = 1)
plot(useSupertrend2 ? supertrendHTF2 : na, title = "Supertrend HTF 2", color = colorHTF2, linewidth = 1, style = plot.style_line)

alignUp    = directionHTF1 < 0 and directionHTF2 < 0
alignDown  = directionHTF1 > 0 and directionHTF2 > 0

var int coursesDirection = 0
newUpCourse   = alignUp   and coursesDirection != 1
newDownCourse = alignDown and coursesDirection != -1
if newUpCourse
    coursesDirection := 1
if newDownCourse
    coursesDirection := -1
newCourse = newUpCourse or newDownCourse

var int pendingDirection = 0
if newUpCourse
    pendingDirection := 1
if newDownCourse
    pendingDirection := -1

// =========================================================================
// SECTION 6: PER-PLOTTING-COURSE TAKE PROFIT / STOP LOSS (in ticks)
// NOTE: The Stop Loss value here also becomes the trigger threshold used by
// the "Reverse At Stop Loss" system in Section 7.
// =========================================================================
grpCourse = "6) Per-Plotting-Course TP / SL"
useCourseTP = input.bool(true, title = "Enable Take Profit (ticks)", inline = "ctp", group = grpCourse)
courseTPTicks = input.int(defval = 80, title = "Take Profit (ticks)", minval = 1, inline = "ctp", group = grpCourse)
useCourseSL = input.bool(true, title = "Enable Stop Loss (ticks)", inline = "csl", group = grpCourse)
courseSLTicks = input.int(defval = 40, title = "Stop Loss (ticks) - also the Reverse-At-SL threshold", minval = 1, inline = "csl", group = grpCourse)

// =========================================================================
// SECTION 7: REVERSE AT STOP LOSS
// =========================================================================
grpReverse = "7) Reverse At Stop Loss"
useReverseAtSL = input.bool(false, title = "Enable Reverse At Stop Loss", group = grpReverse, tooltip = "Uses the Per-Plotting-Course Stop Loss (Section 6) tick amount as the reversal trigger. When met, ALL positions (including tiered exits) are closed and the strategy immediately re-enters in the opposite direction, fresh, honoring the new plotting course. Does NOT affect the Pyramid system.")
maxReversalsPerCourse = input.int(defval = 2, title = "Max Reversals Allowed Per Plotting Course", minval = 1, maxval = 20, group = grpReverse)

var int reversalsThisCourse = 0
if newCourse
    reversalsThisCourse := 0

// =========================================================================
// SECTION 8: VOLATILITY EXIT
// =========================================================================
grpVol = "8) Volatility Exit"
useVolatilityExit = input.bool(false, title = "Enable Volatility Exit", group = grpVol)
volLookback   = input.int(defval = 20, title = "ATR Lookback", minval = 2, group = grpVol)
volSpikeMult  = input.float(defval = 2.0, title = "Exit When ATR Expands By (x Average ATR)", minval = 1.0, step = 0.1, group = grpVol)
volAvgLen     = input.int(defval = 50, title = "Average ATR Length", minval = 2, group = grpVol)

atrNow = ta.atr(volLookback)
atrAvg = ta.sma(atrNow, volAvgLen)
volatilityExitTriggered = useVolatilityExit and atrNow >= atrAvg * volSpikeMult

// =========================================================================
// SECTION 9: PROTECTIVE STOP (ATR)
// =========================================================================
grpProt = "9) Protective Stop (ATR)"
useProtectiveStop = input.bool(true, title = "Enable ATR Protective Stop", inline = "prot", group = grpProt)
protectiveATRLen  = input.int(defval = 14, title = "ATR Length", minval = 1, inline = "prot2", group = grpProt)
protectiveATRMult = input.float(defval = 3.0, title = "ATR Multiplier", minval = 0.1, step = 0.1, inline = "prot2", group = grpProt)

protectiveATR = ta.atr(protectiveATRLen)
longProtectiveStop  = strategy.position_avg_price - protectiveATR * protectiveATRMult
shortProtectiveStop = strategy.position_avg_price + protectiveATR * protectiveATRMult

// =========================================================================
// SECTION 10: TIERED EXITS (3 tiers, independent of pyramid system)
// Each tier is fully self-contained: Target (always active when the tier is
// enabled), plus optional Stop Loss and Trailing Stop, each with its own
// enable checkbox.
// =========================================================================
grpT1 = "10a) Tiered Exit 1"
useTier1 = input.bool(false, title = "Enable Tier 1", group = grpT1)
tier1Target    = input.int(defval = 60, title = "Tier 1 Target (ticks)", minval = 1, group = grpT1)
tier1Qty       = input.int(defval = 1,  title = "Tier 1 Quantity", minval = 1, group = grpT1)
tier1UseSL     = input.bool(false, title = "Enable Stop Loss", inline = "T1sl", group = grpT1)
tier1SL        = input.int(defval = 40, title = "Tier 1 Stop Loss (ticks)", minval = 1, inline = "T1sl", group = grpT1)
tier1UseTrail  = input.bool(false, title = "Enable Trailing Stop", inline = "T1trail", group = grpT1)
tier1Trail     = input.int(defval = 15, title = "Tier 1 Trailing Stop (ticks)", minval = 1, inline = "T1trail", group = grpT1)
tier1Threshold = input.int(defval = 20, title = "Tier 1 Trail Activation Threshold (ticks)", minval = 1, inline = "T1trail", group = grpT1)
tier1ExitAtFlip = input.bool(false, title = "Exit At Next Supertrend Plotted Course", group = grpT1, tooltip = "UNCHECKED (default): this tier's contracts only close via its own Target / Stop Loss / Trailing Stop above (or the global Volatility Exit / Protective Stop / Session / Daily limits). CHECKED: this tier's contracts are force-closed the instant the Supertrend flips to a new plotted course.")

grpT2 = "10b) Tiered Exit 2"
useTier2 = input.bool(false, title = "Enable Tier 2", group = grpT2)
tier2Target    = input.int(defval = 84, title = "Tier 2 Target (ticks)", minval = 1, group = grpT2)
tier2Qty       = input.int(defval = 1,  title = "Tier 2 Quantity", minval = 1, group = grpT2)
tier2UseSL     = input.bool(false, title = "Enable Stop Loss", inline = "T2sl", group = grpT2)
tier2SL        = input.int(defval = 40, title = "Tier 2 Stop Loss (ticks)", minval = 1, inline = "T2sl", group = grpT2)
tier2UseTrail  = input.bool(false, title = "Enable Trailing Stop", inline = "T2trail", group = grpT2)
tier2Trail     = input.int(defval = 25, title = "Tier 2 Trailing Stop (ticks)", minval = 1, inline = "T2trail", group = grpT2)
tier2Threshold = input.int(defval = 20, title = "Tier 2 Trail Activation Threshold (ticks)", minval = 1, inline = "T2trail", group = grpT2)
tier2ExitAtFlip = input.bool(false, title = "Exit At Next Supertrend Plotted Course", group = grpT2, tooltip = "UNCHECKED (default): this tier's contracts only close via its own Target / Stop Loss / Trailing Stop above (or the global Volatility Exit / Protective Stop / Session / Daily limits). CHECKED: this tier's contracts are force-closed the instant the Supertrend flips to a new plotted course.")

grpT3 = "10c) Tiered Exit 3"
useTier3 = input.bool(false, title = "Enable Tier 3", group = grpT3)
tier3Target    = input.int(defval = 100, title = "Tier 3 Target (ticks)", minval = 1, group = grpT3)
tier3Qty       = input.int(defval = 1,   title = "Tier 3 Quantity", minval = 1, group = grpT3)
tier3UseSL     = input.bool(false, title = "Enable Stop Loss", inline = "T3sl", group = grpT3)
tier3SL        = input.int(defval = 40, title = "Tier 3 Stop Loss (ticks)", minval = 1, inline = "T3sl", group = grpT3)
tier3UseTrail  = input.bool(false, title = "Enable Trailing Stop", inline = "T3trail", group = grpT3)
tier3Trail     = input.int(defval = 30,  title = "Tier 3 Trailing Stop (ticks)", minval = 1, inline = "T3trail", group = grpT3)
tier3Threshold = input.int(defval = 20, title = "Tier 3 Trail Activation Threshold (ticks)", minval = 1, inline = "T3trail", group = grpT3)
tier3ExitAtFlip = input.bool(false, title = "Exit At Next Supertrend Plotted Course", group = grpT3, tooltip = "UNCHECKED (default): this tier's contracts only close via its own Target / Stop Loss / Trailing Stop above (or the global Volatility Exit / Protective Stop / Session / Daily limits). CHECKED: this tier's contracts are force-closed the instant the Supertrend flips to a new plotted course.")

// The core "Long"/"Short" entry is what the tiers scale out of (they share
// the same entry id), so if ANY enabled tier asks to exit-at-flip, the whole
// core+tiered position closes together at the next plotted course.
coreExitAtFlip = (useTier1 and tier1ExitAtFlip) or (useTier2 and tier2ExitAtFlip) or (useTier3 and tier3ExitAtFlip)

// =========================================================================
// SHARED PYRAMID HELPERS (used by each Pyramid Type section below)
// =========================================================================
// Volatility Exit / Protective Stop ALWAYS override the pyramid system.
pyramidForceExit = volatilityExitTriggered or (useProtectiveStop and ((strategy.position_size > 0 and low <= longProtectiveStop) or (strategy.position_size < 0 and high >= shortProtectiveStop)))

f_pyrExitProfit(useOwn, ownVal) =>
    useOwn and ownVal > 0 ? ownVal : na
f_pyrExitLoss(useOwn, ownVal) =>
    useOwn and ownVal > 0 ? ownVal : na
f_pyrExitTrail(useOwn, useTrailChk, ownVal) =>
    useOwn and useTrailChk and ownVal > 0 ? ownVal : na

f_distanceOK(useMin, distType, amount, lastPrice, currentPrice, atrVal) =>
    result = true
    if useMin and not na(lastPrice)
        diff = math.abs(currentPrice - lastPrice)
        result := switch distType
            "Multiplier (ATR)" => diff >= amount * atrVal
            "Percent"          => diff >= lastPrice * (amount / 100.0)
            "Ticks"            => diff >= amount * tick
            "Points"           => diff >= amount
            "Dollar"           => diff >= amount
            => true
    result

// =========================================================================
// MATH HELPERS (self-contained - mirrors the uploaded Error Functions / KDE /
// Viterbi reference libraries, implemented inline, no external imports)
// =========================================================================
erfApprox(x) =>
    sign = x < 0 ? -1.0 : 1.0
    ax = math.abs(x)
    a1 = 0.254829592
    a2 = -0.284496736
    a3 = 1.421413741
    a4 = -1.453152027
    a5 = 1.061405429
    p  = 0.3275911
    t = 1.0 / (1.0 + p * ax)
    y = 1.0 - (((((a5 * t + a4) * t) + a3) * t + a2) * t + a1) * t * math.exp(-ax * ax)
    sign * y

normalCDF(z) =>
    0.5 * (1.0 + erfApprox(z / math.sqrt(2.0)))

oneTailedProb(z) =>
    1.0 - normalCDF(math.abs(z))

studentTOneTailedProb(t, df) =>
    dfAdj = df <= 2 ? 2.0001 : df
    correction = 1.0 + (t * t) / (4.0 * dfAdj)
    zEff = math.abs(t) / correction
    1.0 - normalCDF(zEff)

distanceATR = ta.atr(14)

// =========================================================================
// SECTION 11: PYRAMID TYPE 1: TURTLE ATR UNIT
// =========================================================================
grpPyr1 = "11) Pyramid Type 1: Turtle ATR Unit"
usePyr1 = input.bool(false, title = "Enable Turtle ATR Unit Adds", group = grpPyr1)
pyr1ATRLen   = input.int(defval = 20, title = "ATR Length (N)", minval = 1, group = grpPyr1)
pyr1UnitFrac = input.float(defval = 0.5, title = "Add Every X * N Move In Favor", minval = 0.1, step = 0.1, group = grpPyr1)

pyr1ATR = ta.atr(pyr1ATRLen)
pyr1LastEntryPrice = strategy.opentrades > 0 ? strategy.opentrades.entry_price(strategy.opentrades - 1) : na
pyr1LongTrigger  = strategy.position_size > 0 and not na(pyr1LastEntryPrice) and (close - pyr1LastEntryPrice) >= pyr1ATR * pyr1UnitFrac
pyr1ShortTrigger = strategy.position_size < 0 and not na(pyr1LastEntryPrice) and (pyr1LastEntryPrice - close) >= pyr1ATR * pyr1UnitFrac
pyr1RawTrigger = pyr1LongTrigger or pyr1ShortTrigger


pyr1_UseOwnExits = input.bool(false, title = "Enable TP/SL/Trailing For This Type", group = grpPyr1)
pyr1_ExitAtFlip = input.bool(false, title = "Exit At Next Supertrend Plotted Course", group = grpPyr1, tooltip = "UNCHECKED (default): this pyramid type's contracts only close via its own TP/SL/Trailing above (or the global Volatility Exit / Protective Stop / Session / Daily limits). CHECKED: this type's contracts are force-closed the instant the Supertrend flips to a new plotted course.")
pyr1_AddQty = input.int(defval = 1, title = "Contracts Added Per Signal", minval = 1, group = grpPyr1)
pyr1_TP    = input.int(defval = 60, title = "Take Profit (ticks, 0=off)", minval = 0, inline = "1exit", group = grpPyr1)
pyr1_SL    = input.int(defval = 30, title = "Stop Loss (ticks, 0=off)", minval = 0, inline = "1exit", group = grpPyr1)
pyr1_UseTrail = input.bool(false, title = "Enable Trailing Stop", inline = "1trail", group = grpPyr1)
pyr1_Trail = input.int(defval = 20, title = "Trailing Stop (ticks)", minval = 0, inline = "1trail", group = grpPyr1)
pyr1_MaxAddPerCourse = input.int(defval = 0, title = "Max Contracts Added Per Plotted Course (0=off)", minval = 0, inline = "1lim1", group = grpPyr1)
pyr1_MaxSignalsPerCourse = input.int(defval = 0, title = "Max Total Signals Per Plotted Course (0=off)", minval = 0, inline = "1lim1", group = grpPyr1)
pyr1_DelaySeconds = input.int(defval = 0, title = "Delay Between Signals (seconds, 0=off)", minval = 0, group = grpPyr1)
pyr1_UseMinDistance = input.bool(false, title = "Require Minimum Distance Before Next Add", inline = "1dist", group = grpPyr1)
pyr1_DistanceType = input.string(defval = "Ticks", title = "Distance Type", options = ["Multiplier (ATR)", "Percent", "Ticks", "Points", "Dollar"], inline = "1dist", group = grpPyr1)
pyr1_DistanceAmount = input.float(defval = 20.0, title = "Distance Amount", minval = 0.0, group = grpPyr1)

var int pyr1_addedThisCourse = 0
var int pyr1_signalsThisCourse = 0
var float pyr1_lastSignalTime = na
var float pyr1_lastFillPrice = na
if newCourse
    pyr1_addedThisCourse := 0
    pyr1_signalsThisCourse := 0

pyr1_CourseAddOK    = pyr1_MaxAddPerCourse <= 0 or pyr1_addedThisCourse < pyr1_MaxAddPerCourse
pyr1_CourseSignalOK = pyr1_MaxSignalsPerCourse <= 0 or pyr1_signalsThisCourse < pyr1_MaxSignalsPerCourse
pyr1_DelayOK        = pyr1_DelaySeconds <= 0 or na(pyr1_lastSignalTime) or (time - pyr1_lastSignalTime) >= pyr1_DelaySeconds * 1000
pyr1_DistOK         = f_distanceOK(pyr1_UseMinDistance, pyr1_DistanceType, pyr1_DistanceAmount, pyr1_lastFillPrice, close, distanceATR)

pyr1_CanAddContracts = not useMaxContracts or (math.abs(strategy.position_size) + pyr1_AddQty <= maxContracts)
pyr1Signal = usePyr1 and canTrade and not pyramidForceExit and pyr1_CanAddContracts and pyr1RawTrigger and pyr1_CourseAddOK and pyr1_CourseSignalOK and pyr1_DelayOK and pyr1_DistOK

if pyr1Signal and strategy.position_size > 0
    strategy.entry("Pyr1-L", strategy.long, qty = pyr1_AddQty, comment = "Pyr1 Add L")
    pyr1_addedThisCourse := pyr1_addedThisCourse + pyr1_AddQty
    pyr1_signalsThisCourse := pyr1_signalsThisCourse + 1
    pyr1_lastSignalTime := time
    pyr1_lastFillPrice := close
if pyr1Signal and strategy.position_size < 0
    strategy.entry("Pyr1-S", strategy.short, qty = pyr1_AddQty, comment = "Pyr1 Add S")
    pyr1_addedThisCourse := pyr1_addedThisCourse + pyr1_AddQty
    pyr1_signalsThisCourse := pyr1_signalsThisCourse + 1
    pyr1_lastSignalTime := time
    pyr1_lastFillPrice := close

pyr1_ExitProfit = f_pyrExitProfit(pyr1_UseOwnExits, pyr1_TP)
pyr1_ExitLoss   = f_pyrExitLoss(pyr1_UseOwnExits, pyr1_SL)
pyr1_ExitTrail  = f_pyrExitTrail(pyr1_UseOwnExits, pyr1_UseTrail, pyr1_Trail)
strategy.exit("Pyr1-ExitL", from_entry = "Pyr1-L", profit = pyr1_ExitProfit, loss = pyr1_ExitLoss, trail_points = pyr1_ExitTrail, trail_offset = pyr1_ExitTrail)
strategy.exit("Pyr1-ExitS", from_entry = "Pyr1-S", profit = pyr1_ExitProfit, loss = pyr1_ExitLoss, trail_points = pyr1_ExitTrail, trail_offset = pyr1_ExitTrail)


// =========================================================================
// SECTION 12: PYRAMID TYPE 2: SWING STRUCTURE
// =========================================================================
grpPyr2 = "12) Pyramid Type 2: Swing Structure"
usePyr2 = input.bool(false, title = "Enable Swing Structure Adds", group = grpPyr2)
pyr2SwingLen = input.int(defval = 5, title = "Swing Pivot Length (bars each side)", minval = 1, group = grpPyr2)

pyr2PivotHigh = ta.pivothigh(high, pyr2SwingLen, pyr2SwingLen)
pyr2PivotLow  = ta.pivotlow(low, pyr2SwingLen, pyr2SwingLen)
var float pyr2LastSwingHigh = na
var float pyr2LastSwingLow  = na
if not na(pyr2PivotHigh)
    pyr2LastSwingHigh := pyr2PivotHigh
if not na(pyr2PivotLow)
    pyr2LastSwingLow := pyr2PivotLow

pyr2LongTrigger  = strategy.position_size > 0 and not na(pyr2LastSwingHigh) and close > pyr2LastSwingHigh
pyr2ShortTrigger = strategy.position_size < 0 and not na(pyr2LastSwingLow)  and close < pyr2LastSwingLow
pyr2RawTrigger = pyr2LongTrigger or pyr2ShortTrigger


pyr2_UseOwnExits = input.bool(false, title = "Enable TP/SL/Trailing For This Type", group = grpPyr2)
pyr2_ExitAtFlip = input.bool(false, title = "Exit At Next Supertrend Plotted Course", group = grpPyr2, tooltip = "UNCHECKED (default): this pyramid type's contracts only close via its own TP/SL/Trailing above (or the global Volatility Exit / Protective Stop / Session / Daily limits). CHECKED: this type's contracts are force-closed the instant the Supertrend flips to a new plotted course.")
pyr2_AddQty = input.int(defval = 1, title = "Contracts Added Per Signal", minval = 1, group = grpPyr2)
pyr2_TP    = input.int(defval = 60, title = "Take Profit (ticks, 0=off)", minval = 0, inline = "2exit", group = grpPyr2)
pyr2_SL    = input.int(defval = 30, title = "Stop Loss (ticks, 0=off)", minval = 0, inline = "2exit", group = grpPyr2)
pyr2_UseTrail = input.bool(false, title = "Enable Trailing Stop", inline = "2trail", group = grpPyr2)
pyr2_Trail = input.int(defval = 20, title = "Trailing Stop (ticks)", minval = 0, inline = "2trail", group = grpPyr2)
pyr2_MaxAddPerCourse = input.int(defval = 0, title = "Max Contracts Added Per Plotted Course (0=off)", minval = 0, inline = "2lim1", group = grpPyr2)
pyr2_MaxSignalsPerCourse = input.int(defval = 0, title = "Max Total Signals Per Plotted Course (0=off)", minval = 0, inline = "2lim1", group = grpPyr2)
pyr2_DelaySeconds = input.int(defval = 0, title = "Delay Between Signals (seconds, 0=off)", minval = 0, group = grpPyr2)
pyr2_UseMinDistance = input.bool(false, title = "Require Minimum Distance Before Next Add", inline = "2dist", group = grpPyr2)
pyr2_DistanceType = input.string(defval = "Ticks", title = "Distance Type", options = ["Multiplier (ATR)", "Percent", "Ticks", "Points", "Dollar"], inline = "2dist", group = grpPyr2)
pyr2_DistanceAmount = input.float(defval = 20.0, title = "Distance Amount", minval = 0.0, group = grpPyr2)

var int pyr2_addedThisCourse = 0
var int pyr2_signalsThisCourse = 0
var float pyr2_lastSignalTime = na
var float pyr2_lastFillPrice = na
if newCourse
    pyr2_addedThisCourse := 0
    pyr2_signalsThisCourse := 0

pyr2_CourseAddOK    = pyr2_MaxAddPerCourse <= 0 or pyr2_addedThisCourse < pyr2_MaxAddPerCourse
pyr2_CourseSignalOK = pyr2_MaxSignalsPerCourse <= 0 or pyr2_signalsThisCourse < pyr2_MaxSignalsPerCourse
pyr2_DelayOK        = pyr2_DelaySeconds <= 0 or na(pyr2_lastSignalTime) or (time - pyr2_lastSignalTime) >= pyr2_DelaySeconds * 1000
pyr2_DistOK         = f_distanceOK(pyr2_UseMinDistance, pyr2_DistanceType, pyr2_DistanceAmount, pyr2_lastFillPrice, close, distanceATR)

pyr2_CanAddContracts = not useMaxContracts or (math.abs(strategy.position_size) + pyr2_AddQty <= maxContracts)
pyr2Signal = usePyr2 and canTrade and not pyramidForceExit and pyr2_CanAddContracts and pyr2RawTrigger and pyr2_CourseAddOK and pyr2_CourseSignalOK and pyr2_DelayOK and pyr2_DistOK

if pyr2Signal and strategy.position_size > 0
    strategy.entry("Pyr2-L", strategy.long, qty = pyr2_AddQty, comment = "Pyr2 Add L")
    pyr2_addedThisCourse := pyr2_addedThisCourse + pyr2_AddQty
    pyr2_signalsThisCourse := pyr2_signalsThisCourse + 1
    pyr2_lastSignalTime := time
    pyr2_lastFillPrice := close
if pyr2Signal and strategy.position_size < 0
    strategy.entry("Pyr2-S", strategy.short, qty = pyr2_AddQty, comment = "Pyr2 Add S")
    pyr2_addedThisCourse := pyr2_addedThisCourse + pyr2_AddQty
    pyr2_signalsThisCourse := pyr2_signalsThisCourse + 1
    pyr2_lastSignalTime := time
    pyr2_lastFillPrice := close

pyr2_ExitProfit = f_pyrExitProfit(pyr2_UseOwnExits, pyr2_TP)
pyr2_ExitLoss   = f_pyrExitLoss(pyr2_UseOwnExits, pyr2_SL)
pyr2_ExitTrail  = f_pyrExitTrail(pyr2_UseOwnExits, pyr2_UseTrail, pyr2_Trail)
strategy.exit("Pyr2-ExitL", from_entry = "Pyr2-L", profit = pyr2_ExitProfit, loss = pyr2_ExitLoss, trail_points = pyr2_ExitTrail, trail_offset = pyr2_ExitTrail)
strategy.exit("Pyr2-ExitS", from_entry = "Pyr2-S", profit = pyr2_ExitProfit, loss = pyr2_ExitLoss, trail_points = pyr2_ExitTrail, trail_offset = pyr2_ExitTrail)


// =========================================================================
// SECTION 13: PYRAMID TYPE 3: MOMENTUM RE-CONFIRMATION
// =========================================================================
grpPyr3 = "13) Pyramid Type 3: Momentum Re-confirmation"
usePyr3 = input.bool(false, title = "Enable Momentum Re-confirmation Adds", group = grpPyr3)
pyr3ADXLen = input.int(defval = 14, title = "ADX/DI Length", minval = 1, group = grpPyr3)
pyr3ADXMin = input.float(defval = 20.0, title = "Minimum Rising ADX", minval = 0, group = grpPyr3)
pyr3RSILen = input.int(defval = 14, title = "RSI Length", minval = 1, group = grpPyr3)
pyr3RSILongMin  = input.float(defval = 55.0, title = "RSI Must Hold Above (long)", group = grpPyr3)
pyr3RSIShortMax = input.float(defval = 45.0, title = "RSI Must Hold Below (short)", group = grpPyr3)

[pyr3DIPlus, pyr3DIMinus, pyr3ADX] = ta.dmi(pyr3ADXLen, pyr3ADXLen)
pyr3ADXRising = pyr3ADX > pyr3ADX[1] and pyr3ADX >= pyr3ADXMin
pyr3RSI = ta.rsi(close, pyr3RSILen)

pyr3LongTrigger  = strategy.position_size > 0 and pyr3ADXRising and pyr3DIPlus > pyr3DIMinus and pyr3RSI > pyr3RSILongMin
pyr3ShortTrigger = strategy.position_size < 0 and pyr3ADXRising and pyr3DIMinus > pyr3DIPlus and pyr3RSI < pyr3RSIShortMax
pyr3RawTrigger = pyr3LongTrigger or pyr3ShortTrigger


pyr3_UseOwnExits = input.bool(false, title = "Enable TP/SL/Trailing For This Type", group = grpPyr3)
pyr3_ExitAtFlip = input.bool(false, title = "Exit At Next Supertrend Plotted Course", group = grpPyr3, tooltip = "UNCHECKED (default): this pyramid type's contracts only close via its own TP/SL/Trailing above (or the global Volatility Exit / Protective Stop / Session / Daily limits). CHECKED: this type's contracts are force-closed the instant the Supertrend flips to a new plotted course.")
