// =========================================================================
grpPyr5 = "15) Pyramid Type 5: Multi-Timeframe Alignment"
usePyr5 = input.bool(false, title = "Enable Multi-Timeframe Alignment Adds", group = grpPyr5)
pyr5FilterTF = input.timeframe(defval = "D", title = "Higher Timeframe Trend Filter", group = grpPyr5)
pyr5FilterLen = input.int(defval = 50, title = "Filter EMA Length", minval = 1, group = grpPyr5)

pyr5HTFClose = request.security(syminfo.tickerid, pyr5FilterTF, close, barmerge.gaps_off, barmerge.lookahead_off)
pyr5HTFEma   = request.security(syminfo.tickerid, pyr5FilterTF, ta.ema(close, pyr5FilterLen), barmerge.gaps_off, barmerge.lookahead_off)
pyr5HTFUp    = pyr5HTFClose > pyr5HTFEma
pyr5HTFDown  = pyr5HTFClose < pyr5HTFEma

pyr5LongTrigger  = strategy.position_size > 0 and pyr5HTFUp
pyr5ShortTrigger = strategy.position_size < 0 and pyr5HTFDown
pyr5RawTrigger = pyr5LongTrigger or pyr5ShortTrigger


pyr5_UseOwnExits = input.bool(false, title = "Enable TP/SL/Trailing For This Type", group = grpPyr5)
pyr5_ExitAtFlip = input.bool(false, title = "Exit At Next Supertrend Plotted Course", group = grpPyr5, tooltip = "UNCHECKED (default): this pyramid type's contracts only close via its own TP/SL/Trailing above (or the global Volatility Exit / Protective Stop / Session / Daily limits). CHECKED: this type's contracts are force-closed the instant the Supertrend flips to a new plotted course.")
