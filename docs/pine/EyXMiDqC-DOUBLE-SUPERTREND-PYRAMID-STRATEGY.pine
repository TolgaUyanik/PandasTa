if pyr3Signal and strategy.position_size > 0
    strategy.entry("Pyr3-L", strategy.long, qty = pyr3_AddQty, comment = "Pyr3 Add L")
    pyr3_addedThisCourse := pyr3_addedThisCourse + pyr3_AddQty
    pyr3_signalsThisCourse := pyr3_signalsThisCourse + 1
    pyr3_lastSignalTime := time
    pyr3_lastFillPrice := close
if pyr3Signal and strategy.position_size < 0
    strategy.entry("Pyr3-S", strategy.short, qty = pyr3_AddQty, comment = "Pyr3 Add S")
    pyr3_addedThisCourse := pyr3_addedThisCourse + pyr3_AddQty
    pyr3_signalsThisCourse := pyr3_signalsThisCourse + 1
    pyr3_lastSignalTime := time
    pyr3_lastFillPrice := close

