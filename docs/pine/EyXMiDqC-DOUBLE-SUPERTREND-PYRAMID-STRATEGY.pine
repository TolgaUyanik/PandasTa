pyr3_DistOK         = f_distanceOK(pyr3_UseMinDistance, pyr3_DistanceType, pyr3_DistanceAmount, pyr3_lastFillPrice, close, distanceATR)

pyr3_CanAddContracts = not useMaxContracts or (math.abs(strategy.position_size) + pyr3_AddQty <= maxContracts)
