// =========================================================================
// SECTION 16: PYRAMID TYPE 6: ERROR FUNCTION ONE-TAILED TEST
// =========================================================================
grpPyr6 = "16) Pyramid Type 6: Error Function One-Tailed Test"
usePyr6 = input.bool(false, title = "Enable Error Function One-Tailed Test Adds", group = grpPyr6)
pyr6RetLen    = input.int(defval = 100, title = "Return Distribution Lookback (bars)", minval = 10, group = grpPyr6)
pyr6UseT      = input.bool(false, title = "Use Student-T Approximation Instead Of Normal", group = grpPyr6)
pyr6DF        = input.int(defval = 5, title = "Student-T Degrees Of Freedom", minval = 2, group = grpPyr6)
pyr6MaxProb   = input.float(defval = 0.10, title = "Max One-Tailed Probability To Trigger (0.10 = top 10%)", minval = 0.001, maxval = 0.5, step = 0.01, group = grpPyr6)

pyr6Return = ta.change(close)
pyr6Mean   = ta.sma(pyr6Return, pyr6RetLen)
pyr6Std    = ta.stdev(pyr6Return, pyr6RetLen)
pyr6Z      = pyr6Std == 0 ? 0.0 : (pyr6Return - pyr6Mean) / pyr6Std
pyr6Prob   = pyr6UseT ? studentTOneTailedProb(pyr6Z, pyr6DF) : oneTailedProb(pyr6Z)

pyr6LongTrigger  = strategy.position_size > 0 and pyr6Return > 0 and pyr6Prob <= pyr6MaxProb
pyr6ShortTrigger = strategy.position_size < 0 and pyr6Return < 0 and pyr6Prob <= pyr6MaxProb
pyr6RawTrigger = pyr6LongTrigger or pyr6ShortTrigger


pyr6_UseOwnExits = input.bool(false, title = "Enable TP/SL/Trailing For This Type", group = grpPyr6)
pyr6_ExitAtFlip = input.bool(false, title = "Exit At Next Supertrend Plotted Course", group = grpPyr6, tooltip = "UNCHECKED (default): this pyramid type's contracts only close via its own TP/SL/Trailing above (or the global Volatility Exit / Protective Stop / Session / Daily limits). CHECKED: this type's contracts are force-closed the instant the Supertrend flips to a new plotted course.")
pyr6_AddQty = input.int(defval = 1, title = "Contracts Added Per Signal", minval = 1, group = grpPyr6)
pyr6_TP    = input.int(defval = 60, title = "Take Profit (ticks, 0=off)", minval = 0, inline = "6exit", group = grpPyr6)
pyr6_SL    = input.int(defval = 30, title = "Stop Loss (ticks, 0=off)", minval = 0, inline = "6exit", group = grpPyr6)
pyr6_UseTrail = input.bool(false, title = "Enable Trailing Stop", inline = "6trail", group = grpPyr6)
pyr6_Trail = input.int(defval = 20, title = "Trailing Stop (ticks)", minval = 0, inline = "6trail", group = grpPyr6)
pyr6_MaxAddPerCourse = input.int(defval = 0, title = "Max Contracts Added Per Plotted Course (0=off)", minval = 0, inline = "6lim1", group = grpPyr6)
pyr6_MaxSignalsPerCourse = input.int(defval = 0, title = "Max Total Signals Per Plotted Course (0=off)", minval = 0, inline = "6lim1", group = grpPyr6)
pyr6_DelaySeconds = input.int(defval = 0, title = "Delay Between Signals (seconds, 0=off)", minval = 0, group = grpPyr6)
pyr6_UseMinDistance = input.bool(false, title = "Require Minimum Distance Before Next Add", inline = "6dist", group = grpPyr6)
pyr6_DistanceType = input.string(defval = "Ticks", title = "Distance Type", options = ["Multiplier (ATR)", "Percent", "Ticks", "Points", "Dollar"], inline = "6dist", group = grpPyr6)
pyr6_DistanceAmount = input.float(defval = 20.0, title = "Distance Amount", minval = 0.0, group = grpPyr6)

var int pyr6_addedThisCourse = 0
var int pyr6_signalsThisCourse = 0
var float pyr6_lastSignalTime = na
var float pyr6_lastFillPrice = na
if newCourse
    pyr6_addedThisCourse := 0
    pyr6_signalsThisCourse := 0

pyr6_CourseAddOK    = pyr6_MaxAddPerCourse <= 0 or pyr6_addedThisCourse < pyr6_MaxAddPerCourse
pyr6_CourseSignalOK = pyr6_MaxSignalsPerCourse <= 0 or pyr6_signalsThisCourse < pyr6_MaxSignalsPerCourse
pyr6_DelayOK        = pyr6_DelaySeconds <= 0 or na(pyr6_lastSignalTime) or (time - pyr6_lastSignalTime) >= pyr6_DelaySeconds * 1000
pyr6_DistOK         = f_distanceOK(pyr6_UseMinDistance, pyr6_DistanceType, pyr6_DistanceAmount, pyr6_lastFillPrice, close, distanceATR)

pyr6_CanAddContracts = not useMaxContracts or (math.abs(strategy.position_size) + pyr6_AddQty <= maxContracts)
pyr6Signal = usePyr6 and canTrade and not pyramidForceExit and pyr6_CanAddContracts and pyr6RawTrigger and pyr6_CourseAddOK and pyr6_CourseSignalOK and pyr6_DelayOK and pyr6_DistOK

if pyr6Signal and strategy.position_size > 0
    strategy.entry("Pyr6-L", strategy.long, qty = pyr6_AddQty, comment = "Pyr6 Add L")
    pyr6_addedThisCourse := pyr6_addedThisCourse + pyr6_AddQty
    pyr6_signalsThisCourse := pyr6_signalsThisCourse + 1
    pyr6_lastSignalTime := time
    pyr6_lastFillPrice := close
if pyr6Signal and strategy.position_size < 0
    strategy.entry("Pyr6-S", strategy.short, qty = pyr6_AddQty, comment = "Pyr6 Add S")
    pyr6_addedThisCourse := pyr6_addedThisCourse + pyr6_AddQty
    pyr6_signalsThisCourse := pyr6_signalsThisCourse + 1
    pyr6_lastSignalTime := time
    pyr6_lastFillPrice := close

pyr6_ExitProfit = f_pyrExitProfit(pyr6_UseOwnExits, pyr6_TP)
pyr6_ExitLoss   = f_pyrExitLoss(pyr6_UseOwnExits, pyr6_SL)
pyr6_ExitTrail  = f_pyrExitTrail(pyr6_UseOwnExits, pyr6_UseTrail, pyr6_Trail)
strategy.exit("Pyr6-ExitL", from_entry = "Pyr6-L", profit = pyr6_ExitProfit, loss = pyr6_ExitLoss, trail_points = pyr6_ExitTrail, trail_offset = pyr6_ExitTrail)
strategy.exit("Pyr6-ExitS", from_entry = "Pyr6-S", profit = pyr6_ExitProfit, loss = pyr6_ExitLoss, trail_points = pyr6_ExitTrail, trail_offset = pyr6_ExitTrail)


// =========================================================================
// SECTION 17: PYRAMID TYPE 7: KDE PERCENTILE
// =========================================================================
grpPyr7 = "17) Pyramid Type 7: KDE Percentile"
usePyr7 = input.bool(false, title = "Enable KDE Percentile Adds", group = grpPyr7)
pyr7SampleSize = input.int(defval = 100, title = "Sample Window (bars of returns)", minval = 20, maxval = 500, group = grpPyr7)
pyr7Bandwidth  = input.float(defval = 0.5, title = "Kernel Bandwidth", minval = 0.01, step = 0.05, group = grpPyr7)
pyr7Steps      = input.int(defval = 40, title = "KDE Grid Steps", minval = 10, maxval = 200, group = grpPyr7)
pyr7TopPct     = input.float(defval = 0.10, title = "Trigger When Move Is In Top X% (0.10 = top 10%)", minval = 0.01, maxval = 0.5, step = 0.01, group = grpPyr7)

var array<float> pyr7Samples = array.new_float(0)
pyr7Return = ta.change(close)
if not na(pyr7Return)
    array.push(pyr7Samples, pyr7Return)
    if array.size(pyr7Samples) > pyr7SampleSize
        array.shift(pyr7Samples)

f_kdePercentile(samples, x, h, steps) =>
    n = array.size(samples)
    result = 0.0
    if n >= 20
        lo = array.min(samples)
        hi = array.max(samples)
        span = hi - lo
        gridLo = lo - span * 0.1
        gridHi = hi + span * 0.1
        stepSize = (gridHi - gridLo) / steps
        cumDensity = 0.0
        totalDensity = 0.0
        for s = 0 to steps
            gx = gridLo + s * stepSize
            dens = 0.0
            for i = 0 to n - 1
                xi = array.get(samples, i)
                u = (gx - xi) / h
                dens := dens + math.exp(-0.5 * u * u)
            dens := dens / (n * h * math.sqrt(2.0 * math.pi))
            totalDensity := totalDensity + dens
            if gx <= x
                cumDensity := cumDensity + dens
        result := totalDensity == 0.0 ? 0.5 : cumDensity / totalDensity
    else
        result := 0.5
    result

pyr7Percentile = usePyr7 ? f_kdePercentile(pyr7Samples, pyr7Return, pyr7Bandwidth, pyr7Steps) : 0.5

pyr7LongTrigger  = strategy.position_size > 0 and pyr7Return > 0 and pyr7Percentile >= (1.0 - pyr7TopPct)
pyr7ShortTrigger = strategy.position_size < 0 and pyr7Return < 0 and pyr7Percentile <= pyr7TopPct
pyr7RawTrigger = pyr7LongTrigger or pyr7ShortTrigger


pyr7_UseOwnExits = input.bool(false, title = "Enable TP/SL/Trailing For This Type", group = grpPyr7)
pyr7_ExitAtFlip = input.bool(false, title = "Exit At Next Supertrend Plotted Course", group = grpPyr7, tooltip = "UNCHECKED (default): this pyramid type's contracts only close via its own TP/SL/Trailing above (or the global Volatility Exit / Protective Stop / Session / Daily limits). CHECKED: this type's contracts are force-closed the instant the Supertrend flips to a new plotted course.")
pyr7_AddQty = input.int(defval = 1, title = "Contracts Added Per Signal", minval = 1, group = grpPyr7)
pyr7_TP    = input.int(defval = 60, title = "Take Profit (ticks, 0=off)", minval = 0, inline = "7exit", group = grpPyr7)
pyr7_SL    = input.int(defval = 30, title = "Stop Loss (ticks, 0=off)", minval = 0, inline = "7exit", group = grpPyr7)
pyr7_UseTrail = input.bool(false, title = "Enable Trailing Stop", inline = "7trail", group = grpPyr7)
pyr7_Trail = input.int(defval = 20, title = "Trailing Stop (ticks)", minval = 0, inline = "7trail", group = grpPyr7)
pyr7_MaxAddPerCourse = input.int(defval = 0, title = "Max Contracts Added Per Plotted Course (0=off)", minval = 0, inline = "7lim1", group = grpPyr7)
pyr7_MaxSignalsPerCourse = input.int(defval = 0, title = "Max Total Signals Per Plotted Course (0=off)", minval = 0, inline = "7lim1", group = grpPyr7)
pyr7_DelaySeconds = input.int(defval = 0, title = "Delay Between Signals (seconds, 0=off)", minval = 0, group = grpPyr7)
pyr7_UseMinDistance = input.bool(false, title = "Require Minimum Distance Before Next Add", inline = "7dist", group = grpPyr7)
pyr7_DistanceType = input.string(defval = "Ticks", title = "Distance Type", options = ["Multiplier (ATR)", "Percent", "Ticks", "Points", "Dollar"], inline = "7dist", group = grpPyr7)
pyr7_DistanceAmount = input.float(defval = 20.0, title = "Distance Amount", minval = 0.0, group = grpPyr7)

var int pyr7_addedThisCourse = 0
var int pyr7_signalsThisCourse = 0
var float pyr7_lastSignalTime = na
var float pyr7_lastFillPrice = na
if newCourse
    pyr7_addedThisCourse := 0
    pyr7_signalsThisCourse := 0

pyr7_CourseAddOK    = pyr7_MaxAddPerCourse <= 0 or pyr7_addedThisCourse < pyr7_MaxAddPerCourse
pyr7_CourseSignalOK = pyr7_MaxSignalsPerCourse <= 0 or pyr7_signalsThisCourse < pyr7_MaxSignalsPerCourse
pyr7_DelayOK        = pyr7_DelaySeconds <= 0 or na(pyr7_lastSignalTime) or (time - pyr7_lastSignalTime) >= pyr7_DelaySeconds * 1000
pyr7_DistOK         = f_distanceOK(pyr7_UseMinDistance, pyr7_DistanceType, pyr7_DistanceAmount, pyr7_lastFillPrice, close, distanceATR)

pyr7_CanAddContracts = not useMaxContracts or (math.abs(strategy.position_size) + pyr7_AddQty <= maxContracts)
pyr7Signal = usePyr7 and canTrade and not pyramidForceExit and pyr7_CanAddContracts and pyr7RawTrigger and pyr7_CourseAddOK and pyr7_CourseSignalOK and pyr7_DelayOK and pyr7_DistOK

if pyr7Signal and strategy.position_size > 0
    strategy.entry("Pyr7-L", strategy.long, qty = pyr7_AddQty, comment = "Pyr7 Add L")
    pyr7_addedThisCourse := pyr7_addedThisCourse + pyr7_AddQty
    pyr7_signalsThisCourse := pyr7_signalsThisCourse + 1
    pyr7_lastSignalTime := time
    pyr7_lastFillPrice := close
if pyr7Signal and strategy.position_size < 0
    strategy.entry("Pyr7-S", strategy.short, qty = pyr7_AddQty, comment = "Pyr7 Add S")
    pyr7_addedThisCourse := pyr7_addedThisCourse + pyr7_AddQty
    pyr7_signalsThisCourse := pyr7_signalsThisCourse + 1
    pyr7_lastSignalTime := time
    pyr7_lastFillPrice := close

pyr7_ExitProfit = f_pyrExitProfit(pyr7_UseOwnExits, pyr7_TP)
pyr7_ExitLoss   = f_pyrExitLoss(pyr7_UseOwnExits, pyr7_SL)
pyr7_ExitTrail  = f_pyrExitTrail(pyr7_UseOwnExits, pyr7_UseTrail, pyr7_Trail)
strategy.exit("Pyr7-ExitL", from_entry = "Pyr7-L", profit = pyr7_ExitProfit, loss = pyr7_ExitLoss, trail_points = pyr7_ExitTrail, trail_offset = pyr7_ExitTrail)
strategy.exit("Pyr7-ExitS", from_entry = "Pyr7-S", profit = pyr7_ExitProfit, loss = pyr7_ExitLoss, trail_points = pyr7_ExitTrail, trail_offset = pyr7_ExitTrail)


// =========================================================================
// SECTION 18: PYRAMID TYPE 8: VITERBI REGIME DETECTION
// =========================================================================
grpPyr8 = "18) Pyramid Type 8: Viterbi Regime Detection"
usePyr8 = input.bool(false, title = "Enable Viterbi Regime Detection Adds", group = grpPyr8)
pyr8Window = input.int(defval = 20, title = "Observation Window (bars)", minval = 5, maxval = 100, group = grpPyr8)
pyr8ATRLen = input.int(defval = 14, title = "ATR Length (for observation discretization)", minval = 1, group = grpPyr8)
pyr8TransStay = input.float(defval = 0.85, title = "P(Stay In Same Regime) [transition diag]", minval = 0.5, maxval = 0.99, step = 0.01, group = grpPyr8)
pyr8EmisTrendHigh = input.float(defval = 0.6, title = "P(High-Vol Move | Trending)", minval = 0.34, maxval = 0.98, step = 0.01, group = grpPyr8)
pyr8EmisRangeLow  = input.float(defval = 0.6, title = "P(Low-Vol Move | Ranging)", minval = 0.34, maxval = 0.98, step = 0.01, group = grpPyr8)

pyr8ATR = ta.atr(pyr8ATRLen)
pyr8NormMove = pyr8ATR == 0 ? 0.0 : math.abs(ta.change(close)) / pyr8ATR
pyr8Obs = pyr8NormMove < 0.5 ? 0 : (pyr8NormMove < 1.5 ? 1 : 2)

var array<int> pyr8Obs_window = array.new_int(0)
array.push(pyr8Obs_window, pyr8Obs)
if array.size(pyr8Obs_window) > pyr8Window
    array.shift(pyr8Obs_window)

pyr8Trans = matrix.new<float>(2, 2, 0.0)
matrix.set(pyr8Trans, 0, 0, pyr8TransStay)
matrix.set(pyr8Trans, 0, 1, 1.0 - pyr8TransStay)
matrix.set(pyr8Trans, 1, 0, 1.0 - pyr8TransStay)
matrix.set(pyr8Trans, 1, 1, pyr8TransStay)

pyr8RemainderTrend = (1.0 - pyr8EmisTrendHigh) / 2.0
pyr8RemainderRange = (1.0 - pyr8EmisRangeLow) / 2.0
pyr8Emis = matrix.new<float>(2, 3, 0.0)
matrix.set(pyr8Emis, 0, 0, pyr8RemainderTrend)
matrix.set(pyr8Emis, 0, 1, pyr8RemainderTrend)
matrix.set(pyr8Emis, 0, 2, pyr8EmisTrendHigh)
matrix.set(pyr8Emis, 1, 0, pyr8EmisRangeLow)
matrix.set(pyr8Emis, 1, 1, pyr8RemainderRange)
matrix.set(pyr8Emis, 1, 2, pyr8RemainderRange)

f_viterbiCurrentState(obsArr, transMat, emisMat) =>
    nObs = array.size(obsArr)
    result = 0
    if nObs >= 2
        omega0 = math.log(0.5 * matrix.get(emisMat, 0, array.get(obsArr, 0)))
        omega1 = math.log(0.5 * matrix.get(emisMat, 1, array.get(obsArr, 0)))
        for t = 1 to nObs - 1
            obsT = array.get(obsArr, t)
            cand00 = omega0 + math.log(matrix.get(transMat, 0, 0)) + math.log(matrix.get(emisMat, 0, obsT))
            cand10 = omega1 + math.log(matrix.get(transMat, 1, 0)) + math.log(matrix.get(emisMat, 0, obsT))
            new0 = math.max(cand00, cand10)
            cand01 = omega0 + math.log(matrix.get(transMat, 0, 1)) + math.log(matrix.get(emisMat, 1, obsT))
            cand11 = omega1 + math.log(matrix.get(transMat, 1, 1)) + math.log(matrix.get(emisMat, 1, obsT))
            new1 = math.max(cand01, cand11)
            omega0 := new0
            omega1 := new1
        result := omega0 >= omega1 ? 0 : 1
    result

pyr8State = usePyr8 ? f_viterbiCurrentState(pyr8Obs_window, pyr8Trans, pyr8Emis) : 1
pyr8Trending = pyr8State == 0

pyr8LongTrigger  = strategy.position_size > 0 and pyr8Trending
pyr8ShortTrigger = strategy.position_size < 0 and pyr8Trending
pyr8RawTrigger = pyr8LongTrigger or pyr8ShortTrigger


pyr8_UseOwnExits = input.bool(false, title = "Enable TP/SL/Trailing For This Type", group = grpPyr8)
pyr8_ExitAtFlip = input.bool(false, title = "Exit At Next Supertrend Plotted Course", group = grpPyr8, tooltip = "UNCHECKED (default): this pyramid type's contracts only close via its own TP/SL/Trailing above (or the global Volatility Exit / Protective Stop / Session / Daily limits). CHECKED: this type's contracts are force-closed the instant the Supertrend flips to a new plotted course.")
pyr8_AddQty = input.int(defval = 1, title = "Contracts Added Per Signal", minval = 1, group = grpPyr8)
pyr8_TP    = input.int(defval = 60, title = "Take Profit (ticks, 0=off)", minval = 0, inline = "8exit", group = grpPyr8)
pyr8_SL    = input.int(defval = 30, title = "Stop Loss (ticks, 0=off)", minval = 0, inline = "8exit", group = grpPyr8)
pyr8_UseTrail = input.bool(false, title = "Enable Trailing Stop", inline = "8trail", group = grpPyr8)
pyr8_Trail = input.int(defval = 20, title = "Trailing Stop (ticks)", minval = 0, inline = "8trail", group = grpPyr8)
pyr8_MaxAddPerCourse = input.int(defval = 0, title = "Max Contracts Added Per Plotted Course (0=off)", minval = 0, inline = "8lim1", group = grpPyr8)
pyr8_MaxSignalsPerCourse = input.int(defval = 0, title = "Max Total Signals Per Plotted Course (0=off)", minval = 0, inline = "8lim1", group = grpPyr8)
pyr8_DelaySeconds = input.int(defval = 0, title = "Delay Between Signals (seconds, 0=off)", minval = 0, group = grpPyr8)
pyr8_UseMinDistance = input.bool(false, title = "Require Minimum Distance Before Next Add", inline = "8dist", group = grpPyr8)
pyr8_DistanceType = input.string(defval = "Ticks", title = "Distance Type", options = ["Multiplier (ATR)", "Percent", "Ticks", "Points", "Dollar"], inline = "8dist", group = grpPyr8)
pyr8_DistanceAmount = input.float(defval = 20.0, title = "Distance Amount", minval = 0.0, group = grpPyr8)

var int pyr8_addedThisCourse = 0
var int pyr8_signalsThisCourse = 0
var float pyr8_lastSignalTime = na
var float pyr8_lastFillPrice = na
if newCourse
    pyr8_addedThisCourse := 0
    pyr8_signalsThisCourse := 0

pyr8_CourseAddOK    = pyr8_MaxAddPerCourse <= 0 or pyr8_addedThisCourse < pyr8_MaxAddPerCourse
pyr8_CourseSignalOK = pyr8_MaxSignalsPerCourse <= 0 or pyr8_signalsThisCourse < pyr8_MaxSignalsPerCourse
pyr8_DelayOK        = pyr8_DelaySeconds <= 0 or na(pyr8_lastSignalTime) or (time - pyr8_lastSignalTime) >= pyr8_DelaySeconds * 1000
pyr8_DistOK         = f_distanceOK(pyr8_UseMinDistance, pyr8_DistanceType, pyr8_DistanceAmount, pyr8_lastFillPrice, close, distanceATR)

pyr8_CanAddContracts = not useMaxContracts or (math.abs(strategy.position_size) + pyr8_AddQty <= maxContracts)
pyr8Signal = usePyr8 and canTrade and not pyramidForceExit and pyr8_CanAddContracts and pyr8RawTrigger and pyr8_CourseAddOK and pyr8_CourseSignalOK and pyr8_DelayOK and pyr8_DistOK

if pyr8Signal and strategy.position_size > 0
    strategy.entry("Pyr8-L", strategy.long, qty = pyr8_AddQty, comment = "Pyr8 Add L")
    pyr8_addedThisCourse := pyr8_addedThisCourse + pyr8_AddQty
    pyr8_signalsThisCourse := pyr8_signalsThisCourse + 1
    pyr8_lastSignalTime := time
    pyr8_lastFillPrice := close
if pyr8Signal and strategy.position_size < 0
    strategy.entry("Pyr8-S", strategy.short, qty = pyr8_AddQty, comment = "Pyr8 Add S")
    pyr8_addedThisCourse := pyr8_addedThisCourse + pyr8_AddQty
    pyr8_signalsThisCourse := pyr8_signalsThisCourse + 1
    pyr8_lastSignalTime := time
    pyr8_lastFillPrice := close

pyr8_ExitProfit = f_pyrExitProfit(pyr8_UseOwnExits, pyr8_TP)
pyr8_ExitLoss   = f_pyrExitLoss(pyr8_UseOwnExits, pyr8_SL)
pyr8_ExitTrail  = f_pyrExitTrail(pyr8_UseOwnExits, pyr8_UseTrail, pyr8_Trail)
strategy.exit("Pyr8-ExitL", from_entry = "Pyr8-L", profit = pyr8_ExitProfit, loss = pyr8_ExitLoss, trail_points = pyr8_ExitTrail, trail_offset = pyr8_ExitTrail)
strategy.exit("Pyr8-ExitS", from_entry = "Pyr8-S", profit = pyr8_ExitProfit, loss = pyr8_ExitLoss, trail_points = pyr8_ExitTrail, trail_offset = pyr8_ExitTrail)

// =========================================================================
// SECTION 19: MAIN ENTRIES (double-supertrend "plotting course" signal)
// Each subsystem's own "Exit At Next Supertrend Plotted Course" checkbox
// (Sections 10a-10c, and inside each Pyramid Type) decides whether ITS
// contracts get force-closed on a flip. Subsystems left unchecked simply
// keep running on their own TP/SL/Trailing until they close themselves.
// The new-direction entry waits until the strategy is fully flat.
// =========================================================================
if newCourse and coreExitAtFlip
    strategy.close("Long",  comment = "Exit At Next Supertrend Course")
    strategy.close("Short", comment = "Exit At Next Supertrend Course")

if newCourse and pyr1_ExitAtFlip
    strategy.close("Pyr1-L", comment = "Exit At Next Supertrend Course")
    strategy.close("Pyr1-S", comment = "Exit At Next Supertrend Course")
if newCourse and pyr2_ExitAtFlip
    strategy.close("Pyr2-L", comment = "Exit At Next Supertrend Course")
    strategy.close("Pyr2-S", comment = "Exit At Next Supertrend Course")
if newCourse and pyr3_ExitAtFlip
    strategy.close("Pyr3-L", comment = "Exit At Next Supertrend Course")
    strategy.close("Pyr3-S", comment = "Exit At Next Supertrend Course")
if newCourse and pyr4_ExitAtFlip
    strategy.close("Pyr4-L", comment = "Exit At Next Supertrend Course")
    strategy.close("Pyr4-S", comment = "Exit At Next Supertrend Course")
if newCourse and pyr5_ExitAtFlip
    strategy.close("Pyr5-L", comment = "Exit At Next Supertrend Course")
    strategy.close("Pyr5-S", comment = "Exit At Next Supertrend Course")
if newCourse and pyr6_ExitAtFlip
    strategy.close("Pyr6-L", comment = "Exit At Next Supertrend Course")
    strategy.close("Pyr6-S", comment = "Exit At Next Supertrend Course")
if newCourse and pyr7_ExitAtFlip
    strategy.close("Pyr7-L", comment = "Exit At Next Supertrend Course")
    strategy.close("Pyr7-S", comment = "Exit At Next Supertrend Course")
if newCourse and pyr8_ExitAtFlip
    strategy.close("Pyr8-L", comment = "Exit At Next Supertrend Course")
    strategy.close("Pyr8-S", comment = "Exit At Next Supertrend Course")

canEnterLong  = canTrade and allowLong  and pendingDirection == 1  and strategy.position_size <= 0
canEnterShort = canTrade and allowShort and pendingDirection == -1 and strategy.position_size >= 0

if canEnterLong
    strategy.entry("Long", strategy.long, comment = "Long Entry")
    pendingDirection := 0

if canEnterShort
    strategy.entry("Short", strategy.short, comment = "Short Entry")
    pendingDirection := 0

// =========================================================================
// SECTION 20: TIERED EXITS (scale-outs on the core "Long"/"Short" entries)
// trail_points = activation threshold (ticks in favor before trailing starts)
// trail_offset = the trailing distance itself
// Only these orders (plus the global Volatility Exit / Protective Stop /
// Session / Daily limits) can close a tiered position - see Section 19.
// =========================================================================
tier1LossVal  = tier1UseSL ? tier1SL : na
tier1TrailPts = tier1UseTrail ? tier1Threshold : na
tier1TrailOff = tier1UseTrail ? tier1Trail : na
tier2LossVal  = tier2UseSL ? tier2SL : na
tier2TrailPts = tier2UseTrail ? tier2Threshold : na
tier2TrailOff = tier2UseTrail ? tier2Trail : na
tier3LossVal  = tier3UseSL ? tier3SL : na
tier3TrailPts = tier3UseTrail ? tier3Threshold : na
tier3TrailOff = tier3UseTrail ? tier3Trail : na

if useTier1
    strategy.exit("Tier1-L", from_entry = "Long",  qty = tier1Qty, profit = tier1Target, loss = tier1LossVal, trail_points = tier1TrailPts, trail_offset = tier1TrailOff)
    strategy.exit("Tier1-S", from_entry = "Short", qty = tier1Qty, profit = tier1Target, loss = tier1LossVal, trail_points = tier1TrailPts, trail_offset = tier1TrailOff)
if useTier2
    strategy.exit("Tier2-L", from_entry = "Long",  qty = tier2Qty, profit = tier2Target, loss = tier2LossVal, trail_points = tier2TrailPts, trail_offset = tier2TrailOff)
    strategy.exit("Tier2-S", from_entry = "Short", qty = tier2Qty, profit = tier2Target, loss = tier2LossVal, trail_points = tier2TrailPts, trail_offset = tier2TrailOff)
if useTier3
    strategy.exit("Tier3-L", from_entry = "Long",  qty = tier3Qty, profit = tier3Target, loss = tier3LossVal, trail_points = tier3TrailPts, trail_offset = tier3TrailOff)
    strategy.exit("Tier3-S", from_entry = "Short", qty = tier3Qty, profit = tier3Target, loss = tier3LossVal, trail_points = tier3TrailPts, trail_offset = tier3TrailOff)

// =========================================================================
// SECTION 21: PER-PLOTTING-COURSE TP / SL (skipped when Reverse-At-SL is on;
//             that subsystem replaces the SL leg - see Section 23)
// =========================================================================
courseSLActive = useCourseSL and not useReverseAtSL
courseProfitVal = useCourseTP ? courseTPTicks : na
courseLossVal   = courseSLActive ? courseSLTicks : na

if useCourseTP or courseSLActive
    strategy.exit("CourseExit-L", from_entry = "Long",  profit = courseProfitVal, loss = courseLossVal)
    strategy.exit("CourseExit-S", from_entry = "Short", profit = courseProfitVal, loss = courseLossVal)

// =========================================================================
// SECTION 22: REVERSE AT STOP LOSS
// =========================================================================
longSLPrice  = strategy.position_avg_price - courseSLTicks * tick
shortSLPrice = strategy.position_avg_price + courseSLTicks * tick

reverseLongTrigger  = useReverseAtSL and strategy.position_size > 0 and low  <= longSLPrice  and reversalsThisCourse < maxReversalsPerCourse
reverseShortTrigger = useReverseAtSL and strategy.position_size < 0 and high >= shortSLPrice and reversalsThisCourse < maxReversalsPerCourse

if reverseLongTrigger
    strategy.close("Long", comment = "Reverse@SL")
    strategy.close_all(comment = "Reverse@SL - flatten pyramids")
    strategy.entry("Short", strategy.short, comment = "Reverse Entry S")
    reversalsThisCourse := reversalsThisCourse + 1

if reverseShortTrigger
    strategy.close("Short", comment = "Reverse@SL")
    strategy.close_all(comment = "Reverse@SL - flatten pyramids")
    strategy.entry("Long", strategy.long, comment = "Reverse Entry L")
    reversalsThisCourse := reversalsThisCourse + 1

// =========================================================================
// SECTION 23: VOLATILITY EXIT & PROTECTIVE STOP (override everything, incl. pyramids)
// =========================================================================
if volatilityExitTriggered
    strategy.close_all(comment = "Volatility Exit")

if useProtectiveStop and strategy.position_size > 0 and low <= longProtectiveStop
    strategy.close_all(comment = "Protective Stop (Long)")

if useProtectiveStop and strategy.position_size < 0 and high >= shortProtectiveStop
    strategy.close_all(comment = "Protective Stop (Short)")

// =========================================================================
// SECTION 24: SESSION END / DAILY LIMIT CLOSE-OUT
// =========================================================================
if sessionEndThisBar and closeAtSessionEnd
    strategy.close_all(comment = "Session End")

if (useDailyTP or useDailyMaxLoss) and dailyHalt and not dailyHalt[1]
    strategy.close_all(comment = "Daily Limit Hit")

// =========================================================================
// SECTION 25: VISUALS - ENTRY / EXIT SIGNALS
// =========================================================================
plotshape(canEnterLong,  title = "Long Entry",  style = shape.triangleup,   location = location.belowbar, color = color.green, size = size.small)
plotshape(canEnterShort, title = "Short Entry", style = shape.triangledown, location = location.abovebar, color = color.red,   size = size.small)
plotshape(reverseLongTrigger,  title = "Reverse To Long",  style = shape.arrowup,   location = location.belowbar, color = color.aqua,   size = size.small)
plotshape(reverseShortTrigger, title = "Reverse To Short", style = shape.arrowdown, location = location.abovebar, color = color.fuchsia, size = size.small)
plotshape(volatilityExitTriggered, title = "Volatility Exit", style = shape.xcross, location = location.abovebar, color = color.orange, size = size.small)
bgcolor(dailyHalt ? color.new(color.gray, 85) : na, title = "Daily Halt Shading")

// Pyramid add markers - one per type so you can tell them apart on the chart
plotshape(pyr1Signal and strategy.position_size > 0, title = "Pyr1 Turtle Add L",   style = shape.circle, location = location.belowbar, color = color.new(color.teal, 20),    size = size.tiny, text = "T")
plotshape(pyr1Signal and strategy.position_size < 0, title = "Pyr1 Turtle Add S",   style = shape.circle, location = location.abovebar, color = color.new(color.teal, 20),    size = size.tiny, text = "T")
plotshape(pyr2Signal and strategy.position_size > 0, title = "Pyr2 Swing Add L",    style = shape.circle, location = location.belowbar, color = color.new(color.blue, 20),    size = size.tiny, text = "SW")
plotshape(pyr2Signal and strategy.position_size < 0, title = "Pyr2 Swing Add S",    style = shape.circle, location = location.abovebar, color = color.new(color.blue, 20),    size = size.tiny, text = "SW")
plotshape(pyr3Signal and strategy.position_size > 0, title = "Pyr3 Momentum Add L", style = shape.circle, location = location.belowbar, color = color.new(color.purple, 20),  size = size.tiny, text = "M")
plotshape(pyr3Signal and strategy.position_size < 0, title = "Pyr3 Momentum Add S", style = shape.circle, location = location.abovebar, color = color.new(color.purple, 20),  size = size.tiny, text = "M")
plotshape(pyr4Signal and strategy.position_size > 0, title = "Pyr4 Breakout Add L", style = shape.circle, location = location.belowbar, color = color.new(color.olive, 20),   size = size.tiny, text = "BO")
plotshape(pyr4Signal and strategy.position_size < 0, title = "Pyr4 Breakout Add S", style = shape.circle, location = location.abovebar, color = color.new(color.olive, 20),   size = size.tiny, text = "BO")
plotshape(pyr5Signal and strategy.position_size > 0, title = "Pyr5 MTF Add L",      style = shape.circle, location = location.belowbar, color = color.new(color.navy, 20),    size = size.tiny, text = "MTF")
plotshape(pyr5Signal and strategy.position_size < 0, title = "Pyr5 MTF Add S",      style = shape.circle, location = location.abovebar, color = color.new(color.navy, 20),    size = size.tiny, text = "MTF")
plotshape(pyr6Signal and strategy.position_size > 0, title = "Pyr6 ErfTest Add L",  style = shape.circle, location = location.belowbar, color = color.new(color.maroon, 20),  size = size.tiny, text = "ERF")
plotshape(pyr6Signal and strategy.position_size < 0, title = "Pyr6 ErfTest Add S",  style = shape.circle, location = location.abovebar, color = color.new(color.maroon, 20),  size = size.tiny, text = "ERF")
plotshape(pyr7Signal and strategy.position_size > 0, title = "Pyr7 KDE Add L",      style = shape.circle, location = location.belowbar, color = color.new(color.fuchsia, 20), size = size.tiny, text = "KDE")
plotshape(pyr7Signal and strategy.position_size < 0, title = "Pyr7 KDE Add S",      style = shape.circle, location = location.abovebar, color = color.new(color.fuchsia, 20), size = size.tiny, text = "KDE")
plotshape(pyr8Signal and strategy.position_size > 0, title = "Pyr8 Viterbi Add L",  style = shape.circle, location = location.belowbar, color = color.new(color.orange, 20),  size = size.tiny, text = "VIT")
plotshape(pyr8Signal and strategy.position_size < 0, title = "Pyr8 Viterbi Add S",  style = shape.circle, location = location.abovebar, color = color.new(color.orange, 20),  size = size.tiny, text = "VIT")

// =========================================================================
// SECTION 26: DEBUG LABELS - every actual order fill, labeled by exit/entry id
// This directly shows what closed a position and why (tiered exit, course
// exit, protective stop, pyramid exit, reversal, etc.)
// =========================================================================
showFillLabels = input.bool(true, title = "Show Fill Debug Labels On Chart", group = "26) Debug")

var int lastClosedCount = 0
if showFillLabels and strategy.closedtrades > lastClosedCount
    for idx = lastClosedCount to strategy.closedtrades - 1
        exitId = strategy.closedtrades.exit_id(idx)
        exitPrice = strategy.closedtrades.exit_price(idx)
        tradeSize = strategy.closedtrades.size(idx)
        label.new(bar_index, exitPrice, text = exitId, style = tradeSize > 0 ? label.style_label_down : label.style_label_up, color = color.new(color.black, 70), textcolor = color.white, size = size.tiny)
    lastClosedCount := strategy.closedtrades

// =========================================================================
// SECTION 27: ALERTS
// =========================================================================
alertcondition(canEnterLong,  title = "Long Entry",  message = "DOUBLE SUPERTREND PYRAMID: Long Entry")
alertcondition(canEnterShort, title = "Short Entry", message = "DOUBLE SUPERTREND PYRAMID: Short Entry")
alertcondition(reverseLongTrigger,  title = "Reverse To Long",  message = "DOUBLE SUPERTREND PYRAMID: Reverse to Long")
alertcondition(reverseShortTrigger, title = "Reverse To Short", message = "DOUBLE SUPERTREND PYRAMID: Reverse to Short")
alertcondition(pyr1Signal or pyr2Signal or pyr3Signal or pyr4Signal or pyr5Signal or pyr6Signal or pyr7Signal or pyr8Signal, title = "Pyramid Add", message = "DOUBLE SUPERTREND PYRAMID: Pyramid Add Triggered")
