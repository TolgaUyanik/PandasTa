grpPyr4 = "14) Pyramid Type 4: Breakout / Consolidation"
usePyr4 = input.bool(false, title = "Enable Breakout / Consolidation Adds", group = grpPyr4)
pyr4DonchianLen = input.int(defval = 10, title = "Donchian Lookback (bars)", minval = 2, group = grpPyr4)

pyr4Highest = ta.highest(high, pyr4DonchianLen)
pyr4Lowest  = ta.lowest(low, pyr4DonchianLen)
pyr4LongTrigger  = strategy.position_size > 0 and close > pyr4Highest[1]
pyr4ShortTrigger = strategy.position_size < 0 and close < pyr4Lowest[1]
pyr4RawTrigger = pyr4LongTrigger or pyr4ShortTrigger


