    pyr3_addedThisCourse := 0
    pyr3_signalsThisCourse := 0

pyr3_CourseAddOK    = pyr3_MaxAddPerCourse <= 0 or pyr3_addedThisCourse < pyr3_MaxAddPerCourse
pyr3_CourseSignalOK = pyr3_MaxSignalsPerCourse <= 0 or pyr3_signalsThisCourse < pyr3_MaxSignalsPerCourse
