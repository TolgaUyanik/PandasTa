pyr5_TP    = input.int(defval = 60, title = "Take Profit (ticks, 0=off)", minval = 0, inline = "5exit", group = grpPyr5)
pyr5_SL    = input.int(defval = 30, title = "Stop Loss (ticks, 0=off)", minval = 0, inline = "5exit", group = grpPyr5)
pyr5_UseTrail = input.bool(false, title = "Enable Trailing Stop", inline = "5trail", group = grpPyr5)
pyr5_Trail = input.int(defval = 20, title = "Trailing Stop (ticks)", minval = 0, inline = "5trail", group = grpPyr5)
pyr5_MaxAddPerCourse = input.int(defval = 0, title = "Max Contracts Added Per Plotted Course (0=off)", minval = 0, inline = "5lim1", group = grpPyr5)
pyr5_MaxSignalsPerCourse = input.int(defval = 0, title = "Max Total Signals Per Plotted Course (0=off)", minval = 0, inline = "5lim1", group = grpPyr5)
pyr5_DelaySeconds = input.int(defval = 0, title = "Delay Between Signals (seconds, 0=off)", minval = 0, group = grpPyr5)
pyr5_UseMinDistance = input.bool(false, title = "Require Minimum Distance Before Next Add", inline = "5dist", group = grpPyr5)
pyr5_DistanceType = input.string(defval = "Ticks", title = "Distance Type", options = ["Multiplier (ATR)", "Percent", "Ticks", "Points", "Dollar"], inline = "5dist", group = grpPyr5)
pyr5_DistanceAmount = input.float(defval = 20.0, title = "Distance Amount", minval = 0.0, group = grpPyr5)

var int pyr5_addedThisCourse = 0
