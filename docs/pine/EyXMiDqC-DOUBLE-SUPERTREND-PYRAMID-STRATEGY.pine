    pyr5_addedThisCourse := 0
    pyr5_signalsThisCourse := 0

pyr5_CourseAddOK    = pyr5_MaxAddPerCourse <= 0 or pyr5_addedThisCourse < pyr5_MaxAddPerCourse
pyr5_CourseSignalOK = pyr5_MaxSignalsPerCourse <= 0 or pyr5_signalsThisCourse < pyr5_MaxSignalsPerCourse
pyr5_DelayOK        = pyr5_DelaySeconds <= 0 or na(pyr5_lastSignalTime) or (time - pyr5_lastSignalTime) >= pyr5_DelaySeconds * 1000
pyr5_DistOK         = f_distanceOK(pyr5_UseMinDistance, pyr5_DistanceType, pyr5_DistanceAmount, pyr5_lastFillPrice, close, distanceATR)

pyr5_CanAddContracts = not useMaxContracts or (math.abs(strategy.position_size) + pyr5_AddQty <= maxContracts)
pyr5Signal = usePyr5 and canTrade and not pyramidForceExit and pyr5_CanAddContracts and pyr5RawTrigger and pyr5_CourseAddOK and pyr5_CourseSignalOK and pyr5_DelayOK and pyr5_DistOK

