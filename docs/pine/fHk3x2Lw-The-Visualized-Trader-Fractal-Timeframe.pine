
//@version=5
indicator("The Visualized Trader (Fractal Timeframe)", overlay=true, shorttitle="TDVT Fractal")

// Inputs
showBoxes = input.bool(true, title="Show Condition Boxes")
timeframe = input.timeframe("D", title="Comparison Timeframe")

// Current Timeframe Calculations
// 1. Trend Condition: using 50-SMA slope
sma50     = ta.sma(close, 50)
trendBull = sma50 > sma50[1]
trendBear = sma50 < sma50[1]

// 2. Stochastic Condition: using parameters 5, 3, 2
k_raw     = ta.stoch(close, high, low, 5)
k_smooth  = ta.sma(k_raw, 3)
d         = ta.sma(k_smooth, 2)
stochBull = k_smooth > k_smooth[1]
stochBear = k_smooth < k_smooth[1]

// 3. Momentum ("Mom"): modified MACD fast line from MACD (5,20,30)
[macdLine, signalLine, _] = ta.macd(close, 5, 20, 30)
momBull = macdLine > macdLine[1]
momBear = macdLine < macdLine[1]

// 4. Dad Condition: the MACD signal line
dadBull = signalLine > signalLine[1]
dadBear = signalLine < signalLine[1]

// 5. Price Change (PC): compare current close with previous close
pcBull = close > close[1]
pcBear = close < close[1]

// Higher Timeframe Calculations
// Fetch data from higher timeframe
htf_close = request.security(syminfo.tickerid, timeframe, close, lookahead=barmerge.lookahead_on)
htf_high  = request.security(syminfo.tickerid, timeframe, high, lookahead=barmerge.lookahead_on)
htf_low   = request.security(syminfo.tickerid, timeframe, low, lookahead=barmerge.lookahead_on)

// 1. Trend Condition (HTF)
htf_sma50     = ta.sma(htf_close, 50)
htf_trendBull = htf_sma50 > htf_sma50[1]
htf_trendBear = htf_sma50 < htf_sma50[1]

// 2. Stochastic Condition (HTF)
htf_k_raw     = ta.stoch(htf_close, htf_high, htf_low, 5)
htf_k_smooth  = ta.sma(htf_k_raw, 3)
htf_d         = ta.sma(htf_k_smooth, 2)
htf_stochBull = htf_k_smooth > htf_k_smooth[1]
htf_stochBear = htf_k_smooth < htf_k_smooth[1]

// 3. Momentum (HTF)
[htf_macdLine, htf_signalLine, _] = ta.macd(htf_close, 5, 20, 30)
htf_momBull = htf_macdLine > htf_macdLine[1]
htf_momBear = htf_macdLine < htf_macdLine[1]

// 4. Dad Condition (HTF)
htf_dadBull = htf_signalLine > htf_signalLine[1]
htf_dadBear = htf_signalLine < htf_signalLine[1]

// 5. Price Change (HTF)
htf_pcBull = htf_close > htf_close[1]
htf_pcBear = htf_close < htf_close[1]

// Overall alignment
allBull = trendBull and stochBull and momBull and dadBull and pcBull
allBear = trendBear and stochBear and momBear and dadBear and pcBear
htf_allBull = htf_trendBull and htf_stochBull and htf_momBull and htf_dadBull and htf_pcBull
htf_allBear = htf_trendBear and htf_stochBear and htf_momBear and htf_dadBear and htf_pcBear

// Plot alignment arrows
plotshape(allBull, title="Aligned Bullish (Current TF)", location=location.belowbar, style=shape.arrowup, color=color.blue, size=size.tiny, offset=0)
plotshape(allBear, title="Aligned Bearish (Current TF)", location=location.abovebar, style=shape.arrowdown, color=color.red, size=size.tiny, offset=0)
plotshape(htf_allBull, title="Aligned Bullish (HTF)", location=location.belowbar, style=shape.triangleup, color=color.green, size=size.tiny, offset=0)
plotshape(htf_allBear, title="Aligned Bearish (HTF)", location=location.abovebar, style=shape.triangledown, color=color.orange, size=size.tiny, offset=0)

// Display condition table with two rows
var condTable = table.new(position.top_right, 5, 2, border_width=1)
if showBoxes
    // Current Timeframe Row
    table.cell(condTable, 0, 0, "Trend", bgcolor=trendBull ? color.green : color.red, text_color=color.white, text_size=size.normal)
    table.cell(condTable, 1, 0, "Stoch", bgcolor=stochBull ? color.green : color.red, text_color=color.white, text_size=size.normal)
    table.cell(condTable, 2, 0, "Mom", bgcolor=momBull ? color.green : color.red, text_color=color.white, text_size=size.normal)
    table.cell(condTable, 3, 0, "Dad", bgcolor=dadBull ? color.green : color.red, text_color=color.white, text_size=size.normal)
    table.cell(condTable, 4, 0, "PC", bgcolor=pcBull ? color.green : color.red, text_color=color.white, text_size=size.normal)
    // Higher Timeframe Row
    table.cell(condTable, 0, 1, "Trend (HTF)", bgcolor=htf_trendBull ? color.green : color.red, text_color=color.white, text_size=size.normal)
    table.cell(condTable, 1, 1, "Stoch (HTF)", bgcolor=htf_stochBull ? color.green : color.red, text_color=color.white, text_size=size.normal)
    table.cell(condTable, 2, 1, "Mom (HTF)", bgcolor=htf_momBull ? color.green : color.red, text_color=color.white, text_size=size.normal)
    table.cell(condTable, 3, 1, "Dad (HTF)", bgcolor=htf_dadBull ? color.green : color.red, text_color=color.white, text_size=size.normal)
    table.cell(condTable, 4, 1, "PC (HTF)", bgcolor=htf_pcBull ? color.green : color.red, text_color=color.white, text_size=size.normal)