//@version=5
//@description  PulseLogic breath-strength & momentum-structure calculator
//@author       brian8u7op
//@version      3.6.1
library("PulseLogicLib", false)

// getBreathScore() → int (0–100)
// Combines MACD, RSI, CMF & OBV confluence into a single “breath” score.
export getBreathScore() =>
    // 1) MACD histogram signal
    [_, _, hist] = ta.macd(close, 12, 26, 9)
    bool macdBull = hist > 0

    // 2) RSI midpoint signal
    float rsi     = ta.rsi(close, 14)
    bool  rsiBull = rsi > 50

    // 3) Chaikin Money Flow (manual 20-period)
    float mfMult  = (high - low) > 0 ? ((close - low) - (high - close)) / (high - low) : 0
    float mfVol   = mfMult * volume
    float cumMF   = ta.cum(mfVol)
    float sumMF   = cumMF - nz(cumMF[20])
    float cumVol  = ta.cum(volume)
    float sumVol  = cumVol - nz(cumVol[20])
    float cmf     = sumVol != 0 ? sumMF / sumVol : 0
    bool  cmfBull = cmf > 0

    // 4) OBV momentum (manual calculation)
    float obvVal  = ta.cum(math.sign(ta.change(close)) * volume)
    bool  obvBull = obvVal > obvVal[1]

    // Count bullish signals
    int bullCount = (macdBull ? 1 : 0)
                  + (rsiBull  ? 1 : 0)
                  + (cmfBull  ? 1 : 0)
                  + (obvBull  ? 1 : 0)

    // Scale to 0–100
    math.round(bullCount * 25)


// hasGreenDot() → bool
// “Green Dot” if at least 3 of the 4 confluence signals are bullish
export hasGreenDot() =>
    // 1) MACD histogram signal (destructure before using)
    [_, _, hist2] = ta.macd(close, 12, 26, 9)
    int   count   = hist2 > 0 ? 1 : 0

    // 2) RSI midpoint signal
    count        += ta.rsi(close, 14) > 50 ? 1 : 0

    // 3) Manual CMF check
    float mfMult2 = (high - low) > 0 ? ((close - low) - (high - close)) / (high - low) : 0
    float mfVol2  = mfMult2 * volume
    float cumMF2  = ta.cum(mfVol2)
    float sumMF2  = cumMF2 - nz(cumMF2[20])
    float cumVol2 = ta.cum(volume)
    float sumVol2 = cumVol2 - nz(cumVol2[20])
    float cmf2    = sumVol2 != 0 ? sumMF2 / sumVol2 : 0
    count        += cmf2 > 0 ? 1 : 0

    // 4) OBV momentum check (manual)
    float obv2    = ta.cum(math.sign(ta.change(close)) * volume)
    count        += obv2 > obv2[1] ? 1 : 0

    count >= 3


// getTriangleColor() → string (“green”/“red”/“none”)
export getTriangleColor() =>
    float hi     = high
    float lo     = low
    float hiPrev = high[1]
    float loPrev = low[1]
    if lo > loPrev and hi > hiPrev
        "green"
    else if lo < loPrev and hi < hiPrev
        "red"
    else
        "none"