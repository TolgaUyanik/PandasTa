//@version=5
// @description Library for producing gap-adjusted price series that removes intraday gaps at market open
library("AdjCloseLib", overlay=false, dynamic_requests=true)

// ==================== INTERNAL HELPERS ====================

// @function Internal helper to determine if current bar is within session time (09:15-15:29)
// @param _bh Hour component of bar time
// @param _bm Minute component of bar time
// @returns Boolean indicating if time is within session
_isSessionTime(_bh, _bm) =>
    bool inS = ((_bh > 9) or (_bh == 9 and _bm >= 15)) and ((_bh < 15) or (_bh == 15 and _bm <= 29))
    inS

// @function Internal helper to calculate gap information for the current bar
// @param _gapThresholdPct Minimum gap percentage to trigger adjustment
// @returns Tuple of [gapValue, shouldAdjust, isInSession]
_calculateGapInfo(float _gapThresholdPct) =>
    // Get previous day's close using daily timeframe
    float dailyClose = request.security(syminfo.tickerid, "D", close, lookahead=barmerge.lookahead_off)
    float prevDayClose = dailyClose[1]
    
    // Extract time components
    int bh = hour(time)
    int bm = minute(time)
    bool is915 = (bh == 9) and (bm == 15)
    bool inSession = _isSessionTime(bh, bm)
    
    // Initialize gap values
    float gapVal = 0.0
    bool shouldAdjust = false
    
    // Detect and calculate gap at 09:15
    if is915 and not na(prevDayClose) and prevDayClose != 0.0
        gapVal := open - prevDayClose
        float gapPct = (gapVal / prevDayClose) * 100.0
        
        if math.abs(gapPct) >= _gapThresholdPct
            shouldAdjust := true
    else
        // Check if we're in a session that started with a gap
        // Look back to find the 09:15 bar of today
        bool foundGap = false
        float foundGapVal = 0.0
        
        if inSession
            // Use a simple approach: check if we're past 09:15 today
            int barsSince915 = 0
            for i = 0 to 100
                if (hour(time[i]) == 9 and minute(time[i]) == 15)
                    // Found today's 09:15
                    float prevClose = dailyClose[i+1]
                    if not na(prevClose) and prevClose != 0.0
                        float gap = open[i] - prevClose
                        float gapP = (gap / prevClose) * 100.0
                        if math.abs(gapP) >= _gapThresholdPct
                            foundGap := true
                            foundGapVal := gap
                    break
            
            if foundGap
                gapVal := foundGapVal
                shouldAdjust := true
    
    [gapVal, shouldAdjust, inSession]

// ==================== EXPORTED FUNCTIONS ====================

// @function Calculates gap-adjusted close price by detecting and removing gaps at market open (09:15)
// @param _gapThresholdPct Minimum gap size (in percentage) required to trigger adjustment. Example: 0.5 for 0.5%
// @returns Adjusted close price for the current bar (always returns a numeric value, never na)
// @details Detects gaps by comparing 09:15 open with previous day's close. If gap exceeds threshold,
//          subtracts the gap value from all bars between 09:15-15:29 inclusive. State resets after session close.
export get_adj_close(float _gapThresholdPct) =>
    [gapVal, shouldAdjust, inSession] = _calculateGapInfo(_gapThresholdPct)
    
    // Calculate and return adjusted close
    float result = close
    if shouldAdjust and inSession
        result := close - gapVal
    result

// @function Calculates gap-adjusted OHLC values by subtracting detected gap from all price components
// @param _gapThresholdPct Minimum gap size (in percentage) required to trigger adjustment. Example: 0.5 for 0.5%
// @returns Tuple of [adjustedOpen, adjustedHigh, adjustedLow, adjustedClose]
// @details Useful for calculating indicators (ATR, Heikin-Ashi, etc.) on gap-adjusted data.
//          Applies the same gap adjustment logic to all OHLC components simultaneously.
export get_adj_ohlc(float _gapThresholdPct) =>
    [gapVal, shouldAdjust, inSession] = _calculateGapInfo(_gapThresholdPct)
    
    // Initialize OHLC values
    float o = open
    float h = high
    float l = low
    float c = close
    
    // Apply adjustment if active during session
    if shouldAdjust and inSession
        o := open - gapVal
        h := high - gapVal
        l := low - gapVal
        c := close - gapVal
    
    [o, h, l, c]