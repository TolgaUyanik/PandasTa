//@version=6

// @description TODO: add library description here
library("MyLibraryPub")

// @function 与futu的MA系统，保持一致
export futu_ema(float src,int len) =>
    float _ema = na
    _ema := na(_ema[1]) ? src : (2 * src + (len - 1) * _ema[1]) / (len + 1)
    _ema := na(_ema) ? 0: _ema
    _ema

//@function 多头ema最大值
export MaxEMA(float c) =>
    math.max(math.max(math.max(math.max(math.max(math.max(math.max(futu_ema(c, 5),futu_ema(c, 10)),futu_ema(c, 21)),
    futu_ema(c, 34)),futu_ema(c, 55)),futu_ema(c, 89)),futu_ema(c, 144)),futu_ema(c, 233))

//@function 多头ema最大值，10
export MaxEMA10(float c) =>
    math.max(math.max(math.max(math.max(math.max(math.max(futu_ema(c, 10),futu_ema(c, 21)),
    futu_ema(c, 34)),futu_ema(c, 55)),futu_ema(c, 89)),futu_ema(c, 144)),futu_ema(c, 233))

// @function 空字符判定
export isEmpty(string inStr) =>
    rt = na(inStr) or inStr == ""
    rt

// @function 进入多头价格
export Bull_Max(string tk, string tf) =>
    string tmpTk = isEmpty(tk) ?  syminfo.tickerid : tk
    string tmpTf = isEmpty(tf) ? "D" : tf
    
    emax = request.security(tmpTk, tmpTf, MaxEMA(close))

// @function 多头天数
export Bull_Day(string tk, string tf) =>
    string tmpTk = isEmpty(tk) ?  syminfo.tickerid : tk
    string tmpTf = isEmpty(tf) ? "D" : tf
    
    request.security(tmpTk, tmpTf, ta.barssince(not(close >= MaxEMA(close))))

// @function 是否多头
export Bull(string tk, string tf) =>
    string tmpTk = isEmpty(tk) ?  syminfo.tickerid : tk
    string tmpTf = isEmpty(tf) ? "D" : tf
    
    request.security(tmpTk, tmpTf, close >= MaxEMA(close))

// @function 是否多头10
export Bull10(string tk, string tf) =>
    string tmpTk = isEmpty(tk) ?  syminfo.tickerid : tk
    string tmpTf = isEmpty(tf) ? "D" : tf
    
    request.security(tmpTk, tmpTf, close >= MaxEMA10(close))

// @function 是不是杠杆etf
calc_isLeveraged() =>
    // 用圆括号包裹多行逻辑，这是最稳妥的解决办法
    bool leveraged = (
        str.contains(syminfo.description, "3X") or
        str.contains(syminfo.description, "2X") or
        str.contains(syminfo.description, "Bull") or
        str.contains(syminfo.description, "Bear") or
        str.contains(syminfo.description, "Ultra")
        )
    leveraged

// @function 距离多头最大值判定
calc_type2DivCoef() =>
    float coef = 1
    if syminfo.type == "index"
        coef := 0.015
    else if syminfo.type == "fund"
        if calc_isLeveraged()
            coef := 0.03
        else
            coef := 0.015
    else if syminfo.type == "stock"
        coef := 0.03
    else if syminfo.type == "futures"
        coef := 0.03
    coef

//@function 返回当前状态，B、S、OB、B1
calc_status(int Days) =>
    // 原始偏离度计算
    current_dev = (close - futu_ema(close, 5)) / futu_ema(close, 5)
    //可以编译过的Days
    DaysForCompile = math.max(nz(Days, 1),1)
    coef = calc_type2DivCoef()
    // 原始阈值公式
    threshold = Days < 2 ? (1+coef) : (1+coef + math.max((math.abs(math.sum(current_dev, DaysForCompile) / DaysForCompile) - coef) / 2, 0))
    // 原始状态判定
    max_ema_val = MaxEMA(close)
    res = close <= threshold * max_ema_val ? (close >= max_ema_val ? (Days==1 ? "B1":"B") : "S") : "OB"
    res

//@function 内置，可以买最大值，离均线不太远
calc_BuyMax(int Days) =>
    // 原始偏离度计算
    current_dev = (close - futu_ema(close, 5)) / futu_ema(close, 5)
    //可以编译过的Days
    DaysForCompile = math.max(nz(Days, 1),1)
    coef = calc_type2DivCoef()
    // 原始阈值公式
    threshold = Days < 2 ? (1+coef) : (1+coef + math.max((math.abs(math.sum(current_dev, DaysForCompile) / DaysForCompile) - coef) / 2, 0))
    // 原始状态判定
    max_ema_val = MaxEMA(close)
    res = threshold * max_ema_val

