    string tmpTk = isEmpty(tk) ? syminfo.tickerid : tk
    string tmpTf = isEmpty(tf) ? "D" : tf
    // avrDev = math.abs(ta.sum((close-futu_ema(close,5))/futu_ema(close,5),Days))/Days
    // Status = request.security(tmpTk, tmpTf, close <= (Days<2?1.03:(1.03+math.max((math.abs(ta.sum((close-futu_ema(close,5))/futu_ema(close,5), Days))/Days-0.03)/2,0)))*MaxEMA(close) ?  (close >= MaxEMA(close) ? "B":"S") :"H" )
    request.security(tmpTk, tmpTf, calc_BuyMax(ta.barssince(not(close >= MaxEMA(close)))))

//@function 当前状态
export Bull_BuyStatus(string tk, string tf) =>
    string tmpTk = isEmpty(tk) ? syminfo.tickerid : tk
    string tmpTf = isEmpty(tf) ? "D" : tf
    // avrDev = math.abs(ta.sum((close-futu_ema(close,5))/futu_ema(close,5),Days))/Days
    // Status = request.security(tmpTk, tmpTf, close <= (Days<2?1.03:(1.03+math.max((math.abs(ta.sum((close-futu_ema(close,5))/futu_ema(close,5), Days))/Days-0.03)/2,0)))*MaxEMA(close) ?  (close >= MaxEMA(close) ? "B":"S") :"H" )
    request.security(tmpTk, tmpTf, calc_status(ta.barssince(not(close >= MaxEMA(close)))))

//@function 涨幅
export pct_D20(string tk, string tf) =>
    string tmpTk = isEmpty(tk) ?  syminfo.tickerid : tk
    string tmpTf = isEmpty(tf) ? "D" : tf

    request.security(tmpTk, tmpTf, (close-close[20])/close[20]*100)

