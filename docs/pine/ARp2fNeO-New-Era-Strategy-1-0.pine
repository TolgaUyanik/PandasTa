//@version=6
strategy("New Era Strategy 1.0", overlay = true, margin_long = 100, margin_short = 100)

tradeTime = time(timeframe.period, "0915-1500")
exitTime = time(timeframe.period, "1510-1515")

slMaxPointsPercent = input.float(0, "SL Max Points %", minval = 0)
tgtRatio = input.float(2, "Target 1", minval = 0, inline = "T1") 

// ─── Base Indicators ───
rsi       = ta.rsi(close, 5)
rsiSmooth = ta.sma(rsi, 5)

cci       = ta.cci(close, 14)
cciSmooth = ta.sma(cci, 5)

ema09     = ta.ema(close, 9)
ema33     = ta.ema(close, 33)
emaSmooth = ta.sma(ema33, 9)

hma18     = ta.hma(close, 18)
hma22     = ta.hma(close, 22)
hma27     = ta.hma(close, 27)

// ─── PE Formation Conditions ───
condA_PE = emaSmooth < ema33 and ema33 < hma27 and hma27 < hma22 and hma22 < hma18
condB_PE = rsi > 65 and rsiSmooth > 60
condC_PE = cci > 100 and cciSmooth > 80

// ─── CE Formation Conditions ───
condA_CE = emaSmooth > ema33 and ema33 > hma27 and hma27 > hma22 and hma22 > hma18
condB_CE = rsi < 25 and rsiSmooth < 30
condC_CE = cci < -50 and cciSmooth < -20

Signal_PE = false
Signal_CE = false
Formation_PE = condA_PE and condB_PE and condC_PE and not na(tradeTime)
Formation_CE = condA_CE and condB_CE and condC_CE and not na(tradeTime)

// ─── Variables to track Formation candle high/low ───
var float sigLow  = na
var float sigHigh = na
var float sl = na
var bool  active_PE  = false
var bool  active_CE  = false
var bool  TradeRunning_PE  = false
var bool  TradeRunning_CE  = false

var Sl = 0.0
var Entry = 0.0
var Target = 0.0

if strategy.position_size > 0 and not na(exitTime)
    strategy.close_all("Day Close")

if strategy.position_size == 0
    TradeRunning_PE := false
    TradeRunning_CE := false
    Sl := na
    Entry := na
    Target := na

if not TradeRunning_PE and not na(tradeTime)    
    if Formation_PE
        if Formation_PE[1]
            if (high > sigHigh or low < sigLow) and close > sigLow
                sigLow  := low
                sigHigh := high
                active_PE  := true
        else
            sigLow  := low
            sigHigh := high
            active_PE  := true

    // Update low/high while active
    if active_PE and close > sigLow
        if high > sigHigh
            sigLow  := low
            sigHigh := high    
        else if low < sigLow 
            sigLow  := low
            sigHigh := high
        else if low > sigLow and high < sigHigh 
            sigLow  := low
            sigHigh := high

    // ─── Entry Condition ───
    // Wait until captured high is broken and candle closes above it
    Signal_PE := active_PE and close < sigLow and not TradeRunning_PE

    if Signal_PE
        // Stop loss = previous captured low
        sl := math.min(high[1], high)
        entry = close
        slPoints = ( sl - entry )
        if slMaxPointsPercent > 0
            slMaxPoints = (entry/100) * slMaxPointsPercent
            if slPoints > slMaxPoints
                sl := high
                slPoints := (sl - entry)
                if slPoints > slMaxPoints
                    sl := 0
        // Target
        target = entry - (tgtRatio * slPoints)
                
        if sl > 0
            // Enter next candle open
            strategy.entry("Short", strategy.short, qty = 1)
            TradeRunning_PE := true
            strategy.exit("TP/SL 1", "Short", qty = 1, stop = sl, limit = target)
            
            Sl := sl
            Entry := close
            Target := target

            // Convert to string for display
            // sl_str     = str.tostring(sl, format.mintick)
            // slPoints_str     = str.tostring(slPoints, format.mintick)
            // target_str = str.tostring(target, format.mintick)
            // targetPoints_str = str.tostring(slPoints*2, format.mintick)
            // label.new(bar_index, math.min(hma18 - 20, low - 20), "SL: " + sl_str + "(" +  slPoints_str + ")" + "\nTarget: " + target_str + "(" +  targetPoints_str + ")",
            //         style=label.style_label_up, color=color.green, textcolor=color.white)
            // Reset
            active_PE := false
            sigLow := na
            sigHigh := na

if not TradeRunning_CE and not na(tradeTime)
    if Formation_CE
        if Formation_CE[1]
            if (low < sigLow or high > sigHigh) and close < sigHigh
                sigLow  := low
                sigHigh := high
                active_CE  := true
        else
            sigLow  := low
            sigHigh := high
            active_CE  := true

    // Update low/high while active
    if active_CE and close < sigHigh
        if low < sigLow
            sigLow  := low
            sigHigh := high    
        else if high > sigHigh 
            sigLow  := low
            sigHigh := high
        else if high < sigHigh and low > sigLow 
            sigLow  := low
            sigHigh := high

    // ─── Entry Condition ───
    // Wait until captured high is broken and candle closes above it
    Signal_CE := active_CE and close > sigHigh and not TradeRunning_CE

    if Signal_CE
        // Stop loss = previous captured low
        sl := math.min(low[1], low)
        entry = close
        slPoints = (entry - sl)
        if slMaxPointsPercent > 0
            slMaxPoints = (entry/100) * slMaxPointsPercent
            if slPoints > slMaxPoints
                sl := low
                slPoints := (entry - sl)
                if slPoints > slMaxPoints
                    sl := 0
        // Target
        target = entry + (tgtRatio * slPoints)
        
        if sl > 0
            // Enter next candle open
            strategy.entry("Long", strategy.long, qty = 1)
            TradeRunning_CE := true
            strategy.exit("TP/SL 1", "Long", qty = 1, stop = sl, limit = target)
            
            Sl := sl
            Entry := close
            Target := target

            // Convert to string for display
            // sl_str     = str.tostring(sl, format.mintick)
            // slPoints_str     = str.tostring(slPoints, format.mintick)
            // target_str = str.tostring(target, format.mintick)
            // targetPoints_str = str.tostring(slPoints*2, format.mintick)
            // label.new(bar_index, math.min(hma18 - 20, low - 20), "SL: " + sl_str + "(" +  slPoints_str + ")" + "\nTarget: " + target_str + "(" +  targetPoints_str + ")",
            //         style=label.style_label_up, color=color.green, textcolor=color.white)
            // Reset
            active_CE := false
            sigLow := na
            sigHigh := na


// ─── Plotting ───
plot(ema09,     "EMA 9",       color=color.rgb(68, 57, 224), linewidth = 2)
plot(ema33,     "EMA 33",       color=color.green,  style=plot.style_stepline)
plot(emaSmooth, "EMA Smooth 9", color=color.orange, style=plot.style_stepline)
plot(hma18,     "HMA 18",       color=color.aqua,   style=plot.style_stepline)
plot(hma22,     "HMA 22",       color=color.yellow, style=plot.style_stepline)
plot(hma27,     "HMA 27",       color=color.red,    style=plot.style_stepline)

plotshape(Formation_PE, title="Formation", style=shape.arrowdown, location=location.abovebar, color=color.rgb(186, 204, 209, 16), size=size.large, text="")
plotshape(Signal_PE, title="Signal", style=shape.triangledown, location=location.abovebar, color=color.rgb(55, 250, 71), size=size.normal, text="Signal")

plotshape(Formation_CE, title="Formation", style=shape.arrowup, location=location.belowbar, color=color.rgb(186, 204, 209, 16), size=size.large, text="")
plotshape(Signal_CE, title="Signal", style=shape.triangleup, location=location.belowbar, color=color.rgb(55, 250, 71), size=size.normal, text="Signal")

hLineSL = plot(Sl, 'SL', color.red, style = plot.style_linebr, offset = 1)
hlineEntry =  plot(Entry, 'Entry', color.blue, style = plot.style_linebr, offset = 1)
hLineTgt = plot(Target, 'Target', color.green, style = plot.style_linebr, offset = 1)

fill(hlineEntry, hLineTgt, color.rgb(86, 253, 184, 80), title = "Target Range")
fill(hlineEntry, hLineSL, color.rgb(255, 84, 84, 80), title = "SL Range")