//@version=6
strategy("TIS - BTC Momentum + Confluencia",
     overlay                 = true,
     initial_capital         = 100000,
     default_qty_type        = strategy.fixed,
     commission_type         = strategy.commission.percent,
     commission_value        = 0.0,
     slippage                = 5,
     process_orders_on_close = true,
     calc_on_every_tick      = false)

// ---- Inputs ----
maLen     = input.int(50,    "Media de tendencia (SMA)", minval = 2)
streakLen = input.int(3,     "Velas verdes para momentum", minval = 2)
atrLen    = input.int(14,    "ATR (largo)", minval = 1)
atrMult   = input.float(3.0, "ATR - distancia de riesgo", step = 0.5)
riskPct   = input.float(1.0, "Riesgo por trade (% equity)", step = 0.1)
tailMult  = input.float(2.0, "Corte de cola (x ATR adverso)", step = 0.5)
confMult  = input.float(1.5, "Multiplicador por confluencia", step = 0.1)
htf       = input.timeframe("1D", "Timeframe mayor (confluencia)")
capPct    = input.float(40,  "Tope de exposicion (% equity)", step = 5)

// ---- Indicadores ----
ma      = ta.sma(close, maLen)
atr     = ta.atr(atrLen)
trendUp = close > ma

// Momentum = racha de N velas verdes
var int green = 0
green := close > open ? green + 1 : 0
mom = green >= streakLen

// Momentum en el timeframe mayor (diario), sin mirar el futuro
f_htfMom() =>
    var int g = 0
    g := close > open ? g + 1 : 0
    g >= streakLen
htfMom = request.security(syminfo.tickerid, htf, f_htfMom(), lookahead = barmerge.lookahead_off)

// ---- CONFLUENCIA: entra solo si 4h Y diario tienen momentum ----
longSignal = trendUp and mom and htfMom

// ---- Sizing por riesgo (ATR) + confluencia, con tope ----
riskDollars = strategy.equity * riskPct / 100.0
stopDist    = atr * atrMult
qtyRaw      = stopDist > 0 ? (riskDollars / stopDist) * confMult : 0.0
qtyCap      = close > 0 ? (strategy.equity * capPct / 100.0) / close : 0.0
qty         = math.min(qtyRaw, qtyCap)

// ---- Entradas / Salidas ----
if longSignal and strategy.position_size == 0 and qty > 0
    strategy.entry("LONG", strategy.long, qty = qty)

if strategy.position_size > 0 and close < ma
    strategy.close("LONG", comment = "Giro de media")

if strategy.position_size > 0 and (open - close) > tailMult * atr
    strategy.close("LONG", comment = "Corte de cola")

// ---- Visual ----
plot(ma, "SMA tendencia", color = color.new(color.orange, 0), linewidth = 2)
plotshape(longSignal and strategy.position_size == 0, "Compra",
     style = shape.triangleup, location = location.belowbar,
     color = color.new(#26d97e, 0), size = size.small)
bgcolor(htfMom ? color.new(#26d97e, 92) : na, title = "Momentum diario")