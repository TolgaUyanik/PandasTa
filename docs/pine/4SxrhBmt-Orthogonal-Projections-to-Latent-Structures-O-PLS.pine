//@version=5
indicator("Orthogonal Projections to Latent Structures (O-PLS)", overlay=false, max_lines_count=15, max_labels_count=0)

// 📥 Inputs
lookback = input.int(100, title="Lookback Period", minval=10, maxval=500)
// User-definable external asset symbol, default to BINANCE:BTCUSDT
string external_asset_symbol = input.symbol("BINANCE:BTCUSDT", title="External Asset Symbol")

// NEW: Checkboxes for Relevance Score Plot Visibility
bool show_open_price_plot = input.bool(true, title="Plot: Open Price Relevance")
bool show_close_price_plot = input.bool(true, title="Plot: Close Price Relevance")
bool show_low_price_plot = input.bool(true, title="Plot: Low Price Relevance")
bool show_high_price_plot = input.bool(true, title="Plot: High Price Relevance")
bool show_volume_plot = input.bool(true, title="Plot: Volume Relevance")
bool show_vol_price_plot = input.bool(true, title="Plot: Volume/Price Relevance")
bool show_vol_current_prev_plot = input.bool(true, title="Plot: Vol Current+Prev Relevance")
bool show_close_7_plot = input.bool(true, title="Plot: Close 7 Periods Ago Relevance")
bool show_close_14_plot = input.bool(true, title="Plot: Close 14 Periods Ago Relevance")
bool show_mfi_plot = input.bool(true, title="Plot: MFI Relevance")
bool show_sma5_plot = input.bool(true, title="Plot: SMA5 Relevance")
bool show_rsi16_plot = input.bool(true, title="Plot: RSI16 Relevance")
bool show_rsi4_plot = input.bool(true, title="Plot: RSI4 Relevance")
bool show_rsi14_plot = input.bool(true, title="Plot: RSI14 Relevance")
bool show_external_asset_plot = input.bool(true, title="Plot: External Asset Close Relevance")


// 📡 Fetch Data
var float open_price = open
var float close_price = close
var float low_price = low
var float high_price = high
var float volume_val = volume
var float vol_price = volume != 0 ? close / volume : na
var float vol_current_prev = volume + nz(volume[1])
var float close_7_ago = nz(close[7])
var float close_14_ago = nz(close[14])
var float mfi = ta.mfi(close, 14)
var float close_5_sma = ta.sma(close, 5)
var float close_16_rsi = ta.rsi(close, 16)
var float close_4_rsi = ta.rsi(close, 4)
var float close_14_rsi = ta.rsi(close, 14)

float external_asset_close = request.security(external_asset_symbol, timeframe.period, close)

string cleaned_asset_name = str.replace(external_asset_symbol, "BINANCE:", "")

// 📊 Arrays for Variables
var float[] x1 = array.new_float(lookback)
var float[] x2 = array.new_float(lookback)
var float[] x3 = array.new_float(lookback)
var float[] x4 = array.new_float(lookback)
var float[] x5 = array.new_float(lookback)
var float[] x6 = array.new_float(lookback)
var float[] x7 = array.new_float(lookback)
var float[] x8 = array.new_float(lookback)
var float[] x9 = array.new_float(lookback)
var float[] x10 = array.new_float(lookback)
var float[] x11 = array.new_float(lookback)
var float[] x12 = array.new_float(lookback)
var float[] x13 = array.new_float(lookback)
var float[] x14 = array.new_float(lookback)
var float[] x15 = array.new_float(lookback)
var float[] y = array.new_float(lookback)

// 📈 Populate Arrays
for i = 0 to lookback - 1
    array.set(x1, i, nz(open[i]))
    array.set(x2, i, nz(close[i]))
    array.set(x3, i, nz(low[i]))
    array.set(x4, i, nz(high[i]))
    array.set(x5, i, nz(volume[i]))

    float val_x6 = na
    if volume[i] != 0
        val_x6 := close[i] / volume[i]
    else
        val_x6 := 0.0
    array.set(x6, i, val_x6)

    array.set(x7, i, bar_index >= 1 ? nz(volume[i] + nz(volume[i + 1])) : na)
    array.set(x8, i, bar_index >= 7 ? nz(close[i + 7]) : na)
    array.set(x9, i, bar_index >= 14 ? nz(close[i + 14]) : na)
    array.set(x10, i, bar_index >= 14 ? nz(ta.mfi(close[i], 14)) : na)
    array.set(x11, i, bar_index >= 4 ? nz(ta.sma(close[i], 5)) : na)
    array.set(x12, i, bar_index >= 16 ? nz(ta.rsi(close[i], 16)) : na)
    array.set(x13, i, bar_index >= 4 ? nz(ta.rsi(close[i], 4)) : na)
    array.set(x14, i, bar_index >= 14 ? nz(ta.rsi(close[i], 14)) : na)
    array.set(x15, i, external_asset_close[i])
    array.set(y, i, i >= 1 ? nz(close[i - 1]) : na)

// 🧮 Standardize Data (Z-scores)
type FloatArray
    array<float> data

x_arrays = array.new<FloatArray>(15, na)
array.set(x_arrays, 0, FloatArray.new(x1))
array.set(x_arrays, 1, FloatArray.new(x2))
array.set(x_arrays, 2, FloatArray.new(x3))
array.set(x_arrays, 3, FloatArray.new(x4))
array.set(x_arrays, 4, FloatArray.new(x5))
array.set(x_arrays, 5, FloatArray.new(x6))
array.set(x_arrays, 6, FloatArray.new(x7))
array.set(x_arrays, 7, FloatArray.new(x8))
array.set(x_arrays, 8, FloatArray.new(x9))
array.set(x_arrays, 9, FloatArray.new(x10))
array.set(x_arrays, 10, FloatArray.new(x11))
array.set(x_arrays, 11, FloatArray.new(x12))
array.set(x_arrays, 12, FloatArray.new(x13))
array.set(x_arrays, 13, FloatArray.new(x14))
array.set(x_arrays, 14, FloatArray.new(x15))

x_means = array.new_float(15)
x_stds = array.new_float(15)
x_norm = array.new<FloatArray>(15, na)

for i = 0 to 14
    x_array = array.get(x_arrays, i).data
    mean_val = array.avg(x_array)
    std_val = array.stdev(x_array)
    array.set(x_means, i, mean_val)
    array.set(x_stds, i, std_val)
    norm_array = array.new_float(lookback)
    for j = 0 to lookback - 1
        val = array.get(x_array, j)
        array.set(norm_array, j, std_val != 0 ? (val - mean_val) / std_val : 0)
    array.set(x_norm, i, FloatArray.new(norm_array))

y_mean = array.avg(y)
y_std = array.stdev(y)
y_norm = array.new_float(lookback)
for i = 0 to lookback - 1
    val = array.get(y, i)
    array.set(y_norm, i, y_std != 0 ? (val - y_mean) / y_std : 0)

// 🧮 Calculate Correlations (Proxy for O-PLS Relevance)
relevance_scores = array.new_float(15)
for i = 0 to 14
    x_array = array.get(x_norm, i).data
    corr_sum = 0.0
    count = 0
    for j = 0 to lookback - 1
        x_val = array.get(x_array, j)
        y_val = array.get(y_norm, j)
        if not na(x_val) and not na(y_val)
            corr_sum := corr_sum + x_val * y_val
            count := count + 1
    corr = count > 0 ? math.abs(corr_sum / count) : 0
    score = math.min(10, math.max(0, corr * 10))
    array.set(relevance_scores, i, score)

// 🎨 Plot Relevance Scores (Visibility controlled by checkboxes)
// FIX: Using plot.display.all and plot.display.none for the 'display' argument
plot(array.get(relevance_scores, 0), title="Open Price", color=color.red, display=show_open_price_plot ? display.all : display.none)
plot(array.get(relevance_scores, 1), title="Close Price", color=color.blue, display=show_close_price_plot ? display.all : display.none)
plot(array.get(relevance_scores, 2), title="Low Price", color=color.green, display=show_low_price_plot ? display.all : display.none)
plot(array.get(relevance_scores, 3), title="High Price", color=color.navy, display=show_high_price_plot ? display.all : display.none)
plot(array.get(relevance_scores, 4), title="Volume", color=color.purple, display=show_volume_plot ? display.all : display.none)
plot(array.get(relevance_scores, 5), title="Volume/Price", color=color.orange, display=show_vol_price_plot ? display.all : display.none)
plot(array.get(relevance_scores, 6), title="Vol Current+Prev", color=color.teal, display=show_vol_current_prev_plot ? display.all : display.none)
plot(array.get(relevance_scores, 7), title="Close 7 Periods Ago", color=color.fuchsia, display=show_close_7_plot ? display.all : display.none)
plot(array.get(relevance_scores, 8), title="Close 14 Periods Ago", color=color.aqua, display=show_close_14_plot ? display.all : display.none)
plot(array.get(relevance_scores, 9), title="MFI", color=color.maroon, display=show_mfi_plot ? display.all : display.none)
plot(array.get(relevance_scores, 10), title="SMA5", color=color.gray, display=show_sma5_plot ? display.all : display.none)
plot(array.get(relevance_scores, 11), title="RSI16", color=color.black, display=show_rsi16_plot ? display.all : display.none)
plot(array.get(relevance_scores, 12), title="RSI4", color=color.fuchsia, display=show_rsi4_plot ? display.all : display.none)
plot(array.get(relevance_scores, 13), title="RSI14", color=color.silver, display=show_rsi14_plot ? display.all : display.none)
plot(array.get(relevance_scores, 14), title="External Asset Close Relevance", color=color.lime, display=show_external_asset_plot ? display.all : display.none)

// 📋 Sorted Table
var table t = table.new(position.top_right, 2, 16, border_width=1, border_color=color.white)
if barstate.isconfirmed
    table.clear(t, 0, 0)
    // Create array of indices
    indices = array.new_int(15)
    for i = 0 to 14
        array.set(indices, i, i)
    
    // Custom sort indices by relevance_scores in descending order
    for i = 0 to 13
        for j = i + 1 to 14
            if array.get(relevance_scores, array.get(indices, i)) < array.get(relevance_scores, array.get(indices, j))
                // Swap indices
                temp = array.get(indices, i)
                array.set(indices, i, array.get(indices, j))
                array.set(indices, j, temp)
    
    // Table headers
    table.cell(t, 0, 0, "Variable", bgcolor=color.white, text_color=color.black)
    table.cell(t, 1, 0, "Relevance", bgcolor=color.white, text_color=color.black)
    
    // Variable names and colors
    var string[] var_names = array.new_string(15)
    var color[] plot_colors = array.new_color(15)
    array.set(var_names, 0, "Open Price")
    array.set(var_names, 1, "Close Price")
    array.set(var_names, 2, "Low Price")
    array.set(var_names, 3, "High Price")
    array.set(var_names, 4, "Volume")
    array.set(var_names, 5, "Volume/Price")
    array.set(var_names, 6, "Vol Current+Prev")
    array.set(var_names, 7, "Close 7 Periods Ago")
    array.set(var_names, 8, "Close 14 Periods Ago")
    array.set(var_names, 9, "MFI")
    array.set(var_names, 10, "SMA5")
    array.set(var_names, 11, "RSI16")
    array.set(var_names, 12, "RSI4")
    array.set(var_names, 13, "RSI14")
    
    // Dynamically set the external asset name in the table
    array.set(var_names, 14, cleaned_asset_name + " Close")

    array.set(plot_colors, 0, color.red)
    array.set(plot_colors, 1, color.blue)
    array.set(plot_colors, 2, color.green)
    array.set(plot_colors, 3, color.navy)
    array.set(plot_colors, 4, color.purple)
    array.set(plot_colors, 5, color.orange)
    array.set(plot_colors, 6, color.teal)
    array.set(plot_colors, 7, color.fuchsia)
    array.set(plot_colors, 8, color.aqua)
    array.set(plot_colors, 9, color.maroon)
    array.set(plot_colors, 10, color.gray)
    array.set(plot_colors, 11, color.black)
    array.set(plot_colors, 12, color.fuchsia)
    array.set(plot_colors, 13, color.silver)
    array.set(plot_colors, 14, color.lime)
    
    // Fill table
    for i = 0 to 14
        idx = array.get(indices, i)
        table.cell(t, 0, i + 1, array.get(var_names, idx), bgcolor=color.white, text_color=array.get(plot_colors, idx))
        table.cell(t, 1, i + 1, str.format("{0,number,#.##}", array.get(relevance_scores, idx)), bgcolor=color.white, text_color=array.get(plot_colors, idx))