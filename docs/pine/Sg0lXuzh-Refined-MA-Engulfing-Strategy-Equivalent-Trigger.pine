//@version=6
//@version=6
indicator("Refined MA + Engulfing (Strategy-Equivalent Trigger)", overlay=true)

// === INPUTS ===
ma1Len = input.int(66, title="MA1 Length")
ma2Len = input.int(85, title="MA2 Length")
cooldownBars = input.int(15, title="Directional Cooldown (bars)")

// === MOVING AVERAGES ===
ma1 = ta.sma(close, ma1Len)
ma2 = ta.sma(close, ma2Len)
plot(ma1, color=color.orange, title="MA 66")
plot(ma2, color=color.blue, title="MA 85")

aboveMAs = close > ma1 and close > ma2
belowMAs = close < ma1 and close < ma2

// === ENGULFING CANDLE LOGIC ===
bullEngulf = close > open and close > close[1] and open <= close[1]
bearEngulf = close < open and close < close[1] and open >= close[1]

// === SWING STRUCTURE LOGIC ===
pivotHigh = ta.pivothigh(high, 2, 2)
pivotLow  = ta.pivotlow(low, 2, 2)

var float lastSwingHigh = na
var float lastSwingLow = na
var string structureState = "none"
var bool structureConfirmed = false

if not na(pivotHigh)
    lastSwingHigh := pivotHigh
if not na(pivotLow)
    lastSwingLow := pivotLow

bullBreakConfirmed = not na(lastSwingHigh) and close > lastSwingHigh
bearBreakConfirmed = not na(lastSwingLow) and close < lastSwingLow

if bullBreakConfirmed
    structureState := "bullish"
    structureConfirmed := true
if bearBreakConfirmed
    structureState := "bearish"
    structureConfirmed := true

bullishStructure = structureState == "bullish" and structureConfirmed
bearishStructure = structureState == "bearish" and structureConfirmed

// === FIB PLACEHOLDER ===
inFibLong  = true
inFibShort = true

// === CONFLUENCE SCORING ===
longConfluence  = (bullEngulf ? 1 : 0) + (bullishStructure ? 1 : 0) + (aboveMAs ? 1 : 0) + (inFibLong ? 1 : 0)
shortConfluence = (bearEngulf ? 1 : 0) + (bearishStructure ? 1 : 0) + (belowMAs ? 1 : 0) + (inFibShort ? 1 : 0)

longReady  = longConfluence >= 2
shortReady = shortConfluence >= 2

// === COOLDOWN CONTROL ===
var int lastLongBar = na
var int lastShortBar = na

canLong  = na(lastLongBar)  or (bar_index - lastLongBar  >= cooldownBars)
canShort = na(lastShortBar) or (bar_index - lastShortBar >= cooldownBars)

// === FINAL CONDITIONS ===
longCondition  = longReady  and canLong  and bullishStructure and aboveMAs
shortCondition = shortReady and canShort and bearishStructure and belowMAs

// === SIGNAL TRIGGERS ===
plotshape(longCondition, title="Long Entry", location=location.belowbar, style=shape.triangleup, size=size.small, color=color.green)
plotshape(shortCondition, title="Short Entry", location=location.abovebar, style=shape.triangledown, size=size.small, color=color.red)

// === COOLDOWN STATE UPDATE ===
if (longCondition)
    lastLongBar := bar_index
if (shortCondition)
    lastShortBar := bar_index