//@version=6
indicator(
     "Log Regression Regime Channel",
     "LogReg Regime",
     overlay = true,
     max_bars_back = 500,
     max_lines_count = 20,
     max_labels_count = 20)

//=============================================================================
// INPUT GROUPS
//=============================================================================

string GROUP_MODEL   = "Regression Model"
string GROUP_CHANNEL = "Residual Channel"
string GROUP_REGIME  = "Regime Detection"
string GROUP_MOM     = "Directional Momentum"
string GROUP_VISUAL  = "Visuals"
string GROUP_TABLE   = "Dashboard"

//=============================================================================
// INPUTS
//=============================================================================

int regressionLength = input.int(
     120,
     "Regression Length",
     minval = 30,
     maxval = 500,
     group = GROUP_MODEL,
     tooltip = "Number of bars used for the log-linear regression model.")

int channelLength = input.int(
     100,
     "Visible Channel Length",
     minval = 20,
     maxval = 500,
     group = GROUP_MODEL,
     tooltip = "Number of recent bars used to draw the visible regression channel.")

float innerDeviation = input.float(
     1.0,
     "Inner Residual Band",
     minval = 0.25,
     step = 0.25,
     group = GROUP_CHANNEL,
     tooltip = "Inner channel boundary measured in standard deviations of log-regression residuals.")

float outerDeviation = input.float(
     2.0,
     "Outer Residual Band",
     minval = 0.5,
     step = 0.25,
     group = GROUP_CHANNEL,
     tooltip = "Outer channel boundary measured in standard deviations of log-regression residuals.")

//-----------------------------------------------------------------------------
// Regime hysteresis
//-----------------------------------------------------------------------------

float enterQuality = input.float(
     45.0,
     "Trend Entry Quality",
     minval = 0.0,
     maxval = 100.0,
     step = 1.0,
     group = GROUP_REGIME,
     tooltip = "Minimum R-squared required to enter a Bullish or Bearish regime.")

float exitQuality = input.float(
     35.0,
     "Trend Exit Quality",
     minval = 0.0,
     maxval = 100.0,
     step = 1.0,
     group = GROUP_REGIME,
     tooltip = "Minimum R-squared required to preserve an existing directional regime.")

float enterStrength = input.float(
     1.25,
     "Trend Entry Strength",
     minval = 0.1,
     step = 0.05,
     group = GROUP_REGIME,
     tooltip = "Minimum fitted move, measured in residual deviations, required to enter a directional regime.")

float exitStrength = input.float(
     0.90,
     "Trend Exit Strength",
     minval = 0.1,
     step = 0.05,
     group = GROUP_REGIME,
     tooltip = "Minimum fitted move required to preserve an existing directional regime.")

//-----------------------------------------------------------------------------
// Momentum inputs
//-----------------------------------------------------------------------------

int momentumFast = input.int(
     5,
     "Momentum Length",
     minval = 2,
     maxval = 50,
     group = GROUP_MOM,
     tooltip = "Smoothing period for short-term directional price momentum.")

int momentumBaseline = input.int(
     18,
     "Momentum Baseline",
     minval = 5,
     maxval = 100,
     group = GROUP_MOM,
     tooltip = "Period used to estimate normal price and residual movement.")

int momentumNoiseLength = input.int(
     40,
     "Momentum Noise Window",
     minval = 10,
     maxval = 200,
     group = GROUP_MOM,
     tooltip = "Period used to estimate normal variation of the combined momentum score.")

float momentumBaseThreshold = input.float(
     0.35,
     "Minimum Momentum Threshold",
     minval = 0.05,
     maxval = 2.0,
     step = 0.05,
     group = GROUP_MOM,
     tooltip = "Minimum normalized momentum required for a Bullish or Bearish classification.")

float momentumNoiseMultiplier = input.float(
     0.30,
     "Adaptive Noise Multiplier",
     minval = 0.0,
     maxval = 2.0,
     step = 0.05,
     group = GROUP_MOM,
     tooltip = "Raises the momentum threshold when the momentum score becomes unstable.")

float accelerationThreshold = input.float(
     0.35,
     "Acceleration Threshold",
     minval = 0.05,
     maxval = 2.0,
     step = 0.05,
     group = GROUP_MOM,
     tooltip = "Minimum standardized change in regression slope required to classify the trend as strengthening or cooling.")

//-----------------------------------------------------------------------------
// Visual inputs
//-----------------------------------------------------------------------------

bool showMidLine = input.bool(
     true,
     "Show Regression Midline",
     group = GROUP_VISUAL)

bool showChannelFill = input.bool(
     true,
     "Show Channel Ribbons",
     group = GROUP_VISUAL)

bool showMomentumFill = input.bool(
     true,
     "Show Momentum Fill",
     group = GROUP_VISUAL)

bool showRegimeLabel = input.bool(
     true,
     "Show Regime Label",
     group = GROUP_VISUAL)

color bullColor = input.color(
     color.rgb(16, 185, 129),
     "Bullish",
     inline = "direction",
     group = GROUP_VISUAL)

color bearColor = input.color(
     color.rgb(225, 29, 72),
     "Bearish",
     inline = "direction",
     group = GROUP_VISUAL)

color neutralColor = input.color(
     color.rgb(100, 116, 139),
     "Neutral",
     inline = "direction",
     group = GROUP_VISUAL)

color extendedColor = input.color(
     color.rgb(245, 158, 11),
     "Extended",
     inline = "deviation",
     group = GROUP_VISUAL)

color extremeColor = input.color(
     color.rgb(239, 68, 68),
     "Extreme",
     inline = "deviation",
     group = GROUP_VISUAL)

color dashboardText = input.color(
     color.rgb(226, 232, 240),
     "Text",
     inline = "dashboard",
     group = GROUP_TABLE)

color dashboardBg = input.color(
     color.rgb(15, 23, 42),
     "Background",
     inline = "dashboard",
     group = GROUP_TABLE)

//=============================================================================
// LOG-SPACE REGRESSION ENGINE
//
// x = 0 represents the oldest observation.
// x = length - 1 represents the current observation.
//
// The channel is based on regression residual dispersion in logarithmic space.
//=============================================================================

f_logRegressionStats(float source, int length) =>
    float sumLogPrice = 0.0
    float sumXLogPrice = 0.0
    bool validWindow = true

    for offset = 0 to length - 1
        float observedPrice = source[offset]
        float x = length - 1 - offset

        bool validObservation =
             not na(observedPrice) and
             observedPrice > 0.0

        validWindow :=
             validWindow and
             validObservation

        if validObservation
            float logPrice = math.log(observedPrice)

            sumLogPrice += logPrice
            sumXLogPrice += x * logPrice

    float slope = na
    float intercept = na
    float residualDeviation = na
    float rSquaredValue = na
    float fittedOldest = na
    float fittedCurrent = na

    if validWindow
        float meanX =
             (length - 1) * 0.5

        float meanY =
             sumLogPrice / length

        float covarianceXY =
             sumXLogPrice -
             length * meanX * meanY

        float varianceX =
             length *
             (length * length - 1.0) /
             12.0

        slope :=
             varianceX > 0.0
             ? covarianceXY / varianceX
             : 0.0

        intercept :=
             meanY -
             slope * meanX

        float residualSumSquares = 0.0
        float totalSumSquares = 0.0

        for offset = 0 to length - 1
            float x =
                 length - 1 - offset

            float y =
                 math.log(source[offset])

            float fittedY =
                 intercept +
                 slope * x

            float residual =
                 y -
                 fittedY

            float centeredY =
                 y -
                 meanY

            residualSumSquares +=
                 residual * residual

            totalSumSquares +=
                 centeredY * centeredY

        int degreesOfFreedom =
             math.max(
                  length - 2,
                  1)

        residualDeviation :=
             math.sqrt(
                  residualSumSquares /
                  degreesOfFreedom)

        if totalSumSquares > 0.0
            rSquaredValue :=
                 1.0 -
                 residualSumSquares /
                 totalSumSquares

            rSquaredValue :=
                 math.max(
                      0.0,
                      math.min(
                           1.0,
                           rSquaredValue))
        else
            rSquaredValue := 0.0

        fittedOldest :=
             math.exp(intercept)

        fittedCurrent :=
             math.exp(
                  intercept +
                  slope *
                  (length - 1))

    [slope, intercept, residualDeviation, rSquaredValue, fittedOldest, fittedCurrent, validWindow]

//=============================================================================
// MODEL OUTPUTS
//=============================================================================

[logSlope, logIntercept, residualStd, rSquared, fittedWindowStart, fittedNow, validModel] = f_logRegressionStats(close, regressionLength)

//=============================================================================
// EFFECTIVE SETTINGS
//=============================================================================

float effectiveOuterDeviation =
     math.max(
          outerDeviation,
          innerDeviation + 0.25)

float effectiveExitQuality =
     math.min(
          exitQuality,
          enterQuality)

float effectiveExitStrength =
     math.min(
          exitStrength,
          enterStrength)

int effectiveMomentumBaseline =
     math.max(
          momentumBaseline,
          momentumFast + 1)

int visibleBars =
     math.min(
          channelLength,
          regressionLength)

int leftOffset =
     visibleBars - 1

float leftX =
     regressionLength -
     visibleBars

//=============================================================================
// FITTED MODEL VALUES
//=============================================================================

float fittedLeftLog = na
float fittedRightLog = na
float fittedLeft = na
float fittedRight = na

if validModel
    fittedLeftLog :=
         logIntercept +
         logSlope * leftX

    fittedRightLog :=
         logIntercept +
         logSlope *
         (regressionLength - 1)

    fittedLeft :=
         math.exp(fittedLeftLog)

    fittedRight :=
         math.exp(fittedRightLog)

//=============================================================================
// TREND QUALITY AND PRICE DEVIATION
//=============================================================================

float currentLogResidual = na

if validModel and close > 0.0
    currentLogResidual :=
         math.log(close) -
         fittedRightLog

float deviationScore = na

if validModel and residualStd > 0.0
    deviationScore :=
         currentLogResidual /
         residualStd

float trendQuality =
     validModel
     ? rSquared * 100.0
     : na

float fittedMovePercent = na

if validModel
    fittedMovePercent :=
         (
              math.exp(
                   logSlope *
                   (regressionLength - 1))
              - 1.0
         ) * 100.0

float trendStrength = na

if validModel and residualStd > 0.0
    trendStrength :=
         math.abs(logSlope) *
         (regressionLength - 1) /
         residualStd

//=============================================================================
// REGIME CANDIDATES
//=============================================================================

bool bullishEntryCandidate =
     validModel and
     logSlope > 0.0 and
     trendQuality >= enterQuality and
     trendStrength >= enterStrength

bool bearishEntryCandidate =
     validModel and
     logSlope < 0.0 and
     trendQuality >= enterQuality and
     trendStrength >= enterStrength

bool bullishHoldCondition =
     validModel and
     logSlope > 0.0 and
     trendQuality >= effectiveExitQuality and
     trendStrength >= effectiveExitStrength

bool bearishHoldCondition =
     validModel and
     logSlope < 0.0 and
     trendQuality >= effectiveExitQuality and
     trendStrength >= effectiveExitStrength

//=============================================================================
// PERSISTENT REGIME STATE
//
//  1 = Bullish
//  0 = Neutral
// -1 = Bearish
//
// State changes are committed only after the bar is confirmed.
//=============================================================================

var int regimeState = 0

if barstate.isconfirmed
    int nextRegimeState =
         regimeState

    if regimeState == 1
        if bearishEntryCandidate
            nextRegimeState := -1
        else if not bullishHoldCondition
            nextRegimeState := 0

    else if regimeState == -1
        if bullishEntryCandidate
            nextRegimeState := 1
        else if not bearishHoldCondition
            nextRegimeState := 0

    else
        if bullishEntryCandidate
            nextRegimeState := 1
        else if bearishEntryCandidate
            nextRegimeState := -1
        else
            nextRegimeState := 0

    regimeState :=
         nextRegimeState

bool bullishRegime =
     regimeState == 1

bool bearishRegime =
     regimeState == -1

bool neutralRegime =
     regimeState == 0

//=============================================================================
// DIRECTIONAL MOMENTUM ENGINE
//
// Momentum combines:
//
// 1. Smoothed logarithmic price velocity.
// 2. Smoothed velocity of the current regression residual.
//
// Both components are normalized by their own typical movement.
//=============================================================================

float logReturn = na

if (
     close > 0.0 and
     not na(close[1]) and
     close[1] > 0.0
)
    logReturn :=
         math.log(
              close /
              close[1])

float smoothedPriceVelocity =
     ta.ema(
          logReturn,
          momentumFast)

float normalPriceMovement =
     ta.ema(
          math.abs(logReturn),
          effectiveMomentumBaseline)

float normalizedPriceVelocity = na

if (
     not na(normalPriceMovement) and
     normalPriceMovement > 0.0
)
    normalizedPriceVelocity :=
         smoothedPriceVelocity /
         normalPriceMovement

float residualChange =
     ta.change(
          deviationScore)

float smoothedResidualVelocity =
     ta.ema(
          residualChange,
          momentumFast)

float normalResidualMovement =
     ta.ema(
          math.abs(residualChange),
          effectiveMomentumBaseline)

float normalizedResidualVelocity = na

if (
     not na(normalResidualMovement) and
     normalResidualMovement > 0.0
)
    normalizedResidualVelocity :=
         smoothedResidualVelocity /
         normalResidualMovement

float momentumScore = na

if (
     not na(normalizedPriceVelocity) and
     not na(normalizedResidualVelocity)
)
    momentumScore :=
         0.75 *
         normalizedPriceVelocity +
         0.25 *
         normalizedResidualVelocity

float momentumNoise =
     ta.stdev(
          momentumScore,
          momentumNoiseLength)

float adaptiveMomentumThreshold =
     math.max(
          momentumBaseThreshold,
          nz(momentumNoise) *
          momentumNoiseMultiplier)

bool bullishMomentum =
     not na(momentumScore) and
     momentumScore >
     adaptiveMomentumThreshold

bool bearishMomentum =
     not na(momentumScore) and
     momentumScore <
     -adaptiveMomentumThreshold

bool neutralMomentum =
     not bullishMomentum and
     not bearishMomentum

//=============================================================================
// TREND ACCELERATION
//
// Measures whether the standardized regression slope is strengthening,
// weakening or remaining stable.
//=============================================================================

float standardizedSlope = na

if validModel and residualStd > 0.0
    standardizedSlope :=
         logSlope /
         residualStd

float slopeChange =
     ta.change(
          standardizedSlope)

float smoothedSlopeChange =
     ta.ema(
          slopeChange,
          momentumFast)

float normalSlopeChange =
     ta.ema(
          math.abs(slopeChange),
          effectiveMomentumBaseline)

float accelerationScore = na

if (
     not na(normalSlopeChange) and
     normalSlopeChange > 0.0
)
    accelerationScore :=
         smoothedSlopeChange /
         normalSlopeChange

string accelerationText =
     "Stable"

color accelerationColor =
     neutralColor

if bullishRegime
    if accelerationScore > accelerationThreshold
        accelerationText := "Strengthening"
        accelerationColor := bullColor
    else if accelerationScore < -accelerationThreshold
        accelerationText := "Cooling"
        accelerationColor := extendedColor

else if bearishRegime
    if accelerationScore < -accelerationThreshold
        accelerationText := "Strengthening"
        accelerationColor := bearColor
    else if accelerationScore > accelerationThreshold
        accelerationText := "Cooling"
        accelerationColor := extendedColor

else
    if math.abs(nz(accelerationScore)) > accelerationThreshold
        accelerationText := "Changing"
        accelerationColor := extendedColor

//=============================================================================
// VISUAL STATE
//=============================================================================

color regimeColor =
     neutralColor

if bullishRegime
    regimeColor := bullColor
else if bearishRegime
    regimeColor := bearColor

color momentumColor =
     neutralColor

if bullishMomentum
    momentumColor := bullColor
else if bearishMomentum
    momentumColor := bearColor

string regimeText =
     "Neutral"

if bullishRegime
    regimeText := "Bullish"
else if bearishRegime
    regimeText := "Bearish"

string momentumText =
     "Neutral"

if bullishMomentum
    momentumText := "Bullish"
else if bearishMomentum
    momentumText := "Bearish"

//=============================================================================
// DEVIATION STATES
//=============================================================================

bool upperExtended =
     not na(deviationScore) and
     deviationScore >= innerDeviation

bool lowerExtended =
     not na(deviationScore) and
     deviationScore <= -innerDeviation

bool upperExtreme =
     not na(deviationScore) and
     deviationScore >= effectiveOuterDeviation

bool lowerExtreme =
     not na(deviationScore) and
     deviationScore <= -effectiveOuterDeviation

//=============================================================================
// MARKET PHASE ENGINE
//=============================================================================

string marketPhase =
     "No Clear Trend"

color marketPhaseColor =
     neutralColor

if bullishRegime
    if upperExtreme
        marketPhase := "Bullish Overextension"
        marketPhaseColor := extremeColor

    else if lowerExtended and bullishMomentum
        marketPhase := "Pullback Recovery"
        marketPhaseColor := bullColor

    else if lowerExtended and bearishMomentum
        marketPhase := "Bullish Pullback"
        marketPhaseColor := extendedColor

    else if bullishMomentum
        marketPhase := "Trend Continuation"
        marketPhaseColor := bullColor

    else if bearishMomentum
        marketPhase := "Momentum Cooling"
        marketPhaseColor := extendedColor

    else
        marketPhase := "Bullish Consolidation"
        marketPhaseColor := neutralColor

else if bearishRegime
    if lowerExtreme
        marketPhase := "Bearish Overextension"
        marketPhaseColor := extremeColor

    else if upperExtended and bearishMomentum
        marketPhase := "Bounce Rejection"
        marketPhaseColor := bearColor

    else if upperExtended and bullishMomentum
        marketPhase := "Bearish Bounce"
        marketPhaseColor := extendedColor

    else if bearishMomentum
        marketPhase := "Trend Continuation"
        marketPhaseColor := bearColor

    else if bullishMomentum
        marketPhase := "Countertrend Bounce"
        marketPhaseColor := extendedColor

    else
        marketPhase := "Bearish Consolidation"
        marketPhaseColor := neutralColor

else
    if upperExtreme
        marketPhase := "Upper Price Shock"
        marketPhaseColor := extremeColor

    else if lowerExtreme
        marketPhase := "Lower Price Shock"
        marketPhaseColor := extremeColor

    else if bullishMomentum
        marketPhase := "Neutral Upward Impulse"
        marketPhaseColor := bullColor

    else if bearishMomentum
        marketPhase := "Neutral Downward Impulse"
        marketPhaseColor := bearColor

    else
        marketPhase := "No Clear Trend"
        marketPhaseColor := neutralColor

//=============================================================================
// ROLLING REGRESSION LINE AND MOMENTUM FILL
//=============================================================================

float momentumReference =
     ta.ema(
          fittedNow,
          effectiveMomentumBaseline)

trendPlot = plot(
     fittedNow,
     "Log Regression",
     color = momentumColor,
     linewidth = 3)

momentumReferencePlot = plot(
     momentumReference,
     "Momentum Reference",
     color = color.new(
          momentumColor,
          100),
     display = display.none,
     editable = false)

fill(
     trendPlot,
     momentumReferencePlot,
     color =
          showMomentumFill
          ? color.new(
               momentumColor,
               84)
          : na,
     title = "Momentum Fill")

//=============================================================================
// RESIDUAL CHANNEL VALUES
//=============================================================================

float upperOuterLeft = na
float upperOuterRight = na
float upperInnerLeft = na
float upperInnerRight = na

float lowerInnerLeft = na
float lowerInnerRight = na
float lowerOuterLeft = na
float lowerOuterRight = na

if validModel
    upperOuterLeft :=
         math.exp(
              fittedLeftLog +
              effectiveOuterDeviation *
              residualStd)

    upperOuterRight :=
         math.exp(
              fittedRightLog +
              effectiveOuterDeviation *
              residualStd)

    upperInnerLeft :=
         math.exp(
              fittedLeftLog +
              innerDeviation *
              residualStd)

    upperInnerRight :=
         math.exp(
              fittedRightLog +
              innerDeviation *
              residualStd)

    lowerInnerLeft :=
         math.exp(
              fittedLeftLog -
              innerDeviation *
              residualStd)

    lowerInnerRight :=
         math.exp(
              fittedRightLog -
              innerDeviation *
              residualStd)

    lowerOuterLeft :=
         math.exp(
              fittedLeftLog -
              effectiveOuterDeviation *
              residualStd)

    lowerOuterRight :=
         math.exp(
              fittedRightLog -
              effectiveOuterDeviation *
              residualStd)

//=============================================================================
// CHANNEL OBJECTS
//=============================================================================

var line upperOuterLine = na
var line upperInnerLine = na
var line regressionMidLine = na
var line lowerInnerLine = na
var line lowerOuterLine = na

var linefill upperRibbon = na
var linefill lowerRibbon = na

var label regimeLabel = na

bool channelReady =
     validModel and
     bar_index >= leftOffset

int leftBar =
     bar_index -
     leftOffset

if channelReady
    if na(upperOuterLine)
        upperOuterLine := line.new(
             leftBar,
             upperOuterLeft,
             bar_index,
             upperOuterRight,
             color = regimeColor,
             width = 3)

        upperInnerLine := line.new(
             leftBar,
             upperInnerLeft,
             bar_index,
             upperInnerRight,
             color = na,
             width = 1)

        regressionMidLine := line.new(
             leftBar,
             fittedLeft,
             bar_index,
             fittedRight,
             color =
                  showMidLine
                  ? color.new(
                       neutralColor,
                       10)
                  : na,
             style = line.style_dashed,
             width = 1)

        lowerInnerLine := line.new(
             leftBar,
             lowerInnerLeft,
             bar_index,
             lowerInnerRight,
             color = na,
             width = 1)

        lowerOuterLine := line.new(
             leftBar,
             lowerOuterLeft,
             bar_index,
             lowerOuterRight,
             color = regimeColor,
             width = 3)

        upperRibbon := linefill.new(
             upperInnerLine,
             upperOuterLine,
             showChannelFill
             ? color.new(
                  regimeColor,
                  84)
             : na)

        lowerRibbon := linefill.new(
             lowerInnerLine,
             lowerOuterLine,
             showChannelFill
             ? color.new(
                  regimeColor,
                  84)
             : na)

    else
        line.set_xy1(
             upperOuterLine,
             leftBar,
             upperOuterLeft)

        line.set_xy2(
             upperOuterLine,
             bar_index,
             upperOuterRight)

        line.set_color(
             upperOuterLine,
             regimeColor)

        line.set_xy1(
             upperInnerLine,
             leftBar,
             upperInnerLeft)

        line.set_xy2(
             upperInnerLine,
             bar_index,
             upperInnerRight)

        line.set_xy1(
             regressionMidLine,
             leftBar,
             fittedLeft)

        line.set_xy2(
             regressionMidLine,
             bar_index,
             fittedRight)

        line.set_color(
             regressionMidLine,
             showMidLine
             ? color.new(
                  neutralColor,
                  10)
             : na)

        line.set_xy1(
             lowerInnerLine,
             leftBar,
             lowerInnerLeft)

        line.set_xy2(
             lowerInnerLine,
             bar_index,
             lowerInnerRight)

        line.set_xy1(
             lowerOuterLine,
             leftBar,
             lowerOuterLeft)

        line.set_xy2(
             lowerOuterLine,
             bar_index,
             lowerOuterRight)

        line.set_color(
             lowerOuterLine,
             regimeColor)

        linefill.set_color(
             upperRibbon,
             showChannelFill
             ? color.new(
                  regimeColor,
                  84)
             : na)

        linefill.set_color(
             lowerRibbon,
             showChannelFill
             ? color.new(
                  regimeColor,
                  84)
             : na)

//=============================================================================
// REGIME LABEL
//=============================================================================

if channelReady and showRegimeLabel
    if na(regimeLabel)
        regimeLabel := label.new(
             leftBar,
             lowerOuterLeft,
             regimeText,
             style =
                  bullishRegime
                  ? label.style_label_upper_right
                  : bearishRegime
                  ? label.style_label_lower_right
                  : label.style_label_right,
             color = regimeColor,
             textcolor = dashboardBg,
             size = size.small)

    else
        label.set_xy(
             regimeLabel,
             leftBar,
             lowerOuterLeft)

        label.set_text(
             regimeLabel,
             regimeText)

        if bullishRegime
            label.set_style(
                 regimeLabel,
                 label.style_label_upper_right)

        else if bearishRegime
            label.set_style(
                 regimeLabel,
                 label.style_label_lower_right)

        else
            label.set_style(
                 regimeLabel,
                 label.style_label_right)

        label.set_color(
             regimeLabel,
             regimeColor)

        label.set_textcolor(
             regimeLabel,
             dashboardBg)

else if not showRegimeLabel and not na(regimeLabel)
    label.delete(regimeLabel)
    regimeLabel := na

//=============================================================================
// DASHBOARD HELPERS
//=============================================================================

f_deviationText(
     float score,
     float innerBand,
     float outerBand) =>

    string result =
         "N/A"

    if not na(score)
        string side =
             "Center"

        if score > 0.0
            side := "Upper"
        else if score < 0.0
            side := "Lower"

        string zone =
             "Normal"

        if math.abs(score) >= outerBand
            zone := "Extreme"
        else if math.abs(score) >= innerBand
            zone := "Extended"

        result :=
             side +
             " " +
             str.tostring(
                  score,
                  "#.##") +
             "σ · " +
             zone

    result

f_deviationColor(
     float score,
     float innerBand,
     float outerBand,
     color neutral,
     color extended,
     color extreme) =>

    color result =
         neutral

    if not na(score)
        if math.abs(score) >= outerBand
            result := extreme
        else if math.abs(score) >= innerBand
            result := extended

    result

//=============================================================================
// DASHBOARD
//=============================================================================

var table dashboard = table.new(
     position.top_right,
     2,
     7,
     bgcolor =
          color.new(
               dashboardBg,
               8),
     frame_color =
          color.new(
               neutralColor,
               55),
     frame_width = 1,
     border_color =
          color.new(
               neutralColor,
               70),
     border_width = 1)

if barstate.islast
    string qualityText =
         "Waiting"

    string strengthText =
         "Waiting"

    if validModel
        qualityText :=
             str.tostring(
                  trendQuality,
                  "#.##") +
             "% R²"

        strengthText :=
             str.tostring(
                  trendStrength,
                  "#.##") +
             "σ"

    string deviationText =
         f_deviationText(
              deviationScore,
              innerDeviation,
              effectiveOuterDeviation)

    color currentDeviationColor =
         f_deviationColor(
              deviationScore,
              innerDeviation,
              effectiveOuterDeviation,
              neutralColor,
              extendedColor,
              extremeColor)

    table.cell(
         dashboard,
         0,
         0,
         "MSL Regime Dashboard",
         text_color = dashboardText,
         text_size = size.small,
         bgcolor =
              color.new(
                   dashboardBg,
                   0))

    table.cell(
         dashboard,
         1,
         0,
         "Status",
         text_color = dashboardText,
         text_size = size.small,
         bgcolor =
              color.new(
                   dashboardBg,
                   0))

    table.cell(
         dashboard,
         0,
         1,
         "Market Regime",
         text_color =
              color.new(
                   dashboardText,
                   5),
         text_size = size.small)

    table.cell(
         dashboard,
         1,
         1,
         regimeText,
         text_color = regimeColor,
         text_size = size.small)

    table.cell(
         dashboard,
         0,
         2,
         "Trend Quality",
         text_color =
              color.new(
                   dashboardText,
                   5),
         text_size = size.small)

    table.cell(
         dashboard,
         1,
         2,
         qualityText +
         " · " +
         strengthText,
         text_color = regimeColor,
         text_size = size.small)

    table.cell(
         dashboard,
         0,
         3,
         "Price Deviation",
         text_color =
              color.new(
                   dashboardText,
                   5),
         text_size = size.small)

    table.cell(
         dashboard,
         1,
         3,
         deviationText,
         text_color =
              currentDeviationColor,
         text_size = size.small)

    table.cell(
         dashboard,
         0,
         4,
         "Current Momentum",
         text_color =
              color.new(
                   dashboardText,
                   5),
         text_size = size.small)

    table.cell(
         dashboard,
         1,
         4,
         momentumText,
         text_color = momentumColor,
         text_size = size.small)

    table.cell(
         dashboard,
         0,
         5,
         "Trend Acceleration",
         text_color =
              color.new(
                   dashboardText,
                   5),
         text_size = size.small)

    table.cell(
         dashboard,
         1,
         5,
         accelerationText,
         text_color =
              accelerationColor,
         text_size = size.small)

    table.cell(
         dashboard,
         0,
         6,
         "Market Phase",
         text_color =
              color.new(
                   dashboardText,
                   5),
         text_size = size.small)

    table.cell(
         dashboard,
         1,
         6,
         marketPhase,
         text_color =
              marketPhaseColor,
         text_size = size.small)

//=============================================================================
// DATA WINDOW VALUES
//=============================================================================

plot(
     trendQuality,
     "Trend Quality R² (%)",
     display = display.data_window,
     color = na)

plot(
     trendStrength,
     "Trend Strength (Residual σ)",
     display = display.data_window,
     color = na)

plot(
     deviationScore,
     "Price Deviation Score",
     display = display.data_window,
     color = na)

plot(
     fittedMovePercent,
     "Fitted Move Across Window (%)",
     display = display.data_window,
     color = na)

plot(
     momentumScore,
     "Directional Momentum Score",
     display = display.data_window,
     color = na)

plot(
     adaptiveMomentumThreshold,
     "Adaptive Momentum Threshold",
     display = display.data_window,
     color = na)

plot(
     accelerationScore,
     "Trend Acceleration Score",
     display = display.data_window,
     color = na)

//=============================================================================
// NOTES
//
// This version intentionally contains no Buy or Sell markers.
//
// Market Regime:
// Uses log-regression quality, standardized trend strength and hysteresis.
//
// Current Momentum:
// Measures normalized short-term price and residual direction.
//
// Trend Acceleration:
// Measures whether the regression slope is strengthening or cooling.
//
// Market Phase:
// Interprets the combination of regime, momentum and price deviation.
//
// Regime changes are committed only on confirmed bars.
//=============================================================================