// @version=6 
// @description - A Trader's Edge (ATE)_Library was created to assist in constructing COMET Scanners with Pinescript v5 code/logic. // Provides a brief description of the library's purpose.
                                                                                                                                                                                                       
library(title="COMET_Scanner_Library", overlay=true) 

//== IMPORT ==\\
import PineCoders/Strings/1 as strings

//== TICKERID FORMATION ==\\
// @function -   TickerString    - This function extracts the string of assets you will be scanning from the entire list of string assets. // Documentation comment describing the function's goal.
// @param    -  tickers (string) - This is the entire list of assets you will be scanning. // Documentation comment describing the 'tickers' parameter.
// @param    - inEachGroup (int) - How many assets will be in each group for this scanner (hard-coded/set by COMET Scanner Author). // Documentation comment describing the 'inEachGroup' parameter.
// @param    -  whichGroup (int) - Which set/group of assets that particular iteration/copy of the scanner will be scanning. // Documentation comment describing the 'whichGroup' parameter.
// @returns  -     (string)      - Returns a single string containing all the assets being scanned as determined by the amount of assets in each group and which group of the lot is being scanned. // Documentation comment describing the function's return value.

export TickerString(string tickers, int inEachGroup, int whichGroup) => // Exports the TickerString function, making it callable from other scripts. Defines its parameters: the full ticker list, items per group, and the desired group number.
    var result=""                                                       // Initializes an empty string variable 'result' once per script instance using 'var', to hold the extracted tickers.
    commasBefore = (whichGroup-1) * (inEachGroup-1)                     // Calculates the number of commas to skip before the desired group starts. (Note: Relies on exactly N-1 commas within each group of N items).
    rightSide = strings.rightOf(tickers, ",", commasBefore-1)           // Uses the imported 'strings.rightOf' function to get the portion of the 'tickers' string starting after the calculated number of commas.
    result := strings.leftOf(rightSide, ",", inEachGroup)               // Uses the imported 'strings.leftOf' function to extract the first 'inEachGroup' comma-separated items from the 'rightSide' string, updating the 'result' variable.
    if str.endswith(result, ",")                                        // Checks if the extracted 'result' string accidentally ends with a comma.
        result := str.substring(result, 0, str.length(result)-1)        // If it ends with a comma, removes the last character to clean up the string, updating 'result'.
    result                                                              // Returns the final 'result' string containing the tickers for the specified group.
    

// @function -   TickerIDs   - Breaks up single string into 40 separate variables to be in the COMET Scanner // Documentation comment describing the function's goal.
// @param    -  str (string) - This input will be a single string consisting of up to 40 tickerID's with a blank space between each tickerID (ex. 'BINANCE:BTCUSDT BINANCE:SXPUSDT BINANCE:XRPUSDT').", display=display.none) // Documentation comment describing the 'str' parameter. (Note: Actual code handles comma-separated).
// @returns  -   (string)    - Returns 40 string variables (in a tuple) containing separated TickerIDs. Regarless of how many you are scanning at a time, this will always return 40 variables even if some have to be assigned to nothing. // Documentation comment describing the function's return value.

export TickerIDs(string str) =>	              // Exports the TickerIDs function, which takes a single comma-separated string of tickers for one group.
    str.replace_all(str," ","")               // Removes all space characters from the input string 'str' to ensure clean comma separation.
    _regex = '^[^,]+|(?<=,)[^,]+(?=,)|[^,]+$' // Defines a regular expression pattern designed to match individual comma-separated values within a string.
	var t01=str.match(str,_regex)             // Extracts the first match (ticker) from the input 'str' using the regex, stores it in 't01' (initialized once due to 'var').
    var a01=str.replace(str,t01,"")           // Removes the first matched ticker ('t01') from the original string, storing the remainder in 'a01' (initialized once due to 'var').            
	var t02=str.match(a01,_regex)             // Extracts the first ticker from the remaining string 'a01', stores it in 't02' (initialized once due to 'var').
    var a02=str.replace(a01,t02,"")           // Removes the matched ticker ('t02') from 'a01', storing the remainder in 'a02' (initialized once due to 'var').                  
	var t03=str.match(a02,_regex)             // .........
    var a03=str.replace(a02,t03,"")            
	var t04=str.match(a03,_regex) 
    var a04=str.replace(a03,t04,"")            
	var t05=str.match(a04,_regex) 
    var a05=str.replace(a04,t05,"")            
	var t06=str.match(a05,_regex) 
    var a06=str.replace(a05,t06,"")            
	var t07=str.match(a06,_regex) 
    var a07=str.replace(a06,t07,"")            
	var t08=str.match(a07,_regex) 
    var a08=str.replace(a07,t08,"")            
	var t09=str.match(a08,_regex) 
    var a09=str.replace(a08,t09,"")            
	var t10=str.match(a09,_regex) 
    var a10=str.replace(a09,t10,"")        
	var t11=str.match(a10,_regex) 
    var a11=str.replace(a10,t11,"")       
	var t12=str.match(a11,_regex) 
    var a12=str.replace(a11,t12,"")       
	var t13=str.match(a12,_regex) 
    var a13=str.replace(a12,t13,"")       
	var t14=str.match(a13,_regex) 
    var a14=str.replace(a13,t14,"")       
	var t15=str.match(a14,_regex) 
    var a15=str.replace(a14,t15,"")       
	var t16=str.match(a15,_regex) 
    var a16=str.replace(a15,t16,"")       
	var t17=str.match(a16,_regex) 
    var a17=str.replace(a16,t17,"")       
	var t18=str.match(a17,_regex) 
    var a18=str.replace(a17,t18,"")       
	var t19=str.match(a18,_regex) 
    var a19=str.replace(a18,t19,"")       
	var t20=str.match(a19,_regex) 
    var a20=str.replace(a19,t20,"")          
    var t21=str.match(a20,_regex) 
    var a21=str.replace(a20,t21,"")
    var t22=str.match(a21,_regex) 
    var a22=str.replace(a21,t22,"")
    var t23=str.match(a22,_regex) 
    var a23=str.replace(a22,t23,"")
    var t24=str.match(a23,_regex) 
    var a24=str.replace(a23,t24,"")
    var t25=str.match(a24,_regex) 
    var a25=str.replace(a24,t25,"")
    var t26=str.match(a25,_regex) 
    var a26=str.replace(a25,t26,"")
    var t27=str.match(a26,_regex) 
    var a27=str.replace(a26,t27,"")
    var t28=str.match(a27,_regex) 
    var a28=str.replace(a27,t28,"")
    var t29=str.match(a28,_regex) 
    var a29=str.replace(a28,t29,"")
    var t30=str.match(a29,_regex) 
    var a30=str.replace(a29,t30,"")
    var t31=str.match(a30,_regex) 
    var a31=str.replace(a30,t31,"")
    var t32=str.match(a31,_regex) 
    var a32=str.replace(a31,t32,"")
    var t33=str.match(a32,_regex) 
    var a33=str.replace(a32,t33,"")
    var t34=str.match(a33,_regex) 
    var a34=str.replace(a33,t34,"")
    var t35=str.match(a34,_regex) 
    var a35=str.replace(a34,t35,"")
    var t36=str.match(a35,_regex) 
    var a36=str.replace(a35,t36,"")
    var t37=str.match(a36,_regex) 
    var a37=str.replace(a36,t37,"")  
    var t38=str.match(a37,_regex) 
    var a38=str.replace(a37,t38,"")
    var t39=str.match(a38,_regex) 
    var a39=str.replace(a38,t39,"")
    var t40=str.match(a39,_regex) 
    var a40=str.replace(a39,t40,"")

    [t01,t02,t03,t04,t05,t06,t07,t08,t09,t10,t11,t12,t13,t14,t15,t16,t17,t18,t19,t20,t21,t22,t23,t24,t25,t26,t27,t28,t29,t30,t31,t32,t33,t34,t35,t36,t37,t38,t39,t40] // Returns a tuple containing exactly 40 ticker variables (t01 to t40). If fewer than 40 tickers were in the input string, later variables will hold 'na' or empty strings.

//== ASSIGNMENT OF LOCATIONS FOR ALERT LABELS ==\\
// @function -     Locations     - Y axis locations for alert labels to print (if applicable). // Documentation comment describing the function's goal.
// @param    - inEachGroup (int) - How many assets will be in each group for this scanner (hard-coded/set by COMET Scanner Author). // Documentation comment describing the 'inEachGroup' parameter.
// @param    -  whichGroup (int) - Which set/group of assets that particular iteration/copy of the scanner will be scanning. // Documentation comment describing the 'whichGroup' parameter.
// @returns  -       (int)       - Returns 40 location integer variables (in a tuple) for alert labels to print at when triggered. // Documentation comment describing the function's return value.                                                                                                                    

export Locations(int inEachGroup, int whichGroup) =>          // Exports the Locations function. Calculates unique Y-axis integer locations for alert labels based on the group size and the specific group number.
    var _firstLocation = ((whichGroup - 1) * inEachGroup) + 1 // Calculates the starting Y-location value for the first asset in the specified group/set. Uses 'var' so the calculation happens once, but the value is effectively constant per instance.
    var loc01=_firstLocation  // Assigns the calculated starting location to 'loc01' (initialized once due to 'var').
    var loc02=loc01+1         // Assigns the next sequential location to 'loc02' (initialized once due to 'var').
    var loc03=loc02+1         // Assigns the next sequential location to 'loc03' (initialized once due to 'var').
    var loc04=loc03+1         // Assigns the next sequential location to 'loc04' (initialized once due to 'var').
    var loc05=loc04+1         // .......
    var loc06=loc05+1 
    var loc07=loc06+1 
    var loc08=loc07+1 
    var loc09=loc08+1 
    var loc10=loc09+1 
    var loc11=loc10+1    
    var loc12=loc11+1 
    var loc13=loc12+1 
    var loc14=loc13+1 
    var loc15=loc14+1 
    var loc16=loc15+1 
    var loc17=loc16+1 
    var loc18=loc17+1 
    var loc19=loc18+1 
    var loc20=loc19+1 
    var loc21=loc20+1    
    var loc22=loc21+1 
    var loc23=loc22+1 
    var loc24=loc23+1 
    var loc25=loc24+1 
    var loc26=loc25+1 
    var loc27=loc26+1 
    var loc28=loc27+1 
    var loc29=loc28+1 
    var loc30=loc29+1 
    var loc31=loc30+1    
    var loc32=loc31+1 
    var loc33=loc32+1 
    var loc34=loc33+1 
    var loc35=loc34+1 
    var loc36=loc35+1 
    var loc37=loc36+1 
    var loc38=loc37+1 
    var loc39=loc38+1 
    var loc40=loc39+1 

    [loc01,loc02,loc03,loc04,loc05,loc06,loc07,loc08,loc09,loc10,loc11,loc12,loc13,loc14,loc15,loc16,loc17,loc18,loc19,loc20,loc21,loc22,loc23,loc24,loc25,loc26,loc27,loc28,loc29,loc30,loc31,loc32,loc33,loc34,loc35,loc36,loc37,loc38,loc39,loc40] // Returns a tuple containing exactly 40 location variables (loc01 to loc40).

//== INVALID TICKERID'S FROM SECURITY CALL ==\\
// @function -      Invalid TickerIDs      - Displays invalid ticker IDs as a label on the rightmost bar // Documentation comment describing the function's goal.
// @param    -       lblSz (string)        - Size of Invalid TickerID labels set by user in COMET Scanner inputs // Documentation comment describing the '_lblSz' parameter.
// @param    -       _close (float)        - Close price from security function // Documentation comment describing the '_close' parameter.
// @param    -  _securityTickerid (string) - Ticker ID from security function // Documentation comment describing the '_securityTickerid' parameter.
// @param    - _invalidArray array<string> - Array containing invalid ticker strings // Documentation comment describing the '_invalidArray' parameter.
// @param    -         _set (int)          - Position set (1-10) for Y-axis distribution // Documentation comment describing the '_set' parameter (Note: Code uses 8 positions).
// @return   -           label             - Label showing invalid tickers // Documentation comment describing the function's output (Note: Creates a table).

export InvalidTickerIDs(string _lblSz, float _close, string _securityTickerid, array<string> _invalidArray, int _set=1) => // Exports the InvalidTickerIDs function. Manages display of invalid tickers found during security calls. Takes label size, close price, ticker ID, the shared invalid array, and the set number.       
    var tablePositions = array.from(position.top_left, position.top_center, position.top_right, position.middle_left, position.middle_right, position.bottom_left, position.bottom_center, position.bottom_right) // Defines an array containing 8 standard table position constants, initialized once per script instance using 'var'.
    var bool valid=false                                                                        // Initializes a persistent boolean 'valid' flag once per script instance. Tracks if *any* valid data (_close > 0.0) has been received by this instance.
    tblPos = array.get(tablePositions, (_set-1)%8)                                              // Calculates the position index (0-7) by taking the 1-based '_set' number, subtracting 1 (for 0-based index), and using the modulo 8 operator. Retrieves the corresponding position constant from 'tablePositions'.    
    if not valid                                                                                // Executes the inner block only if the persistent 'valid' flag for this script instance is still false (meaning no _close > 0.0 was ever encountered).
        if _close>0.0                                                                           // Checks if the current _close value passed from the security call is greater than 0.0.
            valid := true                                                                       // If _close is valid, updates the persistent 'valid' flag to true. It will remain true for this instance hereafter.
        if barstate.islast                                                                      // Checks if the current bar being processed is the last (most recent) bar on the chart.
            array.push(_invalidArray,_securityTickerid)                                         // This push only occurs if 'valid' is still false *and* it's the last bar. This logic might miss tickers that were invalid earlier but became valid later.        // Adds the current '_securityTickerid' to the shared '_invalidArray' IF the persistent 'valid' flag is still false AND it's the last bar.
    var table resultTable = table.new(tblPos, 1, 1, bgcolor=#FFFF0000)                        // Creates a new 1x1 table ONCE per script instance using 'var', places it at the calculated 'tblPos', and sets the background color to opaque yellow (#FFFF0000).
    if barstate.islast                                                                          // Checks if the current bar being processed is the last bar on the chart.
        invalidList = array.join(_invalidArray,'\n')                                            // Joins all the ticker IDs currently stored in the shared '_invalidArray' into a single string, separated by newline characters ('\n').
        table.cell(resultTable, 0, 0, invalidList, text_color=chart.fg_color, text_size=_lblSz) // Updates the content of the table's single cell (row 0, column 0) with the 'invalidList' string. Sets text color to the chart's foreground color and uses the label size passed in '_lblSz'. This happens on every last bar tick.