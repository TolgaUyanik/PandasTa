// Refactored, visually updated, and alert-optimized by LuxAlgo Quant Agent

//@version=6
indicator(title = "KayMansaMusa Swing Trading Strategy [Buy&Sell Signals]", shorttitle = "Philakone", overlay = true)

//---------------------------------------------------------------------------------------------------------------------}
// Inputs
//---------------------------------------------------------------------------------------------------------------------{

exponential = input.bool(true, title = "Exponential MA")

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{

src = close

ma8   = exponential ? ta.ema(src, 8)   : ta.sma(src, 8)
ma13  = exponential ? ta.ema(src, 13)  : ta.sma(src, 13)
ma21  = exponential ? ta.ema(src, 21)  : ta.sma(src, 21)
ma55  = exponential ? ta.ema(src, 55)  : ta.sma(src, 55)
ma200 = exponential ? ta.ema(src, 200) : ta.sma(src, 200)

buyCond  = ta.crossover(ma21, ma55)  and ma8 > ma13
sellCond = ta.crossunder(ma21, ma55) and ma8 < ma13

//---------------------------------------------------------------------------------------------------------------------}
// Plots
//---------------------------------------------------------------------------------------------------------------------{

plotshape(buyCond  ? 1 : na, color = #089981, style = shape.triangleup,   location = location.belowbar, text = "Buy",  size = size.tiny)
plotshape(sellCond ? 1 : na, color = #f23645, style = shape.triangledown, location = location.abovebar, text = "Sell", size = size.tiny)

plot(ma8,   color = #5b9cf6,        style = plot.style_line, title = "8",   linewidth = 1)
plot(ma13,  color = #089981,        style = plot.style_line, title = "13",  linewidth = 1)
plot(ma21,  color = color.yellow,   style = plot.style_line, title = "21",  linewidth = 1)
plot(ma55,  color = #f23645,        style = plot.style_line, title = "55",  linewidth = 1)
plot(ma200, color = chart.fg_color, style = plot.style_line, title = "200", linewidth = 1)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{

alertcondition(buyCond,  title = "Buy Condition",  message = "Buy Condition Alert")
alertcondition(sellCond, title = "Sell Condition", message = "Sell Condition Alert")

//---------------------------------------------------------------------------------------------------------------------}
