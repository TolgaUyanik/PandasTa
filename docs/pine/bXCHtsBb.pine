//@version=6
// @description Advanced Evaluation Engine for Market Poker
library("MarketPokerEnginev2", overlay=false)

// @function Evaluates a 5-card poker hand and returns a tuple of flags.
// @param ranks Array of 5 integers (0=Joker, 1-13=A-K)
// @param suits Array of 5 integers (0=Joker, 1=Spade, 2=Club, 3=Diamond, 4=Heart)
// @returns [is_royal, is_str_flush, is_quads, is_full_house, is_flush, is_straight, is_trips, is_two_pair, is_pair, jokers_count]
export evaluate_hand(int[] ranks, int[] suits) =>
    int[] counts = array.new_int(14, 0)
    for i = 0 to 4
        int r = array.get(ranks, i)
        array.set(counts, r, array.get(counts, r) + 1)

    int jokers = array.get(counts, 0)
    
    int pairs = 0
    int triples = 0
    int max_dup = 0
    
    for i = 1 to 13
        int c = array.get(counts, i)
        if c == 2
            pairs += 1
        if c == 3
            triples += 1
        if c > max_dup
            max_dup := c

    int max_suit = 0
    for s = 1 to 4
        int s_count = 0
        for i = 0 to 4
            if array.get(suits, i) == s
                s_count += 1
        if s_count > max_suit
            max_suit := s_count
            
    bool is_flush = (max_suit + jokers >= 5)

    bool is_straight = false
    bool is_royal = false
    
    for w = 1 to 10
        int have_cards = 0
        int[] window = array.from(w, w+1, w+2, w+3, w+4 > 13 ? 1 : w+4)
        for i = 0 to 4
            if array.get(counts, array.get(window, i)) > 0
                have_cards += 1
        
        if have_cards + jokers >= 5
            is_straight := true
            if w == 10 and is_flush
                is_royal := true

    bool is_str_flush = is_straight and is_flush and not is_royal
    
    // Evaluate Hand Hierarchy
    bool flag_royal      = is_royal
    bool flag_str_flush  = is_str_flush
    bool flag_quads      = (max_dup + jokers >= 4)
    bool flag_full_house = (triples == 1 and pairs == 1) or (pairs == 2 and jokers == 1)
    bool flag_flush      = is_flush
    bool flag_straight   = is_straight
    bool flag_trips      = (max_dup + jokers >= 3)
    bool flag_two_pair   = (pairs >= 2)
    bool flag_pair       = (max_dup + jokers >= 2)

    [flag_royal, flag_str_flush, flag_quads, flag_full_house, flag_flush, flag_straight, flag_trips, flag_two_pair, flag_pair, jokers]

// @function Converts rank and suit integers to a vertical display string
// @param r Rank integer
// @param s Suit integer
// @returns String formatted for vertical label display
export get_card_vertical(int r, int s) =>
    string suit_str = s == 0 ? "🃏" : s == 1 ? "♠️" : s == 2 ? "♣️" : s == 3 ? "♦️" : "♥️"
    string rank_str = r == 0 ? "JOKER" : r == 1 ? "A" : r == 11 ? "J" : r == 12 ? "Q" : r == 13 ? "K" : str.tostring(r)
    suit_str + "\n" + rank_str