// ==============================================================================
// 📘 BASCOOL Library v1
// Range–Body Structure Analysis Toolkit for Intraday Trading
// ------------------------------------------------------------------------------
// This library provides reusable building blocks for structural conviction
// analysis using pure price action. It is designed for advanced intraday
// strategies that rely on volatility-normalized range expansion and candle-body
// efficiency.
//
// 📌 Included in v1:
//    • rbm_from_ohlc()  →  Computes RBM (Range–Body Measure)
//        - Measures structural "strength" of candles based on:
//              1. Normalized range expansion (EMA(range) / ATR)
//              2. Body-to-range efficiency (body_size / total_range)
//        - Outputs a smooth momentum-weighted value between ~0 and 1
//        - Helps detect trending, grinding, or choppy market conditions
//
// 🔧 Usage Example:
//        import gokul4trading/BASCOOL_Lib/1 as bas
//        rbm = bas.rbm_from_ohlc(open, high, low, close, 5, 14)
//
// 🎯 When to Use RBM:
//    • To detect increasing structural strength before entering directional trades
//    • To stay out during low-range or inefficient-body conditions (chop)
//    • To complement delta/VWAP, MACD histogram or Nimuka signals
//
// 📒 Input Parameters:
//    - o, h, l, c → OHLC series from your indicator context
//    - emaSpan    → Smoothing factor for range + body efficiency (default: 5)
//    - atrSpan    → Volatility normalization period (default: 14)
//
// 🧠 Key Concepts Behind RBM:
//    • Strong candles have expanding ranges + high body efficiency
//    • Weak/choppy regimes have compressed ranges + small bodies
//    • RBM captures this as a single, normalized structural metric
//
// ------------------------------------------------------------------------------
// NOTE:
// • This library must be called from an indicator (not standalone).
// • OHLC must be passed manually due to Pine Script library restrictions.
// • ATR inside the library automatically uses chart context provided by the caller.
// ------------------------------------------------------------------------------
//
// Author: gokul4trading
// ============================================================================== 


//@version=6
library("BASCOOL_Lib")

// === Constants ===
VERY_SMALL = 1e-8

// === Custom tanh implementation ===
tanh_fn(x) =>
    e2x = math.exp(2 * x)
    (e2x - 1) / (e2x + 1)

// === RBM from OHLC ===
// Computes RBM based on your Python logic
export rbm_from_ohlc(
	series float o,
    series float h,
    series float l,
    series float c,
    int emaSpan,
    int atrSpan
) =>
    // Range and body
    range_ = h - l
    range_safe = math.max(range_, VERY_SMALL)
    body_size = math.abs(c - o)

    // 1. EMA of range
    rangeAvg = ta.ema(range_, emaSpan)

    // 2. ATR
    atr = ta.atr(atrSpan)
    atr_safe = math.max(atr, VERY_SMALL)

    // 3. Normalized range expansion
    rangeAvgNorm = tanh_fn(rangeAvg / atr_safe)

    // 4. Body-to-range ratio
    body_to_range = body_size / range_safe

    // 5. EMA of body/range ratio
    bodyToRangeRatioAvg = ta.ema(body_to_range, emaSpan)

    // 6. Final RBM
    rbm_value = rangeAvgNorm * bodyToRangeRatioAvg

    rbm_value
