//@version=6
strategy("Ultimate Pattern Engine (EMA + Stochastic)", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

// ═══════════════════════════════════════════════════════════════════════════
// 1. INPUTS & INDICATORS
// ═══════════════════════════════════════════════════════════════════════════
// EMAs
ema1_len = input.int(21, "Fast EMA")
ema2_len = input.int(34, "Medium EMA")
ema3_len = input.int(90, "Slow EMA")

ema21 = ta.ema(close, ema1_len)
ema34 = ta.ema(close, ema2_len)
ema90 = ta.ema(close, ema3_len)

plot(ema21, color=color.green, title="EMA 21")
plot(ema34, color=color.orange, title="EMA 34")
plot(ema90, color=color.red, title="EMA 90")

// Stochastic (5, 3, 3)
stoch_k = input.int(5, "Stoch %K Length")
stoch_d = input.int(3, "Stoch %D Smooth")
stoch_smooth = input.int(3, "Stoch %K Smooth")

highest_high = ta.highest(high, stoch_k)
lowest_low = ta.lowest(low, stoch_k)
raw_k = 100 * (close - lowest_low) / (highest_high - lowest_low)
k = ta.sma(raw_k, stoch_smooth)
d = ta.sma(k, stoch_d)

stoch_oversold = k < 20 or d < 20
stoch_overbought = k > 80 or d > 80

// Trend Definitions based on EMAs
bullish_trend = close > ema21 and ema21 > ema34 and ema34 > ema90
bearish_trend = close < ema21 and ema21 < ema34 and ema34 < ema90

// ═══════════════════════════════════════════════════════════════════════════
// 2. CANDLESTICK UTILITIES
// ═══════════════════════════════════════════════════════════════════════════
body = math.abs(close - open)
atr = ta.atr(14)
avg_body = ta.sma(body, 14)

is_doji = body <= (high - low) * 0.1
is_marubozu = body > avg_body * 1.5 and math.min(open, close) - low <= (high - low) * 0.05 and high - math.max(open, close) <= (high - low) * 0.05

// ═══════════════════════════════════════════════════════════════════════════
// 3. PATTERN RECOGNITION LOGIC
// ═══════════════════════════════════════════════════════════════════════════

// --- Bullish Candlestick Patterns ---
p_hammer          = (hl2 > close[1]) and (math.min(open, close) - low) >= body * 2 and (high - math.max(open, close)) <= body * 0.25
p_inv_hammer      = (high - math.max(open, close)) >= body * 2 and (math.min(open, close) - low) <= body * 0.25
p_morning_star    = close[2] < open[2] and body[1] < avg_body * 0.5 and close > open and close > hl2[2]
p_classic_doji    = is_doji and (high - math.max(open, close)) > body and (math.min(open, close) - low) > body
p_bull_harami     = close[1] < open[1] and open > close[1] and close < open[1] and open > close and body[1] > body
p_bull_pinbar     = (close - low) / (high - low) >= 0.66 and (high - math.max(open, close)) / (high - low) <= 0.10
p_bull_engulfing  = close[1] < open[1] and close > open and open <= close[1] and close >= open[1]
p_three_white_sld = close > open and close[1] > open[1] and close[2] > open[2] and close > close[1] and close[1] > close[2]
p_dragonfly_doji  = is_doji and (high - math.max(open, close)) <= (high - low) * 0.1 and (math.min(open, close) - low) > body * 3
p_bull_marubozu   = is_marubozu and close > open
p_tweezer_bottom  = math.abs(low - low[1]) <= (atr * 0.05) and math.min(open, close) > low and math.min(open[1], close[1]) > low[1]

// --- Bearish Candlestick Patterns ---
p_bear_marubozu   = is_marubozu and close < open
p_tweezer_top     = math.abs(high - high[1]) <= (atr * 0.05) and high - math.max(open, close) > 0 and high[1] - math.max(open[1], close[1]) > 0
p_gravestone_doji = is_doji and (high - math.max(open, close)) > body * 3 and (math.min(open, close) - low) <= (high - low) * 0.1
p_dark_cloud      = close[1] > open[1] and open > high[1] and close < hl2[1] and close > open[1]
p_evening_star    = close[2] > open[2] and body[1] < avg_body * 0.5 and close < open and close < hl2[2]
p_bear_engulfing  = close[1] > open[1] and close < open and open >= close[1] and close <= open[1]
p_three_blk_crows = close < open and close[1] < open[1] and close[2] < open[2] and close < close[1] and close[1] < close[2]
p_hanging_man     = (bullish_trend[1] or stoch_overbought) and (math.min(open, close) - low) >= body * 2 and (high - math.max(open, close)) <= body * 0.25

// --- Simplified Classical Chart Patterns (Breakout Configurations) ---
p_falling_wedge   = ta.falling(high, 3) and ta.falling(low, 3) and (high - low) < (high[2] - low[2]) and close > high[1]
p_bull_rectangle  = math.abs(ta.highest(high, 5) - ta.highest(high, 10)) < atr * 0.2 and close > ta.highest(high, 5)[1]
p_bull_pennant    = ta.falling(high, 3) and ta.rising(low, 3) and close > high[1]

p_rising_wedge    = ta.rising(high, 3) and ta.rising(low, 3) and (high - low) < (high[2] - low[2]) and close < low[1]
p_bear_rectangle  = math.abs(ta.lowest(low, 5) - ta.lowest(low, 10)) < atr * 0.2 and close < ta.lowest(low, 5)[1]
p_bear_pennant    = ta.falling(high, 3) and ta.rising(low, 3) and close < low[1]

// --- Basic Harmonic Concept Filter (Bearish Pattern Structure Proxy) ---
// Simplified pattern checking structural swing context
pivot_high = ta.pivothigh(high, 4, 4)
p_bear_harmonic = not na(pivot_high) and close < open and stoch_overbought

// ═══════════════════════════════════════════════════════════════════════════
// 4. COMBINED SIGNAL DETERMINATION
// ═══════════════════════════════════════════════════════════════════════════

any_bullish_pattern = p_hammer or p_inv_hammer or p_morning_star or p_classic_doji or 
                      p_bull_harami or p_bull_pinbar or p_bull_engulfing or 
                      p_three_white_sld or p_dragonfly_doji or p_bull_marubozu or 
                      p_tweezer_bottom or p_falling_wedge or p_bull_rectangle or p_bull_pennant

any_bearish_pattern = p_bear_marubozu or p_tweezer_top or p_gravestone_doji or 
                      p_dark_cloud or p_evening_star or p_bear_engulfing or 
                      p_three_blk_crows or p_hanging_man or p_rising_wedge or 
                      p_bear_rectangle or p_bear_pennant or p_bear_harmonic

// Entry Conditions
// Buy when any bullish pattern forms while the market is in an overall uptrend OR oversold on the Stochastic
long_condition = any_bullish_pattern and (bullish_trend or stoch_oversold)

// Sell when any bearish pattern forms while the market is in an overall downtrend OR overbought on the Stochastic
short_condition = any_bearish_pattern and (bearish_trend or stoch_overbought)

// ═══════════════════════════════════════════════════════════════════════════
// 5. STRATEGY EXECUTION & RENDER
// ═══════════════════════════════════════════════════════════════════════════

if long_condition
    strategy.entry("Long", strategy.long)
    
if short_condition
    strategy.entry("Short", strategy.short)

// Simple ATR Based Dynamic Risk Management Exits
atr_stop = ta.atr(14)
if strategy.position_size > 0
    strategy.exit("Exit Long", "Long", stop=close - (atr_stop * 2), limit=close + (atr_stop * 4))

if strategy.position_size < 0
    strategy.exit("Exit Short", "Short", stop=close + (atr_stop * 2), limit=close - (atr_stop * 4))

// Visual shapes onto charts when patterns match filters
plotshape(long_condition, title="Bullish Setup Entry", location=location.belowbar, color=color.green, style=shape.triangleup, size=size.small)
plotshape(short_condition, title="Bearish Setup Entry", location=location.abovebar, color=color.red, style=shape.triangledown, size=size.small)