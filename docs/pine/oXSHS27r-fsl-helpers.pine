// @description A library with function helpers for FSL script families, including functions for plotting, formatting, etc. 
//@version=6
library("fsl_helpers")

import QuantNomad/fsl_theme/3 as th 

// Internal default width of the custom plot panel.
plot_width = 16

// @function
// Returns the internal panel width used by the helper library.
// @returns int Width of the custom plot panel.
export plot_width_get() =>
    plot_width

// @function
// Draws a vertical tick and label on the custom X-axis of the panel.
// @param x X-axis coordinate in panel space.
// @param inc Label value displayed below the tick.
// @param theme Theme used for the chart
export plot_x_axis(int x, string axis_text, th.Theme theme) =>
    line.new( x, -1.2, x, -1.1, color = theme.grid, style = line.style_solid)
    
    label.new(x, -1.33, axis_text, textcolor = theme.text_secondary, color = color.new(theme.bg_main, 100), 
              style = label.style_label_center)

// @function
// Draws a horizontal Y-axis guide line and corresponding price label.
// Converts the normalized panel coordinate to the actual price level.
// @param yy Normalized Y coordinate in panel space.
// @param min Minimum value of the plotted price range.
// @param max Maximum value of the plotted price range.
// @param theme Theme used for the chart
// @param plot_mult Horizontal spacing multiplier used by the panel.
// @returns void
export plot_y_axis(float yy, float min, float max, th.Theme theme, int plot_mult) =>
    y = max - (1-yy)/(2/(max-min)) 
    
    line.new(bar_index, yy, bar_index - (plot_width - 3) * plot_mult, yy, color = theme.grid, style = line.style_dashed)
    
    label.new(bar_index, yy, str.tostring(math.round_to_mintick(y)), textcolor = theme.text_secondary, color = color.new(theme.bg_main, 100), 
              style = label.style_label_left)

// @function
// Converts a price value into the normalized panel scale [-1, 1] used
// by the forward-curve plotting area.
// @param y Price value to scale.
// @param min Minimum value of the plotted price range.
// @param max Maximum value of the plotted price range.
// @returns float Normalized Y coordinate for plotting.
export plot_scale(float y, float min, float max) =>
    2 / (max - min) * (y - min) - 1

// @function
// Draws a scatter-point marker in the forward-curve panel.
// Optionally attaches a tooltip containing symbol, time, and price.
// @param x X index position within the curve.
// @param y Price value of the point.
// @param max Maximum value of the plotted price range.
// @param min Minimum value of the plotted price range.
// @param col Marker color.
// @param s Marker size.
// @param tiptool Text shown in the tooltip.
// @param theme Theme used for the chart
// @param plot_mult Horizontal spacing multiplier used by the panel.
// @returns void
export plot_scatter(int x, float y, float max, float min, color col, string s, 
                     string tiptool, th.Theme theme, int plot_mult) =>
    
    label.new(bar_index - (plot_width - 4) * plot_mult + x * plot_mult, plot_scale(y, min, max), "⬤", xloc.bar_index, yloc.price, 
              color.new(theme.bg_main, 100), label.style_label_center, col, s, tooltip = tiptool)


// @function
// Draws a line segment between two curve points in the panel.
// Used to connect consecutive futures contracts in the forward curve.
// @param x X position of the ending point.
// @param y Price value of the ending point.
// @param max Maximum value of the plotted price range.
// @param min Minimum value of the plotted price range.
// @param x1 X position of the starting point.
// @param y1 Price value of the starting point.
// @param col Line color.
// @param w Line width.
// @param sty Line style.
// @param plot_mult Horizontal spacing multiplier used by the panel.
// @returns void
export plot_line(int x, float y, float max, float min, int x1, float y1, color col, int w, string sty, int plot_mult) =>   
    line.new(bar_index - (plot_width - 4  - x1) * plot_mult, plot_scale(y1, min, max), bar_index - (plot_width - 4 - x) * plot_mult, plot_scale(y, min, max), 
             color = col, style = sty, width = w) 

// @function
// Draws a legend entry composed of a marker, line sample, and label.
// @param y Y position of the legend row.
// @param col Legend color.
// @param sty Line style used for the sample segment.
// @param txt Legend label text.
// @param theme Theme used for the chart
// @param plot_mult Horizontal spacing multiplier used by the panel.
// @returns void
export plot_legend(float y, color col, string sty, string txt, th.Theme theme, int plot_mult) =>    
    _x = 0

    label.new(bar_index - (plot_width - 1) * plot_mult + _x * plot_mult, y, "⬤", xloc.bar_index, yloc.price, color.new(theme.bg_secondary, 100), 
              label.style_label_center, col)

    line.new(bar_index - plot_width * plot_mult , y, bar_index - (plot_width - 1) * plot_mult + _x, y, color = col, style = sty, width = 2)

    label.new(bar_index - (plot_width - 1) * plot_mult + _x * plot_mult, y, txt, xloc.bar_index, yloc.price, color.new(theme.bg_secondary, 100), 
              label.style_label_left, col)

// @function
// Deletes all boxes currently drawn by the script.
// Useful before redrawing the custom panel.
// @returns void
export plot_remove_all_boxes() =>
    boxs = box.all
    if array.size(boxs) > 0
        for i = 0 to array.size(boxs) - 1
            box.delete(array.get(boxs, i))

// @function
// Deletes all labels currently drawn by the script.
// Useful before redrawing the custom panel.
// @returns void
export plot_remove_all_labels() =>
    labs = label.all
    if array.size(labs) > 0
        for i = 0 to array.size(labs) - 1
            label.delete(array.get(labs, i))

// @function
// Deletes all lines currently drawn by the script.
// Useful before redrawing the custom panel.
// @returns void
export plot_remove_all_lines() =>
    lins = line.all
    if array.size(lins) > 0
        for i = 0 to array.size(lins) - 1
            line.delete(array.get(lins, i))

// @function
// Draws the main panel boxes for the forward-curve display, including
// frame, title area, legend area, and timeframe header.
// @param main_title Main title for the plot
// @param theme Theme used for the chart
// @param plot_mult Horizontal spacing multiplier used by the panel.
// @returns void
export plot_main_boxes(string main_title, th.Theme theme, int plot_mult) =>
	
    // Plot Frame 
    box.new(bar_index-plot_width * plot_mult, 1.2, bar_index, -1.2,  theme.border, 2, bgcolor = color.new(theme.bg_secondary, 75))
    
    // Title
    box.new(bar_index-(plot_width - 3) * plot_mult, 1.5, bar_index,  1.18, theme.border, 2, bgcolor = color.new(theme.bg_secondary, 0), 
     text = main_title, text_color = theme.data_tx)
     
    // Legends
    box.new(bar_index-plot_width * plot_mult, 1.5, bar_index- (plot_width - 3) * plot_mult, -1.2, theme.border, 2, bgcolor = color.new(theme.bg_secondary, 50))
    
    //Timeframe
    box.new(bar_index-plot_width * plot_mult, 1.5, bar_index- (plot_width - 3) * plot_mult, 1.18, theme.border, 2, bgcolor = color.new(theme.bg_secondary, 0), 
     text = '' , text_color = theme.text_secondary)