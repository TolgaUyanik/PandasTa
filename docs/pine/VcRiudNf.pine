//@version=6
// =============================================================================
// MHIDa Strategy Honesty Dashboard
// A CONTEXT / educational tool, not a signal or advice. No promises.
// =============================================================================
//
// WHAT IT IS:
//   An "honesty" dashboard. It takes the trades of ONE strategy (the same
//   entry/exit logic you set in the inputs) and runs them through a "strict
//   bench": 6 panels that try to expose inflated numbers. It shows whether the
//   strategy "passes" or "does not pass" the bench.
//
// THE IDEA BEHIND IT:
//   A single headline return is easy to fool yourself with. The strict bench
//   instead asks for six things AT THE SAME TIME:
//     1) enough trades (>= a minimum)          -> no verdicts on 4 trades
//     2) a positive average return per trade    -> does an edge really exist?
//     3) it survives removing the lucky outliers -> not just 5 jackpot trades
//     4) it survives on the NEWER half of history -> not only old past (OOS)
//     5) it survives in WEAK / bear-like regimes  -> holds up when it's hard
//     6) it survives with HIGHER costs            -> holds with more fees/slippage
//   The defaults are sensible starting points and are fully editable:
//     min trades = 40 ; OOS = last 30% of bars ; cost stress = +0.1% per side.
//
// HOW TO READ IT (honest traffic light):
//   GREEN  = the panel holds.   RED = the panel fails (suspicious numbers).
//   Final verdict "PASS" ONLY if all six hold together.
//
// LIMITS — STATED CLEARLY:
//   - The sample strategy here is a simple "dip vs moving average + bar turning
//     up" with a moving-average / target / stop exit: it is an EDUCATIONAL
//     EXAMPLE, not a tuned production configuration. Change the inputs and
//     watch how the panels react.
//   - The trades are the ones generated by THIS chart/timeframe: results change
//     with symbol, period and settings. It is not a promise.
//   - No lookahead: signal on a closed bar, execution at the close.
//   - This is not a signal and not financial advice. Past numbers guarantee
//     nothing about the future.
// =============================================================================

strategy("MHIDa Strategy Honesty Dashboard",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100,
     commission_type=strategy.commission.percent,
     commission_value=0.1,
     calc_on_every_tick=false,
     process_orders_on_close=true,
     max_labels_count=500)

// -----------------------------------------------------------------------------
// INPUT — the sample strategy (EXAMPLE, not a real signal) + bench thresholds
// -----------------------------------------------------------------------------
grpStrat = "Sample strategy (educational example, editable)"
emaLen   = input.int(20,   "Reference moving average (EMA)",   minval=2,  group=grpStrat)
dipPct   = input.float(0.8,"Distance below the MA for a 'dip' (%)", minval=0.0, step=0.1, group=grpStrat)
exitMode = input.string("MA", "Exit mode", options=["MA","Target","Stop only"], group=grpStrat)
tgtPct   = input.float(2.0,"Exit target (%)",                   minval=0.1, step=0.1, group=grpStrat)
stopPct  = input.float(4.0,"Protective stop (%)",               minval=0.1, step=0.1, group=grpStrat)
maxBars  = input.int(48,   "Max bars in position",              minval=1,  group=grpStrat)

grpBanco = "Strict bench thresholds"
minTrades   = input.int(40,   "Minimum trades (below = RED)", minval=1, group=grpBanco)
oosFrac     = input.float(30, "Newer half of history: last % of bars", minval=5, maxval=80, step=5, group=grpBanco)
weakLen     = input.int(100,  "Slow MA for 'weak market' (EMA)", minval=10, group=grpBanco) // proxy for a bear/weak-regime filter
topCut      = input.int(5,    "How many 'jackpot' trades to remove", minval=1, maxval=20, group=grpBanco)
costStress  = input.float(0.1,"Extra stress cost per side (%)", minval=0.0, step=0.05, group=grpBanco)

grpUI = "Appearance"
showTbl = input.bool(true, "Show dashboard", group=grpUI)
tblPos  = input.string("Top right", "Position", options=["Top right","Top left","Bottom right","Bottom left"], group=grpUI)

// -----------------------------------------------------------------------------
// Base indicators
// -----------------------------------------------------------------------------
emaRef  = ta.ema(close, emaLen)        // reference MA for dip / exit
emaWeak = ta.ema(close, weakLen)       // "weak market" proxy (below = weak regime)

// "dip vs MA" + bar turning up: requires the previous close to be below the MA
//  by a given percentage AND the current close above the previous close.
isDip      = close[1] < emaRef[1] * (1 - dipPct / 100.0)
turnedUp   = close > close[1]
enterSig   = isDip and turnedUp

// "weak market" now (for the holds-in-weakness panel): price below the slow MA
weakNow    = not na(emaWeak) and close < emaWeak

// -----------------------------------------------------------------------------
// STRATEGY EXECUTION (so trades show up in the Strategy Tester)
//   exit: stop always; plus MA or target depending on the mode; plus max time.
// -----------------------------------------------------------------------------
inPos    = strategy.position_size > 0
barsHeld = inPos ? (bar_index - strategy.opentrades.entry_bar_index(strategy.opentrades - 1)) : 0

if enterSig and not inPos
    strategy.entry("Dip", strategy.long)

if inPos
    entryP = strategy.opentrades.entry_price(strategy.opentrades - 1)
    stopP  = entryP * (1 - stopPct / 100.0)
    strategy.exit("Stop", from_entry="Dip", stop=stopP,
         limit = exitMode == "Target" ? entryP * (1 + tgtPct / 100.0) : na)
    // MA exit (mode "MA")
    if exitMode == "MA" and high >= emaRef
        strategy.close("Dip", comment="MA")
    // max-time exit
    if barsHeld >= maxBars
        strategy.close("Dip", comment="Time")

// =============================================================================
// STRICT BENCH — computing the 6 panels on the closed trades
//   net via COMPOUNDED equity, trade count, remove-jackpots, newer-half (OOS),
//   weak regime, higher cost.
//   Work on an array of per-closed-trade returns (as a fraction, e.g. 0.012).
// =============================================================================
var float[] tRet  = array.new_float()   // net return per trade (fraction)
var int[]   tBar  = array.new_int()     // closing bar (for OOS)
var bool[]  tWeak = array.new_bool()    // was the trade born in a weak market?

// number of closed trades known so far
var int seenClosed = 0
closedNow = strategy.closedtrades

if closedNow > seenClosed
    for k = seenClosed to closedNow - 1
        // percentage return already NET of the tester commission
        eP = strategy.closedtrades.entry_price(k)
        xP = strategy.closedtrades.exit_price(k)
        r  = eP != 0 ? (xP - eP) / eP : 0.0
        // use the tester's net profit percent (already net of commissions)
        netR = strategy.closedtrades.profit_percent(k) / 100.0
        array.push(tRet,  netR)
        array.push(tBar,  strategy.closedtrades.exit_bar_index(k))
        eb = strategy.closedtrades.entry_bar_index(k)
        // the trade is "weak" if at the entry bar the price was below the slow MA
        wAtEntry = not na(emaWeak[bar_index - eb]) and close[bar_index - eb] < emaWeak[bar_index - eb]
        array.push(tWeak, wAtEntry)
    seenClosed := closedNow

// ---- helper functions (computed on the last bar) ----
// compounded net over a subset of returns (eq *= (1 + ret))
f_netComposto(float[] arr) =>
    float eq = 1.0
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            eq := eq * (1 + array.get(arr, i))
    (eq - 1) * 100.0

// simple average of the returns (average return per trade, in %)
f_media(float[] arr) =>
    array.size(arr) > 0 ? array.avg(arr) * 100.0 : 0.0

// panels computed ONLY on the last bar (dashboard frozen at end of history)
var bool   p1ok=false, p2ok=false, p3ok=false, p4ok=false, p5ok=false, p6ok=false
var float  v_n=0.0, v_avg=0.0, v_noTop=0.0, v_oos=0.0, v_weak=0.0, v_cost=0.0
var int    v_oosN=0, v_weakN=0, v_full=0
var float  v_netFull=0.0
var float  v_hold=0.0

if barstate.islastconfirmedhistory
    int n = array.size(tRet)
    v_full := n

    // --- full net (all trades) and buy & hold as a reference benchmark ---
    v_netFull := f_netComposto(tRet)
    // buy & hold (return of simply holding): first close vs last close
    float firstClose = close[bar_index]   // price at bar 0 (bar_index bars ago)
    v_hold := firstClose != 0 ? (close - firstClose) / firstClose * 100.0 : 0.0

    // === PANEL 1: number of trades (red below threshold) ===
    v_n  := n
    p1ok := n >= minTrades

    // === PANEL 2: average return per trade (>0) ===
    v_avg := f_media(tRet)
    p2ok  := v_avg > 0 and v_netFull > v_hold   // real edge and beats "just hold"

    // === PANEL 3: holds after removing the 'jackpots' (the topCut best) ===
    // copy, sort, drop the best, recompute compounded net
    float[] cp = array.copy(tRet)
    array.sort(cp, order.ascending)
    int cut = math.min(topCut, array.size(cp))
    if cut > 0 and array.size(cp) > 0
        for d = 1 to cut
            if array.size(cp) > 0
                array.pop(cp)   // removes the last = the best
    v_noTop := f_netComposto(cp)
    p3ok    := v_noTop > 0     // holds even without the lucky hits

    // === PANEL 4: holds on the NEWER half of history (OOS) ===
    int cutBar = math.round(bar_index * (1 - oosFrac / 100.0))
    float[] oosArr = array.new_float()
    if n > 0
        for i = 0 to n - 1
            if array.get(tBar, i) >= cutBar
                array.push(oosArr, array.get(tRet, i))
    v_oos  := f_netComposto(oosArr)
    v_oosN := array.size(oosArr)
    p4ok   := v_oos > 0 and v_oosN >= 15   // positive OOS net and enough OOS trades

    // === PANEL 5: holds in WEAK / bear-like regimes ===
    float[] weakArr = array.new_float()
    if n > 0
        for i = 0 to n - 1
            if array.get(tWeak, i)
                array.push(weakArr, array.get(tRet, i))
    v_weak  := f_netComposto(weakArr)
    v_weakN := array.size(weakArr)
    // weak-regime sample count requirement (default, scaled to the sample size)
    int weakMin = math.min(30, math.max(5, math.round(n * 0.15)))
    p5ok    := v_weak > 0 and v_weakN >= weakMin

    // === PANEL 6: holds with HIGHER cost (+costStress per side) ===
    // subtract 2*costStress (round trip) from each trade and recompute net
    float extra = (costStress / 100.0) * 2.0
    float[] cArr = array.new_float()
    if n > 0
        for i = 0 to n - 1
            array.push(cArr, array.get(tRet, i) - extra)
    v_cost := f_netComposto(cArr)
    p6ok   := v_cost > 0

// final verdict: PASS only if ALL six hold
bool passAll = p1ok and p2ok and p3ok and p4ok and p5ok and p6ok

// -----------------------------------------------------------------------------
// DASHBOARD (table). Green = holds, Red = fails.
// -----------------------------------------------------------------------------
f_pos() =>
    tblPos == "Top right"    ? position.top_right    :
     tblPos == "Top left"    ? position.top_left     :
     tblPos == "Bottom right"  ? position.bottom_right : position.bottom_left

cOK   = color.new(#1b8a3a, 0)
cBAD  = color.new(#b00020, 0)
cHEAD = color.new(#1a1a2e, 0)
cTXT  = color.white
cMUT  = color.new(#cccccc, 0)

f_cell(table t, int col, int row, string lbl, string val, bool ok) =>
    table.cell(t, col, row, lbl, text_color=cTXT, text_size=size.small, bgcolor=color.new(#2b2b3d, 0), text_halign=text.align_left)
    table.cell(t, col + 1, row, val, text_color=cTXT, text_size=size.small, bgcolor=ok ? cOK : cBAD, text_halign=text.align_right)

var table dash = na
if showTbl and barstate.islastconfirmedhistory
    dash := table.new(f_pos(), 2, 9, border_width=1, frame_color=color.new(#000000, 40), frame_width=1)

    table.cell(dash, 0, 0, "MHIDa Honesty Dashboard", text_color=cTXT, text_size=size.normal, bgcolor=cHEAD)
    table.cell(dash, 1, 0, "strict bench", text_color=cMUT, text_size=size.small, bgcolor=cHEAD)

    // 1) number of trades
    f_cell(dash, 0, 1, "1) Trades (>=" + str.tostring(minTrades) + ")",
         str.tostring(v_n, "#"), p1ok)
    // 2) average return per trade
    f_cell(dash, 0, 2, "2) Avg/trade vs hold " + str.tostring(v_hold, "#.0") + "%",
         str.tostring(v_avg, "#.000") + "%  net " + str.tostring(v_netFull, "#.0") + "%", p2ok)
    // 3) jackpots removed
    f_cell(dash, 0, 3, "3) Removed " + str.tostring(topCut, "#") + " jackpots",
         "net " + str.tostring(v_noTop, "#.0") + "%", p3ok)
    // 4) newer half (OOS)
    f_cell(dash, 0, 4, "4) Newer half (last " + str.tostring(oosFrac, "#") + "%)",
         "net " + str.tostring(v_oos, "#.0") + "% (n" + str.tostring(v_oosN, "#") + ")", p4ok)
    // 5) weak market
    f_cell(dash, 0, 5, "5) Weak market",
         "net " + str.tostring(v_weak, "#.0") + "% (n" + str.tostring(v_weakN, "#") + ")", p5ok)
    // 6) higher cost
    f_cell(dash, 0, 6, "6) Cost +" + str.tostring(costStress, "#.00") + "%/side",
         "net " + str.tostring(v_cost, "#.0") + "%", p6ok)

    // final verdict
    table.cell(dash, 0, 7, "VERDICT", text_color=cTXT, text_size=size.large, bgcolor=cHEAD)
    table.cell(dash, 1, 7, passAll ? "PASS" : "DOES NOT PASS",
         text_color=cTXT, text_size=size.large, bgcolor=passAll ? cOK : cBAD)

    // honest note
    table.cell(dash, 0, 8, "Educational example, not a signal. Past numbers != future.",
         text_color=cMUT, text_size=size.tiny, bgcolor=cHEAD)
    table.cell(dash, 1, 8, "MHIDa", text_color=cMUT, text_size=size.tiny, bgcolor=cHEAD)

// visual mark on the sample entry (educational)
plotshape(enterSig and not inPos and chart.is_standard, title="sample dip", style=shape.triangleup,
     location=location.belowbar, color=color.new(#1b8a3a, 0), size=size.tiny)
plot(emaRef,  "Reference MA", color=color.new(#4488ff, 0))
plot(emaWeak, "Slow MA (weak)", color=color.new(#888888, 30))