//@version=6
indicator("Daily EMAs (8, 21 & 50) with Band", shorttitle="Daily EMA 8/21/50 Band", overlay=true)

// Input settings
src = input.source(close, "Source")
ma_offset = input.int(0, "Offset")

// Calculate Daily EMAs using 'request.security'
ema8  = request.security(syminfo.tickerid, "D", ta.ema(src, 8))
ema21 = request.security(syminfo.tickerid, "D", ta.ema(src, 21))
ema50 = request.security(syminfo.tickerid, "D", ta.ema(src, 50))

// Plot the EMAs
plot(ema8,  color=color.lime,                  offset=ma_offset, title="8-Day EMA")
plot(ema21, color=color.aqua,                  offset=ma_offset, title="21-Day EMA")
plot(ema50, color=color.rgb(255, 255, 255),    offset=ma_offset, title="50-Day EMA")

// Define the fill color with 25% transparency
band_color = ema8 > ema21 ? color.new(color.green, 90) : color.new(color.blue, 90)

// Hidden plots for fill reference
p1 = plot(ema8, display=display.none)
p2 = plot(ema21, display=display.none)

// Fill between the 8 and 21 EMAs
fill(p1, p2, color=band_color, title="EMA Band")
