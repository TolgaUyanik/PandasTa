fx_sydney_countdown = show_fx_sydney ? get_countdown(fx_sydney_open_int, fx_sydney_close_int, "fx_sydney") : na
fx_tokyo_countdown = show_fx_tokyo ? get_countdown(fx_tokyo_open_int, fx_tokyo_close_int, "fx_tokyo") : na
fx_london_countdown = show_fx_london ? get_countdown(fx_london_open_int, fx_london_close_int, "fx_london") : na
