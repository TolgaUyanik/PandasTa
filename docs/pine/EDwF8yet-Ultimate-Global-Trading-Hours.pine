indicator("Ultimate Global Trading Hours", shorttitle="Global Markets Pro", overlay=true)

// ====== INPUT SETTINGS ======

// Sydney (ASX) - Opens first (~23:00 GMT previous day)
show_asx = input.bool(true, "Enable Sydney (ASX)", group="🇦🇺 Sydney (ASX)")
