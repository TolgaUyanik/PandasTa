        table.cell(market_table, 1, row, "FEAR & GREED ANALYSIS", text_color=color.white, bgcolor=color.new(color.navy, 70), text_size=get_size(table_size))
        row += 1
        
        // VIX Fear & Greed
        vix_text = str.tostring(vix_value, "#.##")
        table.cell(market_table, 0, row, "⚡ VIX (Fear):", text_color=text_color, text_size=get_size(table_size))
        table.cell(market_table, 1, row, vix_text + " " + vix_sentiment_text, text_color=vix_sentiment_color, text_size=get_size(table_size))
        row += 1
        
        // Put/Call Proxy (Fear/Greed)
        pc_text = str.tostring(put_call_ratio, "#.##")
        table.cell(market_table, 0, row, "🎭 Fear/Greed Proxy:", text_color=text_color, text_size=get_size(table_size))
        table.cell(market_table, 1, row, pc_text + " " + put_call_sentiment_text, text_color=put_call_sentiment_color, text_size=get_size(table_size))
        row += 1
        
        // Bond Market (Safe Haven)
        bond_text = (bond_sentiment >= 0 ? "+" : "") + str.tostring(bond_sentiment, "#.##") + "%"
        bond_color = bond_sentiment >= 1.0 ? color.red : bond_sentiment >= 0.5 ? color.orange : bond_sentiment <= -1.0 ? color.lime : bond_sentiment <= -0.5 ? color.green : color.gray
        bond_status = bond_sentiment >= 1.0 ? "🏃 Flight to Safety" : bond_sentiment >= 0.5 ? "🟡 Cautious" : bond_sentiment <= -1.0 ? "🚀 Risk On" : bond_sentiment <= -0.5 ? "🟢 Risk Positive" : "⚪ Neutral"
        table.cell(market_table, 0, row, "🏛️ Bonds vs Stocks:", text_color=text_color, text_size=get_size(table_size))
        table.cell(market_table, 1, row, bond_text + " " + bond_status, text_color=bond_color, text_size=get_size(table_size))
        row += 1
        
        // Weekly Trend
        weekly_text = (weekly_trend >= 0 ? "+" : "") + str.tostring(weekly_trend, "#.##") + "%"
        weekly_color = weekly_trend >= 2.0 ? color.lime : weekly_trend >= 0 ? color.green : weekly_trend <= -2.0 ? color.red : color.orange
        weekly_status = weekly_trend >= 2.0 ? "📈 Strong Uptrend" : weekly_trend >= 0 ? "🟢 Uptrend" : weekly_trend <= -2.0 ? "📉 Strong Downtrend" : "🟡 Downtrend"
        table.cell(market_table, 0, row, "📅 Weekly Trend:", text_color=text_color, text_size=get_size(table_size))
        table.cell(market_table, 1, row, weekly_text + " " + weekly_status, text_color=weekly_color, text_size=get_size(table_size))
        row += 1
    
    // Stock Markets Header
    table.cell(market_table, 0, row, "📈 STOCK MARKETS", text_color=color.yellow, bgcolor=color.new(color.blue, 80), text_size=get_size(table_size))
    table.cell(market_table, 1, row, "STATUS & COUNTDOWN", text_color=color.yellow, bgcolor=color.new(color.blue, 80), text_size=get_size(table_size))
    row += 1
    
    // Stock Markets (in chronological order)
    if show_asx
        table.cell(market_table, 0, row, "Sydney (ASX)", text_color=text_color, text_size=get_size(table_size))
        table.cell(market_table, 1, row, get_status_with_countdown(asx_is_open, asx_countdown), text_color=asx_is_open ? color.lime : color.red, text_size=get_size(table_size))
        row += 1
    
    if show_tokyo
        table.cell(market_table, 0, row, "Tokyo (TSE)", text_color=text_color, text_size=get_size(table_size))
        table.cell(market_table, 1, row, get_status_with_countdown(tokyo_is_open, tokyo_countdown), text_color=tokyo_is_open ? color.lime : color.red, text_size=get_size(table_size))
        row += 1
    
    if show_seoul
        table.cell(market_table, 0, row, "Seoul (KOSPI)", text_color=text_color, text_size=get_size(table_size))
        table.cell(market_table, 1, row, get_status_with_countdown(seoul_is_open, seoul_countdown), text_color=seoul_is_open ? color.lime : color.red, text_size=get_size(table_size))
        row += 1
    
    if show_hk
        table.cell(market_table, 0, row, "Hong Kong", text_color=text_color, text_size=get_size(table_size))
        table.cell(market_table, 1, row, get_status_with_countdown(hk_is_open, hk_countdown), text_color=hk_is_open ? color.lime : color.red, text_size=get_size(table_size))
        row += 1
    
    if show_mumbai
        table.cell(market_table, 0, row, "Mumbai (NSE)", text_color=text_color, text_size=get_size(table_size))
        table.cell(market_table, 1, row, get_status_with_countdown(mumbai_is_open, mumbai_countdown), text_color=mumbai_is_open ? color.lime : color.red, text_size=get_size(table_size))
        row += 1
    
    if show_lse
        table.cell(market_table, 0, row, "London (LSE)", text_color=text_color, text_size=get_size(table_size))
        table.cell(market_table, 1, row, get_status_with_countdown(lse_is_open, lse_countdown), text_color=lse_is_open ? color.lime : color.red, text_size=get_size(table_size))
        row += 1
    
    if show_frankfurt
        table.cell(market_table, 0, row, "Frankfurt (DAX)", text_color=text_color, text_size=get_size(table_size))
        table.cell(market_table, 1, row, get_status_with_countdown(frankfurt_is_open, frankfurt_countdown), text_color=frankfurt_is_open ? color.lime : color.red, text_size=get_size(table_size))
        row += 1
    
    if show_euronext
        table.cell(market_table, 0, row, "Euronext", text_color=text_color, text_size=get_size(table_size))
        table.cell(market_table, 1, row, get_status_with_countdown(euronext_is_open, euronext_countdown), text_color=euronext_is_open ? color.lime : color.red, text_size=get_size(table_size))
        row += 1
    
    if show_nyse
        table.cell(market_table, 0, row, "NYSE/NASDAQ", text_color=text_color, text_size=get_size(table_size))
        table.cell(market_table, 1, row, get_status_with_countdown(nyse_is_open, nyse_countdown), text_color=nyse_is_open ? color.lime : color.red, text_size=get_size(table_size))
        row += 1
    
    if show_toronto
        table.cell(market_table, 0, row, "Toronto (TSX)", text_color=text_color, text_size=get_size(table_size))
        table.cell(market_table, 1, row, get_status_with_countdown(toronto_is_open, toronto_countdown), text_color=toronto_is_open ? color.lime : color.red, text_size=get_size(table_size))
        row += 1
    
    if show_sao_paulo
        table.cell(market_table, 0, row, "São Paulo (B3)", text_color=text_color, text_size=get_size(table_size))
        table.cell(market_table, 1, row, get_status_with_countdown(sao_paulo_is_open, sao_paulo_countdown), text_color=sao_paulo_is_open ? color.lime : color.red, text_size=get_size(table_size))
        row += 1
    
    // Extended Hours
    if show_premarket or show_afterhours
        table.cell(market_table, 0, row, "⏰ EXTENDED HOURS", text_color=color.purple, bgcolor=color.new(color.purple, 80), text_size=get_size(table_size))
        table.cell(market_table, 1, row, "US MARKETS", text_color=color.purple, bgcolor=color.new(color.purple, 80), text_size=get_size(table_size))
        row += 1
        
        if show_premarket
            table.cell(market_table, 0, row, "Pre-Market", text_color=text_color, text_size=get_size(table_size))
            table.cell(market_table, 1, row, get_extended_status_with_countdown(premarket_is_open, premarket_countdown), text_color=premarket_is_open ? color.yellow : color.gray, text_size=get_size(table_size))
            row += 1
        
        if show_afterhours
            table.cell(market_table, 0, row, "After-Hours", text_color=text_color, text_size=get_size(table_size))
            table.cell(market_table, 1, row, get_extended_status_with_countdown(afterhours_is_open, afterhours_countdown), text_color=afterhours_is_open ? color.yellow : color.gray, text_size=get_size(table_size))
            row += 1
    
    // Forex Sessions
    if show_fx_sydney or show_fx_tokyo or show_fx_london or show_fx_ny
        table.cell(market_table, 0, row, "💱 FOREX SESSIONS", text_color=color.orange, bgcolor=color.new(color.orange, 80), text_size=get_size(table_size))
        table.cell(market_table, 1, row, "24/5 TRADING", text_color=color.orange, bgcolor=color.new(color.orange, 80), text_size=get_size(table_size))
        row += 1
        
        if show_fx_sydney
            table.cell(market_table, 0, row, "Sydney Session", text_color=text_color, text_size=get_size(table_size))
            table.cell(market_table, 1, row, get_status_with_countdown(fx_sydney_is_open, fx_sydney_countdown), text_color=fx_sydney_is_open ? color.lime : color.red, text_size=get_size(table_size))
            row += 1
        
        if show_fx_tokyo
            table.cell(market_table, 0, row, "Tokyo Session", text_color=text_color, text_size=get_size(table_size))
            table.cell(market_table, 1, row, get_status_with_countdown(fx_tokyo_is_open, fx_tokyo_countdown), text_color=fx_tokyo_is_open ? color.lime : color.red, text_size=get_size(table_size))
            row += 1
        
        if show_fx_london
            table.cell(market_table, 0, row, "London Session", text_color=text_color, text_size=get_size(table_size))
            table.cell(market_table, 1, row, get_status_with_countdown(fx_london_is_open, fx_london_countdown), text_color=fx_london_is_open ? color.lime : color.red, text_size=get_size(table_size))
            row += 1
        
        if show_fx_ny
            table.cell(market_table, 0, row, "New York Session", text_color=text_color, text_size=get_size(table_size))
            table.cell(market_table, 1, row, get_status_with_countdown(fx_ny_is_open, fx_ny_countdown), text_color=fx_ny_is_open ? color.lime : color.red, text_size=get_size(table_size))
            row += 1

// ====== ALERTS ======
alertcondition(nyse_is_open and not nyse_is_open[1], title="🔔 NYSE Opened", message="NYSE/NASDAQ market has opened!")
alertcondition(not nyse_is_open and nyse_is_open[1], title="🔔 NYSE Closed", message="NYSE/NASDAQ market has closed!")
alertcondition(lse_is_open and not lse_is_open[1], title="🔔 LSE Opened", message="London Stock Exchange has opened!")
alertcondition(total_markets_open >= 4 and total_markets_open[1] < 4, title="🔥 Peak Trading Hours", message="Peak trading period - 4+ markets active!")
alertcondition(us_eu_overlap and not us_eu_overlap[1], title="🌍 US-EU Overlap", message="US and European markets are now overlapping!")

// Background color based on activity
bg_activity_color = total_markets_open >= 6 ? color.new(color.green, 98) : total_markets_open >= 4 ? color.new(color.blue, 98) : total_markets_open >= 2 ? color.new(color.yellow, 99) : color.new(color.gray, 99)
bgcolor(bg_activity_color, title="Market Activity Background")