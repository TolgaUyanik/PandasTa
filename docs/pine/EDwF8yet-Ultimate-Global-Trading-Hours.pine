// Countdowns for all markets
nyse_countdown = show_nyse ? get_countdown(nyse_open_int, nyse_close_int, "nyse") : na
lse_countdown = show_lse ? get_countdown(lse_open_int, lse_close_int, "lse") : na
euronext_countdown = show_euronext ? get_countdown(euronext_open_int, euronext_close_int, "euronext") : na
frankfurt_countdown = show_frankfurt ? get_countdown(frankfurt_open_int, frankfurt_close_int, "frankfurt") : na
tokyo_countdown = show_tokyo ? get_countdown(tokyo_open_int, tokyo_close_int, "tokyo") : na
