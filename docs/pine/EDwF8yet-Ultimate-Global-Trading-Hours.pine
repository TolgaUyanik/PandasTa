fx_london_close = input.string("12:00", "Close Time (HH:MM EDT)", group="💱 London FX Session")

// New York FX
show_fx_ny = input.bool(false, "Enable New York FX Session", group="💱 New York FX Session")
fx_ny_open = input.string("08:00", "Open Time (HH:MM EDT)", group="💱 New York FX Session")
fx_ny_close = input.string("17:00", "Close Time (HH:MM EDT)", group="💱 New York FX Session")

// Display Options
user_timezone = input.string("GMT+1", "Your Timezone", options=["GMT-12", "GMT-11", "GMT-10", "GMT-9", "GMT-8", "GMT-7", "GMT-6", "GMT-5", "GMT-4", "GMT-3", "GMT-2", "GMT-1", "GMT", "GMT+1", "GMT+2", "GMT+3", "GMT+4", "GMT+5", "GMT+5:30", "GMT+6", "GMT+7", "GMT+8", "GMT+9", "GMT+10", "GMT+11", "GMT+12"], group="🎨 Display Options")
table_pos = input.string("Top Right", "Table Position", options=["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], group="🎨 Display Options")
compact_mode = input.bool(true, "Compact Mode", group="🎨 Display Options")
show_timeline = input.bool(true, "Show 24h Timeline", group="🎨 Display Options")
show_summary = input.bool(true, "Show Market Summary", group="🎨 Display Options")
show_sentiment = input.bool(true, "Show Market Sentiment", group="🎨 Display Options")
table_size = input.string("Normal", "Text Size", options=["Tiny", "Small", "Normal", "Large"], group="🎨 Display Options")
color_theme = input.string("Dark", "Color Theme", options=["Dark", "Light", "Blue", "Green"], group="🎨 Display Options")

// ====== 1-MINUTE TIME FUNCTIONS ======
// Force 1-minute updates regardless of chart timeframe
get_1m_time() =>
    request.security(syminfo.tickerid, "1", time, lookahead=barmerge.lookahead_off)

get_1m_hour() =>
    request.security(syminfo.tickerid, "1", hour, lookahead=barmerge.lookahead_off)

get_1m_minute() =>
    request.security(syminfo.tickerid, "1", minute, lookahead=barmerge.lookahead_off)

get_1m_dayofweek() =>
    request.security(syminfo.tickerid, "1", dayofweek, lookahead=barmerge.lookahead_off)

// ====== UTILITY FUNCTIONS ======
get_position(pos) =>
    pos == "Top Left" ? position.top_left : pos == "Top Center" ? position.top_center : pos == "Top Right" ? position.top_right : pos == "Middle Left" ? position.middle_left : pos == "Middle Center" ? position.middle_center : pos == "Middle Right" ? position.middle_right : pos == "Bottom Left" ? position.bottom_left : pos == "Bottom Center" ? position.bottom_center : position.bottom_right

get_size(sz) =>
    sz == "Tiny" ? size.tiny : sz == "Small" ? size.small : sz == "Normal" ? size.normal : sz == "Large" ? size.large : size.normal

// Convert HH:MM string to HHMM integer
time_to_int(time_str) =>
    parts = str.split(time_str, ":")
    if array.size(parts) == 2
        hours = str.tonumber(array.get(parts, 0))
        minutes = str.tonumber(array.get(parts, 1))
        math.round(hours * 100 + minutes)
    else
        0

// Convert GMT string to numeric offset
get_gmt_offset(tz) =>
    tz == "GMT-12" ? -12.0 : tz == "GMT-11" ? -11.0 : tz == "GMT-10" ? -10.0 : tz == "GMT-9" ? -9.0 : tz == "GMT-8" ? -8.0 : tz == "GMT-7" ? -7.0 : tz == "GMT-6" ? -6.0 : tz == "GMT-5" ? -5.0 : tz == "GMT-4" ? -4.0 : tz == "GMT-3" ? -3.0 : tz == "GMT-2" ? -2.0 : tz == "GMT-1" ? -1.0 : tz == "GMT" ? 0.0 : tz == "GMT+1" ? 1.0 : tz == "GMT+2" ? 2.0 : tz == "GMT+3" ? 3.0 : tz == "GMT+4" ? 4.0 : tz == "GMT+5" ? 5.0 : tz == "GMT+5:30" ? 5.5 : tz == "GMT+6" ? 6.0 : tz == "GMT+7" ? 7.0 : tz == "GMT+8" ? 8.0 : tz == "GMT+9" ? 9.0 : tz == "GMT+10" ? 10.0 : tz == "GMT+11" ? 11.0 : tz == "GMT+12" ? 12.0 : 0.0

// Theme Colors
get_theme_colors() =>
    bg_color = color_theme == "Light" ? color.new(color.white, 85) : color_theme == "Blue" ? color.new(color.navy, 85) : color_theme == "Green" ? color.new(color.teal, 85) : color.new(color.black, 85)
    header_color = color_theme == "Light" ? color.new(color.gray, 30) : color_theme == "Blue" ? color.new(color.blue, 50) : color_theme == "Green" ? color.new(color.green, 50) : color.new(color.blue, 70)
    text_color = color_theme == "Light" ? color.black : color.white
    [bg_color, header_color, text_color]

// ====== MARKET SENTIMENT FUNCTIONS ======
get_us_change() =>
    spy_close = request.security("SPY", "1D", close, lookahead=barmerge.lookahead_off)
    spy_prev = request.security("SPY", "1D", close[1], lookahead=barmerge.lookahead_off)
    vti_close = request.security("VTI", "1D", close, lookahead=barmerge.lookahead_off)
    vti_prev = request.security("VTI", "1D", close[1], lookahead=barmerge.lookahead_off)
    
    spy_change = spy_prev != 0 ? ((spy_close - spy_prev) / spy_prev) * 100 : 0
    vti_change = vti_prev != 0 ? ((vti_close - vti_prev) / vti_prev) * 100 : 0
    (spy_change + vti_change) / 2

get_europe_change() =>
    vgk_close = request.security("VGK", "1D", close, lookahead=barmerge.lookahead_off)
    vgk_prev = request.security("VGK", "1D", close[1], lookahead=barmerge.lookahead_off)
    vgk_prev != 0 ? ((vgk_close - vgk_prev) / vgk_prev) * 100 : 0

get_asia_change() =>
    vpl_close = request.security("VPL", "1D", close, lookahead=barmerge.lookahead_off)
    vpl_prev = request.security("VPL", "1D", close[1], lookahead=barmerge.lookahead_off)
    vpl_prev != 0 ? ((vpl_close - vpl_prev) / vpl_prev) * 100 : 0

get_vix_value() =>
    request.security("VIX", "1D", close, lookahead=barmerge.lookahead_off)

// Advanced sentiment indicators
get_put_call_ratio() =>
    // Since PCALL isn't available, use VIX/SPY ratio as proxy for fear/greed
    vix_close = request.security("VIX", "1D", close, lookahead=barmerge.lookahead_off)
    spy_close = request.security("SPY", "1D", close, lookahead=barmerge.lookahead_off)
    spy_sma = request.security("SPY", "1D", ta.sma(close, 20), lookahead=barmerge.lookahead_off)
    
    // Create synthetic put/call proxy: VIX level + distance from moving average
    vix_normalized = vix_close / 20.0  // Normalize VIX (20 is typical neutral level)
    spy_distance = spy_sma != 0 ? (spy_close - spy_sma) / spy_sma : 0
    
    // Higher values = more fear (like high put/call ratio)
    vix_normalized - (spy_distance * 2)

get_bond_sentiment() =>
    // TLT (20+ Year Treasury) vs SPY performance - Safe Haven Demand
    tlt_close = request.security("TLT", "1D", close, lookahead=barmerge.lookahead_off)
    tlt_prev = request.security("TLT", "1D", close[1], lookahead=barmerge.lookahead_off)
    spy_close = request.security("SPY", "1D", close, lookahead=barmerge.lookahead_off)
    spy_prev = request.security("SPY", "1D", close[1], lookahead=barmerge.lookahead_off)
    
    tlt_change = tlt_prev != 0 ? ((tlt_close - tlt_prev) / tlt_prev) * 100 : 0
    spy_change = spy_prev != 0 ? ((spy_close - spy_prev) / spy_prev) * 100 : 0
    
    // Positive = Flight to Safety (Bearish), Negative = Risk On (Bullish)
    tlt_change - spy_change

get_dollar_strength() =>
    // DXY US Dollar Index - Strong dollar can pressure global markets
    dxy_close = request.security("DXY", "1D", close, lookahead=barmerge.lookahead_off)
    dxy_prev = request.security("DXY", "1D", close[1], lookahead=barmerge.lookahead_off)
    dxy_prev != 0 ? ((dxy_close - dxy_prev) / dxy_prev) * 100 : 0

get_weekly_trend() =>
    // Weekly S&P 500 trend for medium-term sentiment
    spy_weekly = request.security("SPY", "1W", close, lookahead=barmerge.lookahead_off)
    spy_weekly_prev = request.security("SPY", "1W", close[1], lookahead=barmerge.lookahead_off)
    spy_weekly_prev != 0 ? ((spy_weekly - spy_weekly_prev) / spy_weekly_prev) * 100 : 0

get_volume_confirmation() =>
    // SPY volume vs 20-day average volume
    spy_volume = request.security("SPY", "1D", volume, lookahead=barmerge.lookahead_off)
    spy_volume_avg = request.security("SPY", "1D", ta.sma(volume, 20), lookahead=barmerge.lookahead_off)
    spy_volume_avg != 0 ? (spy_volume / spy_volume_avg) : 1

// Enhanced sentiment scoring
get_advanced_sentiment_score(us_change, bond_sentiment, put_call, dollar_change, weekly_trend, volume_ratio) =>
    score = 0.0
    
    // US Performance (30% weight)
    if us_change >= 1.0
        score += 30
    else if us_change >= 0.5
        score += 20
    else if us_change >= 0
        score += 10
    else if us_change >= -0.5
        score -= 10
    else if us_change >= -1.0
        score -= 20
    else
        score -= 30
    
    // Bond Market Fear/Greed (20% weight)
    if bond_sentiment <= -1.0  // Risk On
        score += 20
    else if bond_sentiment <= -0.5
        score += 10  
    else if bond_sentiment >= 1.0  // Flight to Safety
        score -= 20
    else if bond_sentiment >= 0.5
        score -= 10
    
    // Put/Call Ratio (20% weight) - Contrarian indicator (using synthetic ratio)
    if put_call >= 1.5  // Extreme Fear = Bullish
        score += 20
    else if put_call >= 1.2
        score += 10
    else if put_call <= 0.5  // Extreme Greed = Bearish
        score -= 20
    else if put_call <= 0.8
        score -= 10
    
    // Weekly Trend (15% weight)
    if weekly_trend >= 2.0
        score += 15
    else if weekly_trend >= 0
        score += 7
    else if weekly_trend <= -2.0
        score -= 15
    else
        score -= 7
    
    // Volume Confirmation (10% weight)
    if volume_ratio >= 1.5  // High volume confirms moves
        score += (us_change > 0 ? 10 : -10)
    else if volume_ratio >= 1.2
        score += (us_change > 0 ? 5 : -5)
    
    // Dollar Impact (5% weight)
    if dollar_change >= 1.0  // Strong dollar can pressure markets
        score -= 5
    else if dollar_change <= -1.0  // Weak dollar can help markets
        score += 5
    
    score

get_advanced_sentiment_text(score) =>
    if score >= 60
        "🚀 VERY BULLISH"
    else if score >= 30
        "📈 BULLISH"
    else if score >= 15
        "🟢 MILD BULLISH"
    else if score >= -15
        "⚪ NEUTRAL"
    else if score >= -30
        "🟡 MILD BEARISH"
    else if score >= -60
        "📉 BEARISH"
    else
        "💥 VERY BEARISH"

get_advanced_sentiment_color(score) =>
    if score >= 60
        color.new(color.lime, 0)
    else if score >= 30
        color.lime
    else if score >= 15
        color.green
    else if score >= -15
        color.gray
    else if score >= -30
        color.orange
    else if score >= -60
        color.red
    else
        color.new(color.red, 0)

get_sentiment_text(change_pct) =>
    if change_pct >= 1.5
        "🚀 Very Bullish"
    else if change_pct >= 0.5
        "📈 Bullish"
    else if change_pct >= 0.1
        "🟢 Mild Bullish"
    else if change_pct >= -0.1
        "⚪ Neutral"
    else if change_pct >= -0.5
        "🟡 Mild Bearish"
    else if change_pct >= -1.5
        "📉 Bearish"
    else
        "💥 Very Bearish"

get_sentiment_color(change_pct) =>
    if change_pct >= 0.5
        color.lime
    else if change_pct >= 0.1
        color.green
    else if change_pct >= -0.1
        color.gray
    else if change_pct >= -0.5
        color.orange
    else
        color.red

get_vix_sentiment_text(vix_value) =>
    if vix_value < 15
        "😎 Very Low"
    else if vix_value < 20
        "🟢 Low"
    else if vix_value < 25
        "⚪ Normal"
    else if vix_value < 30
        "🟡 Elevated"
    else
        "🔥 High"

get_vix_sentiment_color(vix_value) =>
    if vix_value < 15
        color.lime
    else if vix_value < 20
        color.green
    else if vix_value < 25
        color.gray
    else if vix_value < 30
        color.orange
    else
        color.red

get_put_call_text(ratio) =>
    // Adjusted for synthetic ratio (VIX-based proxy)
    if ratio >= 1.5
        "😨 Extreme Fear"
    else if ratio >= 1.2
        "🟡 Bearish"
    else if ratio >= 0.8
        "⚪ Neutral"
    else if ratio >= 0.5
        "🟢 Bullish"
    else
        "🤑 Extreme Greed"

get_put_call_color(ratio) =>
    // Adjusted for synthetic ratio - contrarian interpretation
    if ratio >= 1.5
        color.lime  // Extreme fear = bullish
    else if ratio >= 1.2
        color.green
    else if ratio >= 0.8
        color.gray
    else if ratio >= 0.5
        color.orange
    else
        color.red  // Extreme greed = bearish

get_overall_sentiment_text(us_change, europe_change, asia_change) =>
    avg_change = (us_change + europe_change + asia_change) / 3
    positive_markets = (us_change > 0 ? 1 : 0) + (europe_change > 0 ? 1 : 0) + (asia_change > 0 ? 1 : 0)
    
    if avg_change >= 0.5 and positive_markets >= 2
        "🟢 BULLISH"
    else if avg_change >= 0.2 or positive_markets >= 2
        "📈 MIXED BULLISH"
    else if avg_change >= -0.2 and positive_markets >= 1
        "⚪ NEUTRAL"
    else if avg_change >= -0.5 or positive_markets >= 1
        "📉 MIXED BEARISH"
    else
        "🔴 BEARISH"

get_overall_sentiment_color(us_change, europe_change, asia_change) =>
    avg_change = (us_change + europe_change + asia_change) / 3
    positive_markets = (us_change > 0 ? 1 : 0) + (europe_change > 0 ? 1 : 0) + (asia_change > 0 ? 1 : 0)
    
    if avg_change >= 0.5 and positive_markets >= 2
        color.lime
    else if avg_change >= 0.2 or positive_markets >= 2
        color.green
    else if avg_change >= -0.2 and positive_markets >= 1
        color.gray
    else if avg_change >= -0.5 or positive_markets >= 1
        color.orange
    else
        color.red

// ====== MARKET STATUS FUNCTIONS (Updated for 1-minute) ======
// Fixed timezone offsets for each market
get_market_timezone(market) =>
    market == "nyse" ? -4.0 : market == "lse" ? 1.0 : market == "euronext" ? 2.0 : market == "frankfurt" ? 2.0 : market == "tokyo" ? 9.0 : market == "hk" ? 8.0 : market == "asx" ? 11.0 : market == "toronto" ? -4.0 : market == "mumbai" ? 5.5 : market == "sao_paulo" ? -3.0 : market == "seoul" ? 9.0 : market == "premarket" ? -4.0 : market == "afterhours" ? -4.0 : market == "fx_sydney" ? -4.0 : market == "fx_tokyo" ? -4.0 : market == "fx_london" ? -4.0 : market == "fx_ny" ? -4.0 : 0.0

is_market_open(open_time, close_time, market_name) =>
    // Get current UTC time from 1-minute timeframe
    utc_time = get_1m_time()
    utc_hour = get_1m_hour()
    utc_min = get_1m_minute()
    utc_weekday = get_1m_dayofweek()
    
    // Convert UTC to market timezone
    market_offset = get_market_timezone(market_name)
    market_hour_float = utc_hour + market_offset
    market_day_offset = 0
    
    // Handle day rollover for market time
    if market_hour_float < 0
        market_hour_float += 24
        market_day_offset := -1
    else if market_hour_float >= 24
        market_hour_float -= 24
        market_day_offset := 1
        
    market_hour = math.floor(market_hour_float)
    market_min = utc_min
    market_weekday = utc_weekday + market_day_offset
    
    // Normalize market weekday
    if market_weekday < 1
        market_weekday += 7
    else if market_weekday > 7
        market_weekday -= 7
    
    // Check weekend in MARKET's timezone
    is_weekend = market_weekday == 7 or market_weekday == 1
    if is_weekend
        false
    else
        // Convert market time to HHMM format for comparison
        current_market_time = market_hour * 100 + market_min
        current_market_time >= open_time and current_market_time <= close_time

get_countdown(open_time, close_time, market_name) =>
    // Get current UTC time from 1-minute timeframe
    utc_time = get_1m_time()
    utc_hour = get_1m_hour()
    utc_min = get_1m_minute()
    utc_weekday = get_1m_dayofweek()
    
    // Get timezone offsets
    user_offset = get_gmt_offset(user_timezone)
    market_offset = get_market_timezone(market_name)
    
    // Convert UTC to market timezone to check if it's weekend there
    market_hour_float = utc_hour + market_offset
    market_day_offset = 0
    
    if market_hour_float < 0
        market_hour_float += 24
        market_day_offset := -1
    else if market_hour_float >= 24
        market_hour_float -= 24
        market_day_offset := 1
        
    market_weekday = utc_weekday + market_day_offset
    
    // Normalize market weekday
    if market_weekday < 1
        market_weekday += 7
    else if market_weekday > 7
        market_weekday -= 7
    
    // Check if it's weekend in MARKET's timezone
    is_weekend_in_market = market_weekday == 7 or market_weekday == 1
    
    // Convert current UTC to user's timezone for display calculations
    user_hour_float = utc_hour + user_offset
    user_day_offset = 0
    
    if user_hour_float < 0
        user_hour_float += 24
        user_day_offset := -1
    else if user_hour_float >= 24
        user_hour_float -= 24
        user_day_offset := 1
        
    user_hour = math.floor(user_hour_float)
    user_min = utc_min
    user_current_minutes = user_hour * 60 + user_min
    
    // Parse market open/close times
    open_hour = math.floor(open_time / 100)
    open_minutes = open_time % 100
    close_hour = math.floor(close_time / 100)
    close_minutes = close_time % 100
    
    if is_weekend_in_market
        // Weekend in market timezone - calculate time until Monday market open
        days_until_monday = market_weekday == 7 ? 2 : 1
        
        // Monday market open time in market's local time (minutes since Monday midnight)
        monday_market_open_minutes = open_hour * 60 + open_minutes
        
        // Convert to user's timezone
        timezone_diff_minutes = (market_offset - user_offset) * 60
        monday_open_in_user_tz = monday_market_open_minutes + timezone_diff_minutes
        
        // Handle day rollover
        day_adjustment = 0
        if monday_open_in_user_tz < 0
            monday_open_in_user_tz += (24 * 60)
            day_adjustment := -1
        else if monday_open_in_user_tz >= (24 * 60)
            monday_open_in_user_tz -= (24 * 60)
            day_adjustment := 1
            
        actual_days_until_monday = days_until_monday + day_adjustment
        
        // Calculate total minutes from now until Monday open
        total_minutes = (actual_days_until_monday * 24 * 60) - user_current_minutes + monday_open_in_user_tz
        
        math.max(total_minutes, 0)
    else
        // Weekday in market timezone - normal calculation
        market_hour = math.floor(market_hour_float)
        market_min = utc_min
        current_market_time = market_hour * 100 + market_min
        
        // Check if market is currently open
        market_is_open = current_market_time >= open_time and current_market_time <= close_time
        
        if market_is_open
            // Market is open - time until close
            market_close_minutes = close_hour * 60 + close_minutes
            market_current_minutes = market_hour * 60 + market_min
            minutes_until_close = market_close_minutes - market_current_minutes
            
            // Convert to user's timezone perspective
            timezone_diff_minutes = (market_offset - user_offset) * 60
            math.max(minutes_until_close, 0)
        else
            // Market is closed - time until next open
            market_open_minutes = open_hour * 60 + open_minutes
            market_current_minutes = market_hour * 60 + market_min
            
            if market_current_minutes < market_open_minutes
                // Market opens later today
                minutes_until_open = market_open_minutes - market_current_minutes
                math.max(minutes_until_open, 0)
            else
                // Market opens tomorrow
                minutes_until_tomorrow_open = (24 * 60) - market_current_minutes + market_open_minutes
                math.max(minutes_until_tomorrow_open, 0)

// ====== CALCULATE ALL MARKET STATUS ======
// Convert all time strings to integers
nyse_open_int = time_to_int(nyse_open)
