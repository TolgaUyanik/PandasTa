put_call_sentiment_text = show_sentiment ? get_put_call_text(put_call_ratio) : ""
put_call_sentiment_color = show_sentiment ? get_put_call_color(put_call_ratio) : color.gray

// ====== ANALYSIS & OVERLAPS ======
// Count active markets
stock_markets_open = (nyse_is_open ? 1 : 0) + (lse_is_open ? 1 : 0) + (euronext_is_open ? 1 : 0) + (frankfurt_is_open ? 1 : 0) + (tokyo_is_open ? 1 : 0) + (hk_is_open ? 1 : 0) + (asx_is_open ? 1 : 0) + (toronto_is_open ? 1 : 0) + (mumbai_is_open ? 1 : 0) + (sao_paulo_is_open ? 1 : 0) + (seoul_is_open ? 1 : 0)

fx_sessions_open = (fx_sydney_is_open ? 1 : 0) + (fx_tokyo_is_open ? 1 : 0) + (fx_london_is_open ? 1 : 0) + (fx_ny_is_open ? 1 : 0)

total_markets_open = stock_markets_open + fx_sessions_open

// Market Activity Level
activity_level = total_markets_open >= 6 ? "🔥 PEAK" : total_markets_open >= 4 ? "📈 HIGH" : total_markets_open >= 2 ? "📊 ACTIVE" : total_markets_open >= 1 ? "📉 LOW" : "😴 QUIET"

// Major Overlaps
us_eu_overlap = (nyse_is_open or toronto_is_open) and (lse_is_open or euronext_is_open or frankfurt_is_open)
asia_eu_overlap = (tokyo_is_open or hk_is_open or mumbai_is_open or seoul_is_open) and (lse_is_open or euronext_is_open or frankfurt_is_open)
us_asia_overlap = (nyse_is_open or toronto_is_open) and (tokyo_is_open or hk_is_open or asx_is_open)

// Format time with comprehensive display
format_time(minutes) =>
    if na(minutes)
        "N/A"
    else if minutes >= 1440
        days = math.floor(minutes / 1440)
        remaining_minutes = minutes % 1440
        hours = math.floor(remaining_minutes / 60)
        mins = remaining_minutes % 60
        if compact_mode
            str.tostring(days) + "d " + str.tostring(hours) + "h " + str.tostring(mins) + "m"
        else
            str.tostring(days) + " day" + (days != 1 ? "s " : " ") + str.tostring(hours) + "h " + str.tostring(mins) + "m"
    else
        hours = math.floor(minutes / 60)
        mins = minutes % 60
        if compact_mode
            str.tostring(hours) + "h " + str.tostring(mins) + "m"
        else
            str.tostring(hours) + " hour" + (hours != 1 ? "s " : " ") + str.tostring(mins) + " min"

// Get status with countdown for different market types
get_status_with_countdown(is_open, countdown_minutes) =>
    status = is_open ? "🟢 OPEN" : "🔴 CLOSED"
    action = is_open ? "Closes in: " : "Opens in: "
    if compact_mode
        status + " " + format_time(countdown_minutes)
    else
        status + " - " + action + format_time(countdown_minutes)

// Get status for extended hours
get_extended_status_with_countdown(is_open, countdown_minutes) =>
    status = is_open ? "🟡 ACTIVE" : "⚫ CLOSED"
    action = is_open ? "Ends in: " : "Starts in: "
    if compact_mode
        status + " " + format_time(countdown_minutes)
    else
        status + " - " + action + format_time(countdown_minutes)

// ====== CREATE TABLE ======
[bg_color, header_color, text_color] = get_theme_colors()
var table market_table = table.new(get_position(table_pos), 2, 50, bgcolor=bg_color, border_width=1, border_color=color.gray)

// Current time in user's timezone (using 1-minute data)
utc_time = get_1m_time()
utc_hour = get_1m_hour()
utc_min = get_1m_minute()
user_offset = get_gmt_offset(user_timezone)
user_hour_float = utc_hour + user_offset

// Handle day rollover
if user_hour_float < 0
    user_hour_float += 24
else if user_hour_float >= 24
    user_hour_float -= 24
    
user_hour = math.floor(user_hour_float)
user_min = utc_min
time_str = str.tostring(user_hour, "#00") + ":" + str.tostring(user_min, "#00")

if barstate.islast
    table.clear(market_table, 0, 0, 1, 49)
    
    row = 0
    
    // Header
    table.cell(market_table, 0, row, "🌍 GLOBAL MARKETS", text_color=color.white, bgcolor=header_color, text_size=get_size(table_size))
    table.cell(market_table, 1, row, activity_level, text_color=color.white, bgcolor=header_color, text_size=get_size(table_size))
    row += 1
    
    // Your Time
    table.cell(market_table, 0, row, "⏰ Your Time:", text_color=color.aqua, text_size=get_size(table_size))
    table.cell(market_table, 1, row, time_str + " " + user_timezone, text_color=color.aqua, text_size=get_size(table_size))
    row += 1
    
    // Summary
    if show_summary
        table.cell(market_table, 0, row, "📊 Markets Open:", text_color=text_color, text_size=get_size(table_size))
        table.cell(market_table, 1, row, str.tostring(stock_markets_open) + " Stock, " + str.tostring(fx_sessions_open) + " FX", text_color=text_color, text_size=get_size(table_size))
        row += 1
        
        // Overlaps
        if us_eu_overlap or asia_eu_overlap or us_asia_overlap
            overlap_text = us_eu_overlap ? "🇺🇸🇪🇺 " : ""
            overlap_text := overlap_text + (asia_eu_overlap ? "🇦🇸🇪🇺 " : "")
            overlap_text := overlap_text + (us_asia_overlap ? "🇺🇸🇦🇸" : "")
            table.cell(market_table, 0, row, "🔄 Overlaps:", text_color=color.orange, text_size=get_size(table_size))
            table.cell(market_table, 1, row, overlap_text, text_color=color.orange, text_size=get_size(table_size))
            row += 1
    
    // Market Sentiment
    if show_sentiment
        table.cell(market_table, 0, row, "📊 ADVANCED SENTIMENT", text_color=color.white, bgcolor=color.new(color.purple, 70), text_size=get_size(table_size))
        table.cell(market_table, 1, row, overall_sentiment_text, text_color=overall_sentiment_color, bgcolor=color.new(color.purple, 70), text_size=get_size(table_size))
        row += 1
        
        // US Markets Sentiment
        us_pct_text = (us_change >= 0 ? "+" : "") + str.tostring(us_change, "#.##") + "%"
        table.cell(market_table, 0, row, "🇺🇸 US Markets:", text_color=text_color, text_size=get_size(table_size))
        table.cell(market_table, 1, row, us_pct_text + " " + get_sentiment_text(us_change), text_color=get_sentiment_color(us_change), text_size=get_size(table_size))
        row += 1
        
        // Europe Sentiment
        europe_pct_text = (europe_change >= 0 ? "+" : "") + str.tostring(europe_change, "#.##") + "%"
        table.cell(market_table, 0, row, "🇪🇺 Europe:", text_color=text_color, text_size=get_size(table_size))
