asx_close = input.string("16:00", "Close Time (HH:MM AEDT)", group="🇦🇺 Sydney (ASX)")

// Tokyo (TSE) - Opens ~00:00 GMT
show_tokyo = input.bool(true, "Enable Tokyo (TSE)", group="🇯🇵 Tokyo (TSE)")
