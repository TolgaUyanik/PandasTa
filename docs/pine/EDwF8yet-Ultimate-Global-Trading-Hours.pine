fx_sydney_is_open = show_fx_sydney and is_market_open(fx_sydney_open_int, fx_sydney_close_int, "fx_sydney")
fx_tokyo_is_open = show_fx_tokyo and is_market_open(fx_tokyo_open_int, fx_tokyo_close_int, "fx_tokyo")
