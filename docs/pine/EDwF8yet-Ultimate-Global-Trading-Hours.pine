asx_countdown = show_asx ? get_countdown(asx_open_int, asx_close_int, "asx") : na
toronto_countdown = show_toronto ? get_countdown(toronto_open_int, toronto_close_int, "toronto") : na
mumbai_countdown = show_mumbai ? get_countdown(mumbai_open_int, mumbai_close_int, "mumbai") : na
sao_paulo_countdown = show_sao_paulo ? get_countdown(sao_paulo_open_int, sao_paulo_close_int, "sao_paulo") : na
