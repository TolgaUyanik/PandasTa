//@version=5
indicator('TrendShift [MOT]', overlay=true)

// === INPUTS === //
// EMA Inputs
ema_len1 = input.int(21, title='EMA Length 1')
ema_len2 = input.int(50, title='EMA Length 2')
ema_len3 = input.int(100, title='EMA Length 3')
ema_len4 = input.int(200, title='EMA Length 4')

// ATR Trailing Stop Inputs
atrLen = input.int(9, title='ATR Period', minval=1)
hhvLen = input.int(10, title='HHV Period', minval=1)
atrMult = input.float(2.9, title='ATR Multiplier', minval=0.1)

// Stochastic RSI Inputs
smoothK = input.int(3, 'K', minval=1)
smoothD = input.int(3, 'D', minval=1)
stochRsiLen = input.int(15, 'Stoch RSI Length', minval=1)
stochLen = input.int(15, 'Stochastic Length', minval=1)

// RSI Input
rsiLen = input.int(15, title='RSI Length')

// Volume Inputs
volLen = input.int(20, title='Volume Average Length')

// Bar Logic Input
maxBars = input.int(5, title='Max Bars Between Conditions')

// === SL/TP Inputs (Points) ===
enableSLTP = input.bool(true, "Enable Stop Loss / Take Profit Lines")
slPoints = input.float(5.0, "Stop Loss (Points)", step=0.25)
tpPoints = input.float(10.0, "Take Profit (Points)", step=0.25)
slColor = input.color(color.red, "Stop Loss Line Color")
tpColor = input.color(color.green, "Take Profit Line Color")

tablePos = input.string("Top Right", title="Signal Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"])

// Map string input to table position
position = tablePos == "Top Right" ? position.top_right :
      tablePos == "Top Left" ? position.top_left :
      tablePos == "Bottom Right" ? position.bottom_right :
      position.bottom_left

// === EMA CALCULATIONS === //
ema1 = ta.ema(close, ema_len1)
ema2 = ta.ema(close, ema_len2)
ema3 = ta.ema(close, ema_len3)
ema4 = ta.ema(close, ema_len4)

emaColor(e) => e >= e[1] ? color.green : color.red
plot(ema1, title='EMA 1', color=emaColor(ema1), linewidth=1)
plot(ema2, title='EMA 2', color=emaColor(ema2), linewidth=1)
plot(ema3, title='EMA 3', color=emaColor(ema3), linewidth=1)
plot(ema4, title='EMA 4', color=emaColor(ema4), linewidth=1)

// === ATR TRAILING STOP === //
atrVal = ta.atr(atrLen)
stopBase = high - atrMult * atrVal
highestStop = ta.highest(stopBase, hhvLen)
prevStop = highestStop[1]

trailStop = ta.cum(1) < 16 ? close : (close > highestStop and close > close[1] ? highestStop : prevStop)

buySignal = ta.crossover(close, trailStop)
sellSignal = ta.crossunder(close, trailStop)

// === STOCHASTIC RSI === //
rsiStoch = ta.rsi(close, stochRsiLen)
k = ta.sma(ta.stoch(rsiStoch, rsiStoch, rsiStoch, stochLen), smoothK)
d = ta.sma(k, smoothD)

// === RSI & VOLUME === //
rsi = ta.rsi(close, rsiLen)
volAvg = ta.sma(volume, volLen)

// === ENTRY CONDITIONS === //
barsWithin(cond) => ta.barssince(cond) <= maxBars

longSignalRaw = barsWithin(ta.crossover(k, d)) and barsWithin(ta.crossover(rsi, 20)) and barsWithin(ta.crossover(k, 20) or ta.crossover(d, 20)) and barsWithin(volume > volAvg)

shortSignalRaw = barsWithin(ta.crossunder(k, d)) and barsWithin(ta.crossunder(rsi, 80)) and barsWithin(ta.crossunder(k, 80) or ta.crossunder(d, 80)) and barsWithin(volume > volAvg)

// Filter duplicate entries
longSignal = longSignalRaw and not longSignalRaw[1]
shortSignal = shortSignalRaw and not shortSignalRaw[1]

// === Entry and SL/TP Tracking ===
var float longEntry = na
var float longSL = na
var float longTP = na
var int longBar = na

var float shortEntry = na
var float shortSL = na
var float shortTP = na
var int shortBar = na

// === Entry Prices ===
if longSignal
    longEntry := close
    shortEntry := na
    longSL := longEntry - slPoints
    longTP := longEntry + tpPoints
    longBar := bar_index

if shortSignal
    shortEntry := close
    longEntry := na
    shortSL := shortEntry + slPoints
    shortTP := shortEntry - tpPoints
    shortBar := bar_index

// === Invalidate SL/TP after signal bar ===
if not na(longEntry) and bar_index > longBar
    if low <= longSL or high >= longTP
        longEntry := na
        longSL := na
        longTP := na

if not na(shortEntry) and bar_index > shortBar
    if high >= shortSL or low <= shortTP
        shortEntry := na
        shortSL := na
        shortTP := na


// === POSITION TRACKING === //
var float pos = na
pos := longSignal ? 1 : shortSignal ? -1 : pos[1]

// === Plot SL/TP Lines ===
// === SL/TP Line Plotting ===
plot(enableSLTP and not na(longSL) ? longSL : na, title="Long SL", color=slColor, linewidth=1, style=plot.style_linebr)
plot(enableSLTP and not na(longTP) ? longTP : na, title="Long TP", color=tpColor, linewidth=1, style=plot.style_linebr)

plot(enableSLTP and not na(shortSL) ? shortSL : na, title="Short SL", color=slColor, linewidth=1, style=plot.style_linebr)
plot(enableSLTP and not na(shortTP) ? shortTP : na, title="Short TP", color=tpColor, linewidth=1, style=plot.style_linebr)

// === PLOTS & ALERTS === //
plotshape(longSignal, title='Buy Signal', location=location.belowbar, style=shape.triangleup, color=color.lime, size=size.small, text='BUY')
plotshape(shortSignal, title='Sell Signal', location=location.abovebar, style=shape.triangledown, color=color.red, size=size.small, text='SELL')

alertcondition(longSignal, title='BUY Alert', message='BUY Signal Triggered')
alertcondition(shortSignal, title='SELL Alert', message='SELL Signal Triggered')

isDark = input.bool(true, "Dark Theme?", inline="theme")
themeBg = isDark ? color.new(color.black, 85) : color.new(color.white, 85)
titleColor = isDark ? color.white : color.black
labelColor = isDark ? color.white : color.black
valueColor = isDark ? color.lime : color.green

// === Create table ===
var table signalTable = table.new(position, 2, 4, border_width=1, frame_color=color.gray, border_color=color.gray, bgcolor=themeBg)

// === Signal logic ===
emaTrend = ema1 > ema1[1] and ema2 > ema2[1] and ema3 > ema3[1] and ema4 > ema4[1] ? "Bullish" :
           ema1 < ema1[1] and ema2 < ema2[1] and ema3 < ema3[1] and ema4 < ema4[1] ? "Bearish" : "Mixed"

stochStatus = k < 20 and d < 20 ? "Oversold" :
              k > 80 and d > 80 ? "Overbought" :
              "Neutral"

rsiStatus = rsi < 30 ? "Oversold" : rsi > 70 ? "Overbought" : "Neutral"
rsiValueDisplay = str.tostring(rsi, "#.##") + " (" + rsiStatus + ")"

volumeStatus = volume > volAvg ? "Above Avg" : "Below Avg"

// === Table Content Update ===
if bar_index % 1 == 0
    // EMA Trend
    table.cell(signalTable, 0, 0, "EMA Trend:", text_color=labelColor, text_halign=text.align_left)
    table.cell(signalTable, 1, 0, emaTrend, text_color=color.lime, text_halign=text.align_left)

    // Stoch RSI
    table.cell(signalTable, 0, 1, "Stoch RSI:", text_color=labelColor, text_halign=text.align_left)
    table.cell(signalTable, 1, 1, stochStatus, text_color=color.aqua, text_halign=text.align_left)

    // RSI
    table.cell(signalTable, 0, 2, "RSI:", text_color=labelColor, text_halign=text.align_left)
    table.cell(signalTable, 1, 2, rsiValueDisplay, text_color=color.orange, text_halign=text.align_left)

    // Volume
    table.cell(signalTable, 0, 3, "Volume:", text_color=labelColor, text_halign=text.align_left)
    table.cell(signalTable, 1, 3, volumeStatus, text_color=color.fuchsia, text_halign=text.align_left)