//@version=6
// Multi-TF 200 EMA Waterfall with Labels + Toggleable Clouds
indicator("Multi-TF 200 EMA", overlay=true)

// ===========================================================================================================
// INPUTS
// ===========================================================================================================
int emaLen = input.int(200, "EMA Length")

bool showChart = input.bool(true,  "Show CHART 200 EMA", group="Timeframes")
bool show1m    = input.bool(false, "Show 1m 200 EMA",    group="Timeframes")
bool show3m    = input.bool(false, "Show 3m 200 EMA",    group="Timeframes")
bool show5m    = input.bool(true,  "Show 5m 200 EMA",    group="Timeframes")
bool show15m   = input.bool(true,  "Show 15m 200 EMA",   group="Timeframes")
bool show1h    = input.bool(true,  "Show 1H 200 EMA",    group="Timeframes")
bool show4h    = input.bool(true,  "Show 4H 200 EMA",    group="Timeframes")
bool show1d    = input.bool(true,  "Show 1D 200 EMA",    group="Timeframes")

color cChart = input.color(#ffffff, "CHART Color", group="Colors")
color c1m    = input.color(#ffffff, "1m Color",    group="Colors")
color c3m    = input.color(#b0bec5, "3m Color",    group="Colors")
color c5m    = input.color(#ffeb3b, "5m Color",    group="Colors")
color c15m   = input.color(#ff9800, "15m Color",   group="Colors")
color c1h    = input.color(#00bcd4, "1H Color",    group="Colors")
color c4h    = input.color(#e040fb, "4H Color",    group="Colors")
color c1d    = input.color(#ff1744, "1D Color",    group="Colors")

int lwChart = input.int(2, "CHART Width", group="Line Width", minval=1, maxval=4)
int lw1m    = input.int(1, "1m Width",    group="Line Width", minval=1, maxval=4)
int lw3m    = input.int(1, "3m Width",    group="Line Width", minval=1, maxval=4)
int lw5m    = input.int(1, "5m Width",    group="Line Width", minval=1, maxval=4)
int lw15m   = input.int(2, "15m Width",   group="Line Width", minval=1, maxval=4)
int lw1h    = input.int(2, "1H Width",    group="Line Width", minval=1, maxval=4)
int lw4h    = input.int(3, "4H Width",    group="Line Width", minval=1, maxval=4)
int lw1d    = input.int(3, "1D Width",    group="Line Width", minval=1, maxval=4)

string labelSize = input.string("small", "Label Size", options=["tiny", "small", "normal", "large", "huge"], group="Labels")
int labelOffset  = input.int(5, "Label Offset (bars)", group="Labels", minval=1, maxval=50)

// --- Cloud Toggles ---
bool cloudChart1m  = input.bool(false, "CHART-1m Cloud",  group="Clouds")
bool cloud1m3m     = input.bool(false, "1m-3m Cloud",     group="Clouds")
bool cloud3m5m     = input.bool(false, "3m-5m Cloud",     group="Clouds")
bool cloud5m15m    = input.bool(true,  "5m-15m Cloud",    group="Clouds")
bool cloud15m1h    = input.bool(true,  "15m-1H Cloud",    group="Clouds")
bool cloud1h4h     = input.bool(true,  "1H-4H Cloud",     group="Clouds")
bool cloud4h1d     = input.bool(true,  "4H-1D Cloud",     group="Clouds")

// ===========================================================================================================
// 200 EMAs
// ===========================================================================================================
float emaChart = ta.ema(close, emaLen)
float ema1m    = request.security(syminfo.tickerid, "1",   ta.ema(close, emaLen))
float ema3m    = request.security(syminfo.tickerid, "3",   ta.ema(close, emaLen))
float ema5m    = request.security(syminfo.tickerid, "5",   ta.ema(close, emaLen))
float ema15m   = request.security(syminfo.tickerid, "15",  ta.ema(close, emaLen))
float ema1h    = request.security(syminfo.tickerid, "60",  ta.ema(close, emaLen))
float ema4h    = request.security(syminfo.tickerid, "240", ta.ema(close, emaLen))
float ema1d    = request.security(syminfo.tickerid, "D",   ta.ema(close, emaLen))

// ===========================================================================================================
// PLOTS
// ===========================================================================================================
pChart = plot(showChart ? emaChart : na, "CHART 200", color=cChart, linewidth=lwChart, editable=false)
p1m    = plot(show1m    ? ema1m    : na, "1m 200",    color=c1m,    linewidth=lw1m,    editable=false)
p3m    = plot(show3m    ? ema3m    : na, "3m 200",    color=c3m,    linewidth=lw3m,    editable=false)
p5m    = plot(show5m    ? ema5m    : na, "5m 200",    color=c5m,    linewidth=lw5m,    editable=false)
p15m   = plot(show15m   ? ema15m   : na, "15m 200",   color=c15m,   linewidth=lw15m,   editable=false)
p1h    = plot(show1h    ? ema1h    : na, "1H 200",    color=c1h,    linewidth=lw1h,    editable=false)
p4h    = plot(show4h    ? ema4h    : na, "4H 200",    color=c4h,    linewidth=lw4h,    editable=false)
p1d    = plot(show1d    ? ema1d    : na, "1D 200",    color=c1d,    linewidth=lw1d,    editable=false)

// ===========================================================================================================
// CLOUDS
// ===========================================================================================================
fill(pChart, p1m,  color=cloudChart1m ? (emaChart > ema1m  ? color.new(#00e676, 90) : color.new(#ff1744, 90)) : na, title="CHART-1m")
fill(p1m,    p3m,  color=cloud1m3m    ? (ema1m    > ema3m  ? color.new(#00e676, 90) : color.new(#ff1744, 90)) : na, title="1m-3m")
fill(p3m,    p5m,  color=cloud3m5m    ? (ema3m    > ema5m  ? color.new(#00e676, 90) : color.new(#ff1744, 90)) : na, title="3m-5m")
fill(p5m,    p15m, color=cloud5m15m   ? (ema5m    > ema15m ? color.new(#00e676, 90) : color.new(#ff1744, 90)) : na, title="5m-15m")
fill(p15m,   p1h,  color=cloud15m1h   ? (ema15m   > ema1h  ? color.new(#00e676, 90) : color.new(#ff1744, 90)) : na, title="15m-1H")
fill(p1h,    p4h,  color=cloud1h4h    ? (ema1h    > ema4h  ? color.new(#00e676, 90) : color.new(#ff1744, 90)) : na, title="1H-4H")
fill(p4h,    p1d,  color=cloud4h1d    ? (ema4h    > ema1d  ? color.new(#00e676, 90) : color.new(#ff1744, 90)) : na, title="4H-1D")

// ===========================================================================================================
// LABELS — last bar only
// ===========================================================================================================
string sz = switch labelSize
    "tiny"   => size.tiny
    "small"  => size.small
    "normal" => size.normal
    "large"  => size.large
    "huge"   => size.huge
    => size.small

if showChart and barstate.islast
    label.new(bar_index + labelOffset, emaChart, "CHART", color=color.new(cChart, 100), textcolor=cChart, style=label.style_label_left, size=sz)

if show1m and barstate.islast
    label.new(bar_index + labelOffset, ema1m, "1m", color=color.new(c1m, 100), textcolor=c1m, style=label.style_label_left, size=sz)

if show3m and barstate.islast
    label.new(bar_index + labelOffset, ema3m, "3m", color=color.new(c3m, 100), textcolor=c3m, style=label.style_label_left, size=sz)

if show5m and barstate.islast
    label.new(bar_index + labelOffset, ema5m, "5m", color=color.new(c5m, 100), textcolor=c5m, style=label.style_label_left, size=sz)

if show15m and barstate.islast
    label.new(bar_index + labelOffset, ema15m, "15m", color=color.new(c15m, 100), textcolor=c15m, style=label.style_label_left, size=sz)

if show1h and barstate.islast
    label.new(bar_index + labelOffset, ema1h, "1H", color=color.new(c1h, 100), textcolor=c1h, style=label.style_label_left, size=sz)

if show4h and barstate.islast
    label.new(bar_index + labelOffset, ema4h, "4H", color=color.new(c4h, 100), textcolor=c4h, style=label.style_label_left, size=sz)

if show1d and barstate.islast
    label.new(bar_index + labelOffset, ema1d, "1D", color=color.new(c1d, 100), textcolor=c1d, style=label.style_label_left, size=sz)