// USAGE EXAMPLE
// ══════════════════════════════════════════════════════════════════════════════
//
//   //@version=6
//   indicator("Statistical Analysis")
//   import HenriqueCentieiro/PineStats/1 as stats
//
//   // Core statistics
//   z = stats.zscore(close, 20)
//   skew = stats.skewness(close, 50)
//
//   // Test for normality
//   returns = ta.change(close) / close[1]
//   is_gaussian = stats.is_normal(returns, 100, 0.05)
//
//   // Regression channel
//   [center, upper, lower] = stats.linreg_channel(close, 50, 2.0)
//   plot(center, "Regression", color.blue)
//   plot(upper, "Upper", color.red)
//   plot(lower, "Lower", color.green)
//
//   // Correlation with benchmark
//   benchmark_returns = request.security("SPY", timeframe.period, close) / close[1] - 1
//   beta_val = stats.beta(returns, benchmark_returns, 60)
//
// ══════════════════════════════════════════════════════════════════════════════
// ERROR HANDLING
// ══════════════════════════════════════════════════════════════════════════════
//
// All functions return `na` on invalid inputs including:
//   - na values in required parameters
//   - Insufficient data (length < minimum required)
//   - Division by zero conditions
//   - Out of range parameters (e.g., probability not in [0,1])
//
// ══════════════════════════════════════════════════════════════════════════════


// ═══════════════════════════════════════════════════════════════════════════════
// CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════════

var float PI = 3.14159265358979323846
var float SQRT_2 = 1.41421356237309504880
var float SQRT_2PI = 2.50662827463100050242
var float INV_SQRT_2PI = 0.39894228040143267794
var float LN_2 = 0.693147180559945309417
var float DEG_PER_RAD = 57.29577951308232


// ═══════════════════════════════════════════════════════════════════════════════
// MODULE 1: CORE STATISTICS
// ═══════════════════════════════════════════════════════════════════════════════

// ─────────────────────────────────────────────────────────────────────────────
// CENTRAL TENDENCY
// ─────────────────────────────────────────────────────────────────────────────

//@function Calculates the arithmetic mean (simple moving average) over a lookback period
//@param src Source series
//@param length Lookback period (must be >= 1)
//@returns Arithmetic mean of the last `length` values, or `na` if inputs invalid
export mean(series float src, simple int length) =>
    if na(src) or length < 1
        na
    else
        ta.sma(src, length)


//@function Calculates weighted moving average with linearly decreasing weights
//@param src Source series
//@param length Lookback period (must be >= 1)
//@returns Weighted moving average, or `na` if inputs invalid
export wma_custom(series float src, simple int length) =>
    if na(src) or length < 1
        na
    else
        ta.wma(src, length)


//@function Calculates exponential moving average
//@param src Source series
//@param length Lookback period (must be >= 1)
//@returns Exponential moving average, or `na` if inputs invalid
export ema_custom(series float src, simple int length) =>
    if na(src) or length < 1
        na
    else
        ta.ema(src, length)


//@function Calculates the median value over a lookback period
//@param src Source series
//@param length Lookback period (must be >= 1)
//@returns Median value, or `na` if inputs invalid
export median(series float src, simple int length) =>
    if na(src) or length < 1
        na
    else
        ta.median(src, length)


// ─────────────────────────────────────────────────────────────────────────────
// DISPERSION / VARIABILITY
// ─────────────────────────────────────────────────────────────────────────────

//@function Calculates population variance over a lookback period
//@param src Source series
//@param length Lookback period (must be >= 1)
//@returns Population variance, or `na` if inputs invalid
export variance(series float src, simple int length) =>
    if na(src) or length < 1
        na
    else
        ta.variance(src, length)


//@function Calculates population standard deviation over a lookback period
//@param src Source series
//@param length Lookback period (must be >= 1)
//@returns Population standard deviation, or `na` if inputs invalid
export stdev(series float src, simple int length) =>
    if na(src) or length < 1
        na
    else
        ta.stdev(src, length)


//@function Calculates Median Absolute Deviation (MAD) - robust dispersion measure
//@param src Source series
//@param length Lookback period (must be >= 1)
//@returns MAD value, or `na` if inputs invalid
export mad(series float src, simple int length) =>
    if na(src) or length < 1
        na
    else
        med = ta.median(src, length)
        // Calculate absolute deviations from median
        abs_dev = math.abs(src - med)
        ta.median(abs_dev, length)


//@function Calculates the range (highest - lowest) over a lookback period
//@param src Source series
//@param length Lookback period (must be >= 1)
//@returns Range value, or `na` if inputs invalid
export data_range(series float src, simple int length) =>
    if na(src) or length < 1
        na
    else
        ta.highest(src, length) - ta.lowest(src, length)


// ─────────────────────────────────────────────────────────────────────────────
// STANDARDIZATION / NORMALIZATION
// ─────────────────────────────────────────────────────────────────────────────

//@function Calculates z-score (number of standard deviations from mean)
//@param src Source series
//@param length Lookback period for mean and stdev calculation (must be >= 2)
//@returns Z-score, or `na` if inputs invalid or stdev is zero
export zscore(series float src, simple int length) =>
    if na(src) or length < 2
        na
    else
        m = ta.sma(src, length)
        s = ta.stdev(src, length)
        if s == 0
            na
        else
            (src - m) / s


//@function Calculates robust z-score using median and MAD (resistant to outliers)
//@param src Source series
//@param length Lookback period (must be >= 2)
//@returns Robust z-score, or `na` if inputs invalid or MAD is zero
export zscore_robust(series float src, simple int length) =>
    if na(src) or length < 2
        na
    else
        med = ta.median(src, length)
        abs_dev = math.abs(src - med)
        mad_val = ta.median(abs_dev, length)
        // Scale factor 0.6745 makes MAD consistent with stdev for normal distribution
        if mad_val == 0
            na
        else
            (src - med) / (mad_val * 1.4826)


//@function Normalizes value to [0, 1] range using min-max scaling
//@param src Source series
//@param length Lookback period (must be >= 1)
//@returns Normalized value in [0, 1], or `na` if inputs invalid or range is zero
export normalize(series float src, simple int length) =>
    if na(src) or length < 1
        na
    else
        lo = ta.lowest(src, length)
        hi = ta.highest(src, length)
        rng = hi - lo
        if rng == 0
            na
        else
            (src - lo) / rng


//@function Calculates percentile rank of current value within lookback window
//@param src Source series
//@param length Lookback period (must be >= 1)
//@returns Percentile rank (0 to 100), or `na` if inputs invalid
export percentile(series float src, simple int length) =>
    if na(src) or length < 1
        na
    else
        ta.percentrank(src, length)


//@function Winsorizes values by clamping to percentile bounds (reduces outlier impact)
//@param src Source series
//@param length Lookback period (must be >= 1)
//@param lower_pct Lower percentile bound (0-100, e.g., 5 for 5th percentile)
//@param upper_pct Upper percentile bound (0-100, e.g., 95 for 95th percentile)
//@returns Winsorized value clamped to [lower_pct, upper_pct] bounds
export winsorize(series float src, simple int length, simple float lower_pct, simple float upper_pct) =>
    if na(src) or length < 1 or lower_pct < 0 or upper_pct > 100 or lower_pct >= upper_pct
        na
    else
        // Use linear interpolation to estimate percentile bounds
        sorted_lo = ta.lowest(src, length)
        sorted_hi = ta.highest(src, length)
        rng = sorted_hi - sorted_lo

        lower_bound = sorted_lo + (rng * lower_pct / 100)
        upper_bound = sorted_lo + (rng * upper_pct / 100)

        math.max(lower_bound, math.min(upper_bound, src))


// ─────────────────────────────────────────────────────────────────────────────
// SHAPE / DISTRIBUTION
// ─────────────────────────────────────────────────────────────────────────────

//@function Calculates sample skewness (measure of distribution asymmetry)
//@param src Source series
//@param length Lookback period (must be >= 3)
//@returns Skewness value (negative = left tail, positive = right tail), or `na` if invalid
export skewness(series float src, simple int length) =>
    if na(src) or length < 3
        na
    else
        m = ta.sma(src, length)
        s = ta.stdev(src, length)
        if s == 0
            na
        else
            // Sum of cubed deviations
            sum_cubed = 0.0
            for i = 0 to length - 1
                dev = (src[i] - m) / s
                sum_cubed += dev * dev * dev
            // Bias-corrected sample skewness
            n = float(length)
            correction = math.sqrt(n * (n - 1)) / (n - 2)
            correction * sum_cubed / n


//@function Calculates excess kurtosis (measure of distribution tail heaviness)
//@param src Source series
//@param length Lookback period (must be >= 4)
//@returns Excess kurtosis (>0 = heavy tails, <0 = light tails), or `na` if invalid
export kurtosis(series float src, simple int length) =>
    if na(src) or length < 4
        na
    else
        m = ta.sma(src, length)
        s = ta.stdev(src, length)
        if s == 0
            na
        else
            // Sum of fourth power deviations
            sum_fourth = 0.0
            for i = 0 to length - 1
                dev = (src[i] - m) / s
                sum_fourth += dev * dev * dev * dev
            // Bias-corrected excess kurtosis
            n = float(length)
            raw_kurt = sum_fourth / n
            // Fisher correction for sample excess kurtosis
            correction = (n - 1) / ((n - 2) * (n - 3))
            excess = correction * ((n + 1) * raw_kurt - 3 * (n - 1))
            excess


// ─────────────────────────────────────────────────────────────────────────────
// UTILITY FUNCTIONS
// ─────────────────────────────────────────────────────────────────────────────

//@function Counts non-na values in lookback window (useful for data quality checks)
//@param src Source series
//@param length Lookback period (must be >= 1)
//@returns Count of valid (non-na) values
export count_valid(series float src, simple int length) =>
    if length < 1
        0
    else
        cnt = 0
        for i = 0 to length - 1
            if not na(src[i])
                cnt += 1
        cnt


//@function Calculates sum over lookback period
//@param src Source series
//@param length Lookback period (must be >= 1)
//@returns Sum of values, or `na` if inputs invalid
export sum(series float src, simple int length) =>
    if na(src) or length < 1
        na
    else
        math.sum(src, length)


//@function Calculates cumulative sum (running total from first bar)
//@param src Source series
//@returns Cumulative sum
export cumsum(series float src) =>
    ta.cum(src)


//@function Returns the change (difference) from n bars ago
//@param src Source series
//@param length Number of bars to look back (must be >= 1)
//@returns Current value minus value from `length` bars ago
export change(series float src, simple int length) =>
    if na(src) or length < 1
        na
    else
        ta.change(src, length)


//@function Calculates Rate of Change (percentage change from n bars ago)
//@param src Source series
//@param length Number of bars to look back (must be >= 1)
//@returns Percentage change as decimal (0.05 = 5%), or `na` if invalid
export roc(series float src, simple int length) =>
    if na(src) or length < 1
        na
    else
        prev = src[length]
        if na(prev) or prev == 0
            na
        else
            (src - prev) / prev


// ═══════════════════════════════════════════════════════════════════════════════
// MODULE 2: PROBABILITY DISTRIBUTIONS
// ═══════════════════════════════════════════════════════════════════════════════

// ─────────────────────────────────────────────────────────────────────────────
// NORMAL (GAUSSIAN) DISTRIBUTION
// ─────────────────────────────────────────────────────────────────────────────

//@function Calculates the standard normal probability density function (PDF)
//@param x The value to evaluate
//@returns PDF value at x for standard normal N(0,1)
export normal_pdf_standard(series float x) =>
    if na(x)
        na
    else
        INV_SQRT_2PI * math.exp(-0.5 * x * x)


//@function Calculates the normal probability density function (PDF)
//@param x The value to evaluate
//@param mu Mean of the distribution (default: 0)
//@param sigma Standard deviation (default: 1, must be > 0)
//@returns PDF value at x for normal N(mu, sigma²)
export normal_pdf(series float x, series float mu, series float sigma) =>
    if na(x) or na(mu) or na(sigma) or sigma <= 0
        na
    else
        z = (x - mu) / sigma
        INV_SQRT_2PI / sigma * math.exp(-0.5 * z * z)


//@function Calculates the standard normal cumulative distribution function (CDF)
//@param x The value to evaluate
//@returns Probability P(X <= x) for standard normal N(0,1)
//@description Uses Abramowitz & Stegun approximation (formula 7.1.26), accurate to ~1.5e-7
export normal_cdf_standard(series float x) =>
    if na(x)
        na
    else
        // Handle extreme values
        if x < -8.0
            0.0
        else if x > 8.0
            1.0
        else
            // Abramowitz & Stegun approximation constants
            a1 =  0.254829592
            a2 = -0.284496736
            a3 =  1.421413741
            a4 = -1.453152027
            a5 =  1.061405429
            p  =  0.3275911

            sign = x < 0 ? -1.0 : 1.0
            abs_x = math.abs(x)

            t = 1.0 / (1.0 + p * abs_x / SQRT_2)
            t2 = t * t
            t3 = t2 * t
            t4 = t3 * t
            t5 = t4 * t

            y = 1.0 - (a1*t + a2*t2 + a3*t3 + a4*t4 + a5*t5) * math.exp(-0.5 * x * x)

            0.5 * (1.0 + sign * (2.0 * y - 1.0))


//@function Calculates the normal cumulative distribution function (CDF)
//@param x The value to evaluate
//@param mu Mean of the distribution (default: 0)
//@param sigma Standard deviation (default: 1, must be > 0)
//@returns Probability P(X <= x) for normal N(mu, sigma²)
export normal_cdf(series float x, series float mu, series float sigma) =>
    if na(x) or na(mu) or na(sigma) or sigma <= 0
        na
    else
        z = (x - mu) / sigma
        normal_cdf_standard(z)


//@function Calculates the inverse standard normal CDF (quantile function)
//@param p Probability value (must be in (0, 1))
//@returns x such that P(X <= x) = p for standard normal N(0,1)
//@description Uses Acklam's algorithm, accurate to ~1.15e-9
export normal_inv_standard(series float p) =>
    if na(p) or p <= 0 or p >= 1
        na
    else
        // Acklam's algorithm coefficients
        // Coefficients for rational approximation
        a1 = -3.969683028665376e+01
        a2 =  2.209460984245205e+02
        a3 = -2.759285104469687e+02
        a4 =  1.383577518672690e+02
        a5 = -3.066479806614716e+01
        a6 =  2.506628277459239e+00

        b1 = -5.447609879822406e+01
        b2 =  1.615858368580409e+02
        b3 = -1.556989798598866e+02
        b4 =  6.680131188771972e+01
        b5 = -1.328068155288572e+01

        c1 = -7.784894002430293e-03
        c2 = -3.223964580411365e-01
        c3 = -2.400758277161838e+00
        c4 = -2.549732539343734e+00
        c5 =  4.374664141464968e+00
        c6 =  2.938163982698783e+00

        d1 =  7.784695709041462e-03
        d2 =  3.224671290700398e-01
        d3 =  2.445134137142996e+00
        d4 =  3.754408661907416e+00

        // Breakpoints
        p_low  = 0.02425
        p_high = 1.0 - p_low

        result = 0.0

        if p < p_low
            // Lower region - rational approximation
            q = math.sqrt(-2.0 * math.log(p))
            num = ((((c1*q + c2)*q + c3)*q + c4)*q + c5)*q + c6
            den = (((d1*q + d2)*q + d3)*q + d4)*q + 1.0
            result := num / den
        else if p <= p_high
            // Central region - rational approximation
            q = p - 0.5
            r = q * q
            num = (((((a1*r + a2)*r + a3)*r + a4)*r + a5)*r + a6) * q
            den = ((((b1*r + b2)*r + b3)*r + b4)*r + b5)*r + 1.0
            result := num / den
        else
            // Upper region - rational approximation
            q = math.sqrt(-2.0 * math.log(1.0 - p))
            num = ((((c1*q + c2)*q + c3)*q + c4)*q + c5)*q + c6
            den = (((d1*q + d2)*q + d3)*q + d4)*q + 1.0
            result := -num / den

        result


//@function Calculates the inverse normal CDF (quantile function)
//@param p Probability value (must be in (0, 1))
//@param mu Mean of the distribution
//@param sigma Standard deviation (must be > 0)
//@returns x such that P(X <= x) = p for normal N(mu, sigma²)
export normal_inv(series float p, series float mu, series float sigma) =>
    if na(p) or na(mu) or na(sigma) or sigma <= 0 or p <= 0 or p >= 1
        na
    else
        mu + sigma * normal_inv_standard(p)


// ─────────────────────────────────────────────────────────────────────────────
// POWER-LAW DISTRIBUTION
// ─────────────────────────────────────────────────────────────────────────────

//@function Estimates power-law exponent (alpha) using Hill estimator
//@param src Source series (typically absolute returns or drawdowns)
//@param length Lookback period (must be >= 10 for reliable estimates)
//@param tail_pct Percentage of data to use for tail estimation (default: 0.1 = top 10%)
//@returns Estimated alpha (tail index), typically 2-4 for financial data
//@description Alpha < 2 indicates infinite variance (very heavy tails)
//@description Alpha < 3 indicates infinite kurtosis
//@description Alpha > 4 suggests near-Gaussian behavior
export power_law_alpha(series float src, simple int length, simple float tail_pct) =>
    if na(src) or length < 10 or tail_pct <= 0 or tail_pct > 0.5
        na
    else
        // Collect absolute values
        float[] values = array.new_float(0)
        for i = 0 to length - 1
            if not na(src[i])
                array.push(values, math.abs(src[i]))

        n_valid = array.size(values)
        if n_valid < 10
            na
        else
            // Sort in descending order for tail analysis
            array.sort(values, order.descending)

            // Number of tail observations
            n_tail = math.max(2, math.floor(n_valid * tail_pct))

            // Minimum value in tail (threshold)
            x_min = array.get(values, n_tail - 1)

            if x_min <= 0
                na
            else
                // Hill estimator: alpha = 1 / mean(log(x/x_min))
                sum_log = 0.0
                for i = 0 to n_tail - 1
                    xi = array.get(values, i)
                    sum_log += math.log(xi / x_min)

                if sum_log <= 0
                    na
                else
                    1.0 + n_tail / sum_log


//@function Estimates power-law alpha using maximum likelihood (Clauset method)
//@param src Source series (positive values expected)
//@param length Lookback period (must be >= 20)
//@param x_min Minimum threshold for power-law behavior
//@returns Estimated alpha using MLE
export power_law_alpha_mle(series float src, simple int length, series float x_min) =>
    if na(src) or length < 20 or na(x_min) or x_min <= 0
        na
    else
        sum_log = 0.0
        n = 0

        for i = 0 to length - 1
            val = math.abs(src[i])
            if not na(val) and val >= x_min
                sum_log += math.log(val / x_min)
                n += 1

        if n < 5 or sum_log <= 0
            na
        else
            // MLE estimator: alpha = 1 + n / sum(log(x/x_min))
            1.0 + n / sum_log


//@function Calculates power-law probability density (Pareto Type I)
//@param x Value to evaluate (must be >= x_min)
//@param alpha Power-law exponent (must be > 1)
//@param x_min Minimum value / scale parameter (must be > 0)
//@returns PDF value
export power_law_pdf(series float x, series float alpha, series float x_min) =>
    if na(x) or na(alpha) or na(x_min) or alpha <= 1 or x_min <= 0 or x < x_min
        na
    else
        (alpha - 1) / x_min * math.pow(x / x_min, -alpha)


//@function Calculates power-law survival function P(X > x)
//@param x Value to evaluate (must be >= x_min)
//@param alpha Power-law exponent (must be > 1)
//@param x_min Minimum value / scale parameter (must be > 0)
//@returns Probability of exceeding x
export power_law_survival(series float x, series float alpha, series float x_min) =>
    if na(x) or na(alpha) or na(x_min) or alpha <= 1 or x_min <= 0 or x < x_min
        na
    else
        math.pow(x / x_min, -(alpha - 1))


//@function Tests if data follows power-law using simplified Kolmogorov-Smirnov
//@param src Source series
//@param length Lookback period
//@param alpha Estimated alpha from power_law_alpha()
//@param x_min Threshold value
//@returns KS statistic (lower = better fit, typically < 0.1 for good fit)
export power_law_ks(series float src, simple int length, series float alpha, series float x_min) =>
    if na(src) or length < 20 or na(alpha) or na(x_min) or alpha <= 1 or x_min <= 0
        na
    else
        // Collect tail values
        float[] tail_values = array.new_float(0)
        for i = 0 to length - 1
            val = math.abs(src[i])
            if not na(val) and val >= x_min
                array.push(tail_values, val)

        n = array.size(tail_values)
        if n < 10
            na
        else
            array.sort(tail_values, order.ascending)

            max_diff = 0.0
            for i = 0 to n - 1
                xi = array.get(tail_values, i)
                // Empirical CDF
                emp_cdf = (i + 1.0) / n
                // Theoretical CDF: 1 - (x/x_min)^(-(alpha-1))
                theo_cdf = 1.0 - math.pow(xi / x_min, -(alpha - 1))

                diff = math.abs(emp_cdf - theo_cdf)
                max_diff := math.max(max_diff, diff)

            max_diff


//@function Simple test if distribution appears to follow power-law
//@param src Source series
//@param length Lookback period
//@param tail_pct Tail percentage for alpha estimation
//@param ks_threshold Maximum KS statistic for acceptance (default: 0.1)
//@returns true if KS test suggests power-law fit
export is_power_law(series float src, simple int length, simple float tail_pct, simple float ks_threshold) =>
    if na(src) or length < 20
        false
    else
        // Estimate alpha
        alpha = power_law_alpha(src, length, tail_pct)
        if na(alpha) or alpha <= 1
            false
        else
            // Get x_min from tail
            float[] values = array.new_float(0)
            for i = 0 to length - 1
                if not na(src[i])
                    array.push(values, math.abs(src[i]))

            n_valid = array.size(values)
            n_tail = math.max(2, math.floor(n_valid * tail_pct))
            array.sort(values, order.descending)
            x_min = array.get(values, n_tail - 1)

            if x_min <= 0
                false
            else
                ks = power_law_ks(src, length, alpha, x_min)
                not na(ks) and ks < ks_threshold


// ─────────────────────────────────────────────────────────────────────────────
// EXPONENTIAL DISTRIBUTION
// ─────────────────────────────────────────────────────────────────────────────

//@function Calculates exponential probability density function
//@param x Value to evaluate (must be >= 0)
//@param lambda Rate parameter (must be > 0)
//@returns PDF value
export exp_pdf(series float x, series float lambda) =>
    if na(x) or na(lambda) or x < 0 or lambda <= 0
        na
    else
        lambda * math.exp(-lambda * x)


//@function Calculates exponential cumulative distribution function
//@param x Value to evaluate (must be >= 0)
//@param lambda Rate parameter (must be > 0)
//@returns Probability P(X <= x)
export exp_cdf(series float x, series float lambda) =>
    if na(x) or na(lambda) or x < 0 or lambda <= 0
        na
    else
        1.0 - math.exp(-lambda * x)


//@function Estimates exponential rate parameter (lambda) using MLE
//@param src Source series (positive values)
//@param length Lookback period
//@returns Estimated lambda (1/mean)
export exp_lambda(series float src, simple int length) =>
    if na(src) or length < 5
        na
    else
        sum_val = 0.0
        n = 0
        for i = 0 to length - 1
            if not na(src[i]) and src[i] > 0
                sum_val += src[i]
                n += 1

        if n < 5 or sum_val <= 0
            na
        else
            n / sum_val


// ─────────────────────────────────────────────────────────────────────────────
// NORMALITY TESTING
// ─────────────────────────────────────────────────────────────────────────────

//@function Calculates Jarque-Bera test statistic for normality
//@param src Source series
//@param length Lookback period (must be >= 10)
//@returns JB statistic (higher = more deviation from normality)
//@description Under normality, JB ~ chi-squared(2). JB > 6 suggests non-normality at 5% level
export jarque_bera(series float src, simple int length) =>
    if na(src) or length < 10
        na
    else
        m = ta.sma(src, length)
        s = ta.stdev(src, length)

        if s == 0
            na
        else
            // Calculate skewness and kurtosis
            sum_cubed = 0.0
            sum_fourth = 0.0

            for i = 0 to length - 1
                dev = (src[i] - m) / s
                dev2 = dev * dev
                sum_cubed += dev2 * dev
                sum_fourth += dev2 * dev2

            n = float(length)
            skew = sum_cubed / n
            kurt_excess = sum_fourth / n - 3.0

            // JB = n/6 * (S² + K²/4)
            n / 6.0 * (skew * skew + kurt_excess * kurt_excess / 4.0)


//@function Tests if distribution is approximately normal
//@param src Source series
//@param length Lookback period
//@param significance Significance level (default: 0.05)
//@returns true if Jarque-Bera test does not reject normality
export is_normal(series float src, simple int length, simple float significance) =>
    if na(src) or length < 10
        false
    else
        jb = jarque_bera(src, length)
        if na(jb)
            false
        else
            // Critical values for chi-squared(2)
            // 0.01 -> 9.21, 0.05 -> 5.99, 0.10 -> 4.61
            critical = significance <= 0.01 ? 9.21 :
                       significance <= 0.05 ? 5.99 :
                       significance <= 0.10 ? 4.61 : 5.99

            jb < critical


// ═══════════════════════════════════════════════════════════════════════════════
// MODULE 3: ENTROPY
// ═══════════════════════════════════════════════════════════════════════════════

// ─────────────────────────────────────────────────────────────────────────────
// PROBABILITY DISTRIBUTION HELPERS
// ─────────────────────────────────────────────────────────────────────────────

// Internal: Creates histogram bins and returns probability distribution
_histogram_probs(series float src, simple int length, simple int n_bins) =>
    float[] probs = array.new_float(n_bins, 0.0)

    // Find min/max
    min_val = ta.lowest(src, length)
    max_val = ta.highest(src, length)
    range_val = max_val - min_val

    if range_val == 0
        // All values identical - return uniform
        for i = 0 to n_bins - 1
            array.set(probs, i, 1.0 / n_bins)
    else
        // Count values in each bin
        bin_width = range_val / n_bins
        total_count = 0

        for i = 0 to length - 1
            if not na(src[i])
                bin_idx = math.min(n_bins - 1, math.floor((src[i] - min_val) / bin_width))
                array.set(probs, bin_idx, array.get(probs, bin_idx) + 1)
                total_count += 1

        // Convert counts to probabilities
        if total_count > 0
            for i = 0 to n_bins - 1
                array.set(probs, i, array.get(probs, i) / total_count)

    probs


// ─────────────────────────────────────────────────────────────────────────────
// SHANNON ENTROPY
// ─────────────────────────────────────────────────────────────────────────────

//@function Calculates Shannon entropy from a probability distribution
//@param src Source series
//@param length Lookback period (must be >= 10)
//@param n_bins Number of histogram bins for discretization (default: 10)
//@returns Shannon entropy in bits (log base 2)
//@description Higher entropy = more randomness/uncertainty, lower = more predictability
export shannon_entropy(series float src, simple int length, simple int n_bins) =>
    if na(src) or length < 10 or n_bins < 2
        na
    else
        probs = _histogram_probs(src, length, n_bins)

        entropy = 0.0
        for i = 0 to n_bins - 1
            p = array.get(probs, i)
            if p > 0
                entropy -= p * math.log(p) / LN_2  // Convert to bits

        entropy


//@function Calculates normalized Shannon entropy [0, 1]
//@param src Source series
//@param length Lookback period
//@param n_bins Number of histogram bins
//@returns Normalized entropy where 0 = perfectly predictable, 1 = maximum randomness
export shannon_entropy_norm(series float src, simple int length, simple int n_bins) =>
    if na(src) or length < 10 or n_bins < 2
        na
    else
        h = shannon_entropy(src, length, n_bins)
        max_entropy = math.log(n_bins) / LN_2  // Maximum possible entropy

        if na(h) or max_entropy == 0
            na
        else
            h / max_entropy


// ─────────────────────────────────────────────────────────────────────────────
// TSALLIS ENTROPY (Non-Extensive)
// ─────────────────────────────────────────────────────────────────────────────

//@function Calculates Tsallis entropy with q-parameter
//@param src Source series
//@param length Lookback period (must be >= 10)
//@param q Entropic index (q=1 recovers Shannon entropy)
//@param n_bins Number of histogram bins
//@returns Tsallis entropy value
//@description q < 1: emphasizes rare events (fat tails)
//@description q = 1: equivalent to Shannon entropy
//@description q > 1: emphasizes common events
export tsallis_entropy(series float src, simple int length, series float q, simple int n_bins) =>
    if na(src) or length < 10 or na(q) or n_bins < 2
        na
    else
        probs = _histogram_probs(src, length, n_bins)

        // Special case: q = 1 (Shannon limit)
        if math.abs(q - 1.0) < 0.0001
            entropy = 0.0
            for i = 0 to n_bins - 1
                p = array.get(probs, i)
                if p > 0
                    entropy -= p * math.log(p)
            entropy
        else
            // General Tsallis: S_q = (1 - sum(p^q)) / (q - 1)
            sum_pq = 0.0
            for i = 0 to n_bins - 1
                p = array.get(probs, i)
                if p > 0
                    sum_pq += math.pow(p, q)

            (1.0 - sum_pq) / (q - 1.0)


//@function Estimates optimal q parameter from kurtosis
//@param src Source series
//@param length Lookback period
//@returns Estimated q value that best captures the distribution's tail behavior
//@description Uses relationship: q ≈ (5 + kurtosis) / (3 + kurtosis) for kurtosis > 0
export optimal_q(series float src, simple int length) =>
    if na(src) or length < 10
        na
    else
        // Calculate excess kurtosis
        m = ta.sma(src, length)
        s = ta.stdev(src, length)

        if s == 0
            1.0  // Default to Shannon
        else
            sum_fourth = 0.0
            for i = 0 to length - 1
                if not na(src[i])
                    dev = (src[i] - m) / s
                    sum_fourth += dev * dev * dev * dev

            kurt_excess = sum_fourth / length - 3.0

            // Map kurtosis to q
            // For Gaussian (kurt=0): q=5/3 ≈ 1.67
            // For heavy tails (kurt>0): q approaches 5/3 from below as kurt increases
            // For light tails (kurt<0): q > 5/3

            if kurt_excess > -3.0
                (5.0 + kurt_excess) / (3.0 + kurt_excess)
            else
                1.0  // Fallback to Shannon


//@function Calculates Tsallis q-Gaussian probability density
//@param x Value to evaluate
//@param q Tsallis q parameter (must be < 3)
//@param beta Width parameter (inverse temperature, must be > 0)
//@returns q-Gaussian PDF value
//@description q=1 recovers standard Gaussian
export tsallis_q_gaussian(series float x, series float q, series float beta) =>
    if na(x) or na(q) or na(beta) or q >= 3 or beta <= 0
        na
    else
        // q-exponential: exp_q(x) = [1 + (1-q)x]^(1/(1-q)) if 1+(1-q)x > 0
        // q-Gaussian: p(x) = sqrt(beta) * C_q * exp_q(-beta * x^2)

        arg = 1.0 - (1.0 - q) * beta * x * x

        if arg <= 0
            0.0
        else
            // Normalization constant (approximate)
            if math.abs(q - 1.0) < 0.0001
                // Standard Gaussian
                math.sqrt(beta / PI) * math.exp(-beta * x * x)
            else
                // q-Gaussian
                math.pow(arg, 1.0 / (1.0 - q))


// ─────────────────────────────────────────────────────────────────────────────
// PERMUTATION ENTROPY
// ─────────────────────────────────────────────────────────────────────────────

//@function Calculates permutation entropy (ordinal pattern complexity)
//@param src Source series
//@param length Lookback period (must be >= 20)
//@param order Embedding dimension / pattern length (2-5, default: 3)
//@returns Normalized permutation entropy [0, 1]
//@description Measures complexity of temporal ordering patterns
//@description 0 = perfectly predictable sequence, 1 = random
export permutation_entropy(series float src, simple int length, simple int order) =>
    if na(src) or length < 20 or order < 2 or order > 5
        na
    else
        // Number of possible permutation patterns
        n_patterns = 1
        for i = 2 to order
            n_patterns *= i

        // Count pattern occurrences
        int[] pattern_counts = array.new_int(n_patterns, 0)
        total_patterns = 0

        // Slide through data
        for i = 0 to length - order
            // Extract window and get rank ordering
            float[] window = array.new_float(order)
            valid = true

            for j = 0 to order - 1
                val = src[i + j]
                if na(val)
                    valid := false
                    break
                array.set(window, j, val)

            if valid
                // Convert ordering to pattern index
                // Simple encoding for order 2-5
                pattern_idx = 0

                if order == 2
                    pattern_idx := array.get(window, 0) <= array.get(window, 1) ? 0 : 1

                else if order == 3
                    a = array.get(window, 0)
                    b = array.get(window, 1)
                    c = array.get(window, 2)
                    // 6 permutations for order 3
                    if a <= b
                        if b <= c
                            pattern_idx := 0
                        else if a <= c
                            pattern_idx := 1
                        else
                            pattern_idx := 2
                    else
                        if a <= c
                            pattern_idx := 3
                        else if b <= c
                            pattern_idx := 4
                        else
                            pattern_idx := 5

                else
                    // For order 4-5, use simplified ranking
                    int[] ranks = array.new_int(order)
                    for j = 0 to order - 1
                        rank = 0
                        for k = 0 to order - 1
                            if array.get(window, k) < array.get(window, j)
                                rank += 1
                        array.set(ranks, j, rank)

                    // Convert ranks to unique index (factorial number system)
                    pattern_idx := 0
                    mult = 1
                    for j = order - 1 to 0
                        pattern_idx += array.get(ranks, j) * mult
                        mult *= (order - j)
                    pattern_idx := pattern_idx % n_patterns

                array.set(pattern_counts, pattern_idx, array.get(pattern_counts, pattern_idx) + 1)
                total_patterns += 1

        if total_patterns == 0
            na
        else
            // Calculate entropy from pattern distribution
            entropy = 0.0
            for i = 0 to n_patterns - 1
                count = array.get(pattern_counts, i)
                if count > 0
                    p = count / total_patterns
                    entropy -= p * math.log(p)

            // Normalize by maximum entropy
            max_entropy = math.log(n_patterns)
            if max_entropy > 0
                entropy / max_entropy
            else
                na


// ─────────────────────────────────────────────────────────────────────────────
// APPROXIMATE ENTROPY
// ─────────────────────────────────────────────────────────────────────────────

//@function Calculates Approximate Entropy (ApEn) - regularity measure
//@param src Source series
//@param length Lookback period (must be >= 50)
//@param m Embedding dimension (default: 2)
//@param r Tolerance as fraction of stdev (default: 0.2)
//@returns Approximate entropy value (higher = more irregular/complex)
//@description Lower ApEn indicates more self-similarity and predictability
export approx_entropy(series float src, simple int length, simple int m, simple float r) =>
    if na(src) or length < 50 or m < 1 or r <= 0
        na
    else
        // Calculate threshold
        s = ta.stdev(src, length)
        threshold = r * s

        if threshold == 0
            na
        else
            // Collect data points
            float[] data = array.new_float(length)
            for i = 0 to length - 1
                array.set(data, i, nz(src[i], 0))

            // Count similar patterns for dimension m
            n = length - m
            phi_m = 0.0
            count_m = 0

            for i = 0 to n - 1
                matches = 0
                for j = 0 to n - 1
                    // Check if patterns are similar
                    similar = true
                    for k = 0 to m - 1
                        diff = math.abs(array.get(data, i + k) - array.get(data, j + k))
                        if diff > threshold
                            similar := false
                            break

                    if similar
                        matches += 1

                if matches > 0
                    phi_m += math.log(matches / n)
                    count_m += 1

            // Count similar patterns for dimension m+1
            n1 = length - m - 1
            phi_m1 = 0.0
            count_m1 = 0

            for i = 0 to n1 - 1
                matches = 0
                for j = 0 to n1 - 1
                    similar = true
                    for k = 0 to m
                        diff = math.abs(array.get(data, i + k) - array.get(data, j + k))
                        if diff > threshold
                            similar := false
                            break

                    if similar
                        matches += 1

                if matches > 0
                    phi_m1 += math.log(matches / n1)
                    count_m1 += 1

            if count_m == 0 or count_m1 == 0
                na
            else
                (phi_m / count_m) - (phi_m1 / count_m1)


// ─────────────────────────────────────────────────────────────────────────────
// ENTROPY-BASED REGIME DETECTION
// ─────────────────────────────────────────────────────────────────────────────

//@function Detects market regime based on entropy level
//@param src Source series (typically returns)
//@param length Lookback period
//@param q Tsallis q parameter (use optimal_q() or default 1.5)
//@param n_bins Number of histogram bins
//@returns Regime indicator: -1 = trending (low entropy), 0 = transition, 1 = ranging (high entropy)
export entropy_regime(series float src, simple int length, series float q, simple int n_bins) =>
    if na(src) or length < 20 or na(q) or n_bins < 2
        na
    else
        entropy = tsallis_entropy(src, length, q, n_bins)

        if na(entropy)
            na
        else
            // Calculate entropy percentile over longer period
            entropy_ma = ta.sma(entropy, length)
            entropy_std = ta.stdev(entropy, length)

            if entropy_std == 0
                0.0
            else
                z = (entropy - entropy_ma) / entropy_std

                // Classify regime
                if z < -1.0
                    -1.0  // Low entropy = trending
                else if z > 1.0
                    1.0   // High entropy = ranging
                else
                    0.0   // Transition


//@function Calculates entropy-based risk indicator
//@param src Source series (typically returns)
//@param length Lookback period
//@returns Risk score [0, 1] where 1 = maximum divergence from Gaussian 1
export entropy_risk(series float src, simple int length) =>
    if na(src) or length < 20
        na
    else
        // Compare actual Tsallis entropy to Gaussian expectation
        q_opt = optimal_q(src, length)
        tsallis_ent = tsallis_entropy(src, length, q_opt, 20)
        shannon_ent = shannon_entropy(src, length, 20)

        if na(tsallis_ent) or na(shannon_ent) or shannon_ent == 0
            na
        else
            // Ratio indicates deviation from extensivity (Gaussian behavior)
            // For Gaussian: Tsallis(q~1.67) ≈ Shannon, ratio ≈ 1
            // For fat tails: ratio diverges from 1
            ratio = tsallis_ent / shannon_ent
            divergence = math.abs(ratio - 1.0)

            // Normalize to [0, 1]
            math.min(1.0, divergence)


// ═══════════════════════════════════════════════════════════════════════════════
// MODULE 4: PROBABILITY
// ═══════════════════════════════════════════════════════════════════════════════

// ─────────────────────────────────────────────────────────────────────────────
// BASIC PROBABILITY
// ─────────────────────────────────────────────────────────────────────────────

//@function Calculates hit rate (probability of positive outcome) over lookback
//@param src Source series (positive values count as hits)
//@param length Lookback period
//@returns Hit rate as decimal [0, 1]
export hit_rate(series float src, simple int length) =>
    if na(src) or length < 1
        na
    else
        hits = 0
        total = 0
        for i = 0 to length - 1
            if not na(src[i])
                total += 1
                if src[i] > 0
                    hits += 1

        total > 0 ? hits / total : na


//@function Calculates hit rate for custom condition over lookback
//@param condition Boolean series (true = hit)
//@param length Lookback period
//@returns Hit rate as decimal [0, 1]
export hit_rate_cond(series bool condition, simple int length) =>
    if length < 1
        na
    else
        hits = 0
        total = 0
        for i = 0 to length - 1
            cond_val = condition[i]
            if not na(nz(cond_val ? 1.0 : 0.0, na))
                total += 1
                if cond_val
                    hits += 1

        total > 0 ? hits / total : na


//@function Calculates expected value of a series
//@param src Source series
//@param length Lookback period
//@returns Expected value (mean)
export expected_value(series float src, simple int length) =>
    if na(src) or length < 1
        na
    else
        ta.sma(src, length)


//@function Calculates expected value for a trade with TP and SL levels
//@param win_prob Probability of hitting TP (0-1)
//@param take_profit Take profit in price units or %
//@param stop_loss Stop loss in price units or % (positive value)
//@returns Expected value per trade
//@description EV = (win_prob * TP) - ((1 - win_prob) * SL)
export expected_value_trade(series float win_prob, series float take_profit, series float stop_loss) =>
    if na(win_prob) or na(take_profit) or na(stop_loss)
        na
    else if win_prob < 0 or win_prob > 1 or take_profit < 0 or stop_loss < 0
        na
    else
        (win_prob * take_profit) - ((1.0 - win_prob) * stop_loss)


//@function Calculates breakeven win rate for given TP/SL ratio
//@param take_profit Take profit distance
//@param stop_loss Stop loss distance
//@returns Required win rate for breakeven (EV = 0)
export breakeven_winrate(series float take_profit, series float stop_loss) =>
    if na(take_profit) or na(stop_loss) or take_profit <= 0 or stop_loss <= 0
        na
    else
        stop_loss / (take_profit + stop_loss)


//@function Calculates the reward-to-risk ratio
//@param take_profit Take profit distance
//@param stop_loss Stop loss distance
//@returns R:R ratio
export reward_risk_ratio(series float take_profit, series float stop_loss) =>
    if na(take_profit) or na(stop_loss) or stop_loss == 0
        na
    else
        take_profit / stop_loss


// ─────────────────────────────────────────────────────────────────────────────
// FIRST PASSAGE TIME
// ─────────────────────────────────────────────────────────────────────────────

// Internal helper: Normal CDF approximation
_normal_cdf_approx(series float x) =>
    if x < -8.0
        0.0
    else if x > 8.0
        1.0
    else
        a1 = 0.254829592
        a2 = -0.284496736
        a3 = 1.421413741
        a4 = -1.453152027
        a5 = 1.061405429
        p = 0.3275911

        sign = x < 0 ? -1.0 : 1.0
        abs_x = math.abs(x)
        t = 1.0 / (1.0 + p * abs_x / 1.41421)
        y = 1.0 - (a1*t + a2*t*t + a3*t*t*t + a4*t*t*t*t + a5*t*t*t*t*t) * math.exp(-0.5 * x * x)
        0.5 * (1.0 + sign * (2.0 * y - 1.0))


//@function Estimates probability of price reaching target within N bars
//@param src Source series (typically returns)
//@param length Lookback for volatility estimation
//@param target Target move (in same units as src, e.g., % return)
//@param max_bars Maximum bars to consider
//@returns Probability of reaching target within max_bars
//@description Based on random walk with drift approximation
export fpt_probability(series float src, simple int length, series float target, simple int max_bars) =>
    if na(src) or length < 10 or na(target) or max_bars < 1
        na
    else
        // Estimate drift and volatility from historical data
        mu = ta.sma(src, length)
        sigma = ta.stdev(src, length)

        if sigma == 0
            if target == 0
                1.0
            else if (target > 0 and mu > 0) or (target < 0 and mu < 0)
                1.0
            else
                0.0
        else
            // For random walk: P(hitting target in T bars) approximation
            // Using normal CDF for cumulative return distribution
            target_abs = math.abs(target)
            drift_total = mu * max_bars
            vol_total = sigma * math.sqrt(max_bars)

            // P(max(S_t) >= target) for t in [1, T]
            // Approximation using reflection principle
            if target > 0
                z = (target - drift_total) / vol_total
                // Simple CDF approximation
                2.0 * (1.0 - _normal_cdf_approx(z))
            else
                z = (-target + drift_total) / vol_total
                2.0 * (1.0 - _normal_cdf_approx(z))


//@function Estimates mean first passage time to target level
//@param src Source series (typically returns)
//@param length Lookback for volatility estimation
//@param target Target move
//@returns Expected number of bars to reach target (can be infinite)
export fpt_mean(series float src, simple int length, series float target) =>
    if na(src) or length < 10 or na(target) or target == 0
        na
    else
        mu = ta.sma(src, length)
        sigma = ta.stdev(src, length)

        if sigma == 0
            if mu == 0
                na  // Never reaches target
            else
                math.abs(target / mu)
        else
            // Mean FPT for Brownian motion with drift
            // E[T] = |target| / |mu| for mu != 0
            // E[T] = infinity for mu = 0 (but variance is target^2 / sigma^2)

            if math.abs(mu) < 0.0001 * sigma
                // Near-zero drift: approximate using diffusion-only formula
                target * target / (sigma * sigma)
            else
                // With drift
                math.abs(target / mu)


//@function Counts historical bars to reach target from each point
//@param src Source series (typically price or returns)
//@param length Lookback period
//@param target Target move from each starting point
//@returns Array of first passage times (na if target not reached within lookback)
export fpt_historical(series float src, simple int length, series float target) =>
    if na(src) or length < 10 or na(target)
        array.new_float(0)
    else
        float[] fpt_times = array.new_float(0)

        for start = length - 1 to 0
            cumulative = 0.0
            found = false

            for t = start - 1 to 0
                cumulative += nz(src[t])
                if (target > 0 and cumulative >= target) or (target < 0 and cumulative <= target)
                    array.push(fpt_times, start - t)
                    found := true
                    break

            if not found
                array.push(fpt_times, na)

        fpt_times


// ─────────────────────────────────────────────────────────────────────────────
// STOP LOSS / TAKE PROFIT PROBABILITY
// ─────────────────────────────────────────────────────────────────────────────

//@function Estimates probability of hitting TP before SL
//@param src Source series (typically returns)
//@param length Lookback for estimation
//@param tp_distance Take profit distance (positive)
//@param sl_distance Stop loss distance (positive)
//@returns Probability of TP being hit first
export tp_probability(series float src, simple int length, series float tp_distance, series float sl_distance) =>
    if na(src) or length < 20 or na(tp_distance) or na(sl_distance)
        na
    else if tp_distance <= 0 or sl_distance <= 0
        na
    else
        // Historical simulation approach
        tp_hits = 0
        sl_hits = 0

        for start = length - 1 to 10
            cumulative = 0.0
            hit_tp = false
            hit_sl = false

            for t = start - 1 to 0
                cumulative += nz(src[t])
                if cumulative >= tp_distance and not hit_tp
                    hit_tp := true
                    break
                if cumulative <= -sl_distance and not hit_sl
                    hit_sl := true
                    break

            if hit_tp
                tp_hits += 1
            else if hit_sl
                sl_hits += 1

        total = tp_hits + sl_hits
        total > 0 ? tp_hits / total : na


//@function Calculates complete trade probability and EV analysis
//@param src Source series (typically returns)
//@param length Lookback period
//@param tp_pct Take profit percentage
//@param sl_pct Stop loss percentage
//@returns Tuple: [tp_probability, expected_value, breakeven_wr, actual_rr]
export trade_probability(series float src, simple int length, series float tp_pct, series float sl_pct) =>
    if na(src) or length < 20 or na(tp_pct) or na(sl_pct)
        [na, na, na, na]
    else if tp_pct <= 0 or sl_pct <= 0
        [na, na, na, na]
    else
        win_prob = tp_probability(src, length, tp_pct, sl_pct)
        ev = expected_value_trade(win_prob, tp_pct, sl_pct)
        be_wr = breakeven_winrate(tp_pct, sl_pct)
        rr = reward_risk_ratio(tp_pct, sl_pct)

        [win_prob, ev, be_wr, rr]


// ─────────────────────────────────────────────────────────────────────────────
// CONDITIONAL PROBABILITY
// ─────────────────────────────────────────────────────────────────────────────

///@function Calculates conditional probability P(B|A) from historical data
//@param condition_a Condition A (the given condition)
//@param condition_b Condition B (the outcome)
//@param length Lookback period
//@returns P(B|A) = P(A and B) / P(A)
export cond_prob(series bool condition_a, series bool condition_b, simple int length) =>
    if length < 10
        na
    else
        count_a = 0
        count_a_and_b = 0

        for i = 0 to length - 1
            a_val = condition_a[i] == true
            b_val = condition_b[i] == true
            if a_val
                count_a += 1
                if b_val
                    count_a_and_b += 1

        count_a > 0 ? count_a_and_b / count_a : na


//@function Updates probability using Bayes' theorem
//@param prior Prior probability P(H)
//@param likelihood P(E|H) - probability of evidence given hypothesis
//@param false_positive P(E|~H) - probability of evidence given hypothesis is false
//@returns Posterior probability P(H|E)
export bayes_update(series float prior, series float likelihood, series float false_positive) =>
    if na(prior) or na(likelihood) or na(false_positive)
        na
    else if prior < 0 or prior > 1 or likelihood < 0 or likelihood > 1 or false_positive < 0 or false_positive > 1
        na
    else
        // P(H|E) = P(E|H) * P(H) / [P(E|H) * P(H) + P(E|~H) * P(~H)]
        numerator = likelihood * prior
        denominator = numerator + false_positive * (1.0 - prior)

        denominator > 0 ? numerator / denominator : na


// ─────────────────────────────────────────────────────────────────────────────
// STREAK AND COMPOUND PROBABILITIES
// ─────────────────────────────────────────────────────────────────────────────

//@function Calculates probability of N consecutive wins given win rate
//@param win_rate Single-trade win probability
//@param streak_length Number of consecutive wins
//@returns Probability of streak
export streak_prob(series float win_rate, simple int streak_length) =>
    if na(win_rate) or win_rate < 0 or win_rate > 1 or streak_length < 1
        na
    else
        math.pow(win_rate, streak_length)


//@function Calculates probability of experiencing N consecutive losses
//@param win_rate Single-trade win probability
//@param streak_length Number of consecutive losses
//@returns Probability of losing streak
export losing_streak_prob(series float win_rate, simple int streak_length) =>
    if na(win_rate) or win_rate < 0 or win_rate > 1 or streak_length < 1
        na
    else
        math.pow(1.0 - win_rate, streak_length)


//@function Estimates probability of drawdown exceeding threshold
//@param src Source series (returns)
//@param length Lookback period
//@param dd_threshold Drawdown threshold (as positive decimal, e.g., 0.10 = 10%)
//@returns Historical probability of exceeding drawdown threshold
export drawdown_prob(series float src, simple int length, series float dd_threshold) =>
    if na(src) or length < 20 or na(dd_threshold) or dd_threshold <= 0
        na
    else
        // Count how often max drawdown exceeded threshold
        exceed_count = 0
        total_windows = 0

        // Calculate running drawdowns
        for start = length - 1 to 20
            peak = 0.0
            cumulative = 0.0
            max_dd = 0.0

            for t = start to 0
                cumulative += nz(src[t])
                peak := math.max(peak, cumulative)
                dd = peak - cumulative
                max_dd := math.max(max_dd, dd)

            total_windows += 1
            if max_dd >= dd_threshold
                exceed_count += 1

        total_windows > 0 ? exceed_count / total_windows : na


// ─────────────────────────────────────────────────────────────────────────────
// PROBABILITY UTILITIES
// ─────────────────────────────────────────────────────────────────────────────

//@function Calculates odds from probability
//@param prob Probability (0-1)
//@returns Odds (prob / (1 - prob))
export prob_to_odds(series float prob) =>
    if na(prob) or prob < 0 or prob >= 1
        na
    else
        prob / (1.0 - prob)


//@function Calculates probability from odds
//@param odds Odds ratio
//@returns Probability (0-1)
export odds_to_prob(series float odds) =>
    if na(odds) or odds < 0
        na
    else
        odds / (1.0 + odds)


//@function Calculates implied probability from decimal odds (betting)
//@param decimal_odds Decimal odds (e.g., 2.5 means $2.50 return per $1 bet)
//@returns Implied probability
export implied_prob(series float decimal_odds) =>
    if na(decimal_odds) or decimal_odds <= 1
        na
    else
        1.0 / decimal_odds


//@function Calculates log-odds (logit) from probability
//@param prob Probability (must be in (0, 1))
//@returns Log-odds
export logit(series float prob) =>
    if na(prob) or prob <= 0 or prob >= 1
        na
    else
        math.log(prob / (1.0 - prob))


//@function Calculates probability from log-odds (inverse logit / sigmoid)
//@param log_odds Log-odds value
//@returns Probability (0-1)
export inv_logit(series float log_odds) =>
    if na(log_odds)
        na
    else
        1.0 / (1.0 + math.exp(-log_odds))


// ═══════════════════════════════════════════════════════════════════════════════
// MODULE 5: REGRESSION
// ═══════════════════════════════════════════════════════════════════════════════

// ─────────────────────────────────────────────────────────────────────────────
// LINEAR REGRESSION CORE
// ─────────────────────────────────────────────────────────────────────────────

//@function Calculates linear regression slope
//@param src Source series
//@param length Lookback period (must be >= 2)
//@returns Slope coefficient (change per bar)
export linreg_slope(series float src, simple int length) =>
    if na(src) or length < 2
        na
    else
        // Using least squares formula
        // slope = (n * sum(xy) - sum(x) * sum(y)) / (n * sum(x²) - sum(x)²)

        sum_x = 0.0
        sum_y = 0.0
        sum_xy = 0.0
        sum_xx = 0.0
        n = 0

        for i = 0 to length - 1
            if not na(src[i])
                x = float(length - 1 - i)  // Time index (0 = oldest)
                y = src[i]
                sum_x += x
                sum_y += y
                sum_xy += x * y
                sum_xx += x * x
                n += 1

        if n < 2
            na
        else
            denominator = n * sum_xx - sum_x * sum_x
            if denominator == 0
                na
            else
                (n * sum_xy - sum_x * sum_y) / denominator


//@function Calculates linear regression intercept
//@param src Source series
//@param length Lookback period (must be >= 2)
//@returns Intercept (predicted value at oldest bar in window)
export linreg_intercept(series float src, simple int length) =>
    if na(src) or length < 2
        na
    else
        slope = linreg_slope(src, length)
        if na(slope)
            na
        else
            mean_y = ta.sma(src, length)
            mean_x = (length - 1.0) / 2.0
            mean_y - slope * mean_x


//@function Calculates predicted value at current bar using linear regression
//@param src Source series
//@param length Lookback period
//@returns Predicted value at current bar (end of regression line)
export linreg_value(series float src, simple int length) =>
    if na(src) or length < 2
        na
    else
        ta.linreg(src, length, 0)


//@function Forecasts value N bars ahead using linear regression
//@param src Source series
//@param length Lookback period for regression
//@param offset Bars ahead to forecast (positive = future)
//@returns Forecasted value
export linreg_forecast(series float src, simple int length, simple int offset) =>
    if na(src) or length < 2
        na
    else
        ta.linreg(src, length, -offset)


// Internal: Standard error calculation
_std_error_internal(series float src, simple int length) =>
    if na(src) or length < 3
        na
    else
        slope = linreg_slope(src, length)
        intercept = linreg_intercept(src, length)

        if na(slope) or na(intercept)
            na
        else
            ss_res = 0.0
            n = 0

            for i = 0 to length - 1
                if not na(src[i])
                    x = float(length - 1 - i)
                    y_actual = src[i]
                    y_pred = intercept + slope * x
                    ss_res += (y_actual - y_pred) * (y_actual - y_pred)
                    n += 1

            if n < 3
                na
            else
                math.sqrt(ss_res / (n - 2))


//@function Calculates linear regression channel with bands
//@param src Source series
//@param length Lookback period
//@param mult Standard deviation multiplier for bands
//@returns Tuple: [center, upper, lower]
export linreg_channel(series float src, simple int length, simple float mult) =>
    if na(src) or length < 2 or na(mult)
        [na, na, na]
    else
        center = ta.linreg(src, length, 0)
        std_err = _std_error_internal(src, length)

        if na(center) or na(std_err)
            [na, na, na]
        else
            upper = center + mult * std_err
            lower = center - mult * std_err
            [center, upper, lower]


// ─────────────────────────────────────────────────────────────────────────────
// GOODNESS OF FIT
// ─────────────────────────────────────────────────────────────────────────────

//@function Calculates R-squared (coefficient of determination)
//@param src Source series
//@param length Lookback period
//@returns R² value [0, 1] where 1 = perfect linear fit
export r_squared(series float src, simple int length) =>
    if na(src) or length < 3
        na
    else
        // R² = 1 - (SS_res / SS_tot)
        slope = linreg_slope(src, length)
        intercept = linreg_intercept(src, length)
        mean_y = ta.sma(src, length)

        if na(slope) or na(intercept) or na(mean_y)
            na
        else
            ss_res = 0.0
            ss_tot = 0.0

            for i = 0 to length - 1
                if not na(src[i])
                    x = float(length - 1 - i)
                    y_actual = src[i]
                    y_pred = intercept + slope * x

                    ss_res += (y_actual - y_pred) * (y_actual - y_pred)
                    ss_tot += (y_actual - mean_y) * (y_actual - mean_y)

            if ss_tot == 0
                na
            else
                1.0 - (ss_res / ss_tot)


//@function Calculates adjusted R-squared (accounts for sample size)
//@param src Source series
//@param length Lookback period
//@returns Adjusted R² value
export adj_r_squared(series float src, simple int length) =>
    if na(src) or length < 4
        na
    else
        r2 = r_squared(src, length)
        if na(r2)
            na
        else
            n = float(length)
            k = 1.0  // Number of predictors (just x for simple regression)
            1.0 - ((1.0 - r2) * (n - 1.0) / (n - k - 1.0))


//@function Calculates standard error of estimate (residual standard deviation)
//@param src Source series
//@param length Lookback period
//@returns Standard error
export std_error(series float src, simple int length) =>
    _std_error_internal(src, length)


//@function Calculates residual at current bar
//@param src Source series
//@param length Lookback period
//@returns Residual (actual - predicted)
export residual(series float src, simple int length) =>
    if na(src) or length < 2
        na
    else
        predicted = ta.linreg(src, length, 0)
        if na(predicted)
            na
        else
            src - predicted


//@function Returns array of all residuals in lookback window
//@param src Source series
//@param length Lookback period
//@returns Array of residuals
export residuals(series float src, simple int length) =>
    if na(src) or length < 2
        array.new_float(0)
    else
        slope = linreg_slope(src, length)
        intercept = linreg_intercept(src, length)

        float[] res = array.new_float(length)

        if na(slope) or na(intercept)
            res
        else
            for i = 0 to length - 1
                if not na(src[i])
                    x = float(length - 1 - i)
                    y_pred = intercept + slope * x
                    array.set(res, i, src[i] - y_pred)
                else
                    array.set(res, i, na)
            res


// ─────────────────────────────────────────────────────────────────────────────
// STATISTICAL TESTS
// ─────────────────────────────────────────────────────────────────────────────

//@function Calculates t-statistic for slope coefficient
//@param src Source series
//@param length Lookback period
//@returns T-statistic (slope / standard error of slope)
export t_statistic(series float src, simple int length) =>
    if na(src) or length < 4
        na
    else
        slope = linreg_slope(src, length)
        se = _std_error_internal(src, length)

        if na(slope) or na(se) or se == 0
            na
        else
            // Standard error of slope = SE / sqrt(sum((x - mean_x)²))
            mean_x = (length - 1.0) / 2.0
            sum_xx_dev = 0.0

            for i = 0 to length - 1
                x = float(length - 1 - i)
                sum_xx_dev += (x - mean_x) * (x - mean_x)

            if sum_xx_dev == 0
                na
            else
                se_slope = se / math.sqrt(sum_xx_dev)
                slope / se_slope


//@function Approximates p-value for slope t-test (two-tailed)
//@param src Source series
//@param length Lookback period
//@returns Approximate p-value
export slope_pvalue(series float src, simple int length) =>
    if na(src) or length < 4
        na
    else
        t = t_statistic(src, length)
        if na(t)
            na
        else
            // Approximation using normal distribution for large samples
            // More accurate would use t-distribution, but this is reasonable for length > 30
            abs_t = math.abs(t)

            // Simple approximation: p ≈ 2 * (1 - Φ(|t|))
            if abs_t > 6
                0.0
            else
                // Normal CDF approximation
                z = abs_t
                a1 = 0.254829592
                a2 = -0.284496736
                a3 = 1.421413741
                a4 = -1.453152027
                a5 = 1.061405429
                p_coef = 0.3275911

                t_val = 1.0 / (1.0 + p_coef * z / 1.41421)
                t2 = t_val * t_val
                t3 = t2 * t_val
                t4 = t3 * t_val
                t5 = t4 * t_val
                cdf = 1.0 - (a1*t_val + a2*t2 + a3*t3 + a4*t4 + a5*t5) * math.exp(-0.5 * z * z)

                2.0 * (1.0 - cdf)


//@function Tests if regression slope is statistically significant
//@param src Source series
//@param length Lookback period
//@param alpha Significance level (default: 0.05)
//@returns true if slope is significant at alpha level
export is_significant(series float src, simple int length, simple float alpha) =>
    if na(src) or length < 4 or alpha <= 0 or alpha >= 1
        false
    else
        pval = slope_pvalue(src, length)
        not na(pval) and pval < alpha


// ─────────────────────────────────────────────────────────────────────────────
// TREND ANALYSIS
// ─────────────────────────────────────────────────────────────────────────────

//@function Calculates normalized trend strength based on R² and slope
//@param src Source series
//@param length Lookback period
//@returns Trend strength [-1, 1] where sign indicates direction
export trend_strength(series float src, simple int length) =>
    if na(src) or length < 3
        na
    else
        r2 = r_squared(src, length)
        slope = linreg_slope(src, length)

        if na(r2) or na(slope)
            na
        else
            direction = slope >= 0 ? 1.0 : -1.0
            direction * math.sqrt(r2)


//@function Calculates trend angle in degrees
//@param src Source series
//@param length Lookback period
//@returns Angle in degrees (positive = uptrend, negative = downtrend)
export trend_angle(series float src, simple int length) =>
    if na(src) or length < 2
        na
    else
        slope = linreg_slope(src, length)
        if na(slope)
            na
        else
            // Normalize slope by price level for meaningful angle
            mean_price = ta.sma(src, length)
            if mean_price == 0
                na
            else
                normalized_slope = slope / mean_price * length
                math.atan(normalized_slope) * DEG_PER_RAD


//@function Calculates trend acceleration (second derivative)
//@param src Source series
//@param length Lookback period for each regression
//@returns Acceleration (change in slope)
export linreg_acceleration(series float src, simple int length) =>
    if na(src) or length < 4
        na
    else
        slope_current = linreg_slope(src, length)
        slope_prev = linreg_slope(src[1], length)

        if na(slope_current) or na(slope_prev)
            na
        else
            slope_current - slope_prev


//@function Calculates deviation from regression line in standard error units
//@param src Source series
//@param length Lookback period
//@returns Deviation in standard error units (like z-score)
export linreg_deviation(series float src, simple int length) =>
    if na(src) or length < 3
        na
    else
        res = residual(src, length)
        se = _std_error_internal(src, length)

        if na(res) or na(se) or se == 0
            na
        else
            res / se


// ─────────────────────────────────────────────────────────────────────────────
// POLYNOMIAL REGRESSION (QUADRATIC)
// ─────────────────────────────────────────────────────────────────────────────

//@function Fits quadratic regression and returns coefficients
//@param src Source series
//@param length Lookback period (must be >= 4)
//@returns Tuple: [a, b, c] for y = a*x² + b*x + c
export quadreg_coefficients(series float src, simple int length) =>
    if na(src) or length < 4
        [na, na, na]
    else
        // Solve normal equations for quadratic fit
        sum_x = 0.0
        sum_x2 = 0.0
        sum_x3 = 0.0
        sum_x4 = 0.0
        sum_y = 0.0
        sum_xy = 0.0
        sum_x2y = 0.0
        n = 0

        for i = 0 to length - 1
            if not na(src[i])
                x = float(length - 1 - i)
                x2 = x * x
                y = src[i]

                sum_x += x
                sum_x2 += x2
                sum_x3 += x2 * x
                sum_x4 += x2 * x2
                sum_y += y
                sum_xy += x * y
                sum_x2y += x2 * y
                n += 1

        if n < 4
            [na, na, na]
        else
            // Matrix determinant calculations (simplified)
            nf = float(n)

            // Main determinant
            det_main = nf * (sum_x2 * sum_x4 - sum_x3 * sum_x3) -
                       sum_x * (sum_x * sum_x4 - sum_x2 * sum_x3) +
                       sum_x2 * (sum_x * sum_x3 - sum_x2 * sum_x2)

            if math.abs(det_main) < 1e-10
                [na, na, na]
            else
                t1_a = sum_y * (sum_x2 * sum_x4 - sum_x3 * sum_x3)
                t2_a = sum_x * (sum_xy * sum_x4 - sum_x2y * sum_x3)
                t3_a = sum_x2 * (sum_xy * sum_x3 - sum_x2y * sum_x2)
                num_a = t1_a - t2_a + t3_a

                t1_b = nf * (sum_xy * sum_x4 - sum_x2y * sum_x3)
                t2_b = sum_y * (sum_x * sum_x4 - sum_x2 * sum_x3)
                t3_b = sum_x2 * (sum_x * sum_x2y - sum_x2 * sum_xy)
                num_b = t1_b - t2_b + t3_b

                t1_c = nf * (sum_x2 * sum_x2y - sum_x3 * sum_xy)
                t2_c = sum_x * (sum_x * sum_x2y - sum_x2 * sum_xy)
                t3_c = sum_y * (sum_x * sum_x3 - sum_x2 * sum_x2)
                num_c = t1_c - t2_c + t3_c

                a = num_a / det_main
                b = num_b / det_main
                c = num_c / det_main

                [a, b, c]


//@function Calculates quadratic regression value at current bar
//@param src Source series
//@param length Lookback period
//@returns Predicted value from quadratic fit
export quadreg_value(series float src, simple int length) =>
    [a, b, c] = quadreg_coefficients(src, length)
    if na(a) or na(b) or na(c)
        na
    else
        x = float(length - 1)
        a * x * x + b * x + c


// ═══════════════════════════════════════════════════════════════════════════════
// MODULE 6: CORRELATION
// ═══════════════════════════════════════════════════════════════════════════════

// ─────────────────────────────────────────────────────────────────────────────
// BASIC CORRELATION AND COVARIANCE
// ─────────────────────────────────────────────────────────────────────────────

//@function Calculates Pearson correlation coefficient between two series
//@param x First series
//@param y Second series
//@param length Lookback period (must be >= 3)
//@returns Correlation coefficient [-1, 1]
export correlation(series float x, series float y, simple int length) =>
    if na(x) or na(y) or length < 3
        na
    else
        ta.correlation(x, y, length)


//@function Calculates sample covariance between two series
//@param x First series
//@param y Second series
//@param length Lookback period (must be >= 2)
//@returns Covariance value
export covariance(series float x, series float y, simple int length) =>
    if na(x) or na(y) or length < 2
        na
    else
        mean_x = ta.sma(x, length)
        mean_y = ta.sma(y, length)

        if na(mean_x) or na(mean_y)
            na
        else
            sum_cov = 0.0
            n = 0

            for i = 0 to length - 1
                if not na(x[i]) and not na(y[i])
                    sum_cov += (x[i] - mean_x) * (y[i] - mean_y)
                    n += 1

            if n < 2
                na
            else
                sum_cov / (n - 1)  // Sample covariance (n-1 denominator)


//@function Calculates beta coefficient (slope of regression of y on x)
//@param asset Asset returns series
//@param benchmark Benchmark returns series
//@param length Lookback period
//@returns Beta coefficient
//@description Beta = Cov(asset, benchmark) / Var(benchmark)
export beta(series float asset, series float benchmark, simple int length) =>
    if na(asset) or na(benchmark) or length < 3
        na
    else
        cov_val = covariance(asset, benchmark, length)
        var_bench = ta.variance(benchmark, length)

        if na(cov_val) or na(var_bench) or var_bench == 0
            na
        else
            cov_val / var_bench


//@function Calculates alpha (Jensen's alpha / intercept)
//@param asset Asset returns series
//@param benchmark Benchmark returns series
//@param length Lookback period
//@param risk_free Risk-free rate (default: 0)
//@returns Alpha value (excess return not explained by beta)
export alpha(series float asset, series float benchmark, simple int length, series float risk_free) =>
    if na(asset) or na(benchmark) or length < 3
        na
    else
        b = beta(asset, benchmark, length)
        mean_asset = ta.sma(asset, length)
        mean_bench = ta.sma(benchmark, length)
        rf = nz(risk_free, 0)

        if na(b) or na(mean_asset) or na(mean_bench)
            na
        else
            // Alpha = R_asset - [Rf + Beta * (R_bench - Rf)]
            mean_asset - (rf + b * (mean_bench - rf))


// ─────────────────────────────────────────────────────────────────────────────
// RANK CORRELATION
// ─────────────────────────────────────────────────────────────────────────────

// Internal: Calculate ranks for a window of data
_get_ranks(float[] data) =>
    n = array.size(data)
    float[] ranks = array.new_float(n)

    for i = 0 to n - 1
        rank = 1.0
        val = array.get(data, i)
        for j = 0 to n - 1
            if i != j and array.get(data, j) < val
                rank += 1.0
        array.set(ranks, i, rank)

    ranks


//@function Calculates Spearman rank correlation coefficient
//@param x First series
//@param y Second series
//@param length Lookback period (must be >= 3)
//@returns Spearman correlation [-1, 1]
//@description More robust to outliers than Pearson correlation
export spearman(series float x, series float y, simple int length) =>
    if na(x) or na(y) or length < 3
        na
    else
        // Collect data
        float[] x_data = array.new_float(length)
        float[] y_data = array.new_float(length)

        valid = true
        for i = 0 to length - 1
            if na(x[i]) or na(y[i])
                valid := false
                break
            array.set(x_data, i, x[i])
            array.set(y_data, i, y[i])

        if not valid
            na
        else
            // Get ranks
            x_ranks = _get_ranks(x_data)
            y_ranks = _get_ranks(y_data)

            // Calculate Pearson correlation on ranks
            mean_rx = 0.0
            mean_ry = 0.0
            for i = 0 to length - 1
                mean_rx += array.get(x_ranks, i)
                mean_ry += array.get(y_ranks, i)
            mean_rx /= length
            mean_ry /= length

            sum_num = 0.0
            sum_rx2 = 0.0
            sum_ry2 = 0.0

            for i = 0 to length - 1
                dx = array.get(x_ranks, i) - mean_rx
                dy = array.get(y_ranks, i) - mean_ry
                sum_num += dx * dy
                sum_rx2 += dx * dx
                sum_ry2 += dy * dy

            denom = math.sqrt(sum_rx2 * sum_ry2)
            denom > 0 ? sum_num / denom : na


//@function Calculates Kendall's tau rank correlation (simplified)
//@param x First series
//@param y Second series
//@param length Lookback period (must be >= 3)
//@returns Kendall's tau [-1, 1]
export kendall_tau(series float x, series float y, simple int length) =>
    if na(x) or na(y) or length < 3
        na
    else
        // Collect data
        float[] x_data = array.new_float(length)
        float[] y_data = array.new_float(length)

        valid = true
        for i = 0 to length - 1
            if na(x[i]) or na(y[i])
                valid := false
                break
            array.set(x_data, i, x[i])
            array.set(y_data, i, y[i])

        if not valid
            na
        else
            // Count concordant and discordant pairs
            concordant = 0
            discordant = 0

            for i = 0 to length - 2
                for j = i + 1 to length - 1
                    xi = array.get(x_data, i)
                    xj = array.get(x_data, j)
                    yi = array.get(y_data, i)
                    yj = array.get(y_data, j)

                    x_sign = xj > xi ? 1 : (xj < xi ? -1 : 0)
                    y_sign = yj > yi ? 1 : (yj < yi ? -1 : 0)

                    if x_sign * y_sign > 0
                        concordant += 1
                    else if x_sign * y_sign < 0
                        discordant += 1

            n_pairs = length * (length - 1) / 2
            n_pairs > 0 ? (concordant - discordant) / n_pairs : na


// ─────────────────────────────────────────────────────────────────────────────
// ROLLING CORRELATION ANALYSIS
// ─────────────────────────────────────────────────────────────────────────────

//@function Calculates change in correlation over time
//@param x First series
//@param y Second series
//@param length Lookback period for correlation
//@param change_period Period over which to measure change
//@returns Change in correlation
export correlation_change(series float x, series float y, simple int length, simple int change_period) =>
    if na(x) or na(y) or length < 3 or change_period < 1
        na
    else
        corr_now = ta.correlation(x, y, length)
        corr_prev = ta.correlation(x[change_period], y[change_period], length)

        if na(corr_now) or na(corr_prev)
            na
        else
            corr_now - corr_prev


//@function Detects correlation regime based on level and stability
//@param x First series
//@param y Second series
//@param length Lookback period for correlation
//@param ma_length Moving average length for smoothing
//@returns Regime: -1 = negative, 0 = uncorrelated, 1 = positive
export correlation_regime(series float x, series float y, simple int length, simple int ma_length) =>
    if na(x) or na(y) or length < 3 or ma_length < 1
        na
    else
        corr = ta.correlation(x, y, length)
        corr_ma = ta.sma(corr, ma_length)
        corr_std = ta.stdev(corr, ma_length)

        if na(corr_ma) or na(corr_std)
            na
        else
            // Classify based on smoothed correlation
            threshold = 0.3  // Minimum for meaningful correlation

            if corr_ma > threshold
                1.0   // Positive correlation regime
            else if corr_ma < -threshold
                -1.0  // Negative correlation regime
            else
                0.0   // Uncorrelated regime


//@function Calculates correlation stability (inverse of volatility)
//@param x First series
//@param y Second series
//@param length Lookback for correlation
//@param stability_length Lookback for stability calculation
//@returns Stability score [0, 1] where 1 = perfectly stable
export correlation_stability(series float x, series float y, simple int length, simple int stability_length) =>
    if na(x) or na(y) or length < 3 or stability_length < 5
        na
    else
        corr = ta.correlation(x, y, length)
        corr_std = ta.stdev(corr, stability_length)

        if na(corr_std)
            na
        else
            // Convert volatility to stability (0-1 scale)
            // Correlation can range from -1 to 1, so max std dev is ~1
            math.max(0, 1.0 - corr_std)


// ─────────────────────────────────────────────────────────────────────────────
// MULTI-ASSET ANALYSIS
// ─────────────────────────────────────────────────────────────────────────────

//@function Calculates relative strength of asset vs benchmark
//@param asset Asset price series
//@param benchmark Benchmark price series
//@param length Smoothing period
//@returns Relative strength ratio (normalized)
export relative_strength(series float asset, series float benchmark, simple int length) =>
    if na(asset) or na(benchmark) or length < 1 or benchmark == 0
        na
    else
        ratio = asset / benchmark
        ratio_ma = ta.sma(ratio, length)
        ratio_ma


//@function Calculates tracking error (standard deviation of excess returns)
//@param asset Asset returns
//@param benchmark Benchmark returns
//@param length Lookback period
//@returns Tracking error (annualize by multiplying by sqrt(252) for daily data)
export tracking_error(series float asset, series float benchmark, simple int length) =>
    if na(asset) or na(benchmark) or length < 3
        na
    else
        excess = asset - benchmark
        ta.stdev(excess, length)


//@function Calculates information ratio (risk-adjusted excess return)
//@param asset Asset returns
//@param benchmark Benchmark returns
//@param length Lookback period
//@returns Information ratio
export information_ratio(series float asset, series float benchmark, simple int length) =>
    if na(asset) or na(benchmark) or length < 3
        na
    else
        excess = asset - benchmark
        mean_excess = ta.sma(excess, length)
        te = ta.stdev(excess, length)

        if na(te) or te == 0
            na
        else
            mean_excess / te


//@function Calculates up/down capture ratio
//@param asset Asset returns
//@param benchmark Benchmark returns
//@param length Lookback period
//@param up_capture If true, calculate up capture; if false, down capture
//@returns Capture ratio
export capture_ratio(series float asset, series float benchmark, simple int length, simple bool up_capture) =>
    if na(asset) or na(benchmark) or length < 10
        na
    else
        sum_asset = 0.0
        sum_bench = 0.0
        n = 0

        for i = 0 to length - 1
            if not na(asset[i]) and not na(benchmark[i])
                if (up_capture and benchmark[i] > 0) or (not up_capture and benchmark[i] < 0)
                    sum_asset += asset[i]
                    sum_bench += benchmark[i]
                    n += 1

        if n < 5 or sum_bench == 0
            na
        else
            (sum_asset / n) / (sum_bench / n) * 100  // As percentage


// ─────────────────────────────────────────────────────────────────────────────
// AUTOCORRELATION
// ─────────────────────────────────────────────────────────────────────────────

//@function Calculates autocorrelation at specified lag
//@param src Source series
//@param length Lookback period
//@param lag Lag for autocorrelation (default: 1)
//@returns Autocorrelation at specified lag
export autocorrelation(series float src, simple int length, simple int lag) =>
    if na(src) or length < 3 or lag < 1 or lag >= length
        na
    else
        ta.correlation(src, src[lag], length)


//@function Calculates partial autocorrelation at lag 1
//@param src Source series
//@param length Lookback period
//@returns PACF at lag 1 (equals ACF at lag 1)
export partial_autocorr(series float src, simple int length) =>
    if na(src) or length < 3
        na
    else
        // PACF(1) = ACF(1)
        ta.correlation(src, src[1], length)


//@function Tests for significant autocorrelation (Ljung-Box inspired)
//@param src Source series
//@param length Lookback period
//@param max_lag Maximum lag to test
//@returns Sum of squared autocorrelations (higher = more autocorrelation)
export autocorr_test(series float src, simple int length, simple int max_lag) =>
    if na(src) or length < 10 or max_lag < 1
        na
    else
        sum_sq = 0.0

        for k = 1 to max_lag
            acf_k = ta.correlation(src, src[k], length)
            if not na(acf_k)
                sum_sq += acf_k * acf_k

        sum_sq


// ─────────────────────────────────────────────────────────────────────────────
// CROSS-CORRELATION
// ─────────────────────────────────────────────────────────────────────────────

//@function Calculates cross-correlation at specified lag
//@param x First series
//@param y Second series (lagged)
//@param length Lookback period
//@param lag Lag to apply to y (positive = y leads x)
//@returns Cross-correlation at specified lag
export cross_correlation(series float x, series float y, simple int length, simple int lag) =>
    if na(x) or na(y) or length < 3 or math.abs(lag) >= length
        na
    else
        if lag >= 0
            ta.correlation(x, y[lag], length)
        else
            ta.correlation(x[-lag], y, length)


///@function Finds lag with maximum cross-correlation
//@param x First series
//@param y Second series
//@param length Lookback period
//@param max_lag Maximum lag to search (both directions)
//@returns Tuple: [best_lag, max_correlation]
export cross_correlation_peak(series float x, series float y, simple int length, simple int max_lag) =>
    if na(x) or na(y) or length < 3 or max_lag < 1
        [na, na]
    else
        best_lag = 0
        max_corr = -2.0

        // Positive lags
        for lag = 0 to max_lag
            corr = ta.correlation(x, y[lag], length)
            if not na(corr) and math.abs(corr) > math.abs(max_corr)
                max_corr := corr
                best_lag := lag

        // Negative lags
        for lag = 1 to max_lag
            corr = ta.correlation(x[lag], y, length)
            if not na(corr) and math.abs(corr) > math.abs(max_corr)
                max_corr := corr
                best_lag := -lag

        [float(best_lag), max_corr]
