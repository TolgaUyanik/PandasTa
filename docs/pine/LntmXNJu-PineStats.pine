library("PineStats", overlay = true)

// ══════════════════════════════════════════════════════════════════════════════
// PINESTATS - Comprehensive Statistical Analysis Library
// ══════════════════════════════════════════════════════════════════════════════
//
// A complete statistical analysis library for TradingView Pine Script v6, with a total of 104 functions. 
// Provides foundational statistics, probability distributions, entropy measures,
// probability calculations, regression analysis, and correlation measures.
// These are common functions that I use across my indicators and decided to compite them into a library.
//
// ══════════════════════════════════════════════════════════════════════════════
// MODULES INCLUDED
// ══════════════════════════════════════════════════════════════════════════════
//
// ┌─────────────────────────────────────────────────────────────────────────────┐
// │ MODULE 1: CORE STATISTICS                                                   │
// ├─────────────────────────────────────────────────────────────────────────────┤
// │ Central Tendency:                                                           │
// │   - mean()           : Arithmetic mean (SMA)                                │
// │   - wma_custom()     : Weighted moving average                              │
// │   - ema_custom()     : Exponential moving average                           │
// │   - median()         : Median value                                         │
// │                                                                             │
// │ Dispersion / Variability:                                                   │
// │   - variance()       : Population variance                                  │
// │   - stdev()          : Population standard deviation                        │
// │   - mad()            : Median Absolute Deviation (robust)                   │
// │   - data_range()     : Range (highest - lowest)                             │
// │                                                                             │
// │ Standardization / Normalization:                                            │
// │   - zscore()         : Z-score (standard deviations from mean)              │
// │   - zscore_robust()  : Robust z-score using median and MAD                  │
// │   - normalize()      : Min-max normalization to [0, 1]                      │
// │   - percentile()     : Percentile rank (0-100)                              │
// │   - winsorize()      : Clamp values to percentile bounds                    │
// │                                                                             │
// │ Shape / Distribution:                                                       │
// │   - skewness()       : Sample skewness (asymmetry measure)                  │
// │   - kurtosis()       : Excess kurtosis (tail heaviness)                     │
// │                                                                             │
// │ Utility:                                                                    │
// │   - count_valid()    : Count non-na values in window                        │
// │   - sum()            : Sum over lookback period                             │
// │   - cumsum()         : Cumulative sum from first bar                        │
// │   - change()         : Difference from n bars ago                           │
// │   - roc()            : Rate of change (percentage)                          │
